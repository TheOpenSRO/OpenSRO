## Opens the talk window for an NPC or gate holder (the click in reach, or a
## talk approach's arrival): the name, greeting and lines, the ring under an
## NPC.
func _open_talk(node: Node) -> void:
	_talk_server = false
	_talk_shop_def = {}
	# Talking supersedes an attack still walking into reach: the attack would
	# otherwise go out behind the talk window.
	_drop_pending_attack()
	# A server NPC (round 727): the select request 0x7045 (FUN_0078f5f0),
	# whose 0xB045 reply names the NPC's interaction ids and opens the talk
	# window (_on_npc_selected). Nothing opens before the reply, as in the
	# original.
	if _is_server_npc(node):
		_talk_select_node = weakref(node)
		_npc_talk_net().select(int(node.get_meta("npc_uid")))
		return
	# A client-placed teleport gate, or no server: the set is built here
	# (_client_talk_ids, OURS).
	_show_talk(node, _client_talk_ids(str(node.get_meta("npc_code")) if node.has_meta("npc_code") else ""))

## Opens the talk window for `node` with interaction-id set `ids`: the name,
## greeting, tax line and lines (NpcServiceReader.services_from_ids), the
## ring under an NPC.
func _show_talk(node: Node, ids: PackedByteArray) -> void:
	var npc_name := str(node.get_meta("npc_name"))
	if npc_name == "":
		npc_name = "..."
	var code := str(node.get_meta("npc_code")) if node.has_meta("npc_code") else ""
	_talk_npc_name = npc_name
	_talk_npc_code = code
	_talk_node = node as Node3D
	_talk_ids = ids
	# Round 783: the definition the server sent for this uid, if any.
	_talk_shop_def = _npc_shop_defs.get(int(node.get_meta("npc_uid", 0)), {}) if _talk_server else {}
	# The ring under an NPC (round 698; the 0xB045 reply selects a CICharactor,
	# texture 1); a teleport gate is not one and gets none.
	if not node.has_meta("gate_point_id") and node is Node3D:
		_markers().attach("npc:%d" % node.get_instance_id(), GroundMarkers.Kind.NPC)
	if not _talk_shop_def.is_empty():
		# OURS (round 783): its own greeting; no fortress tax line.
		_hud_panels.open_npc_talk(npc_name, str(_talk_shop_def.get("greeting", "")), _npc_services(code), "")
		return
	_hud_panels.open_npc_talk(npc_name, _npc_greeting_text(code), _npc_services(code), _npc_tax_text(code))

## Whether a talk with `node` goes through the server (round 727): an NPC the
## server spawned (its uid), while connected. A gate is client-placed.
func _is_server_npc(node: Node) -> bool:
	return node.has_meta("npc_uid") and int(node.get_meta("npc_uid")) != 0 \
		and not node.has_meta("gate_point_id") and NetClient.is_connected_to_server()

## The placed holder of a server-spawned NPC with codename `code` nearest the
## player (QA_TALK, round 727), or null.
func _qa_server_npc(code: String) -> Node3D:
	var best: Node3D = null
	var best_d := INF
	for uid in _npc_holders:
		var h = _npc_holders[uid]
		if not is_instance_valid(h) or not (h as Node).is_inside_tree():
			continue
		var holder := h as Node3D
		if str(holder.get_meta("npc_code", "")).to_upper() != code.to_upper() or not _is_server_npc(holder):
			continue
		var d := holder.global_position.distance_to(player.global_position) if player != null else 0.0
		if d < best_d:
			best_d = d
			best = holder
	return best

## The talk approach (round 701). READ from sro_client.exe:
## - The object click 0x793570 measures the object's +0x24c, the 3-D distance
##   from the local player that CICPlayer::vslot_005 (0x9d6f19..0x9d6f7e)
##   writes for every object each frame. A CICNPC beyond 240.0 (double
##   0xdb9888) and a CITeleportGate (class link 0xef1dac) beyond 800.0
##   (double 0xd83080) are walked to; nearer, the select request 0x7045 goes
##   at once (FUN_0078f5f0), whose 0xB045 reply opens the talk window
##   (FUN_0088b200 -> IF_NPCWindow::FUN_00703ff0).
## - The walk: FUN_0078f8d0(msg, 1, 0) -> FUN_009ec6b0(id, 20.0, range, 0),
##   range 240.0 (float 0xdb9884) for an NPC, 640.0 (float 0xdb9890) for a
##   gate, the near bound 20.0 (float 0xd88108) for both. It picks d =
##   rand() / 32767.0 (double 0xde4808) * (range - 20) + 20 and the point
##   object + d * unit(player - object) (FUN_009ed1e0's vector is its second
##   position less its first: the player less the object), moves the ring
##   there with the ground texture (FUN_00a631e0) and sends the walk through
##   the click filter FUN_009ec240. So the ring lands between 20 and 240 (a
##   gate: 640) short of the target on the line to the player -- not at the
##   click, and not always at the farthest spot.
## - The arrival: FUN_009ec380, every frame, waits for the mover to start
##   (+0x714 != 0) and then to stop (+0x714 == 0, +0x6ec == 0), then calls
##   FUN_0078ff60(0, id) -> FUN_0078f5f0(id): the same select, so the talk
##   window opens on arrival. A ground click clears the pending id
##   (FUN_009ec570 writes +0x20 = 0).
## - The server's select handler (SR_GameServer 0x50faf0) measures with
##   GObjPC::IsWithinInteractionRange (0x4a8e10): 300 for an NPC, 800 for a
##   structure, 3-D; beyond, the reply is an error the client shows nothing
##   for. This client has no select request, so the arrival applies that
##   limit itself (talk_out_of_range) and logs a refusal.
const TALK_APPROACH_NPC_BEYOND := 240.0
const TALK_APPROACH_NPC_RANGE := 240.0
const TALK_APPROACH_GATE_BEYOND := 800.0
const TALK_APPROACH_GATE_RANGE := 640.0
const TALK_APPROACH_NEAR := 20.0

## The approach in progress: {"id": the holder's instance id, "started":
## whether the walk has begun}, {} when none.
var _talk_approach: Dictionary = {}
## The random source for the approach distance (retail's rand()); a test
## seeds it.
var _talk_rng := RandomNumberGenerator.new()

## Whether a click on a target `distance` away walks first (READ, 0x793570).
static func talk_needs_approach(distance: float, structure: bool) -> bool:
	return distance > (TALK_APPROACH_GATE_BEYOND if structure else TALK_APPROACH_NPC_BEYOND)

## The approach point (READ, FUN_009ec6b0): `d` from the target on the line
## to the player. `d` is drawn in [TALK_APPROACH_NEAR, range] by the caller.
static func talk_approach_point(target: Vector3, from: Vector3, d: float) -> Vector3:
	var to_player := from - target
	if to_player.length_squared() < 1e-6:
		return target
	return target + to_player.normalized() * d

## Starts the walk to a target out of talk reach; false when it is in reach.
func _start_talk_approach(node: Node3D) -> bool:
	if player == null:
		return false
	var structure := node.has_meta("gate_point_id")
	var target := node.global_position
	var distance := player.global_position.distance_to(target)
	if not talk_needs_approach(distance, structure):
		return false
	# Round 808: the approach is the same click (0x78f8d0 with its approach
	# flag), so seated it stands instead of walking; the selection stands.
	if _stand_instead("a walk to talk to %s" % str(node.get_meta("npc_name", node.name))):
		return true
	# Round 832: the walk to an NPC is the same ground click (0x78f8d0), and
	# cancels a running action first.
	_cancel_action_for_click()
	var far :=TALK_APPROACH_GATE_RANGE if structure else TALK_APPROACH_NPC_RANGE
	var d := _talk_rng.randf_range(TALK_APPROACH_NEAR, far)
	var point := _walkable_point(talk_approach_point(target, player.global_position, d))
	_markers().place_at(point)
	var took := _issue_walk(point)
	_talk_approach = {"id": node.get_instance_id(), "started": _has_move_target and took == "walk", "point": point}
	print("CLICK: %s '%s' %.1f away (talks within %.0f) -- walking to (%.1f, %.1f, %.1f), %.1f short of it (%s)" % [
		"gate" if structure else "NPC", str(node.get_meta("npc_name", node.name)), distance,
		TALK_APPROACH_GATE_BEYOND if structure else TALK_APPROACH_NPC_BEYOND, point.x, point.y, point.z,
		point.distance_to(target), took])
	return true

## A point on the walkable surface under `p`: the region's walkable graph's
## landing height there, else `p` as it is (OURS: retail sends the 3-D point
## and its mover settles it; this client walks on the graph).
func _walkable_point(p: Vector3) -> Vector3:
	var pair := _nav_graph_for(p)
	if pair.is_empty():
		return p
	var group: Node3D = pair[1]
	var local := group.to_local(p)
	var h := (pair[0] as NavGraph).landing_height_at(local.x, local.z)
	if is_nan(h):
		return p
	return group.to_global(Vector3(local.x, h, local.z))

## Ends a talk approach without talking (a new click, death, a zone change).
func _cancel_talk_approach(why: String) -> void:
	if _talk_approach.is_empty():
		return
	print("CLICK: talk approach dropped (%s)" % why)
	_talk_approach = {}

## Once a physics tick: the arrival of a talk approach (READ, FUN_009ec380):
## once the walk has begun and ended, the talk -- within the server's limit
## (talk_out_of_range), else a logged refusal; a target gone, nothing.
func _step_talk_approach(locked: bool = false) -> void:
	if _talk_approach.is_empty():
		return
	var node := instance_from_id(int(_talk_approach["id"])) as Node3D
	if node == null or not is_instance_valid(node) or not node.is_inside_tree():
		_cancel_talk_approach("the target is gone")
		return
	# A typing or motion lock stops the walk but is no arrival (round 701's
	# review, OURS: retail's walk does not stop for the chat line): the
	# approach waits and walks on when the lock lifts.
	if locked:
		if bool(_talk_approach["started"]):
			_talk_approach["started"] = false
			_talk_approach["resume"] = true
		return
	if bool(_talk_approach.get("resume", false)) and not _has_move_target and _wall_root() == 0:
		_talk_approach["resume"] = false
		_talk_approach["started"] = _issue_walk(_talk_approach["point"]) == "walk" and _has_move_target
		return
	if _has_move_target:
		_talk_approach["started"] = true
		return
	if not bool(_talk_approach["started"]):
		return
	_talk_approach = {}
	var structure := node.has_meta("gate_point_id")
	if talk_out_of_range(player.global_position, node.global_position, structure):
		print("CLICK: arrived %.1f from '%s' -- beyond the server's %.0f, no talk (retail's select reply refuses it silently)" % [
			player.global_position.distance_to(node.global_position), str(node.get_meta("npc_name", node.name)),
			TALK_RANGE_STRUCTURE if structure else TALK_RANGE_NPC])
		return
	print("CLICK: arrived %.1f from '%s' -- talking" % [player.global_position.distance_to(node.global_position), str(node.get_meta("npc_name", node.name))])
	_open_talk(node)

## A text key resolved through the UI table (textuisystem), the speech table,
## then the object-name table (textdata_object); `fallback` when none has it
## (round 725: the store lines' SN_STORE_* keys, the tax line's format and
## its SN_FORTRESS_* fortress name, which only textdata_object carries).
func _resolve_any_text(key: String, fallback: String) -> String:
	if key == "" or key == "xxx":
		return fallback
	# textdata_object holds the fortress names (SN_FORTRESS_JANGAN), the
	# other two the menu lines and the tax format.
	for table in [_ui_text_table, _npc_text_table, _object_names()]:
		if table == null:
			continue
		var t: String = (table as UiTextTable).get_text(key)
		if t != "" and t != key:
			return t
	# Round 838: a talk line's SN_TALK_ key that the tables above lack lives in
	# textquest_queststring.txt (MEASURED: Magic POP's SN_TALK_CH_GACHA_*),
	# read once, on the first such miss, so the world's entry does not pay it.
	if key.begins_with("SN_TALK_"):
		if _quest_string_table == null and _media_pk2 != null:
			var qs := ObjectLoader.find_file(_media_pk2, "server_dep\\silkroad\\textdata\\textquest_queststring.txt")
			_quest_string_table = UiTextTable.parse(_media_pk2.read_file(qs)) if qs != null else UiTextTable.new()
		if _quest_string_table != null:
			var q: String = _quest_string_table.get_text(key)
			if q != "" and q != key:
				return q
	return fallback

var _quest_string_table: UiTextTable = null

## The talk box's tax line for the NPC or gate `code`, or "" (round 725;
## NpcTalkView.fortress_strid_for has what is READ and what is ours): the
## client's SN_FORTRESS_SHOP_TAX with the fortress's name and the rate, 0 --
## OpenSRO's server sends no fortress tax yet (lane C).
func _npc_tax_text(code: String) -> String:
	var fortress := NpcTalkView.fortress_strid_for(code)
	if fortress == "":
		return ""
	var fmt := _resolve_any_text(NpcTalkView.TAX_STRID, NpcTalkView.TAX_FALLBACK)
	var fortress_name := _resolve_any_text(fortress, fortress)
	if fmt.count("%") < 2:
		return ""
	return fmt.replace("%%", "\u0001").replace("%s", fortress_name).replace("%d", "0").replace("\u0001", "%")

## The NPC's real greeting, resolved from npcchat.txt's SN_ id through the
## text table; "" when the NPC has none (the talk window then shows "...").
func _npc_greeting_text(code: String) -> String:
	if code == "" or _npc_text_table == null:
		return ""
	var pair: Array = _npc_greetings.get(code.to_upper(), [])
	for strid in pair:
		var s := str(strid)
		if s != "" and s != "xxx":
			var resolved := _npc_text_table.get_text(s)
			if resolved != "" and resolved != s:
				return resolved
			# Round 838: Magic POP's greetings (SN_TALK_CH_GACHA_*_1) are in
			# textquest_queststring.txt (_resolve_any_text's SN_TALK_ branch).
			if s.begins_with("SN_TALK_"):
				resolved = _resolve_any_text(s, "")
				if resolved != "":
					return resolved
	return ""

## The talk window's lines (round 727): the interaction-id set `ids` -- the
## server's 0xB045 reply for an NPC, _client_talk_ids for a gate -- walked in
## the client's order (NpcServiceReader.services_from_ids); the last talk's
## set when `ids` is null. The player's guild state picks a guild NPC's lines
## (round 521) and gates its store line (round 524), the level the academy
## line (round 727), the job and alias a job guild's (round 799).
func _npc_services(code: String, ids: Variant = null) -> Array:
	var id_set: PackedByteArray = _talk_ids if ids == null else ids
	# Round 725: the store lines, one per tab group, each worded by its group's
	# own name (ShopReader.store_lines_for; FUN_006fb630, READ). The name is
	# resolved here through both text tables, so the talk box shows it even
	# where its own UI table has no SN_STORE_* row; so are the SN_ tokens of
	# the builder's last lines (textdata_object / the NPC text table).
	var store_lines: Array = _shop_reader.store_lines_for(code) if _shop_reader != null and code != "" else []
	# Round 783: an NPC of OpenSRO's own words its lines by its definition
	# (the label is a text key or the text itself).
	if not _talk_shop_def.is_empty():
		store_lines = NpcShopDefNet.store_lines(_talk_shop_def)
	var out := NpcServiceReader.services_from_ids(id_set, store_lines, _guild_id, _guild_master, NetClient.job_kind,
		_player_level, NetClient.job_alias == "", NetClient.academy.in_academy())
	# Round 844: the guild storage's line is red below guild level 2.
	if NetClient.guild_data.level < GuildStorageController.MIN_LEVEL:
		NpcTalkView.line_colours["guild_storage"] = NpcTalkView.COLOUR_MENU_LOW_LEVEL
	else:
		NpcTalkView.line_colours.erase("guild_storage")
	for svc_v in out:
		var svc: NpcServiceReader.Service = svc_v
		if NpcShopDefNet.line_of(NpcServiceReader.tabgroup_of(svc.key)) >= 0:
			svc.label = _resolve_any_text(svc.strid, svc.strid)
		elif svc.key.begins_with(NpcServiceReader.SHOP_KEY_PREFIX) or svc.strid.begins_with("SN_"):
			svc.label = _resolve_any_text(svc.strid, svc.label)
	return out

## The interaction ids of a talk the server does not answer (round 727). A
## teleport gate is placed by this client and has no server uid, so its set
## is built from its teleportdata point, as the server's own registrar reads
## it (NpcServiceReader.gate_ids: 7 and 9 READ, 8 from the links, disclosed);
## so is a teleport NPC's (round 642: the ferry, airship and tunnel sellers,
## Jangan's gate soldiers) when no server sends its set. OURS: in the
## original every set comes in the 0xB045 reply. Anything else without a
## server has no set: its window shows the greeting and the end line.
func _client_talk_ids(code: String) -> PackedByteArray:
	var point := _teleport_point_for_code(code)
	if point == null:
		return PackedByteArray()
	return NpcServiceReader.gate_ids(not _teleport_reader.links_from(point.id).is_empty(),
		point.interaction7, point.interaction9)

## The teleport point the thing being talked to stands for: a gate
## structure's (its teleportbuilding code, round 577) or, since round 642, an
## NPC's -- the point whose associated object is the NPC's characterdata id
## (teleportdata column 3; GATE_NPC_CH_FERRY names 2011, NPC_CH_FERRY). The
## NPC's id comes from its code through the NPC tables (_npc_codes, the
## reverse of what places it). null when neither names a point.
func _teleport_point_for_code(code: String) -> TeleportReader.Point:
	if _teleport_reader == null or code == "":
		return null
	var point := _teleport_reader.point_for_building(code)
	if point != null:
		return point
	return _teleport_reader.point_for_object(_npc_id_for_code(code))

## The unique id of the NPC being talked to (its spawn's uid, round 708), or
## 0 (round 728: the retail item operations carry it).
func _talk_npc_uid() -> int:
	if _talk_node != null and is_instance_valid(_talk_node) and _talk_node.has_meta("npc_uid"):
		return int(_talk_node.get_meta("npc_uid"))
	return _npc_uid_for_code(_talk_npc_code)

## The uid of a spawned NPC with this codename (QA hooks that open a store
## without a click), or 0.
func _npc_uid_for_code(code: String) -> int:
	var roster: NpcSpawnNet.Roster = NetClient.get("npc_roster") as NpcSpawnNet.Roster
	var ref_id := _npc_id_for_code(code)
	if roster == null or ref_id <= 0:
		return 0
	for uid in roster.npcs:
		if int(roster.npcs[uid].ref_id) == ref_id:
			return int(uid)
	return 0

## The characterdata id of NPC codename `code` (0 when the NPC tables do not
## name it), through the reverse of _npc_codes.
func _npc_id_for_code(code: String) -> int:
	if _npc_ids_built_from != _npc_codes.size():
		_npc_ids_by_code.clear()
		for npc_id in _npc_codes:
			_npc_ids_by_code[str(_npc_codes[npc_id]).to_upper()] = int(npc_id)
		_npc_ids_built_from = _npc_codes.size()
	return int(_npc_ids_by_code.get(code.strip_edges().to_upper(), 0))

## codename (upper) -> characterdata id, the reverse of _npc_codes, rebuilt
## when that grows (_teleport_point_for_code).
var _npc_ids_by_code: Dictionary = {}
## _npc_codes' size when _npc_ids_by_code was built (-1: never).
var _npc_ids_built_from := -1

## Rebuilds the talk menu if it is still open, after the player's guild state
## changed (round 521): a guild NPC's lines depend on it. It rebuilds in place
## (HudPanels.refresh_npc_talk), so the talk box is not raised above a window
## opened from it and a guild prompt being typed into stays.
func _refresh_open_talk_menu() -> void:
	if _hud_panels == null or _talk_npc_code == "":
		return
	_hud_panels.refresh_npc_talk(_talk_npc_name, _npc_greeting_text(_talk_npc_code), _npc_services(_talk_npc_code),
		_npc_tax_text(_talk_npc_code))

# --- The job guild (round 799, JobGuildFlow) -----------------------------------

var _job_flow: JobGuildFlow = null

func _job_setup() -> void:
	_job_flow = JobGuildFlow.new(self, _hud_panels)
	if _media_pk2 != null:
		var e := ObjectLoader.find_file(_media_pk2, LevelDataReader.TABLE_PATH)
		if e != null:
			_job_flow.job_table = LevelDataReader.parse_job_exp(_media_pk2.read_file(e))
	NetClient.job_reply.connect(_job_flow.on_reply)
	NetClient.job_exp_changed.connect(_job_flow.on_exp)
	NetClient.job_changed.connect(_on_job_changed)
	_on_job_changed()
	# Round 800: the suit's 10 seconds over the head (StripBars).
	_strip_bars = StripBars.new()
	_strip_bars.name = "StripBars"
	_strip_bars.camera_of = func() -> Camera3D: return get_viewport().get_camera_3d()
	_strip_bars.anchor_of = _strip_anchor
	ui_control.add_child(_strip_bars)
	# Round 826: under every window. The original draws it in the object's
	# own pass (CICUser::vslot_010, READ), so before the interface (INFERRED
	# from the pass order); added last here,
	# it drew over open windows (the user: "That yellow bar appears over open
	# GUI windows and it shouldn't").
	ui_control.move_child(_strip_bars, 0)
	NetClient.strip_started.connect(func(uid: int, secs: int) -> void:
		_strip_bars.start(uid, secs, Time.get_ticks_msec()))
	NetClient.strip_cancelled.connect(_on_strip_cancelled)
	# Round 801: the specialty trade.
	_specialty_flow = SpecialtyFlow.new(self, _hud_panels, _hud_cos)
	# Round 841: the specialty store's transport window and Escape's COS step.
	_hud_panels.hud_cos = _hud_cos
	NetClient.notice_word.connect(func(w: int) -> void: _specialty_flow.on_notice_word(w))
	if _hud_cos != null:
		_hud_cos.sell_all_requested.connect(func(uid: int) -> void: _specialty_flow.sell_all(uid))

var _strip_bars: StripBars = null
var _specialty_flow: SpecialtyFlow = null

## Round 801: specialnpcdata.txt's NPC ids (the trade-info window's stores,
## READ c:0x952890 case 0x52: `<id>\t<codename>`), and each id's code.
var _special_npcs: Array = []
var _special_npc_codes := {}
## Each good's origin: the special NPC whose store sells it (c:0x9413f0 sets
## the good's +0x560 walking every special NPC's store).
var _good_origin := {}

func _load_special_npcs() -> void:
	if not _special_npcs.is_empty() or _media_pk2 == null:
		return
	var e := ObjectLoader.find_file(_media_pk2, "server_dep\\silkroad\\textdata\\specialnpcdata.txt")
	if e == null:
		return
	var raw := _media_pk2.read_file(e)
	if raw.size() >= 2 and raw[0] == 0xFF and raw[1] == 0xFE:
		raw = raw.slice(2)
	var text := TextDecode.utf16(raw)
	if text.is_empty():
		text = raw.get_string_from_utf8()
	for line in text.replace("\r", "").split("\n"):
		var cols := line.split("\t")
		if cols.size() < 2 or not cols[0].strip_edges().is_valid_int():
			continue
		var id := int(cols[0])
		_special_npcs.append(id)
		_special_npc_codes[id] = cols[1].strip_edges()
	for id in _special_npcs:
		var code: String = _special_npc_codes[id]
		if _shop_reader == null:
			break
		for t in _shop_reader.tabs_for(code):
			for item_code in (t as ShopReader.Tab).item_codes:
				_good_origin[item_code] = id

func _special_npc_ids() -> Array:
	_load_special_npcs()
	return _special_npcs

## A store's name: text(<the NPC's NameStrID> + "_T") (c:0x568440), "" when
## the text has none.
func _special_npc_store_name(ref: int) -> String:
	var key := _unique_name_key(ref)
	if key == "":
		return ""
	var t := _resolve_any_text(key + "_T", "")
	return "" if t == key + "_T" else t

func _trade_item_name(item: int) -> String:
	return _item_label_for_line(item)

func _trade_item_origin(item: int) -> String:
	_load_special_npcs()
	var code := _hud_panels.item_code_for_id(item) if _hud_panels != null else ""
	var npc := int(_good_origin.get(code, 0))
	return _special_npc_store_name(npc) if npc != 0 else ""

## The head point a uid's strip bar hangs under: its plate's anchor.
func _strip_anchor(uid: int) -> Variant:
	_sync_own_id()
	var body: Node3D = null
	if _own_id() >= 0 and uid == (_own_id() & 0xffffffff):
		body = player
	else:
		var other := _other_by_uid(uid)
		body = _other_bodies.get(other) if other >= 0 else null
	if body == null or not is_instance_valid(body):
		return null
	var plate := body.get_node_or_null("Name") as Node3D
	return plate.global_position if plate != null else body.global_position

## 0x3042 (FUN_008825d0): the bar stops; the own player, with any byte but 2,
## hears UIIT_MSG_STRIP_CANCEL (system window type 0).
func _on_strip_cancelled(uid: int, kind: int) -> void:
	if _strip_bars != null:
		_strip_bars.stop(uid)
	_sync_own_id()
	if _own_id() >= 0 and uid == (_own_id() & 0xffffffff) and kind != 2:
		_log_system(_resolve_any_text("UIIT_MSG_STRIP_CANCEL", "Unequiping item cancelled."), HudSystemMessage.TYPE_ALWAYS)

## The player's job changed (OpJobInfo, a join or leave, the alias, 0x30E6):
## the character window's job rows.
func _on_job_changed() -> void:
	# Round 805: the alias may land after the plate is built, or change; the
	# OURS class title follows the job level.
	if NetClient.job_alias != _plate_alias or NetClient.job_level != _plate_job_level:
		_refresh_player_name_plate()
	if _hud_panels != null and _job_flow != null:
		_hud_panels.set_character_job(NetClient.job_kind, NetClient.job_level, NetClient.job_exp, NetClient.job_alias,
			_job_flow.job_table)

## FUN_006fdd40 (READ): the outcome query's reply rewrites the open talk box --
## its text and its lines (the collect line when there is a reward, then the
## end line, which the talk view adds).
func _replace_talk(body: String, services: Array) -> void:
	if _hud_panels == null or _talk_npc_code == "":
		return
	for svc_v in services:
		var svc: NpcServiceReader.Service = svc_v
		svc.label = _resolve_any_text(svc.strid, svc.label)
	_hud_panels.refresh_npc_talk(_talk_npc_name, body, services, "")

## Acts on a service chosen in the talk box. Buy opens the NPC's real shop and
## Storage the warehouse. At a guild NPC (round 521), "guild_create" asks for
## a name and founds the guild, and "guild_leave" asks for a confirmation and
## then leaves it. The others (a
## guild master's "guild") are their own systems, still to come, so they say
## so rather than doing nothing silently. A smith lists no Repair line (round
## 512, NpcServiceReader.services_from_ids): repair is the store window's own
## buttons.
func _on_npc_service_selected(key: String) -> void:
	# Round 728: the retail sell, deposit and buy back carry the NPC's uid.
	_hud_panels.npc_uid = _talk_npc_uid()
	# Round 799: a job guild's lines (JobGuildFlow; their requests name the
	# NPC, no 0x7046 open).
	if _job_flow != null and _job_flow.handle_service(key):
		return
	# Round 865: the storage keeper's academy lines (AcademyFlow: the fee
	# box then 0x7470, or 0x7478 at once).
	if _academy_flow != null and _academy_flow.handle_service(key):
		return
	# A server NPC's store, storage and talk lines (round 727): the open
	# request 0x7046 with the line's id (CIF_NPCTalk::FUN_007020c0: kind 1 ->
	# 1, kind 3 -> 3, kind 4 -> 2); the windows open on its reply
	# (_on_npc_opened).
	# Round 844 lane G part 2: a guild manager's store below guild level 3
	# does not open (CIF_NPCTalk::FUN_007020c0 item 1, c:0x702161..0x7021ef:
	# interaction 0x0f and the guild record's level < 3 ->
	# UIIT_MSG_GUILD_STORE_LIMIT on the big notice and the system window).
	if NpcServiceReader.is_shop_key(key) and _talk_ids.has(0x0f) and NetClient.guild_data.in_guild \
			and NetClient.guild_data.level < 3:
		var limit := _resolve_any_text("UIIT_MSG_GUILD_STORE_LIMIT", "Guild level must be 3 or higher to use guild store.")
		_show_banner("system", limit)
		_log_system(limit)
		return
	if _talk_server and _npc_talk != null:
		if NpcServiceReader.is_shop_key(key):
			_talk_pending_tabgroup = NpcServiceReader.tabgroup_of(key)
			# Round 801: at an NPC whose set holds 0xc the store line opens
			# 0xc (c:0x7022d6..0x702330).
			_npc_talk.open(SpecialtyNet.store_open_id(_npc_talk.ids))
			return
		if key == "storage":
			_npc_talk.open(3)
			return
		# Round 844: the guild storage's line 0x1d hides the talk window and
		# sends 0x7046 {npc, 0x0f} (c:0x702c31..0x702c97); its 0xB046 sends
		# 0x7250 (_on_npc_opened).
		if key == "guild_storage":
			_npc_talk.open(GuildStorageNet.INTERACTION)
			return
		# Round 789: the blacksmith's grant line (kind 0x2f -> 0x7046 {npc,
		# 0x20}, READ c:0x7034f3..0x70358d); its 0xB046 opens the window.
		if key == "avatar_magic_option":
			_npc_talk.open(0x20)
			return
		if key == "talk":
			_npc_talk.open(2)
			return
		# Round 838: Magic POP. The machine's line 0x27 opens 0x11; Gori's
		# line 0x28 sends the exchange 0x7119 when the bag holds a coupon
		# (3/3/14/2, c:0x745ab0), else his talk says he cannot
		# (SN_TALK_CH_GACHA_OPERATOR_3) -- c:0x7020c0, READ.
		if key == "gacha_machine":
			_npc_talk.open(0x11)
			return
		if key == "gacha_operator":
			_gacha_exchange()
			return
	# A tab group's store line (round 725): that group's tabs.
	if key.begins_with(NpcServiceReader.SHOP_KEY_PREFIX):
		if _shop_reader != null and _talk_npc_code != "":
			_hud_panels.open_shop(_talk_npc_name,
				_shop_reader.tabs_for(_talk_npc_code, NpcServiceReader.tabgroup_of(key)), _talk_npc_code)
		return
	match key:
		"special_price":
			# Round 801: the talk line 0x39 opens the trade-info window with no
			# request (c:0x79e510).
			if _specialty_flow != null:
				_specialty_flow.open_trade_info()
		"shop":
			if _shop_reader != null and _talk_npc_code != "":
				# The codename also decides the store's repair buttons
				# (HudPanels._show_repair_buttons, round 514).
				_hud_panels.open_shop(_talk_npc_name, _shop_reader.tabs_for(_talk_npc_code), _talk_npc_code)
		"storage":
			_hud_panels.open_storage(_talk_npc_name)
		"guild_create":
			# The name prompt emits guild_create_requested, which
			# _on_guild_create_requested sends. The server holds the gates
			# (level 20, 500,000 gold, a 2-12 byte name; rounds 481/487).
			if NetClient.is_connected_to_server():
				_hud_panels.open_guild_name_prompt(_talk_npc_name)
			else:
				_log_system("Founding a guild needs the server.")
		"guild_leave":
			# Not sent on the click: box 0x14's OK emits
			# guild_leave_requested, which _on_guild_leave_requested sends
			# (round 822: CIF_NPCTalk::FUN_007020c0 case 0x1c).
			if NetClient.is_connected_to_server():
				_hud_panels.open_guild_leave_prompt(_talk_npc_name)
			else:
				_log_system("Leaving a guild needs the server.")
		"guild_master_release":
			# Round 844 part 2: line 0x19's box; its OK sends 0x7105.
			_hud_panels.open_guild_vote_confirm(_talk_npc_uid())
		"guild_vote":
			# Line 0x1a (c:0x702f1d): the state asked for first, else the
			# window from the cache.
			var gp2 := NetClient.guild_part2
			if gp2.vote_loaded:
				_hud_panels.open_guild_election(_talk_npc_uid(), gp2)
			else:
				_guild_vote_npc = _talk_npc_uid()
				NetClient.guild_manage(GuildPart2Net.OP_VOTE_STATE, GuildPart2Net.encode_vote_state(gp2.vote_id))
		"guild_gp_history":
			# Line 0x43 (c:0x7020c0 case 0x43): 0x7501 {npc}.
			NetClient.guild_manage(GuildPart2Net.OP_GP_HISTORY, GuildPart2Net.encode_gp_history(_talk_npc_uid()))
		"guild_level_up":
			# Round 844: line 0x17 opens CIFGuildLevelUp; its Confirm sends 0x70FA.
			_hud_panels.open_guild_level_up(_talk_npc_uid())
		"guild_master_leave":
			# Round 844: line 0x18 opens CIFGuildMasterLeave; its confirm sends 0x7103.
			_hud_panels.open_guild_master_leave(_talk_npc_uid())
		"guild_compensation":
			# Round 844 (lane V): line 0x1b "War reward gold received"
			# (CIF_NPCTalk 0x7020c0 case 0x1b): 0x7114 {npc}.
			if NetClient.is_connected_to_server() and _guild_war_ui != null:
				_guild_war_ui.ask_reward(_talk_npc_uid())
		"guild_disband":
			# Round 822: line 0x14 opens box 0x13; its OK sends 0x70F1.
			if NetClient.is_connected_to_server():
				var npc := _talk_npc_uid()
				var box: GuildMsgBox = _hud_panels.open_guild_box(GuildMsgBox.Kind.DISBAND)
				if box != null:
					box.accepted.connect(func(_t: String) -> void: NetClient.guild_disband(npc))
		"teleport":
			# A Dimensional Gate's 'Select a teleport area:' (round 578): its
			# destinations, in the talk box (round 603).
			_open_teleport_list()
		"recall_designate":
			# A town gate's 'Designate as return/recall point' (round 686):
			# retail's agreement box, then the request.
			_open_recall_designate()
		_:
			_log_system("%s is not available yet." % key.capitalize())

## The gate the return-point box was opened at (a teleportdata id), what its
## OK sends (_on_recall_designate_requested); 0 when none is open.
var _recall_gate_point_id := 0

## Opens the agreement box behind a town gate's 'Designate as return/recall
## point' line (round 686; HudPanels.open_recall_designate_prompt has the
## reading) for the gate being talked to, naming the zone the player stands
## in, as retail's box does.
func _open_recall_designate() -> void:
	if _teleport_reader == null or _hud_panels == null or _talk_npc_code == "":
		return
	var point := _teleport_point_for_code(_talk_npc_code)
	if point == null:
		_log_system("This gate has no teleport point.")
		return
	_recall_gate_point_id = point.id
	_hud_panels.open_recall_designate_prompt(_talk_npc_name, _current_zone_name)

## The box's OK: the request goes out with the gate it was opened at.
