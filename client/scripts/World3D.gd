## The booth, title and loop of uid's body as its stall state says. Nothing
## is done for a body that neither stalls nor carries a booth (every spawn
## asks: round 839 keeps the crowd's path as it was).
func _stall_refresh(uid: int) -> void:
	if _stall_world == null:
		return
	var own := _own_id() >= 0 and (uid & 0xffffffff) == (_own_id() & 0xffffffff)
	var node: Node3D = player if own else _other_bodies.get(uid)
	if node == null or not is_instance_valid(node):
		return
	var stalling := _stall_world.stalling(uid)
	# Round 850: the vendor pose (state 15) hides a player's weapon and shield
	# from the stall's open to its close (HeldItems, READ 0xa5a330 / 0xa59c90).
	_held_set(_own_id() if own else uid, HeldItems.REASON_STALL, stalling)
	if not stalling and node.get_node_or_null(StallWorld.BOOTH_NODE) == null \
			and node.get_node_or_null(StallWorld.TITLE_NODE) == null:
		return
	# A ghost (round 756) is dressed now: its loop is swapped on the full
	# path (_refresh_other_loop below).
	if not own and _dress_ghost_now(uid):
		return
	var body := _player_body if own else String(node.get_meta("body", ""))
	var top := float(node.get_meta(STALL_TOP_META, 0.0))
	if own and _player_skeleton != null:
		top = _skeleton_top(_player_skeleton)
	if top <= 0.0:
		top = 1.8 * PLAYER_SCALE_RATIO
	_stall_world.apply(uid, node, _race_of_body(body), top)
	if own:
		_stall_own_pets(stalling)
	if stalling:
		var group := _player_anim_group() if own else String((_other_gaits.get(uid, {}) as Dictionary).get("group", "default"))
		print("STALL: %d's vendor clip (type %d, %s, group %s): %s" % [uid, StallWorld.VENDOR_ACTION, body, group,
			"found" if _body_animation_for(body, StallWorld.VENDOR_ACTION, group) != null else "none"])
	if not own:
		_refresh_other_loop(uid)

## Round 840: the control a QA netnode / netbox / underbar step clicks.
## Round 854 (QA): the optnode / optlist / localnode clicks (_qa_input_step).
func _qa_option_click(kind: String, arg: String) -> String:
	var action := "%s:%s" % [kind, arg]
	if kind == "optlist":
		var cl := ComboList.current()
		if cl == null:
			return action + " (no list open)"
		var at := cl.to_canvas * (cl.list_rect.position + ComboList.row_rect(cl.list_rect.size, int(arg)).get_center())
		_qa_push_click(at, MOUSE_BUTTON_LEFT, true)
		return "%s at %s UI units (%s)" % [action, at, cl.items[int(arg)] if int(arg) < cl.items.size() else "?"]
	var c: Control = null
	if kind == "localnode":
		c = _qa_find_visible(ui_control, arg)
	else:
		var ow := _hud_panels.option_window() if _hud_panels != null else null
		var ids: Array = []
		var child := ""
		for b in arg.split(",", false):
			if b.is_valid_int():
				ids.append(int(b))
			else:
				child = b
		c = ow.control(ids) if ow != null else null
		if c != null and child != "":
			c = c.get_node_or_null(child) as Control
	if c == null or not c.is_visible_in_tree():
		return action + " (not shown)"
	var centre := c.get_global_rect().get_center()
	_qa_push_click(centre, MOUSE_BUTTON_LEFT, true)
	var hov := get_viewport().gui_get_hovered_control()
	return "%s at %s UI units (hovered %s)" % [action, centre, hov.get_path() if hov != null else "nothing"]

## Round 854 (QA): the UI scale in force -- the window, its content scale,
## the view, the saved choice, the Option window's UI Scale row -- and every
## shown window's rect in the view (UI units) with whether it is wholly on
## the screen, plus the underbar and minimap drawn sizes in window pixels
## (the HUD's applied scale, measured).
func _qa_ui_scale_report() -> String:
	var win := get_window()
	var k := win.content_scale_factor
	var view := get_viewport().get_visible_rect().size
	var d := {"frame": Engine.get_frames_drawn(), "window": [win.size.x, win.size.y], "scale": snappedf(k, 0.001), "view": [snappedf(view.x, 0.01), snappedf(view.y, 0.01)],
		"saved": UiScaleChoices.saved_percent(), "in_force": UiScaleChoices.in_force(win),
		"offered_here": UiScaleChoices.offered(win.size)}
	var ow := _hud_panels.option_window() if _hud_panels != null else null
	if ow != null and ow.video != null:
		var page := ow.video
		var n := page.slot_of(VideoOptions.UI_SCALE)
		var combo := page.slot_combo(n) if n >= 0 else null
		var items: Array = []
		if combo != null:
			for i in combo.item_count:
				items.append(combo.get_item_text(i))
		d["row"] = {"slot": n, "label": page.slot_label(n).text if n >= 0 else "", "items": items,
			"shown": combo.text if combo != null else "", "choice": page.ui_scale_choice, "scroll": page.scroll_line()}
	var off: Array = []
	var shown: Array = []
	var screen := Rect2(Vector2.ZERO, view).grow(0.5)
	for node in ui_control.find_children("*", "HudWindow", true, false):
		var w := node as Control
		if not w.is_visible_in_tree() or w.size.x <= 0.0:
			continue
		var r := w.get_global_rect()
		shown.append("%s %d,%d %dx%d" % [w.name, roundi(r.position.x), roundi(r.position.y), roundi(r.size.x), roundi(r.size.y)])
		if not screen.encloses(r):
			off.append(String(w.name))
	d["windows"] = shown
	d["off_screen"] = off
	for pair in [["underbar", _hud_underbar.bar_root if _hud_underbar != null else null], ["minimap", _hud_minimap]]:
		var c := pair[1] as Control
		if c != null and c.is_visible_in_tree():
			var r := c.get_global_rect()
			d[pair[0]] = {"ui": [roundi(r.position.x), roundi(r.position.y), roundi(r.size.x), roundi(r.size.y)],
				"px": [roundi(r.position.x * k), roundi(r.position.y * k), roundi(r.size.x * k), roundi(r.size.y * k)],
				"on_screen": screen.encloses(r)}
	return JSON.stringify(d)

func _qa_net_control(kind: String, arg: String) -> Control:
	if _hud_panels == null:
		return null
	var ids: Array = []
	for b in arg.split(",", false):
		ids.append(int(b))
	var c: Control = null
	match kind:
		"netnode":
			var nw := _hud_panels.stall_network_window()
			c = nw.control(ids) if nw != null else null
		"netbox":
			var nb = _hud_panels.stall_network.box if _hud_panels.stall_network != null else null
			c = nb.control(ids) if nb != null and is_instance_valid(nb) and nb.visible else null
		"underbar":
			c = TwoDtBuilder.find_path(_hud_underbar.bar_root, ids) if _hud_underbar != null else null
		"guildnode":
			c = _hud_panels.qa_guild_control(ids)
	return c if c != null and c.is_visible_in_tree() else null

## Round 840: the stall network's town test (CRegionManagerBody slot 23,
## c:0x414560): the claim of the English regioninfo.txt (the music's table)
## at the player's region-local position is #TOWN. OURS: with no table (no
## Data.pk2) the test passes and the server decides.
func _stall_network_in_town() -> bool:
	var music := _audio_music()
	var table: RegioninfoReader.ParsedTable = music._region_table() if music != null else null
	if table == null or player == null:
		return true
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		return false
	var group: Node3D = pair[1]
	var parts := String(group.name).trim_prefix("RealTerrain_").split("_")
	if parts.size() < 2:
		return false
	var local := group.to_local(player.global_position)
	var zi := table.zone_for_position(parts[0].to_int(), parts[1].to_int(), local.x, local.z)
	return zi >= 0 and zi < table.zones.size() and table.zones[zi].kind == RegioninfoReader.KIND_TOWN

## Round 840 (lane B): this player's own summoned COS take the stall's state
## too. READ FUN_009dd040 (c:0x9dd189..0x9dd226 at the open, c:0x9dd29a..
## 0x9dd320 at the close): only when the stalling character is this client's
## own player (IsKindOf CICPlayer, c:0x9dd190 on 0xef1b44), each COS in the
## player's COSDataMgr (CICPlayer +0x20d4, c:0x9d4c70; NetClient.cos_own)
## that is in the world (FindObjectByID, c:0x9dd1e0) enters state 0xF -- the
## vendor loop, animation type 80 -- when its animation set's group 0
## (`default`) has a type-80 entry (c:0x9dd1fd, FUN_00a5a900); at the close
## each enters state 3, the stand, with no such test. Nobody else's pets are
## touched, in this client or another's. MEASURED on the box's Data.pk2: the
## only COS models with a type-80 entry are `cos\p_jinn.bsr` and
## `p_jinn_02.bsr` (`p_jinn_cart_stand01.ban`; the COS_P_JINN growth pets,
## ITEM_COS_P_JINN_SCROLL); every other pet and ride keeps its pose.
var _stall_pets_on := false

func _stall_own_pets(on: bool) -> void:
	if on == _stall_pets_on:
		return
	_stall_pets_on = on
	for uid in NetClient.cos_own:
		var assembled: SkinnedBsrAssembler.AssembledCharacter = _cos_assembled.get(int(uid))
		if not _cos_bodies.has(int(uid)) or assembled == null or not is_instance_valid(assembled.skeleton):
			continue
		if not on:
			_cos_gait(int(uid), BsrReader.AnimationEntry.TYPE_STAND)
			print("STALL: own COS %d back to its stand (state 3)" % int(uid))
			continue
		var clip := SkinnedBsrAssembler.animation_for(_data_pk2, assembled, StallWorld.VENDOR_ACTION, "default") \
			if _data_pk2 != null else null
		if clip == null:
			print("STALL: own COS %d has no type-80 clip: it keeps its pose" % int(uid))
			continue
		_end_body_fidget(assembled.skeleton)
		MonsterMotion.swap_loop(_animated, assembled.skeleton, clip, _frame_count(clip), _idle_anim_time, [],
			_pose_fades, _loop_in_ms(StallWorld.VENDOR_ACTION))
		print("STALL: own COS %d takes the vendor loop (state 0xF, type 80, %s)" % [int(uid),
			String(clip.get_meta(SkinnedBsrAssembler.CLIP_PATH_META, "?"))])

## QA (round 840): OPENSRO_QA_STALL_LOG=1 prints every 30 ticks each booth's
## clock and first moving bone (`QA BOOTH` lines) -- the measurement that a
## booth's own clip runs.
var _qa_stall_log := OS.get_environment("OPENSRO_QA_STALL_LOG") != ""

func _stall_tick() -> void:
	if _qa_stall_log and _stall_world != null and _qa_tick % 30 == 0:
		for uid in _other_bodies:
			var n: Node3D = _other_bodies[uid]
			var b := n.get_node_or_null(StallWorld.BOOTH_NODE) as Node3D if n != null and is_instance_valid(n) else null
			if b != null:
				print("QA BOOTH tick %d: %d %s" % [_qa_tick, int(uid), StallWorld.booth_state(b)])
	if _stall_world == null or _stall_world.pending_owner < 0 or player == null:
		return
	var body: Node3D = _other_bodies.get(_stall_world.pending_owner)
	_stall_world.step(player.global_position.distance_to(body.global_position) if body != null and is_instance_valid(body) else -1.0)

