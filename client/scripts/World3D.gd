## built -- the numbers of client/tools/README.md's "Load benchmark".
var _qa_done := false
var _qa_tick := 0
## SRREVAMP_QA_GROUND_RAYS's lattice size once armed (0: not armed, or
## fired), and the ticks it has waited with the grid loaded (round 567).
var _qa_ground_rays := 0
var _qa_ground_rays_waited := 0
## SRREVAMP_QA_ENTRY as this instance read it in _ready: 0 outside a reconnect
## run; the world entry number (1, 2, ...) inside one.
var _qa_entry := 0
## SRREVAMP_QA_WALK, read once: a heading in degrees to keep walking on,
## driven from _physics_process like a held key so the run plays.
var _qa_walk := OS.get_environment("SRREVAMP_QA_WALK")

## Puts the player at a region-local spot in the region they stand in,
## landing on the highest walkable surface there -- what SRREVAMP_QA_AT
## and the debug panel's teleport both do. False when no region has
## streamed in yet.
func _teleport_local(lx: float, lz: float) -> bool:
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		return false
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	# An arrival, not a step: land on the highest surface here.
	var ly := graph.landing_height_at(lx, lz)
	player.global_position = group.to_global(Vector3(lx, ly, lz))
	player.velocity = Vector3.ZERO
	return true

# --- SRREVAMP_QA_INPUT --------------------------------------------------------
#
# SRREVAMP_QA_INPUT="<tick>:<action>[;<tick>:<action>...]" plays a player's
# input into the real viewport (push_input), one action per tick, so Godot's
# own hit-testing, focus and key routing decide who gets each event -- what
# the one-key SRREVAMP_QA_HOTKEY cannot show, since a player clicks before
# pressing keys. Actions:
#   key:<name>          press and release a key, as the OS delivers it:
#                       keycode, physical_keycode, key_label and (letters,
#                       digits) unicode; `key:shift+q` holds Shift,
#                       `key:ctrl+1` Ctrl
#   down:<name>         press a key and keep it down (V, Z, Space; round 608)
#   up:<name>           release it
#   whisper_from:<name> a whisper from <name> arrives, as the server's would
#                       (R's reply; the text is a synthetic "tt" line)
#   click:<x>,<y>       left press and release at a viewport point
#   rclick:<x>,<y>      the same with the right button
#   node:<name>         left click the centre of the first visible Control of
#                       that name under the UI (find_child pattern)
#   drag:<x>,<y>,<x2>,<y2>  left press, a motion in steps, release
#   type:<text>         a key per character
#   hover:<x>,<y>       move the mouse there (a tooltip shows after its delay)
#   census              print every visible focusable Control that is not a
#                       button (text lines, lists, spin boxes) and its rect
#   talk                open the NPC talk box (as a click on an NPC does)
# The tick after each action prints
#   QA INPUT <n> <action>: open=[...] focus=<node> world_keys=[...] keymap=[...]
# -- the windows on screen, the keyboard focus, the keys that reached
# World3D._unhandled_input (the last stage: every HUD handler ran first),
# and what the key table ran (KeyInput.dispatched, since the action).
var _qa_input_steps: Dictionary = {}
var _qa_input_armed := false
var _qa_input_report := ""
var _qa_input_seen: Array = []
var _qa_input_count := 0
## SRREVAMP_QA_BERSERK=tab: Tab pushed once the gauge filled.
var _qa_berserk_tab_sent := false

## SRREVAMP_QA_PMI="<start tick>,<hold ticks>" (round 629): walks the player
## block through its states for a render, one every <hold> ticks from
## <start>, printing `QA PMI <state> frame <n>` for each: the gauge at 0, at
## two orbs, full with the stat panel opened by a mouse click pushed through
## the viewport at the button's rect, the weapon taken off and put back (with
## a server) so the open panel's numbers change, the ready circle clicked,
## berserk on, and the European emblem. QA only; never set in real play.
var _qa_pmi_spec := OS.get_environment("SRREVAMP_QA_PMI")
var _qa_pmi_state := -1

func _qa_pmi_click(control_name: String) -> void:
	var c := _hud_player_info.find_child(control_name, true, false) as Control
	if c == null:
		print("QA PMI: no %s to click" % control_name)
		return
	var at := c.get_global_rect().get_center()
	for pressed in [true, false]:
		var ev := InputEventMouseButton.new()
		ev.button_index = MOUSE_BUTTON_LEFT
		ev.pressed = pressed
		ev.position = at
		ev.global_position = at
		get_viewport().push_input(ev)
	print("QA PMI: clicked %s at %s" % [control_name, at])

func _qa_pmi_step() -> void:
	if _hud_player_info == null:
		return
	var parts := _qa_pmi_spec.split(",")
	var start := int(parts[0]) if parts.size() > 0 else 400
	var hold := int(parts[1]) if parts.size() > 1 else 40
	if _qa_tick < start or (_qa_tick - start) % hold != 0:
		return
	_qa_pmi_state += 1
	var who := NetClient.current_character_name
	var states := ["ch_gauge0", "ch_gauge2", "ch_full_panel", "unequip_weapon", "equip_weapon", "click_ready", "berserk_on", "eu_full_panel"]
	if _qa_pmi_state >= states.size():
		return
	var state: String = states[_qa_pmi_state]
	match state:
		"ch_gauge0":
			_hud_player_info.set_berserk(0, false)
		"ch_gauge2":
			_hud_player_info.set_berserk(40, false)
		"ch_full_panel":
			_hud_player_info.set_berserk(100, false)
			_qa_pmi_click("GDR_PMI_BTN_CINFO")
		"unequip_weapon":
			if who != "" and NetClient.is_connected_to_server():
				NetClient.unequip(who, EquipmentNet.SLOT_WEAPON)
		"equip_weapon":
			if who != "" and NetClient.is_connected_to_server():
				NetClient.equip(who, EquipmentNet.SLOT_WEAPON, 0)
		"click_ready":
			_qa_pmi_click("GDR_PMI_BTN_JAHWAN")
		"berserk_on":
			_hud_player_info.set_berserk(0, true)
		"eu_full_panel":
			_hud_player_info.set_berserk(100, false)
			_hud_player_info.set_race(1)
	print("QA PMI %s frame %d (panel %s, orbs %d, ready %s, emblem %s)" % [state, Engine.get_frames_drawn(),
		str(_hud_player_info.is_stat_panel_open()), _hud_player_info.hwan_charges(), str(_hud_player_info.hwan_ready()),
		_hud_player_info.race_mark_path()])
## Where KeyInput.dispatched stood when the current action was pushed.
var _qa_input_keymap_mark := 0

func _qa_input_step() -> void:
	var spec := OS.get_environment("SRREVAMP_QA_INPUT")
	if spec == "":
		return
	if not _qa_input_armed:
		_qa_input_armed = true
		for part in spec.split(";", false):
			var at := String(part).find(":")
			if at > 0 and String(part).substr(0, at).is_valid_int():
				_qa_input_steps[int(String(part).substr(0, at))] = String(part).substr(at + 1)
	if _qa_input_report != "":
		var ran: Array = _key_input.dispatched.slice(_qa_input_keymap_mark) if _key_input != null else []
		print("QA INPUT %d %s: open=[%s] focus=%s world_keys=[%s] keymap=[%s]" % [_qa_input_count, _qa_input_report,
			_qa_open_windows(), _qa_focus_name(), ",".join(_qa_input_seen), " | ".join(ran)])
		_qa_input_report = ""
	if not _qa_input_steps.has(_qa_tick):
		return
	var action: String = _qa_input_steps[_qa_tick]
	_qa_input_seen.clear()
	_qa_input_keymap_mark = _key_input.dispatched.size() if _key_input != null else 0
	_qa_input_count += 1
	_qa_input_report = action
	var kind := action.get_slice(":", 0)
	var arg := action.substr(kind.length() + 1)
	match kind:
		"key":
			_qa_push_key(arg)
		"down":
			_qa_push_key(arg, [true])
		"up":
			_qa_push_key(arg, [false])
		"whisper_from":
			var heard := ChatNet.Update.new()
			heard.type = HudChat.TYPE_WHISPER
			heard.sender_name = arg
			heard.message_text = "tt whisper"
			_on_chat_update(heard)
		"type":
			for i in arg.length():
				_qa_push_key(arg[i])
		"click", "rclick":
			var xy := arg.split(",")
			_qa_push_click(Vector2(float(xy[0]), float(xy[1])),
				MOUSE_BUTTON_RIGHT if kind == "rclick" else MOUSE_BUTTON_LEFT)
		"node":
			var node := _qa_find_visible(ui_control, arg)
			if node == null:
				_qa_input_report = action + " (no such visible node)"
			else:
				var centre := node.get_global_rect().get_center()
				_qa_input_report = "%s at %s (%s)" % [action, centre, node.get_path()]
				_qa_push_click(centre, MOUSE_BUTTON_LEFT)
		"drag":
			var v := arg.split(",")
			var from := Vector2(float(v[0]), float(v[1]))
			var to := Vector2(float(v[2]), float(v[3]))
			_qa_push_mouse(from, MOUSE_BUTTON_LEFT, true)
			for i in range(1, 9):
				var motion := InputEventMouseMotion.new()
				motion.position = from.lerp(to, i / 8.0)
				motion.global_position = motion.position
				motion.button_mask = MOUSE_BUTTON_MASK_LEFT
				get_viewport().push_input(motion)
			_qa_push_mouse(to, MOUSE_BUTTON_LEFT, false)
		"hover":
			var hv := arg.split(",")
			var motion := InputEventMouseMotion.new()
			motion.position = Vector2(float(hv[0]), float(hv[1]))
			motion.global_position = motion.position
			get_viewport().push_input(motion)
		"census":
			for node in get_tree().root.find_children("*", "Control", true, false):
				var c := node as Control
				if c.focus_mode != Control.FOCUS_NONE and c.is_visible_in_tree() and not (c is BaseButton):
					print("QA CENSUS %s<%s> rect=%s filter=%d focus_mode=%d" % [c.get_path(), c.get_class(),
						c.get_global_rect(), c.mouse_filter, c.focus_mode])
		"talk":
			if _hud_panels != null:
				_hud_panels.open_npc_talk("QA NPC", "Hello.", [])
		_:
			_qa_input_report = action + " (unknown action)"

func _qa_push_key(name: String, phases: Array = [true, false]) -> void:
	var shift := name.to_lower().begins_with("shift+")
	var ctrl := name.to_lower().begins_with("ctrl+")
	var key_name := name.substr(6) if shift else name.substr(5) if ctrl else name
	var code := OS.find_keycode_from_string(key_name)
	if code == KEY_NONE and key_name == " ":
		code = KEY_SPACE
	var uni := 0
	if key_name.length() == 1:
		uni = key_name.to_upper().unicode_at(0) if shift else key_name.to_lower().unicode_at(0)
	if ctrl:
		uni = 0
	for pressed in phases:
		var ev := InputEventKey.new()
		ev.keycode = code
		ev.physical_keycode = code
		ev.key_label = code
		ev.unicode = uni if pressed else 0
		ev.shift_pressed = shift
		ev.ctrl_pressed = ctrl
		ev.pressed = pressed
		get_viewport().push_input(ev)

func _qa_push_mouse(at: Vector2, button: MouseButton, pressed: bool) -> void:
	var motion := InputEventMouseMotion.new()
	motion.position = at
	motion.global_position = at
	get_viewport().push_input(motion)
	var ev := InputEventMouseButton.new()
	ev.button_index = button
	ev.pressed = pressed
	ev.position = at
	ev.global_position = at
	ev.button_mask = (MOUSE_BUTTON_MASK_LEFT if button == MOUSE_BUTTON_LEFT else MOUSE_BUTTON_MASK_RIGHT) if pressed else 0
	get_viewport().push_input(ev)

func _qa_push_click(at: Vector2, button: MouseButton) -> void:
	_qa_push_mouse(at, button, true)
	_qa_push_mouse(at, button, false)

func _qa_find_visible(root: Node, pattern: String) -> Control:
	for node in root.find_children(pattern, "Control", true, false):
		if (node as Control).is_visible_in_tree():
			return node as Control
	return null

func _qa_focus_name() -> String:
	var focus := get_viewport().gui_get_focus_owner()
	return "null" if focus == null else "%s<%s>" % [focus.name, focus.get_class()]

func _qa_open_windows() -> String:
	var out: Array = []
	if _hud_panels != null:
		for id in HudPanels.PANELS:
			if _hud_panels.is_open(id):
				out.append(id)
	if _hud_worldmap != null and is_instance_valid(_hud_worldmap) and _hud_worldmap.visible:
		out.append("worldmap")
	if _hud_underbar != null and _hud_underbar.is_menu_open():
		out.append("barmenu")
	return ",".join(out)

func _qa_step() -> void:
	var pair := _nav_graph_for(player.global_position)
	if not _qa_done:
		var at := OS.get_environment("SRREVAMP_QA_AT")
		if at != "" and pair.is_empty():
			return # region not streamed in yet; try again next frame
		_qa_done = true
		if at != "":
			var parts := at.split(",")
			if parts.size() >= 2:
				_teleport_local(float(parts[0]), float(parts[1]))
		if OS.get_environment("SRREVAMP_QA_DEBUG") != "" and _debug_panel != null:
			_debug_panel.toggle()
		if OS.get_environment("SRREVAMP_QA_FREE") != "":
			camera_arm.collision_mask = 0
		if OS.get_environment("SRREVAMP_QA_DIST") != "":
			camera_arm.spring_length = float(OS.get_environment("SRREVAMP_QA_DIST"))
		var yaw := OS.get_environment("SRREVAMP_QA_YAW")
		var pitch := OS.get_environment("SRREVAMP_QA_PITCH")
		if yaw != "" or pitch != "":
			camera_arm.rotation_degrees = Vector3(
				float(pitch) if pitch != "" else camera_arm.rotation_degrees.x,
				float(yaw) if yaw != "" else camera_arm.rotation_degrees.y, 0.0)
		if OS.get_environment("SRREVAMP_QA_NOUI") != "":
			# Comparing a render against the authored minimap is a lot
			# easier without a chat box across the bottom of it.
			for node in [$UI/Control, $UI/HideUIButton]:
				(node as CanvasItem).visible = false
		# SRREVAMP_QA_ATTACK needs a server. This block runs on the first
		# physics frame, which can come while _ready is still awaiting the QA
		# sign-in, so a run signing in to a QA server is armed here and swings
		# only once connected (the tick below). Round 539: a `--server
		# --attack` run from the default spot printed no QA ATTACK line at
		# all -- with no SRREVAMP_QA_AT to wait for, this block had found the
		# connection not yet up.
		if OS.get_environment("SRREVAMP_QA_ATTACK") != "" \
				and (NetClient.is_connected_to_server() or OS.get_environment("SRREVAMP_QA_SERVER") != ""):
			_qa_attacking = true
			print("QA ATTACK: armed at tick %d (connected: %s)" % [_qa_tick, str(NetClient.is_connected_to_server())])
		# SRREVAMP_QA_CLICK="monster,npc,ground": synthetic left clicks through
		# the real dispatcher, one after another (see _qa_advance_click).
		var qa_click := OS.get_environment("SRREVAMP_QA_CLICK")
		if qa_click != "":
			for kind in qa_click.split(",", false):
				_qa_click_queue.append(String(kind).strip_edges())
			# The monster list arrives after the connect; give it two seconds.
			_qa_click_wait = 120
			# SRREVAMP_QA_CLICK_WAIT=<ticks> (round 646) waits longer, so a
			# live run can cast buffs by real input before a gate's click.
			var qa_click_wait := OS.get_environment("SRREVAMP_QA_CLICK_WAIT")
			if qa_click_wait.is_valid_int() and int(qa_click_wait) > 0:
				_qa_click_wait = int(qa_click_wait)
		# SRREVAMP_QA_LEVELUP=<level> fires the real level-up burst a moment
		# after the player is placed, so a movie render catches it mid-play
		# (it lasts LevelUpEffect.LIFE). Movie mode advances 1/60 a frame, so
		# 15 frames is a quarter second -- enough for the camera to settle.
		var qa_levelup := OS.get_environment("SRREVAMP_QA_LEVELUP")
		if qa_levelup != "":
			var lvl: int = int(qa_levelup) if qa_levelup.is_valid_int() else 10
			get_tree().create_timer(15.0 / 60.0).timeout.connect(_on_level_up.bind(lvl, 0))
		var qa_worldmap := OS.get_environment("SRREVAMP_QA_WORLDMAP")
		if qa_worldmap != "" and _hud_worldmap != null:
			# The window only builds its tiles for what can be seen, so it
			# has to be opened *after* the player is in place -- otherwise
			# it centres on nowhere and loads the map's top-left corner.
			_hud_worldmap.open()
			if qa_worldmap == "world":
				_hud_worldmap.show_world()
			elif qa_worldmap == "both":
				# One boot, both of the window's modes: the city map first
				# and the whole world part way through the run.
				#
				# In seconds, not frames, but movie-writing mode advances
				# scene time by a fixed 1/60 a frame regardless of how long
				# the frame really took -- so a six-second timer needs 360
				# rendered frames and a 60-frame run never reaches it. A
				# third of a second is frame 20.
				get_tree().create_timer(20.0 / 60.0).timeout.connect(_hud_worldmap.show_world)
		# Round 693's renderer A/B: the sun's shadows off, so a Forward+ /
		# Compatibility difference can be put on them or not. QA only.
		if OS.get_environment("SRREVAMP_QA_NOSHADOW") != "" and directional_light != null:
			directional_light.shadow_enabled = false
		if OS.get_environment("SRREVAMP_QA_NOFOG") != "":
			if world_environment != null and world_environment.environment != null:
				var env := world_environment.environment
				env.fog_enabled = false
				# The aerial-perspective haze is a separate term from the
				# fog toggle, and at the altitude an overview shot needs it
				# washes the whole city out -- which defeats the point of
				# taking one to compare against authored art.
				env.fog_aerial_perspective = 0.0
				env.fog_density = 0.0
			camera_3d.far = 40000.0
			# So is the cloud layer, and for a more interesting reason: until
			# round 628's review it was a finite dome over the player, so a
			# camera far enough up to frame a region ended up *above* the
			# clouds looking down through them. (Retail's layer is 20000
			# above the eye wherever the eye is; hidden here all the same, so
			# overview shots stay comparable.) That is the pale veil over the city in every
			# overview shot this project has taken -- correct rendering of
			# a real cloud layer, mistaken for a defect in the world for
			# long enough to be written up as one.
			if _sky_dome != null:
				_sky_dome.visible = false
			if _sun_glow != null:
				_sun_glow.visible = false
		var hide := OS.get_environment("SRREVAMP_QA_HIDE")
		if hide != "":
			_qa_hide_meshes(hide.split(","))
		var floating := OS.get_environment("SRREVAMP_QA_FLOAT")
		if floating != "":
			_qa_float_report(float(floating))
		var through := OS.get_environment("SRREVAMP_QA_THROUGH")
		if through != "":
			# Several bands in one run: the useful height is rarely known
			# in advance, and each run costs minutes.
			for spec in through.split(";"):
				if spec.strip_edges() != "":
					_qa_through_report(spec.strip_edges())
		var shots := OS.get_environment("SRREVAMP_QA_SHOTS")
		if shots != "":
			for spec in shots.split(";"):
				var parsed := _parse_shot(spec.strip_edges())
				if not parsed.is_empty():
					_qa_shots.append(parsed)
		var scan := OS.get_environment("SRREVAMP_QA_SCAN")
		if scan != "":
			_qa_scan_report(maxi(int(scan), 2))
		var columns := OS.get_environment("SRREVAMP_QA_COLUMNS")
		if columns != "":
			_qa_columns_report(columns)
		var ground_rays := OS.get_environment("SRREVAMP_QA_GROUND_RAYS")
		if ground_rays != "":
			# Armed here, fired below once the grid is in.
			_qa_ground_rays = maxi(int(ground_rays), 1)
		var qa_zone := OS.get_environment("SRREVAMP_QA_ZONE")
		if qa_zone != "":
			var target := _split_zone_target(qa_zone)
			var zone: String = target["zone"]
			_reload_zone_assets(zone)
			var coords := _parse_region_coords(_resolve_zone_region(zone))
			if target.has("local") and not coords.is_empty():
				var spot: Vector2 = target["local"]
				_place_at_region_local(coords["x"], coords["y"], spot.x, spot.y)
			_refresh_zone_label_position()

	# SRREVAMP_QA_PANELS opens named HUD windows so a render can show them.
	# Comma-separated panel ids from HudPanels.PANELS, e.g.
	# "inventory,character,skill". Opened once the world has settled, and
	# tiled rather than centred so several are visible in one shot.
	if OS.get_environment("SRREVAMP_QA_PANELS") != "" and _qa_tick == 30:
		_qa_open_panels(OS.get_environment("SRREVAMP_QA_PANELS"))

	# SRREVAMP_QA_HELP=1 opens the in-client Help window at tick 30;
	# SRREVAMP_QA_COMMANDS="/a;/b" feeds those lines through the chat console
	# at tick 60 (docs/DEBUG_TOOLS.md). Frame ticks, like every hook here: a
	# SceneTreeTimer did not fire inside a movie-writer run.
	if OS.get_environment("SRREVAMP_QA_HELP") != "" and _qa_tick == 30 and _help_window != null:
		_help_window.open()
		print("QA HELP: opened the Help window")
	if OS.get_environment("SRREVAMP_QA_COMMANDS") != "" and _qa_tick == 60:
		_run_qa_commands(OS.get_environment("SRREVAMP_QA_COMMANDS"))
	if OS.get_environment("SRREVAMP_QA_NOTICES") != "":
		_qa_notices_step(OS.get_environment("SRREVAMP_QA_NOTICES"))
	# SRREVAMP_QA_PARTY=create | join:<party id> (round 634): forms a party at
	# tick 70 through the same requests the old party panel sent, so a live
	# run can type party chat; the retail party window's invite is not built.
	var qa_party := OS.get_environment("SRREVAMP_QA_PARTY")
	if qa_party != "" and _qa_tick == 70 and NetClient.current_character_name != "":
		print("QA PARTY: %s" % qa_party)
		if qa_party == "create":
			NetClient.create_party(NetClient.current_character_name)
		elif qa_party.begins_with("join:"):
			NetClient.join_party(NetClient.current_character_name, qa_party.substr(5).to_int())
	var mob_heights := OS.get_environment("SRREVAMP_QA_MOB_HEIGHTS")
	if mob_heights != "" and mob_heights.split(",").has(str(_qa_tick)):
		_qa_mob_heights_report()
		_qa_terrain_slope_report()

	# SRREVAMP_QA_CASTANIM="<anim_base>" plays a skill's cast animation on the
	# player at tick 90 (and replays it), so a render can verify the grounded
	# Basic_Code -> .ban mapping. QA only, no target/server needed.
	if OS.get_environment("SRREVAMP_QA_CASTANIM") != "" and _qa_tick % 90 == 0 and _qa_tick > 0:
		_play_skill_cast_anim(OS.get_environment("SRREVAMP_QA_CASTANIM"))
	# ... and measures the pose it drives (round 691's merge): at eight ticks
	# of each 90 the angle of each upper arm from its bind (rest) rotation --
	# a T-pose reads ~0 on both -- and the clip playing. QA only.
	if OS.get_environment("SRREVAMP_QA_CASTANIM") != "" and _qa_tick > 90 and _qa_tick % 90 in [5, 15, 25, 35, 45, 55, 65, 75] \
			and _player_skeleton != null:
		var angles := PackedStringArray()
		for bone_name in ["Bip01 L UpperArm", "Bip01 R UpperArm"]:
			var b := _player_skeleton.find_bone(bone_name)
			if b < 0:
				angles.append("%s missing" % bone_name)
				continue
			var q := _player_skeleton.get_bone_global_pose(b).basis.get_rotation_quaternion()
			var r := _player_skeleton.get_bone_global_rest(b).basis.get_rotation_quaternion()
			angles.append("%s %.1f deg" % [bone_name, rad_to_deg(q.angle_to(r))])
		print("QA CASTPOSE tick %d body %s: %s; one-shot %s" % [_qa_tick, _player_body, ", ".join(angles),
			_player_one_shot.animation_name if _player_one_shot != null else "none"])

	# SRREVAMP_QA_TARGET=1 opens the target window on the first known monster so a
	# render can verify its real level (from characterdata) shows. QA only.
	if OS.get_environment("SRREVAMP_QA_TARGET") != "" and _qa_tick == 90 and not _monsters.is_empty():
		var m: CombatNet.MonsterSnapshot = _monsters[0]
		_monster_snapshots[m.monster_id] = m
		_show_target(m.monster_id)

	# SRREVAMP_QA_STANCE=1 keeps the player "recently in combat" so a render shows
	# the battle stance (STAND_BATTLE) instead of the town idle. QA only.
	if OS.get_environment("SRREVAMP_QA_STANCE") != "":
		_last_combat_time = _player_anim_time

	# SRREVAMP_QA_HITFX=1 plays the critical-hit slash burst on the player every
	# 90 ticks, so a render can verify the recovered hit_3_critical layers.
	if OS.get_environment("SRREVAMP_QA_HITFX") != "" and _qa_tick >= 15 and _qa_tick % 15 == 0 and player != null:
		# Exercise the real per-skill path: look the effect up in skilleffect.txt
		# by Basic_Code and play it via the generic .efp loader.
		_play_skill_hit_effect_on(player, _player_world_height(), OS.get_environment("SRREVAMP_QA_HITFX"))

	# SRREVAMP_QA_EFFECT="<efp>[;<efp>...]" (round 620) plays those Particles.pk2
	# effects on the player at tick 20, looping, spaced SRREVAMP_QA_EFFECT_SPACING
	# (default 40) native units apart along the body's X -- a render shows
	# EfpEffect drawing them. SRREVAMP_QA_CAST="<skill id>[,<id>...]" plays each
	# skill's effect phases on the player in turn, every
	# SRREVAMP_QA_CAST_PERIOD ticks (default 160) through SkillEffects' cast
	# sequencer: cast at +0 (READY now, WAIT and SHOT by the skill's timing
	# columns), shot + hit (SHOT/1) at +30, act (ACT_S) at +40 and the ACT_L
	# aura (token 1) from +41 to the next skill. Each step prints a `QA CAST` line with its tick.
	var qa_fx := OS.get_environment("SRREVAMP_QA_EFFECT")
	if qa_fx != "" and _qa_tick == 20 and player != null:
		_qa_play_effects(qa_fx)
	var qa_cast := OS.get_environment("SRREVAMP_QA_CAST")
	if qa_cast != "" and _qa_tick >= 20 and player != null:
		_qa_cast_step(qa_cast)

	# SRREVAMP_QA_HOTBAR=1 assigns two real skills to the hotbar (the same path a
	# window click takes) so a render can show their icons in the quickslots.
	# A value above 1 is the tick to do it at (default 60), for a run that
	# learns the skill first (SRREVAMP_QA_LEARN). The path refuses a skill the
	# server has not said the character knows.
	var qa_hotbar := OS.get_environment("SRREVAMP_QA_HOTBAR")
	var qa_hotbar_tick := int(qa_hotbar) if qa_hotbar.is_valid_int() and int(qa_hotbar) > 1 else 60
	if qa_hotbar != "" and _qa_tick == qa_hotbar_tick and _ui_builder != null:
		print("QA HOTBAR: assigning at tick %d (skill 3 known: %s)" % [_qa_tick,
			str(_hud_panels != null and _hud_panels.is_skill_known(3))])
		# SRREVAMP_QA_HOTBAR_SKILLS="<id>,<id>..." (round 614) assigns those
		# skills instead, in order, each with the Basic_Code its skilldata row
		# names and no icon -- a run can cast a skill with cast sounds.
		var qa_ids := OS.get_environment("SRREVAMP_QA_HOTBAR_SKILLS")
		if qa_ids != "":
			for part in qa_ids.split(",", false):
				if String(part).strip_edges().is_valid_int():
					var sid := int(String(part).strip_edges())
					var scode := String(SkillAudio.context_for(sid)["code"])
					print("QA HOTBAR: skill %d (%s), known: %s" % [sid, scode,
						str(_hud_panels != null and _hud_panels.is_skill_known(sid))])
					_on_skill_assign_requested(sid, scode, null)
		else:
			_on_skill_assign_requested(3, "SKILL_CH_SWORD_SMASH_A_01",
				_ui_builder.load_texture("icon\\skill\\china\\sword_smash_a.ddj"))
			_on_skill_assign_requested(177, "SKILL_CH_SWORD_CHAIN_A_01",
				_ui_builder.load_texture("icon\\skill\\china\\sword_chain_a.ddj"))

	# SRREVAMP_QA_HOTKEY="<tick>:<key>[,<tick>:<key>...]" presses a key at
	# each tick through the viewport's real input path (push_input), as a
	# player's key press arrives -- the number keys reach the underbar's quick
	# slots through KeyInput (the key table, KeyMap). Each press and each quick slot
	# it fires is printed (_on_quickslot_activated), so a run measures the
	# key -> quick slot -> cast chain from its log. QA only.
	var qa_hotkey := OS.get_environment("SRREVAMP_QA_HOTKEY")
	if qa_hotkey != "":
		for part in qa_hotkey.split(",", false):
			var key_at := String(part).split(":")
			if key_at.size() == 2 and key_at[0].is_valid_int() and int(key_at[0]) == _qa_tick:
				var code := OS.find_keycode_from_string(key_at[1])
				print("QA HOTKEY: pressing %s (keycode %d) at tick %d, page F%d" % [key_at[1], code, _qa_tick,
					_hud_underbar.current_page() if _hud_underbar != null else 0])
				for pressed in [true, false]:
					var ev := InputEventKey.new()
					ev.keycode = code
					ev.physical_keycode = code
					ev.pressed = pressed
					get_viewport().push_input(ev)

	# SRREVAMP_QA_INPUT: a player's clicks and keys, through push_input
	# (_qa_input_step has the syntax).
	_qa_input_step()

	# SRREVAMP_QA_LEARN="<mastery>x<n>;<skill id>[;...]" raises a mastery n
	# times and learns skills, one request after another, each waiting for
	# its reply, starting at tick 90 (after SRREVAMP_QA_COMMANDS, which can
	# give the skill points with a GM account). Each reply is printed. QA only.
	var qa_learn := OS.get_environment("SRREVAMP_QA_LEARN")
	if qa_learn != "" and _qa_tick == 90 and NetClient.is_connected_to_server():
		_qa_learn(qa_learn)

	# SRREVAMP_QA_FAKEITEMS fills the bag with sample items (real IDs) a little
	# after it opens -- past the server's empty-inventory reply -- so a render
	# can show a populated inventory. QA only.
	if OS.get_environment("SRREVAMP_QA_FAKEITEMS") != "" and _qa_tick == 50 and _hud_panels != null:
		_hud_panels.qa_fill_sample_inventory()

	# SRREVAMP_QA_TALK="<name>" opens the NPC dialogue for a render, standing
	# in for a click on an NPC (which a render cannot make).
	if OS.get_environment("SRREVAMP_QA_TALK") != "" and _qa_tick == 30 and _hud_panels != null:
		# The env value is an NPC codename (e.g. NPC_CH_SMITH) so a render shows
		# its real greeting + services; falls back to using it as a display name.
		_load_npc_tables()
		var code := OS.get_environment("SRREVAMP_QA_TALK")
		_talk_npc_name = code
		_talk_npc_code = code
		_hud_panels.open_npc_talk(code, _npc_greeting_text(code), _npc_services(code))

	# SRREVAMP_QA_SHOP="<NPC_CODE>" opens that NPC's store window for a render,
	# standing in for talk -> Buy. Shows the real goods grid + tabs.
	if OS.get_environment("SRREVAMP_QA_SHOP") != "" and _qa_tick == 40 and _hud_panels != null:
		_load_npc_tables()
		var scode := OS.get_environment("SRREVAMP_QA_SHOP")
		_talk_npc_name = scode
		_talk_npc_code = scode
		if _shop_reader != null:
			_hud_panels.open_shop(scode, _shop_reader.tabs_for(scode), scode)

	# SRREVAMP_QA_SHOP_BUY exercises the buy flow for a render: show the confirm
	# popup (proving the price + purse loaded), then actually buy (proving the
	# transaction; the purse drops and the server logs it).
	if OS.get_environment("SRREVAMP_QA_SHOP_BUY") != "" and _hud_panels != null:
		# Buy a stack, then sell part of it back -- the whole shop loop. The bag
		# opens with the shop, so the stack and the sell dialog both show.
		if _qa_tick == 55:
			_hud_panels.qa_buy_first_item()
		elif _qa_tick == 75:
			_hud_panels.qa_confirm_sell_first()
		elif _qa_tick == 90:
			_hud_panels.qa_sell_first(5)

	# SRREVAMP_QA_STORAGE (with SRREVAMP_QA_SHOP set to a shop) exercises the
	# warehouse: buy a stack into the bag, open storage, then deposit part of it.
	if OS.get_environment("SRREVAMP_QA_STORAGE") != "" and _hud_panels != null:
		if _qa_tick == 52:
			_hud_panels.qa_buy_first_item()
		elif _qa_tick == 66:
			_hud_panels.close("store")
			_hud_panels.open_storage("Warehouse Keeper")
		elif _qa_tick == 80:
			_hud_panels.qa_open_gold_dialog()
		elif _qa_tick == 92:
			_hud_panels.qa_gold_deposit(250)

	# SRREVAMP_QA_STORAGE_ITEM=1 deposits the first ITEM in the bag into the
	# warehouse (SRREVAMP_QA_MOVE="0,9" first puts the boots there): open
	# storage, the quantity dialog, then the deposit itself -- the flow a
	# playtest reported crashing the client on 2026-09-19, so a render's log
	# carries the error instead of a description of it.
	if OS.get_environment("SRREVAMP_QA_STORAGE_ITEM") != "" and _hud_panels != null:
		if _qa_tick == 120 and NetClient.is_connected_to_server():
			# Something real in the bag first: the boots, the same real OP_UNEQUIP
			# the move sequence uses (they land in the lowest free slot).
			NetClient.unequip(NetClient.current_character_name, EquipmentNet.SLOT_BOOTS)
			print("QA STORAGE_ITEM: boots unequipped into the bag")
		elif _qa_tick == 150:
			_hud_panels.open_storage("Warehouse Keeper")
			print("QA STORAGE_ITEM: storage opened")
		elif _qa_tick == 175:
			_hud_panels.qa_deposit_first()
			print("QA STORAGE_ITEM: quantity dialog for the first bag item")
		elif _qa_tick == 200:
			_hud_panels.qa_do_deposit_first(1)
			print("QA STORAGE_ITEM: deposit of 1 sent")

	# SRREVAMP_QA_NAVGAP compares each nearby object's *solid* footprint
	# against its *walkable* one. A player can stand inside anything where
	# the first is bigger than the second, so this says which objects those
	# are rather than leaving it to be discovered by falling into one.
	if OS.get_environment("SRREVAMP_QA_NAVGAP") != "" and _qa_tick == 60:
		_qa_navgap_report()

	# SRREVAMP_QA_NPCBODY fires a short horizontal ray at each nearby NPC
	# and reports whether anything stops it. "The player walks through the
	# merchants" is not something a still frame can answer, and walking into
	# one on camera to find out is exactly the kind of check this project
	# has been wrong with before.
	if OS.get_environment("SRREVAMP_QA_NPCBODY") != "" and _qa_tick == 60:
		_qa_npc_body_report()

	# Whether the idle animations are actually moving anything. A still
	# frame cannot answer that, so this samples the same skeletons at two
	# ticks and prints how far their bones travelled between them: zero
	# means the pose is being applied but nothing is changing, which is what
	# a broken animation looks like from the outside.
	if OS.get_environment("SRREVAMP_QA_ANIM") != "" and (_qa_tick == 60 or _qa_tick == 130):
		_qa_animation_report()

	if OS.get_environment("SRREVAMP_QA_LOOK") != "" and (_qa_tick == 60 or _qa_tick == 120):
		_qa_look_report()

	# Reported from a later tick, not the one-time setup block: the
	# animation is applied during the movement update, so a report taken on
	# the first frame measures the character before it has been posed at
	# all -- which it did, and produced identical output with playback on
	# and off.
	# Sampled at several ticks, so "is anything moving at all" can be read
	# off the numbers rather than inferred from a still image.
	if OS.get_environment("SRREVAMP_QA_RIG") != "" and _qa_tick in [30, 60, 90]:
		_qa_rig_report()
	# Normally one attack a game-second (60 ticks). SRREVAMP_QA_ATTACK_FAST
	# attacks every 10 ticks so a render can land enough hits to kill and level
	# within a reasonable frame budget -- a QA-only accelerant, never real play.
	var _qa_attack_interval := 10 if OS.get_environment("SRREVAMP_QA_ATTACK_FAST") != "" else 60
	# SRREVAMP_QA_ATTACK_UNTIL=<tick> ends the QA attack loop at that tick, so a
	# run can take damage and then rest (round 607's sit measurement). QA only.
	var qa_attack_until := OS.get_environment("SRREVAMP_QA_ATTACK_UNTIL")
	if _qa_attacking and qa_attack_until.is_valid_int() and _qa_tick >= int(qa_attack_until):
		_qa_attacking = false
		print("QA ATTACK: stopped at tick %d (SRREVAMP_QA_ATTACK_UNTIL)" % _qa_tick)
	if _qa_attacking and _qa_tick % _qa_attack_interval == 0 and NetClient.is_connected_to_server():
		_qa_attack_nearest()
	# SRREVAMP_QA_REVIVE_AFTER=n: n physics frames after a killing blow left
	# the player dead (_enter_dead_state), send OpRevive, as the Revive button
	# would (round 548). Once per death; never fires in real play.
	var qa_revive_after := OS.get_environment("SRREVAMP_QA_REVIVE_AFTER")
	if qa_revive_after != "" and _player_dead and not _qa_revive_sent and _qa_dead_tick >= 0 \
			and _qa_tick - _qa_dead_tick >= int(qa_revive_after) and NetClient.is_connected_to_server():
		_qa_revive_sent = true
		# SRREVAMP_QA_REVIVE_OPTION picks the button (round 665): 1, the
		# default, the return point; 2 the present point.
		var qa_option := int(OS.get_environment("SRREVAMP_QA_REVIVE_OPTION")) if OS.get_environment("SRREVAMP_QA_REVIVE_OPTION") != "" else 1
		print("QA REVIVE: sending OpRevive option %d %d frames after the death" % [qa_option, _qa_tick - _qa_dead_tick])
		_on_revive_requested(qa_option)
	if not _qa_mob_move_done and OS.get_environment("SRREVAMP_QA_MOB_MOVE") != "":
		_qa_mob_move()
	if not _qa_click_queue.is_empty():
		_qa_advance_click()
	if _qa_teleport_stage < 2 and OS.get_environment("SRREVAMP_QA_TELEPORT") != "":
		_qa_advance_teleport()

	# Not before the entry has finished loading: see _initial_load_done.
	if not _qa_shots.is_empty() and _initial_load_done:
		_qa_advance_shots()

	# SRREVAMP_QA_RECONNECT=<tick|drain> (round 558): leave and re-enter the
	# world in this process. "drain" fires on the first tick that finds the
	# entry's loading screen up WITH cells still queued -- _drain_initial_load
	# is then suspended on `await get_tree().process_frame`, which is where a
	# server redeploy lands on a tester who is still loading. The queue check
	# is round 562's: the screen is up from before the centre cell now, so
	# the first tick that finds it has an empty queue and is _ready's own
	# await, not the drain's.
	var reconnect := OS.get_environment("SRREVAMP_QA_RECONNECT")
	if reconnect != "" and ((reconnect == "drain" and _loading_screen != null \
			and (not _load_queue.is_empty() or not _cell_jobs.is_empty())) \
			or (reconnect.is_valid_int() and _qa_tick == int(reconnect))):
		# Cleared here, before it fires, so neither the next tick nor the
		# next instance arms it again. Deferred: change_scene_to_file
		# detaches this instance at once, and the first run fired it from
		# inside this very _physics_process, whose remainder then ran on a
		# detached node (ten `!is_inside_tree()` errors and a
		# `direct_space_state` on a null world) -- the hook's own artefact,
		# not the tester's path, where the drop arrives from NetClient's
		# _process, outside any World3D callback.
		OS.set_environment("SRREVAMP_QA_RECONNECT", "")
		# The tick it was armed on goes with it: the deferred call runs
		# after this tick's increment, and round 558's line read
		# `tick 201 (200, ...)`.
		call_deferred("_qa_reconnect", reconnect, _qa_tick)

	# SRREVAMP_QA_GROUND_RAYS fires ten ticks after the grid is in -- nothing
	# queued or preparing and the centre region's group in the tree -- so
	# every shape the entry built is in the physics space and the deferred
	# ground snap has run. A run signed in to a server builds the grid only
	# after the sign-in, frames after this block first ran (round 567's first
	# entry pair fired on an empty world on a fixed ten-frame timer).
	if _qa_ground_rays > 0 and _load_queue.is_empty() and _cell_jobs.is_empty() \
			and has_node("RealTerrain_%d_%d" % [_grid_centre_region.x, _grid_centre_region.y]):
		_qa_ground_rays_waited += 1
		if _qa_ground_rays_waited >= 10:
			var samples := _qa_ground_rays
			_qa_ground_rays = 0
			_qa_ground_rays_report(samples)

	# SRREVAMP_QA_ARRIVAL_PROBE (round 690): the entry's arrival once its
	# load is done, then each zone change's (armed in _on_change_zone_result).
	if _qa_arrival_probe_enabled():
		if not _qa_arrival_entry_armed and _initial_load_done:
			_qa_arrival_entry_armed = true
			_qa_arm_arrival_probe("entry")
		if _qa_arrival_probe_at >= 0 and _qa_tick >= _qa_arrival_probe_at \
				and _load_queue.is_empty() and _cell_jobs.is_empty():
			_qa_arrival_probe_at = -1
			_qa_arrival_probe()

	_qa_tick += 1
	if _qa_pmi_spec != "":
		_qa_pmi_step()
	_qa_video_step()
	# The load summary every ten seconds of game time (round 561): the window
	# since the last one, so the play after the entry -- a boundary crossing
	# -- is reported apart from the entry itself. _qa_step runs for every
	# player, so a real player's log carries it too: log-only and bounded
	# (the window restarts each summary), like the `QA <tick> local` line
	# below.
	if _qa_tick % 600 == 0:
		print(_load_timings.summary())
		# The readers' table for the same window (round 670): a boundary
		# crossing's parse time, apart from the entry's.
		if ParseProfile.enabled:
			print(ParseProfile.report("window"))
			ParseProfile.reset()
	if _qa_tick % 60 == 0:
		var where := "off-region"
		var standing := ""
		if not pair.is_empty():
			var l := (pair[1] as Node3D).to_local(player.global_position)
			where = "%d, %d, %d" % [l.x, l.y, l.z]
			# What the walkable graph thinks is underfoot, and how far the
			# player actually is from it -- the question when someone
			# reports walking *underneath* something they should be on top
			# of.
			var graph: NavGraph = pair[0]
			var surface := graph.surface_at(l.x, l.z, l.y)
			# The footing the walk itself carries (see _move_on_nav_graph),
			# which is what decides whose walls apply; the height query is
			# only the fallback when the walk has not run on this graph yet.
			var what := "terrain"
			if _nav_footing_graph == graph:
				what = _nav_footing_name(graph, _nav_footing)
			elif not surface.is_terrain:
				what = _nav_footing_name(graph, surface.object_index)
			standing = "  on %s at %.1f (%.1f below feet)" % [what, surface.height, l.y - surface.height]

			# What the walkable graph says and what is actually *drawn*
			# there are two different questions, and this project has been
			# caught by that before -- an earlier float report measured the
			# navmesh and called it the terrain. A ray straight down through
			# the real collision answers the second one, so a disagreement
			# between them shows up as a number instead of as a player
			# standing waist-deep in a plaza.
			var space := get_world_3d().direct_space_state
			var from := player.global_position + Vector3(0, 200, 0)
			# Off the heightfield's grid lines (TerrainCollision.vertical_ray,
			# round 572).
			var hit := TerrainCollision.vertical_ray(space, from.x, from.z, from.y, from.y - 800.0,
				TERRAIN_COLLISION_LAYER, [player.get_rid()])
			if hit.is_empty():
				standing += "  drawn surface: none found"
			else:
				var drawn_local: float = (pair[1] as Node3D).to_local(hit.position).y
				# Name what was hit. "Something is 13.8 above the graph" is
				# not actionable; "cj_jang_square is 13.8 above the graph"
				# says whether the walkable graph is missing that object's
				# navigation mesh or the object is simply overhead.
				var what_drawn := "?"
				var collider = hit.get("collider")
				if collider is Node:
					var n: Node = collider
					while n != null and not (n.name as String).begins_with("Obj_"):
						n = n.get_parent()
					what_drawn = String(n.name) if n != null else String((collider as Node).name)
				standing += "  drawn %s at %.1f (%.1f above the graph's)" % [
					what_drawn, drawn_local, drawn_local - surface.height]
		print("QA %4d local %s%s" % [_qa_tick, where, standing])

## Viewpoints still to visit this run, and where the current one is up to.
## See _qa_advance_shots.
var _qa_shots: Array = []
var _qa_shot_index := -1
var _qa_shot_frames := 0

## How many frames a viewpoint is held before and after its frame is
## announced -- enough for streaming and the camera arm to settle.
const QA_SHOT_SETTLE := 12
const QA_SHOT_HOLD := 16

## Parses one `name@x,z:yaw,pitch,dist` viewpoint. Everything after the
## position is optional.
static func _parse_shot(spec: String) -> Dictionary:
	if spec == "":
		return {}
	var name := "shot"
	var rest := spec
	var at := spec.find("@")
	if at >= 0:
		name = spec.substr(0, at).strip_edges()
		rest = spec.substr(at + 1)
	var camera := ""
	var colon := rest.find(":")
	if colon >= 0:
		camera = rest.substr(colon + 1)
		rest = rest.substr(0, colon)
	var pos := rest.split(",")
	if pos.size() < 2 or not pos[0].strip_edges().is_valid_float() or not pos[1].strip_edges().is_valid_float():
		return {}
	var out := {"name": name, "x": float(pos[0]), "z": float(pos[1])}
	var cam := camera.split(",") if camera != "" else PackedStringArray()
	var keys := ["yaw", "pitch", "dist"]
	for i in range(mini(cam.size(), keys.size())):
		if cam[i].strip_edges().is_valid_float():
			out[keys[i]] = float(cam[i])
	return out

## SRREVAMP_QA_RECONNECT (round 558): leave the world and come back in this
## process, the tester's reconnect. Direct: drop the socket without letting
## `disconnected` send this instance to Login, and change scene straight
## back to World3D -- the new instance's _ready signs in again (QaSignIn)
## and re-arms every SRREVAMP_QA_* hook from the unchanged environment.
## Until round 560 this route was what isolated this script's `static var`s
## (_ground_texture_cache, _water_frames_cache, _environment_table and
## their load flags), which outlived the instance; they are instance state
## now, and _exit_tree frees or resets everything else the instance owned
## outside the tree, so the two routes differ only in the front-end
## screens. Via Login: the same call NetClient._process makes when the
## peer drops (disconnect_from_server -> `disconnected` -> _on_disconnected
## -> Login), with Login and CharacterSelect signing back in under
## SRREVAMP_QA_RECONNECT_VIA_LOGIN. The env var was cleared when _qa_step
## armed this, so the next instance does not fire again; the entry count
## lives in SRREVAMP_QA_ENTRY, never in this script, because what this
## script keeps across entries is what is under measurement. Server side
## there is no per-character dedupe: the first socket's entity leaves
## through WorldDisconnectHandler -> hub.Leave when the gateway sees the
## close, so two QaTester entities can coexist briefly.
func _qa_reconnect(when: String, armed_tick: int) -> void:
	var via_login := OS.get_environment("SRREVAMP_QA_RECONNECT_VIA_LOGIN") != ""
	print("QA RECONNECT: leaving the world at frame %d, tick %d (%s, route %s, entry %d, %d cells still queued, %d preparing)" % [
		Engine.get_frames_drawn(), armed_tick, when, "login" if via_login else "direct", _qa_entry, _load_queue.size(), _cell_jobs.size()])
	if via_login:
		NetClient.disconnect_from_server()
		return
	if NetClient.disconnected.is_connected(_on_disconnected):
		NetClient.disconnected.disconnect(_on_disconnected)
	NetClient.disconnect_from_server()
	get_tree().change_scene_to_file("res://scenes/World3D.tscn")

## One `QA ENTRY <n> loaded ...` line per world entry, printed beside `region
## grid loaded` when SRREVAMP_QA_ENTRY is set (round 558): the renderer's
## texture, buffer and video memory; the object, node, orphan-node and
## resource counts and static memory; the root viewport's debug_draw (the
## one cross-instance state that paints every surface white by itself --
## DEBUG_DRAW_LIGHTING, set only by debug_panel._on_draw_mode_selected, and
## reset by _exit_tree since round 560); this world's ground, water and
## environment caches with their cached-null count (per instance since
## round 560, so entry 2 starts empty and refills -- statics until then,
## when entry 2 began with entry 1's 43); the world's scenery template and
## texture caches (round 559: with them owned per world, the orphan count
## no longer doubles between entries); and the baked-light and fog inputs
## the centre cell was built with. Then one `QA TEXPROBE <n> surface <i>
## ...` line per surface material of the centre cell's terrain
## (RealTerrain_<x>_<y>/SubPatch, built by
## MapmTerrainBuilder._textured_surfaces_from_cells: surface 0 the flat
## base, then one per texture pass): whether its albedo texture is set, its
## RID valid, its size, the mean of 64 texels read back from the renderer,
## the material's shading mode and albedo colour, and the min and mean of
## the surface's baked vertex colours. Growth between two entries' lines is
## the leak measurement; a white pass 2 with rid_valid=true and intact
## texel means says the texture is alive and the cause is downstream of it.
## A zone change drains through the same function once the entry is done,
## so its lines read `QA ENTRY <n> zone loaded` / `QA TEXPROBE <n> zone
## surface` and a count of `QA ENTRY <n> loaded` lines stays one per entry.
func _qa_print_entry_probe() -> void:
	if _qa_entry <= 0:
		return
	var tag := "zone " if _initial_load_done else ""
	var nulls := 0
	for tex in _ground_texture_cache.values():
		if tex == null:
			nulls += 1
	var env: Environment = world_environment.environment if world_environment != null else null
	print("QA ENTRY %d %sloaded: frame %d tex_mem=%d buf_mem=%d video_mem=%d objects=%d nodes=%d orphans=%d resources=%d static_mem=%d debug_draw=%d cache_ground=%d cache_ground_nulls=%d cache_water_frames=%d water_attempted=%s env_table=%s light_ready=%s light_diffuse=%s terrain_ambient=%s fog_enabled=%s fog_color=%s fog_density=%s object_templates=%d object_textures=%d dxt1_alpha_rgba8=%d dxt1_alpha_bytes=%d" % [
		_qa_entry, tag, Engine.get_frames_drawn(),
		RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TEXTURE_MEM_USED),
		RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_BUFFER_MEM_USED),
		RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_VIDEO_MEM_USED),
		int(Performance.get_monitor(Performance.OBJECT_COUNT)),
		int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)),
		int(Performance.get_monitor(Performance.OBJECT_ORPHAN_NODE_COUNT)),
		int(Performance.get_monitor(Performance.OBJECT_RESOURCE_COUNT)),
		int(Performance.get_monitor(Performance.MEMORY_STATIC)),
		get_viewport().debug_draw,
		_ground_texture_cache.size(), nulls, _water_frames_cache.size(), str(_water_frames_load_attempted),
		"loaded" if _environment_table != null else ("attempted" if _environment_load_attempted else "none"),
		str(_env_light_ready), str(_env_light_diffuse), str(_env_terrain_ambient),
		str(env.fog_enabled) if env != null else "no-env",
		str(env.fog_light_color) if env != null else "no-env",
		str(env.fog_density) if env != null else "no-env",
		_object_templates.size() if _object_templates != null else 0, _object_textures.size(),
		DdjReader.dxt1_alpha_decoded, DdjReader.dxt1_alpha_bytes])
	if not _grid_has_origin:
		print("QA TEXPROBE %d: no region grid origin -- nothing to probe" % _qa_entry)
		return
	var patch := get_node_or_null("RealTerrain_%d_%d/SubPatch" % [_grid_centre_region.x, _grid_centre_region.y]) as MeshInstance3D
	if patch == null or patch.mesh == null:
		print("QA TEXPROBE %d: no RealTerrain_%d_%d/SubPatch to probe" % [_qa_entry, _grid_centre_region.x, _grid_centre_region.y])
		return
	var mesh: Mesh = patch.mesh
	for i in range(mesh.get_surface_count()):
		var arrays := mesh.surface_get_arrays(i)
		var colors := PackedColorArray()
		if arrays.size() > Mesh.ARRAY_COLOR and arrays[Mesh.ARRAY_COLOR] != null:
			colors = arrays[Mesh.ARRAY_COLOR]
		var vcol_min := 1.0
		var vcol_sum := 0.0
		for c: Color in colors:
			var luma: float = (c.r + c.g + c.b) / 3.0
			vcol_min = minf(vcol_min, luma)
			vcol_sum += luma
		var vcol_mean := vcol_sum / float(maxi(colors.size(), 1))
		var mat := mesh.surface_get_material(i) as StandardMaterial3D
		if mat == null:
			print("QA TEXPROBE %d %ssurface %d: no StandardMaterial3D (material_override %s) vcol_min=%.3f vcol_mean=%.3f verts=%d" % [
				_qa_entry, tag, i, str(patch.material_override != null), vcol_min, vcol_mean, colors.size()])
			continue
		var tex := mat.albedo_texture
		var line := "QA TEXPROBE %d %ssurface %d: tex=%s" % [_qa_entry, tag, i, str(tex != null)]
		if tex != null:
			line += " rid_valid=%s size=%dx%d texel_mean=%s" % [
				str(tex.get_rid().is_valid()), tex.get_width(), tex.get_height(), _qa_texel_mean(tex)]
		line += " shading=%d albedo=%s vcol_albedo=%s transparency=%d vcol_min=%.3f vcol_mean=%.3f verts=%d" % [
			mat.shading_mode, str(mat.albedo_color), str(mat.vertex_color_use_as_albedo), mat.transparency,
			vcol_min, vcol_mean, colors.size()]
		print(line)

## The mean colour of 64 texels of `tex` on an 8x8 grid, read back from the
## renderer (Texture2D.get_image is RenderingServer.texture_2d_get, so a
## texture the GPU no longer holds reads as "no-image"), decompressed first
## because the Tile2D ground textures are DXT1 (round 252). The number to
## hold it against is round 252's decoded top-mip mean of the same kind --
## Jangan's c_marble_jang_02 (0.40, 0.38, 0.31) -- a texel mean, never a
## rendered frame's.
func _qa_texel_mean(tex: Texture2D) -> String:
	var img := tex.get_image()
	if img == null or img.is_empty():
		return "no-image"
	if img.is_compressed() and img.decompress() != OK:
		return "undecompressable(format %d)" % img.get_format()
	var sum := Color(0.0, 0.0, 0.0, 0.0)
	for gy in range(8):
		for gx in range(8):
			sum += img.get_pixel(gx * img.get_width() / 8, gy * img.get_height() / 8)
	return "(%.2f, %.2f, %.2f)" % [sum.r / 64.0, sum.g / 64.0, sum.b / 64.0]

## SRREVAMP_QA_OBJECTS (round 643): every placed map object whose node name
## contains one of `fragments`, measured -- `QA OBJECT <shot> <name> key
## <owner x>/<owner y>#<uid> held by <region> (listed by N) at world (x, y,
## z) region-local (x, z) of <region>: P piece(s), T triangle(s), visible
## <bool>, in frustum <bool>, <d> from the camera` -- or `QA OBJECT <shot>
## <fragment>: none placed`. The triangles are the drawn surfaces' own
## index counts, not a picture.
func _qa_objects_report(shot: String, fragments: PackedStringArray) -> void:
	var found := {}
	for key in _placed_objects:
		var held: Dictionary = _placed_objects[key]
		var node: Node3D = held["node"]
		if not is_instance_valid(node) or not node.is_inside_tree():
			continue
		var node_name := String(node.name)
		var hit := ""
		for f in fragments:
			if node_name.contains(f):
				hit = f
		if hit == "":
			continue
		found[hit] = true
		var pieces := 0
		var tris := 0
		var in_frustum := false
		for mesh_node in node.find_children("*", "MeshInstance3D", true, false):
			var mi := mesh_node as MeshInstance3D
			if mi.mesh == null:
				continue
			pieces += 1
			for si in range(mi.mesh.get_surface_count()):
				var arrays := mi.mesh.surface_get_arrays(si)
				var idx: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
				tris += idx.size() / 3 if not idx.is_empty() else (arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array).size() / 3
			var aabb := mi.global_transform * mi.mesh.get_aabb()
			for corner in range(8):
				if camera_3d.is_position_in_frustum(aabb.get_endpoint(corner)):
					in_frustum = true
		var holder := String(held["holder"])
		var group := get_node_or_null("RealTerrain" + holder) as Node3D
		var local := group.to_local(node.global_position) if group != null else Vector3.INF
		var owner_region := (int(key) >> 16) & 0xFFFF
		print("QA OBJECT %s %s key %d/%d#%d held by %s (listed by %d) at world (%.1f, %.1f, %.1f) region-local (%.1f, %.1f) of %s: %d piece(s), %d triangle(s), visible %s, in frustum %s, %.0f from the camera" % [
			shot, node_name, owner_region >> 8, owner_region & 0xFF, int(key) & 0xFFFF, holder.trim_prefix("_"),
			(held["listers"] as Dictionary).size(), node.global_position.x, node.global_position.y, node.global_position.z,
			local.x, local.z, holder.trim_prefix("_"), pieces, tris, node.is_visible_in_tree(), in_frustum,
			camera_3d.global_position.distance_to(node.global_position)])
	for f in fragments:
		if not found.has(f):
			print("QA OBJECT %s %s: none placed" % [shot, f])

## Walks a run through several viewpoints, announcing the movie frame each
## one lands on.
##
## Startup dominates a screenshot run -- about 65 seconds of loading
## against 0.33 seconds a frame -- so taking six pictures as six runs pays
## that cost six times. This pays it once: the run visits each viewpoint in
## turn, holds it long enough to settle, and prints
## `QA SHOT <name> frame <n>`, so the caller pulls frame n from the movie
## sequence for each. No separate capture path is needed, which matters
## because manual viewport capture has its own history of returning blank
## images in this project.
func _qa_advance_shots() -> void:
	# Announce once the camera has had QA_SHOT_SETTLE frames to arrive, so
	# the frame named is one worth pulling.
	if _qa_shot_index >= 0 and _qa_shot_frames == QA_SHOT_HOLD:
		print("QA SHOT %s frame %d" % [
			_qa_shots[_qa_shot_index]["name"], Engine.get_frames_drawn()])
		# The grid's bookkeeping and the process's object and memory counts
		# at the same moment (round 563), on a line of their own so the `QA
		# SHOT <name> frame <n>` contract above is untouched: a tour that
		# crosses region boundaries shows the per-region caches bounded by
		# the window instead of growing with every region ever visited.
		var under := _nav_graph_for(player.global_position)
		var where := "off-region"
		if not under.is_empty():
			var local := (under[1] as Node3D).to_local(player.global_position)
			where = "%s local %.0f,%.0f" % [String((under[1] as Node3D).name).trim_prefix("RealTerrain_"), local.x, local.z]
		print("QA GRID %s frame %d at %s: %s object_templates=%d objects=%d orphans=%d static_mem=%d" % [
			_qa_shots[_qa_shot_index]["name"], Engine.get_frames_drawn(), where, _grid.counts_line(),
			_object_templates.size() if _object_templates != null else 0,
			int(Performance.get_monitor(Performance.OBJECT_COUNT)),
			int(Performance.get_monitor(Performance.OBJECT_ORPHAN_NODE_COUNT)),
			int(Performance.get_monitor(Performance.MEMORY_STATIC))])
		var wanted := OS.get_environment("SRREVAMP_QA_OBJECTS")
		if wanted != "":
			_qa_objects_report(_qa_shots[_qa_shot_index]["name"], wanted.split(",", false))
		if OS.get_environment("SRREVAMP_QA_PLATES") != "":
			_qa_plates_report(_qa_shots[_qa_shot_index]["name"])
	_qa_shot_frames -= 1
	if _qa_shot_frames > 0:
		return

	_qa_shot_index += 1
	if _qa_shot_index >= _qa_shots.size():
		print("QA SHOT: all %d viewpoints visited" % _qa_shots.size())
		_qa_shots.clear()
		return

	var shot: Dictionary = _qa_shots[_qa_shot_index]
	var pair := _nav_graph_for(player.global_position)
	if not pair.is_empty():
		var graph: NavGraph = pair[0]
		var group: Node3D = pair[1]
		var lx: float = shot["x"]
		var lz: float = shot["z"]
		# Same as the initial placement: a viewpoint jump is an arrival.
		player.global_position = group.to_global(Vector3(lx, graph.landing_height_at(lx, lz), lz))
		player.velocity = Vector3.ZERO
	if shot.has("dist"):
		camera_arm.spring_length = shot["dist"]
	if shot.has("yaw") or shot.has("pitch"):
		camera_arm.rotation_degrees = Vector3(
			shot.get("pitch", camera_arm.rotation_degrees.x),
			shot.get("yaw", camera_arm.rotation_degrees.y), 0.0)
	_qa_shot_frames = QA_SHOT_SETTLE + QA_SHOT_HOLD

## SRREVAMP_QA_PLATES=1 (round 673): at each QA SHOT, one `QA PLATE` line per
## monster body and one for the player -- the name plate's distance from the
## camera and from the player, where it projects on screen, and whether the
## node is shown -- so a frame crop can count the plate's own pixels there.
func _qa_plates_report(shot: String) -> void:
	var cam := get_viewport().get_camera_3d()
	if cam == null:
		return
	var plates: Array = []
	for monster_id in _monster_bodies:
		var body = _monster_bodies[monster_id]
		if is_instance_valid(body):
			plates.append(["monster %d" % monster_id, body, (body as Node3D).get_node_or_null("Label")])
	plates.append(["player 0", player, player.get_node_or_null("Name")])
	for entry in plates:
		var label := entry[2] as Label3D
		if label == null:
			continue
		var at := label.global_position
		var sp := cam.unproject_position(at)
		print("QA PLATE %s %s cam=%.1f player=%.1f screen=%.0f,%.0f ahead=%s shown=%s range_end=%.0f text=%s" % [
			shot, entry[0], cam.global_position.distance_to(at),
			(entry[1] as Node3D).global_position.distance_to(player.global_position), sp.x, sp.y,
			"yes" if not cam.is_position_behind(at) else "no", "yes" if label.is_visible_in_tree() else "no",
			label.visibility_range_end, label.text])

## Reports where each piece of the assembled character actually is,
## against where its own bone is.
##
## The skeleton itself is known to pose correctly -- see
## client/tools/check_ban_pose.gd, which puts the hands below the head
## after a frame -- while the assembled character renders with its arms
## overhead. That can only be the attachment, and the attachment's
## arithmetic looks right on paper, so this measures it instead of
## reasoning about it: for every piece, where the bone is, where the piece
## ended up, and how far apart they are.
var _qa_attacking := false
var _qa_alternate_flip := false
## SRREVAMP_QA_ATTACK_RETREAT: the first landed blow is still to come.
var _qa_retreat_pending := OS.get_environment("SRREVAMP_QA_ATTACK_RETREAT") != ""
## SRREVAMP_QA_ATTACK_GOTO with a server: the monster the next list result
## stands the player beside (QaAttackGoto), -1 when no GOTO is waiting.
var _qa_goto_pending_id := -1
## SRREVAMP_QA_REVIVE_AFTER (round 548): the tick a killing blow left the
## player dead (-1: never), and whether that death's OpRevive has gone out.
var _qa_dead_tick := -1
var _qa_revive_sent := false

## SRREVAMP_QA_ATTACK_RETREAT=n (round 546): the first blow has landed on
## `monster`, so walk n units straight back from it -- the click-to-move walk,
## whose OpMove ends this player's keep-up (session/world.go handleMove) -- and
## stop the QA attack loop, so a server with -monster-battle has to chase the
## player to its band before it can swing. One retreat a run.
func _qa_retreat(monster: int) -> void:
	_qa_retreat_pending = false
	_qa_attacking = false
	var units := float(OS.get_environment("SRREVAMP_QA_ATTACK_RETREAT"))
	var body = _monster_bodies.get(monster)
	var away := Vector3(1.0, 0.0, 0.0)
	if body != null and is_instance_valid(body):
		var d := player.global_position - (body as Node3D).global_position
		d.y = 0.0
		if not d.is_zero_approx():
			away = d.normalized()
	var spot := player.global_position + away * units
	spot.y = _terrain_height_at(spot)
	_drop_pending_attack()
	_move_target = spot
	_has_move_target = true
	_move_heading_run = false
	print("QA ATTACK: retreating %.0f from monster %d to %.1f,%.1f,%.1f; no more swings" % [
		units, monster, spot.x, spot.y, spot.z])

## Attacks whichever live monster is nearest the player -- the same
## request the Attack button sends -- so the combat animations can be
## rendered without a hand on the mouse.
func _qa_attack_nearest() -> void:
	if _player_dead:
		return
	var nearest_id := -1
	var nearest := INF
	# SRREVAMP_QA_ATTACK_NAME narrows the pick to monsters whose name plate
	# contains it (the nearest monster to the spawn is a Yeoha that kills a
	# fresh character; a drop test wants a Mangyang).
	var wanted := OS.get_environment("SRREVAMP_QA_ATTACK_NAME")
	var candidates: Array = []  # [distance, id], nearest first
	for monster_id in _monster_bodies:
		if _dying_until.has(monster_id):
			continue
		var body: Node3D = _monster_bodies[monster_id]
		if not is_instance_valid(body):
			continue
		if wanted != "":
			var plate: Label3D = body.get_node_or_null("Label")
			if plate == null or not plate.text.contains(wanted):
				continue
		var d := body.global_position.distance_to(player.global_position)
		candidates.append([d, monster_id])
	if candidates.is_empty():
		return
	candidates.sort_custom(func(a, b): return float(a[0]) < float(b[0]))
	nearest = float(candidates[0][0])
	nearest_id = int(candidates[0][1])
	# SRREVAMP_QA_ATTACK_ALTERNATE=1 swings at the nearest and the second
	# nearest in turn, so the target changes between a swing and its landing
	# -- the situation that made the wrong monster animate (round on the
	# result's monster id). With one candidate it degrades to the nearest.
	if OS.get_environment("SRREVAMP_QA_ATTACK_ALTERNATE") != "" and candidates.size() > 1:
		_qa_alternate_flip = not _qa_alternate_flip
		if _qa_alternate_flip:
			nearest = float(candidates[1][0])
			nearest_id = int(candidates[1][1])
	# SRREVAMP_QA_ATTACK_GOTO=1 stands the player a few units from the target
	# first (a QA teleport, no collision), so the frames -- and any drop --
	# are in front of the camera rather than 2,000 units away.
	#
	# With a server, not beside the drawn body: under qa_shot's time dilation
	# a walking monster is drawn up to RESYNC_DISTANCE from where the server
	# has it (live check 2 measured two targets 20.7 and 24.7 away), so a
	# swing from beside the drawn body can be out of reach. So on every swing the
	# list is asked for, and the next list result to arrive -- that request's
	# reply, or an earlier periodic request's still in flight; _qa_goto_plan
	# takes the next result and does not track the request, and either is a
	# server snapshot newer than the drawn body -- stands the player beside the
	# position it listed -- unless the player already stands there -- and
	# swings (_qa_goto_from_list, round 539). Every swing, not only when the
	# drawn body is more than 12 away: that distance is the stale one, both
	# ways.
	if OS.get_environment("SRREVAMP_QA_ATTACK_GOTO") != "" and NetClient.is_connected_to_server():
		_qa_goto_pending_id = nearest_id
		print("QA ATTACK: asking for the monster list to stand beside monster %d where the server has it (drawn %.0f away)" % [
			nearest_id, nearest])
		NetClient.list_monsters()
		return
	if OS.get_environment("SRREVAMP_QA_ATTACK_GOTO") != "" and nearest > 12.0:
		var target: Node3D = _monster_bodies[nearest_id]
		var spot := target.global_position + Vector3(8.0, 0.0, 0.0)
		spot.y = _terrain_height_at(spot)
		player.global_position = spot
		player.velocity = Vector3.ZERO
		NetClient.move_to(player.position.x, player.position.y, player.position.z, _position_relocated())
		# Recorded as sent, so _attack_monster's _flush_position does not send
		# the same OpMove a second time.
		_last_sent_pos = player.position
		_walked_since_send = 0.0
		_time_since_send = 0.0
		nearest = target.global_position.distance_to(player.global_position)
		print("QA ATTACK: moved next to monster %d at %.1f,%.1f,%.1f" % [nearest_id, spot.x, spot.y, spot.z])
	print("QA ATTACK: monster %d at %.0f" % [nearest_id, nearest])
	_last_attack_target = nearest_id
	_show_target(nearest_id)
	_ring_on_monster(nearest_id)
	_attack_monster(nearest_id)

## The GOTO half of a list result (round 539): which monster, and where to
## stand, from the list's OWN positions -- so this runs before
## _sync_monster_bodies, which rewrites a walking monster's listed x/z into
## its drawn position (MonsterMotion.reconcile). {} when no GOTO is waiting
## or the list has no such monster.
func _qa_goto_plan(fresh: Array) -> Dictionary:
	if _qa_goto_pending_id == -1:
		return {}
	var preferred := _qa_goto_pending_id
	_qa_goto_pending_id = -1
	var m := QaAttackGoto.pick(fresh, preferred, OS.get_environment("SRREVAMP_QA_ATTACK_NAME"),
		player.global_position, _dying_until)
	if m == null:
		print("QA ATTACK: the fresh list has no monster to stand beside (wanted %d)" % preferred)
		return {}
	return {"id": m.monster_id, "at": Vector3(m.x, m.y, m.z), "spot": QaAttackGoto.stand_spot(m)}

## Stands the player beside where the server listed the monster and swings
## from there. The swing goes out at once (_flush_position, then
## _send_attack), not through _attack_monster: that would measure the reach
## to the DRAWN body, which under the dilation can be up to RESYNC_DISTANCE
## from the listed position, and walk toward it. The server measures the
## swing against where the monster is when it arrives: the list's position
## plus however far it walked in between, which only a live run shows.
##
## A player already on the stand spot is not moved (QaAttackGoto.needs_teleport:
## a move would cancel the keep-up holding the monster). One who is, is settled
## onto the walkable graph at once, as the next physics frame would do: the
## graph's height is not the terrain ray's, and the OpMove that frame sent
## after the swing would cancel the keep-up the swing starts.
func _qa_goto_from_list(plan: Dictionary) -> void:
	var monster_id := int(plan["id"])
	var at: Vector3 = plan["at"]
	var spot: Vector3 = plan["spot"]
	_drop_pending_attack()
	var drawn := -1.0
	var body = _monster_bodies.get(monster_id)
	if body != null and is_instance_valid(body):
		drawn = Vector2((body as Node3D).global_position.x, (body as Node3D).global_position.z).distance_to(Vector2(at.x, at.z))
	if QaAttackGoto.needs_teleport(player.global_position, spot):
		spot.y = _terrain_height_at(spot)
		player.global_position = spot
		player.velocity = Vector3.ZERO
		_move_on_nav_graph(0.0)
		print("QA ATTACK: moved next to monster %d as listed at %.1f,%.1f (drawn %.1f from there), standing %.1f away" % [
			monster_id, at.x, at.z, drawn,
			Vector2(player.global_position.x, player.global_position.z).distance_to(Vector2(at.x, at.z))])
	else:
		print("QA ATTACK: already beside monster %d as listed at %.1f,%.1f (drawn %.1f from there) -- not moved" % [
			monster_id, at.x, at.z, drawn])
	_last_attack_target = monster_id
	_show_target(monster_id)
	_ring_on_monster(monster_id)
	_flush_position()
	_send_attack(monster_id, 0, "")

## SRREVAMP_QA_MOB_HEIGHTS (round 572): every monster body's drawn height
## against the ground under it now, three ways. The terrain ray is the one
## the game places a body with (TerrainCollision.vertical_ray on the
## terrain-only layer, the stand-in floors excluded) fired by the report at
## the body's drawn x/z, with no lift -- a body placed on the terrain stands
## 0.05 * PLAYER_SCALE_RATIO above it -- and names the region whose collider
## answered (or the node, if something else did). The plain ray is a
## straight PhysicsRayQueryParameters3D at the exact column, the ray before
## the helper: it can come back `none` on a heightfield grid line (it did at
## 7 of the 9 Jangan bodies on 97/168's grid vertices, and at none of the 10
## on exactly one line). The drawn mesh is TerrainCollision.mesh_height_at
## over the region's parsed heightmap -- the drawn triangle's height, no
## physics at all.
func _qa_mob_heights_report() -> void:
	var space := get_world_3d().direct_space_state
	var held := {}
	for monster_id in _monster_bodies:
		var body = _monster_bodies[monster_id]
		if body == null or not is_instance_valid(body):
			continue
		var p: Vector3 = (body as Node3D).global_position
		var hit := TerrainCollision.vertical_ray(space, p.x, p.z, p.y + 1000.0, p.y - 1000.0,
			TERRAIN_ONLY_COLLISION_MASK, _stand_in_floor_rids())
		var query := PhysicsRayQueryParameters3D.create(p + Vector3(0.0, 1000.0, 0.0), p + Vector3(0.0, -1000.0, 0.0))
		query.collision_mask = TERRAIN_ONLY_COLLISION_MASK
		query.exclude = _stand_in_floor_rids()
		var plain := space.intersect_ray(query)
		var mesh := _qa_drawn_mesh_height(p, held)
		var ray_text := "none"
		if not hit.is_empty():
			var who := "?"
			var node = hit.get("collider")
			while node is Node:
				if String((node as Node).name).begins_with("RealTerrain_"):
					who = String((node as Node).name).trim_prefix("RealTerrain_").replace("_", "/")
					break
				node = (node as Node).get_parent()
			if who == "?" and hit.get("collider") is Node:
				who = "NOT TERRAIN: %s" % String((hit["collider"] as Node).name)
			ray_text = "%.2f on %s (drawn %.2f above it)" % [hit.position.y, who, p.y - hit.position.y]
		var snap = _monster_snapshots.get(monster_id)
		print("QA MOB HEIGHT tick %d frame %d: monster %d %s at (%.1f, %.1f) drawn y %.2f, terrain ray %s, plain ray %s, drawn mesh %s%s" % [
			_qa_tick, Engine.get_frames_drawn(), monster_id, snap.monster_name if snap != null else "?", p.x, p.z, p.y,
			ray_text, "none" if plain.is_empty() else "%.2f" % plain.position.y,
			"none" if mesh.is_empty() else "%.2f (%s)" % [mesh[0], mesh[1]],
			", waiting for ground" if _monster_heights_pending.has(monster_id) else ""])

## The drawn terrain's height at world p's x/z: the first loaded region group
## whose 1920-square holds it, its parsed heightmap (_grid.parsed_heightmaps)
## and TerrainCollision.mesh_height_at -- [height, "rx/ry"], or [] when no
## held region covers p. `held` caches each region's height grid for one
## report.
func _qa_drawn_mesh_height(p: Vector3, held: Dictionary) -> Array:
	for child in get_children():
		if not (child is Node3D) or not String(child.name).begins_with("RealTerrain_"):
			continue
		var g := child as Node3D
		var local := g.to_local(p)
		if local.x < 0.0 or local.z < 0.0 or local.x > REGION_SPAN or local.z > REGION_SPAN:
			continue
		var parts := String(g.name).trim_prefix("RealTerrain_").split("_")
		if parts.size() != 2:
			continue
		if not held.has(g.name):
			held[g.name] = TerrainCollision.heights_from_region(
				_grid.parsed_heightmaps.get(RegionGridState.region_key(int(parts[0]), int(parts[1]))))
		var heights: PackedFloat32Array = held[g.name]
		var h := TerrainCollision.mesh_height_at(heights, local.x, local.z)
		if is_nan(h):
			continue
		return [g.to_global(Vector3(local.x, h, local.z)).y, "%s/%s" % [parts[0], parts[1]]]
	return []

## Region name -> [the steepest triangle's |dh/dx| + |dh/dz|, its quad] for
## _qa_terrain_slope_report, so each region's 18,432 triangles are read once.
var _qa_slopes := {}

## SRREVAMP_QA_MOB_HEIGHTS' second report (round 572): for every loaded
## region with a parsed heightmap, the steepest of the drawn mesh's
## triangles, as |dh/dx| + |dh/dz| over the triangle -- the most a height
## read RAY_GRID_EPSILON off on each axis (TerrainCollision.vertical_ray) can
## differ from the height at the exact column. The mesh's own split
## (TerrainCollision.mesh_height_at): [i00, i10, i11] rises (h10 - h00) along
## x and (h11 - h10) along z, [i00, i11, i01] (h11 - h01) and (h01 - h00),
## over a TILE_SIZE run. One line per region the first time a report sees
## it, then the steepest over every region seen so far.
func _qa_terrain_slope_report() -> void:
	var tile := MapmTerrainBuilder.TILE_SIZE
	var side := TerrainCollision.SIDE
	for child in get_children():
		if not (child is Node3D) or not String(child.name).begins_with("RealTerrain_"):
			continue
		var parts := String(child.name).trim_prefix("RealTerrain_").split("_")
		if parts.size() != 2:
			continue
		var region_name := "%s/%s" % [parts[0], parts[1]]
		if _qa_slopes.has(region_name):
			continue
		var heights := TerrainCollision.heights_from_region(
			_grid.parsed_heightmaps.get(RegionGridState.region_key(int(parts[0]), int(parts[1]))))
		if heights.is_empty():
			continue
		var steepest := 0.0
		var at := Vector2i.ZERO
		for r in range(side - 1):
			for c in range(side - 1):
				var h00 := heights[(side - 1 - r) * side + c]
				var h10 := heights[(side - 1 - r) * side + c + 1]
				var h01 := heights[(side - 2 - r) * side + c]
				var h11 := heights[(side - 2 - r) * side + c + 1]
				var g := maxf(absf(h10 - h00) + absf(h11 - h10), absf(h11 - h01) + absf(h01 - h00)) / tile
				if g > steepest:
					steepest = g
					at = Vector2i(r, c)
		_qa_slopes[region_name] = [steepest, at]
		print("QA TERRAIN SLOPE %s: steepest triangle |dh/dx| + |dh/dz| %.3f at quad (row %d, column %d): a %.2f nudge moves a height by at most %.4f there" % [
			region_name, steepest, at.x, at.y, TerrainCollision.RAY_GRID_EPSILON, steepest * TerrainCollision.RAY_GRID_EPSILON])
	var worst := 0.0
	var worst_name := ""
	for region_name in _qa_slopes:
		if float(_qa_slopes[region_name][0]) > worst:
			worst = float(_qa_slopes[region_name][0])
			worst_name = region_name
	print("QA TERRAIN SLOPE: %d region(s) read; steepest triangle %.3f (%s): the grid-line nudge (%.2f) moves a height by at most %.4f" % [
		_qa_slopes.size(), worst, worst_name, TerrainCollision.RAY_GRID_EPSILON, worst * TerrainCollision.RAY_GRID_EPSILON])

## SRREVAMP_QA_MOB_MOVE="dx,dz,speed,mode": once monster bodies exist, the
## nearest living one is sent on a leg from where it is drawn to (x+dx, z+dz)
## at `speed` units a second, mode 0 walk / 1 run -- a 29-byte OpMonsterMoved
## payload built here and decoded by CombatNet.decode_monster_moved, the same
## path a server's push takes. With --server the list is requested once at half
## the leg, so the refresh's reconcile runs mid-walk. Pair with
## SRREVAMP_QA_MOB_LOG=1 for the move, progress and arrival lines.
var _qa_mob_move_done := false

func _qa_mob_move() -> void:
	var nearest_id := -1
	var nearest := INF
	for monster_id in _monster_bodies:
		var body = _monster_bodies[monster_id]
		if _dying_until.has(monster_id) or not is_instance_valid(body):
			continue
		var d := (body as Node3D).global_position.distance_to(player.global_position)
		if d < nearest:
			nearest = d
			nearest_id = monster_id
	if nearest_id == -1:
		return
	_qa_mob_move_done = true
	var parts := OS.get_environment("SRREVAMP_QA_MOB_MOVE").split(",")
	var dx := float(parts[0]) if parts.size() > 0 else 0.0
	var dz := float(parts[1]) if parts.size() > 1 else 0.0
	var speed := float(parts[2]) if parts.size() > 2 else 0.0
	var mode := int(parts[3]) if parts.size() > 3 else 0
	var at: Vector3 = (_monster_bodies[nearest_id] as Node3D).position
	var payload := PackedByteArray()
	payload.resize(CombatNet.MONSTER_MOVED_SIZE)
	payload.encode_s64(0, nearest_id)
	payload.encode_float(8, at.x)
	payload.encode_float(12, at.z)
	payload.encode_float(16, at.x + dx)
	payload.encode_float(20, at.z + dz)
	payload.encode_float(24, speed)
	payload[28] = mode
	print("QA MOB MOVE: monster %d at %.0f from the player, leg (%.1f,%.1f) at %.1f/s mode %d" % [
		nearest_id, nearest, dx, dz, speed, mode])
	_on_monster_moved(CombatNet.decode_monster_moved(payload))
	if NetClient.is_connected_to_server() and speed > 0.0:
		_after(Vector2(dx, dz).length() / speed / 2.0, func() -> void:
			print("QA MOB MOVE: asking for the monster list at half the leg")
			NetClient.list_monsters())

## SRREVAMP_QA_MOBS=<N> (round 655): a list of N monsters, the density the
## server will send (the densest 5 x 5-region window of the field spawns
## holds about 500), for the perf gate's `mobs` site. Delivered once, as soon
## as the grid has its origin -- during the loading drain, where a real list
## asked for in _ready lands -- through the list handler a server's list
## takes. The monsters are OURS: QA_MOB_SPECIES real `MOB_CH_` species with a
## model of their own (every k-th of the sorted codes, so the pick is the
## same on every build), at positions drawn with a fixed seed uniformly over
## the (2 * radius + 1)^2 regions of the load window, at the player's height.
const QA_MOB_SPECIES := 24
var _qa_mobs_done := false
## SRREVAMP_QA_LINEUP (round 689, QaLineup): the creatable Figures spawned
## through the other-player path in front of the player and measured --
## posed or T-posed, feet against the ground -- per action phase. QA only.
var _qa_lineup: QaLineup = QaLineup.from_env(self)

## SRREVAMP_QA_BODY="<ref_obj_id>[:<scale>]" (round 689): the player's model
## and scale byte for a run with no server (a server names them in its
## enter-world result). [] when unset or malformed.
func _qa_body_spec() -> Array:
	var spec := OS.get_environment("SRREVAMP_QA_BODY")
	if spec == "":
		return []
	var kv := spec.split(":")
	if not kv[0].is_valid_int():
		printerr("World3D: SRREVAMP_QA_BODY: bad model '%s' (want <ref_obj_id>[:<scale>])" % spec)
		return []
	var scale := CharacterAppearance.DEFAULT_SCALE
	if kv.size() > 1:
		var t := kv[1].strip_edges()
		scale = t.substr(2).hex_to_int() if t.begins_with("0x") else int(t)
	print("World3D: QA body %d, scale 0x%02x" % [int(kv[0]), scale])
	return [int(kv[0]), scale]
func _qa_mobs_step() -> void:
	if _qa_mobs_done or not _grid_has_origin:
		return
	var spec := OS.get_environment("SRREVAMP_QA_MOBS")
	if spec == "" or not spec.is_valid_int():
		return
	_qa_mobs_done = true
	_monster_model_path("", "") # the species tables
	var codes: Array = []
	for code in _monster_models_by_code.keys():
		if String(code).begins_with("MOB_CH_"):
			codes.append(code)
	codes.sort()
	var species: Array = []
	if not codes.is_empty():
		var step := maxi(codes.size() / QA_MOB_SPECIES, 1)
		for i in range(0, codes.size(), step):
			if species.size() < QA_MOB_SPECIES:
				species.append(codes[i])
	if species.is_empty():
		species.append("")
	var rng := RandomNumberGenerator.new()
	rng.seed = 655
	var radius := _region_load_radius()
	var span := 1920.0
	var centre := _grid_origin_world + Vector3(span / 2.0, 0.0, -span / 2.0)
	var half := span * (float(radius) + 0.5)
	# SRREVAMP_QA_MOBS_SPREAD=<half-width> (round 664): the crowd in a square
	# of that half-width around the player instead, as a dense field packs
	# its nests (the perf gate's `crowd` site).
	var spread := OS.get_environment("SRREVAMP_QA_MOBS_SPREAD")
	if spread.is_valid_float() and float(spread) > 0.0:
		centre = player.position
		half = float(spread)
	var list: Array = []
	for i in range(int(spec)):
		var m := CombatNet.MonsterSnapshot.new()
		m.monster_id = 900000 + i
		m.code_name = species[i % species.size()]
		m.monster_name = m.code_name if m.code_name != "" else "QA monster"
		m.x = centre.x + rng.randf_range(-half, half)
		m.z = centre.z + rng.randf_range(-half, half)
		m.y = player.position.y
		m.max_hp = 100
		m.hp = 100
		list.append(m)
	print("QA MOBS: %d monster(s) of %d species over %.0f x %.0f around (%.0f, %.0f): %s" % [
		list.size(), species.size(), half * 2.0, half * 2.0, centre.x, centre.z, ", ".join(PackedStringArray(species))])
	_on_monster_list_result(list, "")

## SRREVAMP_QA_MOBSPLIT=<frames> (round 664): the frame split, one line every
## <frames> rendered frames (MonsterCrowd.Split). SRREVAMP_QA_MOBSPLIT_OFF, a
## comma list, switches parts of every monster body off for the A/B that
## splits the renderer's share: `pose` (no clip is posed), `labels` (the name
## hidden), `collide` (no click collider), `mesh` (the model hidden,
## still posed), `sound` (no clip's sound tracks advanced). QA only.
var _qa_split: MonsterCrowd.Split = null
var _qa_split_off := PackedStringArray()
func _qa_split_init() -> void:
	var every := int(OS.get_environment("SRREVAMP_QA_MOBSPLIT"))
	if every <= 0:
		return
	_qa_split = MonsterCrowd.Split.new(every)
	var off := OS.get_environment("SRREVAMP_QA_MOBSPLIT_OFF")
	if off != "":
		_qa_split_off = off.split(",", false)
	RenderingServer.viewport_set_measure_render_time(get_viewport().get_viewport_rid(), true)
	print("QA MOBSPLIT on: a line every %d frame(s); off: %s" % [every, ",".join(_qa_split_off) if not _qa_split_off.is_empty() else "nothing"])

func _qa_split_print() -> void:
	var vp := get_viewport().get_viewport_rid()
	print(_qa_split.line(Engine.get_frames_drawn(), _monster_bodies.size(),
		RenderingServer.viewport_get_measured_render_time_cpu(vp),
		RenderingServer.viewport_get_measured_render_time_gpu(vp),
		int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)),
		int(Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME)),
		int(Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME)),
		Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0,
		Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1000.0))

## The QA split's switches on one freshly built monster body.
func _qa_split_strip(body: Node3D, skeleton: Skeleton3D) -> void:
	if _qa_split_off.has("labels"):
		# Off every render layer rather than hidden: the plate sweep sets
		# `visible` (round 673, NamePlates) and would show it again.
		var name_plate := body.get_node_or_null("Label") as VisualInstance3D
		if name_plate != null:
			name_plate.layers = 0
	if _qa_split_off.has("collide"):
		var click := body.get_node_or_null("ClickBody")
		if click != null:
			body.remove_child(click)
			click.free()
	if _qa_split_off.has("mesh") and skeleton != null:
		for mi in skeleton.find_children("*", "MeshInstance3D", true, false):
			(mi as MeshInstance3D).visible = false

## SRREVAMP_QA_MOB_STRIKE=1: stands in for a server with the strike push
## (OpMonsterAttacked 0x007D), which a server sends only with its
## -monster-strike-push flag on (round 541; off by default). Right behind each
## result that reports a counter, the push such a server sends -- the result's
## own numbers in a 33-byte payload built here, with -1 for the target, an id
## the client is not told when it enters the world (MonsterStrikes pairs by
## the numbers instead) -- goes through NetClient's own _dispatch, deferred to
## the end of the frame, as a push arriving right behind its result would.
## Never fires in real play.
func _qa_mob_strike(monster: int, result: CombatNet.AttackResult) -> void:
	if monster == -1 or not MonsterStrikes.result_countered(result):
		return
	var flags := 0
	if result.monster_critical:
		flags |= CombatNet.STRIKE_CRITICAL
	if result.player_blocked:
		flags |= CombatNet.STRIKE_BLOCKED
	if result.player_died:
		flags |= CombatNet.STRIKE_TARGET_DIED
	var payload := PackedByteArray()
	payload.resize(CombatNet.MONSTER_ATTACKED_SIZE)
	payload.encode_s64(0, monster)
	payload.encode_s64(8, -1)
	payload.encode_s32(16, result.player_damage_taken)
	payload[20] = flags
	payload.encode_s32(21, result.player_hp)
	payload.encode_s64(25, result.death_exp_lost)
	print("QA MOB STRIKE: monster %d's counter pushed behind its result" % monster)
	NetClient.call_deferred("_dispatch", Packet.new(CombatNet.OP_MONSTER_ATTACKED, payload))

## SRREVAMP_QA_CLICK="monster,npc,ground": each kind becomes a real left
## click through _dispatch_left_click -- after the player is put 40 units in
## front of the nearest such target with the camera aimed at it -- and the
## log shows what the NPC ray and the monster ray each hit at that screen
## point and which path took the click. That is the measurement behind
## "clicking a monster opened the talk window": the node, not the impression.
## Since round 701 a click on a monster selects it and the next one attacks
## (_pick_character), so a QA attack is "monster,monster".
## SRREVAMP_QA_ARRIVAL_PROBE=1 (round 690): QA_ARRIVAL_PROBE_DELAY ticks after
## each arrival -- the entry, a zone change, a gate teleport, a return to the
## return point -- once the grid has stopped loading, prints where the player
## stands against the ground under it (`QA ARRIVAL`: the feet, the terrain-only
## ray, the walkable graph's landing height) and, for every bound gate within
## QA_GATE_PROBE_RANGE, its drawn box against its click bodies and a sweep of
## the talk ray from eight directions (`QA GATEPICK`, GatePickProbe). A
## measurement only: it moves nothing.
const QA_ARRIVAL_PROBE_DELAY := 240
const QA_GATE_PROBE_RANGE := 1500.0
## The sweep's eye (OURS, the measurement's geometry): QA_GATE_EYE_DISTANCE
## beyond the gate's drawn half-extent in x/z, QA_GATE_EYE_HEIGHT above the
## ground at its drawn centre -- about where the camera arm (45 units at -42
## degrees, World3D.tscn) puts a player standing just off the gate.
const QA_GATE_EYE_DISTANCE := 60.0
const QA_GATE_EYE_HEIGHT := 50.0
var _qa_arrival_probe_at := -1
var _qa_arrival_probe_label := ""
var _qa_arrival_entry_armed := false
var _qa_arrival_count := 0

func _qa_arrival_probe_enabled() -> bool:
	return OS.get_environment("SRREVAMP_QA_ARRIVAL_PROBE") != ""

func _qa_arm_arrival_probe(label: String) -> void:
	if not _qa_arrival_probe_enabled():
		return
	_qa_arrival_count += 1
	_qa_arrival_probe_at = _qa_tick + QA_ARRIVAL_PROBE_DELAY
	_qa_arrival_probe_label = "#%d %s" % [_qa_arrival_count, label]

func _qa_arrival_probe() -> void:
	var space := get_world_3d().direct_space_state
	var p := player.global_position
	var terrain := TerrainCollision.vertical_ray(space, p.x, p.z, p.y + 1000.0, p.y - 1000.0,
		TERRAIN_ONLY_COLLISION_MASK, [player.get_rid()])
	var terrain_y: float = (terrain["position"] as Vector3).y if not terrain.is_empty() else NAN
	var landing := NAN
	var where := "no loaded region"
	var pair := _nav_graph_for(p)
	if not pair.is_empty():
		var group: Node3D = pair[1]
		var local := group.to_local(p)
		landing = group.to_global(Vector3(local.x, (pair[0] as NavGraph).landing_height_at(local.x, local.z), local.z)).y
		where = "%s local (%.1f, %.1f)" % [group.name, local.x, local.z]
	print("QA ARRIVAL %s: feet y %.2f at world (%.1f, %.1f) in %s; terrain %.2f; walkable graph landing %.2f; feet - landing %.2f; feet - terrain %.2f; dead %s" % [
		_qa_arrival_probe_label, p.y, p.x, p.z, where, terrain_y, landing, p.y - landing, p.y - terrain_y, str(_player_dead)])
	for code in _gate_bindings:
		var node = _gate_bindings[code]["node"]
		if not is_instance_valid(node) or (node as Node).is_queued_for_deletion():
			print("QA GATEPICK %s %s: no pick node" % [_qa_arrival_probe_label, code])
			continue
		var pick := node as Node3D
		if Vector2(pick.global_position.x - p.x, pick.global_position.z - p.z).length() > QA_GATE_PROBE_RANGE:
			continue
		# What is drawn there: the placed map object nearest the gate's
		# table point (the portal round 577 bound; Alexandria North's is 15.1
		# units off), within QA_GATE_DRAWN_RADIUS.
		var found := _nearest_placed_object(_object_containers.values(), pick.global_position, QA_GATE_DRAWN_RADIUS)
		if found.is_empty():
			print("QA GATEPICK %s %s: nothing placed within %.0f of its point" % [_qa_arrival_probe_label, code, QA_GATE_DRAWN_RADIUS])
			continue
		var gate: Node3D = found["node"]
		var drawn := GatePickProbe.visual_aabb(gate)
		var box := GatePickProbe.body_aabb(pick, GATE_PICK_COLLISION_LAYER | NPC_COLLISION_LAYER)
		print("QA GATEPICK %s %s: drawn %s (%.1f from the point) %s..%s; pick box %s..%s; centre delta %s; box inside drawn %s" % [
			_qa_arrival_probe_label, code, gate.name, float(found["distance"]), str(drawn.position.round()), str(drawn.end.round()),
			str(box.position.round()), str(box.end.round()), str((box.get_center() - drawn.get_center()).round()), str(drawn.encloses(box))])
		# Each drawn piece's box (which one is the stone), and where the
		# pick box's centre falls on this screen and whether a click there
		# talks (`QA GATEAIM`: the point for a real X click).
		for m in gate.find_children("*", "MeshInstance3D", true, false):
			var mi := m as MeshInstance3D
			if mi.mesh == null:
				continue
			var pb := mi.global_transform * mi.get_aabb()
			print("QA GATEPICK %s %s piece %s: %s..%s" % [_qa_arrival_probe_label, code, mi.name, str(pb.position.round()), str(pb.end.round())])
		var aim := box.get_center()
		if not camera_3d.is_position_behind(aim):
			var screen := camera_3d.unproject_position(aim)
			var on_screen := get_viewport().get_visible_rect().has_point(screen)
			print("QA GATEAIM %s %s: pick box centre %s at screen %d,%d%s; talk there: %s" % [_qa_arrival_probe_label, code, str(aim.round()),
				int(round(screen.x)), int(round(screen.y)), "" if on_screen else " (OFF-SCREEN)", str(_talk_ray_at(screen)["node"] == pick)])
		# The ground under the drawn centre (the walkable graph's landing
		# there), so the eye is above the gate's floor, not under it: a
		# piece's foundations reach well below the ground (Jangan's
		# CJ_por_gidung, 73 under its origin).
		var ground := drawn.get_center().y
		var gpair := _nav_graph_for(drawn.get_center())
		if not gpair.is_empty():
			var gg: Node3D = gpair[1]
			var gl := gg.to_local(drawn.get_center())
			ground = gg.to_global(Vector3(gl.x, (gpair[0] as NavGraph).landing_height_at(gl.x, gl.z), gl.z)).y
		var reach := maxf(drawn.size.x, drawn.size.z) * 0.5 + QA_GATE_EYE_DISTANCE
		for k in 8:
			var yaw := k * PI / 4.0
			var eye := drawn.get_center() + Vector3(sin(yaw), 0.0, cos(yaw)) * reach
			eye.y = ground + QA_GATE_EYE_HEIGHT
			var sw := GatePickProbe.sweep(space, gate, pick, eye, drawn, 24, 1, _talk_ray, [player.get_rid()])
			print("QA GATEPICK %s %s" % [_qa_arrival_probe_label, GatePickProbe.describe("%s from %d deg" % [code, k * 45], sw)])

## How far from a gate's table point the probe looks for what is drawn there
## (OURS: Alexandria North's portal is placed 15.1 from its point).
const QA_GATE_DRAWN_RADIUS := 20.0

## "gate" (round 577) clicks the nearest bound teleport gate (_qa_gate_target).
## "npc:<CODE>" (round 642) the nearest NPC with that codename. With
## SRREVAMP_QA_AIM_ONLY=1 nothing is dispatched: the player is stood and the
## camera aimed as for a click, and `QA AIM <kind>: click at x,y` gives the
## point for a real X click.
## SRREVAMP_QA_CLICK_STANDOFF=<units> or "<kind>=<units>,..." (round 701)
## stands the player that far short of the target instead of 40 (a click from
## out of talk reach), for every kind or per kind ("npc=320,gate=860"); a
## ":<side>" suffix (-z, the default, +z, -x, +x) picks the side stood on.
var _qa_click_queue: Array = []
var _qa_click_stage := 0
var _qa_click_wait := 0
var _qa_click_target: Dictionary = {}
## How many times an "npc:<CODE>" target has been looked for and not found.
var _qa_click_retries := 0
## True only while a QA click is being dispatched, so the pickers print
## what their rays hit without spamming real play.
var _qa_click_logging := false

func _qa_advance_click() -> void:
	if _qa_click_wait > 0:
		_qa_click_wait -= 1
		return
	var kind: String = _qa_click_queue[0]
	# "wait:<ticks>" (round 650): a pause between two clicks, so a live run
	# can aim at one gate, teleport by real input, and aim at the next gate
	# after the arrival (SRREVAMP_QA_CLICK="gate,wait:2400,gate").
	if kind.begins_with("wait:"):
		_qa_click_queue.pop_front()
		_qa_click_stage = 0
		_qa_click_wait = maxi(0, kind.substr(5).to_int())
		print("QA CLICK wait %d tick(s)" % _qa_click_wait)
		return
	# "gate@<d>" (round 700): hover only -- stand <d> units short of the
	# nearest gate, aim at it and print what the hover finds (QA HOVER).
	var hover_only := kind.contains("@")
	if _qa_click_stage == 0:
		_qa_click_target = _qa_click_target_for(kind.get_slice("@", 0))
		if _qa_click_target.is_empty():
			# A named NPC may be in a region still streaming in after a /tp
			# (round 642): look again for up to a minute before giving up.
			# A dropped item (round 697) may not have fallen yet: the same.
			if (kind.begins_with("npc:") or kind == "item") and _qa_click_retries < 60:
				_qa_click_retries += 1
				_qa_click_wait = 60
				return
			print("QA CLICK %s: no such target in the world (monsters %d)" % [kind, _monster_bodies.size()])
			_qa_click_queue.pop_front()
			_qa_click_retries = 0
			return
		_qa_click_retries = 0
		if kind != "ground":
			# Stand 40 units short of the target, on the walkable surface, and
			# look along +Z at it with a shallow camera so it sits mid-frame.
			# A gate's pick box is wider than that (round 690: Alexandria's is
			# 140 across): stand 40 short of its side, so the camera is outside it.
			# SRREVAMP_QA_CLICK_STANDOFF (round 701): stand that far short
			# instead of 40, for a click from out of talk or attack reach.
			var standoff := 40.0
			var side := "-z"
			for part in OS.get_environment("SRREVAMP_QA_CLICK_STANDOFF").split(",", false):
				var kv := String(part).split("=")
				var value := kv[0] if kv.size() == 1 else (kv[1] if kv.size() == 2 and kind.begins_with(kv[0]) else "")
				var vs := value.split(":")
				if vs.size() >= 1 and vs[0].is_valid_float():
					standoff = float(vs[0])
					side = vs[1] if vs.size() == 2 else "-z"
			# The side of the target to stand on, and the camera yaw that
			# looks from there at it (yaw 180 sits the camera on -z).
			var axis: Vector3 = {"-z": Vector3(0, 0, -1), "+z": Vector3(0, 0, 1), "-x": Vector3(-1, 0, 0), "+x": Vector3(1, 0, 0)}.get(side, Vector3(0, 0, -1))
			var yaw: float = {"-z": 180.0, "+z": 0.0, "-x": 270.0, "+x": 90.0}.get(side, 180.0)
			var stand: Vector3 = _qa_click_target["pos"] + axis * (standoff + float(_qa_click_target.get("stand_off", 0.0)))
			if hover_only:
				stand = _qa_click_target["pos"] + Vector3(0.0, 0.0, -kind.get_slice("@", 1).to_float())
			var pair := _nav_graph_for(stand)
			if not pair.is_empty():
				var group: Node3D = pair[1]
				var local: Vector3 = group.to_local(stand)
				stand = group.to_global(Vector3(local.x, (pair[0] as NavGraph).landing_height_at(local.x, local.z), local.z))
			player.global_position = stand
			player.velocity = Vector3.ZERO
			camera_arm.rotation_degrees = Vector3(-15.0, yaw, 0.0)
		_qa_click_stage = 1
		_qa_click_wait = 30
		return
	# Stage 1: aim at the target's middle and click there.
	var aim: Vector3 = _qa_click_target["pos"] + Vector3(0.0, float(_qa_click_target["half_height"]), 0.0)
	if camera_3d.is_position_behind(aim):
		print("QA CLICK %s: target %s is behind the camera" % [kind, str(_qa_click_target["name"])])
	else:
		var screen := camera_3d.unproject_position(aim)
		# Marked when the point is outside the viewport (round 577's review:
		# three gate clicks were aimed off-screen and read as "clicked
		# through"): such a click proves the tag and the layer, not a click a
		# player could make.
		var on_screen := get_viewport().get_visible_rect().has_point(screen)
		if hover_only:
			var hk := _hover_kind_at(screen)
			print("QA HOVER %s: '%s' %s at screen %s -> %s (0x%x) -- %s" % [kind, str(_qa_click_target["name"]),
				"on screen" if on_screen else "OFF-SCREEN", str(screen.round()), hk, GameCursor.id_for(hk),
				_hover_target if _hover_target != "" else "nothing under the point"])
			_qa_click_queue.pop_front()
			_qa_click_stage = 0
			_qa_click_wait = 30
			return
		print("QA CLICK %s: '%s' at world %s -> screen %s%s" % [kind, str(_qa_click_target["name"]), str(aim.round()), str(screen.round()),
			"" if on_screen else " (OFF-SCREEN: not a click a player could make)"])
		_probe_click_rays(screen)
		# SRREVAMP_QA_AIM_ONLY (round 642): stand and aim, print the point,
		# and leave the click to real X input (the e2e harness's xdotool).
		if OS.get_environment("SRREVAMP_QA_AIM_ONLY") != "":
			print("QA AIM %s: click at %d,%d" % [kind, int(round(screen.x)), int(round(screen.y))])
			_qa_click_queue.pop_front()
			_qa_click_stage = 0
			_qa_click_wait = 30
			return
		_qa_click_logging = true
		var took := _dispatch_left_click(screen)
		_qa_click_logging = false
		print("QA CLICK %s: dispatched -> %s" % [kind, took])
		# The cursor the same point would show, and a swatch of it drawn at
		# that point so the frame carries the decoded art (the OS cursor is
		# never in an offscreen frame; this is a QA swatch, not the cursor).
		var t0 := Time.get_ticks_usec()
		var hover := _hover_kind_at(screen)
		var took_usec := Time.get_ticks_usec() - t0
		var cid: int = GameCursor.id_for(hover)
		var entry := GameCursor.scaled_entry(cid, get_window().content_scale_factor)
		print("QA CURSOR at %s: kind=%s id=0x%x size=%s hotspot=%s scale %.2f (from %s) classify %d us frame %d" % [
			str(screen.round()), hover, cid, str(entry[0].get_size()) if not entry.is_empty() else "-",
			str(entry[1]) if not entry.is_empty() else "-", get_window().content_scale_factor,
			GameCursor.source_path() if GameCursor.has_cursors() else "no exe", took_usec, Engine.get_frames_drawn()])
		_qa_show_cursor_swatch(cid, screen)
	_qa_click_queue.pop_front()
	_qa_click_stage = 0
	_qa_click_wait = 30

## SRREVAMP_QA_TELEPORT=<dest id> (round 578): once a gate's talk box is up
## (SRREVAMP_QA_CLICK=gate), choose its 'Select teleport area' line through
## the talk box's own handler, then click that destination's line in the talk
## box (HudPanels.qa_press_teleport_line, round 603) and print
## `QA TELEPORT: requested <gate> -> <dest>`. Stage 0 waits for the talk box,
## 1 for the destination list, 2 is done.
var _qa_teleport_stage := 0
var _qa_teleport_wait := 0

func _qa_advance_teleport() -> void:
	var want := OS.get_environment("SRREVAMP_QA_TELEPORT")
	if not want.is_valid_int() or _hud_panels == null:
		_qa_teleport_stage = 2
		print("QA TELEPORT: '%s' is not a teleportdata id" % want)
		return
	if _qa_teleport_wait > 0:
		_qa_teleport_wait -= 1
		return
	if _qa_teleport_stage == 0:
		if _hud_panels.is_open("npctalk") and _teleport_reader != null \
				and _teleport_point_for_code(_talk_npc_code) != null:
			print("QA TELEPORT: choosing the teleport line at %s" % _talk_npc_code)
			_hud_panels._on_npc_talk_choice("teleport")
			_qa_teleport_stage = 1
			_qa_teleport_wait = 30
		return
	if not _hud_panels.teleport_list_shown():
		return
	var dest := int(want)
	if _hud_panels.qa_press_teleport_line(dest):
		print("QA TELEPORT: requested %d -> %d" % [_teleport_gate_point_id, dest])
	else:
		print("QA TELEPORT: the talk box lists no destination %d" % dest)
	_qa_teleport_stage = 2

## The nearest target of a kind: {pos, half_height, name}, or {} if none.
## "ground" is a spot 30 units ahead of the player.
func _qa_click_target_for(kind: String) -> Dictionary:
	# "npc:<CODE>" (round 642): the nearest NPC holder with that codename --
	# a teleport NPC among a dock's other NPCs.
	if kind.begins_with("npc:"):
		var want := kind.substr(4).strip_edges().to_upper()
		var best: Node3D = null
		var best_d := INF
		for group in get_children():
			if not (group is Node3D) or not String(group.name).begins_with("RealTerrain_"):
				continue
			for holder in group.get_children():
				if not (holder is Node3D) or str(holder.get_meta("npc_code", "")).to_upper() != want:
					continue
				var d := (holder as Node3D).global_position.distance_to(player.global_position)
				if d < best_d:
					best_d = d
					best = holder
		if best == null:
			return {}
		return {"pos": best.global_position, "half_height": _qa_click_half_height(best, "Body"),
			"name": str(best.get_meta("npc_name"))}
	match kind:
		"monster":
			var best_m: Node3D = null
			var best_md := INF
			for monster_id in _monster_bodies:
				var body: Node3D = _monster_bodies[monster_id]
				if not is_instance_valid(body) or _dying_until.has(monster_id):
					continue
				var d := body.global_position.distance_to(player.global_position)
				if d < best_md:
					best_md = d
					best_m = body
			if best_m == null:
				return {}
			return {"pos": best_m.global_position, "half_height": _qa_click_half_height(best_m, "ClickBody"),
				"name": (best_m.get_node("Label") as Label3D).text if best_m.has_node("Label") else best_m.name}
		"npc":
			var best_n: Node3D = null
			var best_nd := INF
			for group in get_children():
				if not (group is Node3D) or not String(group.name).begins_with("RealTerrain_"):
					continue
				for holder in group.get_children():
					if not (holder is Node3D) or not holder.has_meta("npc_name"):
						continue
					var d := (holder as Node3D).global_position.distance_to(player.global_position)
					if d < best_nd:
						best_nd = d
						best_n = holder
			if best_n == null:
				return {}
			return {"pos": best_n.global_position, "half_height": _qa_click_half_height(best_n, "Body"),
				"name": str(best_n.get_meta("npc_name"))}
		"gate":
			# The nearest town gate (round 577) -- since round 690 its pick
			# node, which draws nothing: _qa_gate_target aims at its box's
			# centre, the gate's table point.
			var best_g: Node3D = null
			var best_gd := INF
			# The gates' pick nodes (round 690, _bind_region_gates).
			for code in _gate_bindings:
				var node = _gate_bindings[code]["node"]
				if not is_instance_valid(node) or not (node as Node).is_inside_tree():
					continue
				var d := (node as Node3D).global_position.distance_to(player.global_position)
				if d < best_gd:
					best_gd = d
					best_g = node
			if best_g == null:
				return {}
			return _qa_gate_target(best_g)
		"item":
			# The nearest dropped item (round 697, for the hover cursor's
			# live check): aimed at its spot on the ground.
			if _ground_items == null:
				return {}
			var gid := _ground_items.nearest_id(player.global_position)
			if gid < 0:
				return {}
			return {"pos": _ground_items.position_of(gid), "half_height": 0.0, "name": "ground item %d" % gid}
		"ground":
			var spot := player.global_position + Vector3(0.0, 0.0, 30.0)
			var pair := _nav_graph_for(spot)
			if not pair.is_empty():
				var group: Node3D = pair[1]
				var local: Vector3 = group.to_local(spot)
				spot = group.to_global(Vector3(local.x, (pair[0] as NavGraph).landing_height_at(local.x, local.z), local.z))
			return {"pos": spot, "half_height": 0.0, "name": "ground"}
	return {}

## Draws the decoded cursor for a resource id at a screen point, twice its
## size with its hotspot on the point -- a QA stand-in for the OS cursor,
## which offscreen frames never capture.
func _qa_show_cursor_swatch(cursor_id: int, at: Vector2) -> void:
	var entry := GameCursor.scaled_entry(cursor_id, 1.0)
	if entry.is_empty():
		return
	var swatch: TextureRect = get_node_or_null("UI/QaCursorSwatch")
	if swatch == null:
		swatch = TextureRect.new()
		swatch.name = "QaCursorSwatch"
		swatch.mouse_filter = Control.MOUSE_FILTER_IGNORE
		swatch.stretch_mode = TextureRect.STRETCH_SCALE
		swatch.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		$UI.add_child(swatch)
	var tex: Texture2D = entry[0]
	swatch.texture = tex
	swatch.size = tex.get_size() * 2.0
	swatch.position = at - Vector2(entry[1]) * 2.0

## The QA click's target for a bound gate (round 577): the middle of its
## drawn meshes' world box -- "pos" the box's bottom centre, "half_height"
## half its height -- or its own origin when it draws nothing (a gate's pick
## node since round 690: the centre of its pick box). Named
## "<gate name> (<node>)" so the log says which object took the click. The
## box's middle can fall outside the frame for a tall composite (round 577's
## Samarkand, Constantinople and Hotan clicks were aimed off-screen): such a
## click proves the tag and the layer, not a click a player could make.
func _qa_gate_target(gate: Node3D) -> Dictionary:
	var label := "%s (%s)" % [str(gate.get_meta("npc_name")), gate.name]
	var box := AABB()
	var have := false
	for node in gate.find_children("*", "MeshInstance3D", true, false):
		var mi := node as MeshInstance3D
		var b: AABB = mi.global_transform * mi.get_aabb()
		box = b if not have else box.merge(b)
		have = true
	if not have:
		# A gate's pick node (round 690): aim at the lower part of its box
		# (a quarter of its height above its bottom, on the ground side of
		# the centre, so the aim stays on screen from a stand on the
		# ground), and stand off its half-width.
		var shapes := gate.find_children("*", "CollisionShape3D", true, false)
		if not shapes.is_empty() and (shapes[0] as CollisionShape3D).shape is BoxShape3D:
			var size := ((shapes[0] as CollisionShape3D).shape as BoxShape3D).size
			return {"pos": gate.global_position - Vector3(0.0, size.y * 0.25, 0.0), "half_height": 0.0, "name": label, "stand_off": size.x * 0.5}
		return {"pos": gate.global_position, "half_height": 0.0, "name": label}
	var centre := box.get_center()
	return {"pos": Vector3(centre.x, box.position.y, centre.z), "half_height": box.size.y * 0.5, "name": label}

## Half the height of the click capsule under a body, so the QA click aims at
## the target's middle rather than its feet.
func _qa_click_half_height(body: Node3D, collider_name: String) -> float:
	if body.has_node(collider_name):
		for child in body.get_node(collider_name).get_children():
			if child is CollisionShape3D and (child as CollisionShape3D).shape is CapsuleShape3D:
				return ((child as CollisionShape3D).shape as CapsuleShape3D).height * 0.5
	return 5.0

func _qa_rig_report() -> void:
	if _player_skeleton == null:
		print("QA RIG: no assembled player skeleton")
		return
	var skeleton := _player_skeleton
	print("QA RIG tick %d: %d bone(s), skeleton at %s" % [
		_qa_tick, skeleton.get_bone_count(), skeleton.global_position.round()])
	# Where the body stands against the ground: the player node, the
	# lowest and highest bone, every drawn mesh's world-space box, and the
	# walkable height under the player. A character buried to the waist
	# shows here as feet well below the landing height.
	var lowest := INF
	var highest := -INF
	var lowest_bone := ""
	var highest_bone := ""
	for i in range(skeleton.get_bone_count()):
		# The model-space bone build_skin adds sits at the origin: not a foot.
		if not Skeleton3DBuilder.is_skeleton_bone(skeleton, i):
			continue
		var y: float = (skeleton.global_transform * skeleton.get_bone_global_pose(i).origin).y
		if y < lowest:
			lowest = y
			lowest_bone = skeleton.get_bone_name(i)
		if y > highest:
			highest = y
			highest_bone = skeleton.get_bone_name(i)
	var mesh_min := INF
	var mesh_max := -INF
	for node in skeleton.find_children("*", "MeshInstance3D", true, false):
		var mi := node as MeshInstance3D
		var box: AABB = mi.global_transform * mi.get_aabb()
		mesh_min = minf(mesh_min, box.position.y)
		mesh_max = maxf(mesh_max, box.end.y)
	var ground := NAN
	var pair := _nav_graph_for(player.global_position)
	if not pair.is_empty():
		var group: Node3D = pair[1]
		var local: Vector3 = group.to_local(player.global_position)
		ground = group.global_position.y + (pair[0] as NavGraph).landing_height_at(local.x, local.z)
	print("QA RIG   player at y %.2f; bones %.2f (%s) .. %.2f (%s); meshes %.2f .. %.2f; ground %.2f" % [
		player.global_position.y, lowest, lowest_bone, highest, highest_bone, mesh_min, mesh_max, ground])
	# What is physically above and below the feet: a ray straight down from
	# well overhead says which collider is the first surface under this
	# column, and whether it sits above the feet -- which is the difference
	# between standing on the plaza and standing inside it.
	var space_state := get_world_3d().direct_space_state
	var from := player.global_position + Vector3(0.0, 60.0, 0.0)
	# Every layer but the gates' pick boxes (round 690's review: a click
	# target is not a surface), as before; off the heightfield's grid lines
	# (TerrainCollision.vertical_ray, round 572).
	var hit := TerrainCollision.vertical_ray(space_state, from.x, from.z, from.y,
		player.global_position.y - 20.0, 0xFFFFFFFF & ~GATE_PICK_COLLISION_LAYER, [player.get_rid()])
	if hit.is_empty():
		print("QA RIG   nothing under the column from %.1f above the feet" % 60.0)
	else:
		var who: Node = hit.collider
		var above: float = float(hit.position.y) - player.global_position.y
		print("QA RIG   first surface down from overhead: y %.2f (%.2f from the feet) on %s" % [
			hit.position.y, above, who.get_path() if who != null else "?"])
		# A solid top well above the feet means the player was put INSIDE that
		# object -- QA_AT teleports without collision -- and everything below
		# that height is hidden in it. This is what "the legs vanish" was at
		# the square (see WORLD_ISSUES: the dragon pedestal, 11.45 tall), and
		# it was in this very line all along; say it in words so it is not
		# read as a rig bug again.
		if above > 0.5:
			print("QA RIG   ** player is INSIDE %s: its top is %.2f above the feet, so the body below that height is hidden in it -- move the spot, this is not the rig **" % [
				who.name if who != null else "that object", above])
	var every := PackedFloat32Array()
	if not pair.is_empty():
		var group: Node3D = pair[1]
		var local: Vector3 = group.to_local(player.global_position)
		every = (pair[0] as NavGraph).heights_at(local.x, local.z)
		for i in range(every.size()):
			every[i] += group.global_position.y
	print("QA RIG   walkable heights in this column: %s" % str(every))
	var rows: Array = []
	for child in skeleton.get_children():
		if not (child is BoneAttachment3D):
			continue
		var attachment := child as BoneAttachment3D
		var bone_idx := skeleton.find_bone(attachment.bone_name)
		if bone_idx == -1:
			continue
		var bone_world: Vector3 = skeleton.global_transform \
			* skeleton.get_bone_global_pose(bone_idx).origin
		for piece in attachment.get_children():
			if not (piece is MeshInstance3D):
				continue
			var mesh_node := piece as MeshInstance3D
			var centre: Vector3 = mesh_node.global_transform * mesh_node.get_aabb().get_center()
			rows.append([bone_world.distance_to(centre), attachment.bone_name, bone_world, centre])
	rows.sort_custom(func(a, b): return a[0] > b[0])
	# Printed to two decimals in the skeleton's own space, not rounded to
	# whole units in world space: the question is whether a piece moves
	# between frames at all, and rounding hid that.
	for row in rows:
		if String(row[1]) in ["Bip01 L Forearm", "Bip01 L UpperArm", "Bip01 L Calf"]:
			var local_centre: Vector3 = skeleton.global_transform.affine_inverse() * (row[3] as Vector3)
			print("QA RIG   %-18s mesh at %8.3f, %8.3f, %8.3f" % [
				row[1], local_centre.x, local_centre.y, local_centre.z])

## Reports placed objects standing clear of the ground under them, worst
## first -- scenery hanging in mid-air.
##
## Each object is measured against the terrain of the region that OWNS it
## (its `.o2` key's owner, MapO2Reader.Entry.object_key; round 643's review),
## in that region's own space, so a neighbouring region's own vertical
## placement is judged on its own terms rather than against the region the
## player happens to be standing in. Since round 643 a region's container
## can hold a neighbour's object (the first loaded lister places a key, and
## a region streaming out hands its objects on), so walking the containers
## and measuring against the holder skipped every neighbour-owned object:
## the ray landed on the owner's ground, not the holder's. The report walks
## _placed_objects instead, and counts the objects whose owner is not
## loaded (no ground of their own to measure against).
func _qa_float_report(radius: float) -> void:
	var origin := player.global_position
	var found: Array = []
	var owner_unloaded := 0
	var measured := 0
	var measured_foreign := 0
	var space := get_viewport().world_3d.direct_space_state
	for key in _placed_objects:
		var held: Dictionary = _placed_objects[key]
		var node3d: Node3D = held["node"]
		if not is_instance_valid(node3d) or not node3d.is_inside_tree():
			continue
		if origin.distance_to(node3d.global_position) > radius:
			continue
		var owner_region := (int(key) >> 16) & 0xFFFF
		var region_group := get_node_or_null("RealTerrain_%d_%d" % [owner_region >> 8, owner_region & 0xFF]) as Node3D
		if region_group == null:
			owner_unloaded += 1
			continue
		var local := region_group.to_local(node3d.global_position)
		# Against the *rendered* ground, not the navigation mesh: the two
		# are different surfaces, and what a player sees scenery hanging
		# over is the rendered one. Off the heightfield's grid lines
		# (TerrainCollision.vertical_ray, round 572).
		var at := node3d.global_position
		var hit := TerrainCollision.vertical_ray(space, at.x, at.z, at.y + 400.0, at.y - 400.0,
			TERRAIN_COLLISION_LAYER, [player.get_rid()])
		if hit.is_empty():
			continue
		# Only the owner region's *terrain* counts, and terrain is
		# specifically the body under that region's SubPatch. Two ways this
		# went wrong before: measuring against a neighbouring region reports
		# the difference between two vertical anchors as if it were floating
		# scenery, and placed objects carry collision on the default layer
		# -- which TERRAIN_COLLISION_LAYER includes -- so a ray dropped near
		# a tree lands on its canopy 350 units up and calls everything
		# beneath it buried.
		var hit_collider = hit["collider"]
		if hit_collider == null:
			continue
		var collider_parent := (hit_collider as Node).get_parent()
		if collider_parent == null or String(collider_parent.name) != "SubPatch":
			continue
		if not region_group.is_ancestor_of(hit_collider as Node):
			continue
		var ground := region_group.to_local(hit["position"] as Vector3).y
		measured += 1
		if String(held["holder"]) != String(region_group.name).trim_prefix("RealTerrain"):
			measured_foreign += 1
		var gap := local.y - ground
		if absf(gap) < FLOATING_TOLERANCE:
			continue
		found.append([gap, String(node3d.name), String(region_group.name), local, ground])
	found.sort_custom(func(a, b): return absf(a[0]) > absf(b[0]))
	print("QA FLOAT: %d placed object(s) within %.0f sit more than %.0f off their own region's ground (%d measured, %d of them held by a region other than their owner; %d skipped: owner region not loaded)" % [
		found.size(), radius, FLOATING_TOLERANCE, measured, measured_foreign, owner_unloaded])
	for i in range(mini(found.size(), QA_FLOAT_MAX_ROWS)):
		var where: Vector3 = found[i][3]
		print("QA FLOAT   %+7.1f  %-30s %-20s local (%.0f, %.0f) placed y %.1f, ground %.1f" % [
			found[i][0], found[i][1], found[i][2], where.x, where.z, where.y, found[i][4]])

## Fires horizontal rays through a band of the region and reports which
## X positions are clear through it -- "is this arch a way through, or a
## recess in a solid wall?"
##
## Argument is "z0,z1,y[,step]", all region-local: the band to shoot
## through, the height to shoot at, and the sampling step. Reading a
## mesh file's own triangles answers this for one mesh; this answers it
## for what was actually built there, every overlapping copy included,
## which is the thing the player walks into.
func _qa_through_report(spec: String) -> void:
	var parts := spec.split(",")
	if parts.size() < 3:
		print("QA THROUGH: expected \"z0,z1,y[,step]\", got \"%s\"" % spec)
		return
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		print("QA THROUGH: not standing in any loaded region")
		return
	var group: Node3D = pair[1]
	var z0 := float(parts[0])
	var z1 := float(parts[1])
	var y := float(parts[2])
	var step_span := float(parts[3]) if parts.size() > 3 else 10.0
	var space := get_viewport().world_3d.direct_space_state

	var open_from := NAN
	var runs: Array = []
	var x := 0.0
	while x <= REGION_SPAN:
		var query := PhysicsRayQueryParameters3D.create(
			group.to_global(Vector3(x, y, z0)), group.to_global(Vector3(x, y, z1)))
		query.collision_mask = 0xFFFFFFFF & ~GATE_PICK_COLLISION_LAYER
		query.exclude = [player.get_rid()]
		var clear := space.intersect_ray(query).is_empty()
		if clear and is_nan(open_from):
			open_from = x
		elif not clear and not is_nan(open_from):
			runs.append([open_from, x - step_span])
			open_from = NAN
		x += step_span
	if not is_nan(open_from):
		runs.append([open_from, REGION_SPAN])

	print("QA THROUGH z %.0f..%.0f at height %.0f: %d clear span(s) across the region" % [
		z0, z1, y, runs.size()])
	for r in runs:
		print("QA THROUGH   local x %.0f .. %.0f  (%.0f wide)" % [r[0], r[1], r[1] - r[0]])

## Sweeps the player's region on a grid and reports every spot where the
## walkable graph disagrees with the solid geometry actually built there.
##
## "You can walk underneath things" is a whole-region property, and
## walking around looking for it finds one instance an hour. For each
## sample this drops a physics ray from high above and compares what it
## lands on with the height the graph would stand a player at. The graph
## being *below* the geometry is the reported failure: it means a player
## walking there ends up under a floor they should be on top of. The
## graph being above is normal and not reported -- that is a bridge, a
## roof, or an upper storey with the ray having hit the ground beneath it.
## SRREVAMP_QA_COLUMNS="x,z;x,z": for each region-local column, every
## surface the walkable graph knows there, which placed objects it
## considers and their footprints, and any object whose footprint holds
## the column but which the graph's index does not return there -- so
## "under the deck here, on it 85 units away" can be read off the graph.
func _qa_columns_report(spec: String) -> void:
	var here := _nav_graph_for(player.global_position)
	for item in spec.split(";"):
		# `rx/ry@x,z` asks a named region; a bare `x,z` asks the one the
		# player is standing in. The named form is what makes a cross-region
		# question answerable at all -- a spawn point three regions away has
		# a world coordinate only the region's OWN group node can give.
		var body := item
		var pair := here
		var at := item.find("@")
		if at >= 0:
			var coords := _parse_region_coords(item.substr(0, at).strip_edges())
			body = item.substr(at + 1)
			if coords.is_empty():
				print("QA COLUMN: cannot parse a region out of '%s'" % item)
				continue
			pair = _nav_graph_for_region(coords["x"], coords["y"])
			if pair.is_empty():
				print("QA COLUMN: region %d/%d is not loaded" % [coords["x"], coords["y"]])
				continue
		if pair.is_empty():
			print("QA COLUMNS: not standing in any loaded region")
			continue
		var graph: NavGraph = pair[0]
		var parts := body.split(",")
		if parts.size() < 2:
			continue
		var x := float(parts[0])
		var z := float(parts[1])
		# World space is anchored on the grid's FRAME region (see
		# _grid_origin_region: the server's FrameRegion since round 570, else
		# the region the grid was built around), and the server shares that
		# frame only when it named it or it is the zone's own centre. So the
		# origin is printed with the coordinate rather than left implied -- a reading
		# taken in a QA run centred somewhere else is in a different frame,
		# and saying "the server's coordinates" unconditionally made two
		# runs look like they disagreed when they did not.
		var world_here := (pair[1] as Node3D).to_global(Vector3(x, 0.0, z))
		print("QA COLUMN (%d, %d): terrain %.1f, surfaces %s, landing %.1f | world (%.0f, %.0f) in the frame centred on %d/%d" % [
			int(x), int(z), NvmCollision.sample_height(graph.region, x, z),
			str(graph.heights_at(x, z)), graph.landing_height_at(x, z), world_here.x, world_here.z,
			_grid_origin_region.x, _grid_origin_region.y])
		# The real file's own answer first: which objects the navmesh cell
		# under this column lists, whether or not the graph could place them.
		var ci := graph.cell_index_at(x, z)
		if ci >= 0 and ci < graph.region.cells.size():
			var listed := PackedStringArray()
			for oi in graph.region.cells[ci].object_indices:
				var model := "?"
				if graph.objects.has(oi) and (graph.objects[oi] as Object).has_meta("model"):
					model = str((graph.objects[oi] as Object).get_meta("model"))
				elif oi < graph.region.objects.size():
					model = "resource %d, NOT placed" % (graph.region.objects[oi] as NvmReader.MapObject).resource_id
				listed.append("%d (%s)" % [oi, model])
			print("   the navmesh cell here lists objects: %s" % (", ".join(listed) if not listed.is_empty() else "none"))
		var considered: Array[int] = graph.objects_at(x, z)
		for oi in considered:
			var placed: NavGraph.PlacedObject = graph.objects[oi]
			var h := NavGraph.surface_height_of(placed, x, z)
			var model := str(placed.get_meta("model", "?"))
			print("   considers object %d (%s): footprint (%.0f, %.0f)-(%.0f, %.0f), %d cells, surface here %s" % [
				oi, model, placed.bounds_min.x, placed.bounds_min.y, placed.bounds_max.x, placed.bounds_max.y,
				placed.cells.size() / 3, "none" if is_nan(h) else "%.1f" % h])
			# Its navigation cells against its drawn pieces, both in region
			# space: if the two footprints disagree the placement is wrong;
			# if they agree, the navigation mesh has a hole the drawn deck
			# does not.
			var cell_lo := Vector3.INF
			var cell_hi := -Vector3.INF
			for v in placed.vertices:
				cell_lo = _vec_min(cell_lo, v)
				cell_hi = _vec_max(cell_hi, v)
			print("      cells span (%.0f, %.0f, %.0f)-(%.0f, %.0f, %.0f)" % [cell_lo.x, cell_lo.y, cell_lo.z, cell_hi.x, cell_hi.y, cell_hi.z])
			var nearest := []
			var i := 0
			while i + 2 <= placed.cells.size() - 1:
				var a: Vector3 = placed.vertices[placed.cells[i]]
				var b: Vector3 = placed.vertices[placed.cells[i + 1]]
				var c: Vector3 = placed.vertices[placed.cells[i + 2]]
				i += 3
				var centre := (a + b + c) / 3.0
				nearest.append([Vector2(centre.x - x, centre.z - z).length(), a, b, c])
			nearest.sort_custom(func(p, q): return p[0] < q[0])
			for k in range(mini(3, nearest.size())):
				var tri: Array = nearest[k]
				print("      cell %.0f away: (%.0f, %.0f, %.0f) (%.0f, %.0f, %.0f) (%.0f, %.0f, %.0f)" % [
					tri[0], tri[1].x, tri[1].y, tri[1].z, tri[2].x, tri[2].y, tri[2].z, tri[3].x, tri[3].y, tri[3].z])
			var drawn_lo := Vector3.INF
			var drawn_hi := -Vector3.INF
			var pieces := 0
			for node in (pair[1] as Node3D).find_children("Obj_%s_*" % model, "Node3D", true, false):
				for mesh_node in (node as Node).find_children("*", "MeshInstance3D", true, false):
					var mi := mesh_node as MeshInstance3D
					if mi.mesh == null:
						continue
					pieces += 1
					var aabb := mi.global_transform * mi.mesh.get_aabb()
					for corner in range(8):
						var p := (pair[1] as Node3D).to_local(aabb.get_endpoint(corner))
						drawn_lo = _vec_min(drawn_lo, p)
						drawn_hi = _vec_max(drawn_hi, p)
			if pieces > 0:
				print("      drawn as %d piece(s) spanning (%.0f, %.0f, %.0f)-(%.0f, %.0f, %.0f)" % [
					pieces, drawn_lo.x, drawn_lo.y, drawn_lo.z, drawn_hi.x, drawn_hi.y, drawn_hi.z])
			# Its blocking edges within 40 units: what would stop a walk here.
			var near_edges := PackedStringArray()
			var e := 0
			while e + 1 < placed.blocking.size():
				var p0: Vector2 = placed.blocking[e]
				var p1: Vector2 = placed.blocking[e + 1]
				e += 2
				if Geometry2D.get_closest_point_to_segment(Vector2(x, z), p0, p1).distance_to(Vector2(x, z)) <= 40.0:
					near_edges.append("(%.0f, %.0f)-(%.0f, %.0f)" % [p0.x, p0.y, p1.x, p1.y])
			print("      %d blocking edge(s), %d within 40: %s" % [placed.blocking.size() / 2, near_edges.size(), " ".join(near_edges)])
		var near_terrain := PackedStringArray()
		var t := 0
		while t + 1 < graph.terrain_blocking.size():
			var p0: Vector2 = graph.terrain_blocking[t]
			var p1: Vector2 = graph.terrain_blocking[t + 1]
			t += 2
			if Geometry2D.get_closest_point_to_segment(Vector2(x, z), p0, p1).distance_to(Vector2(x, z)) <= 40.0:
				near_terrain.append("(%.0f, %.0f)-(%.0f, %.0f)" % [p0.x, p0.y, p1.x, p1.y])
		print("   terrain blocking edges within 40: %s" % (" ".join(near_terrain) if not near_terrain.is_empty() else "none"))
		for oi in graph.objects:
			if considered.has(oi):
				continue
			var placed: NavGraph.PlacedObject = graph.objects[oi]
			if x < placed.bounds_min.x or x > placed.bounds_max.x or z < placed.bounds_min.y or z > placed.bounds_max.y:
				continue
			var h := NavGraph.surface_height_of(placed, x, z)
			print("   NOT indexed here, footprint holds it: object %d (%.0f, %.0f)-(%.0f, %.0f), surface here %s" % [
				oi, placed.bounds_min.x, placed.bounds_min.y, placed.bounds_max.x, placed.bounds_max.y,
				"none" if is_nan(h) else "%.1f" % h])

## Component-wise min and max; Godot 4.2's Vector3 has neither.
static func _vec_min(a: Vector3, b: Vector3) -> Vector3:
	return Vector3(minf(a.x, b.x), minf(a.y, b.y), minf(a.z, b.z))

static func _vec_max(a: Vector3, b: Vector3) -> Vector3:
	return Vector3(maxf(a.x, b.x), maxf(a.y, b.y), maxf(a.z, b.z))

## Where in a quad SRREVAMP_QA_GROUND_RAYS aims, as a fraction of a tile on
## local x and z: off the grid lines and off both of the quad's diagonals,
## where a shape that split the quad the other way from the mesh would be off
## by 0.45 of the quad's non-planarity (h00 + h11 - h10 - h01). A probe
## placement, not a game value.
const QA_GROUND_IN_QUAD := Vector2(0.45, 0.55)
## How far above the drawn surface a swept shape (the arm's sphere's centre,
## the player body's feet) starts, and how far it sweeps down: 4.2.2's
## cast_motion and body_test_motion bisect the motion eight times
## (servers/physics_3d/godot_space_3d.cpp), so their answer is good to about
## 1/256 of the sweep -- 0.23 unit over 60. Probe placement, not game values.
const QA_GROUND_SWEEP_START := 30.0
const QA_GROUND_SWEEP := 60.0

## SRREVAMP_QA_GROUND_RAYS=n (round 567): the terrain's collision measured
## against the ground that is DRAWN, so the heightfield (TerrainCollision)
## and the trimesh it replaced (SRREVAMP_TERRAIN_TRIMESH=1) can be compared
## by number rather than by picture. For every loaded region, on an n x n
## lattice of region-local columns each inside a quad (QA_GROUND_IN_QUAD),
## four probes against the terrain alone (TERRAIN_ONLY_COLLISION_MASK):
## a vertical ray; a slanted ray (region-local direction (-1, -1, -0.6), about
## 41 degrees below the horizontal) through the column's drawn surface
## point; the camera arm's own shape swept straight down onto it with
## cast_motion (the query the camera spring makes); and the player's own body
## moved straight down onto it with PhysicsServer3D.body_test_motion (the
## query move_and_slide makes, in _physics_process's fallback when no
## walkable graph covers the player). A ray's hit is
## held against the drawn mesh's own triangle under it
## (TerrainCollision.mesh_height_at over the region's parsed heightmap); the
## sweeps have no drawn answer and are for comparing two runs. Per region a
## `QA GROUND <rx>/<ry>` summary (with how many of its probed quads are
## non-planar enough that the other diagonal would be off the drawn ground by
## over 0.5 there, and the steepest quad edge, rise over run -- what makes the
## lattice a test of the diagonal) and a `QA GROUND VALUES <rx>/<ry>` line
## (every probe's number in lattice order: the vertical hit's local y, the
## oblique hit's distance along its ray, how far the sphere and the body
## travelled before they touched -- `sphere=` and `body=`; `miss` for
## none), and first `QA GROUND SNAP`: the ray
## _snap_player_onto_terrain fires, at the player's column.
func _qa_ground_rays_report(samples: int) -> void:
	var space := get_world_3d().direct_space_state
	# The snap's own ray, so through TerrainCollision.vertical_ray as the snap
	# is (round 572). The lattice's vertical rays below are not: they probe
	# the shape itself, inside quads at QA_GROUND_IN_QUAD -- 9 and 11 units
	# off the nearest grid lines, where the helper would fire the same ray.
	var snap_hit := TerrainCollision.vertical_ray(space, player.position.x, player.position.z,
		player.position.y + 1000.0, player.position.y - 1000.0, TERRAIN_ONLY_COLLISION_MASK, [player.get_rid()])
	var under := _nav_graph_for(player.global_position)
	if snap_hit.is_empty() or under.is_empty():
		print("QA GROUND SNAP: the snap's ray finds no terrain under the player at world %s" % str(player.global_position))
	else:
		var group_under: Node3D = under[1]
		var local_hit := group_under.to_local(snap_hit.position as Vector3)
		var local_feet := group_under.to_local(player.global_position)
		print("QA GROUND SNAP: %s local (%.2f, %.2f): the snap's ray lands at local y %.3f; the player stands at %.3f" % [
			String(group_under.name).trim_prefix("RealTerrain_").replace("_", "/"), local_feet.x, local_feet.z,
			local_hit.y, local_feet.y])
	var groups: Array = []
	for child in get_children():
		if child is Node3D and String(child.name).begins_with("RealTerrain_"):
			groups.append(child)
	groups.sort_custom(func(a, b): return String(a.name) < String(b.name))
	var sphere: Shape3D = camera_arm.shape if camera_arm.shape != null else SphereShape3D.new()
	# body_test_motion takes the body's own mask: the terrain's alone while
	# the probe runs, restored at its end.
	var player_mask := player.collision_mask
	player.collision_mask = TERRAIN_ONLY_COLLISION_MASK
	var tile := MapmTerrainBuilder.TILE_SIZE
	var tiles_per_step := REGION_SPAN / tile / float(samples)
	var oblique := Vector3(-1.0, -1.0, -0.6).normalized()
	for group in groups:
		var g: Node3D = group
		var parts := String(g.name).trim_prefix("RealTerrain_").split("_")
		var region_name := "%s/%s" % [parts[0], parts[1]] if parts.size() == 2 else String(g.name)
		var region: MapmReader.ParsedRegion = null
		if parts.size() == 2:
			region = _grid.parsed_heightmaps.get(RegionGridState.region_key(int(parts[0]), int(parts[1])))
		var heights := TerrainCollision.heights_from_region(region)
		if heights.is_empty():
			print("QA GROUND %s: no parsed heightmap held for it -- not probed" % region_name)
			continue
		var counts := {"vertical": 0, "oblique": 0, "sphere": 0, "body": 0}
		# Arrays, not PackedStringArrays: a packed array is a value type, and
		# one appended to through a Dictionary subscript is a copy.
		var values := {"vertical": [], "oblique": [], "sphere": [], "body": []}
		var worst_vertical := 0.0
		var worst_vertical_at := Vector2.ZERO
		var worst_oblique := 0.0
		var other_diagonal_off := 0
		var steepest := 0.0
		for iz in range(samples):
			for ix in range(samples):
				var lx := (floorf((float(ix) + 0.5) * tiles_per_step) + QA_GROUND_IN_QUAD.x) * tile
				var lz := (floorf((float(iz) + 0.5) * tiles_per_step) + QA_GROUND_IN_QUAD.y) * tile
				var drawn := TerrainCollision.mesh_height_at(heights, lx, lz)
				# How much this quad would punish the wrong diagonal: at
				# QA_GROUND_IN_QUAD the other split is off by 0.45 of
				# h00 + h11 - h10 - h01; and the quad's steepest edge.
				var qc := int(lx / tile)
				var qr := int(lz / tile)
				var side := TerrainCollision.SIDE
				var h00 := heights[(side - 1 - qr) * side + qc]
				var h10 := heights[(side - 1 - qr) * side + qc + 1]
				var h01 := heights[(side - 2 - qr) * side + qc]
				var h11 := heights[(side - 2 - qr) * side + qc + 1]
				if absf(h00 + h11 - h10 - h01) * QA_GROUND_IN_QUAD.x > 0.5:
					other_diagonal_off += 1
				steepest = maxf(steepest, maxf(absf(h10 - h00), absf(h01 - h00)) / tile)
				var ray := PhysicsRayQueryParameters3D.create(
					g.to_global(Vector3(lx, drawn + 300.0, lz)), g.to_global(Vector3(lx, drawn - 300.0, lz)))
				ray.collision_mask = TERRAIN_ONLY_COLLISION_MASK
				var hit := space.intersect_ray(ray)
				if hit.is_empty():
					values["vertical"].append("miss")
				else:
					counts["vertical"] += 1
					var y := g.to_local(hit.position as Vector3).y
					values["vertical"].append("%.3f" % y)
					if absf(y - drawn) > worst_vertical:
						worst_vertical = absf(y - drawn)
						worst_vertical_at = Vector2(lx, lz)
				var through := Vector3(lx, drawn, lz)
				var from := g.to_global(through - oblique * 400.0)
				ray = PhysicsRayQueryParameters3D.create(from, g.to_global(through + oblique * 400.0))
				ray.collision_mask = TERRAIN_ONLY_COLLISION_MASK
				hit = space.intersect_ray(ray)
				if hit.is_empty():
					values["oblique"].append("miss")
				else:
					counts["oblique"] += 1
					var at := g.to_local(hit.position as Vector3)
					values["oblique"].append("%.3f" % from.distance_to(hit.position as Vector3))
					var off := absf(at.y - TerrainCollision.mesh_height_at(heights, at.x, at.z))
					if not is_nan(off):
						worst_oblique = maxf(worst_oblique, off)
				# The camera spring's query: the arm's own shape swept down with
				# cast_motion, its centre QA_GROUND_SWEEP_START above the column.
				var params := PhysicsShapeQueryParameters3D.new()
				params.shape = sphere
				params.collision_mask = TERRAIN_ONLY_COLLISION_MASK
				params.exclude = [player.get_rid()]
				params.transform = Transform3D(Basis(), g.to_global(Vector3(lx, drawn + QA_GROUND_SWEEP_START, lz)))
				params.motion = Vector3(0.0, -QA_GROUND_SWEEP, 0.0)
				var fractions := space.cast_motion(params)
				if fractions.size() < 2 or fractions[0] >= 1.0:
					values["sphere"].append("miss")
				else:
					counts["sphere"] += 1
					values["sphere"].append("%.3f" % (QA_GROUND_SWEEP * fractions[0]))
				# move_and_slide's query: the player's own body (its origin is
				# its feet) moved down with body_test_motion from the same
				# height -- from a transform of its own, so the player does
				# not move; the mask is the terrain's alone for the probe.
				var motion := PhysicsTestMotionParameters3D.new()
				motion.from = Transform3D(player.global_transform.basis,
					g.to_global(Vector3(lx, drawn + QA_GROUND_SWEEP_START, lz)))
				motion.motion = Vector3(0.0, -QA_GROUND_SWEEP, 0.0)
				var moved := PhysicsTestMotionResult3D.new()
				if PhysicsServer3D.body_test_motion(player.get_rid(), motion, moved):
					counts["body"] += 1
					values["body"].append("%.3f" % moved.get_travel().length())
				else:
					values["body"].append("miss")
		var n := samples * samples
		print("QA GROUND %s: vertical %d/%d hit, worst %.4f from the drawn triangle (local %.0f, %.0f); oblique %d/%d hit, worst %.4f off the drawn surface; sphere %d/%d touched; body %d/%d touched; %d quad(s) where the other diagonal would be off by over 0.5, steepest edge %.2f" % [
			region_name, counts["vertical"], n, worst_vertical, worst_vertical_at.x, worst_vertical_at.y,
			counts["oblique"], n, worst_oblique, counts["sphere"], n, counts["body"], n, other_diagonal_off, steepest])
		print("QA GROUND VALUES %s vertical=%s oblique=%s sphere=%s body=%s" % [
			region_name, ",".join(PackedStringArray(values["vertical"])), ",".join(PackedStringArray(values["oblique"])),
			",".join(PackedStringArray(values["sphere"])), ",".join(PackedStringArray(values["body"]))])
	player.collision_mask = player_mask

func _qa_scan_report(samples: int) -> void:
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		print("QA SCAN: not standing in any loaded region")
		return
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	var space := get_viewport().world_3d.direct_space_state

	var step_span := REGION_SPAN / float(samples)
	var worst: Array = []
	var checked := 0
	var under := 0
	for iz in range(samples):
		for ix in range(samples):
			var lx := (ix + 0.5) * step_span
			var lz := (iz + 0.5) * step_span
			# Probe from a little over head height above where the graph
			# would stand a player, not from the sky: a ray dropped from
			# far above lands on a tree canopy or a roof, neither of which
			# says anything about the floor underfoot.
			var walkable := graph.height_at(lx, lz, 0.0)
			var head := walkable + _player_capsule_height() * 2.0
			var top := group.to_global(Vector3(lx, head, lz))
			var bottom := group.to_global(Vector3(lx, walkable - 1.0, lz))
			# Off the heightfield's grid lines (TerrainCollision.vertical_ray,
			# round 572): at 48 samples the lattice is on them.
			var hit := TerrainCollision.vertical_ray(space, top.x, top.z, top.y, bottom.y,
				0xFFFFFFFF & ~GATE_PICK_COLLISION_LAYER, [player.get_rid()])
			if hit.is_empty():
				continue
			checked += 1
			var solid_local := group.to_local(hit["position"] as Vector3)
			var drop := solid_local.y - walkable
			if drop <= STAND_UNDER_TOLERANCE:
				continue
			under += 1
			var collider = hit["collider"]
			var what := "?"
			if collider != null:
				var owner_node: Node = (collider as Node)
				while owner_node != null and not String(owner_node.name).begins_with("Obj_"):
					owner_node = owner_node.get_parent()
				what = String(owner_node.name) if owner_node != null else String((collider as Node).name)
			worst.append([drop, lx, lz, walkable, solid_local.y, what])

	worst.sort_custom(func(a, b): return a[0] > b[0])
	print("QA SCAN: %d of %d sampled spots put the player under the solid geometry there (%.0f-unit grid)" % [
		under, checked, step_span])
	for i in range(mini(worst.size(), 15)):
		print("QA SCAN   %6.1f under  local (%.0f, %.0f)  graph stands at %.1f, geometry at %.1f  %s" % [
			worst[i][0], worst[i][1], worst[i][2], worst[i][3], worst[i][4], worst[i][5]])

## Hides every mesh under a placed object whose own real mesh name
## contains one of the given fragments, and reports what it hid.
##
## A real object is assembled from several real .bms pieces (a gate is its
## walls, its roof, its stairs, its door), and when the assembled result
## looks wrong the question is always *which piece*. Rendering the pieces
## separately does not answer it, because a piece only means anything in
## the place the others put it. Switching one off in the built world does.
func _qa_hide_meshes(fragments: PackedStringArray) -> void:
	var hidden := 0
	var names := {}
	for group in get_children():
		if not String(group.name).begins_with("RealTerrain"):
			continue
		for container in (group as Node3D).get_children():
			if not String(container.name).begins_with("RealMapObjects"):
				continue
			for node in container.get_children():
				var stack: Array[Node] = [node]
				while not stack.is_empty():
					var current: Node = stack.pop_back()
					if current is MeshInstance3D:
						var lower := String(current.name).to_lower()
						for fragment in fragments:
							if fragment != "" and lower.contains(fragment.strip_edges().to_lower()):
								(current as MeshInstance3D).visible = false
								names[String(current.name)] = true
								hidden += 1
								break
					for child in current.get_children():
						stack.append(child)
	print("QA HIDE: hid %d real mesh instance(s), %d distinct name(s): %s" % [
		hidden, names.size(), names.keys()])

## Prints which real placed objects the camera is actually pointing at,
## nearest first: their real model name, how far away they are, and where
## they are placed in region-local coordinates.
##
## Exists because "what is that wall in front of me?" had no cheap answer.
## Placed objects carry no physics collision of their own -- movement uses
## the navigation graph, not the meshes -- so a physics raycast finds
## nothing, and a big model like a city gate has its origin hundreds of
## units from the piece of it you are standing in front of, which makes
## matching by placement coordinate alone actively misleading. This walks
## the real placed nodes instead and intersects the ray against each
## one's own visual bounds.
func _qa_look_report() -> void:
	var origin := camera_3d.global_position
	var direction := -camera_3d.global_transform.basis.z
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		print("QA LOOK: not standing in any loaded region")
		return
	var group: Node3D = pair[1]

	# Only the region the player is standing in. Walking all 25 loaded
	# regions' object trees allocated enough to take the process down.
	var hits: Array = []
	for container in group.get_children():
		if not String(container.name).begins_with("RealMapObjects"):
			continue
		for node in container.get_children():
			var bounds := _visual_bounds(node as Node3D)
			if not bounds.has_volume():
				continue
			var hit = bounds.intersects_ray(origin, direction)
			if hit == null:
				continue
			hits.append([origin.distance_to(hit), String(node.name), (node as Node3D).position])
	hits.sort_custom(func(a, b): return a[0] < b[0])
	print("QA LOOK from %s facing %s -- %d real object(s) under the crosshair" % [
		origin.round(), direction.round(), hits.size()])
	if _fog_far_real > 0.0:
		print("QA LOOK   zone fog planes (real): near %.0f, far %.0f; drawn with density %g" % [_fog_near_real, _fog_far_real, FOG_DENSITY])
	for i in range(mini(hits.size(), 10)):
		print("QA LOOK   %7.1f away  %s  placed at local %s" % [
			hits[i][0], hits[i][1], (hits[i][2] as Vector3).round()])

	# Everything standing near the camera, whichever region it belongs to,
	# with the size of the geometry actually built for it. A ray answers
	# "what is directly ahead"; this answers "is there anything tall here
	# at all", which is the question when the thing in front of you turns
	# out not to be a placed object.
	var near: Array = []
	for other in get_children():
		if not String(other.name).begins_with("RealTerrain"):
			continue
		for container in (other as Node3D).get_children():
			if not String(container.name).begins_with("RealMapObjects"):
				continue
			for node in container.get_children():
				var node3d := node as Node3D
				var d := origin.distance_to(node3d.global_position)
				if d > 2500.0:
					continue
				var b := _visual_bounds(node3d)
				if not b.has_volume():
					continue
				near.append([d, String(node.name), String(other.name), b])
	# Tallest first: the thing being looked for is usually the big piece of
	# architecture, and sorting by distance buries it under scenery.
	near.sort_custom(func(a, b): return (a[3] as AABB).size.y > (b[3] as AABB).size.y)
	print("QA LOOK nearby: %d real object(s) within 2500, tallest first" % near.size())
	for i in range(mini(near.size(), 14)):
		var box: AABB = near[i][3]
		var group_node := get_node_or_null(NodePath(near[i][2])) as Node3D
		var lo := box.position
		var hi := box.position + box.size
		if group_node != null:
			lo = group_node.to_local(box.position)
			hi = group_node.to_local(box.position + box.size)
		print("QA LOOK   %7.1f  %-30s %-20s size %s  local %s .. %s" % [
			near[i][0], near[i][1], near[i][2], box.size.round(),
			lo.round(), hi.round()])

## One placed object's visual bounds in world space, merged over every
## mesh under it -- a real placed object is a tree of MeshInstance3Ds, not
## one mesh. Walks the tree with an explicit stack and merges in place, so
## reporting on a dense region does not allocate an array per object.
func _visual_bounds(node: Node3D) -> AABB:
	var merged := AABB()
	var seeded := false
	var stack: Array[Node] = [node]
	while not stack.is_empty():
		var current: Node = stack.pop_back()
		if current is MeshInstance3D:
			var mesh_node := current as MeshInstance3D
			if mesh_node.mesh != null:
				var box: AABB = mesh_node.global_transform * mesh_node.get_aabb()
				if seeded:
					merged = merged.merge(box)
				else:
					merged = box
					seeded = true
		for child in current.get_children():
			stack.append(child)
	return merged

## Lifts the player over a real step they would otherwise walk straight
## into.
##
## Godot's CharacterBody3D does not climb ledges at all -- a vertical riser
## stops it outright -- so every real staircase in the world was
## unclimbable. Found in a real playtest at the real Jangan temple: the
## steps blocked movement outright while the sloped edges beside them could
## be finagled up, which is exactly this failure's signature.
##
## Only lifts when the move is genuinely blocked at foot level, there is
## headroom to rise, *and* the same move is clear one step higher -- so a
## real wall still stops the player rather than being walked up.
func _try_step_up(delta: float) -> void:
	if not player.is_on_floor():
		return
	var horizontal := Vector3(player.velocity.x, 0.0, player.velocity.z)
	if horizontal.length_squared() < 0.01:
		return
	var motion := horizontal * delta
	if not player.test_move(player.global_transform, motion):
		return # not blocked -- nothing to climb
	var step := Vector3.UP * (_player_capsule_height() * STEP_HEIGHT_FRACTION)
	if step.y <= 0.0 or player.test_move(player.global_transform, step):
		return # no headroom to rise
	if player.test_move(player.global_transform.translated(step), motion):
		return # still blocked a step up -- a real wall, not a step
	player.global_position += step

## Whether the keys are going into a text line rather than to the game: the
## chat's input, or any other focused LineEdit or TextEdit in the viewport
## (HudPanels.is_typing) -- the guild name prompt of round 521, the warehouse
## gold dialog's amount. KeyInput runs no key while it holds, and
## _physics_process stops a click walk.
func _is_typing() -> bool:
	if _hud_chat != null and _hud_chat.is_typing():
		return true
	if _hud_panels != null:
		return _hud_panels.is_typing()
	# No HUD (no Media.pk2): the scene's fallback chat line and the debug
	# panel's fields are LineEdits too.
	if not is_inside_tree():
		return false
	var focus := get_viewport().gui_get_focus_owner()
	return (focus is LineEdit or focus is TextEdit) and focus.is_visible_in_tree()

## The per-frame work clock (round 561). The whole step is timed and noted
## against the drawn frame, less the cells _process_stream_queue built inside
## it, which end_cell has already noted on their own; the wall clock between
## steps goes beside it. Work time and not `delta`: every benchmark runs
## under qa_shot.sh's `--write-movie`, which forces `--fixed-fps` ("disables
## real-time synchronization", Godot 4.2's command line reference;
## `editor/movie_writer/fps` default 60), so `delta` reads 1/60 s on every
## frame however long it took -- LoadTimings' doc comment and
## client/tools/README.md, "Load benchmark".
func _physics_process(delta: float) -> void:
	if title_mode:
		_title_physics(delta)
		return
	var sw := Time.get_ticks_usec()
	_hover_tick()
	if _qa_split != null:
		_qa_split.on_step(Engine.get_frames_drawn())
	SkillEffects.tick(delta)
	BerserkLook.tick(delta)
	# Monsters and other players fading into existence (round 676).
	_appear_fades.step(delta)
	_berserk_flash_step(delta)
	_qa_berserk_probe()
	var cells_before := _load_timings.cell_work_usec
	_physics_step(delta)
	# The ring follows its object, or hides (round 698).
	if _ground_markers != null:
		_ground_markers.step()
	var now := Time.get_ticks_usec()
	var frame := Engine.get_frames_drawn()
	_load_timings.note_frame((now - sw - (_load_timings.cell_work_usec - cells_before)) / 1000.0, frame, "")
	_load_timings.note_wall(frame, now)
	if _qa_split != null:
		_qa_split.physics_usec += Time.get_ticks_usec() - sw
		if _qa_split.due():
			_qa_split_print()

## One physics step of the world: the sky, the monsters' legs, the player's
## input and walk, the QA hooks, region streaming and the position send.
func _physics_step(delta: float) -> void:
	_check_talk_range()
	if _sky_dome != null:
		# READ: u += frac(GetTickCount() / 500000); the layer itself follows
		# the eye in its shader.
		_cloud_uv_offset.x = fposmod(Time.get_ticks_msec() / CLOUD_SCROLL_MS, 1.0)
		_sky_dome_material.set_shader_parameter("uv_offset", _cloud_uv_offset)
	if _sun_glow != null:
		_sun_glow.global_position = player.global_position + _sun_glow_offset

	# Monsters walking a server-driven leg step first, so an approach walk's
	# reach test below measures to where they are drawn this frame; the
	# ground items still waiting for ground share the frame's height budget
	# with them (_step_heights).
	var split_sw := Time.get_ticks_usec()
	_step_heights(delta)
	if _qa_split != null:
		_qa_split.heights_usec += Time.get_ticks_usec() - split_sw
	# SRREVAMP_QA_MOBS (round 655): a dense monster list, once.
	_qa_mobs_step()
	# SRREVAMP_QA_LINEUP (round 689): the Figures as other players, measured.
	if _qa_lineup != null:
		_qa_lineup.step(delta)
	# The monster bodies a list queued, a frame's budget of them (round 655).
	split_sw = Time.get_ticks_usec()
	_pump_monster_builds()
	if _qa_split != null:
		_qa_split.pump_usec += Time.get_ticks_usec() - split_sw
	# V and Z, while held (round 608).
	_apply_key_holds()

	# No key moves the character (round 608): the player walks by clicking,
	# as the retail defaults have it. The WASD keys this client used to read
	# (Input.get_axis on move_* actions) went with the retail key table,
	# where S, A and W are the skill, action and pet-switch keys; retail's
	# own arrow-key walk (KeyMap.NOT_BOUND) sends move packets this server
	# does not have. The typing test below still stops a click walk, as it
	# stopped the keys: a focused text line is the player typing (_is_typing;
	# the guild name prompt of round 521).
	var typing := _is_typing()
	# Dead (round 548): no click or QA walk moves the body and no attack
	# walks into reach, as when typing -- the server neither stores nor relays
	# a dead player's OpMove (the dead state's server half; retail's
	# `GetLifeState() != 1` guards). Gravity, streaming and the position send
	# below still run, as they do while typing.
	# Getting up or down (round 607): the server refuses a move in its 1.5 s
	# transition, so none is made; a move while seated is allowed and stands
	# the character at once (_leave_sit_by_moving), as the server's does.
	# Rooted by the player's own wall (round 640, OURS -- _wall_root): a walk
	# already under way when the wall went up stops, as the server drops its
	# moves.
	var locked := typing or _player_dead or _motion_locked() or (_has_move_target and _wall_root() != 0)
	if locked:
		_has_move_target = false
		_pending_attack = {}
		_released_attack = {}
		_pending_friend_cast = {}
	# A talk approach's arrival (round 701): the walk ended last tick.
	_step_talk_approach(locked)
	# Round 653's follow-up: an approach whose move a wall ended is re-issued
	# here on the next tick (_step_move_order).
	if _has_move_target or not _pending_attack.is_empty() or not _pending_friend_cast.is_empty():
		_step_move_order(delta)
	elif _qa_walk != "" and not _player_dead:
		# SRREVAMP_QA_WALK: walk on a fixed world heading (its own path; no
		# key moves the character since round 608), so a render shows the
		# run and the log the path.
		var ang := deg_to_rad(float(_qa_walk))
		player.velocity.x = sin(ang) * _move_speed
		player.velocity.z = cos(ang) * _move_speed
		# QA only: faces the fixed heading at once, as before.
		player.rotation.y = ang
		_player_turn_target = NAN
	else:
		player.velocity.x = 0.0
		player.velocity.z = 0.0
	_step_local_turn(delta)

	var is_moving := _has_move_target or (_qa_walk != "" and not _player_dead)
	if is_moving and (_sit.sitting or (_player_sit_clip != null and _player_one_shot == _player_sit_clip)):
		_leave_sit_by_moving()
	# The camera keeps whatever orbit it was given (see CAMERA_VIEW_FREE).
	# It used to swing back to the default yaw and pitch whenever the
	# character moved, and, hanging from the body, turned with every click.
	_follow_with_camera(delta)

	_qa_step()
	if _teleport_landing != null:
		# A teleport arrival still waiting for its region (round 576): held,
		# neither walking nor falling, until _step_teleport_landing lands it.
		_step_teleport_landing()
	else:
		var walk_from := player.position
		var on_graph := _move_on_nav_graph(delta)
		if not on_graph:
			_end_run_off_world(delta)
		if not on_graph:
			if not player.is_on_floor():
				player.velocity.y -= GRAVITY * delta
			else:
				player.velocity.y = 0.0
			_try_step_up(delta)
			player.move_and_slide()
			# Round 653, OURS: with no navigation graph under the player (a
			# region with no .nvm, or before one streams in) an order that
			# meets a physics wall ends there too, as retail's mover ends at
			# a wall (ClickWalk.blocked_ends); an approach is re-issued.
			if _has_move_target and player.is_on_wall():
				_has_move_target = false
				_move_heading_run = false
				player.velocity.x = 0.0
				player.velocity.z = 0.0
		_walked_since_send += Vector2(player.position.x - walk_from.x, player.position.z - walk_from.z).length()

	# CharacterBody3D.is_on_floor() was observed real, unreliable here (stays
	# false indefinitely for a character resting motionless since spawn, a
	# separate quirk not chased this round) -- a direct raycast is used
	# instead to tell "resting on real ground" from "still falling" for
	# _last_grounded_position's purposes.
	# Off the heightfield's grid lines (TerrainCollision.vertical_ray, round
	# 572).
	var ground_hit := TerrainCollision.vertical_ray(get_world_3d().direct_space_state,
		player.position.x, player.position.z, player.position.y + 10.0, player.position.y - 3000.0,
		TERRAIN_ONLY_COLLISION_MASK, [player.get_rid()])
	if not ground_hit.is_empty() and player.position.y - ground_hit.position.y < 20.0:
		_last_grounded_position = player.position
	elif player.position.y < WORLD_FLOOR_Y:
		# Fell into a real gap in the streamed region grid (see
		# WORLD_FLOOR_Y's doc comment) -- no terrain exists here at all, so
		# rather than let the player fall through an unbounded void, return
		# them to the last real ground they stood on.
		player.position = _last_grounded_position
		player.velocity = Vector3.ZERO
		_has_move_target = false
		_pending_attack = {}
		# Put back, not walked back (round 637's review follow-up): others
		# place the body there without turning it.
		_relocated_pending = true

	_recover_if_below_terrain()

	_maybe_stream_regions()
	_process_stream_queue()
	_refresh_zone_label_position()
	# The minimap once per rendered frame, like the clip tick (round 664):
	# its signs walk every body, and a slow frame ran it in each physics step.
	if _minimap_frame != Engine.get_process_frames():
		_minimap_frame = Engine.get_process_frames()
		split_sw = Time.get_ticks_usec()
		_refresh_minimap()
		if _qa_split != null:
			_qa_split.minimap_usec += Time.get_ticks_usec() - split_sw
	_update_blob_shadow()

	_time_since_send += delta
	# No position goes out while seated or getting up or down (round 607): the
	# server takes any move while seated as walking off and stands the
	# character, and refuses one in its transition -- a settling body must not
	# do either. A real move clears the sit above (_leave_sit_by_moving) first.
	if _time_since_send >= MIN_SEND_INTERVAL and player.position.distance_to(_last_sent_pos) >= MIN_SEND_DISTANCE \
			and not _sit.sitting and not _motion_locked():
		# A heading run's positions carry its heading (round 653; retail's
		# heading form relayed, WorldNet.encode_move).
		var run_wire := SkyRun.wire_angle(_move_heading) if (_has_move_target and _move_heading_run) else -1
		if _qa_move_log:
			print("MOVE send t=%d ms=%d pos=(%.3f,%.3f)%s" % [_qa_move_tick + 1, Time.get_ticks_msec(), player.position.x, player.position.z,
				(" heading=%d" % run_wire) if run_wire >= 0 else ""])
		NetClient.move_to(player.position.x, player.position.y, player.position.z, _position_relocated(), run_wire)
		_last_sent_pos = player.position
		_walked_since_send = 0.0
		_time_since_send = 0.0

	# Smooths every other real entity toward its latest known position
	# instead of teleporting the instant an update arrives -- see
	# _other_body_targets' own doc comment for the real stutter this fixes.
	# OTHER_BODY_INTERPOLATION_SPEED is a real engineering choice (how
	# quickly a body catches up to its target each frame), not a claim
	# about real client behavior -- tuned so a body visually arrives at
	# its target well within one real MIN_SEND_INTERVAL period.
	for character_id in _other_body_targets:
		if not _other_bodies.has(character_id):
			continue
		var body: Node3D = _other_bodies[character_id]
		var target: Vector3 = _other_body_targets[character_id]
		# Still catching up to the last update means the player is on the
		# move; arrived means standing. The threshold is a fraction of the
		# body's own height, so a settled body does not flicker between the
		# two on the last inch of the lerp.
		_set_other_gait(character_id, body.position.distance_to(target) > OTHER_GAIT_THRESHOLD)
		body.position = body.position.lerp(target, minf(OTHER_BODY_INTERPOLATION_SPEED * delta, 1.0))
	_step_remote_turns(delta)
	if _qa_facing_log:
		_qa_facing_report()
	if _qa_move_log:
		_qa_move_report()

	if _real_skeleton != null and _real_skeleton_track.keyframes.size() > 1:
		_real_skeleton_time += delta
		var frame_idx := _real_skeleton_anim.key_index_at(_real_skeleton_time, true)
		Skeleton3DBuilder.apply_ban_keyframe(_real_skeleton, _real_skeleton_track, frame_idx)
		Skeleton3DBuilder.update_debug_visualization(_real_skeleton.get_node("DebugVisualization"), _real_skeleton)

	# RE-ENABLED (2026-08-28, see docs/WORLD_ISSUES.md's twenty-eighth round)
	# -- was disabled 2026-08-26 after a real playtest found the assembled
	# player body's limbs flying apart the instant this ran, root-caused to
	# Skeleton3DBuilder.build_skeleton3d using Basis.IDENTITY for every
	# bone's rest instead of its real .bsk bind rotation. That's now fixed
	# (see Skeleton3DBuilder's own top comment) and visually re-verified via
	# real rendered screenshots showing a coherent walking stride, not
	# exploded limbs -- safe to re-enable. Picks walk_anim/idle_anim (see
	# is_moving, computed above) the same way _real_skeleton's separate
	# dev-only demo path already picks its one fixed animation, using the
	# same BAN_FPS playback-rate engineering guess (not reverse-engineered
	# real timing).
	# **Disabled 2026-09-02** (see docs/WORLD_ISSUES.md's forty-eighth
	# round). Fixing CharacterAssembler.attach_rigid made the real
	# assembled character render correctly for the first time -- but only
	# in its real bind pose. With this real .ban playback driving the
	# skeleton it still comes out distorted (arms and legs splayed
	# outward), so `apply_ban_pose` has its own separate real bug. That
	# earlier "coherent walking stride" check only ever looked at a bare
	# skeleton's bone positions, never at real attached body meshes, which
	# is why it read as fine.
	#
	# **One hypothesis tested and disproven (2026-09-02)**: that real .ban
	# rotations are in the same global/world space this project already had
	# to convert out of for .bsk bind rotations (see
	# Skeleton3DBuilder.build_skeleton3d), and that applying them as *local*
	# pose rotations compounds error down the bone chain. Implemented the
	# global-to-parent-relative conversion and rendered it against real
	# data: the result is dramatically *worse* (the character scatters
	# completely, rather than merely splaying), so real .ban rotations are
	# not global-space and that is not the bug. The existing delta-against-
	# keyframe-0 approach is closer to correct than that alternative.
	# What the real encoding actually is remains genuinely unknown -- it
	# needs real evidence, not another guess.
	#
	# Left disabled rather than shipped visibly broken (same call this
	# project already made for the sky cloud dome), so the real character
	# renders correctly, just statically.
	# **Enabled 2026-09-08.** Two real bugs stood between this and a correct
	# character, and both were invisible in the bind pose: the skeleton's
	# root bone was given an identity rest instead of its own (see
	# Skeleton3DBuilder), and every paired body part was attached to the
	# wrong side's bone (see CharacterAssembler._attach_paired). With both
	# fixed the character stands correctly, arms at its sides, and moves
	# with the real animation.
	# NPCs and monsters, playing their own standing animations -- once per
	# rendered frame, with every step's time (round 664, MonsterCrowd.TickGate).
	var idle_delta := _idle_tick_gate.take(Engine.get_process_frames(), delta)
	if idle_delta >= 0.0:
		# Name plates within 300 of the player (round 673, NamePlates): a
		# share of them each rendered frame.
		if player != null and player.is_inside_tree():
			_plate_sweep.step(player.global_position)
			_step_monster_plate_scale()
		split_sw = Time.get_ticks_usec()
		_tick_idle_animations(idle_delta)
		if _qa_split != null:
			_qa_split.idle_usec += Time.get_ticks_usec() - split_sw
			_qa_split.posed += _anim_posed_last
	# Map objects that move -- trees, reeds, tentacles (round 645).
	_tick_map_animations()

	if _player_skeleton != null and not _body_assets(_player_body).is_empty():
		# The game's default gait is a run -- `chinaman_fighter_runforward`
		# is the type-7 entry, and it is the one a held sword replaces with
		# its own (`_runforward_sword`) -- so moving plays the run of the
		# weapon's group and standing plays its town idle.
		var action: int
		if is_moving:
			action = BsrReader.AnimationEntry.TYPE_RUN
		elif _sit.sitting:
			# The sitting loop, under the sit-down one-shot while that runs.
			action = BsrReader.AnimationEntry.TYPE_SITTING
		elif _player_anim_time - _last_combat_time < COMBAT_STANCE_SECONDS:
			# Recently in combat: hold the battle stance rather than the town idle.
			action = BsrReader.AnimationEntry.TYPE_STAND_BATTLE
		else:
			action = BsrReader.AnimationEntry.TYPE_STAND
		var anim := _body_animation_for(_player_body, action, _player_weapon_group)
		_player_anim_time += delta
		if _player_one_shot != null:
			var elapsed := _player_anim_time - _player_one_shot_start
			if elapsed >= _player_one_shot.duration_seconds() and not _player_one_shot_hold:
				# Its last tracks, on the frame that ends it.
				_anim_sounds.advance(_player_skeleton, _player_one_shot, _player_one_shot_start,
					float(_player_one_shot.duration_ms), false)
				_player_one_shot = null
			else:
				# A held one-shot (the die clip, round 548) keeps its last
				# keyframe past its end: apply_ban_pose_at pins a non-looping
				# clip on it once `seconds` reaches the duration.
				Skeleton3DBuilder.apply_ban_pose_at(_player_skeleton, _player_one_shot, elapsed, false)
				_anim_sounds.advance(_player_skeleton, _player_one_shot, _player_one_shot_start, elapsed * 1000.0, false)
		if _player_one_shot == null and anim != null and not anim.bones.is_empty():
			var ref_track: BanReader.Bone = anim.bones[0]
			if not ref_track.keyframes.is_empty():
				# Pinnable, so the in-world pose can be held against the same
				# frame applied offline by check_ban_pose.gd -- which is how
				# the two were shown to agree exactly.
				var pinned := OS.get_environment("SRREVAMP_QA_ANIM_FRAME")
				if pinned != "" and pinned.is_valid_int():
					Skeleton3DBuilder.apply_ban_pose(_player_skeleton, anim, int(pinned) % ref_track.keyframes.size())
				else:
					# On the clip's own clock: every keyframe at the time the
					# file gives it, blended in between. See BAN_FORMAT.md --
					# a fixed 30 keyframes a second ran the idle five times
					# too fast.
					Skeleton3DBuilder.apply_ban_pose_at(_player_skeleton, anim, _player_anim_time, true)
					_anim_sounds.advance(_player_skeleton, anim, 0.0, _loop_ms(anim, _player_anim_time), true)

## Whether the OpMove about to go out is a relocation (round 637's review
## follow-up), consumed by the send: one already known (_relocated_pending:
## a placement, a recovery) or a displacement (x, z) from the last sent
## position that the physics step's walk since then cannot account for
## (_walked_since_send + RELOCATE_MARGIN) -- a QA or GM placement, the
## unstuck landing. OURS: srrevamp's OpMove is a position stream, and this is
## how its sender tells a placement from a step; the retail client sends a
## destination and the server places objects with a message of its own.
func _position_relocated() -> bool:
	var moved := Vector2(player.position.x - _last_sent_pos.x, player.position.z - _last_sent_pos.z).length()
	var relocated := _relocated_pending or moved > _walked_since_send + RELOCATE_MARGIN
	_relocated_pending = false
	return relocated

## The player's own turn (round 637's review follow-up): the heading its walk
## turns toward, NAN when no turn is in progress. READ: the player's click is
## sent and its echo (0xB021 -> NetProcessInNavAndSkill::FUN_008a5750 ->
## FUN_009e0550) turns the player's own mover at RemoteFacing's rate, exactly
## as another player's; the one exception, FUN_009e04b0's snap, is
## _player_turn_snap (RemoteFacing.click_rule).
var _player_turn_target := NAN
## The next aim snaps the heading and ends any turn (FUN_009e04b0 ->
## FUN_009e0050), set by a click RemoteFacing.click_rule calls "snap".
var _player_turn_snap := false
## The player's movement order is in effect (the object's +0x714, mover +0xac,
## READ): FUN_009e0550 / FUN_009e04b0 / FUN_009e08a0 set it; the stop or
## position message (FUN_008a4f80 -> FUN_009e00f0), FUN_009e0150,
## FUN_009e11e0 and FUN_009e0960 clear it, and arriving does NOT (FUN_009e0e60
## clears +0x84 only). srrevamp has no stop message: it is set by an accepted
## ground click and cleared by a new world entry or zone change (a new object)
## and by the player's own skill move -- the last two mappings INFERRED.
var _player_move_order := false

## Aims the player's walk along `dir` (world): the target heading is the
## direction's, as the echoed move aims it; a pending snap sets it at once.
func _aim_local_player(dir: Vector3) -> void:
	var current := RemoteFacing.heading_of_yaw(player.rotation.y, 0.0)
	var target := RemoteFacing.heading_toward(current, dir)
	if _player_turn_snap:
		_player_turn_snap = false
		player.rotation.y = RemoteFacing.yaw_of(target, 0.0)
		_player_turn_target = NAN
		return
	_player_turn_target = target

## One frame of the player's turn, walking or standing (FUN_009e0e60 runs the
## turn for a mover that is not moving too, while +0x88 & 0x31).
func _step_local_turn(delta: float) -> void:
	if is_nan(_player_turn_target):
		return
	var r := RemoteFacing.turn(RemoteFacing.heading_of_yaw(player.rotation.y, 0.0), _player_turn_target, delta * 1000.0)
	player.rotation.y = RemoteFacing.yaw_of(float(r["heading"]), 0.0)
	if not bool(r["turning"]):
		_player_turn_target = NAN

## SRREVAMP_QA_FACING_LOG=1 (round 637): every 50 ms, one line for this
## player ("self", from its review follow-up), one per other player's body
## and per monster on a leg, with where it is drawn and the way
## its MODEL faces, read off the drawn skeleton's global basis (the player
## body's front is its skeleton's -Z, MEASURED in round 533; a monster's is
## MonsterMotion.MODEL_FRONT, -Z). client/tools/facing_measure.py turns
## consecutive lines into movement-versus-facing angles. Measurement only.
var _qa_facing_log := OS.get_environment("SRREVAMP_QA_FACING_LOG") != ""
## SRREVAMP_QA_MOVE_LOG=1 (round 649): see _qa_move_report. Measurement only.
var _qa_move_log := OS.get_environment("SRREVAMP_QA_MOVE_LOG") != ""
var _qa_move_tick := 0

## One tick of SRREVAMP_QA_MOVE_LOG (round 649): "MOVE self" is this player
## after the walk (world x, z, the click destination and whether one is in
## effect, the run speed, the distance left), "MOVE body" each other player's
## drawn position and its latest received target. Sends and receipts print
## their own "MOVE send" / "MOVE recv" lines where they happen.
func _qa_move_report() -> void:
	_qa_move_tick += 1
	var ms := Time.get_ticks_msec()
	var left := Vector2(_move_target.x - player.position.x, _move_target.z - player.position.z).length()
	# Round 653: "run" is a heading run in effect (no destination; `left` is
	# then to its OURS reach point), "facing" the body's heading and "gait"
	# the locomotion the body plays (run while an order is in effect).
	print("MOVE self t=%d ms=%d pos=(%.3f,%.3f) dest=(%.3f,%.3f) order=%s speed=%.1f left=%.3f run=%s facing=%.3f gait=%s" % [
		_qa_move_tick, ms, player.position.x, player.position.z, _move_target.x, _move_target.z,
		str(_has_move_target), _move_speed, left, str(_has_move_target and _move_heading_run),
		RemoteFacing.heading_of_yaw(player.rotation.y, 0.0), "run" if _has_move_target else "stand"])
	for id in _other_bodies:
		var body: Node3D = _other_bodies[id]
		if not is_instance_valid(body) or not _other_body_targets.has(id):
			continue
		var to: Vector3 = _other_body_targets[id]
		print("MOVE body %d t=%d ms=%d pos=(%.3f,%.3f) target=(%.3f,%.3f)" % [
			id, _qa_move_tick, ms, body.position.x, body.position.z, to.x, to.z])
var _qa_facing_log_ms := 0
## The monsters whose model the facing report has named (round 673).
var _qa_facing_models := {}

func _qa_facing_report() -> void:
	var now := Time.get_ticks_msec()
	if now - _qa_facing_log_ms < 50:
		return
	_qa_facing_log_ms = now
	# This player too (round 637's review follow-up): its own turn, read off
	# its drawn skeleton the same way.
	if _player_skeleton != null and is_instance_valid(_player_skeleton):
		var own := _player_skeleton.global_basis * Vector3(0, 0, -1)
		print("QA FACING self 0 ms=%d pos=(%.3f,%.3f) front=(%.4f,%.4f)" % [
			now, player.global_position.x, player.global_position.z, own.x, own.z])
	for id in _other_bodies:
		var body: Node3D = _other_bodies[id]
		if not is_instance_valid(body):
			continue
		var gait: Dictionary = _other_gaits.get(id, {})
		var skel = gait.get("skeleton")
		var front := Vector3.ZERO
		if skel != null and is_instance_valid(skel):
			front = (skel as Node3D).global_basis * Vector3(0, 0, -1)
		print("QA FACING player %d ms=%d pos=(%.3f,%.3f) front=(%.4f,%.4f)" % [
			id, now, body.global_position.x, body.global_position.z, front.x, front.z])
	for id in _monster_motion:
		var mbody = _monster_bodies.get(id)
		if mbody == null or not is_instance_valid(mbody):
			continue
		# Every drawn model (round 673), not only the ones with a table entry:
		# its skeleton's -Z is the model's front (MEASURED for 117 of the 155
		# MOB_ models, none reading another axis clearly --
		# client/tools/probe_monster_front.gd --all=1), so a body the client
		# never turns shows here as off its path. The capsule has no front.
		var model_path := String((mbody as Node3D).get_meta("model", ""))
		if model_path == "":
			continue
		if not _qa_facing_models.has(id):
			_qa_facing_models[id] = true
			print("QA FACING MODEL %d %s table=%s" % [id, model_path, MonsterMotion.front_of(model_path)])
		var asm: SkinnedBsrAssembler.AssembledCharacter = _monster_assembled.get(id)
		var node: Node3D = asm.skeleton if asm != null and asm.skeleton != null else mbody
		var mf := node.global_basis * Vector3(0, 0, -1)
		print("QA FACING monster %d ms=%d pos=(%.3f,%.3f) front=(%.4f,%.4f)" % [
			id, now, (mbody as Node3D).global_position.x, (mbody as Node3D).global_position.z, mf.x, mf.z])

## SRREVAMP_QA_FACING_LOG (round 673): at each blow a monster swings, the
## angle between its model's front (its skeleton's -Z, as the facing report
## reads it) and the line to its target, and whether it was walking a leg.
func _qa_strike_facing(monster: int, target: Node3D) -> void:
	var body = _monster_bodies.get(monster)
	var asm: SkinnedBsrAssembler.AssembledCharacter = _monster_assembled.get(monster)
	if body == null or asm == null or asm.skeleton == null:
		return
	var front := asm.skeleton.global_basis * Vector3(0, 0, -1)
	var to := target.global_position - (body as Node3D).global_position
	var off := rad_to_deg(absf(wrapf(atan2(front.x, front.z) - atan2(to.x, to.z), -PI, PI)))
	print("QA STRIKE FACE monster %d model %s off %.1f deg moving=%s dist=%.1f" % [
		monster, String((body as Node3D).get_meta("model", "")), off,
		"yes" if _monster_is_moving(monster) else "no", Vector2(to.x, to.z).length()])

## Turns in progress on other players' and monsters' bodies (round 637):
## body instance id -> {"target": the client's heading it turns to, "front":
## the yaw of the body's front from its node's +Z}. RemoteFacing has the rule.
var _remote_turns := {}

## Aims a drawn body along `dir` (world) the way the client's mover does
## (FUN_009e0550 -> FUN_009e02f0(heading, 0)): the target heading is set and
## the turn starts; _step_remote_turns moves the facing each frame. A vector
## too short to have a heading keeps the current one (FUN_009ed130).
func _aim_remote_body(body: Node3D, dir: Vector3, front_yaw: float) -> void:
	if body == null or not is_instance_valid(body):
		return
	var current := RemoteFacing.heading_of_yaw(body.rotation.y, front_yaw)
	var target := RemoteFacing.heading_toward(current, dir)
	_remote_turns[body.get_instance_id()] = {"target": target, "front": front_yaw}

## One frame of every turn in progress: FUN_009e02f0 with the frame's time
## (the mover's tick, FUN_009e0e60 -> FUN_009e0c10). A turn that reaches its
## target ends there; a body that has gone is dropped.
func _step_remote_turns(delta: float) -> void:
	if _remote_turns.is_empty():
		return
	for id in _remote_turns.keys():
		var body := instance_from_id(id) as Node3D
		if body == null or not is_instance_valid(body):
			_remote_turns.erase(id)
			continue
		var turn: Dictionary = _remote_turns[id]
		var front := float(turn["front"])
		var r := RemoteFacing.turn(RemoteFacing.heading_of_yaw(body.rotation.y, front), float(turn["target"]), delta * 1000.0)
		body.rotation.y = RemoteFacing.yaw_of(float(r["heading"]), front)
		if not bool(r["turning"]):
			_remote_turns.erase(id)

## `heading` (round 637's review follow-up) is OpEntityEntered's: the body is
## placed facing it -- FUN_009d17e0 stores the spawn's angle with a bare
## FUN_009c4260, no turn -- and a turn left from before ends (a spawn is a new
## object, whose mover starts with none: 0x9e0cd0 zeroes +0xa4). NAN (a list,
## an older server) leaves the facing as it is. A snapshot is a placement, not
## a walk, so it never aims the body.
##
## `body` and `scale` (round 689) are the character's own model -- a Figure's
## code name (_body_key_for of the snapshot's RefObjID, or of its gender from
## an older server) and its scale byte -- drawn as the local player's is.
func _spawn_or_update_other(character_id: int, char_name: String, pos: Vector3, equipped: Dictionary = {}, body: String = "", heading: float = NAN, scale: int = CharacterAppearance.DEFAULT_SCALE) -> void:
	if not equipped.is_empty():
		_other_equipped[character_id] = equipped
	if _other_bodies.has(character_id):
		# Sets the real interpolation *target* only -- see
		# _other_body_targets' own doc comment for why this replaced a
		# direct position snap.
		_other_body_targets[character_id] = pos
		if not is_nan(heading):
			var drawn: Node3D = _other_bodies[character_id]
			drawn.rotation.y = RemoteFacing.yaw_of(heading, 0.0)
			_remote_turns.erase(drawn.get_instance_id())
		return

	var node := Node3D.new()
	node.position = pos
	if not is_nan(heading):
		node.rotation.y = RemoteFacing.yaw_of(heading, 0.0)

	# The same builder and the same dressing as the local player: their
	# model, scale byte and every worn item's id come in the snapshot (see
	# bodyOf and equippedItems in server/internal/session/world.go, both
	# queried live), and each item is drawn from its own model. Falls back to
	# the labeled placeholder capsule if the bodies never loaded.
	var skeleton := _build_assembled_character(equipped, body, scale)
	if skeleton != null:
		# Same 180deg front correction as the local player (see
		# _try_apply_real_player_character) -- the body's own front is -Z, and
		# the node points +Z where it moves/faces.
		skeleton.rotation.y = PI
		node.add_child(skeleton)
		# Another player stands in the town idle of the group their weapon
		# selects, and runs while their body is still catching up to a
		# position update (see _set_other_gait). Without this they stood
		# in the bind pose, arms out, which no character in the game does.
		body = String(skeleton.get_meta("body", body))
		var group := _weapon_group_for(equipped, body)
		_other_gaits[character_id] = {"skeleton": skeleton, "body": body, "scale": scale, "group": group, "moving": false}
		# Their sounds come from where their body is; the cell under them is
		# found from the height (_audio_material_at), not carried as the
		# local player's is. Their berserk arrives as their body mode (round
		# 651, _berserk_apply), which turns their swings to the hwan ones.
		var owner := _audio_pc_owner("player %d" % character_id, body, equipped, node)
		owner.material = func() -> int: return _audio_material_at(node.global_position, -2) if is_instance_valid(node) else -1
		_anim_sounds.register(skeleton, owner)
		var idle := _body_animation_for(body, BsrReader.AnimationEntry.TYPE_STAND, group)
		var frames := _frame_count(idle)
		if frames > 1:
			_animated.append([skeleton, idle, frames, float(_animated.size()) * 0.37, true, _idle_anim_time, null])
	else:
		var mesh := MeshInstance3D.new()
		var capsule := CapsuleMesh.new()
		capsule.radius = 0.4 * PLAYER_SCALE_RATIO
		capsule.height = 1.8 * PLAYER_SCALE_RATIO
		mesh.mesh = capsule
		var mat := StandardMaterial3D.new()
		mat.albedo_color = Color(0.9, 0.3, 0.3)
		mesh.material_override = mat
		mesh.position.y = 0.9 * PLAYER_SCALE_RATIO
		node.add_child(mesh)

	# The same plate as an NPC's -- fixed screen size, outlined, shown only
	# within range -- over the assembled body's own height.
	var top := _skeleton_top(skeleton) if skeleton != null else 1.8 * PLAYER_SCALE_RATIO
	node.add_child(_name_plate(char_name, top))

	# A click body on its own layer (round 622), so the player can be selected.
	node.set_meta("character_id", character_id)
	node.set_meta("character_name", char_name)
	# Its body key, for the target window's race emblem (round 638; its own
	# model since round 689).
	node.set_meta("body", body)
	node.add_child(_other_player_collider(top))

	other_entities.add_child(node)
	_other_bodies[character_id] = node
	_other_body_targets[character_id] = pos
	# The auras of the buffs this client holds for them go on the new body
	# (round 646): a zone change's arrival list and the world entry build the
	# body after the server's replay may already have arrived.
	_fx_resync_owner(_fx_owner_key(character_id, SkillNet.OWNER_CHARACTER), "their body was built")
	# And their berserk, if they are (round 651): the spawn's own body mode,
	# applied without the start burst (FUN_009cf880(mode, 1, 0), READ).
	_berserk_resync(character_id, "their body was built")
	# They fade into existence over 2.0 s, as a monster does (round 676,
	# AppearFade: READ, CICUser vslot 0x6c FUN_009dbcc0 -> FUN_009d17e0).
	_appear_fades.start(node)

## Another player's body key: their model's (round 689), or their gender's from
## an older server (_body_key_for).
func _snapshot_body(snapshot: WorldNet.EntitySnapshot) -> String:
	return _body_key_for(snapshot.ref_obj_id if snapshot.has_model else 0, snapshot.gender)

func _on_entity_entered(snapshot: WorldNet.EntitySnapshot) -> void:
	# During a zone change's load the old zone's bodies are still drawn and
	# the arrival list is not laid out yet: an arrival is kept for it
	# (round 646's review, _replace_others_for_arrival), not built to be freed.
	if _arrival_pending:
		_arrival_left.erase(snapshot.character_id)
		_arrival_entries[snapshot.character_id] = snapshot
		_log_system("%s entered the zone." % snapshot.char_name)
		return
	_spawn_or_update_other(snapshot.character_id, snapshot.char_name, Vector3(snapshot.x, snapshot.y, snapshot.z), snapshot.equipped,
		_snapshot_body(snapshot), snapshot.heading, snapshot.scale if snapshot.has_model else CharacterAppearance.DEFAULT_SCALE)
	_log_system("%s entered the zone." % snapshot.char_name)

## Another player's position (OpEntityMoved): their body's new walk target,
## and (round 637) the heading toward it, which the body turns to at the
## client's own rate (RemoteFacing; _step_remote_turns). srrevamp streams
## positions, not retail's destinations (0xB021), so each position is the
## destination the client's mover would aim at from where the body is drawn
## (FUN_009e0550 aims from the object's own position, +0x74). Nothing turns
## the body once the positions stop, so it keeps its last heading.
##
## A relocation (moved.relocated, round 637's review follow-up: a teleport,
## a recovery, a placement) puts the body there and turns nothing, as the
## client places an object at a message's source position (FUN_009e11e0)
## without aiming it; a turn already in progress goes on.
func _on_entity_moved(moved: WorldNet.EntityMoved) -> void:
	if _qa_move_log:
		print("MOVE recv %d ms=%d pos=(%.3f,%.3f)%s%s" % [moved.character_id, Time.get_ticks_msec(), moved.x, moved.z,
			" relocated" if moved.relocated else "", (" heading=%d" % moved.heading_wire) if moved.heading_wire >= 0 else ""])
	if _arrival_pending and _arrival_entries.has(moved.character_id):
		var kept: WorldNet.EntitySnapshot = _arrival_entries[moved.character_id]
		kept.x = moved.x
		kept.y = moved.y
		kept.z = moved.z
		return
	if _other_bodies.has(moved.character_id):
		var to := Vector3(moved.x, moved.y, moved.z)
		_other_body_targets[moved.character_id] = to
		var body: Node3D = _other_bodies[moved.character_id]
		if moved.relocated:
			body.position = to
			return
		# Round 653: a heading run faces its heading (retail's echo of the
		# heading form, FUN_008a5750 -> FUN_009e08a0 -> FUN_009e02f0, turns
		# the mover to it at 3 pi rad/s), not the next position.
		if moved.heading_wire >= 0:
			var hf := RemoteFacing.facing_of(RemoteFacing.from_wire_angle(moved.heading_wire))
			_aim_remote_body(body, Vector3(hf.x, 0.0, hf.y), 0.0)
			return
		_aim_remote_body(body, to - body.position, 0.0)

func _on_entity_left(character_id: int) -> void:
	if _arrival_pending:
		_arrival_entries.erase(character_id)
		_arrival_left[character_id] = true
	if character_id == _selected_character:
		_selected_character = -1
		_clear_target()
	if not _pending_friend_cast.is_empty() and int(_pending_friend_cast["character"]) == character_id:
		print("World3D: player %d left before the walk reached them -- friendly cast dropped" % character_id)
		_drop_pending_attack()
	# A departing body stops running before it fades (OURS, as a monster's
	# does in _free_monster_body: whether retail's mover runs on during the
	# 1.5 s was not read).
	_set_other_gait(character_id, false)
	_other_gaits.erase(character_id)
	SkillEffects.detach_owner(_fx_owner_key(character_id, 0))
	_target_buff_book.drop(_fx_owner_key(character_id, SkillNet.OWNER_CHARACTER))
	_abnormal_states.erase(_fx_owner_key(character_id, SkillNet.OWNER_CHARACTER))
	_fx_owner_buffs.erase(_fx_owner_key(character_id, 0))
	_other_seated.erase(character_id)
	# A monster's blow on this player may cross the notice (round 546,
	# MonsterStrikes.is_own_unpaired); remembered for the grace window.
	var now_ms := Time.get_ticks_msec()
	for id in _recently_left.keys():
		if now_ms - int(_recently_left[id]) > MonsterStrikes.LEFT_GRACE_MS:
			_recently_left.erase(id)
	_recently_left[character_id] = now_ms
	if _other_bodies.has(character_id):
		var body: Node3D = _other_bodies[character_id]
		var departing_name := "Someone"
		for child in body.get_children():
			if child is Label3D:
				departing_name = child.text
				break
		# They fade out over 1.5 s (round 677; READ: CICUser's vslot 0x4c,
		# 0x9daf10, ends in IGIDObject::FUN_009c32f0's CIDecoDisappear -- but
		# for its modes 4/6/7, which this client does not draw), no longer
		# their body: coming back is a fresh body fading in.
		_fade_out_body(body)
		_other_bodies.erase(character_id)
		_other_body_targets.erase(character_id)
		_log_system("%s left the zone." % departing_name)

func _on_disconnect_pressed() -> void:
	NetClient.disconnect_from_server()

## Sends a real OpChangeZone for whatever's typed in zone_input.
## _on_change_zone_result (connected in _ready()) handles the reply --
## success updates zone_label and reloads real terrain/objects for the new
## zone, failure is silently ignored here (no dedicated error UI for this
## yet, same honest scope as the rest of this scene's dev-facing controls).
## The region-local spot a zone change should land on, parsed out of the
## zone box's optional `@x,z` suffix and consumed by
## _on_change_zone_result once the new region has actually loaded. null
## means "wherever the server puts us", the original behavior.
var _pending_zone_local: Variant = null
## A GM /tp or /goto world position (Vector2 x,z) to stand at once a
## cross-zone change finishes loading; null when there is none.
var _pending_gm_pos: Variant = null

## Splits what was typed into the zone box into the zone the server is
## asked for and an optional region-local spot to stand on afterwards:
## `97/168` keeps the server's own landing position, `97/168@1002,917`
## additionally walks the player to that spot in the new region.
##
## The suffix exists because the server has no map data at all (see
## ChangeZoneRequest in server/internal/session/world.go) -- it can only
## put an arriving player at one fixed position per zone, which in a
## region 1920 units across is rarely anywhere near what someone wanted to
## look at. Typing the coordinates the zone label already prints is the
## shortest path from "I want to see that" to standing there.
static func _split_zone_target(text: String) -> Dictionary:
	var at := text.find("@")
	if at < 0:
		return {"zone": text}
	var zone := text.substr(0, at).strip_edges()
	var parts := text.substr(at + 1).split(",")
	if parts.size() != 2:
		return {"zone": zone}
	var lx := parts[0].strip_edges()
	var lz := parts[1].strip_edges()
	if not lx.is_valid_float() or not lz.is_valid_float():
		return {"zone": zone}
	return {"zone": zone, "local": Vector2(float(lx), float(lz))}

## How far above the walkable graph's answer to look for a surface that is
## actually drawn there.
##
## The graph and the rendered world do not always agree: measured in Jangan
## town at local 985,1000, the graph reports terrain at -46.4 while the
## drawn surface is at -32.6, because the octagonal plaza is a placed object
## whose navigation mesh was never resolved into the graph. Standing on the
## graph's answer puts the player 13.8 units inside the plaza, which is what
## a zone change looked like.
##
## Bounded deliberately. An earlier probe cast from 200 units up and came
## back with 119.9 at one spot -- it had hit a gate roof, because
## TERRAIN_COLLISION_LAYER includes the default layer that map objects also
## use. Casting from just above the graph's answer finds the deck underfoot
## without finding the building over it.
const DRAWN_SURFACE_CLEARANCE := 30.0

## The height actually drawn at a region-local (x, z), if something is drawn
## within DRAWN_SURFACE_CLEARANCE of graph_height. Returns graph_height
## unchanged when nothing is, so a region whose graph and geometry agree is
## untouched.
func _drawn_surface_height(group: Node3D, local_x: float, local_z: float, graph_height: float) -> float:
	var space := get_world_3d().direct_space_state
	if space == null:
		return graph_height
	var top := group.to_global(Vector3(local_x, graph_height + DRAWN_SURFACE_CLEARANCE, local_z))
	var bottom := group.to_global(Vector3(local_x, graph_height - DRAWN_SURFACE_CLEARANCE, local_z))
	# Off the heightfield's grid lines (TerrainCollision.vertical_ray, round
	# 572): a zone's spawn is a round local position, often on one.
	var hit := TerrainCollision.vertical_ray(space, top.x, top.z, top.y, bottom.y,
		TERRAIN_COLLISION_LAYER, [player.get_rid()])
	if hit.is_empty():
		return graph_height
	var drawn: float = group.to_local(hit.position).y
	# Only ever lift, never drop: dropping would undo the graph's own answer
	# in the cases it gets right, and the failure being fixed is always
	# "standing inside something".
	return maxf(graph_height, drawn)

## Stands the player at a region-local (x, z) in one loaded region cell,
## at whatever height the real walkable graph reports there -- the same
## real signal ordinary movement stands on, so this lands on a staircase
## or a bridge deck rather than in the terrain under it.
func _place_at_region_local(region_x: int, region_y: int, local_x: float, local_z: float) -> bool:
	var pair := _grid.nav_graph_for_region(region_x, region_y)
	if pair.is_empty():
		return false
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	# Landing, not walking: someone placed into the world arrives from
	# above and comes to rest on the highest surface here.
	player.global_position = group.to_global(
		Vector3(local_x, graph.landing_height_at(local_x, local_z), local_z))
	player.velocity = Vector3.ZERO
	# Round 646: _last_sent_pos stays what the server has (the arrival point
	# a zone change or the world entry set it to), so the send loop reports
	# this placement at once. It used to be set to the placement, and nothing
	# went out until the player walked: the server -- and every other client
	# -- kept the character, and its buffs' auras, at the server's landing
	# (MEASURED live: after /goto jangan, A's client at the spawn spot, local
	# 1002,1020, and B drawing A and its Fire Wall inside the dragon's
	# pedestal at the square's centre).
	_walked_since_send = 0.0
	# The server still has the old position: the next OpMove is a relocation
	# (round 637's review follow-up).
	_relocated_pending = true
	return true

## A gate teleport's receipt (round 576, TeleportNet): on success the server's
## OpChangeZoneResult follows at once, and it is marked here as this
## teleport's arrival (_teleport_arrival_pending), whose position is kept. The
## receipt is a chat line in the archive's own format
## (TeleportNet.receipt_line), the place named through textdata_object; a
## refusal is ErrorText.teleport_line's.
func _on_teleport_result(result: TeleportNet.Result) -> void:
	if result == null:
		return
	if result.ok:
		_teleport_arrival_pending = true
		# The talk box and its list stay until the zone change that follows
		# (_close_gate_ui). The request stays pending until then too (round
		# 603's review): the server sends this receipt, then warpTo does its
		# per-entity work before OpChangeZoneResult, so the two can land in
		# different frames, and a click on a destination line between them
		# would send a second OpTeleportUse -- which the server, measuring the
		# range from where the first put the player (round 642's review),
		# refuses, but the click must not go out. _close_gate_ui clears it on
		# the arrival; a refused zone change clears it (_on_change_zone_result; the server
		# refunds a move that failed).
		var receipt := TeleportNet.receipt_line(_teleport_place_name(result.destination), result.fee, _ui_text_table)
		_log_system(receipt)
		print("World3D: teleport accepted -- to %s, %d gold charged, waiver %d: %s" % [result.destination, result.fee, result.waiver, receipt])
	else:
		# A refusal leaves the list up to choose again.
		_teleport_request_pending = false
		_log_system(ErrorText.teleport_line(result.code, _ui_text_table, result.reason))
		print("World3D: teleport refused -- code 0x%x (%s)" % [result.code, result.reason])

## The next OpChangeZoneResult is a gate teleport's arrival (round 576): set by
## an accepted OpTeleportResult, which the server sends just before it, and
## consumed by _on_change_zone_result.
var _teleport_arrival_pending := false
## A teleport arrival waiting to be stood on its ground, Vector2 world (x, z),
## or null: set by _on_change_zone_result, cleared by _step_teleport_landing
## once the point's region has a walkable graph, or after the zone's drain.
var _teleport_landing: Variant = null

## A destination's name for the receipt: its zone-name token (SN_ZONE_22002)
## through textdata_object, as every SN_ name is (_object_names), or "" --
## never the token itself.
func _teleport_place_name(token: String) -> String:
	var names := _object_names()
	if token == "" or names == null or not names.has(token):
		return ""
	var text := names.get_text(token).strip_edges()
	return "" if text == token else text

## Lands a pending teleport arrival if its region is built, else holds the
## player at the point: no walk, no fall (the region under it may be a
## neighbour cell still queued behind the loading screen -- Samarkand's gate
## stands in 106/108, beside its 106/107 centre).
func _step_teleport_landing() -> void:
	var spot: Vector2 = _teleport_landing
	if _land_teleport_arrival(spot.x, spot.y):
		_teleport_landing = null
		return
	player.position.x = spot.x
	player.position.z = spot.y
	player.velocity = Vector3.ZERO

## Stands the player at a world (x, z) on the walkable graph of the region
## under it, as _place_at_region_local stands a typed `@x,z` -- the height is
## the graph's landing height, not the server's 0. False when no loaded region
## holds the point. Prints the region-local spot, so a run measures where a
## teleport landed rather than inferring it from a picture.
func _land_teleport_arrival(x: float, z: float) -> bool:
	var pair := _nav_graph_for(Vector3(x, player.global_position.y, z))
	if pair.is_empty():
		return false
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	var local := group.to_local(Vector3(x, 0.0, z))
	player.global_position = group.to_global(Vector3(local.x, graph.landing_height_at(local.x, local.z), local.z))
	player.velocity = Vector3.ZERO
	_last_sent_pos = player.position
	_walked_since_send = 0.0
	_refresh_zone_label_position()
	print("World3D: teleport arrival in %s at local (%.1f, %.1f), height %.2f -- the destination gate's point, on the walkable graph" % [
		group.name, local.x, local.z, player.global_position.y])
	return true

## Moves the player to a zone's landing whatever the zone (round 573, for
## /unstuck after a restored entry): its own landing spot where one is known
## (_place_at_zone_spawn, ZONE_SPAWN_LOCAL), else the middle of its centre
## region, local (960, 960) -- where the server lands every entry and zone
## change that restores nothing (server/internal/worldmap.Landing). False when
## the zone's centre region has no walkable graph loaded to land on.
func _place_at_zone_landing(zone: String) -> bool:
	if _place_at_zone_spawn(zone):
		return true
	var coords := _parse_region_coords(_resolve_zone_region(zone))
	if coords.is_empty():
		return false
	return _place_at_region_local(coords["x"], coords["y"], REGION_SPAN / 2.0, REGION_SPAN / 2.0)

## Moves the player to a zone's own landing spot (see ZONE_SPAWN_LOCAL) if
## one is known, once that zone's region has actually loaded. Zones with
## no entry keep the server's fixed spawn position.
func _place_at_zone_spawn(zone: String) -> bool:
	var region := _resolve_zone_region(zone)
	if not ZONE_SPAWN_LOCAL.has(region):
		return false
	var coords := _parse_region_coords(region)
	if coords.is_empty():
		return false
	var spot: Vector2 = ZONE_SPAWN_LOCAL[region]
	if not _place_at_region_local(coords["x"], coords["y"], spot.x, spot.y):
		return false
	_refresh_zone_label_position()
	return true

func _on_change_zone_pressed() -> void:
	var typed := zone_input.text.strip_edges()
	if typed == "":
		return
	var target := _split_zone_target(typed)
	var zone: String = target["zone"]
	if zone == "":
		return
	_pending_zone_local = target.get("local", null)
	# A zone change leaves the old zone's monsters behind: drop the target
	# with them, or the window keeps showing (and skills keep aiming at) a
	# Mangyang two zones away -- the reporter's Alexandria screenshot.
	_last_attack_target = -1
	if _hud_target != null:
		_hud_target.clear()
	_request_zone_change(zone)

## Sends OpChangeZone and remembers it (round 690): every zone change this
## client asks for goes through here, so _on_change_zone_result can tell an
## answer to one from a move the server made on its own
## (arrival_keeps_server_point).
func _request_zone_change(zone: String) -> void:
	_note_zone_change_request(zone)
	NetClient.change_zone(zone)

## The zone labels of the OpChangeZone requests sent and not yet answered,
## oldest first (_request_zone_change).
var _zone_change_requests: Array[String] = []

func _note_zone_change_request(zone: String) -> void:
	_zone_change_requests.append(zone.strip_edges().to_lower())

## Whether a zone change's result answers one of this client's requests, and
## if so consumes that request (round 690's review). The server answers a
## request with the label asked for (handleChangeZone -> warpTo(req.Zone)) at
## that zone's landing; a move to the return point (warpHome) comes with the
## return point's label at a teleport point, and can arrive between a request
## and its answer, or before it. So:
## - a refused change answers the oldest request (the server answers in order;
##   warpHome's only refusal is for a session that has left the world);
## - an accepted one answers the oldest request for its label, unless it
##   lands on a teleport point (`at_point`): no zone's landing is one (the
##   town landings are their centres' middles, local (960, 960) -- MEASURED
##   against the 64 open-world points, none there), so that is the server's
##   own move, and the request stays for its answer.
## Whether a zone change's result answers this client: a gate teleport's
## arrival always does (its receipt marked it, round 576) and takes no zone
## request; any other result is matched (_match_zone_change_request).
func _zone_result_requested(teleport_arrival: bool, zone: String, ok: bool, at_point: bool) -> bool:
	if teleport_arrival:
		return true
	return _match_zone_change_request(zone, ok, at_point)

func _match_zone_change_request(zone: String, ok: bool, at_point: bool) -> bool:
	if not ok:
		if not _zone_change_requests.is_empty():
			_zone_change_requests.pop_front()
		return true
	if at_point:
		return false
	var i := _zone_change_requests.find(zone.strip_edges().to_lower())
	if i < 0:
		return false
	_zone_change_requests.remove_at(i)
	return true

## Whether a zone change's arrival keeps the server's position and stands it
## on the walkable graph (round 690), rather than moving it to the zone's own
## landing spot (_place_at_zone_spawn): a gate teleport's (the receipt came
## first, round 576), and a move to the return point -- one that finds the
## player dead (option 1 of the dead window: the server warps a dead
## character, then revives it, deadstate.go) or one this client never asked
## for (the flag-off respawn after a kill). A zone change this client asked
## for lands where it always has.
static func arrival_keeps_server_point(teleport: bool, requested: bool, dead: bool) -> bool:
	return teleport or dead or not requested

## Chat panel, ported from the 2D World.gd HUD (see docs/PROGRESS.md) --
## this scene is becoming the one real client, so its UI needs to cover
## everything the 2D view used to.
## A chat line from the server (round 634): the chat files and colours it
## by type (HudChat.add_chat); a whisper's sender is who R answers; a notice
## also raises GDR_NOTICE (0x876810's type-7 branch -> 0x777bf0).
func _on_chat_update(u: ChatNet.Update) -> void:
	if u == null:
		return
	print("CHAT: type %d from '%s': %s" % [u.type, u.sender_name, u.message_text])
	if u.type == HudChat.TYPE_WHISPER:
		# R replies to this name (KeyMap slot 20; _key_whisper_reply).
		_last_whisperer = u.sender_name
	if _hud_chat != null:
		_hud_chat.add_chat(u.type, u.sender_name, u.message_text)
	if u.type == HudChat.TYPE_NOTICE:
		_show_banner("gm_notice", u.message_text)
	if chat_log != null:
		chat_log.add_text("%s: %s\n" % [u.sender_name, u.message_text])

## The server's answer to a line this client sent (0xB025's fields): the
## player's own line, or the refusal. A global's answer refreshes the bag,
## whose stack of global chatting items shrank.
func _on_chat_result(r: ChatNet.Result) -> void:
	if r == null:
		return
	print("CHAT RESULT: type %d index %d ok %s code 0x%x" % [r.type, r.index, str(r.ok), r.code])
	if r.type == HudChat.TYPE_GLOBAL:
		if r.ok:
			if NetClient.current_character_name != "":
				NetClient.list_inventory(NetClient.current_character_name)
			if _hud_whole_chat != null and _hud_whole_chat.visible:
				_hud_whole_chat.set_count(maxi(0, _hud_whole_chat.count - 1))
		elif _hud_chat != null:
			_log_system(_hud_chat.refusal_text(r.code, ""))
		return
	if _hud_chat != null:
		_hud_chat.on_result(r.ok, r.type, r.index, r.code, r.target)

## The global chatting item was used from the bag: "Chat to all" opens for
## that slot (CIFWholeChat, round 634).
func _on_global_chat_requested(slot: int, count: int) -> void:
	if _hud_whole_chat == null:
		_hud_whole_chat = HudWholeChat.new()
		_hud_whole_chat.name = "HudWholeChat"
		ui_control.add_child(_hud_whole_chat)
		if not _hud_whole_chat.setup(_ui_builder):
			_log_system("The global chat window is unavailable.")
			return
		_hud_whole_chat.send_requested.connect(func(at: int, text: String) -> void:
			print("CHAT GLOBAL: slot %d: %s" % [at, text])
			NetClient.send_global(at, text))
		_hud_whole_chat.refused.connect(_log_system)
	_hud_whole_chat.open_for(slot, count)

## A system line (round 639): to the system message window, as retail's
## 0x7781b0(type, text) writes its own -- `type` is the window's filter type
## (HudSystemMessage.TYPE_*; 0 always shows). Every line this client writes
## here is either retail's own message for the same event (the pickup, EXP and
## party lines, refusals) or srrevamp's own (the help hints, the dev tools,
## the quickslot and zone lines; docs/protocol/system_message.md lists them).
## Before the window exists (and on a bare World3D) the chat's All list
## takes it, as before.
func _log_system(text: String, type: int = HudSystemMessage.TYPE_ALWAYS) -> void:
	if _hud_syslog != null:
		_hud_syslog.add_message(type, text)
	elif _hud_chat != null:
		_hud_chat.add_message("", "* " + text)
	# Null on a bare World3D (the headless suites drive one with no scene).
	if chat_log != null:
		chat_log.add_text("* %s\n" % text)

# --- Debug console and Help window ----------------------------------------

## Builds the slash console and the in-client Help window, wires the server's
## GM reply, and puts a tooltip on the chat line telling a tester the
## commands exist. Called once from _ready after the chat is set up.
func _setup_console_and_help() -> void:
	_help_window = HelpWindow.new()
	_help_window.name = "HelpWindow"
	ui_control.add_child(_help_window)
	_help_window.setup(_ui_builder, _help_documents(), _is_gm)

	_console = Console.new(_console_host())
	NetClient.gm_command_result.connect(_on_gm_command_result)
	# This scene usually loads after enter_world_result has already fired, so
	# the probe in that handler never ran for it -- fire it now if the world
	# is already entered.
	if NetClient.last_enter_world_result != null and NetClient.last_enter_world_result.ok:
		_fire_gm_probe()
		_hint_help_once()

	# Discoverability: hovering the chat line says the commands exist. Godot
	# tooltips need a control that takes hover, so mark the input and the
	# underbar's menu button. Our own wording (the client has no authored
	# string for this).
	_refresh_command_tooltip()
	if _hud_underbar != null:
		var menu_btn := _hud_underbar.menu_button()
		if menu_btn != null:
			menu_btn.tooltip_text = _command_tooltip()

	# The QA hooks (SRREVAMP_QA_COMMANDS, SRREVAMP_QA_HELP) fire from the
	# frame-tick block in the QA process function, like every other hook.
	print("Console: ready (help window %s, log %s)" % [
		"authored frame" if _help_window != null and _help_window.has_authored_frame() else "plain frame",
		ProjectSettings.globalize_path("user://logs/srrevamp.log")])

## The documents the Help window lists, shipped under res://docs/ by
## client/tools/bundle_docs.sh.
func _help_documents() -> Array:
	return [
		{"title": "Playing", "path": "res://docs/HELP_PLAYING.md"},
		{"title": "Debug tools", "path": "res://docs/DEBUG_TOOLS.md"},
		{"title": "Release notes", "path": "res://docs/RELEASE_NOTES.md"},
	]

## The host of Callables the console reports through. Kept here so the console
## itself has no dependency on World3D and is tested headless with stubs.
func _console_host() -> Dictionary:
	return {
		# Chat AND the log file (print reaches user://logs/srrevamp.log), so a
		# report can quote the console's own output.
		"log": func(t: String) -> void:
			_log_system(t)
			print("CONSOLE: " + t),
		"open_help": func() -> void:
			if _help_window != null:
				_help_window.open(),
		"where": Callable(self, "_where_report"),
		"log_path": func() -> String: return ProjectSettings.globalize_path("user://logs/srrevamp.log"),
		"open_log_dir": Callable(self, "_open_log_dir"),
		"copy_payload": func() -> String: return _debug_panel.diagnostics() if _debug_panel != null else "",
		"set_clipboard": func(s: String) -> void: DisplayServer.clipboard_set(s),
		"fps": func() -> float: return Engine.get_frames_per_second(),
		"entities": Callable(self, "_entities_report"),
		"recent_errors": Callable(self, "_recent_script_errors"),
		"set_wire": Callable(self, "_set_wire_logging"),
		"set_camera_mode": Callable(self, "_console_set_camera"),
		"whisper": func(n: String, m: String) -> void: NetClient.whisper(n, m),
		"unstuck": func() -> void: _unstuck_player(),
		"ground_probe": Callable(self, "_run_ground_probe"),
		"forward_gm": func(line: String) -> void: NetClient.gm_command(NetClient.current_character_name, line, _last_attack_target if _last_attack_target > 0 else 0),
	}

## This World3D's entry number in the process: 1 on a fresh launch, 2 after
## the first reconnect or return from character select (GroundProbe.next_entry
## -- the SRREVAMP_WORLD_ENTRY environment variable, never a static: what
## outlives an instance is what the white ground after a reconnect is
## suspected of). Round 579.
var _world_entry := 0
## Region grids this instance has built: 1 for the entry, one more per zone
## change (_load_region_neighborhood).
var _grid_builds := 0
## Terrain commits per .m path in this world (_terrain_commit).
var _terrain_commits := {}
## The /groundprobe run still stepping through its A/B checks, if any.
var _ground_probe: GroundProbe = null

## /groundprobe [quick] and the F3 panel's Ground probe button (round 579):
## GroundProbe, run on the region under the player. Returns the chat lines;
## the probe's own lines go to the log and user://logs/groundprobe-*.txt.
## "quick" skips the A/B checks. Any player can run it: nothing reaches the
## server.
func _run_ground_probe(mode: String = "full") -> PackedStringArray:
	if _ground_probe != null and is_instance_valid(_ground_probe) and _ground_probe.is_running():
		return PackedStringArray(["A ground probe is still running -- wait for its 'done' line."])
	var probe := GroundProbe.new()
	probe.name = "GroundProbe"
	add_child(probe)
	_ground_probe = probe
	var focus: Vector3 = player.position if player != null else Vector3.ZERO
	return probe.start(self, _world_entry, mode, focus, {
		"connected": NetClient.is_connected_to_server(),
		"zone": _current_zone_name,
	})

## /where: zone, region y/x, local and world coordinates, walkable height.
func _where_report() -> PackedStringArray:
	var out: PackedStringArray = []
	var p := player.global_position
	# The zone the server last put the player in -- a zone change or a
	# teleport's arrival as well as the entry (NetClient.current_zone, set by
	# both results). Until round 642's review this read the entry's result
	# alone, so after a ferry /where still named the zone the session began in.
	var zone: String = NetClient.current_zone
	if zone == "":
		var result = NetClient.last_enter_world_result
		zone = result.zone if result != null else "?"
	out.append("zone: %s" % zone)
	# The region is whichever loaded cell's own space contains the player --
	# each RealTerrain_<x>_<y> node's local space IS that region's real
	# coordinate space (see _grid.nav_graphs), so this is the inverse of
	# _place_at_region_local rather than arithmetic on the world origin,
	# which named the *relative* cell (0/-1) instead of the real one (97/168).
	var found := false
	for pair in _grid.nav_graph_pairs():
		var group := pair[1] as Node3D
		var graph := pair[0] as NavGraph
		if group == null or graph == null:
			continue
		var local := group.to_local(p)
		if local.x < 0.0 or local.x >= REGION_SPAN or local.z < 0.0 or local.z >= REGION_SPAN:
			continue
		# Node name RealTerrain_<region_x>_<region_y>; written x/y, the
		# project's own notation (Jangan town is "97/168", file 97\168.m).
		var parts := String(group.name).split("_")
		if parts.size() >= 3:
			out.append("region: %s/%s (x/y as in %s\\%s.m)" % [parts[1], parts[2], parts[1], parts[2]])
		out.append("local: %.1f, %.1f" % [local.x, local.z])
		out.append("world: %.1f, %.1f, %.1f" % [p.x, p.y, p.z])
		out.append("walkable height here: %.2f (graph), terrain ray %.2f, feet at %.2f" % [
			group.to_global(Vector3(local.x, graph.height_at(local.x, local.z, local.y), local.z)).y,
			_terrain_height_at(p), p.y])
		found = true
		break
	if not found:
		out.append("region: not inside any loaded region cell")
		out.append("world: %.1f, %.1f, %.1f" % [p.x, p.y, p.z])
		out.append("terrain ray height here: %.2f" % _terrain_height_at(p))
	return out

## /entities: counts of what is in view around the player.
func _entities_report() -> String:
	var monsters := _monster_bodies.size()
	var npcs := get_tree().get_nodes_in_group("name_plates").size()
	var players := _other_bodies.size()
	var ground := _ground_items.count() if _ground_items != null else 0
	return "monsters %d, npcs (name plates) %d, other players %d, ground items %d" % [monsters, npcs, players, ground]

## /log on desktop: open the folder holding the log file. Returns whether it
## did (headless/servers cannot, and say so).
func _open_log_dir() -> bool:
	if OS.has_feature("web") or DisplayServer.get_name() == "headless":
		return false
	var dir := ProjectSettings.globalize_path("user://logs")
	OS.shell_open(dir)
	return true

## /errors: the last `count` script-error lines from this session's log file.
func _recent_script_errors(count: int) -> PackedStringArray:
	var out: PackedStringArray = []
	for line in _tail_log_lines(400):
		if line.contains("SCRIPT ERROR") or line.begins_with("ERROR") or line.contains("Parse Error"):
			out.append(line)
	if out.size() > count:
		out = out.slice(out.size() - count)
	return out

## The last `n` lines of the log file (user://logs/srrevamp.log), or empty if
## it cannot be read.
func _tail_log_lines(n: int) -> PackedStringArray:
	var path := "user://logs/srrevamp.log"
	if not FileAccess.file_exists(path):
		return PackedStringArray()
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		return PackedStringArray()
	var all := f.get_as_text().split("\n")
	if all.size() > n:
		return all.slice(all.size() - n)
	return all

func _set_wire_logging(on: bool) -> void:
	_wire_logging = on
	NetClient.wire_logging = on

## /cam free|orbit: map the two console words onto the client's own views
## (set_camera_view). "orbit" is the fixed-pitch, yaw-free Quarter Angle
## view -- the one that reads as orbiting.
func _console_set_camera(mode: String) -> bool:
	match mode:
		"free":
			set_camera_view(CAMERA_VIEW_FREE)
			return true
		"orbit":
			set_camera_view(CAMERA_VIEW_QUARTER)
			return true
	return false

## The chat-line tooltip: the client commands, plus (for a GM) the GM line.
func _command_tooltip() -> String:
	var base := "Slash commands: type /help for the list.\n%s" % (_console.help_line() if _console != null else "/help /where /copy /fps /entities")
	return base

func _refresh_command_tooltip() -> void:
	if _hud_chat != null:
		var input := _hud_chat.find_child("*Input*", true, false)
		if input is Control:
			(input as Control).tooltip_text = _command_tooltip()
		_hud_chat.tooltip_text = _command_tooltip()

## Feeds SRREVAMP_QA_COMMANDS through the console -- the same parser the chat
## uses -- printing a "QA COMMAND:" marker per line so the log pairs each with
## its reply. Called from the QA tick block once the world has settled.
## Raises a centre-screen banner for a line of `kind` on the instance the
## original uses for it (HudNotice.style_for_kind: GDR_NOTICE for the GM
## notice, GDR_WARNING_WND for the rest; round 703).
func _show_banner(kind: String, text: String) -> void:
	var on := _hud_notice if HudNotice.style_for_kind(kind)["name"] == "GDR_NOTICE" else _hud_warning
	if on != null:
		on.show_notice(text)

## SRREVAMP_QA_NOTICES="<tick>:<what>;..." (round 703) raises the banners at
## those QA ticks through the handlers the network drives:
##   notice:<text>                 GDR_NOTICE, as a chat notice does
##   warning:<text>                GDR_WARNING_WND
##   level:<n>                     _on_level_up(n) -- the level-up line
##   unique:spawn|kill:<ref>[:<killer>]  _on_unique_notice, as 0x300C's
##   region:<x>:<y>                the area banner's test for that region
##   bands                         only print the `QA BANDS` line
##   goto:<x>:<y>:<lx>:<lz>        stand at a spot in a loaded region (the
##                                 region change then runs the real path)
## Each prints `QA NOTICE <tick> <what>` and, a frame later, the banners'
## bands on screen (`QA BANDS ...`).
func _qa_notices_step(plan: String) -> void:
	for raw in plan.split(";", false):
		var spec := String(raw).strip_edges()
		var colon := spec.find(":")
		if colon < 0 or not spec.substr(0, colon).is_valid_int():
			continue
		var tick := int(spec.substr(0, colon))
		var what := spec.substr(colon + 1)
		if _qa_tick == tick + 2:
			_qa_bands_report(what)
		if _qa_tick != tick:
			continue
		print("QA NOTICE %d %s frame %d" % [tick, what, Engine.get_frames_drawn()])
		var parts := what.split(":")
		match parts[0]:
			"notice":
				_show_banner("gm_notice", what.substr(7))
			"warning":
				_show_banner("system", what.substr(8))
			"level":
				_on_level_up(int(parts[1]) if parts.size() > 1 else 2, 0)
			"unique":
				var n := UniqueNoticeNet.Notice.new()
				n.kind = UniqueNoticeNet.KIND_KILL if parts.size() > 1 and parts[1] == "kill" else UniqueNoticeNet.KIND_SPAWN
				n.ref_obj_id = int(parts[2]) if parts.size() > 2 else 1954
				n.killer = parts[3] if parts.size() > 3 else ""
				_on_unique_notice(n)
			"bands":
				_qa_bands_report("probe")
			"goto":
				# A placement in a loaded region, so the next stream check
				# runs the real region-change path.
				if parts.size() > 4:
					_place_at_region_local(int(parts[1]), int(parts[2]), float(parts[3]), float(parts[4]))
			"region":
				if _hud_region != null and parts.size() > 2:
					_hud_region.enter_region(TextZoneNameReader.region_id(int(parts[1]), int(parts[2])))

func _qa_bands_report(what: String) -> void:
	var out := PackedStringArray()
	for item in [_hud_notice, _hud_warning]:
		var b := item as HudNotice
		if b != null and b.visible:
			var r: Rect2 = b.band_screen_rect()
			out.append("%s band %d,%d %dx%d text '%s'" % [b.style_name(), int(r.position.x), int(r.position.y),
				int(r.size.x), int(r.size.y), b.text()])
	if _hud_region != null and _hud_region.visible:
		var xf := _hud_region.get_global_transform_with_canvas()
		var lay := _hud_region.layout()
		var w: Rect2 = lay["window"]
		var t: Rect2 = lay["title"]
		out.append("REGION %s window %d,%d %dx%d title %d,%d %dx%d scale %.2f" % [_hud_region.current_code,
			int(w.position.x), int(w.position.y), int(w.size.x), int(w.size.y),
			int(t.position.x), int(t.position.y), int(t.size.x), int(t.size.y), xf.get_scale().x])
	print("QA BANDS after %s frame %d: %s" % [what, Engine.get_frames_drawn(),
		" | ".join(out) if not out.is_empty() else "none"])

func _run_qa_commands(list: String) -> void:
	for raw in list.split(";", false):
		var line := String(raw).strip_edges()
		if line == "":
			continue
		# "wait <seconds>" (round 642): pause the list, so a /tp can follow a
		# /goto's zone load instead of racing it.
		if line.begins_with("wait "):
			print("QA COMMAND: %s" % line)
			await get_tree().create_timer(maxf(float(line.substr(5)), 0.0)).timeout
			continue
		print("QA COMMAND: %s" % line)
		if line.begins_with("/") and _console != null:
			_console.submit(line)
		else:
			NetClient.say(line)

var _help_hinted := false

## Prints the one-line "type /help" hint once on entering the world. The
## original raised a login notice through its web panel; this is the native,
## non-intrusive equivalent (a chat line, our own wording).
func _hint_help_once() -> void:
	if _help_hinted:
		return
	_help_hinted = true
	_log_system("Type /help for controls and commands, or open Help from the Escape menu.")

## Fires the GM probe: an empty command line the server answers with whether
## this account is a GM. Guarded so it is sent once per world entry.
func _fire_gm_probe() -> void:
	if not NetClient.is_connected_to_server():
		print("Console: GM probe skipped -- not connected")
		return
	if NetClient.current_character_name == "":
		print("Console: GM probe skipped -- no character name yet")
		return
	print("Console: GM probe sent for %s" % NetClient.current_character_name)
	NetClient.gm_command(NetClient.current_character_name, "", 0)

## The server's GM reply: sets GM state, prints the text, applies any move,
## refreshes the views a command changed, and announces a level-up.
func _on_gm_command_result(result: GmNet.Result) -> void:
	if result == null:
		return
	if result.is_gm != _is_gm:
		_is_gm = result.is_gm
		if _console != null:
			_console.is_gm = _is_gm
		if _help_window != null:
			_help_window.set_is_gm(_is_gm)
		_refresh_command_tooltip()
	# On enter-world a GM's client fires an empty probe; greet once.
	if _is_gm and not _gm_greeted:
		_gm_greeted = true
		if _console != null:
			_log_system(_console.gm_help_line())
	if result.text != "":
		_log_system(result.text)
		print("GM REPLY: %s" % result.text)
	if result.new_level > 0:
		_on_level_up(result.new_level, result.stat_points)
	if result.has_pos or result.zone != "":
		_apply_gm_move(result)
	if result.refresh & GmNet.REFRESH_STATS:
		_request_world_stats()
	if result.refresh & GmNet.REFRESH_MONSTERS:
		NetClient.list_monsters()
	if result.refresh & GmNet.REFRESH_INVENTORY:
		if NetClient.current_character_name != "":
			NetClient.list_inventory(NetClient.current_character_name)
	if result.refresh & GmNet.REFRESH_EQUIPMENT:
		if NetClient.current_character_name != "":
			NetClient.list_equipment(NetClient.current_character_name)

## Applies a /tp or /goto move: a zone change first if the reply names a
## different zone (the position is applied when that zone loads), else the
## position now. Movement is client-authoritative, so placing the player and
## letting the move sync inform the server is the same path /unstuck uses.
func _apply_gm_move(result: GmNet.Result) -> void:
	# The zone the player is in NOW (round 629's review): comparing with the
	# enter-world zone took a /goto back to the starting town, after a zone
	# change, for "already there" and never moved the player.
	var here := NetClient.current_zone
	if here == "" and NetClient.last_enter_world_result != null:
		here = NetClient.last_enter_world_result.zone
	if result.zone != "" and result.zone != here:
		if result.has_pos:
			_pending_gm_pos = Vector2(result.x, result.z)
		_request_zone_change(result.zone)
		return
	if result.has_pos:
		_place_player_at_world(result.x, result.z)
		_qa_arm_arrival_probe("gm move to %.0f, %.0f" % [result.x, result.z])

## Stands the player at a world X/Z, resolving the height off the terrain --
## the same safety net _unstuck uses. Clears velocity and lets the move sync
## tell the server.
func _place_player_at_world(x: float, z: float) -> void:
	var spot := Vector3(x, player.global_position.y, z)
	spot.y = _terrain_height_at(spot)
	player.global_position = spot
	player.velocity = Vector3.ZERO
	_last_sent_pos = player.position
	_walked_since_send = 0.0
	_relocated_pending = false
	NetClient.move_to(player.position.x, player.position.y, player.position.z, true)

## The developer chrome that has no authored equivalent yet: the zone travel
## box, Log Out, and the Hide UI button. Shown with Shift+F1 (KeyMap, run by
## KeyInput; F1..F4 are the quickslot pages).
const DEV_UI_NODES := ["ZoneInput", "ChangeZoneButton", "DisconnectButton"]
var _dev_ui_visible := true
## The Shift+F3 panel: build, server, position, entities, loading failures,
## frame times, and the sliders for UI scale, chat font and name range.
var _debug_panel: DebugPanel = null

