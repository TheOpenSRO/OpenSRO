## Builds dungeon `rid` (DungeonWorld.build): its rooms and objects under one
## group, its walkable graph, the indoor light, its NPCs. False when the
## archive names no dungeon for it (the placeholder ground stays).
func _load_dungeon(rid: int) -> bool:
	var sw := Time.get_ticks_msec()
	var data := _open_pk2_if_set()
	if _object_templates == null:
		_object_templates = ObjectTemplateCache.new(_load_object_template)
	var paints_before := _loading_screen.paints if _loading_screen != null else 0
	var built := DungeonWorld.build(data, rid, func(path: String) -> Node3D: return _object_templates.instance(path, "dungeon"),
		true, func(f: float) -> void: _loading_paint(f * DUNGEON_BUILD_SHARE))
	if built == null:
		print("World3D: dungeon 0x%x -- Dungeon\\dungeoninfo.txt names no .dof for it, or it does not parse; nothing built" % rid)
		return false
	ground_mesh.visible = false
	ground_collision.disabled = true
	var rx := (rid >> 8) & 0xFF
	var ry := rid & 0xFF
	built.group.name = "RealTerrain_%d_%d" % [rx, ry]
	add_child(built.group)
	# Rooms and their objects cast no shadow, as the field's placed objects
	# (_load_object_template); the templates already carry it.
	_grid.add_nav_graph(rx, ry, built.graph, built.group)
	_dungeon = built
	_dungeon_block = -1
	_apply_dungeon_environment()
	_attach_dungeon_effects()
	_update_zone_label_for_region(rx, ry)
	print("World3D: dungeon 0x%x %s built in %d ms -- %d rooms (%d without a navigation mesh), %d objects, %d missing, %d floors" % [
		rid, built.path, Time.get_ticks_msec() - sw, built.rooms, built.rooms_without_nav, built.objects,
		built.missing.size(), built.dof.floor_names.size()])
	if not built.missing.is_empty():
		var kinds := {}
		for m in built.missing:
			kinds[m.get_file().to_lower()] = int(kinds.get(m.get_file().to_lower(), 0)) + 1
		print("World3D: dungeon 0x%x -- models that built nothing: %s" % [rid, str(kinds)])
	_try_spawn_region_npcs(rx, ry)
	# The build's end: a forced repaint at 100 % (the client's
	# FUN_00ba3fc0(1000, 1)), so the gauge the drain's frames keep is the one
	# already on screen.
	if _loading_screen != null:
		_loading_paint(1.0, true)
		print("LoadingScreen: %d repaint(s) through the dungeon's build, the last at 100 %%, at frame %d" % [
			_loading_screen.paints - paints_before, Engine.get_frames_drawn()])
	return true

## How much of the loading screen's gauge a dungeon's rooms and objects fill
## (round 785; OURS): the effects' attach (_attach_dungeon_effects) is the
## rest, and the build's end paints 100 %. The user's lv.1 of the tomb took
## 131 ms for the one and 146 ms for the other (their log: `built in 146 ms`,
## `built in 277 ms` in all). The attach repaints nothing: a repaint during it
## made the tomb's lv.2 attach (4,216 effects) ~1 s slower on the box however
## few there were -- 2.4-2.8 s against 1.4-1.6 s with repaints every 50 ms,
## every 250 ms, or with no present (MEASURED, round 785) -- while the rooms'
## and objects' repaints cost nothing measurable.
const DUNGEON_BUILD_SHARE := 0.5

## The loading screen's gauge at `fraction` from inside a load that holds the
## main thread (round 785): LoadingScreen.paint, which repaints at most every
## 50 ms unless forced (the client's FUN_00ba3fc0, READ). Nothing without a
## screen (a QA render's synchronous load).
func _loading_paint(fraction: float, force: bool = false) -> void:
	if _loading_screen != null:
		_loading_screen.paint(fraction, force)

## The dungeon's own effects (round 774): every room and object of a `.dof`
## plays its `.bsr`'s `ambient` particle set (AmbientParticles, READ: the set
## a placed object plays with no clip running). They are the dungeon's
## portals (`system\\system_dungeonpotal.efp` on the rooms the walk-ins stand
## in), its flames, lanterns and crystal glows: every `.dof` object of the
## served dungeons is such a host (MEASURED: the cave's 1,037 are flames,
## lamps, cobwebs and its sunbeams; the tomb's floors' are burners, flames,
## lanterns and bowls), and a mesh-less one (the cave's `lamp.bsr`) is
## kept for them (ObjectLoader).
##
## OURS: the original draws the current block and the blocks its list names
## (Map::FUN_00a255c0); the tomb's B2 lists none for any block (MEASURED) and
## carries 2,064 hosts, so here the DUNGEON_FX_ACTIVE effects nearest the
## camera run and draw and the rest wait, re-chosen every
## DUNGEON_FX_REFRESH_MS.
const DUNGEON_FX_ACTIVE := 400
const DUNGEON_FX_REFRESH_MS := 250
var _dungeon_fx: Array = []
## Each effect's place, as attached (rooms and objects do not move).
var _dungeon_fx_at := PackedVector3Array()
var _dungeon_fx_next_ms := 0

func _attach_dungeon_effects() -> void:
	_dungeon_fx.clear()
	_dungeon_fx_on.clear()
	_dungeon_fx_at = PackedVector3Array()
	if _dungeon == null or OS.get_environment("OPENSRO_QA_AMBIENT") == "off":
		return
	var particles := _open_particles_pk2_if_set()
	if particles == null:
		return
	_ambient.set_light_effect(video_options().value(VideoOptions.LIGHT) == 1)
	var sw := Time.get_ticks_msec()
	var hosts := 0
	var native := 0
	for child in _dungeon.group.get_children():
		var host := child as Node3D
		if host == null or not host.has_meta(AmbientParticles.META_ENTRIES):
			continue
		hosts += 1
		for fx_v in _ambient.attach(host, host.get_meta(AmbientParticles.META_ENTRIES), particles):
			var fx := fx_v as EfpEffect
			# Stepped by _step_dungeon_effects, not by its own _process; in
			# Rust when the library is there (EfpSimNative, round 763).
			fx.process_mode = Node.PROCESS_MODE_DISABLED
			fx.static_host = true
			if fx.use_native_sim():
				native += 1
			_dungeon_fx.append(fx)
			_dungeon_fx_at.append(fx.placed_at())
	_dungeon_fx_next_ms = 0
	_cull_dungeon_effects()
	print("World3D: dungeon 0x%x -- %d ambient effect(s) on %d room(s) and object(s) (%d simulated natively), built in %d ms" % [
		_dungeon.rid, _dungeon_fx.size(), hosts, native, Time.get_ticks_msec() - sw])

## The DUNGEON_FX_ACTIVE effects nearest the camera run; the rest are hidden
## and paused (OURS, see _attach_dungeon_effects).
func _cull_dungeon_effects() -> void:
	if _dungeon_fx.is_empty():
		return
	var eye := camera_3d.global_position if camera_3d != null else player.global_position
	var d2 := PackedFloat32Array()
	d2.resize(_dungeon_fx.size())
	for i in _dungeon_fx.size():
		d2[i] = _dungeon_fx_at[i].distance_squared_to(eye)
	var limit := INF
	if _dungeon_fx.size() > DUNGEON_FX_ACTIVE:
		var sorted := d2.duplicate()
		sorted.sort()
		limit = sorted[DUNGEON_FX_ACTIVE - 1]
	_dungeon_fx_on.clear()
	for i in _dungeon_fx.size():
		var fx := _dungeon_fx[i] as EfpEffect
		if not is_instance_valid(fx):
			continue
		var on := d2[i] <= limit
		fx.culled = not on
		# A glow shows by its own fade (EfpEffect.set_glow_alpha): kept
		# hidden while culled, and left to the glow pass once back.
		fx.set_shown(on and (not fx._glow_on or fx._glow_alpha > 0))
		if on:
			_dungeon_fx_on.append(fx)

## The effects _cull_dungeon_effects keeps, stepped together once a frame
## (round 774): the placement and the draws on this thread, the simulations
## as one batch (EfpSimBatch: natively when the library is there, else on
## WorkerThreadPool), as EquipFx steps its masters. MEASURED, the tomb's B2
## at the same view (QA run, p95 work frame): 2 ms with no ambient effect,
## 12 ms with 400 effects each in its own _process.
var _dungeon_fx_on: Array = []

func _step_dungeon_effects(delta: float) -> void:
	var t0 := Time.get_ticks_usec()
	var list: Array = []
	for fx_v in _dungeon_fx_on:
		var fx := fx_v as EfpEffect
		if is_instance_valid(fx) and fx.sim != null and fx.step_pre(delta):
			list.append(fx)
	var t1 := Time.get_ticks_usec()
	EfpSimBatch.run(list, delta)
	var t2 := Time.get_ticks_usec()
	for fx_v in list:
		if is_instance_valid(fx_v):
			(fx_v as EfpEffect).step_post()
	var t3 := Time.get_ticks_usec()
	if not _qa_dungeon_fx:
		return
	_dungeon_fx_usec += Vector3(t1 - t0, t2 - t1, t3 - t2)
	_dungeon_fx_frames += 1
	if _dungeon_fx_frames >= 300:
		print("World3D: dungeon effects -- %d stepped, per frame: place %.2f ms, simulate %.2f ms, draw %.2f ms, glow pass %.2f ms (300-frame mean)" % [
			list.size(), _dungeon_fx_usec.x / 300000.0, _dungeon_fx_usec.y / 300000.0, _dungeon_fx_usec.z / 300000.0,
			_dungeon_glow_usec / 300000.0])
		_dungeon_glow_usec = 0
		_dungeon_fx_frames = 0
		_dungeon_fx_usec = Vector3.ZERO

var _dungeon_logged_block := -1
## OPENSRO_QA_DUNGEON_FX=1 (round 774): the dungeon effects' cost, every 300
## frames -- placement, simulation, draws and the glow pass.
var _qa_dungeon_fx := OS.get_environment("OPENSRO_QA_DUNGEON_FX") != ""
var _dungeon_glow_usec := 0
var _dungeon_fx_usec := Vector3.ZERO
var _dungeon_fx_frames := 0

## OPENSRO_QA_PIXEL_RAYS="x,y;x,y" (round 774): at tick 300, what the ray
## from the camera through each viewport pixel meets first -- the mesh, its
## object, the distance and the material's shader -- for "what is that".
func _qa_pixel_rays(spec: String) -> void:
	var space := get_world_3d().direct_space_state
	for part in spec.split(";", false):
		var xy := part.split(",")
		if xy.size() != 2:
			continue
		var px := Vector2(float(xy[0]), float(xy[1]))
		var from := camera_3d.project_ray_origin(px)
		var to := from + camera_3d.project_ray_normal(px) * 50000.0
		var hit := space.intersect_ray(PhysicsRayQueryParameters3D.create(from, to))
		if hit.is_empty():
			print("QA PIXEL %s: nothing within 50000" % str(px))
			continue
		var n: Node = hit["collider"]
		var mi: MeshInstance3D = null
		while n != null and mi == null:
			mi = n as MeshInstance3D
			n = n.get_parent()
		var path := ""
		var m: Node = mi
		while m != null and m != self and path.length() < 200:
			path = String(m.name) + ("/" + path if path != "" else "")
			m = m.get_parent()
		var shader := ""
		if mi != null and mi.material_override is ShaderMaterial:
			var sm := mi.material_override as ShaderMaterial
			shader = sm.shader.code.get_slice("\n", 1) if sm.shader != null else "?"
		print("QA PIXEL %s: %.0f away, %s, shader %s" % [str(px), from.distance_to(hit["position"]), path, shader])

## Stands the player at dungeon-space (x, z) on the rooms' graph: the floor
## nearest `reference_y`, or the highest without one. False outside a
## dungeon.
func _place_in_dungeon(x: float, z: float, reference_y: float = NAN) -> bool:
	if _dungeon == null:
		return false
	var h := _dungeon.graph.landing_height_at(x, z, reference_y)
	player.global_position = DungeonWorld.to_world(Vector3(x, h, z))
	player.velocity = Vector3.ZERO
	_relocated_pending = true
	print("World3D: placed in dungeon 0x%x at (%.1f, %.1f, %.1f), room %d" % [
		_dungeon.rid, x, h, z, DungeonWorld.block_under(_dungeon, Vector3(x, h, z))])
	return true

## Out of the dungeon (a zone change; _clear_region_grid): the sky and the
## field's light come back.
func _leave_dungeon() -> void:
	if _dungeon == null:
		return
	_dungeon = null
	_dungeon_block = -1
	_dungeon_area_text = ""
	_dungeon_fx.clear()
	_dungeon_fx_on.clear()
	_dungeon_fx_at = PackedVector3Array()
	if _sky_dome != null:
		_sky_dome.visible = true
	# The sun, the moon and the flare come back (round 786, _day_bodies).
	if _env_record != null:
		_day_bodies(_env_time, _day_cycle.state)
	var env: Environment = world_environment.environment if world_environment != null else null
	if env != null and _dungeon_saved.has("bg"):
		env.background_mode = int(_dungeon_saved["bg"])
		env.background_color = _dungeon_saved["bg_color"]
	if _dungeon_saved.has("sun"):
		directional_light.visible = bool(_dungeon_saved["sun"])
	if _dungeon_saved.has("channels"):
		_object_light_channels = _dungeon_saved["channels"]
		_apply_object_light()
	_dungeon_saved.clear()
	if _hud_minimap != null and is_instance_valid(_hud_minimap):
		_hud_minimap.set_dungeon_prefix("")
	_apply_fog()

## The indoor look (READ, the dungeon draw Map::FUN_00a255c0: no sky and no
## terrain in that path; the current block's light and fog). The light is
## the block's first colour (+0x6c, CRTDunBlock::vslot_006) as an ambient
## (_apply_dungeon_block). The fog is the block's +0x70 record (vslot_005):
## its colour, start, end and density go to D3DRS_FOGCOLOR / FOGSTART /
## FOGEND / FOGDENSITY and the object shader's fog constants
## (CObjRendererVS::FUN_00c31450), and the landscape step picks vertex fog
## LINEAR when the world's region has bit 15 (WorldFog's header, 0xa276fc):
## so linear from start to end in the fog colour, as WorldFog draws it.
## Not drawn: the block's point lights (OPEN which reach an object) and the
## rooms' light maps (Prim\LightMap\Dun, whose loader is OPEN).
func _apply_dungeon_environment() -> void:
	var env: Environment = world_environment.environment if world_environment != null else null
	if _dungeon_saved.is_empty():
		if env != null:
			_dungeon_saved["bg"] = env.background_mode
			_dungeon_saved["bg_color"] = env.background_color
		_dungeon_saved["sun"] = directional_light.visible
		_dungeon_saved["channels"] = _object_light_channels.duplicate()
	if _sky_dome != null:
		_sky_dome.visible = false
	# No sun, moon or flare indoors (READ: FUN_009fb1f0's 0x8000 test).
	_hide_sky_bodies()
	if env != null:
		env.background_mode = Environment.BG_COLOR
		env.background_color = Color.BLACK
	# No sun indoors: the block's light only.
	directional_light.visible = false
	_apply_dungeon_block(0)

## The light and fog of block `b` (the player's, _dungeon_tick).
func _apply_dungeon_block(b: int) -> void:
	if _dungeon == null or b < 0 or b >= _dungeon.dof.blocks.size():
		return
	_dungeon_block = b
	var blk: DofReader.Block = _dungeon.dof.blocks[b]
	# READ (Map::FUN_00a255c0): a directional light (type 3) whose diffuse
	# and specular are 0 and whose ambient is the block's colour /255
	# (CRTDunBlock::vslot_006, block +0x6c: the first of the two words). So
	# the object light here is that ambient alone.
	var light := DungeonWorld.block_colour(blk.color_a)
	_object_light_channels = [Color.BLACK, light]
	_apply_object_light()
	# The fog (round 774, READ -- docs/protocol/dungeon.md "Fog"): a
	# dungeon's landscape step sets no table fog and the object shader's EXP
	# variant (Map::FUN_00a26f60 0xa27722), so the record's start and end
	# are never used: the share kept is 2^-((depth x density)^2), and with
	# the block's A record the height term too (WorldFog.SHADER_FN). The
	# frame is cleared to the fog colour (CGFXVideo3d::vslot_028 / vslot_025
	# from Map::FUN_00a255c0), not black: the pass draws it where nothing
	# was drawn (WorldFog.PASS_SHADER).
	# OURS: the original sets each room's and object's own block's record
	# before it and evaluates per vertex; the pass here fogs every pixel with
	# the current block's.
	var on := video_options().value(VideoOptions.FOG) == 1 and OS.get_environment("OPENSRO_QA_NOFOG") == ""
	var env: Environment = world_environment.environment if world_environment != null else null
	var fog_colour := WorldFog.pass_color(DungeonWorld.block_colour(blk.color_b), env)
	var height := blk.height_fog
	if _dungeon.group != null and _dungeon.group.is_inside_tree():
		height.x += _dungeon.group.global_position.y
	WorldFog.set_dungeon_globals(blk.fog.z, height, on, fog_colour)
	if _fog_pass != null:
		_fog_pass.visible = on
	if b != _dungeon_logged_block:
		_dungeon_logged_block = b
		print("World3D: dungeon block %d -- fog density %.5f, height fog %s, colour %s" % [
			b, blk.fog.z, str(blk.height_fog), str(DungeonWorld.block_colour(blk.color_b))])

## Each frame in a dungeon: the block under the player sets the light and
## the fog, and the minimap's floor.
func _dungeon_tick() -> void:
	if _dungeon == null or player == null:
		return
	var p := DungeonWorld.to_dungeon(player.global_position)
	var b := DungeonWorld.block_under(_dungeon, p)
	if b >= 0 and b != _dungeon_block:
		_apply_dungeon_block(b)
	if Time.get_ticks_msec() >= _dungeon_fx_next_ms:
		_dungeon_fx_next_ms = Time.get_ticks_msec() + DUNGEON_FX_REFRESH_MS
		_cull_dungeon_effects()

## The minimap in a dungeon (READ, UI_SILKMALL::FUN_00661ce0): the tile
## column is floor(x / 1920) + 0x80 and the row floor(z / 1920) + 0x80 of the
## dungeon-space position, the position in the tile what is left, the file
## `minimap_d\<folder>\<floor>_<column>x<row>.ddj`, and no X/Y readout. The
## floor is the player's block's floor name lower-cased (INFERRED: the
## names match the files'); the folder is DUNGEON_MINIMAP_FOLDER's (OURS).
func _refresh_dungeon_minimap() -> void:
	var p := DungeonWorld.to_dungeon(player.global_position)
	var col := int(floorf(p.x / REGION_SPAN)) + 0x80
	var row := int(floorf(p.z / REGION_SPAN)) + 0x80
	var local := Vector3(p.x - float(col - 0x80) * REGION_SPAN, p.y, p.z - float(row - 0x80) * REGION_SPAN)
	var floor_name := _dungeon.dof.floor_name(_dungeon_block).to_lower()
	var folder := String(DUNGEON_MINIMAP_FOLDER.get(_dungeon.rid, ""))
	_hud_minimap.set_dungeon_prefix("minimap_d\\%s\\%s_" % [folder, floor_name] if folder != "" and floor_name != "" else "minimap_d\\none_")
	var facing := minimap_facing(player.global_transform.basis, _dungeon.group.global_transform.basis)
	# The tile's column is the minimap's region y, its row the region x (the
	# field's files are minimap\<y>x<x>.ddj the same way round).
	_hud_minimap.update_player(row, col, local, facing)
	# Round 774 (READ, 0x661ce0's dungeon branch): the area name is the text
	# of the player's block's room name (ICPlayer::FUN_009d7830: the block's
	# room index into the .dof's room list), set only when the block has one
	# -- a block without keeps the last text; the floor badge (child 10)
	# takes the text of its floor name (FUN_009d7880), set when it changes.
	# Both through the text table the zone names are in (MEASURED: the .dof's
	# names are textzonename keys, `QT_A01_F01_ROOM_..` "Audience Chamber",
	# `QT_A01_FLOOR01` "B1").
	var names := _load_text_zone_names()
	var room_text := TextZoneNameReader.text_for(names, HudWorldmap.dof_room_key(_dungeon.dof, _dungeon_block))
	if room_text != "":
		_dungeon_area_text = room_text
	_hud_minimap.set_area_name(_dungeon_area_text if _dungeon_area_text != "" else _current_zone_name)
	_hud_minimap.set_dungeon_floor_text(TextZoneNameReader.text_for(names, _dungeon.dof.floor_name(_dungeon_block)))
	var pos := player.global_position
	var reach := HudMinimap.SIGN_RADIUS / maxf(_hud_minimap.tile_px(), 0.001) * HudMinimap.REGION_SPAN * 1.01
	_minimap_fill_monsters(pos, reach)
	_minimap_others_sync()
	_hud_minimap.update_signs(pos, _minimap_npcs_cache, _minimap_monsters, _minimap_others, _minimap_uniques)
	# Round 786: the party's marks, as in the field (vslot_013 has one party
	# loop for both): the members on the player's floor of this dungeon, in
	# the dungeon's own space, the frame of the player's +0x80 here. This
	# path never placed them before, so the last field frame's marks stayed
	# frozen over the dungeon's minimap.
	_fill_party_marks(_minimap_region)
	_hud_minimap.update_party(Vector2(p.x, p.z), _party_marks_mini)
	# Round 775 (UI lane): the world map in a dungeon -- the floor the player
	# is on, the arrow at its dungeon-space position, the room in the caption
	# (HudWorldmap.update_player_dungeon). Every frame while open, every
	# tenth while hidden, as the field's update_player in _refresh_minimap.
	if _hud_worldmap != null and is_instance_valid(_hud_worldmap) \
			and (_hud_worldmap.is_visible_in_tree() or _zone_label_tick % 10 == 0):
		_hud_worldmap.update_player_dungeon(_dungeon.rid, p, facing, _dungeon.dof.floor_name(_dungeon_block),
			HudWorldmap.dof_room_key(_dungeon.dof, _dungeon_block))
		# Round 786: and the party's dots (FUN_0061eec0 draws them on a floor
		# and on a field map alike; HudWorldmap.party_pixel).
		_hud_worldmap.update_party(_party_marks_regions, _party_marks_pos, _party_marks_names, NetClient.party.job_party)

## Removes every previously-loaded region grid node (see
## _load_region_neighborhood) so a zone change or a fresh load doesn't leave
## stale terrain/objects from a different region behind.
##
## Takes the nodes out of the tree *immediately* rather than only calling
## queue_free(), which defers the removal to the end of the frame. That
## deferral was a real bug, found in a real playtest (2026-09-07): changing
## zone from 98/168 to 97/168 rebuilds a grid that overlaps the old one --
## a REGION_LOAD_RADIUS window around 98/168 already contains 97/168 --
## so the new `RealTerrain_97_168` was added while the old node of that
## exact name was still in the tree. Godot resolves the collision by
## renaming the newcomer, which broke everything that finds a region by
## node name. The visible symptom was a city with no buildings in it:
## _try_load_real_map_objects parents a region's objects to its terrain
## node found by name, so every object in the arrived-at region was
## parented to the *outgoing* node and was deleted along with it at the
## end of that same frame. The zone label read `[@Node3D@4862]` instead of
## `[97_168]` for the same reason, and both _load_region_neighborhood's
## grid-origin lookup and _maybe_stream_regions' per-cell lookup resolved
## to the stale node too.
##
## The nav graphs (_grid.nav_graphs) are cleared here too -- they hold a
## reference to every terrain group, so leaving them populated kept the old
## regions' walkable graphs answering position queries for regions that no
## longer exist.
func _clear_region_grid() -> void:
	# A cell still preparing belongs to the grid being torn down (round 565).
	_drop_cell_jobs("the region grid was cleared")
	# NPCs are parented to their region's terrain group, so tearing the grid
	# down takes them with it. Without clearing their marks, every region
	# still counts as "already populated" and a zone change leaves a world
	# with nobody in it -- which is exactly what a zone-changed render showed.
	# The nav graphs, the loaded and queued cells and the per-region caches
	# go with them (RegionGridState.clear_all, round 563).
	_grid.clear_all()
	# A zone change keeps the scenery templates (round 559): the same models
	# recur across towns, and ObjectTemplateCache's cap bounds them. Their
	# region uses are withdrawn, so they are the first the cap evicts.
	if _object_templates != null:
		_object_templates.forget_regions()
	# The placed objects go with their containers (round 643), and the
	# animation driver forgets them (round 647): a zone change moves the
	# world's origin, so a sector keyed by world position would otherwise
	# take the new zone's objects in with the old zone's stale ones.
	_placed_objects.clear()
	_object_containers.clear()
	# The town gates' bindings go with them (round 650, _bind_region_gates).
	_gate_bindings.clear()
	_map_animations.reset()
	_world_fx.reset()
	_leave_dungeon()
	for child in get_children():
		if child.name.begins_with("RealTerrain") or child.name.begins_with("RealMapObjects"):
			remove_child(child)
			child.queue_free()

## Loads a real (2*radius+1)x(2*radius+1) grid of regions centered on
## (center_x, center_y), one real Map.pk2 .m/.o pair per cell, tiled using
## REGION_SPAN as the grid spacing -- REGION_SPAN's own doc comment notes
## real per-region *adjacency* (whether the real world lays regions out on
## a uniform grid at all) isn't independently confirmed, but a real,
## live-verified consistency check now backs it up: since MapmReader's
## deterministic full-region parsing (2026-08-23), a region's own real
## mesh footprint (97 vertices x TILE_SIZE = exactly 1920 world units) now
## matches REGION_SPAN's real 1920.0 value *exactly* -- and a real 3x3
## grid of these regions, live-rendered from a top-down debug view,
## tiles together with zero visible gaps or overlaps between neighbors.
## That's a real, positive signal for uniform-grid adjacency (an
## unrelated real per-tile size and a real per-region spacing constant,
## both independently decompiled from different functions, wouldn't
## coincidentally match this exactly if regions weren't meant to tile
## this way) -- still not a hard confirmation of the real game's true
## spatial layout, but no longer just "this project's own design" either.
## Missing neighbor files (very likely near a real world's edge, or simply
## because this project only has a handful of real regions to test with) are
## skipped the same honest way a single missing region already was --
## _try_load_real_terrain/_try_load_real_map_objects print and move on
## rather than treating it as fatal. Only the center cell (the grid's (0,0) while
## the frame is the centre, see `frame` below) snaps the
## player onto its terrain (see _snap_player_onto_terrain) -- that's real
## spawn-adjacent ground, not any of the speculative neighbors.
##
## Loads the center cell first and reuses its own real near_height as every
## other cell's shared_vertical_anchor (see _try_load_real_terrain's doc
## comment on why -- without this, every tile independently resets its own
## near edge to Y=0, guaranteeing a cliff at *every* seam and trapping the
## camera in overlapping geometry, confirmed live 2026-08-22). If the center
## cell itself fails to load (missing file, bad data), neighbors fall back
## to each calibrating themselves independently (NAN anchor) -- the original
## behavior -- since there's no real center reference to share in that case.
##
## `frame` (round 570) is the coordinate frame the grid is built in, {"x",
## "y"} as _parse_region_coords gives it: the region whose middle is the world
## origin, which the server names on the wire (FrameRegion; _frame_coords).
## Empty -- a QA run, or an older server -- is the centre itself, which is
## what the frame always was before it was named and still is for every zone.
## Every cell key, _last_stream_cell and _grid_origin_region are relative to
## the FRAME, so a frame other than the centre puts the centre at cell
## (centre - frame) rather than (0, 0); the grid is still built around the
## centre. With frame == centre every value below is exactly what it was,
## except _grid_origin_world when the centre's terrain fails to load (round
## 571, _frame_corner).
func _load_region_neighborhood(center_x: int, center_y: int, radius: int = REGION_LOAD_RADIUS, texture_override: String = "", frame: Dictionary = {}) -> void:
	# No job of an earlier grid may commit into this one (round 565);
	# _reload_zone_assets has already dropped them, and the first entry has
	# none.
	_drop_cell_jobs("a new region grid")
	_grid_builds += 1
	var frame_x: int = frame.get("x", center_x)
	var frame_y: int = frame.get("y", center_y)
	# The centre's cell in the frame: (0, 0) whenever the frame is the centre.
	var cdx := center_x - frame_x
	var cdy := center_y - frame_y
	var centre_offset := _cell_offset(cdx, cdy)
	# The vertical anchor. Frame == centre: NAN, and the centre calibrates
	# itself on its own near-row vertex, as it always has. Otherwise the
	# FRAME region's near-row height, so every grid built in one frame shares
	# one height origin (_frame_anchor_height); NAN again when that cannot
	# be read.
	var anchor := NAN
	if cdx != 0 or cdy != 0:
		anchor = _frame_anchor_height(frame_x, frame_y)
	# Timed like every other cell (round 561): the centre is the one cell a
	# player waits for with nothing on screen yet. It is built whole on the
	# main thread -- prepare and commit -- whatever OPENSRO_SYNC_LOAD says:
	# its near_height anchors every neighbour, its environment lights them,
	# and the caller places the player on it next (round 565 keeps it so).
	_load_timings.begin_cell(center_x, center_y)
	var t0 := Time.get_ticks_usec()
	var center_near_height := _try_load_real_terrain("%d\\%d.m" % [center_x, center_y], texture_override, centre_offset, "_%d_%d" % [center_x, center_y], true, anchor)
	var t1 := Time.get_ticks_usec()
	_try_load_real_map_objects("%d\\%d.o" % [center_x, center_y], centre_offset, "_%d_%d" % [center_x, center_y])
	var t2 := Time.get_ticks_usec()
	# The centre cell is loaded here rather than through _load_region_cell,
	# so it needs its own NPC pass -- without this the one region the player
	# is actually standing in is the only one with nobody in it.
	_try_spawn_region_npcs(center_x, center_y)
	_note_cell_built(t0, t1, t2, Time.get_ticks_usec())

	_update_zone_label_for_region(center_x, center_y)
	_grid_origin_region = Vector2i(frame_x, frame_y)
	_grid_centre_region = Vector2i(center_x, center_y)
	_grid_shared_anchor_height = center_near_height if is_nan(anchor) else anchor
	_grid_has_origin = true
	_grid.loaded_cells.clear()
	_grid.mark_loaded(cdx, cdy, center_x, center_y)
	_monster_cells_dirty = true
	# The centre cell is (cdx, cdy) -- (0, 0) while the frame is the centre;
	# the neighbours stream in from here. Set the stream cell to it (not the
	# sentinel) so the queue's stale-guard keeps the neighbours we are about
	# to enqueue, and so a later _maybe_stream_regions does not redundantly
	# re-scan the same centre.
	_last_stream_cell = Vector2i(cdx, cdy)
	# The frame region's corner, from the anchor every cell of this grid is
	# placed on (_frame_corner), whether or not the centre's terrain loaded.
	_grid_origin_world = _frame_corner(_grid_shared_anchor_height)

	# The neighbours are queued nearest-first and built a few per frame (see
	# _process_stream_queue and, at world entry, the loading screen's pump),
	# instead of all at once here -- that synchronous grid was most of the
	# minute-long, no-feedback entry. Since round 565 their terrain prepares
	# on WorkerThreadPool tasks, since round 566 their objects in the same
	# task, and only the commit takes a frame (_pump_cell_jobs).
	_load_queue.clear()
	_grid.queued_cells.clear()
	var neighbours: Array = []
	for dy in range(-radius, radius + 1):
		for dx in range(-radius, radius + 1):
			if dx == 0 and dy == 0:
				continue # center cell already loaded above
			# dx/dy here are from the centre; the cell's own are from the
			# frame (see _load_region_cell).
			neighbours.append({
				"rx": center_x + dx, "ry": center_y + dy, "dx": cdx + dx, "dy": cdy + dy,
				"key": "%d_%d" % [cdx + dx, cdy + dy], "dist": absi(dx) + absi(dy),
			})
	neighbours.sort_custom(func(a, b): return a["dist"] < b["dist"])
	for cell in neighbours:
		_grid.queued_cells[cell["key"]] = true
		_load_queue.append(cell)

## Loads one real region cell (terrain + objects) at grid position (dx, dy)
## relative to _grid_origin_region, and marks it loaded in _grid.loaded_cells.
## Shared by the initial neighborhood load and _maybe_stream_regions --
## dx/dy must always be relative to the fixed _grid_origin_region, never
## to wherever the player currently is, so every cell's real world
## position stays consistent as the player moves and more cells stream in
## around them (see _grid_origin_world's own doc comment).
##
## `prepared` (round 565) is a terrain job a WorkerThreadPool task has
## already prepared (_dispatch_cell): only its commit runs here -- and since
## round 566 the same task has prepared the cell's objects too
## (prepared["objects"], _cell_prepare), so only their commit runs here as
## well. Empty, the terrain and the objects are prepared and committed here,
## on the main thread, as before. Either way the objects and the NPCs follow
## in the same frame, after the terrain group exists.
func _load_region_cell(region_x: int, region_y: int, dx: int, dy: int, shared_anchor: float, prepared: Dictionary = {}) -> void:
	var suffix := "_%d_%d" % [region_x, region_y]
	var offset := _cell_offset(dx, dy)
	_load_timings.begin_cell(region_x, region_y)
	var t0 := Time.get_ticks_usec()
	if prepared.is_empty():
		_try_load_real_terrain("%d\\%d.m" % [region_x, region_y], "", offset, suffix, false, shared_anchor, false)
	else:
		_terrain_commit(prepared)
	var t1 := Time.get_ticks_usec()
	if prepared.has("objects"):
		_objects_commit(prepared["objects"])
	else:
		_try_load_real_map_objects("%d\\%d.o" % [region_x, region_y], offset, suffix)
	var t2 := Time.get_ticks_usec()
	if not title_mode:
		_try_spawn_region_npcs(region_x, region_y)
	_note_cell_built(t0, t1, t2, Time.get_ticks_usec())
	_grid.mark_loaded(dx, dy, region_x, region_y)
	# Its monsters waiting for it are built now (round 655).
	_monster_cells_dirty = true

## Where a region's terrain group stands (_terrain_commit): the half-span
## centring, the vertical anchor and the cell's offset from the frame region
## (_cell_offset), with z negated -- together with the group's scale.z = -1
## that is the world's one global z -> -z mirror (the **Un-mirrored** comment
## in _terrain_commit). A static function since round 570 so the frame test
## (region_grid_state_test.gd) holds this placement, not a copy of it, to
## server/internal/worldmap.ToWorld. Since round 572 _terrain_commit places
## the group itself with TerrainCollision.place_group, whose arithmetic the
## heightfield's grid lines follow from; this is the same position without a
## node (for _frame_corner), and region_grid_state_test.gd holds the two equal
## -- position and scale -- for every frame row's cell, Constantinople's under
## the server's -single-frame, and several anchors.
static func _group_position(world_offset: Vector3, anchor_height: float) -> Vector3:
	var placement := Vector3(
		-REGION_SPAN / 2.0, -anchor_height, -REGION_SPAN / 2.0) + world_offset
	return Vector3(placement.x, placement.y, -placement.z)

## The frame region's corner -- _grid_origin_world, which _maybe_stream_regions
## measures the player from (RegionGridState.cell_at) -- for a grid placed on
## `anchor_height` (_grid_shared_anchor_height): where the frame region's own
## group stands, or would stand, _group_position of no offset. Every cell of
## the grid, the centre included, stands at this corner plus its
## RegionGridState.cell_world_offset (region_grid_state_test.gd holds that
## for every FRAME_ROWS region), so the corner does not need the centre's
## terrain to have loaded.
##
## Round 571 (the review of round 570): until then _load_region_neighborhood
## read the corner off the centre group and, when the centre's terrain had
## failed to load, took Vector3.ZERO as the centre group's position. The
## corner then stood at minus the centre's cell_world_offset -- for a frame
## other than the centre, what the server's -single-frame names for every
## town but Jangan, regions away from the grid (grid_origin_test.gd derives
## where); for a frame that is the centre, half a region off, at the centre
## region's middle. Only x and z are read (cell_at). With no height known --
## neither the frame's nor the centre's `.m` gave one -- y is 0, as the old
## fallback's was.
static func _frame_corner(anchor_height: float) -> Vector3:
	return _group_position(Vector3.ZERO, 0.0 if is_nan(anchor_height) else anchor_height)

## A grid cell's offset from the frame region's (the grid origin's) cell,
## BEFORE the mirror: _group_position negates its z. The world-space offset,
## after it, is RegionGridState.cell_world_offset.
static func _cell_offset(dx: int, dy: int) -> Vector3:
	# **Axes corrected 2026-09-02** (see docs/WORLD_ISSUES.md's forty-sixth
	# round) -- this was Vector3(dx * REGION_SPAN, 0.0, dy * REGION_SPAN),
	# i.e. region_x -> world X and region_y -> world Z. That was wrong, and
	# it was the real root cause of the hard straight-line seams at every
	# region boundary: it placed entirely unrelated real regions next to
	# each other, so neighbouring terrain never lined up in height *or*
	# texture. Real, exact proof (server/cmd's ad hoc findneighbor_scratch,
	# deleted after use): for a target region, every one of its four real
	# edge vertex rows matches exactly one other real region's opposite
	# edge with a mean absolute difference of **exactly 0.000000** -- and
	# the matching partners are region_x±1 on the north/south (world Z)
	# axis and region_y±1 on the west/east (world X) axis, the opposite of
	# what this code assumed. Verified on two unrelated real regions
	# (96/169 and 98/157), same rule both times. So: region_x -> world Z,
	# region_y -> world X.
	return Vector3(dy * REGION_SPAN, 0.0, dx * REGION_SPAN)

## Closes the cell _load_timings has open (round 561): the three phase
## totals from the stopwatches around them -- the same numbers the `region
## grid loaded` split has summed since round 156 -- and one `World3D: cell
## x/y built in N ms at frame f (terrain [..], objects [..], npcs)` line per
## cell, the sub-phases inside from _try_load_real_terrain's and
## _try_load_real_map_objects' own laps.
func _note_cell_built(t0: int, t1: int, t2: int, t3: int) -> void:
	_load_timings.group("terrain", t1 - t0)
	_load_timings.group("objects", t2 - t1)
	_load_timings.group("npcs", t3 - t2)
	print(_load_timings.end_cell(Engine.get_frames_drawn()))

## Streams additional real region cells in as the player moves, keeping a
## real REGION_LOAD_RADIUS window centered on whichever real region
## they're currently standing over rather than the fixed spot they
## started at -- see _grid_origin_region's own doc comment for why this
## exists. Cheap to call every physics frame: the real region-coordinate
## check is trivial, and the expensive part (loading/unloading real
## regions) only runs on the real cell boundary crossings that actually
## need it, which happen roughly once per REGION_SPAN (1920 units)
## traveled, not every frame.
func _maybe_stream_regions() -> void:
	if not _grid_has_origin:
		return
	var rel := player.position - _grid_origin_world
	# cur.x is a region_x (folder) delta and cur.y a region_y (file) delta --
	# and region_x maps to world Z while region_y maps to world X, so these
	# read from the opposite world axes (see _load_region_cell's own comment
	# for the real, exactly-verified adjacency rule this follows).
	# The real world is mirrored in Z (see _try_load_real_terrain's own
	# **Un-mirrored** comment), so region_x now grows toward -Z and the
	# cell test has to follow it. Getting this wrong streams the
	# neighbouring regions in on the wrong side of the player.
	# **floor, not round** (fixed 2026-09-06, see docs/WORLD_ISSUES.md's
	# sixty-fifth round). `_grid_origin_world` is the origin region's own
	# *corner*, not its centre, so `rel` runs 0 -> REGION_SPAN across the
	# region the player is standing in. Rounding therefore flipped to the
	# next cell at the halfway point: from the middle of their own region
	# onward the player was treated as being in the neighbouring one, so the
	# loaded block was shifted a full region -- terrain ahead never streamed
	# in, terrain still underfoot behind them was unloaded, and the zone
	# label changed a half-region early. Flooring puts the boundary where the
	# real region boundary actually is.
	var cur := RegionGridState.cell_at(rel)
	if cur == _last_stream_cell:
		return
	_last_stream_cell = cur
	_update_zone_label_for_region(_grid_origin_region.x + cur.x, _grid_origin_region.y + cur.y)

	var radius := _region_load_radius()
	# Nearest-first, so the cells the player is about to reach build before the
	# far corners of the window.
	var new_cells: Array = []
	for dy in range(cur.y - radius, cur.y + radius + 1):
		for dx in range(cur.x - radius, cur.x + radius + 1):
			var key := "%d_%d" % [dx, dy]
			if _grid.loaded_cells.has(key) or _grid.queued_cells.has(key):
				continue
			new_cells.append({
				"rx": _grid_origin_region.x + dx, "ry": _grid_origin_region.y + dy,
				"dx": dx, "dy": dy, "key": key,
				"dist": absi(dx - cur.x) + absi(dy - cur.y),
			})
	new_cells.sort_custom(func(a, b): return a["dist"] < b["dist"])
	for cell in new_cells:
		_grid.queued_cells[cell["key"]] = true
		_load_queue.append(cell)

	# Unload real cells now well outside the real load radius, so a player
	# walking through a real, large world doesn't accumulate every region
	# they've ever passed through as permanently-loaded nodes.
	var unload_margin := _region_load_radius() + 1
	for key in _grid.loaded_cells.keys().duplicate():
		var parts := (key as String).split("_")
		var kdx := int(parts[0])
		var kdy := int(parts[1])
		if absi(kdx - cur.x) <= unload_margin and absi(kdy - cur.y) <= unload_margin:
			continue
		var region_x := _grid_origin_region.x + kdx
		var region_y := _grid_origin_region.y + kdy
		var suffix := "_%d_%d" % [region_x, region_y]
		# The region's NPCs are children of its terrain node (see
		# _try_spawn_region_npcs) and go with it; counted so the log reads
		# against the `NPC(s) placed in x/y` line of the region's return.
		var npcs_freed := 0
		# Before the containers go: what this region holds that a region
		# still loaded lists moves there (round 643).
		var handed := _release_region_objects(suffix)
		if int(handed["moved"]) > 0:
			print("World3D: region %d/%d unloaded -- %d object(s) it held handed to a region still listing them, %d dropped" % [
				region_x, region_y, handed["moved"], handed["dropped"]])
		var terrain_node := get_node_or_null("RealTerrain" + suffix)
		if terrain_node != null:
			for child in terrain_node.get_children():
				if String(child.name).begins_with("Npc_"):
					npcs_freed += 1
			terrain_node.queue_free()
		var objects_node := get_node_or_null("RealMapObjects" + suffix)
		if objects_node != null:
			objects_node.queue_free()
		# The scenery templates only this region placed go with it (round
		# 559); the key is the region's own `.o` path, as
		# _try_load_real_map_objects registered it.
		if _object_templates != null:
			var freed := _object_templates.release_region("%d\\%d.o" % [region_x, region_y])
			if freed > 0:
				print("World3D: region %d/%d unloaded -- %d scenery templates only it placed freed, %d held" % [
					region_x, region_y, freed, _object_templates.size()])
		# And everything the world remembered about it (round 563): its
		# cell; its NPC mark, so _try_spawn_region_npcs runs again when the
		# cell streams back in; its nav graph, whose freed group left in the
		# list aborted _nav_graph_for on every tick; its navmesh, its
		# heightmap and the object collision meshes only it referenced.
		# Until this round only the cell key was erased.
		var dropped := _grid.unload(region_x, region_y)
		# Its monsters' bodies go with it (round 655), their snapshots kept.
		_monster_cells_dirty = true
		print("World3D: region %d/%d forgotten -- %s; %d NPC holder(s) freed with its terrain" % [
			region_x, region_y, ", ".join(dropped), npcs_freed])

## A region streaming out (round 643): it stops listing every key it
## listed (_placed_objects), and each object whose node its container holds
## moves -- keeping its place in the world -- to the container of another
## loaded region that lists it, or goes with the container when none does.
## So an object shared by two regions stays drawn while either is loaded,
## as the retail loader's refcount keeps it. Returns {"moved", "dropped"}.
func _release_region_objects(suffix: String) -> Dictionary:
	var own_container = _object_containers.get(suffix)
	_object_containers.erase(suffix)
	var moved := 0
	var dropped := 0
	for key in _placed_objects.keys():
		var held: Dictionary = _placed_objects[key]
		var listers: Dictionary = held["listers"]
		if not listers.erase(suffix) or held["holder"] != suffix:
			continue
		var node: Node3D = held["node"]
		var heir := ""
		for other in listers:
			var candidate = _object_containers.get(other)
			if candidate != null and is_instance_valid(candidate) and not (candidate as Node).is_queued_for_deletion():
				heir = other
				break
		if heir == "" or not is_instance_valid(node):
			_placed_objects.erase(key)
			dropped += 1
			continue
		# A unique name first: the heir's container may hold an "Obj_x_<n>"
		# of its own, and a clash would rename the node "@Obj_x...@".
		var suffix_k: String = "_k%d" % key
		if not String(node.name).ends_with(suffix_k):
			node.name = String(node.name) + suffix_k
		var target: Node3D = _object_containers[heir]
		# Its place in the world kept: the containers' chains up the tree
		# composed by hand, which holds outside the tree too.
		var xf := _chain_transform(target).affine_inverse() * _chain_transform(node.get_parent() as Node3D) * node.transform
		node.get_parent().remove_child(node)
		target.add_child(node)
		node.transform = xf
		held["holder"] = heir
		moved += 1
	# What stays in the container goes with it: the animation driver drops
	# it now (round 647) rather than finding it freed later -- a sector
	# decided whole is not visited, so a freed object could sit in it.
	if own_container != null:
		_map_animations.drop_under(own_container)
	return {"moved": moved, "dropped": dropped}

## A Node3D's transform composed up its chain of Node3D parents -- its
## global transform when the chain reaches the world's root.
static func _chain_transform(node: Node3D) -> Transform3D:
	var xf := Transform3D.IDENTITY
	var n: Node = node
	while n is Node3D:
		xf = (n as Node3D).transform * xf
		n = n.get_parent()
	return xf

## Builds up to STREAM_CELLS_PER_FRAME queued cells a frame, so a boundary
## crossing streams over several frames rather than freezing for one long
## one. A cell the player has since moved away from is dropped, not built.
##
## Since round 565 (the default; OPENSRO_SYNC_LOAD=1 keeps the loop below)
## a cell's terrain (and since round 566 its objects) prepares on a
## WorkerThreadPool task and this commits at
## most STREAM_CELLS_PER_FRAME finished ones a frame (_pump_cell_jobs) --
## except while _drain_initial_load pumps them itself, which owns the queue
## until it returns.
func _process_stream_queue() -> void:
	if not _grid_has_origin:
		return
	if _threaded_load():
		if _drain_pumping or (_load_queue.is_empty() and _cell_jobs.is_empty()):
			return
		_pump_cell_jobs(STREAM_CELLS_PER_FRAME, false)
		return
	if _load_queue.is_empty():
		return
	var margin := _region_load_radius() + 1
	var built := 0
	while built < STREAM_CELLS_PER_FRAME and not _load_queue.is_empty():
		var cell: Dictionary = _load_queue.pop_front()
		_grid.queued_cells.erase(cell["key"])
		if _grid.loaded_cells.has(cell["key"]):
			continue
		if _outside_stream_window(cell, margin):
			continue # the player left this cell's window before it built
		_load_region_cell(cell["rx"], cell["ry"], cell["dx"], cell["dy"], _grid_shared_anchor_height)
		built += 1

## Whether a queued cell is now further from the player's cell than the
## unload margin -- the player left its window before it was built.
func _outside_stream_window(cell: Dictionary, margin: int) -> bool:
	if _title_planned:
		return false # a planned title backdrop builds its whole plan (round 680)
	return absi(int(cell["dx"]) - _last_stream_cell.x) > margin or absi(int(cell["dy"]) - _last_stream_cell.y) > margin

## Whether streamed cells prepare their terrain (round 565) and objects (round
## 566) on WorkerThreadPool tasks, the default. OPENSRO_SYNC_LOAD=1 turns
## that off for one release, as an escape hatch: every cell is then prepared
## and committed on the main thread on the pre-round-565 schedule -- the entry drain's
## LOADING_CELLS_PER_FRAME a frame plus the physics step's
## STREAM_CELLS_PER_FRAME from the same queue, and one a frame in play.
## It restores the SCHEDULE only, not the old code: the terrain still goes
## through _terrain_job / _terrain_prepare / _terrain_commit and the
## collision round 567 gives it (the heightfield, TerrainCollision; the faces
## MapmTerrainBuilder.surface_faces builds under OPENSRO_TERRAIN_TRIMESH=1),
## and the objects
## through _objects_job / _objects_prepare / _objects_commit, the split
## ObjectLoader (prepare_object then commit_object) and the trimesh faces
## ObjectLoader._piece_faces builds -- each half run back to back on the
## main thread.
func _threaded_load() -> bool:
	return OS.get_environment("OPENSRO_SYNC_LOAD") == ""

## The one pump of the threaded cell pipeline (round 565): commits up to
## `commit_budget` cells whose terrain has finished preparing, oldest first,
## and keeps TERRAIN_JOBS_IN_FLIGHT preparing. Each finished cell is
## committed BEFORE the next is dispatched, so the next job's snapshot
## (_terrain_job, _objects_job) holds what that commit cached -- its ground
## tiles, object navigation meshes, heightmaps, templates and textures --
## and its task does not prepare them again; the other job in flight keeps
## preparing while this one commits. Until round 566's review the next cell
## was dispatched first, and _finish_cell_job's `prepared again` line
## measured what that cost (docs/RE_COMPLETION.md, round 566). With `wait` (the QA drain,
## which must have every cell in before it returns) a commit that finds no
## finished task waits for the oldest -- the main thread holds no lock the
## task needs, and the task touches no server (_terrain_prepare's rule), so
## the wait cannot deadlock. Returns the cells finished -- committed, or
## dropped by the stale-cell guard (_finish_cell_job).
func _pump_cell_jobs(commit_budget: int, wait: bool) -> int:
	_dispatch_cell_jobs()
	var finished := 0
	while finished < commit_budget and not _cell_jobs.is_empty():
		var at := -1
		for i in range(_cell_jobs.size()):
			if WorkerThreadPool.is_task_completed(_cell_jobs[i]["task"]):
				at = i
				break
		if at < 0:
			if not wait:
				break
			at = 0
		var flight: Dictionary = _cell_jobs[at]
		_cell_jobs.remove_at(at)
		# Every task is waited for once, which disposes of it (Godot 4.2's
		# WorkerThreadPool reference: a task id "already awaited and disposed
		# of" no longer exists); for a finished one it returns at once.
		PoolWait.task(flight["task"])
		_finish_cell_job(flight)
		_dispatch_cell_jobs()
		finished += 1
	return finished

## Tops the preparing cells up to TERRAIN_JOBS_IN_FLIGHT from the queue,
## nearest-first, skipping a cell already loaded or one whose window the
## player has left since it was queued.
func _dispatch_cell_jobs() -> void:
	var margin := _region_load_radius() + 1
	while _cell_jobs.size() < TERRAIN_JOBS_IN_FLIGHT and not _load_queue.is_empty():
		var cell: Dictionary = _load_queue.pop_front()
		if _grid.loaded_cells.has(cell["key"]) or _outside_stream_window(cell, margin):
			_grid.queued_cells.erase(cell["key"])
			continue
		_dispatch_cell(cell)

## Starts one cell's prepare on a WorkerThreadPool task: the job is
## built here, on the main thread (_terrain_job's snapshot), and the task
## runs the static _terrain_prepare over it (_cell_prepare, round 566). High
## priority: Godot 4.2's pool runs low-priority tasks (add_task's default) on a share of its threads
## only -- threading/worker_pool/low_priority_thread_ratio, 0.3 in the
## project as shipped (read on the render box's 4.2.2, round 565) -- which on
## a small machine can be a single thread for both jobs.
##
## Since round 566 the task prepares the cell's objects after its terrain
## (_cell_prepare): the objects job is built here too (_objects_job's
## snapshot) and rides in job["objects"].
func _dispatch_cell(cell: Dictionary) -> void:
	var rx: int = cell["rx"]
	var ry: int = cell["ry"]
	var offset := _cell_offset(cell["dx"], cell["dy"])
	var suffix := "_%d_%d" % [rx, ry]
	var job := _terrain_job("%d\\%d.m" % [rx, ry], "", offset, suffix,
		false, _grid_shared_anchor_height, false)
	job["threaded"] = true
	job["dispatched_frame"] = Engine.get_frames_drawn()
	var objects := _objects_job("%d\\%d.o" % [rx, ry], offset, suffix)
	objects["threaded"] = true
	objects["dispatched_frame"] = job["dispatched_frame"]
	job["objects"] = objects
	var task := WorkerThreadPool.add_task(_cell_prepare.bind(job), true, "cell %d/%d" % [rx, ry])
	_cell_jobs.append({"task": task, "cell": cell, "job": job})

## Commits a cell whose terrain has prepared -- the rest of the cell (its
## objects and NPCs) follows in the same frame, _load_region_cell -- unless
## the stale-cell guard drops it: a cell already loaded, or one whose window
## the player left while it prepared. A zone change never gets here with an
## old grid's job: _clear_region_grid drops them first. A committed cell's
## `prepared again` line follows its `built in` line (_prepared_again).
func _finish_cell_job(flight: Dictionary) -> void:
	var cell: Dictionary = flight["cell"]
	_grid.queued_cells.erase(cell["key"])
	var why := ""
	if _grid.loaded_cells.has(cell["key"]):
		why = "already loaded"
	elif _outside_stream_window(cell, _region_load_radius() + 1):
		why = "the player left its window while it prepared"
	if why != "":
		print("World3D: cell %d/%d prepared but not committed -- %s" % [cell["rx"], cell["ry"], why])
		return
	var again := _prepared_again(flight["job"])
	_load_region_cell(cell["rx"], cell["ry"], cell["dx"], cell["dy"], _grid_shared_anchor_height, flight["job"])
	print("World3D: cell %d/%d prepared again what an earlier commit had cached -- %d ground tile(s), %d navmesh(es), %d object navigation mesh(es), %d heightmap(s) the objects read, %d model(s), %d object texture(s) decoded" % [
		cell["rx"], cell["ry"], again["tiles"], again["navmesh"], again["collisions"],
		again["heightmaps"], again["models"], again["textures"]])

## What a streamed cell's task read or built that this world had cached by
## the time the cell commits: a commit that landed after this cell's job
## took its snapshot got there first, so this cell's copy is thrown away
## (every commit keeps what is already cached). Counted on the main thread
## before the commit merges anything, per cache -- `tiles` the ground tiles
## _prepare_ground_textures decoded, `navmesh` the region's `.nvm`,
## `collisions` the object navigation meshes _prepare_nav_graph read,
## `heightmaps` the `.m` heightmaps _job_heightmap read and parsed for the
## ownership test, `models` the models prepare_object prepared and
## `textures` the textures it decoded. A null a prepare cached ("tried,
## nothing") counts too: the archive was read again for it. The measurement
## of round 566's review, which found _pump_cell_jobs dispatching the next
## cell before committing the finished one (docs/RE_COMPLETION.md, round
## 566).
##
## Two things a job holds are NOT counted, because its prepare did not read
## them (round 566's second review, which found the first counter counting
## both). A texture the job's snapshot already held (job["known_textures"])
## is only named by the prepare -- ObjectLoader._prepare_material's `known`
## branch, which files it with a null image -- so a texture counts only if
## its entry carries an Image: the prepare decoded it from the archive. One
## whose key is NOT in that snapshot was decoded because the world had not
## uploaded it when the job was built, and counts if it is uploaded now. One
## whose key IS in the snapshot was decoded AGAIN by _alpha_stat, for a
## statistic the snapshot lacked; it counts if ANY statistic it measured
## that the snapshot lacked is in the world's entry now -- a commit after
## the snapshot carried it in (ObjectLoader.commit_textures merges a
## prepare's statistics into a texture already cached). A snapshot taken
## after that commit would have spared the decode only if EVERY such
## statistic had been carried in. Since round 625 there is one statistic,
## `fraction`, measured only under OPENSRO_QA_MATS (the material rule reads
## the layer's flag word, not the pixels), so the two rules agree. (Round
## 568's review: with the old pixel rule a QA_MATS job could measure two
## statistics on one held texture and this count could run over by it.)
## Until round 568 the counter skipped every snapshot-held key, and this
## comment said no later commit could have spared such a decode -- wrong,
## by commit_textures (round 566's second review, re-read in round 568).
## The change can only
## ADD a texture the old rule skipped, and only after a re-decode: the load
## benchmark's command (a) consults no alpha probe at all (0 in round 566's
## alpha_after.log), so its recorded counts cannot move; the crossing, (b),
## was never run with OPENSRO_QA_ALPHA_LOG. And the region's own
## heightmap taken over from the terrain prepare's parse (job["here"],
## _cell_prepare) was parsed for the terrain, which needs it whatever the
## snapshot held, so a heightmap counts only if it is not that parse.
func _prepared_again(job: Dictionary) -> Dictionary:
	var again := {"tiles": 0, "navmesh": 0, "collisions": 0, "heightmaps": 0, "models": 0, "textures": 0}
	for filename in job.get("new_images", {}):
		if _ground_texture_cache.has(filename):
			again["tiles"] += 1
	if job.get("navmesh_loaded", false) and _grid.navmesh_cache.has(job["navmesh_key"]):
		again["navmesh"] = 1
	for id in job.get("parsed_collisions", {}):
		if _grid.object_collision_cache.has(id):
			again["collisions"] += 1
	var objects: Dictionary = job.get("objects", {})
	var here = objects.get("here")
	var new_heightmaps: Dictionary = objects.get("new_heightmaps", {})
	for key in new_heightmaps:
		if here != null and new_heightmaps[key] == here:
			continue
		if _grid.parsed_heightmaps.has(key):
			again["heightmaps"] += 1
	for key in objects.get("models", {}):
		if _object_templates != null and _object_templates.has(key):
			again["models"] += 1
	var known: Dictionary = objects.get("known_textures", {})
	var textures: Dictionary = objects.get("textures", {})
	for key in textures:
		var decoded: Dictionary = textures[key]
		if decoded.get("image") == null or not _object_textures.has(key):
			continue
		if not known.has(key):
			again["textures"] += 1
			continue
		# Decoded again for a statistic the snapshot lacked (_alpha_stat):
		# counts only if a commit since has carried that statistic in.
		var had: Dictionary = known[key].get("alpha", {})
		var now: Dictionary = _object_textures[key].get("alpha", {})
		for stat in decoded.get("alpha", {}):
			if not had.has(stat) and now.has(stat):
				again["textures"] += 1
				break
	return again

## Waits for every preparing cell's task and drops it, uncommitted: a zone
## change (the grid it was for is gone), a new grid, the world leaving the
## tree (a reconnect frees this instance, and a task still running would
## call into it). Blocks the main thread for at most the longest remaining
## prepare -- a worker holds nothing the main thread holds, and PoolWait
## serves the RenderingServer calls a prepare queues for the main thread on
## Godot 4.7.2 (round 760), so the wait ends -- and says how long it took.
func _drop_cell_jobs(why: String) -> void:
	if _cell_jobs.is_empty():
		return
	var started := Time.get_ticks_usec()
	var n := _cell_jobs.size()
	for flight in _cell_jobs:
		PoolWait.task(flight["task"])
		_grid.queued_cells.erase(flight["cell"]["key"])
	_cell_jobs.clear()
	print("World3D: %d cell(s) still preparing dropped (%s) -- waited %.1f ms for their tasks" % [
		n, why, (Time.get_ticks_usec() - started) / 1000.0])

## Whether world entry shows the "NOW LOADING" screen: a real player does; a
## QA/dev render (OPENSRO_MAPM_PATH set) does not, because its synchronous
## load is what the screenshot depends on -- unless OPENSRO_QA_FORCE_LOADING
## asks for it, to render the screen itself.
func _should_show_loading_screen() -> bool:
	return OS.get_environment("OPENSRO_MAPM_PATH") == "" or OS.get_environment("OPENSRO_QA_FORCE_LOADING") != ""

# Cells built per frame while the loading screen is up: the player is not
# moving yet, so a bigger batch than the in-play stream is fine.
#
# Threaded (round 565, the default): the drain commits at most this many
# prepared cells a frame and is the only pump while it runs
# (_drain_pumping), so a frame under the screen builds at most two -- and
# only as many as have finished preparing, with TERRAIN_JOBS_IN_FLIGHT = 2
# preparing at once.
#
# Under OPENSRO_SYNC_LOAD=1, the pre-round-565 schedule: not the whole
# frame, though -- the same frame's physics step runs _process_stream_queue,
# which pops STREAM_CELLS_PER_FRAME more from the same _load_queue (nothing
# gates it on the drain there; _grid_has_origin is set before it), so round
# 561's baseline built THREE cells a frame under the screen -- three `built
# in` lines at each of frames 14-21. The benchmark counts cells a frame
# from the log (docs/RE_COMPLETION.md, rounds 561 and 565).
const LOADING_CELLS_PER_FRAME := 2

## Finishes the initial region load that `_load_region_neighborhood` queued.
## With no loading screen (a QA render) the queue is drained at once, so the
## first frames show the whole world. With one, the queue is pumped a batch a
## frame (see LOADING_CELLS_PER_FRAME) and the gauge filled, so a real entry
## has feedback instead of a black freeze.
##
## Threaded (round 565, the default), the drain owns the cell pipeline until
## it returns (_drain_pumping): its first jobs are dispatched before the
## centre's frame is awaited, so they prepare while that frame draws; each
## later frame commits up to LOADING_CELLS_PER_FRAME finished ones and the
## gauge reads the cells finished over the total. The QA branch keeps the
## QA-drain contract (client/tools/README.md, "Load benchmark"): it waits for
## each task and commits every cell before it returns, so --shots, --radius
## and the movie writer still see the whole grid from the first shot. `frames_already_awaited` is what the caller
## awaited between `region_started_ms` and here -- _ready's frame that drew
## the screen (round 562) -- so the `region grid loaded` line's count covers
## the same span as its total.
func _drain_initial_load(region_started_ms: int, frames_already_awaited: int = 0) -> void:
	# No screen wanted (a QA render): build the queue at once so the first
	# frames show the whole world.
	if _loading_screen == null and not _should_show_loading_screen():
		if _threaded_load():
			_drain_pumping = true
			while not _load_queue.is_empty() or not _cell_jobs.is_empty():
				_pump_cell_jobs(TERRAIN_JOBS_IN_FLIGHT, true)
			_drain_pumping = false
		else:
			while not _load_queue.is_empty():
				_build_one_queued_cell()
		print(_grid_loaded_line(region_started_ms, 0))
		print(_load_timings.summary())
		_prewarm_after_entry.call_deferred()
		_qa_print_entry_probe()
		_land_restored_return_point()
		_adopt_char_entry()
		_initial_load_done = true
		_report_loading_done()
		return
	# Reuse the screen the caller put up (_ready and _on_change_zone_result
	# both do, ahead of their centre cell, since round 562), else make one
	# now -- kept for a caller that did not, with the same held archive.
	#
	# After every await: a socket drop while this is suspended (a server
	# redeploy landing on a player still loading) has _on_disconnected
	# change scene, which removes this instance from the tree at once; the
	# next process_frame still resumed this coroutine on the detached
	# instance, which built one more batch of cells into a world already
	# gone and died at the following await, get_tree() being null (round
	# 558's runs C and D: two `!is_inside_tree()` errors, then `Invalid get
	# index 'process_frame' (on base: 'null instance')`, one per drop, on
	# both routes). Out of the tree there is nothing left to load for.
	var frames_awaited := frames_already_awaited
	if _loading_screen == null:
		_loading_screen = LoadingScreen.new(_loading_backdrop(-1), _open_media_pk2_if_set())
		ui_control.add_child(_loading_screen)
	# The gauge counts the centre cell the caller built before this drain
	# (the + 1), and one frame is drawn before the first batch, so the centre
	# cell stays a frame of its own. Until round 562 that frame was the
	# screen's own creation here; with the screen up before the centre cell
	# the first batch joined the centre's frame, and the benchmark's longest
	# work frame read 7,506 ms for a 5,234 ms centre cell (round 562's first
	# run) -- the later items are measured centre against centre.
	var total := _load_queue.size() + 1
	_loading_screen.set_progress(1.0 / float(total))
	var threaded := _threaded_load()
	if threaded:
		# The first jobs start now and prepare while the centre's frame draws;
		# dispatch is a snapshot, so the centre's frame gains next to nothing.
		_drain_pumping = true
		_pump_cell_jobs(0, false)
	await get_tree().process_frame
	frames_awaited += 1
	if not is_inside_tree():
		return
	if threaded:
		while not _load_queue.is_empty() or not _cell_jobs.is_empty():
			_pump_cell_jobs(LOADING_CELLS_PER_FRAME, false)
			var remaining := _load_queue.size() + _cell_jobs.size()
			total = maxi(total, remaining + 1)
			_loading_screen.set_progress(1.0 - float(remaining) / float(total))
			await get_tree().process_frame
			frames_awaited += 1
			if not is_inside_tree():
				return
		_drain_pumping = false
	else:
		while not _load_queue.is_empty():
			for _i in range(LOADING_CELLS_PER_FRAME):
				if _load_queue.is_empty():
					break
				_build_one_queued_cell()
			_loading_screen.set_progress(1.0 - float(_load_queue.size()) / float(total))
			await get_tree().process_frame
			frames_awaited += 1
			if not is_inside_tree():
				return
	# The same phase split the synchronous QA path prints, so a reconnect
	# run's two entries can be compared phase by phase (round 559), with the
	# frames awaited between batches -- which is where this branch's total
	# leaves the cells' own sum behind (round 561, _grid_loaded_line).
	print(_grid_loaded_line(region_started_ms, frames_awaited))
	print(_load_timings.summary())
	_prewarm_after_entry.call_deferred()
	if ParseProfile.enabled:
		print(ParseProfile.report("entry"))
		# A fresh window for what loads after the entry -- a species or a
		# character met for the first time (round 669), or the play after it
		# (round 670) -- so the next `window` table counts none of the entry.
		ParseProfile.reset()
	_qa_print_entry_probe()
	# The gauge at 100 % for one frame, then the screen goes: the client's
	# forced last repaint, FUN_00ba3fc0(1000, 1), and the next update's close
	# (FUN_0084c060, round 785, READ). The caption stays: until round 785 it
	# turned to "Entering the world..." for this one frame alone, a flicker
	# of its own.
	_loading_screen.set_progress(1.0)
	await get_tree().process_frame
	if not is_inside_tree():
		return
	_loading_screen.queue_free()
	_loading_screen = null
	print("LoadingScreen: lifted at frame %d" % Engine.get_frames_drawn())
	# A finished load leaves the mode at 2 (FUN_0084c060's end, READ).
	_loading_mode = LoadingBackdrop.MODE_ZONE
	_land_restored_return_point()
	_adopt_char_entry()
	_initial_load_done = true
	# Round 786: the screen is down and the cells are in -- the loading-done
	# report, as FUN_0084c060 sends 0x3012 right after removing the screen's
	# windows (READ, 0x84c0e5..0x84c208).
	_report_loading_done()

## Round 786 (part): the loading-done report's gate (ArrivalGuard.ReadyReport):
## armed by the world entry and by each zone change's result, sent once from
## the drain's end. The server keeps the character out of every other
## player's view, and untargetable, until it arrives.
var _ready_report := ArrivalGuard.ReadyReport.new(func() -> void: NetClient.report_ready_to_play())

## Sends the armed report if the load is really over: no screen up, no cell
## queued or preparing.
func _report_loading_done() -> void:
	var left := _load_queue.size() + _cell_jobs.size()
	var why := _ready_report.why
	if _ready_report.loading_done(_loading_screen != null, left):
		print("World3D: loading done (%s) -- 0x3012 sent at frame %d, %d ms" % [
			why, Engine.get_frames_drawn(), Time.get_ticks_msec()])
	elif _ready_report.armed:
		print("World3D: loading-done report held (%s): screen %s, %d cell(s) left" % [
			why, "up" if _loading_screen != null else "down", left])

## Round 746: BCRadius and DecayTime from every characterdata part (CharTables'
## entry task, a worker), taken once -- by the NPC or monster loaders or, at
## the latest, when the entry's grid is in, before any character or monster
## spawns into it.
var _char_entry_adopted := false
func _adopt_char_entry() -> void:
	if _char_entry_adopted or _media_pk2 == null:
		return
	_char_entry_adopted = true
	var t := Time.get_ticks_usec()
	var centry := CharTables.entry(_media_pk2)
	_bc_radius_by_code = centry.bc_radius
	_monster_decay_ms_by_code = centry.decay
	# Every row's BCRadius (column 50), for the attack approach: the player's
	# body and the monsters' species both feed the reach band.
	print("World3D: %d BCRadius row(s) from characterdata column 50 (%s: %s); %d monster DecayTime row(s) from column 13 (MOB_CH_MANGNYANG: %s ms); taken in %d us, %d us of it waiting" % [
		_bc_radius_by_code.size(), GENDER_BODY_CODE[DEFAULT_GENDER],
		str(_bc_radius_by_code.get(GENDER_BODY_CODE[DEFAULT_GENDER], "none")),
		_monster_decay_ms_by_code.size(), str(_monster_decay_ms_by_code.get("MOB_CH_MANGNYANG", "none")),
		Time.get_ticks_usec() - t, CharTables.last_entry_wait_usec])

## A restored entry's position (round 690), world (x, z), until the entry's
## grid is in; null otherwise. _land_restored_return_point consumes it.
var _restored_entry_point: Variant = null

## Stands a restored entry on the walkable graph when it is a teleport point
## (round 690). The server saves a character that leaves the world dead at its
## return point -- the designated gate's teleport point, at its own height 0
## (session.savedPlace) -- and a character that logs out where a teleport put
## it, without moving, at that arrival's height 0 too; the entry keeps a
## restored position, lifted only to the bare terrain
## (_snap_player_onto_terrain): 12.19 under Hotan's plaza, 355.79 under
## GATE_TOMB_GATE_IN's object and 366.84 under GATE_ARABIAN_COAST's (MEASURED,
## walk_probe --column). A restored point that is no teleport point keeps that
## rule: it is where the character stood, on whatever floor it stood on.
func _land_restored_return_point() -> void:
	if _restored_entry_point == null:
		return
	var spot: Vector2 = _restored_entry_point
	_restored_entry_point = null
	var result = NetClient.last_enter_world_result
	var zone: String = result.zone if result != null else ""
	var frame: String = result.frame if result != null else ""
	var point := _teleport_point_at(spot, _zone_frame_coords(zone, frame))
	if point == null:
		return
	if _land_teleport_arrival(spot.x, spot.y):
		print("World3D: the restored entry is %s's point (a teleport arrival) -- stood on the walkable graph there" % point.code)

## The frame a zone's coordinates are in (round 690): the server's FrameRegion
## when it parses, else the zone's own centre (_frame_coords); {} when neither
## is known.
func _zone_frame_coords(zone: String, frame: String) -> Dictionary:
	var centre := _parse_region_coords(_resolve_zone_region(zone)) if zone != "" else {}
	return _frame_coords(centre, frame)

## Round 786: where a point of a grid built in frame `old_frame` (region
## x/y) on `old_anchor` (its height anchor, _grid_shared_anchor_height; NAN
## is 0, as _frame_corner reads it) is in a grid built in `new_frame` on
## `new_anchor`, as the offset to add: the same placement every cell gets
## (_group_position of its _cell_offset), so the two frames agree on every
## region. The original's map hands its objects this offset when the
## player's region changes (CICPlayer slot 37, 0x009d5900, READ; EfpEffect
## shift_effects).
static func zone_frame_shift(old_frame: Vector2i, old_anchor: float, new_frame: Vector2i, new_anchor: float) -> Vector3:
	var a0 := 0.0 if is_nan(old_anchor) else old_anchor
	var a1 := 0.0 if is_nan(new_anchor) else new_anchor
	return _group_position(_cell_offset(old_frame.x - new_frame.x, old_frame.y - new_frame.y), a1) \
		- _group_position(Vector3.ZERO, a0)

## Where region (rx, ry)'s local (lx, lz) is in the world, in a grid built in
## frame (fx, fy) (round 690): the transform TerrainCollision.place_group gives
## that region's group (_cell_offset of its cell in the frame, the z mirror),
## without the group having to be loaded.
static func region_local_to_world(rx: int, ry: int, lx: float, lz: float, fx: int, fy: int) -> Vector2:
	var g := Node3D.new()
	TerrainCollision.place_group(g, _cell_offset(rx - fx, ry - fy), 0.0)
	var at := g.transform * Vector3(lx, 0.0, lz)
	g.free()
	return Vector2(at.x, at.z)

## The teleport point (any open-world teleportdata row, TeleportReader.
## world_points) whose arrival is within TELEPORT_POINT_MATCH of world (x, z)
## in frame `frame_coords` ({"x", "y"}); null when none, or with no frame.
func _teleport_point_at(spot: Vector2, frame_coords: Dictionary) -> TeleportReader.Point:
	if _teleport_reader == null or frame_coords.is_empty():
		return null
	var fx: int = frame_coords["x"]
	var fy: int = frame_coords["y"]
	for p_v in _teleport_reader.world_points():
		var p: TeleportReader.Point = p_v
		var at := region_local_to_world((p.region >> 8) & 0xFF, p.region & 0xFF, p.x, p.z, fx, fy)
		if at.distance_to(spot) <= TELEPORT_POINT_MATCH:
			return p
	return null

## How close a server position must be to a teleport point to be taken for an
## arrival there (OURS): the server names the point exactly, as float32 world
## coordinates from the table's whole numbers.
const TELEPORT_POINT_MATCH := 1.0

## The `region grid loaded` line (round 561): the drain's wall time from its
## clock start, the terrain/objects/npcs split both branches have printed
## since round 559, the frame, and the cells' own sum against the total. The
## difference is what the drain paid outside the cells: under the loading
## screen, the screen's own build and every frame awaited between batches,
## so the sum is at most the total and never equal to it (the plan's "equal
## within 5%" cannot hold on that branch by construction); on the
## synchronous QA path the two are close. A sum above the total would mean
## the clock started after some cell, which the line says outright.
func _grid_loaded_line(region_started_ms: int, frames_awaited: int) -> String:
	var total := Time.get_ticks_msec() - region_started_ms
	var cells_ms := _load_timings.total_ms("terrain") + _load_timings.total_ms("objects") + _load_timings.total_ms("npcs")
	var line := "World3D: region grid loaded in %d ms (terrain %.0f, objects %.0f, npcs %.0f) at frame %d -- %d cells %.0f ms, %.0f ms outside the cells over %d awaited frames" % [
		total, _load_timings.total_ms("terrain"), _load_timings.total_ms("objects"), _load_timings.total_ms("npcs"),
		Engine.get_frames_drawn(), _load_timings.cells, cells_ms, total - cells_ms, frames_awaited]
	if cells_ms > total:
		line += " -- the cell sum EXCEEDS the total: the drain's clock started after a cell"
	# Work the cells had done on WorkerThreadPool tasks (round 565): not in
	# the split or the sum above, which are the main thread's.
	for g in _load_timings.offthread_ms:
		line += "; %s %.0f ms prepared off the main thread" % [g, _load_timings.offthread_ms[g]]
	return line

## Puts the "NOW LOADING" screen up (a real player only), so a caller can
## cover a load whose first, synchronous part runs before the drain -- the
## entry's centre cell (round 562) or a teleport's. Returns the frames it
## awaited: one, for the frame that draws the screen, or none under QA or
## when one is already up. The screen reads its backdrop through the
## Media.pk2 this world already holds (_load_character_assets opens it at
## the top of _ready; _open_media_pk2_if_set returns that handle, or opens it
## for a world without character tables) rather than through a reader of its
## own -- until round 562 every screen, every login and every teleport,
## opened the 1.5 GB archive again (FrontEndUi.open_media); the screen's own
## `LoadingScreen: up at frame` line says which it did and what it cost.
##
## Its art is the client's choice (round 785's follow-up, LoadingBackdrop):
## by _loading_mode, and for a zone change by the region it arrives in
## (`region_id`, -1 when unknown: the default zone art).
func _show_loading_screen(region_id: int = -1) -> int:
	if _loading_screen != null or not _should_show_loading_screen():
		return 0
	_loading_screen = LoadingScreen.new(_loading_backdrop(region_id), _open_media_pk2_if_set())
	ui_control.add_child(_loading_screen)
	await get_tree().process_frame
	return 1

## CPSMission+0xe0, the loading screen's mode (READ, LoadingBackdrop): 0 for
## the world's first entry (OnCreate sets it), 1 once this player has died
## (_enter_dead_state), 2 after every finished load (FUN_0084c060's end, here
## the lift in _drain_initial_load).
var _loading_mode := LoadingBackdrop.MODE_FIRST
## The art the last screen showed: a mode that changes no art keeps it.
var _loading_backdrop_last := LoadingScreen.DEFAULT_BACKDROP

## The art the next screen shows (LoadingBackdrop.path; mode 0's draw is
## the engine's randi(), the client's rand()).
func _loading_backdrop(region_id: int) -> String:
	var art := LoadingBackdrop.path(_loading_mode, region_id, randi())
	if art == "":
		art = _loading_backdrop_last
	_loading_backdrop_last = art
	print("LoadingScreen: mode %d, region %d (0x%x) -> %s" % [_loading_mode, region_id, maxi(region_id, 0), art.get_file()])
	return art

## The region id (LoadingBackdrop.region_id) a zone change arrives in: the
## dungeon's id, or the region of the server's arrival point in the zone's
## frame; -1 when neither is known. The client's comes in the 0x34B5 packet
## (the character's position record, READ); ours from OpChangeZoneResult.
func _arrival_region_id(result: WorldNet.ChangeZoneResult) -> int:
	if result == null:
		return -1
	var rid := DungeonWorld.rid_of_zone(result.zone)
	if rid >= 0:
		return rid
	var frame := _zone_frame_coords(result.zone, result.frame)
	if frame.is_empty():
		return -1
	var r := region_at_world(result.x, result.z, int(frame["x"]), int(frame["y"]))
	return LoadingBackdrop.region_id(r.x, r.y)

## The region (x, y) whose ground holds world (x, z) in a grid built in frame
## (fx, fy): the inverse of region_local_to_world, read off three of its
## points (the frame's corner, one region over each way) so it follows that
## transform rather than restating it.
static func region_at_world(wx: float, wz: float, fx: int, fy: int) -> Vector2i:
	var o := region_local_to_world(fx, fy, 0.0, 0.0, fx, fy)
	var step_x := region_local_to_world(fx + 1, fy, 0.0, 0.0, fx, fy) - o
	var step_y := region_local_to_world(fx, fy + 1, 0.0, 0.0, fx, fy) - o
	var d := Vector2(wx, wz) - o
	# Each region step moves one world axis only (MEASURED by the test).
	var dx := floori(d.y / step_x.y) if absf(step_x.y) > absf(step_x.x) else floori(d.x / step_x.x)
	var dy := floori(d.x / step_y.x) if absf(step_y.x) > absf(step_y.y) else floori(d.y / step_y.y)
	return Vector2i(fx + dx, fy + dy)

## Builds the next queued cell, if it is still wanted, prepare and commit on
## the main thread -- the OPENSRO_SYNC_LOAD=1 path of the entry-time drain
## (round 565: the threaded default pumps _pump_cell_jobs instead).
func _build_one_queued_cell() -> void:
	if _load_queue.is_empty():
		return
	var cell: Dictionary = _load_queue.pop_front()
	_grid.queued_cells.erase(cell["key"])
	if not _grid.loaded_cells.has(cell["key"]):
		_load_region_cell(cell["rx"], cell["ry"], cell["dx"], cell["dy"], _grid_shared_anchor_height)

## _ready()'s own entry point into the region grid: reads OPENSRO_MAPM_PATH
## the same way this scene always has, but now treats it as the *center* of
## a real multi-region neighborhood (see _load_region_neighborhood) instead
## of the one and only region loaded. Falls back to the original
## single-region behavior for a path that isn't shaped like a real region
## coordinate (e.g. a loose dev file with no real (x, y) meaning).
## How many regions out from the player to load, as an override of
## REGION_LOAD_RADIUS.
##
## The default 2 means a 5x5 grid -- 25 regions of terrain and objects
## parsed on every start. Measured on the render box, that fixed cost is
## about 65 seconds of a 94-second screenshot run, against 0.33 seconds a
## frame once it is up. Most checks only ever look at one region, so being
## able to ask for fewer is most of the wait.
func _region_load_radius() -> int:
	if title_mode:
		return _title_radius
	var override := OS.get_environment("OPENSRO_QA_RADIUS")
	if override != "" and override.is_valid_int():
		return maxi(int(override), 0)
	return REGION_LOAD_RADIUS

func _load_initial_region_neighborhood() -> void:
	var mapm_path := OS.get_environment("OPENSRO_MAPM_PATH")
	if mapm_path != "":
		var coords := _parse_region_coords(mapm_path)
		if coords.is_empty():
			_try_load_real_terrain()
			_try_load_real_map_objects()
			return
		_load_region_neighborhood(coords["x"], coords["y"], _region_load_radius(), OS.get_environment("OPENSRO_MAPM_TEXTURE_PATH"))
		return

	# No dev/testing env var set -- the real, normal path for an actual
	# logged-in player: load whatever real zone the server itself already
	# placed them in (NetClient.last_enter_world_result.zone), the exact
	# same resolution _reload_zone_assets uses for a later zone change.
	# Without this, a real downloaded client with real pk2 files in its
	# local pk2/ folder (see Pk2Config) and no env vars set at all would
	# never load any terrain/objects on a normal login -- the env-var path
	# above was the only one ever wired to real region loading, which only
	# ever exercised this project's own dev/testing workflow, never a real
	# player's actual first spawn.
	var result := NetClient.last_enter_world_result
	if result != null and result.ok and result.zone != "":
		_reload_zone_assets(result.zone, result.frame)
		# A restored entry (round 573: the server's -persist-position read back
		# where the character last stood, WorldNet.EnterWorldResult.restored)
		# keeps the server's position -- _ready already put the player there.
		# Moving it on to the zone's landing spot is what every other entry
		# does, and what a client before round 573 does to a restored Jangan
		# entry too. What still runs on it: the centre region's deferred
		# _snap_player_onto_terrain, which only LIFTS a player the ground is
		# above (a saved height below the drawn ground), and only after a lift
		# _avoid_spawning_under_roof -- so a character saved standing under a
		# roof is left under it, where it stood; /unstuck
		# (_unstuck_player) then takes it to the zone's landing.
		if result.restored:
			print("World3D: the server restored %s at (%.1f, %.1f, %.1f) in frame %s -- kept, not moved to the zone's landing spot" % [
				result.zone, result.x, result.y, result.z, result.frame])
			# A character that left the world dead is saved at its return
			# point (server savedPlace, READ FUN_004df050), at the server's
			# height 0, and so is one that logged out where a teleport put it:
			# stood on the walkable graph once the grid is in
			# (_land_restored_return_point, round 690).
			_restored_entry_point = Vector2(result.x, result.z)
		else:
			_place_at_zone_spawn(result.zone)
	else:
		print("World3D: no real zone to load (no OPENSRO_MAPM_PATH set and no real logged-in session) -- ground stays a placeholder")

## Tears down whatever real terrain/map-object nodes are currently loaded
## and reloads them for zone, resolving real per-zone paths via _zone_paths
## instead of the fixed OPENSRO_MAPM_PATH/OPENSRO_MAPO_PATH env vars this
## scene's initial _ready() load still uses. If zone isn't shaped like a
## real region coordinate (see _zone_paths), this just clears back to the
## placeholder ground with no objects -- same honest "nothing to load"
## behavior as an unset env var, not a guess.
##
## `frame` is the server's FrameRegion for the zone (round 570), "" from an
## older server or a QA run: the grid is built around the zone's own region
## inside that frame (_frame_coords).
func _reload_zone_assets(zone: String, frame: String = "") -> void:
	_clear_region_grid()
	if _ground_markers != null:
		_ground_markers.zone_changed()
	_cancel_talk_approach("zone change")
	ground_mesh.visible = true
	ground_collision.disabled = false

	# A dungeon (round 773): its rooms, not a region grid.
	var dungeon_rid := DungeonWorld.rid_of_zone(zone)
	if dungeon_rid >= 0:
		_grid_has_origin = false
		_load_dungeon(dungeon_rid)
		return

	var region := _resolve_zone_region(zone)
	var coords := _parse_region_coords(region)
	if coords.is_empty():
		print("World3D: zone %s isn't shaped like a real region (x/y) -- no per-zone assets to load" % zone)
		# _clear_region_grid() above already removed every real region node
		# and cleared the grid state that referenced them -- also drop the
		# origin, so _maybe_stream_regions doesn't keep trying to grow a
		# grid around a real origin cell that no longer exists.
		_grid_has_origin = false
		return

	var frame_coords := _frame_coords(coords, frame)
	# One line whenever the server named a frame, so a run can measure which
	# frame a grid was built in rather than infer it from a missing line.
	if frame != "":
		if _parse_region_coords(frame).is_empty():
			print("World3D: the server's frame %s for zone %s isn't a region (x/y) -- building in the zone's own frame, %s" % [frame, zone, region])
		elif int(frame_coords["x"]) == int(coords["x"]) and int(frame_coords["y"]) == int(coords["y"]):
			print("World3D: zone %s (%s) is built in its own frame -- the server's FrameRegion %s" % [zone, region, frame])
		else:
			print("World3D: zone %s (%s) is built in the frame of %s, the server's FrameRegion -- the centre is cell %d/%d" % [
				zone, region, frame, int(coords["x"]) - int(frame_coords["x"]), int(coords["y"]) - int(frame_coords["y"])])
	var paths := _zone_paths(zone)
	_load_region_neighborhood(coords["x"], coords["y"], _region_load_radius(), paths.get("minimap", ""), frame_coords)

## The coordinate frame a zone's grid is built in (round 570), {"x", "y"}:
## the region the server named as its FrameRegion when it named one that
## parses, else the zone's own centre -- the frame every server's coordinates
## were in before the server named it, and still are for every zone by
## default (server/internal/worldmap.FrameFor returns ZoneCentre, which
## _resolve_zone_region equals; zone_centres_test.gd). The server's
## -single-frame (round 571, default off) names 97/168 for every town.
static func _frame_coords(centre: Dictionary, frame: String) -> Dictionary:
	if frame != "":
		var named := _parse_region_coords(frame)
		if not named.is_empty():
			return named
	return centre

## The vertical anchor of a grid whose frame is not its centre (round 570):
## the FRAME region's own near-row height (MapmTerrainBuilder.
## near_row_middle_height, the vertex a centre calibrates on), so every grid
## built in one frame shares one height origin and a place stands at the same
## height whether it was walked to or arrived at. NAN -- the centre then
## calibrates itself, as it always has -- when the frame's `.m` cannot be
## read. Read on the main thread, once per zone load.
##
## Reached only under the server's -single-frame (round 571, default off),
## which names 97/168 as the frame of every town; by default the server names
## each zone's own centre. Round 571 (docs/RE_COMPLETION.md, "Heights under
## ONE frame") checked each town's drawn heights under 97/168's anchor
## against the snap ray (_snap_player_onto_terrain, +-1000) and WORLD_FLOOR_Y,
## after round 570 recorded the five town centres' under 97/168.
func _frame_anchor_height(frame_x: int, frame_y: int) -> float:
	var bytes := AssetSource.read_bytes("%d\\%d.m" % [frame_x, frame_y], _open_map_pk2_if_set())
	if bytes.is_empty():
		print("World3D: the frame region %d/%d has no terrain to anchor on -- the centre calibrates itself" % [frame_x, frame_y])
		return NAN
	var parsed := MapmReader.parse(bytes)
	if parsed == null:
		print("World3D: the frame region %d/%d's terrain does not parse -- the centre calibrates itself" % [frame_x, frame_y])
		return NAN
	return MapmTerrainBuilder.near_row_middle_height(parsed)

## Reacts to a successful real zone change (see NetClient.change_zone/
## OpChangeZoneResult): updates the zone label and reloads this scene's
## terrain/map objects for the new real zone. A failed zone change (bad
## request, already in that zone, ...) is left to whatever UI triggered it
## to report -- this scene doesn't render its own error text for that.
func _on_change_zone_result(result: WorldNet.ChangeZoneResult) -> void:
	# A gate teleport's receipt came just before this result (round 576,
	# _on_teleport_result): the position is the destination gate's point, to
	# be kept -- consumed here whatever the result, so a refused change cannot
	# leave it set for a later one.
	var teleport_arrival := _teleport_arrival_pending
	_teleport_arrival_pending = false
	# Whether this client asked for this zone change (round 690,
	# _request_zone_change, matched by _match_zone_change_request): a result
	# it did not ask for, or one that finds the player dead, is the server
	# moving the character to its return point (option 1 of the dead window,
	# or the flag-off respawn).
	var at_point := false
	if result != null and result.ok and not teleport_arrival:
		at_point = _teleport_point_at(Vector2(result.x, result.z), _zone_frame_coords(result.zone, result.frame)) != null
	var requested := _zone_result_requested(teleport_arrival,
		result.zone if result != null else "", result != null and result.ok, at_point)
	var dead_at_arrival := _player_dead
	var keep_server_point := arrival_keeps_server_point(teleport_arrival, requested, dead_at_arrival)
	if result != null and result.ok:
		# Round 838: an accepted skin change's body goes on with the warp.
		_apply_skin_pending()
		# Round 795: the COS in view start over (the server sends its own
		# again with their 0x30C8; the mount is found again by its uid).
		_cos_clear()
		# A zone change or a teleport lets go of the icon on the cursor
		# (round 652's review; OURS -- retail's handling is not read).
		if _hud_panels != null:
			_hud_panels.cancel_held_icon("zone change")
		# A new object in the new zone: no movement order (round 637's review
		# follow-up, _player_move_order) -- and no walk or run in effect
		# (round 653's review): a heading run carried on into the new zone.
		_player_move_order = false
		_end_move_order_for_arrival()
		# The server stands a character that changes zone (round 607).
		_sit.reset()
		_arrow_reset()
		if _footprints != null:
			_footprints.clear()
		# And runs it again (round 781, the server's runAgain; OURS).
		_reset_walk_for_entry()
		# Retail's zone reset (FUN_00787860) runs FUN_007b5300: a running
		# berserk display fades out (round 629's review).
		if _hud_player_info != null:
			_hud_player_info.reset_hwan_display()
		# ... and FUN_007b1300: the delay board (the casting bar) is cleared,
		# with no message (round 779).
		if _hud_panels != null and _hud_panels.close_cast_bar():
			print("CASTBAR closed by the zone change")
		# Round 860: and the scroll state with it (a new object, state 0).
		_own_teleport_state = 0
	if not result.ok:
		# An accepted teleport whose move failed (warpTo's "not in the world";
		# the server refunds the fee): the request is over, so a destination
		# line works again (round 603's review). A refused zone change that is
		# not a teleport's arrival leaves a pending request alone.
		if teleport_arrival:
			_teleport_request_pending = false
		elif result != null and result.reason != "":
			# Round 854: OpChangeZone is a GM's tool (the developer panel's
			# zone box and town buttons); anyone else is refused and stays
			# where they are. The reason goes to the system line, so the
			# panel's "Travelling to ..." is not left unanswered.
			_log_system("Zone change refused: %s" % result.reason)
			print("ZONE CHANGE refused: %s" % result.reason)
		return
	# Round 786 (part): this arrival's loading-done report (0x3012) goes when
	# its load is over (_drain_initial_load); until then the server keeps the
	# character out of the world (ArrivalGuard).
	_ready_report.arm("teleport" if teleport_arrival else "zone change")
	# Round 786 (READ, EfpEffect "shift_effects"): nothing is updated while
	# the zone loads (CPSMission::vslot_012, 0x0084c300), and the change of
	# frame moves every effect whole (CICPlayer slot 37, 0x009d5900 ->
	# CEFEffect::vslot_006, 0x00ca9f20) -- the effects placed now, in the old
	# frame, are moved once the new frame is built (below).
	var fx_old_frame := EfpEffect.placed_under(self)
	var old_frame := _grid_origin_region
	var old_anchor := _grid_shared_anchor_height
	var old_field := _grid_has_origin and _dungeon == null
	EfpEffect.pause_world(true)
	# No gate UI survives a zone change (round 578): its gate is behind. The
	# talk box and the destinations it lists go, and so does the NPC it
	# names -- a talk box left up here would list the old gate's destinations
	# in the new zone (its teleport line reads _talk_npc_code), and a click
	# would send the old gate's links from there (the server would now refuse
	# it by range, round 642's review, but the lines must not be offered).
	_close_gate_ui()
	# From here to the arrival list's layout (_replace_others_for_arrival),
	# who enters or leaves is kept for it (round 646's review).
	_arrival_pending = true
	_arrival_entries.clear()
	_arrival_left.clear()
	# A zone change is a loading screen: music and ambient stop, the area is
	# cleared (round 612, FUN_0084ab20), whether or not the screen is shown.
	var zone_music := _audio_music()
	if zone_music != null:
		zone_music.enter_loading("zone change")
	# A teleport shows the "NOW LOADING" screen (the playtester's call: the
	# loading screen belongs on a teleport). Up before the zone assets load so
	# even the synchronous centre-cell build is behind it; the queued
	# neighbours then pump behind it in _drain_initial_load below. The zone
	# drain's clock starts after this frame (below), so the frame it returns
	# is not this drain's to count; the entry's clock in _ready runs from
	# before its screen and does count it (round 562). Its art is by the
	# region it arrives in (round 785's follow-up).
	await _show_loading_screen(_arrival_region_id(result))
	# The same guard as the drain's: a drop during that frame leaves nothing
	# to rebuild for (round 560).
	if not is_inside_tree():
		EfpEffect.pause_world(false)
		return
	# In the server's frame (result.frame, round 570). That frame is the
	# zone's own centre by default, so (0, 0, 0) is the centre region's
	# middle. Under the server's -single-frame (round 571, default off) it is
	# 97/168 for every town, and the server sends the town's landing -- its
	# centre region's middle named in that frame (worldmap.Landing) -- inside
	# the grid, which is built around the centre; (0, 0, 0) would be the
	# FRAME region's middle, off it.
	player.position = Vector3(result.x, result.y, result.z)
	_last_sent_pos = player.position
	_walked_since_send = 0.0
	# Round 749: the server has the character here, with no leg; the old
	# zone's walkers walk no more.
	_move_sync.placed(player.position)
	_other_legs.clear()
	_other_heights_pending.clear()
	# The monsters of the old zone are left behind, and so is any attack
	# still walking toward one of them -- with the walk, whose target is a
	# spot in the old zone's coordinates.
	_drop_pending_attack()

	_replace_others_for_arrival(result.others, result.seated)

	# Same stale-body bug as _other_bodies above, for monsters -- the old
	# zone's monster list result never gets superseded on its own, so
	# without this their capsules would keep showing here too.
	for monster_id in _monster_bodies.keys():
		_monster_bodies[monster_id].queue_free()
	_monster_bodies.clear()
	_minimap_unique_bodies.clear()
	# And any body still fading out of the old zone (round 677): gone now,
	# not left fading at its old-zone spot. And the old zone's corpse holds
	# (round 677's review): their timers find no body of theirs and do
	# nothing (_finish_monster_death's body_id).
	_appear_fades.free_out_now()
	_depart_flush()
	_dying_until.clear()
	# Their snapshots too (round 638 review): the old zone's monsters are no
	# one's target here; the list below refills it. And any body still
	# queued or waiting for its region (round 655).
	_monster_snapshots.clear()
	_monster_build_queue.clear()
	_monster_build_queued.clear()
	_monster_deferred.clear()
	_monster_motion.clear()
	_monster_heights_pending.clear()
	_strike_waits.clear()
	NetClient.list_monsters()
	NetClient.list_ground_items()

	# The zone drain's clock and grid totals start here, ahead of the centre
	# cell _reload_zone_assets builds, so its `region grid loaded` total
	# covers every cell its split counts (round 561).
	var zone_started_ms := Time.get_ticks_msec()
	_load_timings.begin_drain()
	_reload_zone_assets(result.zone, result.frame)
	# Round 786 (READ, CICPlayer slot 37, 0x009d5900): field to field, the
	# old frame's effects move by the offset between the two frames; into a
	# dungeon the original moves nothing (its region's bit 0x8000), and out
	# of one what it does is OPEN (nothing moved here).
	if old_field and _grid_has_origin and _dungeon == null:
		var by := zone_frame_shift(old_frame, old_anchor, _grid_origin_region, _grid_shared_anchor_height)
		var moved := EfpEffect.shift_effects(fx_old_frame, by)
		print("EFFECTS zone change: %d effect(s) moved %s from frame %s to %s" % [moved, by, old_frame, _grid_origin_region])

	# Only now, with the new region's terrain and walkable graph actually
	# built, can an `@x,z` from the zone box be honoured -- see
	# _split_zone_target.
	if keep_server_point:
		# A gate teleport keeps the server's position -- the destination gate's
		# point -- instead of the zone's landing spot (_place_at_zone_spawn
		# would move a Jangan arrival to the square, ZONE_SPAWN_LOCAL), and
		# stands it on the walkable graph there; held there until its region
		# is built when that is a neighbour cell (_step_teleport_landing).
		# So, since round 690, does a return to the return point: it is the
		# designated gate's teleport point, the arrival a gate teleport there
		# makes (server ResolveRevivePoint, READ in round 686), and the server
		# sends it at height 0 as it sends a teleport's. Until round 690 it
		# took the branch below: Jangan's was moved to the square (the client
		# 350 units from where the server had it), and every other town's
		# kept the server's 0 and was only lifted to the bare terrain by
		# _snap_player_onto_terrain -- 12.5 units under Hotan's plaza, the
		# user's "clipped half way through the ground" (MEASURED, round 690).
		if not teleport_arrival:
			print("World3D: the server moved the character to (%.1f, %.1f) -- %s; kept and stood on the walkable graph" % [
				result.x, result.z, "the return point (dead)" if dead_at_arrival else "a zone change this client did not ask for (the return point)"])
		_teleport_landing = Vector2(result.x, result.z)
		_step_teleport_landing()
	elif _pending_zone_local != null:
		var spot: Vector2 = _pending_zone_local
		_pending_zone_local = null
		var coords := _parse_region_coords(_resolve_zone_region(result.zone))
		if not coords.is_empty() and _place_at_region_local(coords["x"], coords["y"], spot.x, spot.y):
			_refresh_zone_label_position()
		else:
			print("World3D: zone %s has no loaded region to stand at local %s, %s -- left at the server's own landing spot" % [
				result.zone, spot.x, spot.y])
	elif not _place_at_zone_spawn(result.zone) and _pending_gm_pos == null:
		# A zone with no landing spot of its own (every town but Jangan):
		# stood on the walkable graph at the server's landing point, as a
		# teleport arrival is, and reported with that height (round 749's
		# verification, c). It used to keep the server's height 0 until the
		# terrain snap lifted it -- 12.5 under Hotan's plaza (round 690) --
		# and never told the server the ground's.
		_teleport_landing = Vector2(result.x, result.z)
		_step_teleport_landing()

	# A GM /goto or /tp that crossed a zone boundary carried a world position
	# to stand at once the zone loaded -- honour it now, over the zone's own
	# landing spot.
	if _pending_gm_pos != null:
		var gm_spot: Vector2 = _pending_gm_pos
		_pending_gm_pos = null
		_place_player_at_world(gm_spot.x, gm_spot.y)

	# Pump the new zone's queued neighbour cells behind the loading screen (if
	# one is up), then drop it -- the same drain the first entry uses.
	await _drain_initial_load(zone_started_ms)
	_qa_arm_arrival_probe("zone change to %s%s" % [result.zone, " (gate teleport)" if teleport_arrival else ""])
	# A teleport point in a neighbour cell has its ground now; one that still
	# has none (no walkable graph there at all) is let go to the ordinary
	# ground snap rather than held for ever.
	if _teleport_landing != null and is_inside_tree():
		_step_teleport_landing()
		if _teleport_landing != null:
			var unlanded: Vector2 = _teleport_landing
			print("World3D: no walkable graph under the teleport point (%.1f, %.1f) after the zone loaded -- released to the ground snap" % [
				unlanded.x, unlanded.y])
			_teleport_landing = null
	# Round 786: the arrival is laid out; the effects take it as one
	# placement, as retail's do once its loading screen goes.
	EfpEffect.pause_world(false)

## A zone change is loading: OpEntityEntered / OpEntityLeft are kept for its
## arrival list (round 646's review) -- id -> snapshot, and the ids that left.
var _arrival_pending := false
var _arrival_entries: Dictionary = {}
var _arrival_left: Dictionary = {}

## A zone change's arrival list replaces whoever was drawn (split out of
## _on_change_zone_result in round 646, so a test can run it without a
## loading screen).
func _replace_others_for_arrival(others: Array, seated: Array) -> void:
	# Who entered during the load joins the list; who left during it is
	# taken out of it (round 646's review: an arrival's body used to be built
	# on the old zone's list and freed here, and stayed undrawn until they
	# re-entered).
	var list: Array = []
	for o in others:
		if not _arrival_left.has(int(o.character_id)):
			list.append(o)
	var listed := {}
	for o in list:
		listed[int(o.character_id)] = true
	for id in _arrival_entries:
		if not listed.has(int(id)):
			list.append(_arrival_entries[id])
	if _arrival_pending:
		print("World3D: arrival list %d, %d entered and %d left during the load" % [others.size(), _arrival_entries.size(), _arrival_left.size()])
	_arrival_pending = false
	_arrival_entries.clear()
	_arrival_left.clear()
	# Whoever was rendered as an "other" belonged to the *old* zone -- the
	# server only broadcasts OpEntityLeft to people left behind, never back
	# to the mover, so without this their stale capsules/bodies would keep
	# showing here even though this player can no longer interact with them
	# (see docs/PROGRESS.md for this bug, caught right after the initial
	# OpChangeZone implementation shipped).
	for character_id in _other_bodies.keys():
		_other_bodies[character_id].queue_free()
	_other_bodies.clear()
	# Round 762: and the departures still queued or fading, as retail's zone
	# reset deletes every object at once (FUN_009c2c20, READ round 677).
	_depart_flush()
	_minimap_moved.clear()
	if _hud_minimap != null and is_instance_valid(_hud_minimap):
		_hud_minimap.clear_others()
	_other_legs.clear() # round 749
	_other_heights_pending.clear()
	_other_gaits.clear()
	_other_hint_by_skel.clear()
	_other_settled.clear()
	_other_awake.clear()
	_other_seated.clear()
	# Round 739: and their queued dressing and their uids.
	_other_builds.clear()
	_other_build_args.clear()
	_other_ghosts.clear()
	_ghost_ids.clear()
	_ghost_moving.clear()
	_ghost_refused.clear()
	_other_uids.clear()
	# Round 762's review, F3: and every page's hold state -- a page held at
	# the zone change kept its waiting ids, and every later group spawn of
	# the session waited for the 20 s deadline.
	_reset_pages()
	# Their buffs went with them (round 638): the new zone's owners, this
	# player included, are re-sent on arrival (sendBuffsInView). Round 646:
	# the re-sent starts can arrive during _on_change_zone_result's loading-
	# screen await, before this, and went to the old bodies -- the book is rebuilt from what NetClient holds for the new
	# zone (BuffRoster, started over at the result), and each body built
	# below, and this player's, takes its auras from it.
	_target_buff_book.clear()
	# Each state's look undone first (round 785's client review, finding 5):
	# its aura, its pulse and its clip speed outlived the zone change, and the
	# server never re-sends this player's own mask.
	_clear_state_looks("the zone change")
	_abnormal_states.clear()
	# The new zone's players' states, told during the load (round 737's
	# review: a spawn's states follow it), from what NetClient holds.
	_replay_character_states()
	_fx_owner_buffs.clear()
	# Who sits among those spawned during the load (their records' motion
	# byte, round 737's review) is drawn seated with the list's own.
	var sat: Array = seated.duplicate()
	for o in list:
		if o.seated and not sat.has(int(o.character_id)):
			sat.append(int(o.character_id))
	_spawn_result_others(list, sat)
	# The equipment broadcasts that arrived while the list was not drawn
	# (round 735's review, finding 1).
	_flush_pending_equip_changes()
	_fx_resync_all("the zone change's arrival")

## Everything in the world that plays an animation -- NPCs and monsters.
## Each entry is [Skeleton3D, ParsedAnimation, frame count, phase, loops,
## started at, resume, (hold)]: a looping idle, or a one-shot (a hit, a death)
## that holds its last frame and then goes back to `resume` -- an idle entry,
## or null to stay on the last frame, which is what a corpse does. A one-shot
## from _play_once carries an eighth element, true for a death hold (round
## 534); the loops have seven.
##
## Phase matters: without it every Mangyang in a field steps in perfect
## unison, which reads as a bug rather than as a crowd. Each character gets
## a fixed offset from its own instance count, so it is stable across frames
## rather than jittering.
var _animated: Array = []
## The sounds the playing clips fire (AnimSounds): the local player, other
## players and monsters are registered by skeleton, and _tick_idle_animations
## and the player's own tick report each clip's time to it.
var _anim_sounds := AnimSounds.new()
## Berserk (hwan) is on for the local player -- the last attack or berserk
## result said so. Kept here so a re-dressed body's sound owner starts with it.
var _audio_hwan := false
# Assembled NPC bodies kept as detached templates, one per model path, and
# duplicated per spawn. Assembling a skinned .bsr is what made each region
# take seconds; most NPCs in a region share a model, and duplicating a node
# (sharing its mesh/texture resources) is far cheaper than re-assembling. The
# template is never parented, so unloading a region frees the duplicates, not
# it. See _try_spawn_region_npcs.
var _npc_model_cache := {} # model path -> SkinnedBsrAssembler.AssembledCharacter

## Scenery templates -- one per model path across every region this world
## loads, owned and freed with the world (ObjectTemplateCache, round 559).
## Built by _try_load_real_map_objects on first use; released per region by
## the streaming unload (_maybe_stream_regions), kept across a zone change
## (_clear_region_grid), freed in _exit_tree. Until round 559 these were a
## per-call dictionary that was never freed: every region built its own
## copies, and they outlived the region, the zone change and the instance.
var _object_templates: ObjectTemplateCache
## Decoded scenery textures, `.ddj` path -> Texture2D, shared by every
## scenery material this world builds (ObjectLoader.build_godot_material's
## texture_cache): two models naming one texture upload it once. Per
## world, never static -- statics are what a reconnect keeps.
var _object_textures := {}
## Every map object this world has placed, by the `.o2` record's key
## (MapO2Reader.Entry.object_key: owner region and uid) -> {"node", "holder"
## (the region suffix whose container holds the node), "listers" (every
## loaded region whose `.o2` names the key)} -- round 643. The retail loader
## keeps one object per key in a refcounted cache (Map::FUN_00a1a1d0), and
## a region-straddling object is listed by each region it reaches; so the
## first region to commit a key places it, later ones share it, and a
## region streaming out hands what it holds to a lister still loaded
## (_release_region_objects). Cleared with the grid (_clear_region_grid).
var _placed_objects := {}
## Each loaded region's RealMapObjects container, by region suffix -- where
## _release_region_objects moves an object whose holder streams out.
var _object_containers := {}
## The models the objects job being committed prepared (round 566), lower-
## cased path -> ObjectLoader.prepare_object's result: set by _objects_commit
## around its placement loop, read by _load_object_template, empty
## otherwise.
var _prepared_models := {}
## Templates _load_object_template built with no prepared model during the
## current commit -- one whose template the grid released or evicted
## between the job's dispatch and its commit, or one past the prepare's
## MAX_MAP_OBJECTS bound. On the objects line of a streamed cell, so a
## main-thread build is never silent.
var _templates_unprepared := 0

## ObjectTemplateCache's loader: one real .bsr/.cpd, against this world's
## Data.pk2 and texture cache -- committed from the model the job prepared
## (ObjectLoader.commit_object, round 566), or, with none, loaded whole here
## (ObjectLoader.load_object, both halves on the main thread).
func _load_object_template(model_path: String) -> Node3D:
	var sw := Time.get_ticks_usec()
	var prepared: Dictionary = _prepared_models.get(model_path.to_lower(), {})
	var node: Node3D
	if not prepared.is_empty():
		node = ObjectLoader.commit_object(prepared, _object_textures)
	else:
		_templates_unprepared += 1
		node = ObjectLoader.load_object(_open_pk2_if_set(), model_path, _object_textures)
	# Placed objects cast no shadow: in Detail only characters do, as in the
	# original, whose scenery shadows are baked (round 702 review). Every
	# placed copy is a duplicate() of this template.
	if node != null:
		for g in node.find_children("*", "GeometryInstance3D", true, false):
			(g as GeometryInstance3D).cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_load_timings.lap("objects", "templates", sw)
	return node

## What this world owns outside the tree goes when the world does, and what
## it set on state it does not own is put back (rounds 559, 560), so that
## nothing of one login reaches the next in the same process:
## - the scenery templates and the decoded-texture cache (round 559: as a
##   per-call dictionary they outlived the instance -- a scripted reconnect
##   doubled the orphan nodes exactly, 3,770 -> 7,540, and the exit report
##   counted every template's mesh, material, texture, body and shape as
##   leaked, round 558's run A2: 2468 / 2468 / 2469 / 2114 / 2114);
## - the NPC templates in _npc_model_cache, never parented (their own doc
##   comment), so nothing else frees them -- round 559's exit census still
##   reported 354 meshes / 355 textures after the scenery templates were
##   freed, consistent with these;
## - this instance's ground, water and environment caches (instance state
##   since round 560, statics until then);
## - a loading screen still up, so a resumed drain has nothing to draw on;
## - the root viewport's debug_draw, which is the Window's and not this
##   scene's: debug_panel._on_draw_mode_selected sets it and nothing reset
##   it, so a Wireframe or Lighting view chosen in one world was applied to
##   the next one entered in the same process.
## Also called on quit, where all of it is harmless.
func _exit_tree() -> void:
	# Round 866 (lane AX, the guardian's crash): the flows this world made cut
	# their connections to NetClient's stores, which outlive it; a flow left
	# connected was kept alive by its own lambdas and, after a re-entry, called
	# this world's freed HUD (SignalLinks).
	for flow in [_academy_flow, _union_world, _specialty_flow]:
		if flow != null:
			flow.detach()
	_academy_flow = null
	_union_world = null
	_specialty_flow = null
	# Round 786: the display pass goes with the world.
	if RenderingServer.frame_pre_draw.is_connected(_submit_efp_pass):
		RenderingServer.frame_pre_draw.disconnect(_submit_efp_pass)
	EfpDisplayPass.active = null
	if ParseProfile.enabled and _initial_load_done:
		print(ParseProfile.report("after the entry"))
	SoundTable.set_listener(null)
	WindowTitle.apply_default()
	# Round 747: the far crowd's instances go with the world, and its hooks.
	if _crowd_gpu != null:
		_crowd_gpu.release_all()
		_crowd_gpu = null
	if CharacterLight.on_changed == _crowd_light_changed:
		CharacterLight.on_changed = Callable()
	if CharacterLight.on_value == _crowd_ghost_light:
		CharacterLight.on_value = Callable()
	if CharacterBlobs.on_cast == _crowd_wake_node:
		CharacterBlobs.on_cast = Callable()
	if EquipFx.far_frame == _crowd_item_frame:
		EquipFx.far_frame = Callable()
		EquipFx.far_origin = Callable()
	if EquipFx.ghost_frame == _crowd_ghost_item_frame:
		EquipFx.ghost_frame = Callable()
		EquipFx.ghost_origin = Callable()
	if EquipFx.ghost_gpu == _crowd_gpu_now:
		EquipFx.ghost_gpu = Callable()
	# Round 764's review, F6: the ghosts' hosts and the batches go with the
	# world (a world entered again starts over).
	# Round 767: a title backdrop claimed neither (see _ready), so it resets
	# nothing a world in the same viewport owns.
	var fx_vp := get_viewport()
	if not title_mode and fx_vp != null and fx_vp.has_meta(EquipFx.DRIVER_META):
		var fx_d = fx_vp.get_meta(EquipFx.DRIVER_META)
		if is_instance_valid(fx_d):
			(fx_d as EquipFx).reset_world()
	if not title_mode and EquipFx.batch_viewport == fx_vp:
		EquipFx.batch_viewport = null
	# Round 746 (the review's finding 5, and round 746's review, finding 9): a
	# world leaving before it asked for its item, character and skill tables
	# leaves no worker running behind it.
	ItemTableReader.wait_pending()
	CharTables.wait_pending()
	SkillAudio.wait_pending()
	SkillEffects.wait_pending()
	# Round 732's static lambda (MagicOptionTable.shared_text, made in this
	# node's script) aborted every quit -- "corrupted size vs. prev_size in
	# fastbins", rc 134 -- when Godot 4.2.2 freed it after the script at exit
	# (round 735's review: reproduced in a minimal project 3/3; clearing the
	# static before quit exits 0). Cleared here, with the table, so a later
	# world entry reloads both.
	MagicOptionTable.shared_text = Callable()
	MagicOptionTable.shared = null
	# The screens after the world (character select, login) show the
	# default cursor, as retail's do (round 697).
	if not title_mode:
		GameCursor.show(CursorSet.ID_NORMAL, get_window())
		if _cursor_classify_count > 0:
			print("CURSOR: %d hover classification(s), %.1f us each on average" % [
				_cursor_classify_count, float(_cursor_classify_usec) / _cursor_classify_count])
	# The skilleffect.txt parse (_preload_skill_effect_table) is not left
	# running behind a world that is gone.
	if _skill_table_task >= 0:
		PoolWait.task(_skill_table_task)
		_skill_table_task = -1
	# Nor the characterdata name-key index (_preload_name_key_index).
	if _name_key_task >= 0:
		PoolWait.task(_name_key_task)
		_name_key_task = -1
	# Nor the other players' template tasks (round 748): what they made is
	# freed, not adopted.
	if _appearance != null:
		_appearance.wait_prepared(false)
	# Nor a landing-height helper (round 757's review, F3).
	HeightBatch.reap_all()
	EfpSimBatch.reap_all()
	# Every live skill effect and aura goes with the world, and the bodies
	# SkillEffects remembers are forgotten (a relog builds a new World3D).
	SkillEffects.clear_live()
	# Round 809: the cast objects' templates (and any assembly still out).
	BsrEffect.reset()
	BsrEffect.archive = null
	# Round 786: a zone change left mid-way (the world freed during its
	# load) must not hold the next world's effects.
	EfpEffect.pause_world(false)
	EfpEffect.gate_ticks(false)
	# Round 838: the auras' models (AuraModel) and any preparation still out.
	AuraModel.reset()
	BerserkLook.clear()
	StateLook.clear()
	# Round 859: the kill orbs in flight.
	_exp_orbs.clear()
	_orb_pending.clear()
	_orb_death_passed.clear()
	_orb_cos_of.clear()
	for m in _war_marks.values():
		if is_instance_valid(m):
			(m as AuraModel).release()
	_war_marks.clear()
	_war_mark_row = {}
	AuraModel.star_height_of = Callable()
	if _hud_player_info != null:
		_hud_player_info.hwan_gauge.reset()
	_fx_owner_buffs.clear()
	# Round 796: the statics round 795 bound to this world (_cos_bind_table,
	# _hud_cos_setup) let go now. They are lambdas over this node and its
	# script; left set, the script's static teardown at exit released them
	# after both were freed, and the heap was corrupted (MEASURED: every
	# round-795 run aborted at exit with "corrupted size vs. prev_size in
	# fastbins", the perf gate's 794 base runs never).
	ItemInstance.types_of = Callable()
	ItemInstance.cos_kind_of = Callable()
	ItemTooltipLines.cos_row_of = Callable()
	ItemTooltipLines.cos_row_by_code = Callable()
	EfpEffect.mounts.clear()
	var exit_music := _audio_music()
	if exit_music != null:
		exit_music.leave_world()
	# A task still preparing a cell holds this node's static function and a
	# job for its grid: waited for and dropped before anything here is freed
	# (round 565), so a reconnect cannot commit into a freed world.
	_drop_cell_jobs("the world left the tree")
	# How this entry ended and its textures' GL names, for the next entry's
	# /groundprobe (round 579) -- before the caches below are cleared.
	if not title_mode:
		GroundProbe.record_exit(self, NetClient.is_connected_to_server())
	var scenery_freed := 0
	if _object_templates != null:
		scenery_freed = _object_templates.free_all()
	_object_textures.clear()
	var npc_freed := 0
	for template in _npc_model_cache.values():
		var character := template as SkinnedBsrAssembler.AssembledCharacter
		if character != null and is_instance_valid(character.skeleton):
			character.skeleton.free()
			npc_freed += 1
	_npc_model_cache.clear()
	# The monster species templates (round 655), never parented either.
	npc_freed += _monster_templates.free_all()
	_ground_texture_cache.clear()
	_water_frames_cache.clear()
	_water_frames_load_attempted = false
	_water_still_texture = null
	_water_still_load_attempted = false
	_water_material = null
	_water_reflect_material = null
	_water_reflect_still_material = null
	_water_bump_texture = null
	_water_bump_attempted = false
	_water_still_material = null
	_env_water_color = Color(1, 1, 1)
	_water_env_id = -1
	_environment_table = null
	_environment_load_attempted = false
	_env_record = null
	_env_record_id = -1
	_day_cycle = DayCycle.new()
	_day_pushed.clear()
	if _loading_screen != null:
		_loading_screen.queue_free()
		_loading_screen = null
	var viewport := get_viewport()
	if viewport != null:
		viewport.debug_draw = Viewport.DEBUG_DRAW_DISABLED
	print(_load_timings.summary())
	print("World3D: left the tree -- %d scenery templates and %d NPC and monster templates freed" % [scenery_freed, npc_freed])

## Registers an assembled character for idle animation, if it has one.
##
## **Enabled by default since real skinning landed.** This was off for one
## round, because animating a rigidly-attached model tore it apart: with
## every mesh piece bound to a single bone, rotating that bone swung a whole
## dress or torso, and a measured pair of renders showed the same NPC as a
## stretched spike with animation on and correct with it off.
##
## The cause was not animation. `.bms` carries real per-vertex skinning --
## a bone palette and two weighted influences per vertex, in its own section
## rather than in the vertex record -- and reading it makes these models
## deform properly. The same NPC in the same spot now stands in a red dress
## holding a fan, animated.
##
## `OPENSRO_NO_IDLE_ANIM=1` turns it off again, which is how that A/B was
## run and how the next one can be.
func _animate(assembled: SkinnedBsrAssembler.AssembledCharacter) -> void:
	if assembled == null:
		return
	_animate_skeleton(assembled.skeleton, assembled.idle_animation)
	# Round 808: its idle fidget (_step_body_fidgets).
	if assembled.skeleton != null:
		var archive := _data_pk2
		assembled.skeleton.set_meta(FIDGET_META, [assembled.idle_animation,
			func(t: int) -> BanReader.ParsedAnimation: return SkinnedBsrAssembler.animation_for(archive, assembled, t)])

## Registers a skeleton to play `anim` as its looping idle. Split from
## _animate so a duplicated NPC body (which is not the cached template's own
## skeleton) can be registered with the template's animation.
func _animate_skeleton(skeleton: Skeleton3D, anim: BanReader.ParsedAnimation) -> void:
	if skeleton == null or anim == null:
		return
	if OS.get_environment("OPENSRO_NO_IDLE_ANIM") != "":
		return
	var frames := _frame_count(anim)
	if frames <= 1:
		return
	_animated.append([skeleton, anim, frames, float(_animated.size()) * 0.37, true, _idle_anim_time, null])

static func _frame_count(anim: BanReader.ParsedAnimation) -> int:
	var frames := 0
	if anim == null:
		return 0
	for track in anim.bones:
		frames = maxi(frames, track.keyframes.size())
	return frames

## Plays anim once on skeleton -- a hit reaction, a death -- in place of
## whatever it was playing, and afterwards returns to that (or holds the
## last frame if `hold` is set, which a death does). Returns how long the
## one-shot runs, in seconds, so a caller can wait for it.
func _play_once(skeleton: Skeleton3D, anim: BanReader.ParsedAnimation, hold: bool = false) -> float:
	var frames := _frame_count(anim)
	if skeleton == null or frames <= 1:
		return 0.0
	# A far body plays its one-shot on the full path (round 747, CrowdGpu
	# draws loops only): back now, posed where its loop is.
	_crowd_wake(skeleton)
	# Round 808: a one-shot at full weight hides every loop under it (the
	# mix, ClipMixer), so a change still fading is over.
	_pose_fades.erase(skeleton.get_instance_id())
	var resume = null
	# Round 785: EVERY entry the skeleton has goes, not the first found. A
	# skeleton left with a second entry (MEASURED on the box: a monster's
	# stand loop beside its hit one-shot) had the clip tick advance both each
	# frame, so AnimSounds saw the one-shot "start" every frame and fired its
	# key at 0 again and again -- a struck monster's voc_moan 20 times in a
	# second -- and the two clips fought over the pose.
	var found := 0
	var i := 0
	while i < _animated.size():
		var entry: Array = _animated[i]
		if entry[0] == skeleton:
			found += 1
			# Resume the idle it was on, not a one-shot it was in the
			# middle of.
			if resume == null:
				resume = entry if entry[4] else entry[6]
			_animated.remove_at(i)
			continue
		i += 1
	if found > 1 and _combat_trace:
		print("COMBAT a skeleton had %d clip entries when a one-shot started -- all replaced" % found)
	# entry[7] marks the hold itself (round 534): a one-shot with no resume is
	# not necessarily a death -- a body whose idle was never registered (a
	# clip of one frame, OPENSRO_NO_IDLE_ANIM) has nothing to resume after a
	# hit either -- and MonsterMotion.swap_loop must tell the two apart.
	_animated.append([skeleton, anim, frames, 0.0, false, _idle_anim_time, null if hold else resume, hold])
	return anim.duration_seconds()

## Advances every idle animation. Entries whose skeleton has gone (a region
## streamed out, a monster died) are dropped as they are found, which keeps
## this from holding freed nodes alive.
##
## Round 655: a monster's or NPC's clip (MonsterDraw.META_CULL) is posed only
## while its body is in MonsterDraw.POSE_RANGE of the camera and touches the
## view frustum (MonsterDraw.pose_wanted); out of range its clip's sounds stop
## too, and a monster's model (MonsterDraw.META_HIDE) is hidden. The clock
## runs on regardless, so a body coming into view is posed
## where its clip has got to, and a one-shot still hands back to its loop on
## time. Another player is posed only while in view (round 738, CrowdAnim).
## The player and the character window's doll are not culled.
func _tick_idle_animations(delta: float) -> void:
	if _animated.is_empty() and (_crowd_gpu == null or _crowd_gpu.body_count() == 0):
		return
	# QA only (round 747, QaCrowdProbe's `ab` step): the clip clock held, so
	# two frames drawn two ways show the same poses.
	if not _qa_anim_hold:
		_idle_anim_time += delta
	if _animated.is_empty():
		return
	var cam := get_viewport().get_camera_3d() if is_inside_tree() and get_viewport() != null else null
	var eye: Vector3 = cam.global_position if cam != null else Vector3.ZERO
	var planes: Array = cam.get_frustum() if cam != null else []
	# The sound listener (AudioService: the player), for the hearing gate.
	var listener: Vector3 = player.global_position if player != null and player.is_inside_tree() else eye
	# Round 664: the range and frustum tests below are MonsterDraw.pose_wanted's
	# and in_range's, written out (the six planes unrolled) and fed from a
	# per-skeleton cache of its metas (MonsterCrowd.CullCache) -- the same
	# answers without three meta reads and three script calls a body, since
	# the loop visits every body every frame (monster_crowd_test holds the
	# two to the same verdicts).
	var have_planes := planes.size() == 6
	var p0: Plane = planes[0] if have_planes else Plane()
	var p1: Plane = planes[1] if have_planes else Plane()
	var p2: Plane = planes[2] if have_planes else Plane()
	var p3: Plane = planes[3] if have_planes else Plane()
	var p4: Plane = planes[4] if have_planes else Plane()
	var p5: Plane = planes[5] if have_planes else Plane()
	var pose_range := MonsterDraw.POSE_RANGE
	_crowd_cull.tick()
	var pose_tick := _crowd_cull.ticks()
	_step_other_stances()
	if not _gait_drops.is_empty():
		_step_gait_drops()
	_step_body_fidgets(delta)
	# Round 808: changes on bodies no longer posed (culled, freed) are
	# dropped once over.
	if pose_tick % 120 == 0 and not _pose_fades.is_empty():
		for fid in _pose_fades.keys():
			if (_pose_fades[fid] as ClipMixer.Fade).done(_idle_anim_time):
				_pose_fades.erase(fid)
	var cull_ids: Dictionary = _crowd_cull.by_id()
	var lod_skipped := 0
	# The characters in the tick, for the players' animation LOD (round 738,
	# CrowdAnim.CROWD_MIN).
	var crowd_count := _animated_total()
	var posed := 0
	var timing := _qa_split != null
	var t0 := 0
	var culled := 0
	var alive: Array = []
	# Round 785: a one-shot handed back to its loop swaps one entry for
	# another, which leaves the count as it was -- and the count alone used to
	# decide whether the tick kept its new list. The ended one-shot then stayed
	# in the list, "ended" again every frame: its sounds fired every frame (a
	# struck monster's voc_moan, a monster's swing: MEASURED 20-60 a second on
	# the box and in the user's log, "+59 since the last line") while it was
	# posed in its loop.
	var handed_back := false
	for entry in _animated:
		# A zone change frees every region's skeletons while their entries
		# are still listed here, and Godot raises "Trying to assign invalid
		# previously freed instance" on the TYPED assignment itself, before
		# any check can run -- 125 error lines per zone change (round 214).
		# So test the raw Variant first and type it after.
		if not is_instance_valid(entry[0]):
			continue
		var skeleton: Skeleton3D = entry[0]
		if not skeleton.is_inside_tree():
			continue
		var pose := true
		var audible := true
		var info: Array = MonsterCrowd.CullCache.NONE
		if cam != null:
			var cached = cull_ids.get(skeleton.get_instance_id())
			info = cached if cached != null else _crowd_cull.info(skeleton)
		if info.size() == CrowdAnim.PLAYER_INFO_SIZE:
			# Another player (round 738, CrowdAnim): posed only while its
			# sphere is in view (A1, READ: the original poses a character only
			# if it was drawn), and far ones in a crowd every second or fourth
			# frame (A4, OURS). Its clock and its sounds run on.
			# Character Sight Range (round 738's review, F6): a body whose whole
			# sphere is past the range draws nothing, so it is not posed either.
			if CrowdAnim.cull_players and have_planes:
				var at := skeleton.global_position
				var r: float = info[0]
				pose = p0.distance_to(at) <= r and p1.distance_to(at) <= r and p2.distance_to(at) <= r \
					and p3.distance_to(at) <= r and p4.distance_to(at) <= r and p5.distance_to(at) <= r \
					and (_character_range <= 0.0 or at.distance_to(eye) - r <= _character_range)
			# A body's first tick, and its first tick back in view, is never
			# skipped by the LOD (round 738's review, F2): info[4] is "never posed",
			# info[2] "in view at the last tick" (MonsterCrowd.CullCache.info).
			var seen := pose
			if info[4] > 0.0:
				pose = true
				info[4] = 0.0
			elif pose and info[2] > 0.0 and CrowdAnim.lod_players and crowd_count >= CrowdAnim.CROWD_MIN \
					and not MonsterCrowd.pose_due(pose_tick, int(info[3]), CrowdAnim.pose_interval(skeleton.global_position.distance_to(eye), crowd_count)):
				pose = false
				lod_skipped += 1
			info[2] = 1.0 if seen else 0.0
			# Its clip sounds only within the core's cull of the listener
			# (round 739, B3: READ 600, the monsters' rule below), rested once
			# as they go. info[1] is the player entry's own "out of hearing at
			# the last tick" (its review's F1; info[2] is A1's "in view").
			audible = skeleton.global_position.distance_squared_to(listener) <= SoundTable.CULL_DISTANCE_SQ
			if audible != (info[1] == 0.0):
				info[1] = 0.0 if audible else 1.0
				if not audible:
					_anim_sounds.rest(skeleton)
		elif not info.is_empty():
			# A looping body that was neither in view nor in hearing at its
			# last test is tested every second frame, on its slot (round 664,
			# MonsterCrowd.recheck_due; OURS): one coming into view is posed at
			# most a frame late.
			if info[4] > 0.0 and entry[4] and not MonsterCrowd.recheck_due(pose_tick, int(info[3])):
				culled += 1
				alive.append(entry)
				continue
			var origin := skeleton.global_position
			var radius: float = info[0]
			var dist := origin.distance_to(eye)
			var in_range := dist - radius < pose_range
			pose = in_range
			if in_range and have_planes:
				pose = p0.distance_to(origin) <= radius and p1.distance_to(origin) <= radius \
					and p2.distance_to(origin) <= radius and p3.distance_to(origin) <= radius \
					and p4.distance_to(origin) <= radius and p5.distance_to(origin) <= radius
			elif in_range:
				pose = MonsterDraw.pose_wanted(origin, radius, eye, planes)
			# A monster's model out of range is hidden, as MapAnimation hides a
			# map object (round 655's review; OURS): unposed, a walking body
			# would slide without its gait.
			if info[1] > 0.0 and skeleton.visible != in_range:
				skeleton.visible = in_range
			# Its clip's sounds only within the core's cull of the listener
			# (round 664, MonsterCrowd.hearable: READ, 600 units): farther, no
			# key it fires could play. Rested once as it goes, it resumes
			# silently.
			audible = in_range and origin.distance_squared_to(listener) <= SoundTable.CULL_DISTANCE_SQ
			if audible != (info[2] == 0.0):
				info[2] = 0.0 if audible else 1.0
				if not audible:
					_anim_sounds.rest(skeleton)
			# Far bodies posed every second or fourth frame (round 664,
			# MonsterCrowd.pose_interval; OURS): within 300 of the camera,
			# every frame as before.
			info[4] = 0.0 if pose or audible else 1.0
			if pose and not MonsterCrowd.pose_due(pose_tick, int(info[3]), MonsterCrowd.pose_interval(dist)):
				pose = false
				lod_skipped += 1
		if _qa_split != null:
			if pose and _qa_split_off.has("pose"):
				pose = false
			if audible and _qa_split_off.has("sound"):
				audible = false
		if pose:
			posed += 1
		else:
			culled += 1
			# A loop neither posed nor heard this frame has nothing more to do
			# (round 664): only a one-shot's hand-back runs unseen.
			if not audible and entry[4]:
				alive.append(entry)
				continue
		var anim: BanReader.ParsedAnimation = entry[1]
		var phase: float = entry[3]
		var loops: bool = entry[4]
		if loops:
			if pose:
				if timing: t0 = Time.get_ticks_usec()
				MonsterCrowd.pose_at(skeleton, anim, _idle_anim_time + phase, true)
				if not _pose_fades.is_empty():
					_blend_pose_fade(skeleton, eye)
				if not _monster_rides.is_empty():
					_pose_ride(skeleton, anim, _idle_anim_time + phase, true, audible)
				if timing: _qa_split.pose_usec += Time.get_ticks_usec() - t0
			if audible:
				if timing: t0 = Time.get_ticks_usec()
				_anim_sounds.advance(skeleton, anim, float(entry[5]), _loop_ms(anim, _idle_anim_time + phase), true)
				if timing: _qa_split.sound_usec += Time.get_ticks_usec() - t0
		else:
			# A one-shot runs from when it started, on the clip's own clock,
			# and holds its last keyframe; once there, hand back to what it
			# interrupted.
			var elapsed := _idle_anim_time - float(entry[5])
			# A decoration's WAIT hold repeats its clip (round 785, entry[8]).
			if entry.size() > 8 and entry[8] == true and anim.duration_seconds() > 0.0 \
					and elapsed >= anim.duration_seconds():
				entry[5] = float(entry[5]) + floorf(elapsed / anim.duration_seconds()) * anim.duration_seconds()
				elapsed = _idle_anim_time - float(entry[5])
			if elapsed >= anim.duration_seconds() and entry[6] != null:
				# Its last tracks first: the frame that ends it is the frame
				# that would pass them.
				if audible:
					if timing: t0 = Time.get_ticks_usec()
					_anim_sounds.advance(skeleton, anim, float(entry[5]), float(anim.duration_ms), false)
					if timing: _qa_split.sound_usec += Time.get_ticks_usec() - t0
				var resume: Array = entry[6]
				handed_back = true
				resume[5] = _idle_anim_time
				alive.append(resume)
				# Round 808: the one-shot holds its last frame and fades into
				# the loop over 200 ms (CRTAniOneShot, READ; ClipMixer).
				var back := ClipMixer.Fade.new()
				back.from = anim
				back.from_loop = false
				back.from_ms = float(anim.duration_ms)
				back.at = _idle_anim_time
				back.in_ms = 0.0
				back.out_ms = ClipMixer.SHOT_OUT_MS
				_pose_fades[skeleton.get_instance_id()] = back
				if pose:
					if timing: t0 = Time.get_ticks_usec()
					MonsterCrowd.pose_at(skeleton, resume[1], _idle_anim_time + float(resume[3]), true)
					_blend_pose_fade(skeleton, eye)
					if not _monster_rides.is_empty():
						_pose_ride(skeleton, resume[1], _idle_anim_time + float(resume[3]), true, audible)
					if timing: _qa_split.pose_usec += Time.get_ticks_usec() - t0
				if audible:
					if timing: t0 = Time.get_ticks_usec()
					_anim_sounds.advance(skeleton, resume[1], float(resume[5]),
						_loop_ms(resume[1], _idle_anim_time + float(resume[3])), true)
					if timing: _qa_split.sound_usec += Time.get_ticks_usec() - t0
				continue
			if pose:
				if timing: t0 = Time.get_ticks_usec()
				MonsterCrowd.pose_at(skeleton, anim, elapsed, false)
				if not _monster_rides.is_empty():
					_pose_ride(skeleton, anim, elapsed, false, audible)
				if timing: _qa_split.pose_usec += Time.get_ticks_usec() - t0
			if audible:
				if timing: t0 = Time.get_ticks_usec()
				_anim_sounds.advance(skeleton, anim, float(entry[5]), elapsed * 1000.0, false)
				if timing: _qa_split.sound_usec += Time.get_ticks_usec() - t0
		alive.append(entry)
	if handed_back or alive.size() != _animated.size():
		_animated = alive
		_rehint_other_loops()
	_anim_posed_last = posed
	_anim_culled_last = culled
	_anim_lod_skipped_last = lod_skipped

## How many clips the last _tick_idle_animations posed and culled (round
## 655), for the QA ANIM line and the test.
var _anim_posed_last := 0
var _anim_culled_last := 0
## Of the culled, how many were in view but skipped by the animation LOD
## this frame (round 664, MonsterCrowd.pose_interval).
var _anim_lod_skipped_last := 0

## Where a loop posed at `seconds` is in its clip, in milliseconds -- the
## wrap apply_ban_pose_at makes for a looping clip.
static func _loop_ms(anim: BanReader.ParsedAnimation, seconds: float) -> float:
	if anim == null or anim.duration_ms <= 0:
		return 0.0
	return fposmod(seconds * 1000.0, float(anim.duration_ms))

var _idle_anim_time := 0.0
## QA only (round 747): the clip clock held (QaCrowdProbe's `ab` step).
var _qa_anim_hold := false
## Round 664: the clip tick runs once per rendered frame (MonsterCrowd.TickGate),
## and reads each culled skeleton's metas from one cache (MonsterCrowd.CullCache).
var _idle_tick_gate := MonsterCrowd.TickGate.new()
var _crowd_cull := MonsterCrowd.CullCache.new()

## Round 747 (crowd scale A5, CrowdGpu; docs/protocol/crowd_gpu.md): far
## other players drawn as GPU instances. Every RESELECT_FRAMES frames the
## CrowdGpu.near_count bodies nearest the camera, in view or not (and every body that
## needs its skeleton: a one-shot, berserk, an aura, Detail's shadow, a fade)
## stay on the full path; every other dressed body is drawn by `_crowd_gpu`:
## its skeleton hidden and unposed, its clip entry out of _animated (so the
## clip tick never visits it), its parts instances of shared MultiMeshes posed
## by the vertex shader. The decision is a scan spread over the cycle; the
## switches to the GPU at most CrowdGpu.SWITCH_BUDGET a frame. A body comes
## back at once when something needs it (_crowd_wake), posed where its clip
## is, so it draws the same frame.
var _crowd_gpu: CrowdGpu = null
## This cycle's scan: the character ids, how far it has got, and per scanned
## body (round 757: parallel packed arrays, not a Dictionary of Arrays, so the
## cycle's choice is one cheap pass) its id, distance from the camera, flags
## (CROWD_GOT_*), skeleton; and the far bodies' bounds.
var _crowd_scan: Array = []
var _crowd_scan_at := 0
var _crowd_got_ids := PackedInt64Array()
var _crowd_got_dist := PackedFloat32Array()
## Round 762 (OURS): a ghost is dressed only among the DRESS_NEAREST bodies
## nearest the player (the squared distance of the last of them, from the
## near/far cycle's scan; INF when the crowd is smaller). A ghost draws what
## its dressed far body would (round 756's parity: 293 kits, 0 mismatched);
## what it lacks is its weapon's particles, which EquipFx shows on the
## VISIBLE_BUDGET (64) nearest weapons, the near set (CrowdGpu.near_count x
## NEAR_HYSTERESIS: 20) and Detail's ten casters -- all among the nearest.
## Before, every ghost was dressed in the background, one or more a frame at
## 10 ms each for the swarm's kits (MEASURED r762.md): 4,000 of them were
## minutes of frames over a standing crowd's own, and 4,000 skeletons.
const DRESS_NEAREST := 96
var _dress_within_sq := INF
var _crowd_all_d2 := PackedFloat32Array()
var _crowd_got_flags := PackedByteArray()
var _crowd_got_skels: Array = []
var _crowd_far_lo := Vector3.INF
var _crowd_far_hi := -Vector3.INF
const CROWD_GOT_ELIGIBLE := 1
const CROWD_GOT_SEEN := 2
const CROWD_GOT_FAR := 4
## This cycle's bodies that must stay near, by reason (QA: CrowdGpu.describe).
var _crowd_why := {}
var _crowd_cycle_frame := 0
var _crowd_frame := 0
## Bodies chosen for the GPU and not switched yet (the budget).
var _crowd_pending: Array = []
## Meta on a body skeleton: the Callable its tree_exiting runs (_crowd_on_exit).
const CROWD_EXIT_META := &"opensro_crowd_exit"

## Round 762: the Figures whose body templates are made once the world has
## entered, and the call that starts them with the far twins' shaders.
var _prewarm_figures: Array = []
var _prewarmed_after_entry := false

func _prewarm_after_entry() -> void:
	if _prewarmed_after_entry:
		return
	_prewarmed_after_entry = true
	# Round 805: the NPC thieves' and hunters' rows, read on a worker.
	_job_mob_tables_start()
	# The far twins' shaders one a frame (_prewarm_step), the bodies on the worker.
	_prewarm_shaders = CrowdGpu.known_shaders() if CrowdGpu.enabled and _ghosts_on else []
	if _appearance != null and not _prewarm_figures.is_empty():
		var asked := _appearance.prewarm_bodies(_prewarm_figures)
		if asked > 0:
			print("World3D: %d player bod(ies) prewarmed in the background" % asked)

## Round 762: the known shaders' far twins still to make (_prewarm_after_entry),
## one a frame.
var _prewarm_shaders: Array = []
var _prewarm_usec := 0

func _prewarm_step() -> void:
	if _prewarm_shaders.is_empty():
		return
	var cg := _crowd_gpu_get()
	if cg == null:
		_prewarm_shaders.clear()
		return
	var t0 := Time.get_ticks_usec()
	cg.prewarm_one(_prewarm_shaders)
	_prewarm_usec += Time.get_ticks_usec() - t0
	if _prewarm_shaders.is_empty():
		print("World3D: the far crowd's twin shaders made after the entry, %.1f ms over the frames (%d shaders)" % [_prewarm_usec / 1000.0,
			int(cg.stats.get("prewarmed_shaders", 0))])

func _crowd_gpu_get() -> CrowdGpu:
	if _crowd_gpu == null and is_inside_tree() and get_world_3d() != null:
		_crowd_gpu = CrowdGpu.new(get_world_3d().scenario)
		_crowd_gpu.set_range(_character_range)
	return _crowd_gpu

## Whether another player's body could be drawn far now: dressed, in the
## tree, seen by the clip tick's cull cache (so posed from A3's frames), and
## needing nothing the instances do not draw.
## Returns "" when it can, else why not (counted for the QA line).
func _crowd_eligible(character_id: int, node: Node3D, skel: Skeleton3D) -> String:
	if not is_instance_valid(skel) or not skel.is_inside_tree() or not node.is_inside_tree():
		return "tree"
	if not skel.has_meta(CrowdAnim.META_CACHED) or _other_build_args.has(character_id):
		return "dressing"
	if _appear_fades.fading(node) or _appear_fades.fading_out(node):
		return "fade"
	if BerserkLook.active(node):
		return "berserk"
	# Round 855: a body drawing a pulse colour draws it from its own copies,
	# which the far instances would hold on to after the pulse ends.
	if BodyPulse.on(node):
		return "pulse"
	# Detail's ten casters (round 739, B2) cast from their meshes.
	if bool(node.get_meta(CharacterBlobs.META_DETAIL, false)):
		return "detail"
	# An effect on the body follows a bone of the posed skeleton
	# (EfpEffect.follow_host; crowd_gpu.md section 3). Round 757: a dressed
	# body holds its skeleton, its plate and its click body; only a body with
	# more is looked through (get_children() builds an Array a call, and this
	# runs for every body each cycle).
	if node.get_child_count() > 3:
		for c in node.get_children():
			if c is EfpEffect:
				return "effect"
	return ""

## Once a rendered frame, after the others have moved (_process): a slice of
## the near/far scan, the cycle's choice, the switches due, and CrowdGpu's
## flush (its clock, the moved bodies, the baking, the uploads).
func _crowd_gpu_step() -> void:
	var on := CrowdGpu.enabled and CrowdAnim.cache_poses
	if not on:
		if _crowd_gpu != null and _crowd_gpu.body_count() > 0:
			for skel in _crowd_gpu.skeletons():
				_crowd_wake(skel, false)
			# Round 756: ghosts have no full path to go back to. Off the
			# instances, and left to the dressing at its 90 ms aim (review F8:
			# dressing them all here froze the frame for seconds at 3000).
			for g in _crowd_gpu.ghosts():
				_crowd_gpu.remove(g, false)
				var gid := int((g as Node).get_meta("character_id", -1))
				_ghost_ids.erase(gid)
				_ghost_refused[gid] = true
			_crowd_gpu.flush(_idle_anim_time)
		return
	# Round 762: and while arrivals wait to be ghosts -- their clips bake in
	# the flush, and with a page held nobody is dressed meanwhile.
	if _other_gaits.is_empty() and (_crowd_gpu == null or _crowd_gpu.body_count() == 0) and _other_ghosts.is_empty():
		return
	var crowd := _crowd_gpu_get()
	var cam := get_viewport().get_camera_3d() if get_viewport() != null else null
	if crowd == null or cam == null:
		return
	_crowd_frame += 1
	if _crowd_scan.is_empty() and _crowd_scan_at == 0:
		_crowd_scan = _other_gaits.keys()
		# Round 756: the ghosts too, for their hearing (and, round 757's merge,
		# S3: for the far bounds).
		_crowd_scan.append_array(_ghost_ids.keys())
		_crowd_got_ids.clear()
		_crowd_got_dist.clear()
		_crowd_got_flags.clear()
		_crowd_got_skels.clear()
		_crowd_all_d2.clear()
		_crowd_far_lo = Vector3.INF
		_crowd_far_hi = -Vector3.INF
		_crowd_cycle_frame = _crowd_frame
	var fs := FrameSplit.on
	var gt := Time.get_ticks_usec() if fs else 0
	var eye := cam.global_position
	var listener := _crowd_listener()
	var planes: Array = cam.get_frustum()
	# Round 757 (OURS): at most CrowdGpu.SCAN_PER_FRAME_MAX bodies a frame, so
	# a very large crowd's cycle runs longer than RESELECT_FRAMES instead of
	# scanning more a frame (MEASURED at 7,000: 700 bodies a frame, 4.4 ms).
	var per := mini(ceili(float(_crowd_scan.size()) / float(CrowdGpu.RESELECT_FRAMES)), CrowdGpu.SCAN_PER_FRAME_MAX)
	var end := mini(_crowd_scan_at + per, _crowd_scan.size())
	while _crowd_scan_at < end:
		var id: int = int(_crowd_scan[_crowd_scan_at])
		_crowd_scan_at += 1
		var node = _other_bodies.get(id)
		var gait: Dictionary = _other_gaits.get(id, {})
		# Round 762: every body's distance from the player, for the dressing's
		# reach (_dress_within).
		if node != null and is_instance_valid(node) and player != null:
			_crowd_all_d2.append((node as Node3D).global_position.distance_squared_to(player.global_position))
		if gait.is_empty() and _ghost_ids.has(id) and node != null and is_instance_valid(node):
			# A ghost's hearing (round 756), by the far bodies' rule below.
			var gb := crowd.body_of(node)
			if gb != null:
				var gat := (node as Node3D).global_position
				var gheard := gat.distance_squared_to(listener) <= SoundTable.CULL_DISTANCE_SQ
				if gheard != gb.heard:
					crowd.set_heard(gb, gheard)
					gb.sound_due = -INF if gheard else INF
					# Round 757's merge, S1: filed on the sound wheel.
					_sound_schedule(gb)
					if not gheard:
						_anim_sounds.rest(node)
				# S3: inside the cycle's far bounds, as a dressed far body is.
				_crowd_far_lo = Vector3(minf(_crowd_far_lo.x, gat.x), minf(_crowd_far_lo.y, gat.y), minf(_crowd_far_lo.z, gat.z))
				_crowd_far_hi = Vector3(maxf(_crowd_far_hi.x, gat.x), maxf(_crowd_far_hi.y, gat.y), maxf(_crowd_far_hi.z, gat.z))
			continue
		if node == null or not is_instance_valid(node) or gait.is_empty() or not is_instance_valid(gait.get("skeleton")):
			continue
		var skel: Skeleton3D = gait["skeleton"]
		var at := (node as Node3D).global_position
		# In view: counted for the QA line only (the choice is by distance, in
		# view or not), so measured only while the probe's split runs (round 757).
		# (The cull cache's entry is made here too: CrowdAnim.META_CACHED, which
		# _crowd_eligible asks for.)
		var info: Array = _crowd_cull.info(skel)
		var seen := fs and planes.size() == 6
		if seen:
			var r: float = info[0] if info.size() == CrowdAnim.PLAYER_INFO_SIZE else 20.0
			for p in planes:
				if (p as Plane).distance_to(at) > r:
					seen = false
					break
		var why := _crowd_eligible(id, node, skel)
		if why != "":
			_crowd_why[why] = int(_crowd_why.get(why, 0)) + 1
		# A far body's hearing (F2): the READ 600 of the listener, as the
		# tick's rule for a near one; rested as it leaves, advanced at once
		# as it comes back (it carries on from there, silently, as any body
		# back in hearing does).
		var fb := crowd.body_of(skel)
		if fb != null:
			var heard := at.distance_squared_to(listener) <= SoundTable.CULL_DISTANCE_SQ
			if heard != fb.heard:
				crowd.set_heard(fb, heard)
				var cinfo: Array = _crowd_cull.info(skel)
				if cinfo.size() == CrowdAnim.PLAYER_INFO_SIZE:
					cinfo[1] = 0.0 if heard else 1.0
				if heard:
					fb.sound_due = -INF
					_sound_schedule(fb)
				else:
					fb.sound_due = INF
					_anim_sounds.rest(skel)
		var far := fb != null
		if far:
			_crowd_far_lo = Vector3(minf(_crowd_far_lo.x, at.x), minf(_crowd_far_lo.y, at.y), minf(_crowd_far_lo.z, at.z))
			_crowd_far_hi = Vector3(maxf(_crowd_far_hi.x, at.x), maxf(_crowd_far_hi.y, at.y), maxf(_crowd_far_hi.z, at.z))
		_crowd_got_ids.append(id)
		_crowd_got_dist.append(eye.distance_to(at))
		_crowd_got_flags.append((CROWD_GOT_ELIGIBLE if why == "" else 0) | (CROWD_GOT_SEEN if seen else 0) | (CROWD_GOT_FAR if far else 0))
		_crowd_got_skels.append(skel)
	if fs:
		gt = _fs_lap("g_scan", gt)
	if _crowd_frame - _crowd_cycle_frame >= CrowdGpu.RESELECT_FRAMES - 1 and _crowd_scan_at >= _crowd_scan.size():
		crowd.ineligible = _crowd_why
		_crowd_why = {}
		_crowd_choose()
		_crowd_scan = []
		_crowd_scan_at = 0
	if fs:
		gt = _fs_lap("g_choose", gt)
	_crowd_switch_due()
	if fs:
		gt = _fs_lap("g_switch", gt)
	crowd.flush(_idle_anim_time)
	if fs:
		gt = _fs_lap("g_flush", gt)
	_crowd_sound_step()
	if fs:
		_fs_lap("g_sound", gt)

## Round 757 (QA, FrameSplit): adds the time since `since` under `label` and
## returns now.
static func _fs_lap(label: String, since: int) -> int:
	var now := Time.get_ticks_usec()
	FrameSplit.add(label, now - since)
	return now

## The sound listener (AudioService: the player), as the clip tick's.
func _crowd_listener() -> Vector3:
	if player != null and player.is_inside_tree():
		return player.global_position
	var cam := get_viewport().get_camera_3d() if get_viewport() != null else null
	return cam.global_position if cam != null else Vector3.ZERO

## Round 747's review, F2: the far bodies within hearing play their clip
## sounds, as retail plays every body's within 600 (READ, round 664's rule),
## without being posed. A body is advanced only when its clock passes its
## clip's next sound key (AnimSounds.next_key_ms); a clip with no track for
## it (every sitting loop, most stand sets) never is. So a standing crowd
## costs one compare a body a frame, a running one about two advances a body
## a second.
##
## Round 757: the bodies come due from a timing wheel (_sound_wheel: 0.1 s
## buckets of the clip clock), not from a pass over every heard body each frame
## (MEASURED at 7,000, every body within 600: 3.1 ms a frame for the pass). A
## write of a body's sound_due schedules it (_sound_schedule); a spread
## re-check of SOUND_RESCAN_FRAMES catches a write that did not.
const SOUND_WHEEL_HZ := 10.0
const SOUND_RESCAN_FRAMES := 30
var _sound_wheel := {}
var _sound_wheel_at := -1
var _sound_ring: Array = []
var _sound_ring_at := 0

func _sound_schedule(b: CrowdGpu.Body) -> void:
	if b == null or b.sound_due == INF:
		return
	var k := _sound_wheel_at
	if b.sound_due != -INF:
		k = maxi(int(floor(b.sound_due * SOUND_WHEEL_HZ)), _sound_wheel_at)
	var bucket: Array = _sound_wheel.get(k, [])
	if bucket.is_empty():
		_sound_wheel[k] = bucket
	bucket.append(b)

func _crowd_sound_step() -> void:
	if _qa_split != null and (_qa_split_off.has("sound") or _qa_split_off.has("farsound")):
		return
	var t := _idle_anim_time
	var cur := int(floor(t * SOUND_WHEEL_HZ))
	if _sound_wheel_at < 0 or _sound_wheel_at > cur:
		# First use, or the clock went back (a QA hold): every body filed
		# again from now.
		var all: Array = []
		for k in _sound_wheel:
			all.append_array(_sound_wheel[k])
		_sound_wheel.clear()
		_sound_wheel_at = cur
		for fb in all:
			_sound_schedule(fb)
	var k := _sound_wheel_at
	while k <= cur:
		var bucket: Array = _sound_wheel.get(k, [])
		if not bucket.is_empty():
			_sound_wheel.erase(k)
			var later: Array = []
			for fb in bucket:
				var b: CrowdGpu.Body = fb
				if not _sound_live(b):
					continue
				if b.sound_due > t:
					# Not yet (this bucket is the current one), or moved to a later
					# bucket by another write: kept only if it belongs here.
					if int(floor(b.sound_due * SOUND_WHEEL_HZ)) <= k:
						later.append(b)
					continue
				_crowd_sound_advance(b, t)
			if not later.is_empty():
				var keep: Array = _sound_wheel.get(cur, [])
				keep.append_array(later)
				_sound_wheel[cur] = keep
		k += 1
	_sound_wheel_at = cur
	# The spread re-check.
	if _sound_ring_at >= _sound_ring.size():
		_sound_ring = _crowd_gpu.heard_bodies().duplicate()
		_sound_ring_at = 0
	var per := ceili(float(_sound_ring.size()) / float(SOUND_RESCAN_FRAMES))
	var end := mini(_sound_ring_at + per, _sound_ring.size())
	while _sound_ring_at < end:
		var b: CrowdGpu.Body = _sound_ring[_sound_ring_at]
		_sound_ring_at += 1
		if _sound_live(b) and b.sound_due <= t:
			_crowd_sound_advance(b, t)

## Round 757's review, F1: a body is advanced from the wheel only while it is
## still the far record of its skeleton (a ghost's: its holder, round 756). A body brought near (CrowdGpu.remove,
## which also clears its hearing) or replaced by a later switch's new record is
## stale: its bucket entry is dropped, and the near clip tick alone drives the
## skeleton's sounds -- the stale record advancing its old loop overwrote the
## one-shot's state in AnimSounds and replayed a hit's or a death's keys.
func _sound_live(b: CrowdGpu.Body) -> bool:
	if b == null or not b.heard or b.sound_due == INF or _crowd_gpu == null:
		return false
	var key: Object = b.node if b.ghost else b.skel
	return is_instance_valid(key) and _crowd_gpu.body_of(key) == b

func _crowd_sound_advance(b: CrowdGpu.Body, t: float) -> void:
	# A ghost (round 756) has no skeleton: its sounds are registered on its
	# holder (round 757's merge, S1).
	var key: Object = b.node if b.ghost else b.skel
	if not is_instance_valid(key):
		b.sound_due = INF
		return
	var e: Array = b.entry
	var anim: BanReader.ParsedAnimation = e[1]
	var ms := _loop_ms(anim, t + float(e[3]))
	_anim_sounds.advance(key, anim, float(e[5]), ms, true)
	var next := _anim_sounds.next_key_ms(key, anim, ms, true)
	b.sound_due = t + next / 1000.0 if next != INF else INF
	_sound_schedule(b)
	_crowd_gpu.stats["sound_advances"] = int(_crowd_gpu.stats.get("sound_advances", 0)) + 1
	if b.ghost:
		_crowd_gpu.stats["ghost_sound_advances"] = int(_crowd_gpu.stats.get("ghost_sound_advances", 0)) + 1

## The cycle's choice: the CrowdGpu.near_count bodies nearest the camera,
## in view or not, stay near (a near body goes only once it is past the
## NEAR_HYSTERESIS x near_count nearest: by rank, so a dense crowd does not
## keep a ring of bodies near), every other eligible body goes to the GPU; a
## far body now among the nearest, or no longer eligible, comes back. In view
## or not: the nearest are the ones heard (their clip sounds run near only).
func _crowd_choose() -> void:
	# Round 762: the DRESS_NEAREST nearest bodies are the ones a ghost is
	# dressed among (the rest stay ghosts: the same pixels far).
	var within := INF
	if _crowd_all_d2.size() > DRESS_NEAREST:
		_crowd_all_d2.sort()
		within = _crowd_all_d2[DRESS_NEAREST - 1]
	# The dressing looks at its queue again when the reach moved (the player
	# or the crowd walked): by more than a unit, or from or to everyone.
	if is_inf(within) != is_inf(_dress_within_sq) or absf(sqrt(within) - sqrt(_dress_within_sq)) > 1.0:
		_other_builds.reopen()
	_dress_within_sq = within
	var dists := _crowd_got_dist.duplicate()
	var seen := 0
	var come := INF
	var stay := INF
	var k := CrowdGpu.near_count
	if dists.size() > k:
		dists.sort()
		come = dists[maxi(k - 1, 0)]
		var k_out := int(ceil(float(k) * CrowdGpu.NEAR_HYSTERESIS))
		stay = dists[mini(k_out, dists.size()) - 1] if k_out > 0 else -1.0
	_crowd_pending.clear()
	_crowd_come = come
	var nearest := 0
	for i in range(_crowd_got_ids.size()):
		var flags := _crowd_got_flags[i]
		if flags & CROWD_GOT_SEEN:
			seen += 1
		var eligible := (flags & CROWD_GOT_ELIGIBLE) != 0
		var was_far := (flags & CROWD_GOT_FAR) != 0
		var want := eligible and _crowd_got_dist[i] > (come if was_far else stay)
		if not want and eligible:
			nearest += 1
		if want == was_far:
			continue
		# Far or not as it was scanned; checked again here, since a body may
		# have been woken or switched since (round 757).
		var skel = _crowd_got_skels[i]
		if skel == null or not is_instance_valid(skel):
			continue
		var far := _crowd_gpu.has(skel)
		if want and not far:
			_crowd_pending.append(int(_crowd_got_ids[i]))
		elif not want and far:
			# Round 762: a far body still fading (its page's fade-in, on the
			# GPU) stays far until its fade is over: the full path has no fade
			# of its own to take over from (it would pop to full).
			if _crowd_gpu.is_fading(skel):
				continue
			# Sent to the server with the frame's flush, below.
			_crowd_wake(skel, false)
	var counts := {"in_view": seen, "come_within": snappedf(come, 0.1), "stay_within": snappedf(stay, 0.1)}
	if nearest > 0:
		counts["nearest"] = nearest
	_crowd_gpu.ineligible.merge(counts, true)
	# The bounds from this cycle's scan of the far bodies (round 757: not a
	# pass over every far body at the cycle's end).
	if _crowd_far_lo.x != INF:
		_crowd_gpu.reset_aabb_to(_crowd_far_lo, _crowd_far_hi)
	else:
		_crowd_gpu.reset_aabb()
	_crowd_gpu.collect()

## The chosen bodies to the GPU, for up to CrowdGpu.SWITCH_BUDGET_USEC a
## frame: each one's loop entry taken out of _animated (one pass over it for
## all of them); the rest wait for the next frame.
func _crowd_switch_due() -> void:
	if _crowd_pending.is_empty():
		return
	var t0 := Time.get_ticks_usec()
	var want := {}
	var take := mini(_crowd_pending.size(), CrowdGpu.SWITCH_BUDGET)
	for i in range(take):
		var id: int = _crowd_pending[i]
		var gait: Dictionary = _other_gaits.get(id, {})
		var skel = gait.get("skeleton")
		var node = _other_bodies.get(id)
		if skel != null and is_instance_valid(skel) and node != null and is_instance_valid(node):
			want[skel] = [node, id]
	var gone := {}
	var done := {}
	for entry in _animated:
		var raw = entry[0]
		if not is_instance_valid(raw) or not want.has(raw):
			continue
		var skel: Skeleton3D = raw
		if done.has(skel):
			continue
		done[skel] = true
		# A loop only: a one-shot's hand-back is the clip tick's (it comes
		# far at a later cycle, back on its loop).
		# Eligible still (round 747's review, F6): it may have become a Detail
		# caster, berserk or an effect's host since the scan chose it.
		if bool(entry[4]) and _crowd_eligible(int(want[skel][1]), want[skel][0], skel) == "" \
				and _crowd_gpu.add(want[skel][0], skel, entry, _idle_anim_time):
			gone[skel] = true
			# Round 757's review, F5: in this cycle's far bounds, which the
			# cycle's end resets the groups' AABB to (the scan saw it near).
			var at := (want[skel][0] as Node3D).global_position
			_crowd_far_lo = Vector3(minf(_crowd_far_lo.x, at.x), minf(_crowd_far_lo.y, at.y), minf(_crowd_far_lo.z, at.z))
			_crowd_far_hi = Vector3(maxf(_crowd_far_hi.x, at.x), maxf(_crowd_far_hi.y, at.y), maxf(_crowd_far_hi.z, at.z))
			# Its clip sounds go on from the CPU while it is within hearing
			# (round 747's review, F2: the READ 600 rule), from where the near
			# tick left them; its run baked ahead, so a step does not bring it
			# back (a gait change on a far body whose loop is not baked does).
			_crowd_went_far(int(want[skel][1]), want[skel][0], skel)
		if Time.get_ticks_usec() - t0 >= CrowdGpu.SWITCH_BUDGET_USEC:
			break
	# Those not reached this frame wait; those tried (switched or refused) do not.
	var left: Array = []
	for i in range(_crowd_pending.size()):
		var id: int = _crowd_pending[i]
		if i < take:
			var gait: Dictionary = _other_gaits.get(id, {})
			var skel = gait.get("skeleton")
			if skel == null or not is_instance_valid(skel) or done.has(skel) or not want.has(skel):
				continue
		left.append(id)
	_crowd_pending = left
	if gone.is_empty():
		return
	var kept: Array = []
	for entry in _animated:
		var raw = entry[0]
		if is_instance_valid(raw) and gone.has(raw):
			continue
		kept.append(entry)
	_animated = kept
	_rehint_other_loops()
	_crowd_gpu.stats["switch_usec"] = int(_crowd_gpu.stats.get("switch_usec", 0)) + Time.get_ticks_usec() - t0

## Brings a far body back to the full path: its entry back in the clip tick,
## posed now at its clip's current frame (the frame the GPU drew), shown.
## Nothing for a body that is not far. `push` false leaves the instances'
## change for the frame's flush (a caller inside _crowd_gpu_step).
func _crowd_wake(skel, push: bool = true) -> void:
	if _crowd_gpu == null or skel == null or not is_instance_valid(skel) or not _crowd_gpu.has(skel):
		return
	var entry := _crowd_gpu.remove(skel, push)
	if entry.is_empty():
		return
	_animated.append(entry)
	# Its sounds carry on from a live state, so a one-shot starting now (a
	# hit's moan, a death's voice, a sit-down, a pick-up) fires its first key
	# (round 747's review, F1). A body out of hearing is rested again by the
	# tick's own rule.
	_anim_sounds.wake(skel)
	var s: Skeleton3D = skel
	if s.is_inside_tree():
		MonsterCrowd.pose_at(s, entry[1], _idle_anim_time + float(entry[3]), true)
	# Its next tick poses it whatever the A4 slot (CullCache's "never posed").
	var info: Array = _crowd_cull.info(s)
	if info.size() == CrowdAnim.PLAYER_INFO_SIZE:
		info[4] = 1.0

## _crowd_wake for the body `node` is the holder of.
func _crowd_wake_node(node) -> void:
	if _crowd_gpu == null or node == null or not is_instance_valid(node):
		return
	var id := int((node as Node).get_meta("character_id", -1))
	# Round 756: a ghost is dressed first (an effect, berserk, Detail's shadow).
	_dress_ghost_now(id)
	var gait: Dictionary = _other_gaits.get(id, {})
	if not gait.is_empty():
		_crowd_wake(gait.get("skeleton"))

## A far skeleton leaving the tree (a body freed, re-dressed, a zone change,
## the QA `gone` step): off the instances, its entry back (the tick skips or
## drops it as it does any other).
func _crowd_on_exit(skel: Skeleton3D) -> void:
	if _crowd_gpu != null and _crowd_gpu.has(skel):
		var entry := _crowd_gpu.remove(skel)
		if not entry.is_empty():
			_animated.append(entry)
			var info: Array = _crowd_cull.info(skel)
			if info.size() == CrowdAnim.PLAYER_INFO_SIZE:
				info[4] = 1.0

## Another player's loop changes (MonsterMotion.swap_loop's job): a far body
## swaps on the GPU when the new clip is baked, else comes back first.
func _swap_other_loop(skel: Skeleton3D, anim: BanReader.ParsedAnimation, hint: Array = [], in_ms: float = ClipMixer.LOOP_IN_MS) -> void:
	_end_body_fidget(skel)
	var frames := _frame_count(anim)
	if frames > 1 and _crowd_gpu != null and _crowd_gpu.has(skel):
		if frames > 1 and _crowd_gpu.set_clip(skel, anim, frames, _idle_anim_time):
			# Its sounds move to the new loop now (its first frame is silent,
			# as a near body's loop swap is).
			var fb := _crowd_gpu.body_of(skel)
			if fb != null and fb.heard:
				var ms := _loop_ms(anim, _idle_anim_time + float(fb.entry[3]))
				_anim_sounds.prime(skel, anim, float(fb.entry[5]), ms)
				var next := _anim_sounds.next_key_ms(skel, anim, ms, true)
				fb.sound_due = _idle_anim_time + next / 1000.0 if next != INF else INF
				_sound_schedule(fb)
			return
		_crowd_wake(skel)
	MonsterMotion.swap_loop(_animated, skel, anim, frames, _idle_anim_time, hint, _pose_fades, in_ms)

## Round 808: the clip changes in progress on bodies in the clip tick, by
## skeleton id (ClipMixer.Fade): swap_loop's, and a one-shot's hand-back
## (_tick_idle_animations). Blended over the entry's own pose while it is
## posed (_blend_pose_fade); a GPU-drawn far body swaps at once (OURS: its
## clip is a texel write; it is beyond the near bodies by construction).
var _pose_fades := {}

## A loop's fade-in by the state that plays it (READ; ClipMixer): the run
## 100 ms, the walk and the sit 200 (0xa59680, 0xa5a270), the stand and the
## battle stance none (the idle state, 0xa592f0 -- round 831's correction).
static func _loop_in_ms(action: int) -> float:
	match action:
		BsrReader.AnimationEntry.TYPE_RUN:
			return ClipMixer.RUN_IN_MS
		BsrReader.AnimationEntry.TYPE_STAND, BsrReader.AnimationEntry.TYPE_STAND_BATTLE:
			return ClipMixer.IDLE_IN_MS
	return ClipMixer.LOOP_IN_MS

## Blends `skeleton`'s change of clip over the pose just written, if one is
## in progress; drops it once over. OURS (the crowd gate: +0.3 ms a frame
## over 2,500 monsters when every change blended): only within
## MonsterCrowd.POSE_FULL of the camera -- the bodies posed every frame --
## does a change blend; a farther one swaps at once, as before round 808.
func _blend_pose_fade(skeleton: Skeleton3D, eye: Vector3) -> void:
	var id := skeleton.get_instance_id()
	var f = _pose_fades.get(id)
	if f == null:
		return
	if skeleton.global_position.distance_squared_to(eye) > MonsterCrowd.POSE_FULL * MonsterCrowd.POSE_FULL:
		_pose_fades.erase(id)
		return
	if not ClipMixer.blend_from(skeleton, f, _idle_anim_time):
		_pose_fades.erase(id)
	# The baked frame it was posed with no longer holds (CrowdAnim, round
	# 738's review F7).
	if skeleton.has_meta(CrowdAnim.META_LAST):
		skeleton.remove_meta(CrowdAnim.META_LAST)

## Round 748 (the merge with 747): other players' swap hints (gait["at"]) by
## skeleton id, the same arrays, so a rebuild of `_animated` can set them.
var _other_hint_by_skel := {}

## After `_animated` is rebuilt (a far switch drops entries, the tick drops
## dead ones), every hint names its entry's new index again -- one pass,
## instead of each walker's next swap scanning the list.
func _rehint_other_loops() -> void:
	if _other_hint_by_skel.is_empty():
		return
	for h in _other_hint_by_skel.values():
		(h as Array)[0] = -1
	for i in range(_animated.size()):
		var raw = (_animated[i] as Array)[0]
		if not is_instance_valid(raw):
			continue
		var h = _other_hint_by_skel.get((raw as Object).get_instance_id())
		if h != null:
			(h as Array)[0] = i

## A weapon's item skeleton on a far body: its frame, and its body's place
## (EquipFx places and chooses a far weapon's particles by them).
func _crowd_item_frame(item_skel: Node3D):
	return _crowd_gpu.item_frame(item_skel) if _crowd_gpu != null else null

func _crowd_item_origin(item_skel: Node3D):
	# Round 762: a weapon of a player whose departure waits in the queue shows
	# no particles (out of reach), as one fading out does: a crowd leaving
	# otherwise moved EquipFx's nearest weapons onto the next to leave, frame
	# after frame (MEASURED r762.md: 8-10 ms frames of fx_driver).
	if not _depart_pending.is_empty() and item_skel != null:
		var att := item_skel.get_parent()
		var sk := att.get_parent() if att != null else null
		var holder := sk.get_parent() if sk != null else null
		if holder != null and _depart_pending.has(int(holder.get_meta("character_id", -1))):
			return Vector3(INF, INF, INF)
	return _crowd_gpu.item_origin(item_skel) if _crowd_gpu != null else null

## Round 762's review, F1: a ghost's weapon -- the item skeleton's frame from
## the GPU clip, and the ghost's place (out of reach while its departure waits
## in the queue, as _crowd_item_origin's).
func _crowd_ghost_item_frame(node: Node3D, bone: int, chain: Transform3D):
	return _crowd_gpu.ghost_item_frame(node, bone, chain) if _crowd_gpu != null else null

## Round 764 (EquipFxBatch): the CrowdGpu drawing the ghosts, or null.
func _crowd_gpu_now():
	return _crowd_gpu

func _crowd_ghost_origin(node: Node3D):
	if not _depart_pending.is_empty() and node != null and _depart_pending.has(int(node.get_meta("character_id", -1))):
		return Vector3(INF, INF, INF)
	return _crowd_gpu.ghost_origin(node) if _crowd_gpu != null else null

## Round 762's review, F1 (OURS): a ghost's weapon particles, without dressing
## it -- the recipe's particle rows (CharacterAppearance.FarRecipe.fx) as
## EquipFx hosts on the ghost's holder, placed from its GPU clip frame
## (EquipFx.add_ghost_host). Before, a ghost showed none until it was dressed,
## and the background dressing never ran (the review: no other player in a
## crowd showed its weapon's particles). Retail draws a character's effects
## within its LOD 0.9, 720 units (READ, round 761; EquipFx.MAX_DISTANCE).
## Any hosts the ghost had (a kind drawn again) go first.
func _ghost_fx(node: Node3D, recipe: CharacterAppearance.FarRecipe) -> void:
	if node == null or not node.is_inside_tree() or _appearance == null or not _ghost_fx_on:
		return
	var d := EquipFx.driver_for(node.get_viewport())
	d.remove_node(node)
	if recipe == null or recipe.fx.is_empty():
		return
	var archive := _appearance._particles_archive()
	for row in recipe.fx:
		d.add_ghost_host(node, row, archive)

## QA (round 762's review): OPENSRO_QA_GHOST_FX=0 gives ghosts no weapon
## particles (as before the fix), for an A/B of their cost.
var _ghost_fx_on := OS.get_environment("OPENSRO_QA_GHOST_FX") != "0"

## A ghost's weapon particles off (it is dressed, leaves or goes).
func _ghost_fx_off(node: Node) -> void:
	if node == null or not is_instance_valid(node) or not node.is_inside_tree():
		return
	var vp := node.get_viewport()
	if vp == null or not vp.has_meta(EquipFx.DRIVER_META):
		return
	var d = vp.get_meta(EquipFx.DRIVER_META)
	if is_instance_valid(d):
		(d as EquipFx).remove_node(node)

## CharacterLight gave a body's meshes their level's materials: a far body's
## instances take them, or it comes back when they cannot.
func _crowd_light_changed(body: Node3D) -> void:
	if _crowd_gpu != null and not _crowd_gpu.refresh(body):
		_crowd_wake_node(body)

## The bodies the clip tick holds, near and far (a new loop's phase, A4's
## crowd count).
func _animated_total() -> int:
	return _animated.size() + (_crowd_gpu.body_count() if _crowd_gpu != null else 0)

## The map objects that move (round 645): MapAnimation.Driver runs each clip
## while its object is in range and in view, as retail's update does.
var _map_animations := MapAnimation.Driver.new()

## Where the driver's shared poses live (round 647): one node under the
## world, made with the first animated object, kept across zone changes.
func _map_animation_poses() -> Node:
	if _map_animations.pose_parent == null or not is_instance_valid(_map_animations.pose_parent):
		var holder := Node3D.new()
		holder.name = "MapAnimationPoses"
		add_child(holder)
		_map_animations.pose_parent = holder
	return _map_animations.pose_parent

## The QA MAPANIM line's last timestamp (usec) and frame, for its frame_ms.
var _qa_mapanim_us := 0
var _qa_mapanim_frame := 0

## The object range is measured from the camera, as retail's is (READ: the
## camera struct's +0x4, SWorld::vslot_004); the camera's frustum stands in
## for the sectors the view touches (see MapAnimation).
func _tick_map_animations() -> void:
	if _map_animations.size() > 0:
		var cam := get_viewport().get_camera_3d() if get_viewport() != null else null
		var eye: Vector3 = cam.global_position if cam != null else (player.global_position if player != null else Vector3.ZERO)
		_map_animations.tick(eye, cam.get_frustum() if cam != null else [])
		# OPENSRO_QA_MAPANIM_SPLIT=<frame> + _MODE=<mode>: the cost split
		# (MapAnimationProbe). QA only.
		var split := int(OS.get_environment("OPENSRO_QA_MAPANIM_SPLIT"))
		if split > 0:
			var mode := OS.get_environment("OPENSRO_QA_MAPANIM_MODE")
			if Engine.get_process_frames() == split:
				MapAnimationProbe.apply(_map_animations, mode)
			if mode == "manual" and Engine.get_process_frames() > split:
				MapAnimationProbe.step(_map_animations, get_process_delta_time())
	# OPENSRO_QA_MAPANIM=n: every n ticks, the clips registered and running
	# and what the frame cost -- process time, and the viewport's measured
	# render time on the CPU and the GPU (the skinning and the draws) -- the
	# measurement behind round 645's cost figures.
	var every := int(OS.get_environment("OPENSRO_QA_MAPANIM"))
	if every > 0:
		var vp := get_viewport().get_viewport_rid()
		if Engine.get_process_frames() <= 1:
			RenderingServer.viewport_set_measure_render_time(vp, true)
		if Engine.get_process_frames() % every == 0:
			# frame_ms (round 647): the mean wall time of a frame since the
			# last line -- every frame of the interval, not one sample (a
			# frame this skips, the loading drain's, still counts).
			var now_us := Time.get_ticks_usec()
			var frames := Engine.get_process_frames() - _qa_mapanim_frame
			var frame_ms := float(now_us - _qa_mapanim_us) / 1000.0 / float(frames) if _qa_mapanim_us > 0 and frames > 0 else 0.0
			_qa_mapanim_us = now_us
			_qa_mapanim_frame = Engine.get_process_frames()
			print("QA MAPANIM frame %d frame_ms=%.3f registered=%d running=%d poses=%d groups=%d sectors=%d viewed=%d tested=%d driver_us=%d mix_us=%d process_ms=%.3f render_cpu_ms=%.3f render_gpu_ms=%.3f draws=%d objects=%d" % [
				Engine.get_process_frames(), frame_ms, _map_animations.size(), _map_animations.running,
				_map_animations.poses, _map_animations.groups, _map_animations._sectors.size(),
				_map_animations.sectors_viewed, _map_animations.objects_tested, _map_animations.tick_usec,
				MapAnimationProbe.mix_usec, Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0,
				RenderingServer.viewport_get_measured_render_time_cpu(vp),
				RenderingServer.viewport_get_measured_render_time_gpu(vp),
				int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)),
				int(Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME))])
