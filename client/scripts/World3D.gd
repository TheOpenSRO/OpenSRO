##   not 16 x 16 24-bit -> _ERROR, else the use with the 256 bytes. Each line
##   to the system message window (0x7781b0(0, ...)).
## - 0x18 (0x798519..0x7985e7): the same for unionmark.bmp and the own
##   union's revision (0xeeee1c; OpenSRO has no unions: 0).
## - 0x16 / 0x19: no crest -> UIIT_MSG_GUILD_ / UNION_DELETE_ERROR, else the
##   plain use (0x798654).
## The install path is `*(0x110f7d0)+0x134`, the client's folder (INFERRED);
## OURS: the folder Media.pk2 is read from (the player's Silkroad folder),
## else the executable's.
func _on_crest_confirmed(slot: int, kind: int) -> void:
	if NetClient.current_character_name == "":
		return
	var own_rev := NetClient.guild_data.crest_rev if NetClient.guild_data.in_guild else 0
	# Round 844: the own union's crest revision (c:0x895a3b keeps it).
	var union_rev := NetClient.guild_data.union.crest_rev if NetClient.guild_data.in_guild else 0
	match kind:
		GuildMsgBox.Kind.CREST, GuildMsgBox.Kind.UNION_CREST:
			var union := kind == GuildMsgBox.Kind.UNION_CREST
			if (union_rev if union else own_rev) != 0:
				_crest_line("UIIT_MSG_CREST_REGISTER_OVERLAP")
				return
			var file := CrestNet.UNION_MARK_FILE if union else CrestNet.GUILD_MARK_FILE
			var bmp := PackedByteArray()
			for dir in _crest_folders():
				var path := String(dir).path_join(file)
				if FileAccess.file_exists(path):
					bmp = FileAccess.get_file_as_bytes(path)
					print("CREST reading %s (%d bytes)" % [path, bmp.size()])
					break
			var got := CrestNet.bmp_to_indices(bmp, NetClient.crest_cache.palette)
			match int(got[0]):
				CrestNet.BMP_MISSING:
					_crest_line("UIIT_MSG_CREST_REGISTER_FAIL")
				CrestNet.BMP_FORMAT:
					_crest_line("UIIT_MSG_CREST_REGISTER_ERROR")
				_:
					NetClient.use_item_crest(NetClient.current_character_name, slot, got[1])
		GuildMsgBox.Kind.CREST_DELETE:
			if own_rev == 0:
				_crest_line("UIIT_MSG_GUILD_DELETE_ERROR")
				return
			NetClient.use_item(NetClient.current_character_name, slot)
		GuildMsgBox.Kind.UNION_CREST_DELETE:
			if union_rev == 0:
				_crest_line("UIIT_MSG_UNION_DELETE_ERROR")
				return
			NetClient.use_item(NetClient.current_character_name, slot)

func _qa_crest_step(code: String) -> void:
	var slot := _hud_panels.bag_slot_of_code(code)
	var kind := int(HudPanels.CREST_ITEM_BOXES.get(code, 0))
	print("QA CREST %s: bag slot %d, box %x" % [code, slot, kind])
	if slot < 0 or kind == 0:
		return
	var box: GuildMsgBox = _hud_panels.open_crest_box(slot, kind)
	if box == null:
		return
	for i in 40:
		await get_tree().process_frame
	if is_instance_valid(box) and not box.is_queued_for_deletion():
		print("QA CREST pressing OK at frame %d" % Engine.get_frames_drawn())
		(box.node("GDR_MBIN_BTN_OK") as BaseButton).pressed.emit()
	# The result's box (0x1a / 0x1b), confirmed 60 frames after it shows.
	for i in 200:
		await get_tree().process_frame
		var done: GuildMsgBox = _hud_panels._guild_boxes.get(GuildMsgBox.Kind.CREST_DONE)
		if done == null:
			done = _hud_panels._guild_boxes.get(GuildMsgBox.Kind.UNION_CREST_DONE)
		if is_instance_valid(done) and not done.is_queued_for_deletion():
			for j in 60:
				await get_tree().process_frame
			if is_instance_valid(done):
				print("QA CREST confirming the result at frame %d" % Engine.get_frames_drawn())
				(done.node("GDR_MBIN_BTN_OK") as BaseButton).pressed.emit()
			return

## Where guildmark.bmp / unionmark.bmp are looked for, in order.
func _crest_folders() -> PackedStringArray:
	var out := PackedStringArray()
	var media := Pk2Config.media_path()
	if media != "":
		out.append(media.get_base_dir())
	out.append(OS.get_executable_path().get_base_dir())
	return out

func _crest_line(key: String) -> void:
	print("CREST line %s" % key)
	var text := _ui_text_table.get_text(key, "") if _ui_text_table != null else ""
	_log_system(text if text != "" and text != key else key, HudSystemMessage.TYPE_ALWAYS)

func _on_guild_invitation_answered(accept: bool) -> void:
	print("GUILD invitation answered %s" % accept)
	NetClient.guild_answer(accept)

## OPENSRO_QA_GUILD_ANSWER=yes|no[:frames] presses the invitation box's own
## OK (yes) or Cancel (no), that many frames after it opens (0 unless given),
## so the frames show the box first -- but within 25 wall seconds, inside the
## server's 30 s wait (a movie render's frames can run slower than that).
func _qa_guild_answer_pending() -> void:
	var a := OS.get_environment("OPENSRO_QA_GUILD_ANSWER")
	if a == "" or _hud_panels == null:
		return
	var parts := a.split(":")
	var frames := int(parts[1]) if parts.size() > 1 else 0
	var until := Time.get_ticks_msec() + 25000
	while frames > 0 and Time.get_ticks_msec() < until:
		frames -= 1
		await get_tree().process_frame
	var box: GuildMsgBox = _hud_panels._guild_boxes.get(GuildMsgBox.Kind.INVITE)
	if not is_instance_valid(box):
		print("QA GUILD answer %s: no box open" % a)
		return
	print("QA GUILD answer %s: pressing the box's %s" % [a, "OK" if parts[0] == "yes" else "Cancel"])
	var b := box.node("GDR_MBIN_BTN_OK" if parts[0] == "yes" else "GDR_MBIN_BTN_CANCEL") as BaseButton
	if b != null:
		b.pressed.emit()

## Round 844 (QA): the union steps of OPENSRO_QA_INPUT; the report.
func _qa_union_step(kind: String, arg: String) -> String:
	var gw: GuildWindow = _hud_panels._guild_window() if _hud_panels != null else null
	if kind == "unionstate":
		return "unionstate tick %d frame %d %s" % [_qa_tick, Engine.get_frames_drawn(),
			_qa_union_state(gw) if gw != null else "(no guild window)"]
	var target: Control = null
	if kind == "unionnode" and gw != null:
		var path: Array = []
		for part in arg.split(",", false):
			path.append(int(part))
		target = gw.control(path)
	elif kind == "unionbox":
		var box: GuildMsgBox = _hud_panels._guild_boxes.get(GuildMsgBox.Kind.UNION_REQUEST)
		if is_instance_valid(box):
			target = box.node("GDR_MBIN_BTN_OK" if arg == "yes" else "GDR_MBIN_BTN_CANCEL")
	if target == null or not target.is_visible_in_tree():
		return "%s:%s (not shown)" % [kind, arg]
	var at := target.get_global_rect().get_center()
	_qa_push_click(at, MOUSE_BUTTON_LEFT, true)
	var hov := get_viewport().gui_get_hovered_control()
	return "%s:%s at %s (hovered %s)" % [kind, arg, at, hov.get_path() if hov != null else "nothing"]

## The union pane as drawn: the shown texts, the rows, the buttons' states.
func _qa_union_state(gw: GuildWindow) -> String:
	var up := gw.union_pane
	if up == null:
		return "(no union pane)"
	var texts: PackedStringArray = []
	for id in [UnionPane.LEAD_NAME, UnionPane.LEAD_MASTER, UnionPane.COUNT, UnionPane.SEL_NAME,
			UnionPane.SEL_MASTER, UnionPane.SEL_MEMBERS, UnionPane.NO_UNION, UnionPane.NO_SELECTION]:
		var c := up._part(id)
		if c != null and c.is_visible_in_tree():
			var l := c.get_node_or_null(TwoDtBuilder.TEXT_NODE) as Label
			texts.append("%d=%s" % [id, l.text if l != null else TwoDtBuilder.text_of(c)])
	var rows: PackedStringArray = []
	for row in up.rows():
		var n := TwoDtBuilder.child(row, UnionPane.ROW_NAME)
		var lv := TwoDtBuilder.child(row, UnionPane.ROW_LEVEL)
		if n != null and n.visible:
			var nl := n.get_node_or_null(TwoDtBuilder.TEXT_NODE) as Label
			var ll := lv.get_node_or_null(TwoDtBuilder.TEXT_NODE) as Label if lv != null else null
			rows.append("%s|%s|%s%s" % [nl.text if nl != null else "", ll.text if ll != null else "",
				nl.get_theme_color("font_color").to_html(false) if nl != null else "",
				"|sel" if int(row.get_meta("union_guild", 0)) == up.selected else ""])
	var btns: PackedStringArray = []
	for id in [UnionPane.APPLY, UnionPane.SECEDE, UnionPane.EXPEL]:
		var b := up._part(id) as BaseButton
		btns.append("%d:%s" % [id, "off" if b == null or b.disabled else "on"])
	return "pane=%s texts=[%s] rows=[%s] buttons=[%s]" % [str(up.pane() != null and up.pane().is_visible_in_tree()),
		", ".join(texts), ", ".join(rows), " ".join(btns)]

## The guild window's Invite (button 37, c:0x81fb70(0)): the selected player
## (a pet or horse would give its owner, c:0x81fbdd; not selectable here).
## Nothing without a target, or with the player's own body.
