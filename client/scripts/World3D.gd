func _toggle_dev_ui() -> void:
	_set_dev_ui_visible(not _dev_ui_visible)
	_log_system("Developer tools %s" % ("shown" if _dev_ui_visible else "hidden"))

## Toggles the whole hideable UI panel (character/zone labels, chat, action
## tabs, etc.) -- see HideUIButton's own doc-free scene node and F10
## (KeyMap's "hide_ui", ours: retail's F10 is the item mall). HideUIButton
## itself lives outside ui_control (a sibling under the UI CanvasLayer, not
## a child of Control) specifically so it stays clickable to toggle the UI
## back on even while everything else is hidden.
##
## It is Control's LATER sibling, and sits left of the minimap (round 531).
## Godot 4.2 hit-tests a later sibling first. It used to be the earlier one,
## under the minimap's top-right corner, and once round 529 made the minimap
## STOP the minimap took every click on the part it covered: the button could
## no longer hide the UI. Later in the tree, nothing in UI/Control can cover
## it. Left of the minimap (place_minimap), it no longer covers the minimap's
## area name either (GDR_MINIMAP_TEXT_AREANAME, 12,9 104x12 in the archive's
## ifminimap.txt, dumped in round 531). The position is our own; this button
## has no authored equivalent. hud_click_routing_test.gd measures it.
func _toggle_ui_visibility() -> void:
	ui_control.visible = not ui_control.visible
	hide_ui_button.text = "Show UI" if not ui_control.visible else "Hide UI"

## Toggles the tabbed panel holding inventory, equipment, skills, shop, party
## and the rest -- the developer's debug tabs, on Shift+F2 (Ctrl+F2 from round 608 to round 698)
## (they were on Tab, which is retail's berserk key; KeyMap).
##
## It used to be a permanently visible strip spanning the full window width and
## 220 pixels tall, sitting directly above an equally full-width chat panel. A
## real headless render of the real Jangan spawn measured the two of them, plus
## the log-out row beneath, covering roughly 70% of the window -- the world was
## reduced to a letterbox strip along the top. Real Silkroad keeps inventory,
## skills and shop in windows the player opens and closes, and leaves the view
## itself clear, so the panel is now hidden until asked for. Chat stays visible
## (it is, as in the real client, a running log rather than a window) but is
## narrowed to the bottom-left corner instead of spanning the full width.
func _toggle_action_panels() -> void:
	action_tabs.visible = not action_tabs.visible
	_fill_monster_rows()

## Releases the viewport's focus owner for a LEFT button press, and says
## whether it did. Only the left button: a right drag orbits the camera and the
## wheel zooms it, and neither should end a message being typed; the middle
## button fires a quickslot. Static so the suite can drive it without a
## running world (npc_service_reader_test.gd, check (n)).
static func take_focus_back(viewport: Viewport, event: InputEvent) -> bool:
	if viewport == null or not (event is InputEventMouseButton and (event as InputEventMouseButton).pressed):
		return false
	if (event as InputEventMouseButton).button_index != MOUSE_BUTTON_LEFT:
		return false
	var focus_owner := viewport.gui_get_focus_owner()
	if focus_owner == null:
		return false
	focus_owner.release_focus()
	return true

func _unhandled_input(event: InputEvent) -> void:
	if title_mode:
		return
	# A left click that reaches here was consumed by no control -- no STOP
	# control on its chain (Godot 4.2 viewport.cpp) -- so it is treated as a
	# click on the world and takes the keyboard back from whatever text line
	# still holds it. Godot does not release focus on a click on empty space,
	# and since round 521 any focused line counts as typing (_is_typing), which
	# stops movement; without this, a line left focused -- the chat's line,
	# the debug panel's teleport field after Enter -- kept click-to-move (and,
	# before round 608, the WASD keys) dead until the line lost focus some
	# other way.
	# The windows, the chat, the hotbar slots and (round 529) the player-info
	# block, the minimap, the target window and the hotbar's body are STOP, so
	# their clicks do not get here.
	# The click itself carries on to the handlers below.
	if _qa_input_armed and event is InputEventKey and (event as InputEventKey).pressed:
		_qa_input_seen.append(OS.get_keycode_string((event as InputEventKey).keycode))
	take_focus_back(get_viewport(), event)
	# Keys are not read here: every key the game answers is in the key
	# table (KeyMap, round 608) and is run by KeyInput, or by HudPanels for
	# the windows' keys -- F1..F4, the number keys, Tab, N, F10 and the
	# developer toggles all moved there.
	# The middle mouse button fires the bar's "m" slot, the first slot on the
	# hotbar: "the first slot thats on the hotbar you press it with 1, thats
	# not right it should be middle mouse button" (playtest 2026-09-20). The
	# client's own bar has that slot (quick slot 0, labelled ub_number_m), and
	# its mouse handler fires it on WM_MBUTTONDOWN (0x77c4cc -> 0x60bb80(0);
	# HudUnderbar.MOUSE_SLOT has the reading). Until the real bar was built it
	# fired page slot 1, the one the 1 key fires. This is the press over the
	# world; a press over a STOP HUD surface never gets here, and the hotbar
	# fires it for them (_relay_middle_button_to_hotbar).
	#
	# NOT YET REBINDABLE. The client moves it to the right button when its
	# interface flag +0x4f9 is set from the options; this client has no such
	# option (docs/PLAYTEST_2026_09_20b.md records the request).
	if event is InputEventMouseButton and (event as InputEventMouseButton).pressed \
			and (event as InputEventMouseButton).button_index == MOUSE_BUTTON_MIDDLE \
			and _hud_underbar != null:
		_hud_underbar.activate_mouse_slot()
		get_viewport().set_input_as_handled()
		return
	# Motion that gets this far was not consumed by a window -- see _input.
	if event is InputEventMouseMotion:
		_hover_reached_world = true

	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_RIGHT:
			# A right click cancels a ground pick (round 617); the press still
			# starts an orbit as any right press does.
			if event.pressed:
				_cancel_ground_pick("right click")
			_right_button_held = event.pressed
		elif event.button_index == MOUSE_BUTTON_LEFT:
			# The press is the click (round 701; READ): retail's WM_LBUTTONDOWN
			# runs the whole pick -- CGInterface::vslot_017 case 0x201
			# (0x77c4a7) -> 0x793570 -> the object click 0x792f00 or the ground
			# click 0x78f8d0 -> 0x9ec570 (destination, filter, ring) -- and
			# nothing after it repeats it: WM_LBUTTONUP (case 0x202 ->
			# 0x78e5d0) only ends process modes 0xae/0xaf, WM_MOUSEMOVE (case
			# 0x200) turns the camera on the right button (the middle with the
			# swap flag +0x4f9) and never on the left, and the 500 ms timer 7
			# (0x777b90) re-plots a sky click's heading run (0x9eb8e0, which
			# reads no mouse). So a held left button neither moves the ring
			# nor re-aims the walk: a new press does. Until round 701 the
			# click went on the release and a drag past 6 pixels re-picked the
			# destination under the cursor every frame ("the circle will
			# fluidly move around with your cursor", playtest 2026-10-03).
			if event.pressed:
				var took := _dispatch_double_click(event.position) if event.double_click else _dispatch_left_click(event.position)
				# One line a press (round 701): what a tester's log needs to
				# tell "it walked where I first clicked" from "it followed the
				# cursor".
				print("CLICK: left press at %s -> %s%s" % [str(event.position.round()), took,
					(" to (%.1f, %.1f, %.1f)" % [_move_target.x, _move_target.y, _move_target.z]) if took == "walk" and _has_move_target and not _move_heading_run else ""])
			_left_button_held = event.pressed
		elif event.button_index == MOUSE_BUTTON_WHEEL_UP and event.pressed:
			camera_arm.spring_length = clampf(camera_arm.spring_length - CAMERA_ZOOM_STEP, CAMERA_ZOOM_MIN, CAMERA_ZOOM_MAX)
		elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN and event.pressed:
			camera_arm.spring_length = clampf(camera_arm.spring_length + CAMERA_ZOOM_STEP, CAMERA_ZOOM_MIN, CAMERA_ZOOM_MAX)
		# Only the right button orbits the camera (READ: vslot_017 case 0x200
		# tests the right byte +0x25a, or the middle +0x259 with the swap
		# flag; never the left +0x258). A held left button does nothing.
		_camera_orbiting = _right_button_held
	# The orbit's motion is not read here: _input turns the camera, so a drag
	# keeps orbiting over a STOP control (see orbit_motion_applies).

## Whether a mouse motion turns the camera. Asked in _input, not in
## _unhandled_input, because a right drag that began on the world loses its
## motion to any STOP control the cursor crosses. Godot 4.2.2's
## Viewport::_gui_input_event sends motion to gui.mouse_focus, which a press on
## no control leaves empty, or else to the control under the cursor; a STOP
## control there consumes it, so it never reaches _unhandled_input (measured
## by round 522's re-review over the chat, and by npc_service_reader_test's
## check (o)). Viewport::push_input runs _input before the GUI for every
## event, so the orbit reads its motion there wherever the cursor is, and
## _unhandled_input no longer reads it (once, never twice).
##
## The right button must be in the motion's own button mask. _camera_orbiting
## follows the right button's press and release as _unhandled_input sees
## them, and a release can miss it: Godot sends a release to the control that
## holds the mouse focus (a left press on a window made while the right button
## was held), not to _unhandled_input. The flag then stays set with no button
## down, and without this check plain motion would turn the camera everywhere.
## Static so the suite can drive it without a running world.
static func orbit_motion_applies(event: InputEvent, orbiting: bool, camera_view: String) -> bool:
	if not orbiting or not (event is InputEventMouseMotion):
		return false
	if camera_view == CAMERA_VIEW_THIRD_PERSON:
		return false
	return ((event as InputEventMouseMotion).button_mask & MOUSE_BUTTON_MASK_RIGHT) != 0

## Real Silkroad-style click-to-move: raycasts from the camera through the
## real clicked screen position into the 3D world (real terrain/object
## collision -- both now real, solid bodies, see ObjectLoader's own real
## collision fix) and, on a hit, sets that as the player's real destination
## for _physics_process to walk toward every subsequent frame until reached
## or cancelled by another click, typing or death.
## A click on an NPC opens the authored talk window titled with its name,
## the way the original does. Ray-tests the NPC layer only (the colliders
## _npc_collider puts on NAVMESH_WALL_COLLISION_LAYER); returns true when it
## opened a dialogue, so the caller does not also walk there. The holder the
## collider hangs under carries the NPC's name (set where it is placed).
## The game's own cursors (round 697: GameCursor holds the set, read once
## at boot from the player's sro_client.exe, and shows it on every screen at
## the UI scale). The world only chooses which: the hover kind under the
## mouse, re-chosen on retail's timer -- CGInterface's timer 1 fires every
## 250 ms (`push 0xfa; push 1; call 0xb93320`, 0x787294, READ) and its
## handler (vslot_005 case 1, 0x789820) picks the object and its cursor. It
## was a 50 ms throttle on mouse motion until round 697 (ours); the timer
## also turns the cursor when a monster walks under a still mouse.
var _cursor_kind := ""
var _cursor_last_check_ms := 0
const CURSOR_HOVER_INTERVAL_MS := 250
## Classification cost, for the perf note: microseconds summed and counted.
var _cursor_classify_usec := 0
var _cursor_classify_count := 0

func _try_load_cursors() -> void:
	GameCursor.load_once()
	_cursor_kind = ""
	_apply_cursor("normal")

## Every mouse motion is seen here first; whether it then reaches
## _unhandled_input says if a window consumed it. The hover tick
## (_hover_tick, from _physics_process) reads both after the frame's input
## has been routed -- so the cursor is the arrow over a window and the
## world's kind over the world, using the engine's own GUI routing rather
## than a hit-test of our own (4.2 has no gui_get_hovered_control; that
## arrived in 4.3). Retail's tick asks the same question: a window under the
## mouse that is not the interface itself gives 0x95 (FUN_00b9dc00 !=
## CGInterface, READ).
var _hover_pos := Vector2.ZERO
var _hover_reached_world := false

func _input(event: InputEvent) -> void:
	if title_mode:
		return
	# Escape cancels a ground pick (round 617) before anything else sees it --
	# HudPanels would otherwise close a window or open the System menu with
	# the same press. Read here, before the GUI (the real-input rule of round
	# 609: a key left to the unhandled stage can be eaten by a focused
	# control).
	if _self_cast.picking() and event is InputEventKey and (event as InputEventKey).pressed \
			and not (event as InputEventKey).echo and (event as InputEventKey).keycode == KEY_ESCAPE:
		_cancel_ground_pick("Escape")
		get_viewport().set_input_as_handled()
		return
	# The orbit turns the camera here, before the GUI can consume the motion
	# (orbit_motion_applies has why). The event is not marked handled: the
	# control under the cursor still sees it, as before.
	if orbit_motion_applies(event, _camera_orbiting, _camera_view):
		var motion := event as InputEventMouseMotion
		camera_arm.rotation_degrees.y -= motion.relative.x * CAMERA_ORBIT_SENSITIVITY
		if _camera_view == CAMERA_VIEW_FREE:
			camera_arm.rotation_degrees.x = clampf(
				camera_arm.rotation_degrees.x - motion.relative.y * CAMERA_ORBIT_SENSITIVITY,
				CAMERA_PITCH_MIN_DEGREES, CAMERA_PITCH_MAX_DEGREES)
	# The hover follows the mouse with the left button held too (retail's
	# tick runs then, and a held button over an item is the closed glove),
	# and while the camera turns: retail's default rotate method leaves the
	# cursor free and its tick reads where it is (round 697 review, L3). The
	# orbit above is untouched.
	if event is InputEventMouseMotion:
		_hover_pos = (event as InputEventMouseMotion).position
		_hover_reached_world = false

## The hover tick (_physics_process): retail's 250 ms timer.
func _hover_tick() -> void:
	if Time.get_ticks_msec() - _cursor_last_check_ms >= CURSOR_HOVER_INTERVAL_MS:
		_settle_hover_cursor()

func _settle_hover_cursor() -> void:
	_cursor_last_check_ms = Time.get_ticks_msec()
	# Ground-pick mode keeps its own cursor (round 617).
	if _self_cast.picking():
		return
	GameCursor.refresh(get_window())
	# Also when the game's cursors are not there: the item under the mouse
	# shows its name (_hovered_ground_item).
	var t0 := Time.get_ticks_usec()
	# Over a window no world target is under the mouse: the log line must not
	# name the last one (round 700 review, L1).
	if not _hover_reached_world:
		_hover_target = ""
	var kind := _hover_kind_at(_hover_pos) if _hover_reached_world else "normal"
	_cursor_classify_usec += Time.get_ticks_usec() - t0
	_cursor_classify_count += 1
	if kind != "pickup" and kind != "pickup_held":
		_hovered_ground_item = -1
	_apply_cursor(kind)

## What the cursor should be over this screen point in the world, in the
## order the click dispatch tests the same rays (_dispatch_left_click), so
## the cursor says what a click there would do:
##   a dropped item       -> pickup (0x99), pickup_held (0x9a) with the left
##                           button down; notes the item, whose name shows
##   the nearest character -> a monster (a dying one passed over):
##                           GameCursor.monster_kind (0x97, or 0x95 for a
##                           job monster to a jobless player);
##                           another player: GameCursor.player_kind (0xa0
##                           outside the party with Alt held, else 0x95)
##   the talk ray          -> a gate's pick node (gate_point_id): gate (0xa1),
##                           an NPC: talk (0x98)
##   anything else         -> normal (0x95)
## Retail picks the one nearest object of any class (FUN_0078ee20) and
## switches on its class (vslot_005); this client's click tests the item
## first on purpose (round 207: an item at a monster's feet sits inside the
## monster's tall capsule), and the cursor follows the click. A monster or
## player hidden by held V is passed over, as its click is.
func _hover_kind_at(screen_pos: Vector2) -> String:
	_hover_target = ""
	var item := _ray_hit_tagged(screen_pos, GroundItems.GROUND_ITEM_COLLISION_LAYER, "ground_item_id")
	if item != null and _hover_held(item, "item"):
		_hovered_ground_item = int(item.get_meta("ground_item_id"))
		return GameCursor.item_kind(Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT))
	if not _objects_hidden:
		var who := _ray_hit_character(screen_pos)
		if who != null and _hover_held(who, "monster" if who.has_meta("monster_id") else "player"):
			if who.has_meta("monster_id"):
				return GameCursor.monster_kind(_monster_code_of(int(who.get_meta("monster_id"))))
			# Another player: no party, stall or team state reaches this
			# client yet (GameCursor.player_kind).
			return GameCursor.player_kind(GameCursor.player_hostile(Input.is_key_pressed(KEY_ALT)), false, false)
	var talk_node := _talk_ray_at(screen_pos)["node"] as Node
	if talk_node != null and _hover_held(talk_node, "gate" if talk_node.has_meta("gate_point_id") else "npc"):
		return "gate" if talk_node.has_meta("gate_point_id") else "talk"
	return "normal"

## What the hover last found, for its log line: "<what> <name> at <d> units
## (blocks dx, dz)", "" for nothing (round 700).
var _hover_target := ""
var _cursor_target := ""

## Round 700: whether the original client would hold `node` -- the 3 x 3
## message blocks around the player's (GameCursor.in_view_window, READ; see
## there). Notes the target and its distance from the player for the log.
func _hover_held(node: Node, what: String) -> bool:
	var n3 := node as Node3D
	if n3 == null or player == null:
		return true
	var at := n3.global_position
	var me := player.global_position
	var held := GameCursor.in_view_window(me, at)
	_hover_target = "%s %s at %.0f units (blocks %d, %d)%s" % [what, String(node.get_meta("npc_code", node.name)),
		Vector2(at.x - me.x, at.z - me.z).length(),
		GameCursor.view_block(at.x) - GameCursor.view_block(me.x), GameCursor.view_block(at.z) - GameCursor.view_block(me.z),
		"" if held else " -- outside the view window, not held"]
	return held

## The character under a screen point, as the click's pick finds it
## (_pick_character's mask without the Shift self body: retail's hover pick
## passes 0 for include-self): the first ancestor of the nearest monster or
## player collider carrying monster_id or character_id, or null. A dying
## monster is passed over and the ray goes on to whatever is behind it, as
## retail's pick (FUN_0078ee20) skips a character whose +0x65c bit 0 (alive)
## is clear (round 697 review, L2) -- up to HOVER_RAY_PASSES bodies.
const HOVER_RAY_PASSES := 4

func _ray_hit_character(screen_pos: Vector2) -> Node:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
	var exclude: Array[RID] = [player.get_rid()]
	query.collision_mask = MONSTER_COLLISION_LAYER | OTHER_PLAYER_COLLISION_LAYER
	for _pass in HOVER_RAY_PASSES:
		query.exclude = exclude
		var hit := get_world_3d().direct_space_state.intersect_ray(query)
		if hit.is_empty():
			return null
		var node := hit["collider"] as Node
		while node != null and not (node.has_meta("monster_id") or node.has_meta("character_id")):
			node = node.get_parent()
		if node == null or not (node.has_meta("monster_id") and _dying_until.has(int(node.get_meta("monster_id")))):
			return node
		exclude.append(hit["rid"])
	return null

## A live monster's characterdata code (MonsterSnapshot.code_name), "" when
## unknown.
func _monster_code_of(monster_id: int) -> String:
	var snap = _monster_snapshots.get(monster_id)
	if snap != null and snap is CombatNet.MonsterSnapshot:
		return (snap as CombatNet.MonsterSnapshot).code_name
	return ""

## The tagged node under a screen point on a collision layer, or null: the
## ray from the camera through the point, then the first ancestor of the
## collider carrying the meta. The click pickers do the same walk.
func _ray_hit_tagged(screen_pos: Vector2, mask: int, meta: String) -> Node:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
	query.exclude = [player.get_rid()]
	query.collision_mask = mask
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	if hit.is_empty():
		return null
	var node := hit["collider"] as Node
	while node != null and not node.has_meta(meta):
		node = node.get_parent()
	return node

## Shows the cursor for a hover kind (GameCursor.KIND_IDS) when it changes,
## and says so in the log: one line per change, the evidence a tester's log
## carries for "which cursor did it pick there".
func _apply_cursor(kind: String) -> void:
	# The target (round 700) is part of the change, so a gate passing out of
	# the view window logs even while the cursor stays the arrow.
	var target := _hover_target.get_slice(" at ", 0)
	if kind == _cursor_kind and target == _cursor_target:
		return
	_cursor_target = target
	if kind == _cursor_kind:
		if GameCursor.has_cursors() and _hover_target != "":
			print("CURSOR: %s (0x%x) at %s -- %s" % [kind, GameCursor.id_for(kind), str(_hover_pos.round()), _hover_target])
		return
	_cursor_kind = kind
	GameCursor.show_kind(kind, get_window())
	if GameCursor.has_cursors():
		print("CURSOR: %s (0x%x) at %s%s" % [kind, GameCursor.id_for(kind), str(_hover_pos.round()),
			(" -- " + _hover_target) if _hover_target != "" else ""])

## A double click's second press (round 701's review; READ): retail sends it
## as WM_LBUTTONDBLCLK, not a second WM_LBUTTONDOWN, to FUN_00792190 (via
## vslot_017 case 0x203), which picks the object under the cursor and acts
## only on a character it can act on -- a monster is attacked outright; the
## ground, an NPC and a gate get nothing, so a far NPC's approach is not
## rolled again. Another player's case (0x7074 when vslot 0xa8 allows) is not
## built: nothing here (OURS).
func _dispatch_double_click(screen_pos: Vector2) -> String:
	if _player_dead or _self_cast.picking():
		return "ignore"
	if not NetClient.is_connected_to_server() or _objects_hidden:
		return "ignore"
	var monster_id := _monster_at(screen_pos)
	if monster_id < 0:
		return "ignore"
	_cancel_talk_approach("a double click on a monster")
	_last_attack_target = monster_id
	_show_target(monster_id)
	_ring_on_monster(monster_id)
	_attack_monster(monster_id)
	return "attack"

## The original's left-click scheme, in the original's order: a click on a
## monster attacks it, on an NPC talks to it, and anywhere else walks there.
##
## Monster before NPC is deliberate. The NPC ray runs on the navmesh wall
## layer (NPC_COLLISION_LAYER is that layer), which is also what building
## walls sit on, so a monster standing in front of a wall used to lose the
## click to the wall test first -- and the real client's own hover code
## (CGInterface::vslot_005 in sro_client.exe, read for the cursors below)
## classifies the object under the mouse, monsters and NPCs alike, from what
## the pick returns, never wall-first. Returns which path took the click,
## for the QA hook's log.
func _dispatch_left_click(screen_pos: Vector2) -> String:
	if _player_dead:
		# Dead (round 548): a click on the world does nothing -- no pick-up,
		# attack, talk or walk; the Revive button is what there is to click.
		# Logged (round 675): a click lost to a dead state the player cannot
		# see must show in the tester's log.
		print("CLICK: at %s ignored -- the player is dead" % str(screen_pos))
		return "dead"
	# Any new click ends a talk approach still walking (round 701; OURS in
	# part: retail's ground click clears it, FUN_009ec570 writing +0x20 = 0,
	# and a new object click replaces it; a monster's select is not read to).
	_cancel_talk_approach("a new click")
	# Ground-pick mode (round 617): the click is the skill's point, not a
	# pick-up, an attack, a talk or a walk.
	if _self_cast.picking():
		return _ground_pick_click(screen_pos)
	# An item lying on the ground first: it sits at a monster's feet inside
	# the monster's tall click capsule, so testing the monster first would
	# make a drop unpickable while its killer's next target stands over it.
	# The item ray runs on the ground-item layer alone (see GroundItems).
	if _try_pick_up_item(screen_pos):
		return "pickup"
	var picked := _pick_character(screen_pos)
	if picked != "":
		return picked
	if _try_talk_to_npc(screen_pos):
		return "approach" if not _talk_approach.is_empty() else "talk"
	_try_set_move_target(screen_pos)
	return "walk"

## One line saying what a click ray actually hit: the collider's path, the
## layer bits it is on, and which tag was found walking up from it. This is
## what settles "it opened the talk window" -- the node, not the impression.
func _describe_click_hit(hit: Dictionary, wanted_meta: String) -> String:
	if hit.is_empty():
		return "no hit"
	var collider := hit["collider"] as Node
	var layer := -1
	if collider is CollisionObject3D:
		layer = (collider as CollisionObject3D).collision_layer
	var node := collider
	while node != null and not node.has_meta(wanted_meta):
		node = node.get_parent()
	var tagged := ("%s=%s on %s" % [wanted_meta, str(node.get_meta(wanted_meta)), node.name]) if node != null else ("no %s up the chain" % wanted_meta)
	return "%s (layer 0b%s) -> %s" % [collider.get_path() if collider != null else "?", String.num_int64(layer, 2), tagged]

## The talk ray from `from` to `to` (round 690, split out of
## _try_talk_to_npc so the cursor and GatePickProbe fire the same one):
## {"node": the first ancestor of the nearest tagged collider carrying
## `npc_name`, or null; "collider": the first thing the ray hit, or null;
## "hit": the raw result for that first thing}.
##
## It masks the talk layer (NPC bodies) and the gates' pick boxes
## (GATE_PICK_COLLISION_LAYER), and goes on through what is on the talk layer
## without a tag -- the navmesh walls, which share its bit -- up to
## TALK_RAY_PASSES hits: retail's pick (FUN_0078ee20) tests objects only, and
## an invisible wall standing in front of an NPC or a gate's box is not one.
## Until round 690 the first wall ended the click.
func _talk_ray(from: Vector3, to: Vector3) -> Dictionary:
	var query := PhysicsRayQueryParameters3D.create(from, to)
	var exclude: Array[RID] = [player.get_rid()]
	query.collision_mask = NPC_COLLISION_LAYER | GATE_PICK_COLLISION_LAYER
	var first: Dictionary = {}
	for _pass in TALK_RAY_PASSES:
		query.exclude = exclude
		var hit := get_world_3d().direct_space_state.intersect_ray(query)
		if hit.is_empty():
			break
		if first.is_empty():
			first = hit
		var node := hit["collider"] as Node
		while node != null and not node.has_meta("npc_name"):
			node = node.get_parent()
		if node != null:
			return {"node": node, "collider": first["collider"], "hit": first}
		exclude.append(hit["rid"])
	return {"node": null, "collider": first.get("collider"), "hit": first}

## How many untagged talk-layer bodies the talk ray goes through (OURS): a
## bound, so a click across a walled town casts at most this many rays.
const TALK_RAY_PASSES := 8

## The talk ray through a screen point (_talk_ray).
func _talk_ray_at(screen_pos: Vector2) -> Dictionary:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	return _talk_ray(from, from + dir * 2000.0)

func _try_talk_to_npc(screen_pos: Vector2) -> bool:
	if _hud_panels == null:
		return false
	var talk := _talk_ray_at(screen_pos)
	var hit: Dictionary = talk["hit"]
	if hit.is_empty():
		return false
	var node := talk["node"] as Node
	if node == null:
		# Round 675: what took a click that talked to nobody -- a gate whose
		# portal is not bound, or a wall on the talk layer in front of it --
		# goes to the tester's log, not only the QA hook's.
		print("%s npc ray: %s" % ["QA CLICK  " if _qa_click_logging else "CLICK:", _describe_click_hit(hit, "npc_name")])
		return false
	if _qa_click_logging:
		print("QA CLICK   npc ray: %s" % _describe_click_hit(hit, "npc_name"))
	# A CICharactor clicked is the selection (round 701's review; READ:
	# 0x793570 calls FUN_00778650 for it in reach and before an approach): a
	# selected monster stops being one, so a later single click on it selects
	# again rather than attacking. A gate (CITeleportGate) is not a
	# CICharactor and leaves the selection alone.
	_select_for_talk(node)
	# Out of reach the click walks there first (round 701; READ, 0x793570):
	# beyond 240 from an NPC or 800 from a gate, to a point on the line back
	# to the player, and the talk follows the arrival (_step_talk_approach).
	if node is Node3D and _start_talk_approach(node as Node3D):
		return true
	_open_talk(node)
	return true

## The selection a talk click makes (round 701's review): an NPC replaces a
## selected monster or player (FUN_00778650); a gate does not.
func _select_for_talk(node: Node) -> void:
	if node.has_meta("gate_point_id"):
		return
	_last_attack_target = -1
	_selected_character = -1
	_clear_target()

## Opens the talk window for an NPC or gate holder (the click in reach, or a
## talk approach's arrival): the name, greeting and lines, the ring under an
## NPC.
func _open_talk(node: Node) -> void:
	var npc_name := str(node.get_meta("npc_name"))
	if npc_name == "":
		npc_name = "..."
	var code := str(node.get_meta("npc_code")) if node.has_meta("npc_code") else ""
	_talk_npc_name = npc_name
	_talk_npc_code = code
	_talk_node = node as Node3D
	# The ring under an NPC (round 698; the 0xB045 reply selects a CICharactor,
	# texture 1); a teleport gate is not one and gets none.
	if not node.has_meta("gate_point_id") and node is Node3D:
		_markers().attach("npc:%d" % node.get_instance_id(), GroundMarkers.Kind.NPC)
	# Talking supersedes an attack still walking into reach: the attack would
	# otherwise go out behind the talk window.
	_drop_pending_attack()
	_hud_panels.open_npc_talk(npc_name, _npc_greeting_text(code), _npc_services(code))

## The talk approach (round 701). READ from sro_client.exe:
## - The object click 0x793570 measures the object's +0x24c, the 3-D distance
##   from the local player that CICPlayer::vslot_005 (0x9d6f19..0x9d6f7e)
##   writes for every object each frame. A CICNPC beyond 240.0 (double
##   0xdb9888) and a CITeleportGate (class link 0xef1dac) beyond 800.0
##   (double 0xd83080) are walked to; nearer, the select request 0x7045 goes
##   at once (FUN_0078f5f0), whose 0xB045 reply opens the talk window
##   (FUN_0088b200 -> IF_NPCWindow::FUN_00703ff0).
## - The walk: FUN_0078f8d0(msg, 1, 0) -> FUN_009ec6b0(id, 20.0, range, 0),
##   range 240.0 (float 0xdb9884) for an NPC, 640.0 (float 0xdb9890) for a
##   gate, the near bound 20.0 (float 0xd88108) for both. It picks d =
##   rand() / 32767.0 (double 0xde4808) * (range - 20) + 20 and the point
##   object + d * unit(player - object) (FUN_009ed1e0's vector is its second
##   position less its first: the player less the object), moves the ring
##   there with the ground texture (FUN_00a631e0) and sends the walk through
##   the click filter FUN_009ec240. So the ring lands between 20 and 240 (a
##   gate: 640) short of the target on the line to the player -- not at the
##   click, and not always at the farthest spot.
## - The arrival: FUN_009ec380, every frame, waits for the mover to start
##   (+0x714 != 0) and then to stop (+0x714 == 0, +0x6ec == 0), then calls
##   FUN_0078ff60(0, id) -> FUN_0078f5f0(id): the same select, so the talk
##   window opens on arrival. A ground click clears the pending id
##   (FUN_009ec570 writes +0x20 = 0).
## - The server's select handler (SR_GameServer 0x50faf0) measures with
##   GObjPC::IsWithinInteractionRange (0x4a8e10): 300 for an NPC, 800 for a
##   structure, 3-D; beyond, the reply is an error the client shows nothing
##   for. This client has no select request, so the arrival applies that
##   limit itself (talk_out_of_range) and logs a refusal.
const TALK_APPROACH_NPC_BEYOND := 240.0
const TALK_APPROACH_NPC_RANGE := 240.0
const TALK_APPROACH_GATE_BEYOND := 800.0
const TALK_APPROACH_GATE_RANGE := 640.0
const TALK_APPROACH_NEAR := 20.0

## The approach in progress: {"id": the holder's instance id, "started":
## whether the walk has begun}, {} when none.
var _talk_approach: Dictionary = {}
## The random source for the approach distance (retail's rand()); a test
## seeds it.
var _talk_rng := RandomNumberGenerator.new()

## Whether a click on a target `distance` away walks first (READ, 0x793570).
static func talk_needs_approach(distance: float, structure: bool) -> bool:
	return distance > (TALK_APPROACH_GATE_BEYOND if structure else TALK_APPROACH_NPC_BEYOND)

## The approach point (READ, FUN_009ec6b0): `d` from the target on the line
## to the player. `d` is drawn in [TALK_APPROACH_NEAR, range] by the caller.
static func talk_approach_point(target: Vector3, from: Vector3, d: float) -> Vector3:
	var to_player := from - target
	if to_player.length_squared() < 1e-6:
		return target
	return target + to_player.normalized() * d

## Starts the walk to a target out of talk reach; false when it is in reach.
func _start_talk_approach(node: Node3D) -> bool:
	if player == null:
		return false
	var structure := node.has_meta("gate_point_id")
	var target := node.global_position
	var distance := player.global_position.distance_to(target)
	if not talk_needs_approach(distance, structure):
		return false
	var far := TALK_APPROACH_GATE_RANGE if structure else TALK_APPROACH_NPC_RANGE
	var d := _talk_rng.randf_range(TALK_APPROACH_NEAR, far)
	var point := _walkable_point(talk_approach_point(target, player.global_position, d))
	_markers().place_at(point)
	var took := _issue_walk(point)
	_talk_approach = {"id": node.get_instance_id(), "started": _has_move_target and took == "walk", "point": point}
	print("CLICK: %s '%s' %.1f away (talks within %.0f) -- walking to (%.1f, %.1f, %.1f), %.1f short of it (%s)" % [
		"gate" if structure else "NPC", str(node.get_meta("npc_name", node.name)), distance,
		TALK_APPROACH_GATE_BEYOND if structure else TALK_APPROACH_NPC_BEYOND, point.x, point.y, point.z,
		point.distance_to(target), took])
	return true

## A point on the walkable surface under `p`: the region's walkable graph's
## landing height there, else `p` as it is (OURS: retail sends the 3-D point
## and its mover settles it; this client walks on the graph).
func _walkable_point(p: Vector3) -> Vector3:
	var pair := _nav_graph_for(p)
	if pair.is_empty():
		return p
	var group: Node3D = pair[1]
	var local := group.to_local(p)
	var h := (pair[0] as NavGraph).landing_height_at(local.x, local.z)
	if is_nan(h):
		return p
	return group.to_global(Vector3(local.x, h, local.z))

## Ends a talk approach without talking (a new click, death, a zone change).
func _cancel_talk_approach(why: String) -> void:
	if _talk_approach.is_empty():
		return
	print("CLICK: talk approach dropped (%s)" % why)
	_talk_approach = {}

## Once a physics tick: the arrival of a talk approach (READ, FUN_009ec380):
## once the walk has begun and ended, the talk -- within the server's limit
## (talk_out_of_range), else a logged refusal; a target gone, nothing.
func _step_talk_approach(locked: bool = false) -> void:
	if _talk_approach.is_empty():
		return
	var node := instance_from_id(int(_talk_approach["id"])) as Node3D
	if node == null or not is_instance_valid(node) or not node.is_inside_tree():
		_cancel_talk_approach("the target is gone")
		return
	# A typing or motion lock stops the walk but is no arrival (round 701's
	# review, OURS: retail's walk does not stop for the chat line): the
	# approach waits and walks on when the lock lifts.
	if locked:
		if bool(_talk_approach["started"]):
			_talk_approach["started"] = false
			_talk_approach["resume"] = true
		return
	if bool(_talk_approach.get("resume", false)) and not _has_move_target and _wall_root() == 0:
		_talk_approach["resume"] = false
		_talk_approach["started"] = _issue_walk(_talk_approach["point"]) == "walk" and _has_move_target
		return
	if _has_move_target:
		_talk_approach["started"] = true
		return
	if not bool(_talk_approach["started"]):
		return
	_talk_approach = {}
	var structure := node.has_meta("gate_point_id")
	if talk_out_of_range(player.global_position, node.global_position, structure):
		print("CLICK: arrived %.1f from '%s' -- beyond the server's %.0f, no talk (retail's select reply refuses it silently)" % [
			player.global_position.distance_to(node.global_position), str(node.get_meta("npc_name", node.name)),
			TALK_RANGE_STRUCTURE if structure else TALK_RANGE_NPC])
		return
	print("CLICK: arrived %.1f from '%s' -- talking" % [player.global_position.distance_to(node.global_position), str(node.get_meta("npc_name", node.name))])
	_open_talk(node)

## The NPC's real greeting, resolved from npcchat.txt's SN_ id through the
## text table; "" when the NPC has none (the talk window then shows "...").
func _npc_greeting_text(code: String) -> String:
	if code == "" or _npc_text_table == null:
		return ""
	var pair: Array = _npc_greetings.get(code.to_upper(), [])
	for strid in pair:
		var s := str(strid)
		if s != "" and s != "xxx":
			var resolved := _npc_text_table.get_text(s)
			if resolved != "" and resolved != s:
				return resolved
	return ""

## The services the NPC offers (grounded detection; see NpcServiceReader), as
## Service objects (key + label) for the talk window's clickable options. The
## player's guild state picks a guild NPC's lines (round 521).
func _npc_services(code: String) -> Array:
	if code == "":
		return []
	var out := NpcServiceReader.services_for(code, _npc_shop_set, _guild_id, _guild_master)
	# A teleport gate (round 577, _bind_region_gates): its lines come from its
	# teleportdata point -- the two registration columns and whether any link
	# leaves it (NpcServiceReader.gate_services). "teleport" lists the
	# destinations in the talk box (_open_teleport_list, round 603); the recall lines fall to
	# _on_npc_service_selected's default until they have a server.
	#
	# Since round 642 a teleport NPC gets the same lines: the ferry, airship
	# and tunnel ticket sellers, Jangan's gate soldiers and Constantinople's
	# guides are the associated objects of their teleportdata points
	# (_teleport_point_for_code), and the engine serves them as it serves a
	# gate (docs/protocol/teleport_network.md, "Teleport NPCs (round 642)").
	# Their points carry neither registration flag, so they list the
	# teleport line and the end line.
	var point := _teleport_point_for_code(code)
	if point != null:
		out.append_array(NpcServiceReader.gate_services(
			not _teleport_reader.links_from(point.id).is_empty(), point.interaction7, point.interaction9))
	return out

## The teleport point the thing being talked to stands for: a gate
## structure's (its teleportbuilding code, round 577) or, since round 642, an
## NPC's -- the point whose associated object is the NPC's characterdata id
## (teleportdata column 3; GATE_NPC_CH_FERRY names 2011, NPC_CH_FERRY). The
## NPC's id comes from its code through the NPC tables (_npc_codes, the
## reverse of what places it). null when neither names a point.
func _teleport_point_for_code(code: String) -> TeleportReader.Point:
	if _teleport_reader == null or code == "":
		return null
	var point := _teleport_reader.point_for_building(code)
	if point != null:
		return point
	var up := code.strip_edges().to_upper()
	if _npc_ids_built_from != _npc_codes.size():
		_npc_ids_by_code.clear()
		for npc_id in _npc_codes:
			_npc_ids_by_code[str(_npc_codes[npc_id]).to_upper()] = int(npc_id)
		_npc_ids_built_from = _npc_codes.size()
	return _teleport_reader.point_for_object(int(_npc_ids_by_code.get(up, 0)))

## codename (upper) -> characterdata id, the reverse of _npc_codes, rebuilt
## when that grows (_teleport_point_for_code).
var _npc_ids_by_code: Dictionary = {}
## _npc_codes' size when _npc_ids_by_code was built (-1: never).
var _npc_ids_built_from := -1

## Rebuilds the talk menu if it is still open, after the player's guild state
## changed (round 521): a guild NPC's lines depend on it. It rebuilds in place
## (HudPanels.refresh_npc_talk), so the talk box is not raised above a window
## opened from it and a guild prompt being typed into stays.
func _refresh_open_talk_menu() -> void:
	if _hud_panels == null or _talk_npc_code == "":
		return
	_hud_panels.refresh_npc_talk(_talk_npc_name, _npc_greeting_text(_talk_npc_code), _npc_services(_talk_npc_code))

## Acts on a service chosen in the talk box. Buy opens the NPC's real shop and
## Storage the warehouse. At a guild NPC (round 521), "guild_create" asks for
## a name and founds the guild, and "guild_leave" asks for a confirmation and
## then leaves it. The others (a
## guild master's "guild") are their own systems, still to come, so they say
## so rather than doing nothing silently. A smith lists no Repair line (round
## 512, NpcServiceReader.services_for): repair is the store window's own
## buttons.
func _on_npc_service_selected(key: String) -> void:
	match key:
		"shop":
			if _shop_reader != null and _talk_npc_code != "":
				# The codename also decides the store's repair buttons
				# (HudPanels._show_repair_buttons, round 514).
				_hud_panels.open_shop(_talk_npc_name, _shop_reader.tabs_for(_talk_npc_code), _talk_npc_code)
		"storage":
			_hud_panels.open_storage(_talk_npc_name)
		"guild_create":
			# The name prompt emits guild_create_requested, which
			# _on_guild_create_requested sends. The server holds the gates
			# (level 20, 500,000 gold, a 2-12 byte name; rounds 481/487).
			if NetClient.is_connected_to_server():
				_hud_panels.open_guild_name_prompt(_talk_npc_name)
			else:
				_log_system("Founding a guild needs the server.")
		"guild_leave":
			# Not sent on the click: the prompt's Leave emits
			# guild_leave_requested, which _on_guild_leave_requested sends
			# (the real client opens a window here too; see
			# HudPanels.open_guild_leave_prompt).
			if NetClient.is_connected_to_server():
				_hud_panels.open_guild_leave_prompt(_talk_npc_name)
			else:
				_log_system("Leaving a guild needs the server.")
		"teleport":
			# A Dimensional Gate's 'Select a teleport area:' (round 578): its
			# destinations, in the talk box (round 603).
			_open_teleport_list()
		"recall_designate":
			# A town gate's 'Designate as return/recall point' (round 686):
			# retail's agreement box, then the request.
			_open_recall_designate()
		_:
			_log_system("%s is not available yet." % key.capitalize())

## The gate the return-point box was opened at (a teleportdata id), what its
## OK sends (_on_recall_designate_requested); 0 when none is open.
var _recall_gate_point_id := 0

## Opens the agreement box behind a town gate's 'Designate as return/recall
## point' line (round 686; HudPanels.open_recall_designate_prompt has the
## reading) for the gate being talked to, naming the zone the player stands
## in, as retail's box does.
func _open_recall_designate() -> void:
	if _teleport_reader == null or _hud_panels == null or _talk_npc_code == "":
		return
	var point := _teleport_point_for_code(_talk_npc_code)
	if point == null:
		_log_system("This gate has no teleport point.")
		return
	_recall_gate_point_id = point.id
	_hud_panels.open_recall_designate_prompt(_talk_npc_name, _current_zone_name)

## The box's OK: the request goes out with the gate it was opened at.
func _on_recall_designate_requested() -> void:
	if _recall_gate_point_id == 0:
		return
	if not NetClient.is_connected_to_server():
		_log_system("Designating a return point needs the server.")
		return
	print("World3D: recall designate at point %d (%s)" % [_recall_gate_point_id, _talk_npc_code])
	NetClient.recall_designate(_recall_gate_point_id)

## The server's answer (round 686). READ, Client_OnDesignateRecallResult: on 1 the line
## UIIT_MSG_STATE_REBIRTH_POINT_APPOINT goes to the system window as type 5
## (0x7781b0(5, ...)) and to GDR_WARNING_WND (0x77b580); on 2 retail reads the
## code and shows nothing -- the code goes to the log only.
func _on_recall_designate_result(result: RecallNet.Result) -> void:
	if not result.ok:
		print("World3D: recall designate refused, code %d" % result.code)
		return
	var line := RecallNet.DONE_FALLBACK
	if _ui_text_table != null:
		var t := _ui_text_table.get_text(RecallNet.DONE_STRID, "")
		if t != "" and t != RecallNet.DONE_STRID:
			line = t
	print("SYSLOG recall: %s" % line)
	_log_system(line, HudSystemMessage.TYPE_GAME)
	_show_banner("recall_point", line)

## The gate the destination list was last opened at (a teleportdata id), what
## a destination line sends as the source (_on_teleport_requested); 0 before any.
var _teleport_gate_point_id := 0
## The character's level from the last stats packet (_on_world_stats), for
## the list's display of the level waiver; 0 until one arrives.
var _player_level := 0

## Lists the destinations of the gate being talked to in its talk box (round
## 578's board; the talk box's own lines since round 603, as the client's
## UI_TELEPORT::FUN_006fd3e0 does -- TeleportBoard's header): one line per
## link leaving its teleportdata point, in the link table's file order --
## the order the retail dialog lists them in (UI_TELEPORT::FUN_006fd3e0,
## docs/protocol/teleport_network.md "The client's list, read") -- with the
## link's fee (teleportlink column 3, the word GObjPC::HandleTeleportUse
## charges). The place is the destination's zone name through textdata_object
## (_teleport_place_name), else its teleportdata codename. `waived` shows the
## engine's level waiver (fee zeroed unless the level is above 20,
## `cmp al,0x14; ja` at 0x5136de); it reads the current level where the
## engine reads GetMaxLevel, and the GM and testing waivers are the server's
## to report in the receipt -- srrevamp's display, disclosed in TeleportBoard.
func _open_teleport_list() -> void:
	# No NPC being talked to (a zone change cleared it, _close_gate_ui): no
	# gate to list, and nothing to say.
	if _teleport_reader == null or _hud_panels == null or _talk_npc_code == "":
		return
	var point := _teleport_point_for_code(_talk_npc_code)
	if point == null:
		_log_system("This gate has no teleport point.")
		return
	var entries: Array = []
	var listed := PackedStringArray()
	for link_v in _teleport_reader.links_from(point.id):
		var link: TeleportReader.Link = link_v
		var place := _teleport_place_name(_teleport_reader.place_token(link.to_id))
		if place == "":
			var dest := _teleport_reader.point_by_id(link.to_id)
			place = dest.code if dest != null else str(link.to_id)
		entries.append({"dest_id": link.to_id, "place": place, "fee": link.fee,
			"waived": _player_level > 0 and _player_level <= 20})
		listed.append("%d %s %d" % [link.to_id, place, link.fee])
	_teleport_gate_point_id = point.id
	# _teleport_request_pending is NOT cleared here (round 582): the talk box
	# stays up after a destination is clicked, so click -> reopen the list ->
	# click again before the reply would send a second OpTeleportUse, and the
	# server would charge twice. A request out stays out until its reply or a
	# zone change.
	print("World3D: teleport list at %s (point %d, level %d): %s" % [_talk_npc_code, point.id, _player_level, ", ".join(listed)])
	_hud_panels.open_teleport_list(_talk_npc_name, entries)

## Closes the gate's UI -- the talk box and the destinations it lists -- and
## forgets the NPC being talked to and the list's gate, so
## nothing from a gate left behind can send its links (round 578's review).
## Called on a zone change (_on_change_zone_result), and since round 642's
## review when the player walks out of the interaction range of the gate or
## teleport NPC being talked to (_check_talk_range).
func _close_gate_ui() -> void:
	if _hud_panels != null:
		_hud_panels.close("npctalk")
	_talk_npc_code = ""
	_talk_npc_name = ""
	_talk_node = null
	_teleport_gate_point_id = 0
	_recall_gate_point_id = 0
	_teleport_request_pending = false

## The object the open talk box was opened on by a click (an NPC holder or a
## bound gate), for _check_talk_range; null for a QA talk box.
var _talk_node: Node3D = null

## The interaction range, READ (round 642's review): the server's
## GObjPC::IsWithinInteractionRange (0x4a8e10), which HandleTeleportUse
## applies -- 300.0 for an NPCNPC (.rdata 0xb45c40), 800.0 for a structure
## (0xb46190), a 3-D length. The server refuses a teleport beyond it (4, "too
## far"); the client closes the talk box of a gate or teleport NPC once the
## player walks beyond it, so its destination lines cannot be clicked from
## where the server would refuse them. Only a talk box whose target is a
## teleport point: that the other NPCs' talk uses the same range is not read
## (OURS, disclosed). The server measures horizontally (session reach); this
## check is 3-D, which is never shorter, so it closes no talk box the server
## would still serve.
const TALK_RANGE_NPC := 300.0
const TALK_RANGE_STRUCTURE := 800.0

func _check_talk_range() -> void:
	if _talk_node == null or _hud_panels == null or player == null:
		return
	if not is_instance_valid(_talk_node) or not _talk_node.is_inside_tree():
		_talk_node = null
		return
	if not _hud_panels.is_open("npctalk"):
		_talk_node = null
		return
	if _teleport_point_for_code(_talk_npc_code) == null:
		return
	var structure := _talk_node.has_meta("gate_point_id")
	if talk_out_of_range(player.global_position, _talk_node.global_position, structure):
		print("World3D: walked %.0f from %s (range %.0f) -- the talk box closes" % [
			player.global_position.distance_to(_talk_node.global_position), _talk_npc_code,
			TALK_RANGE_STRUCTURE if structure else TALK_RANGE_NPC])
		_close_gate_ui()

## Whether `from` is beyond the interaction range of a target at `to`: 800 for
## a structure (a bound gate), else 300 (an NPC); the 3-D length, retail's
## `fVar9 <= limit` passing (0x4a8e10).
static func talk_out_of_range(from: Vector3, to: Vector3, structure: bool) -> bool:
	return from.distance_to(to) > (TALK_RANGE_STRUCTURE if structure else TALK_RANGE_NPC)

## A destination line clicked in a gate's talk box (round 603; the board's
## Move in round 578): asks the server to travel from the list's gate to
## dest_id (NetClient.teleport_use, round 576). The reply is
## _on_teleport_result; the arrival _on_change_zone_result.
##
## One request at a time (round 578's review; srrevamp's guard -- the client's
## click path at 0x70293d sends with no such check): a second click before
## the reply would be a second OpTeleportUse, which the server -- with no
## range test -- serves from wherever the first put the player, charging the
## fee again. So a click is ignored while _teleport_request_pending. A
## refusal clears it; an accepted reply does NOT, since the talk box is still
## up until the zone change that follows, and the zone change clears it
## (_close_gate_ui; a refused one after an accepted reply too). Reopening the
## list does NOT (round 582: until then it did, and Move -> reopen -> Move
## before the reply charged twice). A reply
## lost to a dropped connection cannot wedge it: `disconnected` sends this
## instance to Login (_on_disconnected), and the flag leaves the world with it.
func _on_teleport_requested(dest_id: int) -> void:
	if _teleport_request_pending:
		print("World3D: teleport click ignored -- a request is already pending")
		return
	if not NetClient.is_connected_to_server():
		_log_system("Teleporting needs the server.")
		return
	print("World3D: teleport requested %d -> %d" % [_teleport_gate_point_id, dest_id])
	_teleport_request_pending = true
	NetClient.teleport_use(_teleport_gate_point_id, dest_id)

## An OpTeleportUse is out and not yet over (_on_teleport_requested): set on
## the send, cleared by a refusal, by the arrival's zone change
## (_close_gate_ui) or by a refused one after an accepted receipt
## (_on_change_zone_result). An accepted receipt alone does not clear it.
var _teleport_request_pending := false

## The talk box's guild name prompt was submitted (round 521).
func _on_guild_create_requested(guild_name: String) -> void:
	if not NetClient.is_connected_to_server():
		return
	NetClient.create_guild(NetClient.current_character_name, guild_name)

## The talk box's guild leave prompt was confirmed (round 521).
func _on_guild_leave_requested() -> void:
	if not NetClient.is_connected_to_server():
		return
	NetClient.leave_guild(NetClient.current_character_name)

func _try_set_move_target(screen_pos: Vector2) -> void:
	var root := _wall_root()
	if root != 0:
		_log_root("a move to the clicked point", root)
		return
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	_move_by_pick_ray(from, dir, get_world_3d().direct_space_state)

## The walk's click on the world, from the camera ray `from` + `dir` (round
## 653; SkyRun has the reading). The pick reaches SkyRun.PICK_LENGTH (1000)
## from the camera, as retail's SWorld::vslot_034 does: ground or a placed
## object inside it is walked to; a ray that meets nothing there -- the sky,
## or ground farther away -- starts a heading run along the ray's ground
## direction (FUN_0078f8d0 -> FUN_009ebec0). Returns "walk", "run", "keep"
## (a run already on that heading goes on unchanged) or "ignore".
func _move_by_pick_ray(from: Vector3, dir: Vector3, space: PhysicsDirectSpaceState3D) -> String:
	# Only the ground and placed objects can be a destination. Left to the
	# default mask the ray also hit the player's own capsule, the invisible
	# navmesh walls (NAVMESH_WALL_COLLISION_LAYER) and NPC capsules, and a
	# click across the plaza landed on the nearest of those instead -- "the
	# character does not move to the direction you click".
	var hit := space.intersect_ray(SkyRun.pick_query(from, dir, TERRAIN_COLLISION_LAYER, [player.get_rid()]))
	if hit.is_empty():
		return _start_heading_run(dir)
	var point: Vector3 = hit["position"]
	# Within 20 units of an NPC the click does nothing: no walk, no ring
	# (round 698's review; READ, FUN_009ec570 0x9ec5a0..0x9ec5eb,
	# GroundMarkers.NPC_CLICK_BLOCK_SQ).
	var npc := GroundMarkers.npc_blocking(point, _markers().npcs())
	if npc != null:
		print("CLICK: ground at (%.1f, %.1f, %.1f) ignored -- %.1f from NPC %s (retail walks nowhere within 20 of an NPC)" % [
			point.x, point.y, point.z, npc.global_position.distance_to(point), str(npc.get_meta("npc_name", npc.name))])
		return "npc_near"
	# The ring goes to the point (round 698; FUN_009ec570 places it whatever
	# the click filter below decides).
	_markers().place_at(point)
	return _issue_walk(point)

## A walk to `point` as retail's destination record sends it: FUN_009ec570's
## tail and FUN_009ec6b0's (the talk approach, round 701) both store the point
## and run the click filter FUN_009ec240. The caller has placed the ring.
## Returns "walk" or "ignore" (the filter sent nothing).
func _issue_walk(point: Vector3) -> String:
	# A click on the ground supersedes an attack that was walking into reach,
	# and a friendly cast walking to its player (round 622's review) -- even
	# one the filter below does not send (OURS: where retail drops a pending
	# action on a click is not read).
	_pending_attack = {}
	_released_attack = {}
	_pending_friend_cast = {}
	# And a walk to a ground item (round 653's review): its arrival or wall
	# stop would ask for the item from wherever this walk ends.
	_pending_pickup_id = -1
	# The client's own click filter (FUN_009eb2a0, round 637's review
	# follow-up; RemoteFacing.click_rule): with no movement order in effect a
	# click under 5 units away is not sent -- nothing moves; a far click
	# within 5 degrees of a far order snaps the heading instead of turning.
	match RemoteFacing.click_rule(_player_move_order, point - player.position, _move_target - player.position):
		"ignore":
			return "ignore"
		"snap":
			_player_turn_snap = true
	_player_move_order = true
	_move_target = point
	_has_move_target = true
	_move_heading_run = false
	return "walk"

## Starts a heading run along the pick ray `dir` (round 653, SkyRun): the ray's
## ground direction becomes the run's heading, and the body turns to it at the
## client's rate while it runs (FUN_009e08a0 -> FUN_009e02f0, 3 pi rad/s). Not
## started -- "keep" -- when the player is moving and the heading is within 5
## degrees of its facing (FUN_0078f8d0, READ; SkyRun.click_rule).
func _start_heading_run(dir: Vector3) -> String:
	var current := RemoteFacing.heading_of_yaw(player.rotation.y, 0.0)
	var h := SkyRun.heading_of_ray(current, dir)
	# READ: retail keeps the run only while the player moves (state bit 9)
	# AND its move kind is not a walk to a point (+0x6e8 != 1; +0x6e8 is the
	# mover's +0x80: 1 a destination, 2 a heading). A sky click within 5
	# degrees during a ground walk therefore starts a run.
	if SkyRun.click_rule(_has_move_target and _move_heading_run, current, h) == "keep":
		return "keep"
	# The click supersedes an attack or friendly cast walking into reach, as
	# a ground click does.
	_pending_attack = {}
	_released_attack = {}
	_pending_friend_cast = {}
	# And a walk to a ground item (round 653's review): the run is the order
	# now, so a wall that stops it must not ask for the item from there.
	_pending_pickup_id = -1
	var flat := RemoteFacing.facing_of(h)
	_player_move_order = true
	_move_heading_run = true
	_move_heading = h
	# OURS: the order's point, for the ground click's own filter
	# (RemoteFacing.click_rule) should a ground click follow: the pick's reach
	# along the heading. What retail's destination record holds during a
	# heading move is not read.
	_move_target = player.position + Vector3(flat.x, 0.0, flat.y) * SkyRun.PICK_LENGTH
	_has_move_target = true
	_aim_local_player(Vector3(flat.x, 0.0, flat.y))
	# A heading move hides the ring (round 698; retail on its 0xB021 echo).
	if _ground_markers != null:
		_ground_markers.heading_move()
	if _qa_move_log:
		print("MOVE run t=%d ms=%d heading=%.4f wire=%d dir=(%.3f,%.3f)" % [_qa_move_tick + 1, Time.get_ticks_msec(), h, SkyRun.wire_angle(h), flat.x, flat.y])
	return "run"

## The point on the ground or a placed object under a screen point, or null:
## the click-to-move ray, shared with the ground-pick cast (round 617).
func _ground_point_at(screen_pos: Vector2) -> Variant:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	var space_state := get_world_3d().direct_space_state
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
	# Only the ground and placed objects can be a destination. Left to the
	# default mask the ray also hit the player's own capsule, the invisible
	# navmesh walls (NAVMESH_WALL_COLLISION_LAYER) and NPC capsules, and a
	# click across the plaza landed on the nearest of those instead -- "the
	# character does not move to the direction you click".
	query.exclude = [player.get_rid()]
	query.collision_mask = TERRAIN_COLLISION_LAYER
	var hit := space_state.intersect_ray(query)
	if hit.is_empty():
		return null
	return hit["position"]

func _on_send_pressed() -> void:
	var text := chat_input.text.strip_edges()
	chat_input.text = ""
	_send_chat(text)

## The authored chat window's input line, which does the same thing.
func _on_chat_submitted(text: String) -> void:
	_send_chat(text)

func _send_chat(text: String) -> void:
	if text.is_empty():
		return
	# Every slash line goes through the console (scripts/ui/console.gd): it
	# runs the client commands, forwards GM commands to the server, and
	# answers an unknown one with the help line -- never silence. Anything
	# else is ordinary chat.
	if text.begins_with("/") and _console != null and _console.submit(text):
		return
	# A chat line (round 634): the channel from its first character
	# (HudChat.parse_line, 0x7ad400), kept under an index for the echo.
	if _hud_chat != null:
		_hud_chat.own_name = NetClient.current_character_name
		_hud_chat.is_gm = _is_gm
		var req := _hud_chat.request_for(text)
		if req.is_empty():
			return
		print("CHAT SEND: type %d index %d to '%s': %s" % [int(req["type"]), int(req["index"]), String(req["target"]), String(req["message"])])
		NetClient.send_chat(int(req["type"]), int(req["index"]), String(req["target"]), String(req["message"]))
		return
	NetClient.say(text)

## Frees a player wedged into geometry: teleports them back to the zone's own
## entry spawn (a known-open point the server placed them at) and clears any
## velocity. A stopgap until movement is navmesh-constrained -- free-physics
## movement lets the capsule wedge into a concave building corner. Shift+F1's
## zone travel does the same the heavy way; this stays in the zone. The move
## sync in _process sends the new position (it differs from _last_sent_pos).
func _unstuck_player() -> void:
	var result = NetClient.last_enter_world_result
	if result == null or not result.ok:
		_log_system("Unstuck: no spawn point known yet -- try zone travel (Shift+F1).")
		return
	player.velocity = Vector3.ZERO
	# A restored entry's point is where the character logged out (round 573)
	# -- the very spot a player may be wedged at -- so /unstuck lands it at
	# the current zone's landing instead. The move sync reports the landing,
	# as it reports the entry point below: _place_at_region_local leaves
	# _last_sent_pos alone since round 646.
	if result.restored:
		var zone: String = NetClient.current_zone if NetClient.current_zone != "" else result.zone
		if _place_at_zone_landing(zone):
			_log_system("Unstuck: returned to the zone's landing spot.")
			return
	player.position = Vector3(result.x, result.y, result.z)
	_log_system("Unstuck: returned to the zone entry point.")

func _on_disconnected() -> void:
	# Restart / Exit from the System menu and a dropped peer all come here
	# before the scene changes: no ground pick outlives the session.
	_leave_ground_pick("disconnected")
	get_tree().change_scene_to_file("res://scenes/Login.tscn")

# --- Monsters tab ---------------------------------------------------------

## Raycasts straight down (and up, to cover terrain that loaded after this
## was called) through pos's X/Z and returns the real surface height found,
## or pos.y unchanged if nothing was hit -- the same practical safety net
## _snap_player_onto_terrain uses for the player, reused here so monsters
## don't spawn embedded in or floating above the real terrain grid either.
func _terrain_height_at(pos: Vector3) -> float:
	var height := _terrain_hit_height(pos)
	return pos.y if is_nan(height) else height

## The same ray as _terrain_height_at, but a miss says so: NAN when nothing on
## the terrain layer lies under pos's X/Z -- no region there has committed its
## terrain collision yet, or none ever will. A caller that places something
## once and never looks again (a monster body, a ground item) keeps it on a
## retry list on a miss instead of leaving it at the server's height (round
## 572: every Mangyang was drawn at the server's y 0 when the monster list
## beat its region's terrain).
##
## The ray is TerrainCollision.vertical_ray's, off the heightfield's grid
## lines (round 572: a plain vertical ray found nothing under 7 of the 9
## Jangan monsters standing on 97/168's grid vertices), and it passes through
## the scene's two stand-in floors (_stand_in_floor_rids): only real terrain
## counts as ground here.
func _terrain_hit_height(pos: Vector3) -> float:
	var hit := TerrainCollision.vertical_ray(get_world_3d().direct_space_state, pos.x, pos.z,
		pos.y + 1000.0, pos.y - 1000.0,
		TERRAIN_ONLY_COLLISION_MASK, # see its own doc comment -- same "landed on a roof" bug applies to monster placement
		_stand_in_floor_rids())
	if hit.is_empty():
		return NAN
	return hit.position.y + 0.05 * PLAYER_SCALE_RATIO

## The scene's stand-in floors, which sit on the terrain-only layer
## (collision_layer 9, World3D.tscn) but are not terrain: the placeholder
## `Ground` (a 200 x 1 x 200 box at the origin, top at y 0.5), switched off
## when the first terrain group commits (_terrain_commit) and on again by
## _reload_zone_assets, and `VoidCatchFloor` (top at y -1995). A placement ray
## that answered from either would place a body on it for good and never
## retry it: on the loading-screen path the monster list is applied before
## the centre commits, so a body listed within 100 of the origin was drawn on
## the placeholder at 0.898 (round 572's review). _terrain_hit_height -- and
## so every monster, ground-item and player placement that goes through it --
## excludes them. Left as they are for everything else: the player's body
## stands on the placeholder until the terrain commits (move_and_slide, layer
## 1), its ground check keeps _last_grounded_position there (the void-fall
## return), and the snap runs after the centre's commit has switched the
## placeholder off; VoidCatchFloor is the void catch.
func _stand_in_floor_rids() -> Array:
	if _stand_in_rids.is_empty():
		for path in ["Ground", "VoidCatchFloor"]:
			var body := get_node_or_null(path) as CollisionObject3D
			if body != null:
				_stand_in_rids.append(body.get_rid())
	return _stand_in_rids

## The height the region's walkable graph gives a world position: its landing
## height -- the highest walkable surface there, the terrain or a placed
## object's navigation mesh (a bridge, a floor, Jangan's plaza deck) -- the
## same NavGraph.landing_height_at an NPC is placed with (_try_spawn_region_npcs
## asks its region's own graph on the authored region-local position; its doc
## comment has the plaza deck measured 13.8 above the terrain against
## height_at's 12.0 reach). The graph is found here by _nav_graph_for and the
## position carried through the region group's to_local/to_global, the
## click-target and zone-entry placement pattern. NAN when no loaded region
## covers the point, so the caller can fall back to the terrain ray.
## landing_height_at is the HIGHEST surface, so a body under an overpass is
## drawn on top of it -- the limit the NPC path shares.
func _navmesh_height_at(pos: Vector3) -> float:
	var pair := _nav_graph_for(pos)
	if pair.is_empty():
		return NAN
	var group: Node3D = pair[1]
	var local := group.to_local(pos)
	return group.to_global(Vector3(local.x, (pair[0] as NavGraph).landing_height_at(local.x, local.z), local.z)).y

## A moving monster's height (round 557): the navmesh first, the terrain ray
## where no loaded region covers the point. Before this round a walking body
## took _terrain_height_at alone, whose ray sees only the terrain layer
## (TERRAIN_ONLY_COLLISION_MASK), so a body walking onto a structure sank to
## the ground under it. The authored heights are no help: they disagree with
## the navmesh by 10-40 units on real rows (server/internal/worldmap, the
## ToWorld comment). A standing body's placement (_spawn_or_update_monster)
## still takes the ray.
func _moving_monster_height_at(pos: Vector3) -> float:
	var height := _moving_monster_hit_height(pos)
	return pos.y if is_nan(height) else height

## _moving_monster_height_at, but NAN when neither the navmesh nor the
## terrain ray has an answer (_terrain_hit_height).
func _moving_monster_hit_height(pos: Vector3) -> float:
	var nav := _navmesh_height_at(pos)
	if is_nan(nav):
		return _terrain_hit_height(pos)
	return nav

## Books one height answer for a monster's body (a *_hit_height result) and
## returns the height to draw it at. A miss (NAN) returns `fallback` -- what
## the body was placed at before round 572, the server's y -- and puts the
## body on _monster_heights_pending, keeping the frame it first went there; a
## hit takes it off (_monster_height_found) and is returned.
func _book_monster_height(monster_id: int, height: float, fallback: float) -> float:
	if is_nan(height):
		if not _monster_heights_pending.has(monster_id):
			_monster_heights_pending[monster_id] = Engine.get_physics_frames()
		return fallback
	_monster_height_found(monster_id, height)
	return height

## A body's height was found: off the retry list, saying so once if it was on
## it.
func _monster_height_found(monster_id: int, height: float) -> void:
	if not _monster_heights_pending.has(monster_id):
		return
	var frames: int = Engine.get_physics_frames() - int(_monster_heights_pending[monster_id])
	_monster_heights_pending.erase(monster_id)
	# Per monster, so only with the monster log on (round 655).
	if not _mob_logging():
		return
	var snap = _monster_snapshots.get(monster_id)
	print("World3D: monster %d %s height resolved after %d frame(s): %.2f at frame %d" % [
		monster_id, snap.monster_name if snap != null else "?", frames, height, Engine.get_frames_drawn()])

## Creates or moves the real 3D body representing one live server-tracked
## monster (see CombatNet.MonsterSnapshot's X/Y/Z). Those coordinates are
## world-space and are used as sent; only the height is resolved here, off
## the terrain, because the authored height and the walkable graph disagree.
##
## Whether a position is REAL now varies by species, and the server is the
## place that says which. Mangyang stands on its four real npcpos rows in
## region 96/168, converted by the server's worldmap package; every other
## species is still on an own-design anchor. This comment said "not real
## per-monster coordinate data" flatly until 2026-09-15, which stopped being
## true for the first species that day.
## A plain colored capsule for now, same honest
## "placeholder until a real per-species model mapping exists" approach
## World3D already uses for other players before a real character loads --
## no real monster model/skeleton mapping has been found or attempted yet
## (a real next step, not this one).
## Superseded 2026-09-09. Two species were hand-wired here -- a golem and a
## scorpion -- each with its own skeleton path, mesh directory, piece list,
## material path, material layer and a hand-derived piece-to-bone table in
## MonsterAssembler. All of it is replaced by reading the species' own .bsr:
## it names its skeleton and mesh pieces, and the bone mapping is computed
## (SkinnedBsrAssembler). What was seven constants and a table per creature
## is now a name lookup that covers 642 species.

## Species -> model, built once from the player's own Media.pk2, two ways:
## {code name -> .bsr path} (`MOB_CH_MANGNYANG`, the row's own key, the same
## in every archive) and {lowercased display name -> .bsr path} for a
## server that sends no code. The code comes first: a display name is
## whatever language column an archive carries, and on one archive the
## name join drew a Mangyang as a treasure chest and a Weasel as nothing.
## See NpcTableReader.parse_models_by_code / parse_models_by_name.
var _monster_models_by_code: Dictionary = {}
var _monster_models_by_name: Dictionary = {}
## {code name -> OrgObjCodeName} (round 655): the row a `_CLON` takes its
## model from (NpcTableReader.parse_org_codes / model_with_org).
var _monster_org_by_code: Dictionary = {}
var _monster_models_loaded := false
## The object name table as parsed from the player's archive, kept so the
## debug panel can show what language its columns yield.
var _object_name_table: UiTextTable = null

func _monster_model_path(code_name: String, species_name: String) -> String:
	if not _monster_models_loaded:
		_monster_models_loaded = true
		if _media_pk2 == null:
			_media_pk2 = _open_media_pk2_if_set()
		if _media_pk2 != null:
			# One parse of textdata_object.txt for the whole world (the item
			# names use it too) -- see _object_names().
			var names: UiTextTable = _object_names()
			for path in NpcTableReader.MODEL_TABLE_PATHS:
				var entry := ObjectLoader.find_file(_media_pk2, path)
				if entry == null:
					continue
				var bytes := _media_pk2.read_file(entry)
				_monster_models_by_code = NpcTableReader.parse_models_by_code(bytes, _monster_models_by_code, "")
				_monster_org_by_code = NpcTableReader.parse_org_codes(bytes, _monster_org_by_code)
				if names != null:
					_monster_models_by_name = NpcTableReader.parse_models_by_name(bytes, names, _monster_models_by_name)
			var through_org := 0
			for code in _monster_org_by_code:
				if not _monster_models_by_code.has(code) and _monster_models_by_code.has(_monster_org_by_code[code]):
					through_org += 1
			print("World3D: %d species resolvable by code, %d more through their Org row, %d by name" % [
				_monster_models_by_code.size(), through_org, _monster_models_by_name.size()])
	if code_name != "":
		# Its own model, else its Org row's (a `_CLON`; READ, round 655).
		var by_code := NpcTableReader.model_with_org(code_name, _monster_models_by_code, _monster_org_by_code)
		if by_code != "":
			return by_code
	return _monster_models_by_name.get(species_name.to_lower(), "")

func _spawn_or_update_monster(monster: CombatNet.MonsterSnapshot) -> void:
	_monster_snapshots[monster.monster_id] = monster

	if _monster_bodies.has(monster.monster_id):
		# A body walking a server-driven leg keeps where it is drawn unless it
		# has drifted past MonsterMotion.RESYNC_DISTANCE; a standing one goes
		# where the list says. Before round 533 every refresh set the list's
		# position, which would teleport a walking body back by its lag.
		var existing: Node3D = _monster_bodies[monster.monster_id]
		var state = _monster_motion.get(monster.monster_id)
		var moving: bool = state != null and bool(state["moving"])
		var placed := MonsterMotion.reconcile(Vector2(existing.position.x, existing.position.z),
			Vector2(monster.x, monster.z), moving)
		# The height is resolved where the body is placed, not at the list's
		# x/z, which can be up to RESYNC_DISTANCE away -- and for a walking
		# body from the navmesh (round 557), as the leg's own resolves are,
		# so a mid-leg refresh does not drop it off a deck for the two units
		# until the next one.
		# A miss keeps the list's y, as before, and puts the body on the retry
		# list (_book_monster_height); a hit takes it off.
		var at := Vector3(placed.x, monster.y, placed.y)
		var found := _moving_monster_hit_height(at) if moving else _terrain_hit_height(at)
		existing.position = Vector3(placed.x, _book_monster_height(monster.monster_id, found, at.y), placed.y)
		monster.x = placed.x
		monster.z = placed.y
		if state != null:
			state["pos"] = placed
			state["h_xz"] = placed
		var existing_label: Label3D = existing.get_node("Label")
		if existing_label.text != monster.monster_name:
			existing_label.text = monster.monster_name
			_fit_monster_name_box(existing_label)
		return

	# Round 655: no body outside the loaded regions. The snapshot is kept, and
	# the body is built when its region loads (_monster_cells_changed).
	if not _monster_region_loaded(Vector3(monster.x, monster.y, monster.z)):
		_monster_build_queued.erase(monster.monster_id)
		_monster_deferred[monster.monster_id] = true
		return
	_monster_deferred.erase(monster.monster_id)
	_monster_build_queued.erase(monster.monster_id)
	_build_monster_body(monster)

## Builds the body of one monster that has none (round 655: split from
## _spawn_or_update_monster; the body comes from its species' template,
## MonsterDraw.Templates). The caller has checked its region is loaded.
func _build_monster_body(monster: CombatNet.MonsterSnapshot) -> void:
	# Round 661: a species met for the first time has its template assembled
	# off the main thread; the monster waits for it (the pump queues it again
	# when poll() reports the model), its snapshot kept.
	var wanted_model := _monster_model_path(monster.code_name, monster.monster_name)
	if wanted_model != "" and _monster_async_wanted() and not _monster_templates.has(wanted_model):
		# Round 661's review: the archive is opened here, on the main thread,
		# never lazily by the worker (_assemble_monster_model's open).
		if not _monster_assemble.is_valid() and _data_pk2 == null:
			_data_pk2 = _open_pk2_if_set()
		_monster_templates.request(wanted_model, _monster_assemble if _monster_assemble.is_valid() else _assemble_monster_model)
		var waiters: Dictionary = _monster_template_waiters.get(wanted_model, {})
		waiters[monster.monster_id] = true
		_monster_template_waiters[wanted_model] = waiters
		return
	# The ray finds no ground where the monster's region has not committed its
	# terrain collision yet -- the list asked for in _ready routinely arrives
	# before the neighbour cells do -- and nothing else re-places a standing
	# body. So a miss is drawn at the server's y for now and retried each
	# physics frame (_book_monster_height, _step_monster_bodies).
	var pos := Vector3(monster.x, monster.y, monster.z)
	pos.y = _book_monster_height(monster.monster_id, _terrain_hit_height(pos), pos.y)
	var body := Node3D.new()
	body.position = pos

	# The species' own model, resolved from the real tables by the name the
	# server calls it. Nothing is hardcoded per creature: characterdata
	# carries each row's SN_ name key and its .bsr, textdata_object resolves
	# that key to a display name, and joining the two gives 642 species by
	# name. A species the tables do not know still gets the labelled capsule.
	#
	# This replaces two hand-built species (a golem and a scorpion), each
	# with its own skeleton path, mesh directory, piece list, material and a
	# hand-derived piece-to-bone table. All of that is superseded:
	# SkinnedBsrAssembler reads the .bsr's own skeleton and meshes, and
	# computes the bone mapping.
	#
	# Round 655: assembled once per model (MonsterDraw.Templates) and
	# duplicated per body, as the NPCs are (_npc_model_cache).
	var monster_skeleton: Skeleton3D = null
	var monster_model := _monster_model_path(monster.code_name, monster.monster_name)
	var label_height := 2.0 * PLAYER_SCALE_RATIO
	if monster_model != "":
		var assembled := _monster_templates.instance(monster_model,
			_monster_assemble if _monster_assemble.is_valid() else _assemble_monster_model)
		if assembled != null:
			monster_skeleton = assembled.skeleton
			_monster_assembled[monster.monster_id] = assembled
			label_height = _monster_templates.label_height_of(monster_model)
			monster_skeleton.set_meta(MonsterDraw.META_CULL, true)
			monster_skeleton.set_meta(MonsterDraw.META_HIDE, true)
			# Every body of this model has its template's bones (round 664,
			# MonsterCrowd.pose_at): its clips' bone indices are found once.
			monster_skeleton.set_meta(MonsterCrowd.META_LAYOUT, monster_model)
			# The class's model scale (round 660, MonsterDraw.class_scale:
			# champion 1.5, giant 3.0, elite 1.7 -- READ, CICMonster::vslot_025
			# 0x9d3995), with the label, the cull radius and the collider
			# grown by it.
			var class_scale := MonsterDraw.class_scale(monster.rarity)
			if class_scale != 1.0:
				monster_skeleton.scale = Vector3.ONE * class_scale
				label_height *= class_scale
			monster_skeleton.set_meta(MonsterDraw.META_RADIUS, _monster_templates.radius_of(monster_model) * class_scale)
			_animate(assembled)
	# Says which of the three ways a monster can come out wrong happened:
	# the species not in the tables, the model not assembling, or a real
	# model placed somewhere the player will never be. Per monster, so only
	# with the monster log on (round 655); the build summary counts them.
	if monster_skeleton == null:
		_monster_build_capsules += 1
	if _mob_logging():
		print("World3D: monster %s (%s) -> model '%s' skeleton=%s at %.0f,%.0f,%.0f (%.0f from the player)%s" % [
			monster.monster_name, monster.code_name if monster.code_name != "" else "no code",
			monster_model, "yes" if monster_skeleton != null else "NO",
			pos.x, pos.y, pos.z, pos.distance_to(player.global_position),
			" (height pending: no ground under it yet)" if _monster_heights_pending.has(monster.monster_id) else ""])

	# Real model height varies a lot by species/asset (real monster
	# skeletons are nowhere near the human PLAYER_SCALE_RATIO-derived
	# height, unscaled real native units) -- computed directly from the
	# real assembled skeleton's own bone bounds rather than reusing the
	# capsule-calibrated label offset, which would float the label wildly
	# too high (or low) above a real model of very different real size.
	# (MonsterDraw.label_height, once per template since round 655.)
	if monster_skeleton != null:
		body.add_child(monster_skeleton)
	else:
		var mesh := MeshInstance3D.new()
		var capsule := CapsuleMesh.new()
		capsule.radius = 0.5 * PLAYER_SCALE_RATIO
		capsule.height = 1.6 * PLAYER_SCALE_RATIO
		mesh.mesh = capsule
		var mat := StandardMaterial3D.new()
		mat.albedo_color = Color(0.55, 0.15, 0.1) # dark red -- visually distinct from other players' capsules
		mesh.material_override = mat
		mesh.position.y = 0.8 * PLAYER_SCALE_RATIO
		body.add_child(mesh)

	var label := _name_plate(monster.monster_name,
		label_height / (1.0 + NAME_PLATE_CLEARANCE_FRACTION))
	label.name = "Label"
	_monster_name_look(label)
	body.add_child(label)
	# A party monster's mark beside its name (round 660, _party_mark).
	if monster.party:
		var mark := _party_mark(label)
		if mark != null:
			label.add_child(mark)
	# A clickable collider so a left click on the monster selects or attacks
	# it (_pick_character), tagged with the id the attack is sent for.
	body.set_meta("monster_id", monster.monster_id)
	# The model drawn, which is what its measured front is keyed by
	# (MonsterMotion.front_of); "" for the capsule.
	body.set_meta("model", monster_model if monster_skeleton != null else "")
	body.add_child(_monster_collider(label_height))

	if _qa_split != null and not _qa_split_off.is_empty():
		_qa_split_strip(body, monster_skeleton)
	other_entities.add_child(body)
	_monster_bodies[monster.monster_id] = body
	_monster_builds += 1
	# It fades into existence over 2.0 s, as retail's spawn does (round 676,
	# AppearFade: READ, CICharactor vslot 0x6c FUN_009d17e0 -> CIDecoAppear).
	_appear_fades.start(body)
	# Its buffs' auras, if the zone told any (round 646, BuffRoster).
	_fx_resync_owner(_fx_owner_key(monster.monster_id, SkillNet.OWNER_MONSTER), "its body was built")
	# Its sounds: keyed by its own sound object (MOB_CH_MANGNYANG ->
	# MOB_MANGNYANG), with no footstep material -- the handler builds a
	# monster's key without one.
	if monster_skeleton != null and _monster_assembled.has(monster.monster_id):
		var sound_owner := AnimSounds.Owner.new()
		sound_owner.label = "monster %d %s" % [monster.monster_id, monster.code_name]
		sound_owner.token = _sound_object_for(monster.code_name)
		sound_owner.parsed = (_monster_assembled[monster.monster_id] as SkinnedBsrAssembler.AssembledCharacter).parsed
		sound_owner.node = body
		# Only whether it stands on a navmesh cell matters for a monster's
		# footstep (0xa6ffc0 returns early without one); its key has no material.
		sound_owner.material = func() -> int: return _audio_material_at(body.global_position, -2) if is_instance_valid(body) else -1
		_anim_sounds.register(monster_skeleton, sound_owner)

# --- Many monsters (round 655) ------------------------------------------------
#
# MonsterDraw has the rules; what follows is the glue: the species templates,
# the build queue and its per-frame budget, and the region gate.

## One template per species model (MonsterDraw.Templates), freed with the
## world (_exit_tree). Kept across zone changes, like _npc_model_cache.
var _monster_templates := MonsterDraw.Templates.new()
## Bodies fading into existence (round 676, AppearFade): every monster body
## built and every other player's body; and bodies fading out of it (round
## 677, _fade_out_body), which free themselves. Stepped in _physics_process.
var _appear_fades := AppearFade.Fades.new()
## How a template is assembled: the model's own `.bsr` out of Data.pk2. A
## Callable so the headless test can hand it a synthetic model.
var _monster_assemble := Callable()
## Round 661: a species' template is assembled on a WorkerThreadPool task
## (MonsterDraw.Templates.request) and its first bodies wait for it, instead
## of the frame that met the species assembling it on the main thread. On
## whenever the threaded load is (SRREVAMP_SYNC_LOAD unset) and the model
## comes from the archive; a test with its own assembler sets it itself.
var _monster_async_templates := true
## Whether the off-thread assembly also runs a test's own assembler
## (_monster_assemble); round 655's tests keep the synchronous path.
var _monster_async_with_hook := false
## Monsters waiting for their species' template: model -> {monster id: true}.
var _monster_template_waiters := {}
## Monsters listed but not built yet, oldest first, and the same ids as a set.
var _monster_build_queue: Array[int] = []
var _monster_build_queued := {}
## Monsters whose region is not loaded: a snapshot, no body. Built when their
## region loads (_monster_cells_changed).
var _monster_deferred := {}
## Set when a region cell loads or unloads, so the next pump re-sorts the
## deferred monsters and the bodies against the loaded cells.
var _monster_cells_dirty := false
## Bodies built, of them capsules, and bodies dropped with their region --
## for the build summary line.
var _monster_builds := 0
var _monster_build_capsules := 0
var _monster_region_drops := 0
## When the queue last became non-empty (usec) and the frames it took, for
## the summary printed when it drains.
var _monster_queue_started_usec := -1
var _monster_queue_frames := 0
var _monster_queue_longest_usec := 0

## Whether a species' template is assembled off the main thread (round 661):
## the flag, the threaded load, and -- unless a test forces it -- the
## archive's own assembler.
func _monster_async_wanted() -> bool:
	return _monster_async_templates and _threaded_load() and (not _monster_assemble.is_valid() or _monster_async_with_hook)

func _assemble_monster_model(model: String) -> SkinnedBsrAssembler.AssembledCharacter:
	if _data_pk2 == null:
		_data_pk2 = _open_pk2_if_set()
	if _data_pk2 == null:
		return null
	return SkinnedBsrAssembler.assemble_from_archive(_data_pk2, model, true)

## Whether a world position lies in a loaded region cell (the streamed grid's
## _grid.loaded_cells, RegionGridState.cell_at). With no grid -- a loose dev
## file, the headless tests -- there is nothing to gate against: true.
func _monster_region_loaded(pos: Vector3) -> bool:
	if not _grid_has_origin:
		return true
	var cell := RegionGridState.cell_at(pos - _grid_origin_world)
	return _grid.loaded_cells.has("%d_%d" % [cell.x, cell.y])

## Queues a listed monster's body for _pump_monster_builds.
func _queue_monster_build(monster_id: int) -> void:
	if _monster_build_queued.has(monster_id) or _monster_bodies.has(monster_id):
		return
	if _monster_build_queue.is_empty():
		_monster_queue_started_usec = Time.get_ticks_usec()
		_monster_queue_frames = 0
		_monster_queue_longest_usec = 0
		_monster_builds = 0
		_monster_build_capsules = 0
	_monster_build_queued[monster_id] = true
	_monster_build_queue.append(monster_id)

## One frame's share of the body builds: queued monsters until
## MonsterDraw.BUILD_BUDGET_USEC is spent (at least MIN_BUILDS_PER_FRAME). A
## monster gone from the snapshots (dead, or left the list) is skipped; one
## whose region is not loaded is deferred. Returns the bodies built.
func _pump_monster_builds(budget_usec: int = MonsterDraw.BUILD_BUDGET_USEC) -> int:
	# Round 661: the templates assembled off the main thread since the last
	# frame, and the monsters that waited for them back on the queue.
	for model in _monster_templates.poll():
		var waiters: Dictionary = _monster_template_waiters.get(model, {})
		_monster_template_waiters.erase(model)
		for monster_id in waiters.keys():
			_queue_monster_build(monster_id)
	if _monster_cells_dirty:
		_monster_cells_dirty = false
		_monster_cells_changed()
	if _monster_build_queue.is_empty():
		return 0
	var started := Time.get_ticks_usec()
	var built := 0
	var taken := 0
	while taken < _monster_build_queue.size():
		if built >= MonsterDraw.MIN_BUILDS_PER_FRAME and Time.get_ticks_usec() - started >= budget_usec:
			break
		var monster_id: int = _monster_build_queue[taken]
		taken += 1
		_monster_build_queued.erase(monster_id)
		var snap = _monster_snapshots.get(monster_id)
		if snap == null or _monster_bodies.has(monster_id) or _dying_until.has(monster_id):
			continue
		var before := _monster_bodies.size()
		_spawn_or_update_monster(snap)
		if _monster_bodies.size() > before:
			built += 1
	_monster_build_queue = _monster_build_queue.slice(taken)
	var spent := Time.get_ticks_usec() - started
	_monster_queue_frames += 1
	_monster_queue_longest_usec = maxi(_monster_queue_longest_usec, spent)
	if _monster_build_queue.is_empty() and _monster_queue_started_usec >= 0:
		print("World3D: %d monster bod(ies) built over %d frame(s) in %.0f ms, longest frame %.1f ms (%d capsule(s)); %d species template(s), %d assembled in %.0f ms, %d instanced in %.0f ms; %d waiting for their region" % [
			_monster_builds, _monster_queue_frames, (Time.get_ticks_usec() - _monster_queue_started_usec) / 1000.0,
			_monster_queue_longest_usec / 1000.0, _monster_build_capsules, _monster_templates.size(),
			_monster_templates.assembles, _monster_templates.assemble_usec / 1000.0,
			_monster_templates.instances, _monster_templates.instance_usec / 1000.0, _monster_deferred.size()])
		_monster_queue_started_usec = -1
	return built

## A region cell loaded or unloaded: deferred monsters whose region is now
## loaded are queued, and bodies whose region has gone are dropped (their
## snapshots kept, deferred until it loads again).
func _monster_cells_changed() -> void:
	for monster_id in _monster_deferred.keys():
		var snap = _monster_snapshots.get(monster_id)
		if snap == null:
			_monster_deferred.erase(monster_id)
			continue
		if _monster_region_loaded(Vector3(snap.x, snap.y, snap.z)):
			_monster_deferred.erase(monster_id)
			_queue_monster_build(monster_id)
	var dropped := 0
	for monster_id in _monster_bodies.keys():
		if _dying_until.has(monster_id):
			continue
		var body = _monster_bodies[monster_id]
		if body == null or not is_instance_valid(body):
			continue
		if _monster_region_loaded((body as Node3D).position):
			continue
		_free_monster_body(monster_id, true)
		if _monster_snapshots.has(monster_id):
			_monster_deferred[monster_id] = true
		dropped += 1
	if dropped > 0:
		_monster_region_drops += dropped
		print("World3D: %d monster bod(ies) dropped with their region; %d waiting for their region" % [dropped, _monster_deferred.size()])

## Takes one monster's body out of the world and everything kept about the
## body (not the snapshot): the list's removal, a region unloading, a death
## played out. `keep_buffs` (a region unloading: the monster lives on) keeps
## the buffs the zone told of it, so the rebuilt body's auras come back
## (_fx_resync_owner). `fade` (round 677: a despawn -- the monster left the
## area, entered a town, or its corpse's time ran out) hands the body to
## _fade_out_body instead of freeing it: it fades over 1.5 s and frees
## itself, no longer this monster's body.
func _free_monster_body(monster_id: int, keep_buffs: bool = false, fade: bool = false) -> void:
	var body = _monster_bodies.get(monster_id)
	if body != null and is_instance_valid(body):
		if fade:
			if monster_id == _last_attack_target:
				# The target window closes as the fade starts. INFERRED: retail
				# takes the object out of its id hash and zeroes its id at once
				# (IGIDObject::FUN_009c3270), so nothing names it any more.
				_clear_target()
				_last_attack_target = -1
				_target_buff_book.drop(_fx_owner_key(monster_id, SkillNet.OWNER_MONSTER))
			if not _pending_attack.is_empty() and int(_pending_attack["monster"]) == monster_id:
				_drop_pending_attack()
			# It stops where it is (OURS: whether retail's mover runs on for
			# the 1.5 s was not read).
			if _monster_motion.has(monster_id) and bool((_monster_motion[monster_id] as Dictionary).get("moving", false)):
				_set_monster_gait(monster_id, BsrReader.AnimationEntry.TYPE_STAND)
			_fade_out_body(body as Node3D)
		else:
			(body as Node).queue_free()
	_monster_bodies.erase(monster_id)
	SkillEffects.detach_owner(_fx_owner_key(monster_id, 1))
	if not keep_buffs:
		_fx_owner_buffs.erase(_fx_owner_key(monster_id, 1))
	_monster_assembled.erase(monster_id)
	_dying_until.erase(monster_id)
	_monster_motion.erase(monster_id)
	_monster_heights_pending.erase(monster_id)
	_strike_waits.erase(monster_id)

## Forgets a monster entirely: its body, its snapshot and any queued or
## deferred build. `fade`: its body fades out (_free_monster_body).
func _forget_monster(monster_id: int, fade: bool = false) -> void:
	_free_monster_body(monster_id, false, fade)
	_monster_snapshots.erase(monster_id)
	_monster_deferred.erase(monster_id)
	_monster_build_queued.erase(monster_id)

## A body leaving the world fades out (round 677, AppearFade.Fades.start_out;
## READ: a despawn makes a 1.5 s CIDecoDisappear, docs/protocol/appear_fade.md)
## and frees itself when the fade ends. From here it is nobody's body: the
## caller has dropped it from its map (retail's FUN_009c3270 takes the
## object out of the id hash before the deco starts), so the same id coming
## back is a fresh body fading in beside this one fading out, as in retail.
## Its click collider goes now, so it cannot be picked or attacked (OURS;
## READ only that its id is zeroed -- what retail's pick, FUN_0078ee20,
## does with a fading body it still lists is OPEN). Its name plate and party
## mark stay as they are until it is freed: retail draws the name while the
## object exists, at full alpha (FUN_009d20d0 -> FUN_009d0a80, no id test;
## the deco never touches it). Its effects (buff auras) are detached by the
## caller (READ: vslot 0x3c(1, 0) -> FUN_009ccf50 stops the object's
## attached list at the despawn).
func _fade_out_body(body: Node3D) -> void:
	if body == null or not is_instance_valid(body) or body.is_queued_for_deletion():
		return
	_drop_click_body(body)
	if not _mob_logging():
		_appear_fades.start_out(body)
		return
	var what := "monster %d" % int(body.get_meta("monster_id")) if body.has_meta("monster_id") \
		else "player %d" % int(body.get_meta("character_id")) if body.has_meta("character_id") \
		else "ground item %d" % int(body.get_meta("ground_item_id", -1))
	var started_ms := Time.get_ticks_msec()
	print("World3D: %s fades out over %.1fs (ticks %d)" % [what, AppearFade.DISAPPEAR_SECONDS, started_ms])
	_appear_fades.start_out(body, AppearFade.DISAPPEAR_SECONDS, func(_m: Node) -> void:
		print("World3D: %s faded out and is freed after %d ms" % [what, Time.get_ticks_msec() - started_ms]))

## Takes a body's click colliders away: out of the physics layers at once,
## so a ray this frame passes through to what is behind, and freed. A dead
## monster's (round 677's review) and a fading body's.
func _drop_click_body(body: Node3D) -> void:
	if body == null or not is_instance_valid(body):
		return
	for c in body.get_children():
		if c is CollisionObject3D:
			(c as CollisionObject3D).collision_layer = 0
			c.queue_free()

## A click-target collider for a monster: a capsule as tall as the model,
## on the monster layer only, so a ray can pick it out for an attack while
## it neither blocks movement nor catches the ground-snap ray.
func _monster_collider(height: float) -> StaticBody3D:
	var shape := CapsuleShape3D.new()
	shape.height = maxf(height, 1.0)
	shape.radius = maxf(height * 0.3, 1.0)
	var sb := StaticBody3D.new()
	sb.name = "ClickBody"
	sb.collision_layer = MONSTER_COLLISION_LAYER
	sb.collision_mask = 0
	var cs := CollisionShape3D.new()
	cs.shape = shape
	cs.position = Vector3(0.0, shape.height * 0.5, 0.0)
	sb.add_child(cs)
	return sb

## The monster under a screen point (the monster layer only), or -1: the
## double click's pick (_dispatch_double_click). A dying monster is none.
func _monster_at(screen_pos: Vector2) -> int:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
	query.exclude = [player.get_rid()]
	query.collision_mask = MONSTER_COLLISION_LAYER
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	if hit.is_empty():
		return -1
	var node := hit["collider"] as Node
	while node != null and not node.has_meta("monster_id"):
		node = node.get_parent()
	if node == null or _dying_until.has(int(node.get_meta("monster_id"))):
		return -1
	return int(node.get_meta("monster_id"))

## Side-effect-free version of both click rays, for the QA hook: what the
## NPC-layer ray and the monster-layer ray each hit at this screen point,
## whatever order the dispatcher runs them in.
func _probe_click_rays(screen_pos: Vector2) -> void:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	for probe in [["npc", NPC_COLLISION_LAYER | GATE_PICK_COLLISION_LAYER, "npc_name"], ["monster", MONSTER_COLLISION_LAYER, "monster_id"]]:
		var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
		query.exclude = [player.get_rid()]
		query.collision_mask = int(probe[1])
		var hit := get_world_3d().direct_space_state.intersect_ray(query)
		print("QA CLICK   probe %-7s layer 0b%s: %s" % [probe[0], String.num_int64(int(probe[1]), 2), _describe_click_hit(hit, str(probe[2]))])

## The items on the ground: a GroundItems node under other_entities, fed by
## the server's list and its spawned/removed/released broadcasts, drawing
## each stack with its drop model out of Data.pk2. Skipped without an
## archive (nothing to draw them with).
func _try_setup_ground_items() -> void:
	if _data_pk2 == null:
		return
	_ground_items = GroundItems.new()
	_ground_items.name = "GroundItems"
	# Unswept plates: an item's name has its own visibility rule (_name_plate).
	_ground_items.setup(_data_pk2, _item_drop_models, _item_display_name, _name_plate.bind(false), _terrain_hit_height)
	other_entities.add_child(_ground_items)

## The object-name table (textdata_object.txt), parsed once on first use and
## shared with the monster-model loader, which fills the same variable.
## This is where item and NPC `SN_` names live -- the UI-string catalog
## (_ui_text_table, textuisystem.txt) has none of the 9,315 `SN_ITEM_` keys,
## which is how a dropped potion came to be labelled with its mangled
## column-3 name ("HP ?? ??") while the same item's tooltip, resolved by the
## HUD through this table, read "HP Recovery Herb".
func _object_names() -> UiTextTable:
	if _object_name_table == null and _media_pk2 != null:
		var entry := ObjectLoader.find_file(_media_pk2, NpcTableReader.OBJECT_NAME_TABLE_PATH)
		if entry != null:
			_object_name_table = UiTextTable.parse(_media_pk2.read_file(entry))
	return _object_name_table

## The client's own English name for an item id, resolved the way the
## tooltips resolve it (ItemTableReader.Item.display_name through the
## object-name table), or "" -- never an id. A key whose first row has no
## English resolves to what the client draws for it, typically "0"
## (UiTextTable.parse).
## A name plate or a chat line that gets "" shows nothing for the name.
func _item_display_name(item_id: int) -> String:
	var row = _item_rows.get(item_id)
	if row == null:
		return ""
	return row.display_name(_object_names())

## What a chat or log line calls an item: its display name, else its code
## name (the game's own `ITEM_*` identifier from the item table -- English,
## and a real fact about the item, unlike an invented label), else nothing.
## The code name is for lines, not plates: a plate shows the name or nothing.
func _item_label_for_line(item_id: int) -> String:
	var name := _item_display_name(item_id)
	if name != "":
		return name
	var row = _item_rows.get(item_id)
	if row != null and String(row.code_name) != "":
		return String(row.code_name)
	return ""

func _on_ground_item_list_result(items: Array, error: String) -> void:
	if error != "":
		print("World3D: ground item list: %s" % error)
		return
	if _ground_items == null:
		return
	_ground_items.apply_list(items)
	print("World3D: %d item(s) on the ground in this zone (%d with no ground under them yet)" % [
		_ground_items.count(), _ground_items.pending_count()])

func _on_ground_item_spawned(snap: GroundItemsNet.Snapshot) -> void:
	if _ground_items == null:
		return
	_ground_items.spawn(snap)
	# CIItem::vslot_024: a drop sounds its kind -- gold and elixirs only, the
	# box and bag rows are commented out (read; UiSounds.item_dropped). That
	# this signal is retail's fresh drop (its +0xec == 0) is inferred.
	if _hud_panels != null:
		UiSounds.item_dropped(_hud_panels.item_types(snap.item_id), snap.gold, "ground item %d dropped" % snap.id)
	print("World3D: ground item %d (%s) at %.1f,%.1f,%.1f owner %d (%.1f from the player)" % [
		snap.id, _ground_items.label_text(snap), snap.x, snap.y, snap.z, snap.owner_id,
		_ground_items.position_of(snap.id).distance_to(player.global_position)])
	# QA: step onto the drop and pick it, so a render's log carries the
	# server's own verdict and the bag after (see the hook list above).
	if OS.get_environment("SRREVAMP_QA_PICKUP") != "" and NetClient.is_connected_to_server():
		_pending_pickup_id = snap.id
		var pos := _ground_items.position_of(snap.id)
		player.global_position = pos + Vector3(2.0, 0.0, 0.0)
		player.velocity = Vector3.ZERO
		# Tell the server where we now stand and let that packet land before the
		# pick, so its range check sees us on the item, not where we were.
		NetClient.move_to(player.position.x, player.position.y, player.position.z, _position_relocated())
		_last_sent_pos = player.position
		_walked_since_send = 0.0
		print("QA PICKUP: standing at %.1f,%.1f,%.1f next to ground item %d; picking shortly" % [
			player.global_position.x, player.global_position.y, player.global_position.z, snap.id])
		# A moment on the ground (frames show the drop lying there), then pick.
		# The attack loop is gated off while _pending_pickup_id is set, so
		# nothing teleports us away in between.
		await get_tree().create_timer(1.2).timeout
		if _ground_items != null and _ground_items.has(snap.id):
			NetClient.move_to(player.position.x, player.position.y, player.position.z, _position_relocated())
			await get_tree().create_timer(0.2).timeout
			NetClient.pick_up(NetClient.current_character_name, snap.id)

func _on_ground_item_removed(removed: GroundItemsNet.Removed) -> void:
	if _ground_items == null:
		return
	# It fades out over 1.5 s (round 677; READ: CIItem's vslot 0x4c,
	# 0x9e21c0, makes the same 1.5 s CIDecoDisappear on a despawn).
	_ground_items.remove(removed.id, _fade_out_body)
	if _pending_pickup_id == removed.id:
		_pending_pickup_id = -1
	print("World3D: ground item %d gone (%s)" % [removed.id,
		"picked by %d" % removed.picker_id if removed.reason == GroundItemsNet.REMOVED_PICKED else "expired"])

func _on_ground_item_owner_released(ground_id: int) -> void:
	if _ground_items != null:
		_ground_items.release_owner(ground_id)

## The server's verdict on our pick. Too far keeps the walk going (the
## arrival branch of the movement code asks again); anything else ends it.
## A success refreshes what changed hands: the bag, or the gold on the stats.
func _on_pick_up_result(result: GroundItemsNet.PickUpResult) -> void:
	_pickup_inflight = false
	match result.code:
		0:
			_pending_pickup_id = -1
			# The item's own name in the chat line, never its id (a name the
			# table cannot give falls to the code name, see _item_label_for_line).
			var what: String
			if result.gold:
				what = "%d gold" % result.quantity
				print("World3D: picked up %s (ground item %d, item %d)" % [what, result.ground_id, result.item_id])
				# Retail's own line (round 639, READ): the ground-item handler
				# 0x87ba20 writes UIIT_MSG_STATE_GAIN_GOLD ("[%d]gold gained.")
				# for the gold kind (0xfe) through 0x778210 with type 1, the
				# GAIN filter (0x87bef4..0x87bf20).
				var gold_t := _ui_text_table.get_text("UIIT_MSG_STATE_GAIN_GOLD", "") if _ui_text_table != null else ""
				_log_system(gold_t.replace("%d", str(result.quantity)) if gold_t.contains("%d") else "Picked up %s." % what,
					HudSystemMessage.TYPE_GAIN)
			else:
				var label := _item_label_for_line(result.item_id)
				what = ("%dx %s" % [result.quantity, label]) if label != "" else ("%dx" % result.quantity)
				print("World3D: picked up %s (ground item %d, item %d)" % [what, result.ground_id, result.item_id])
				# 0x87ba20's item lines are type 1 too (0x87bec4..0x87becf).
				_log_system(_acquired_item_line(label, result.quantity), HudSystemMessage.TYPE_GAIN)
			if NetClient.is_connected_to_server():
				if result.gold:
					NetClient.character_stats(NetClient.current_character_name)
				else:
					NetClient.list_inventory(NetClient.current_character_name)
			if OS.get_environment("SRREVAMP_QA_PICKUP") != "":
				print("QA PICKUP: result 0 -> %s" % what)
		GroundItemsNet.ERR_TOO_FAR:
			print("World3D: ground item %d is out of reach (%.0f units) -- walking to it" % [result.ground_id, GroundItemsNet.PICK_RANGE])
			if OS.get_environment("SRREVAMP_QA_PICKUP") != "":
				print("QA PICKUP: result 4 (too far)")
		_:
			_pending_pickup_id = -1
			print("World3D: cannot pick up ground item %d (server code 0x%x)" % [result.ground_id, result.code])
			# ...and SAY so. A refusal used to go to the log file only, so a
			# player saw the item stay on the ground with no reason given and
			# reported it as "loot does not go into my inventory" (playtest
			# 2026-09-20, item 9). The server has the reason; show it.
			_log_system(_pick_up_refusal_line(result.code))
			if OS.get_environment("SRREVAMP_QA_PICKUP") != "":
				print("QA PICKUP: result 0x%x" % result.code)

## A server refusal code in words.
const ErrorText = preload("res://scripts/net/error_text.gd")
## Round 651: a berserk body's colour, size, fire, sounds and the own flash.
const BerserkLook = preload("res://scripts/effects/berserk_look.gd")

## The server's pick-up refusal in words: the game's own message from the UI
## text table where the client has one (0x1812, 0x1839), our own wording
## otherwise. The code-to-message table, its grounding in sro_client.exe and
## the codes left out are in scripts/net/error_text.gd.
func _pick_up_refusal_line(code: int) -> String:
	return ErrorText.pick_up_line(code, _ui_text_table)

## A left click on a ground item picks it up, the way clicking one does in
## the original. Ray-tests the ground-item layer only; on a hit, asks the
## server (which judges the 10-unit range and the ownership) and, so the
## player ends up in reach if they were not, walks toward the item; the
## arrival branch asks again. Returns true so the click does not also walk.
func _try_pick_up_item(screen_pos: Vector2) -> bool:
	if _ground_items == null or not NetClient.is_connected_to_server():
		return false
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
	query.exclude = [player.get_rid()]
	query.collision_mask = GroundItems.GROUND_ITEM_COLLISION_LAYER
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	if hit.is_empty():
		return false
	var node := hit["collider"] as Node
	while node != null and not node.has_meta("ground_item_id"):
		node = node.get_parent()
	if node == null:
		return false
	_pick_up_ground_item(int(node.get_meta("ground_item_id")))
	return true

## Picks up a ground item: a click on it, or G (_key_pick_up_nearest). Asks
## the server, which judges the 10-unit range and the ownership, and, so the
## player ends up in reach if they were not, walks toward the item; the
## arrival branch asks again.
func _pick_up_ground_item(ground_id: int) -> void:
	_pending_pickup_id = ground_id
	# Only WALK if the drop is actually out of reach. Setting a move target
	# unconditionally is what made a pick-up report its own success as a
	# failure (playtest 2026-09-20): gold falls at your feet, so the arrival
	# branch fired immediately and sent a SECOND pick_up for the same id. The
	# server granted the first, removed the item, and answered the duplicate
	# with 0x1839 (3 since round 493, the engine's code for a drop that is not
	# there) -- which this client then displayed as "your inventory may be
	# full". The player had the gold and an error message about it.
	var target := _ground_items.position_of(ground_id)
	# Round 640 (OURS): rooted, the pick-up is asked for from where the player
	# stands and the server judges the range.
	var pick_root := _wall_root()
	if pick_root != 0 and target != Vector3.INF and player.global_position.distance_to(target) > GroundItemsNet.PICK_RANGE:
		_log_root("the walk to ground item %d" % ground_id, pick_root)
	if pick_root == 0 and target != Vector3.INF and player.global_position.distance_to(target) > GroundItemsNet.PICK_RANGE:
		_move_target = target
		_has_move_target = true
		_move_heading_run = false
		_pending_attack = {}
		_released_attack = {}
	else:
		# Picked up from where the player stands: an attack still walking into
		# reach ends here, with its walk.
		_drop_pending_attack()
	_pickup_inflight = true
	_pickup_inflight_since_ms = Time.get_ticks_msec()
	NetClient.pick_up(NetClient.current_character_name, ground_id)

## Reconciles _monster_bodies against live, the authoritative full monster
## list for the player's current zone (see _on_monster_list_result) --
## updates the body of everything in live that has one, queues a body for
## the rest (round 655: built over the next frames by _pump_monster_builds,
## and only in a loaded region), removes any tracked body no longer present
## (dead, or the player changed zones), the same snapshot-driven approach
## world.Hub's own zone-change teardown uses rather than trying to diff
## individual damaged/died events.
func _sync_monster_bodies(live: Array) -> void:
	var live_ids := {}
	for m in live:
		live_ids[m.monster_id] = true
		if _monster_bodies.has(m.monster_id):
			_spawn_or_update_monster(m)
			continue
		_monster_snapshots[m.monster_id] = m
		if _dying_until.has(m.monster_id):
			continue
		if not _monster_region_loaded(Vector3(m.x, m.y, m.z)):
			_monster_deferred[m.monster_id] = true
			continue
		_monster_deferred.erase(m.monster_id)
		_queue_monster_build(m.monster_id)

	var removed: Array = []
	for monster_id in _monster_bodies.keys():
		# A monster still playing its death is left where it fell until the
		# animation has run; _finish_monster_death removes it then
		# (MonsterBodies.should_free).
		if not MonsterBodies.should_free(monster_id, live_ids, _dying_until, _idle_anim_time):
			continue
		_forget_monster(monster_id)
		removed.append(monster_id)
	# One line per body for a few (a kill's timing reads it), one for many.
	if removed.size() <= 4:
		for monster_id in removed:
			print("World3D: monster %d body removed t=%.2f" % [monster_id, _idle_anim_time])
	else:
		print("World3D: %d monster bodies removed t=%.2f" % [removed.size(), _idle_anim_time])
	# Listed before, gone now, and never built (queued or waiting for its
	# region): forgotten too.
	for monster_id in _monster_snapshots.keys():
		if not live_ids.has(monster_id) and not _monster_bodies.has(monster_id):
			_forget_monster(monster_id)
	# The first share at once, so a small list is drawn in the frame it came.
	_pump_monster_builds()

## The debug tabs' monster rows (round 655): filled only while the tabs are
## shown -- a 500-monster list was 500 ItemList rows rebuilt per list, for a
## panel nobody had open. _toggle_action_panels fills it when it opens.
func _fill_monster_rows() -> void:
	monster_list.clear()
	if not action_tabs.visible:
		return
	for m in _monsters:
		monster_list.add_item("%s (HP %d/%d)" % [m.monster_name, m.hp, m.max_hp])

func _on_monster_list_result(monsters: Array, error: String) -> void:
	if error != "":
		monster_status_label.text = "Error: %s" % error
		push_warning("World3D: monster list refused: %s" % error)
		return
	# One line, not one per monster (round 655); SRREVAMP_QA_MOB_LOG or /wire
	# lists them.
	print("World3D: server reports %d monster(s)" % monsters.size())
	if _mob_logging():
		for m in monsters:
			print("  %s at %.0f, %.0f, %.0f (%d/%d hp)" % [
				m.monster_name, m.x, m.y, m.z, m.hp, m.max_hp])
	# Before the sync: it rewrites a walking monster's listed position.
	var goto_plan := _qa_goto_plan(monsters)
	_monsters.assign(monsters)
	_fill_monster_rows()
	_sync_monster_bodies(_monsters)
	if not goto_plan.is_empty():
		_qa_goto_from_list(goto_plan)

## Monsters that left the player's area of interest (round 656,
## OP_MONSTER_LEFT) or were removed by the server -- a monster entering a
## town (round 674, session/safezone.go) is told the same way: each body
## fades out over 1.5 s and frees itself (round 677, _fade_out_body; READ:
## retail's despawn 0x3016 makes a CIDecoDisappear), and the monster leaves
## the list the panel shows. A corpse still lying there fades too: retail's
## corpse leaves through the same despawn. A monster listed but not built
## yet (queued, or waiting for its region) is forgotten, so no body is built
## for it later.
func _on_monster_left(ids: Array) -> void:
	var gone := {}
	for id in ids:
		gone[int(id)] = true
	for monster_id in gone.keys():
		_forget_monster(monster_id, true)
	var kept: Array[CombatNet.MonsterSnapshot] = []
	for m in _monsters:
		if not gone.has(m.monster_id):
			kept.append(m)
	if kept.size() != _monsters.size():
		_monsters = kept
		monster_list.clear()
		for m in _monsters:
			monster_list.add_item("%s (HP %d/%d)" % [m.monster_name, m.hp, m.max_hp])
	if _mob_logging():
		print("World3D: %d monster(s) left the area of interest" % gone.size())

# --- Server-driven monster movement (round 533) ---------------------------
#
# srrevamp's own OpMonsterMoved (0x007C) and OpMonsterMotionList (0x007F),
# docs/protocol/monster_ai.md "srrevamp's own monster protocol
# (placeholders)". The server sends both only with its -monster-ai flag on
# (round 537, off by default); SRREVAMP_QA_MOB_MOVE drives the path without it.
# The rules are MonsterMotion's; what follows is the glue.

## Whether the move lines are printed: SRREVAMP_QA_MOB_LOG, or the /wire
## console switch (NetClient.wire_logging).
func _mob_logging() -> bool:
	return OS.get_environment("SRREVAMP_QA_MOB_LOG") != "" or NetClient.wire_logging

## Whether `monster_id`'s body is walking a leg (a stop's glide does not count):
## the approach walk then releases only inside the stop distance
## (CombatNet.approach_releases).
func _monster_is_moving(monster_id: int) -> bool:
	var state = _monster_motion.get(monster_id)
	return state != null and MonsterMotion.turns_to_face(state)

## One monster's new leg (OpMonsterMoved). A move for a monster this client
## has no body for asks for the list, at most once every
## UNKNOWN_MOVE_PULL_SECONDS; a dying body ignores it.
func _on_monster_moved(moved: CombatNet.MonsterMoved) -> void:
	if moved == null:
		return
	# Listed but not drawn (round 655): queued, or waiting for its region. Its
	# snapshot takes the leg's destination -- where the server will have it
	# (OURS: the body is built standing there, not mid-leg) -- and it is
	# queued if that is in a loaded region. No list is asked for: the
	# client knows this monster.
	var known = _monster_snapshots.get(moved.monster_id)
	if known != null and not _monster_bodies.has(moved.monster_id):
		known.x = moved.dest_x
		known.z = moved.dest_z
		if _monster_deferred.has(moved.monster_id) and _monster_region_loaded(Vector3(known.x, known.y, known.z)):
			_monster_deferred.erase(moved.monster_id)
			_queue_monster_build(moved.monster_id)
		return
	if not _monster_bodies.has(moved.monster_id):
		var now := Time.get_ticks_msec()
		if now - _unknown_move_pull_msec >= int(MonsterMotion.UNKNOWN_MOVE_PULL_SECONDS * 1000.0) \
				and NetClient.is_connected_to_server():
			_unknown_move_pull_msec = now
			NetClient.list_monsters()
		return
	if _dying_until.has(moved.monster_id):
		return
	_apply_monster_leg(moved)

## The legs of the monsters just listed (OpMonsterMotionList, sent right after
## the list result). A listed body starts or re-aims its leg when the
## destination differs from where it is heading by more than REAIM_EPSILON;
## a body the list leaves out finishes the leg it is on.
func _on_monster_motion_list(entries: Array) -> void:
	for e in entries:
		var entry: CombatNet.MotionEntry = e
		var body = _monster_bodies.get(entry.monster_id)
		if body == null or not is_instance_valid(body) or _dying_until.has(entry.monster_id):
			continue
		var here := Vector2((body as Node3D).position.x, (body as Node3D).position.z)
		var heading := here
		var state = _monster_motion.get(entry.monster_id)
		if state != null and bool(state["moving"]):
			heading = state["dest"]
		var dest := Vector2(entry.dest_x, entry.dest_z)
		if heading.distance_to(dest) <= MonsterMotion.REAIM_EPSILON:
			continue
		# The list result just placed the body (reconcile), so where it is drawn
		# is the position this leg starts from.
		var moved := CombatNet.MonsterMoved.new()
		moved.monster_id = entry.monster_id
		moved.x = here.x
		moved.z = here.y
		moved.dest_x = entry.dest_x
		moved.dest_z = entry.dest_z
		moved.speed = entry.speed
		moved.mode = entry.mode
		_apply_monster_leg(moved)

## Starts a known, living body on a leg: from where it is drawn
## (MonsterMotion.begin), in the leg's clip, turned toward its destination
## unless the leg is a stop.
func _apply_monster_leg(moved: CombatNet.MonsterMoved) -> void:
	var body: Node3D = _monster_bodies[moved.monster_id]
	var displayed := Vector2(body.position.x, body.position.z)
	var state := MonsterMotion.begin(displayed, moved)
	var previous = _monster_motion.get(moved.monster_id)
	state["h_xz"] = previous["h_xz"] if previous != null else displayed
	state["log_frames"] = 0
	_monster_motion[moved.monster_id] = state
	var pos: Vector2 = state["pos"]
	if pos != displayed:
		# Too far from the server's position, or a leg with no speed: placed
		# at once; the height follows in _step_monster_bodies.
		body.position.x = pos.x
		body.position.z = pos.y
		var snap = _monster_snapshots.get(moved.monster_id)
		if snap != null:
			snap.x = pos.x
			snap.z = pos.y
	_set_monster_gait(moved.monster_id, MonsterMotion.state_gait(state))
	var front := MonsterMotion.front_of(String(body.get_meta("model", "")))
	if MonsterMotion.turns_to_face(state) and front != "":
		# Turned toward the destination at the client's rate (round 637), not
		# snapped: the same mover as another player's (_aim_remote_body).
		var to_dest: Vector2 = state["dest"] - pos
		_aim_remote_body(body, Vector3(to_dest.x, 0.0, to_dest.y), MonsterMotion.front_yaw(front))
	elif bool(state["stop"]) and _remote_turns.has(body.get_instance_id()):
		# A stop: the client's stop message snaps the heading to the server's
		# angle and ends the turn (FUN_008a4f80 -> FUN_009e00f0 ->
		# FUN_009e0050, round 637's review follow-up). srrevamp's stop carries
		# no angle; the turn's own target stands in for it (INFERRED: the
		# server's heading is its last leg's).
		var stopping: Dictionary = _remote_turns[body.get_instance_id()]
		body.rotation.y = RemoteFacing.yaw_of(float(stopping["target"]), float(stopping["front"]))
		_remote_turns.erase(body.get_instance_id())
	if _mob_logging():
		var kind := "stop"
		if MonsterMotion.turns_to_face(state):
			kind = "run" if int(state["mode"]) == MonsterMotion.MODE_RUN else "walk"
		var turn = _remote_turns.get(body.get_instance_id())
		print("World3D: monster %d %s from (%.1f,%.1f) to (%.1f,%.1f) at %.1f/s yaw %.2f%s%s" % [
			moved.monster_id, kind, pos.x, pos.y, moved.dest_x, moved.dest_z, float(state["speed"]),
			body.rotation.y, "" if turn == null else " turning to %.2f" % RemoteFacing.yaw_of(float(turn["target"]), float(turn["front"])),
			"" if front != "" else " (no model: the capsule)"])

## Plays a gait on a monster's body: its own idle for 0 (stand), its walk or
## run clip otherwise. A model with no such clip keeps the loop it has.
func _set_monster_gait(monster_id: int, gait: int) -> void:
	if OS.get_environment("SRREVAMP_NO_IDLE_ANIM") != "":
		return
	var assembled: SkinnedBsrAssembler.AssembledCharacter = _monster_assembled.get(monster_id)
	if assembled == null:
		return
	var clip := MonsterMotion.gait_clip(_data_pk2, assembled, gait)
	if clip == null:
		return
	MonsterMotion.swap_loop(_animated, assembled.skeleton, clip, _frame_count(clip), _idle_anim_time)

## Ends a monster's leg where its body is drawn, in its stand clip.
func _stop_monster_motion(monster_id: int) -> void:
	var state = _monster_motion.get(monster_id)
	if state == null:
		return
	_monster_motion.erase(monster_id)
	if bool(state["moving"]):
		_set_monster_gait(monster_id, BsrReader.AnimationEntry.TYPE_STAND)

## One physics frame of every walking body: the engine's mover
## (MonsterMotion.step), the drawn x/z written into the monster's snapshot so
## the approach walk aims at the body the player sees, and the height from
## the navmesh -- the terrain ray where no loaded region covers the body
## (_moving_monster_height_at, round 557) -- only every HEIGHT_RESOLVE_STEP
## units and for at most MAX_HEIGHT_RESOLVES_PER_FRAME bodies a frame -- the
## rest keep their height until a later frame, and take their turn first then
## (MonsterMotion.height_turns, _mob_height_cursor). An arrival switches to the
## stand clip and keeps the facing.
##
## The same budget serves the bodies whose height ray found no ground
## (_monster_heights_pending): each wants a resolve every frame until one hits
## -- a body with a leg by the leg's rule above, a standing one by the
## terrain ray its placement took (_spawn_or_update_monster). Nothing tries
## from inside a region's commit: the StaticBody3D it adds may not answer a
## ray before the next physics step, and the retry every frame finds it then.
## At most `budget` resolves (_step_heights hands it the monsters' share);
## returns the resolves spent, so the ground items' retry takes what is left.
func _step_monster_bodies(delta: float, budget: int = MonsterMotion.MAX_HEIGHT_RESOLVES_PER_FRAME) -> int:
	if _monster_motion.is_empty() and _monster_heights_pending.is_empty():
		return 0
	var logging := _mob_logging()
	# SRREVAMP_QA_MOB_LOG alone, not /wire: the measurement line below fires
	# the terrain ray beside the navmesh lookup, a second answer per resolve.
	var compare := logging and OS.get_environment("SRREVAMP_QA_MOB_LOG") != ""
	# The bodies stepped this frame and whether each wants a height resolve,
	# in the same order; the resolves are handed out after the loop.
	var stepped: Array = []
	var wants: Array = []
	for monster_id in _monster_motion.keys():
		var body = _monster_bodies.get(monster_id)
		if body == null or not is_instance_valid(body):
			_monster_motion.erase(monster_id)
			continue
		var state: Dictionary = _monster_motion[monster_id]
		var pos: Vector2 = state["pos"]
		if bool(state["moving"]):
			pos = MonsterMotion.step(pos, state["dest"], float(state["speed"]), delta)
			state["pos"] = pos
			(body as Node3D).position.x = pos.x
			(body as Node3D).position.z = pos.y
			var snap = _monster_snapshots.get(monster_id)
			if snap != null:
				snap.x = pos.x
				snap.z = pos.y
			if pos == state["dest"]:
				state["moving"] = false
				_set_monster_gait(monster_id, BsrReader.AnimationEntry.TYPE_STAND)
				if logging:
					print("World3D: monster %d arrived at (%.1f,%.1f)" % [monster_id, pos.x, pos.y])
			elif logging:
				state["log_frames"] = int(state["log_frames"]) + 1
				if int(state["log_frames"]) % 30 == 0:
					print("World3D: monster %d at (%.1f,%.1f) %.1f to go" % [
						monster_id, pos.x, pos.y, pos.distance_to(state["dest"])])
		var last: Vector2 = state["h_xz"]
		stepped.append([body, state, monster_id])
		wants.append(MonsterMotion.needs_height(last, pos) or (not bool(state["moving"]) and last != pos)
			or _monster_heights_pending.has(monster_id))
	# Standing bodies still waiting for ground, after the walking ones.
	for monster_id in _monster_heights_pending.keys():
		if _monster_motion.has(monster_id):
			continue
		var body = _monster_bodies.get(monster_id)
		if body == null or not is_instance_valid(body):
			_monster_heights_pending.erase(monster_id)
			continue
		stepped.append([body, null, monster_id])
		wants.append(true)
	var turns := MonsterMotion.height_turns(wants, _mob_height_cursor, budget)
	_mob_height_cursor = int(turns["cursor"])
	var resolved := 0
	var spent := 0
	var retried := 0
	var retry_spent := 0
	for i in turns["picked"]:
		var body: Node3D = stepped[i][0]
		var state = stepped[i][1]
		var monster_id: int = stepped[i][2]
		var retry := _monster_heights_pending.has(monster_id)
		var started := Time.get_ticks_usec()
		var height := _moving_monster_hit_height(body.position) if state != null else _terrain_hit_height(body.position)
		if retry:
			retry_spent += Time.get_ticks_usec() - started
			retried += 1
		else:
			spent += Time.get_ticks_usec() - started
		if compare:
			var nav := _navmesh_height_at(body.position)
			print("World3D: monster %d height at (%.1f,%.1f): navmesh %s, terrain ray %.2f" % [
				monster_id, body.position.x, body.position.z,
				"none" if is_nan(nav) else "%.2f" % nav, _terrain_height_at(body.position)])
		# A miss leaves the height as it is -- what the walking resolve did
		# before, when the ray's miss returned the body's own y.
		if not is_nan(height):
			body.position.y = height
			_monster_height_found(monster_id, height)
		if state != null:
			state["h_xz"] = state["pos"]
		if not retry:
			resolved += 1
	_mob_height_resolves += resolved
	_mob_height_max = maxi(_mob_height_max, resolved)
	_mob_height_usec += spent
	_mob_height_usec_max = maxi(_mob_height_usec_max, spent)
	_mob_height_retries += retried
	_mob_height_retries_max = maxi(_mob_height_retries_max, retried)
	_mob_height_retry_usec += retry_spent
	_mob_height_window += delta
	if _mob_height_window >= 10.0:
		if logging:
			print("World3D: monster height resolves %d/s, max %d in a frame; %.2f ms in them over %.1f s, max %.3f ms in a frame; waiting-for-ground retries %d/s, max %d in a frame, %.2f ms in them" % [
				int(round(float(_mob_height_resolves) / _mob_height_window)), _mob_height_max,
				float(_mob_height_usec) / 1000.0, _mob_height_window, float(_mob_height_usec_max) / 1000.0,
				int(round(float(_mob_height_retries) / _mob_height_window)), _mob_height_retries_max,
				float(_mob_height_retry_usec) / 1000.0])
		_mob_height_resolves = 0
		_mob_height_max = 0
		_mob_height_usec = 0
		_mob_height_usec_max = 0
		_mob_height_retries = 0
		_mob_height_retries_max = 0
		_mob_height_retry_usec = 0
		_mob_height_window = 0.0
	return resolved + retried

## One physics frame's height work (round 572): the monsters' walking legs
## and waiting bodies (_step_monster_bodies) and the ground items waiting for
## ground (GroundItems.resolve_pending) share MAX_HEIGHT_RESOLVES_PER_FRAME --
## the monsters up to MonsterMotion.monster_height_share of it, the items
## whatever the monsters leave, which is at least half the budget whenever
## they want that much. Until round 572 the items took only what the
## monsters left.
func _step_heights(delta: float) -> void:
	var budget := MonsterMotion.MAX_HEIGHT_RESOLVES_PER_FRAME
	var item_wants := _ground_items.pending_count() if _ground_items != null else 0
	var spent := _step_monster_bodies(delta, MonsterMotion.monster_height_share(budget, item_wants))
	if _ground_items != null:
		_ground_items.resolve_pending(budget - spent)

func _on_attack_pressed() -> void:
	var selected := monster_list.get_selected_items()
	if selected.is_empty():
		monster_status_label.text = "Select a monster first."
		return
	var target: CombatNet.MonsterSnapshot = _monsters[selected[0]]
	_last_attack_target = target.monster_id
	_show_target(target.monster_id)
	_attack_monster(target.monster_id)

func _on_attack_result(result: CombatNet.AttackResult) -> void:
	if result == null:
		return
	# A self or ground cast's reply (round 617) is not a blow on the target:
	# no swing, no flinch, no counter, and the monster cast still in flight
	# keeps its hit effect. The health bar is painted by the other handler.
	if SelfCast.is_self_reply(result.target_type, result.target_type_echoed, result.monster_damage,
			result.monster_died, result.player_died, result.error):
		if result.error != "":
			print("CAST reply: self/ground cast (targetType %d, %s) refused: %s" % [result.target_type,
				"echoed" if result.target_type_echoed else "from the request queue", result.error])
			_fx_self_cast_refused()
			if result.target_type == SkillNet.TARGET_CHARACTER:
				_log_system(result.error)
		elif result.wall != null and result.wall.toggled_off:
			# Round 640: the recast switched a running toggle off; its
			# OpBuffEnd ends the icon and the aura. The server's answer
			# decides (review): a cast this client drew because it did not
			# know the toggle was running is ended here.
			print("CAST reply: the toggle was switched off (no cast, no cost), HP %d" % result.player_hp)
			_fx_self_cast_refused()
		else:
			print("CAST reply: self/ground cast (targetType %d, %s) accepted, HP %d" % [result.target_type,
				"echoed" if result.target_type_echoed else "from the request queue", result.player_hp])
			_fx_self_cast_accepted()
			NetClient.list_skills(NetClient.current_character_name)
		return
	if result.error != "":
		monster_status_label.text = "Attack failed: %s" % result.error
		print("World3D: attack refused: %s" % result.error)
		# The server's target test (round 622): a friendly skill at a monster.
		if result.error == SelfCast.INVALID_TARGET_TEXT or result.error == SelfCast.NO_TARGET_TEXT:
			_log_system(result.error)
		SkillEffects.cancel_cast(player)
		_rewalk_after_refusal(result)
		return
	_released_attack = {}
	# One line per exchange, so a render's log says what the fight did
	# without reading it off a label. t is the animation clock the death
	# hold and the "body removed" line read, so a kill can be timed against
	# its body's removal.
	print("World3D: attack hit for %d%s (%d left%s), took %d%s (HP %d)%s t=%.2f" % [
		result.monster_damage, " CRIT" if result.player_critical else "",
		result.monster_remaining_hp, ", died" if result.monster_died else "",
		result.player_damage_taken,
		" BLOCKED" if result.player_blocked else (" CRIT" if result.monster_critical else ""),
		result.player_hp,
		", lost %d exp" % result.death_exp_lost if result.death_exp_lost > 0 else "",
		_idle_anim_time])
	# A combat exchange keeps the player in the battle stance while idle.
	_last_combat_time = _player_anim_time
	# The player's swing: the next plain attack in the weapon group's
	# chain, once. Its hit event says when the blow lands, and that is
	# when the monster's own hit reaction plays.
	var swing_type: int = ATTACK_SEQUENCE[_attack_step % ATTACK_SEQUENCE.size()]
	_attack_step += 1
	var swing_entry := _body_animation_entry(_player_body, swing_type, _player_weapon_group)
	if swing_entry == null:
		swing_entry = _body_animation_entry(_player_body, BsrReader.AnimationEntry.TYPE_ATTACK, _player_weapon_group)
	var lands_after := 0.0
	if swing_entry != null:
		var swing := _body_animation_for(_player_body, swing_entry.action_type, _player_weapon_group)
		if swing != null:
			_play_player_once(swing)
		var hit_ms := swing_entry.first_event_time(BsrReader.AnimationEntry.EVENT_HIT)
		lands_after = float(hit_ms) / 1000.0 if hit_ms > 0 else 0.0
	# The monster this result is about. The server names it (AttackResult.
	# MonsterID; NetClient fills it from the target the attack was sent at
	# when a server predates the field). It is NOT _last_attack_target: the
	# result lands a swing later than it was sent, and a retarget in between
	# used to make the new target flinch, take the number and swing back
	# while the old one fell -- "one Mangyang killed another". Every
	# animation, number and effect below is pinned to this id.
	var monster: int = result.monster_id if result.monster_id != 0 else _last_attack_target
	if monster != _last_attack_target:
		print("World3D: attack result for monster %d while targeting %d -- animating %d" % [
			monster, _last_attack_target, monster])
	elif OS.get_environment("SRREVAMP_QA_ATTACK") != "":
		print("World3D: attack result for monster %d -> animating %d" % [monster, monster])
	if _qa_retreat_pending and monster != -1 and result.monster_damage > 0 and not result.monster_died:
		_qa_retreat(monster)
	# A skill cast (not a plain attack) plays that skill's own hit effect on the
	# target when the blow lands. Consumed here so the next plain attack doesn't
	# inherit it.
	var skill_hit_code := _pending_skill_hit_code
	_pending_skill_hit_code = ""
	var cast_skill := _pending_skill_id
	_pending_skill_id = 0
	# The skill this blow carries, for its sounds: the cast's, or the weapon's
	# base attack for a plain swing (CombatAudio.base_attack_skill), recorded
	# as the player's current skill for the animation-fired sounds.
	var blow_skill := cast_skill if cast_skill != 0 else \
		CombatAudio.base_attack_skill(maxi(_player_weapon_type_id4(), 0))
	if cast_skill == 0:
		SkillAudio.set_current(player, blow_skill)
	var blow_audio := {"skill": blow_skill, "cast": cast_skill != 0,
		"critical": result.player_critical, "hwan": result.berserk_active}
	if monster != -1:
		var dealt := result.monster_damage
		var died := result.monster_died
		# The result's health is recorded now, in wire order with the zone's
		# pushes, and painted as the blow lands (round 655 and its review):
		# a newer OpMonsterDamaged arriving before the landing is not undone
		# by this older number. Only a result that reports a blow carries
		# health: a zero-damage cast (a stun, a debuff) resolves none, and a
		# server before round 655's review sent 0 there.
		var blow := dealt > 0 or died
		if blow:
			_record_monster_hp(monster, result.monster_remaining_hp)
		_own_hit_until[monster] = Time.get_ticks_msec() + int(lands_after * 1000.0) + 750
		if died:
			# The killer is the one player the server never sends
			# OpMonsterDied (session/combat.go performAttack skips the
			# attacker), and the list requested at the end of this handler no
			# longer names the monster -- which used to free its body at once,
			# before any death was seen. Hold it now, before that request,
			# for the rest of the swing and the die clip's own length; the
			# clip itself starts when the blow lands, below. The races this
			# leaves are disclosed at MonsterBodies.hold_for_kill.
			MonsterBodies.hold_for_kill(_dying_until, monster, _idle_anim_time, lands_after,
				_monster_action_seconds(monster, BsrReader.AnimationEntry.TYPE_DIE))
			# Killed mid-walk: it stops here, in its stand clip, rather than
			# walking on until the blow lands and the die clip starts.
			_stop_monster_motion(monster)
			print("World3D: monster %d killed by own blow t=%.2f, clip starts in %.2fs" % [
				monster, _idle_anim_time, lands_after])
		_after(lands_after, func() -> void:
			# The moment that used to go wrong: the blow lands a swing after it
			# was sent, and the live target may already be another monster.
			if OS.get_environment("SRREVAMP_QA_ATTACK") != "" and monster != _last_attack_target:
				print("World3D: blow lands on monster %d (now targeting %d) -- animating %d" % [
					monster, _last_attack_target, monster])
			# A monster this blow killed plays its die animation as the blow
			# lands (held by the kill hold above); a surviving one flinches.
			# The monster's health, as the snapshot has it by now (the result's,
			# or a newer push's), drawn as the blow lands (round 655): until
			# then the full list this handler asked for after every result
			# brought it. OURS: shown with the blow rather than when the reply
			# arrives.
			if blow:
				_paint_monster_hp(monster)
			if died:
				_begin_monster_death(monster)
			else:
				var hit_assembled = _monster_assembled.get(monster)
				if hit_assembled != null:
					_audio_mark_hit(hit_assembled.skeleton, result.player_critical)
				_play_monster_action(monster, BsrReader.AnimationEntry.TYPE_HIT)
			_audio_blow_lands(blow_audio, dealt, monster)
			var hit_body = _monster_bodies.get(monster)
			if hit_body != null and is_instance_valid(hit_body):
				_floating_damage(hit_body, _monster_text_height(monster), dealt, DAMAGE_DEALT_COLOUR)
				if skill_hit_code != "":
					_play_skill_hit_effect_on(hit_body, _monster_text_height(monster), skill_hit_code))
	# The monster strikes back as the player's blow lands -- from the zone's
	# OpMonsterAttacked when a server sends one, else from this result
	# (_draw_counter_at_landing, round 540). Only the monster that took the
	# blow counterattacks, so it is pinned to `monster` too.
	_draw_counter_at_landing(monster, result, lands_after)
	if OS.get_environment("SRREVAMP_QA_MOB_STRIKE") != "":
		_qa_mob_strike(monster, result)
	if result.monster_died:
		monster_status_label.text = "Hit for %d%s -- it died!" % [
			result.monster_damage, " CRITICAL!" if result.player_critical else ""]
		# A kill may have progressed a quest's kill count even without
		# completing it (OpQuestCompleted only fires on completion), so
		# refresh here rather than only on _on_quest_completed.
		NetClient.list_quests(NetClient.current_character_name)
	else:
		monster_status_label.text = _exchange_line(result)
		# Dying was silent until now: the server has reported it since the
		# first combat release and nothing read the flag. Above level 10 it
		# also costs experience -- the real penalty, see
		# leveldata.DeathPenaltyExp.
		if result.player_died:
			monster_status_label.text = _death_line(result.death_exp_lost)
			# Left dead, at HP 0 (round 548) -- or, from today's server, put
			# back on its feet in the same call (MonsterStrikes.leaves_dead).
			if MonsterStrikes.leaves_dead(result.player_died, result.player_hp):
				_enter_dead_state(result.death_exp_lost)
	# No monster list here any more (round 655): the result carries the
	# monster's health and death, applied as the blow lands, and a full list
	# of a 500-monster view after every swing was the cost.
	# OpUseSkill's response reuses this same OpAttackResult (see
	# SkillNet's doc comment) -- refresh here too so a just-used skill's
	# updated cooldown shows up in the Skills tab. Harmless no-op extra
	# traffic for a plain (non-skill) attack, same tradeoff the quest
	# refresh above already makes.
	NetClient.list_skills(NetClient.current_character_name)

# --- A monster's blow (round 540) -------------------------------------------
#
# srrevamp's own OpMonsterAttacked (0x007D), docs/protocol/monster_ai.md
# "srrevamp's own monster protocol (placeholders)": one monster's blow on a
# player, sent to everyone in the zone, the attacker included, right behind the
# attacker's own OpAttackResult. No server sends it yet. Without it a counter is
# drawn from the attacker's result, on the attacker's screen only; with it,
# every player in the zone sees the blow. MonsterStrikes decides which of the
# two draws a counter on the attacker's own screen.

## The death line a blow that killed this player shows on the combat status
## label. Above level 10 a death also costs experience, the real penalty
## (leveldata.DeathPenaltyExp).
func _death_line(exp_lost: int) -> String:
	return "You were killed.%s" % (" Lost %d experience." % exp_lost if exp_lost > 0 else "")

## The combat status label's line for an exchange the monster survived. The
## recovered combat mechanics are only worth recovering if a player can see
## them happen: a critical doubles the blow, a block stops it dead. Both were
## computed and sent for several releases before anything read them. A swing
## inside the monster's ReuseDelay draws no counter (combat.Hub.
## CounterattackReady), and the line says nothing about one: "Took 0" read as
## a blow that did nothing.
func _exchange_line(result: CombatNet.AttackResult) -> String:
	var taken := ""
	if result.wall != null and result.wall.absorbed:
		taken = " Your wall took %d%s (HP %d)." % [result.wall.damage,
			" -- critical!" if result.wall.critical else "", result.player_hp]
	elif result.player_blocked:
		taken = " Blocked it (HP %d)." % result.player_hp
	elif result.player_damage_taken > 0:
		taken = " Took %d%s (HP %d)." % [result.player_damage_taken,
			" -- critical!" if result.monster_critical else " damage", result.player_hp]
	return "Hit for %d%s (%d HP left).%s" % [
		result.monster_damage, " CRITICAL!" if result.player_critical else "",
		result.monster_remaining_hp, taken]

## When the monster's attack clip lands its blow, in seconds after the clip
## starts: the first hit event (BsrReader.AnimationEntry.EVENT_HIT) of its
## TYPE_ATTACK entry -- mangnyang's attack01 at 651. The millisecond unit is
## inferred from the key times, not read from the client's use of them
## (docs/protocol/BSR_FORMAT.md, "Events and walk points"). 0 when the monster
## has no assembled body or no such event.
func _monster_strike_seconds(monster_id: int) -> float:
	var assembled: SkinnedBsrAssembler.AssembledCharacter = _monster_assembled.get(monster_id)
	if assembled == null or assembled.parsed == null:
		return 0.0
	var strike := assembled.parsed.animation_entry_for(BsrReader.AnimationEntry.TYPE_ATTACK)
	if strike == null:
		return 0.0
	var ms := strike.first_event_time(BsrReader.AnimationEntry.EVENT_HIT)
	return float(ms) / 1000.0 if ms > 0 else 0.0

## The counterattack `result` reports, drawn `lands_after` seconds from now,
## when the player's own blow lands: from the zone's OpMonsterAttacked if it
## has come by then (_settle_counter), else from the result. A result that
## reports none draws none.
func _draw_counter_at_landing(monster: int, result: CombatNet.AttackResult, lands_after: float) -> void:
	if monster == -1 or not MonsterStrikes.result_countered(result):
		# No monster to pin a push to (a server that names none and a queue
		# that had nothing in flight): the result draws it, as before.
		if result.player_damage_taken > 0:
			_after(lands_after, _draw_counter_from_result.bind(monster, result))
		return
	var wait := MonsterStrikes.expect(_strike_waits, monster, result)
	_after(lands_after, _settle_counter.bind(monster, result, wait))

## The blow has landed: the counter is drawn from the push that claimed `wait`
## (on this screen too the monster swings as the player's blow lands, not when
## the push arrived), or, when none came, from the result.
func _settle_counter(monster: int, result: CombatNet.AttackResult, wait: Dictionary) -> void:
	var pushed := MonsterStrikes.settle(_strike_waits, monster, wait)
	if pushed != null:
		_draw_monster_strike(pushed, true)
		return
	print("World3D: monster %d counter from the result (no push)" % monster)
	_draw_counter_from_result(monster, result)

## The counter as the attacker's result reports it, for a server that sends no
## OpMonsterAttacked: the monster's attack clip now, and the player's hit
## reaction (type 3) and the number when that clip's hit event falls. Only a
## blow that dealt damage is drawn, and only on an assembled body -- as before
## round 540.
func _draw_counter_from_result(monster: int, result: CombatNet.AttackResult) -> void:
	if result.player_blocked:
		# Nothing is drawn for a blocked counter; its sound is (round 614),
		# when the monster's blow would land.
		var block_after := _monster_strike_seconds(monster) if monster != -1 else 0.0
		_after(block_after, func() -> void:
			_audio_block(player, result.monster_critical, "monster %d's counter, from the result" % monster)
			_audio_monster_blow(monster, result.monster_critical, "blocked counter on the player, from the result"))
	if result.wall != null and result.wall.absorbed:
		# Round 640: the player's wall took the counter whole.
		var wall_after := 0.0
		if monster != -1:
			wall_after = _monster_strike_seconds(monster)
			_play_monster_action(monster, BsrReader.AnimationEntry.TYPE_ATTACK)
		var own_key := _fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER)
		_after(wall_after, _draw_wall_blow.bind(player, own_key, result.wall, monster, "the player (from the result)"))
		return
	if result.player_damage_taken <= 0 or _player_skeleton == null:
		return
	var strike_after := 0.0
	if monster != -1:
		strike_after = _monster_strike_seconds(monster)
		if OS.get_environment("SRREVAMP_QA_ATTACK") != "" and monster != _last_attack_target:
			print("World3D: counter-swing by monster %d (now targeting %d) -- animating %d" % [
				monster, _last_attack_target, monster])
		_play_monster_action(monster, BsrReader.AnimationEntry.TYPE_ATTACK)
	_after(strike_after, func() -> void:
		# The hit reaction -- or the held die clip when this blow left the
		# player dead (round 548).
		_audio_mark_hit(_player_skeleton, result.monster_critical)
		_play_player_struck()
		_audio_monster_blow(monster, result.monster_critical, "counter on the player, from the result")
		# Round 640: a buff naming a DefenseEfp (a wall's) shows it.
		var own_efp := _defense_efp_on(_fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER))
		if own_efp != "":
			_play_hit_efp_on(player, 2.0 * PLAYER_SCALE_RATIO, own_efp)
		# The damage the player took, over the player's own head (human
		# head height from the same PLAYER_SCALE_RATIO calibration the
		# monster fallback uses), timed to when the counter-blow lands.
		_floating_damage(player, 2.0 * PLAYER_SCALE_RATIO, result.player_damage_taken, DAMAGE_TAKEN_COLOUR))

## One monster's blow (OpMonsterAttacked), for everyone in the zone. A blow on
## this player repeats a counter its own result reported (MonsterStrikes.claim):
## it is drawn when this player's blow lands (_settle_counter), or was already
## drawn from the result. Any other blow -- on another player, or on a target
## this client has not drawn -- is drawn at once.
func _on_monster_attacked(attacked: CombatNet.MonsterAttacked) -> void:
	if attacked == null:
		return
	# A state's damage tick (round 659's review, STRIKE_STATUS_TICK): the
	# server sends one when a tick kills. No swing is drawn and no counter
	# claimed; the target takes it as a blow's report -- the HUD, the death
	# line and the dead state for this player, the hit clip for another.
	if attacked.status_tick:
		_on_status_tick_strike(attacked)
		return
	var claim := MonsterStrikes.CLAIM_NONE
	if not _other_bodies.has(attacked.target_character_id):
		claim = MonsterStrikes.claim(_strike_waits, attacked)
	# A blow with no counter result to pair with -- the monster's own swing,
	# from a server with -monster-battle (round 546) -- is this player's when
	# its target is drawn nowhere here (MonsterStrikes.is_own_unpaired).
	var own_unpaired := claim == MonsterStrikes.CLAIM_NONE and MonsterStrikes.is_own_unpaired(
		attacked.target_character_id, _other_bodies, _recently_left, Time.get_ticks_msec())
	var how := "on another player"
	match claim:
		MonsterStrikes.CLAIM_HELD:
			how = "own counter, drawn as the blow lands"
		MonsterStrikes.CLAIM_DRAWN:
			how = "own counter, already drawn from the result"
		_:
			if own_unpaired:
				how = "own blow, no result to pair with (the monster's own swing), drawn at once"
			elif not _other_bodies.has(attacked.target_character_id):
				how = "target not drawn here"
	# One line per push: a live run counts them against the counter results.
	print("World3D: monster %d strikes %d for %d (HP %d)%s%s -- %s" % [
		attacked.monster_id, attacked.target_character_id, attacked.damage, attacked.target_hp,
		" BLOCKED" if attacked.blocked else (" CRIT" if attacked.critical else ""),
		", died" if attacked.target_died else "", how])
	# Only a push that claimed a counter still waiting for its blow repaints
	# the vitals; a late one (CLAIM_DRAWN) is swallowed whole (round 544).
	if claim == MonsterStrikes.CLAIM_HELD:
		_show_own_strike(attacked)
	if claim != MonsterStrikes.CLAIM_NONE:
		return
	if own_unpaired:
		# The push is the only report of this blow: the HUD's HP and the
		# death line come from it, and it is drawn now, on this player.
		_show_own_strike(attacked)
		_draw_monster_strike(attacked, true)
		return
	_draw_monster_strike(attacked, false)

## A state's damage tick reported as OpMonsterAttacked (round 659's review):
## on this player, _show_own_strike (bar, death line, dead state) and the hit
## -- or held die -- clip; on another drawn player, their hit clip.
func _on_status_tick_strike(attacked: CombatNet.MonsterAttacked) -> void:
	var own := attacked.target_character_id == _own_id()
	print("World3D: a state's tick on %d for %d (HP %d)%s -- %s" % [
		attacked.target_character_id, attacked.damage, attacked.target_hp,
		", died" if attacked.target_died else "", "this player" if own else "another player"])
	if own:
		_show_own_strike(attacked)
		_play_player_struck()
	elif _other_bodies.has(attacked.target_character_id):
		_play_other_hit(attacked.target_character_id)

## A blow on this player, from a push that claimed a counter still waiting for
## its blow to land (CLAIM_HELD): the HUD's HP from the push's target HP, and
## the death line when it killed. The result that reported the same counter
## set both a moment earlier (the push repeats its numbers,
## MonsterStrikes.repeats), so this changes nothing against a server that
## sends both. Never from a late push (CLAIM_DRAWN): its counter was drawn
## from the result, and a newer result -- a kill's level-up heal, the next
## counter -- may have moved the HP since, so repainting from it put a stale
## number on the bar until the next result (round 544).
func _show_own_strike(attacked: CombatNet.MonsterAttacked) -> void:
	if _last_enter_world_max_hp > 0:
		if _hud_player_info != null:
			_hud_player_info.set_hp(attacked.target_hp, _last_enter_world_max_hp)
		if _hud_panels != null:
			_hud_panels.set_character_vitals(attacked.target_hp, _last_enter_world_max_hp, 1)
	if attacked.target_died:
		if monster_status_label != null:
			monster_status_label.text = _death_line(attacked.death_exp_lost)
		# Left dead, at HP 0 (round 548): the monster's own swing under
		# -monster-battle reports a kill here alone, with no result before it.
		if MonsterStrikes.leaves_dead(attacked.target_died, attacked.target_hp):
			_enter_dead_state(attacked.death_exp_lost)

# --- The player's dead state (round 548) --------------------------------------
#
# A server with -player-dead-state on (the server half; off by default) leaves
# a player a monster kills at HP 0 in life state 2 -- docs/protocol/
# character_state.md, rounds 411-413: 1 is ALIVE (the "must be alive" guards
# answer GUILDERR_IM_DEAD and 0x6807 on GetLifeState() != 1), 2 is a PC the
# engine revives into 1 (GObjPC::Revive 0x4df290) -- refuses its moves, blows,
# casts and items, and revives it where it lies on OpRevive, at
# character.RespawnFraction (0.4) of each maximum. That fraction is the retail
# resurrect handler's own: GObjPC_HandleResurrectMsg_053 (0x50fee0) acts only
# in life state 2 (`cmp al,0x2` at 0x510077), calls GObjPC::Revive(1) (`push
# 0x1; call 0x4df290` at 0x5100e3) and lands GetParam(3) x 0.4 and GetParam(4)
# x 0.4 through ApplyHPMPDelta (`fmul QWORD PTR ds:0xb460f0` at 0x5100fa and
# 0x510130; 0xb460f0 = 00 00 00 a0 99 99 d9 3f, the double 0.4). Its u8 option
# -- 1 return to the return point, 2 revive in place while the max level is at
# most 10 -- is carried since round 665: the dead window offers retail's two
# buttons (HudPanels.show_revive_prompt) and option 1 comes back as a zone
# change to the return point followed by the OpReviveResult. With the flag
# off a kill arrives with the respawned HP above 0
# (MonsterStrikes.leaves_dead) and is followed by the zone change to the
# return point; no OpReviveResult comes.

## The player's own reaction to a blow that has just landed on it: the hit
## clip (type 3) once, over stand or run -- or, when the blow left the player
## dead (_player_dead), the die clip (type 4 of the weapon group's table,
## `_a_diehardhit` by the body's own hints) held on its last frame until the
## revive. That the retail client plays a death clip and leaves the body down
## was not read here; the clip type is the body table's own.
func _play_player_struck() -> void:
	if _player_skeleton == null:
		return
	if _player_dead:
		_play_player_death_pose()
		return
	var hit := _body_animation_for(_player_body, BsrReader.AnimationEntry.TYPE_HIT, _player_weapon_group)
	if hit != null:
		_play_player_once(hit)

## Plays the die clip once and holds its last frame (_player_one_shot_hold).
## A body with no such clip keeps whatever it plays.
func _play_player_death_pose() -> void:
	_hold_player_one_shot(_body_animation_for(_player_body, BsrReader.AnimationEntry.TYPE_DIE, _player_weapon_group))

## Plays `die` once and holds it -- only if it STARTED (round 550): a clip of
## one frame, or none, starts nothing (_play_player_once), and setting the
## hold regardless pinned whatever one-shot was current, a swing among them.
## A pose already held stays held (the repeated kill report's second call).
func _hold_player_one_shot(die: BanReader.ParsedAnimation) -> void:
	if die == null:
		return
	_play_player_once(die)
	if _player_one_shot == die:
		_player_one_shot_hold = true

## This player has been left dead: every walk and attack under way ends, the
## input locks (_player_dead), the death line goes to the system window and the HUD shows
## the Revive button. The pose itself is played when the killing blow lands
## (_play_player_struck), on the counter's own timing. Idempotent: a push that
## repeats a result's kill (MonsterStrikes.CLAIM_HELD) reaches here twice.
func _enter_dead_state(exp_lost: int) -> void:
	if _player_dead:
		return
	_player_dead = true
	_sit.reset()
	# The body stops turning where it fell (round 637's review follow-up; OURS).
	_player_turn_target = NAN
	# Retail's death (0x30BF kind 0 value 2 -> FUN_0077b000) runs FUN_007b5300:
	# the berserk display fades out (round 629's review).
	if _hud_player_info != null:
		_hud_player_info.reset_hwan_display()
		print("World3D: death -- berserk display reset (active now %s)" % str(_hud_player_info.hwan_display_active()))
	_drop_pending_attack()
	_cancel_talk_approach("death")
	_has_move_target = false
	player.velocity.x = 0.0
	player.velocity.z = 0.0
	# The QA attack loop stops here for good; SRREVAMP_QA_REVIVE_AFTER counts
	# from this tick.
	_qa_attacking = false
	_qa_dead_tick = _qa_tick
	_qa_revive_sent = false
	var line := _death_line(exp_lost)
	# The system window gets retail's own line for the loss (round 639's
	# review): Client_ApplyExpAndLevelUp writes UIIT_MSG_STATE_LOSE_EXP
	# ("[%I64d]Experience Points lost.") with type 1 when the EXP goes down
	# (0x8a9b76..0x8a9baa). No other death line was found among the system
	# window's callers; the revive prompt keeps ours.
	var loss := exp_loss_line(exp_lost, _ui_text_table.get_text("UIIT_MSG_STATE_LOSE_EXP", "") if _ui_text_table != null else "")
	if loss != "":
		_log_system(loss, HudSystemMessage.TYPE_GAIN)
	print("World3D: %s" % line)
	if _hud_panels != null:
		_hud_panels.player_dead = true # the bag's right-click use (round 550)
		_hud_panels.show_revive_prompt(line, _player_level)
	print("World3D: left dead (HP 0) t=%.2f -- input locked until the revive" % _idle_anim_time)

## Back on its feet: an OpReviveResult with no error (_on_revive_result). The
## held die clip is released to the stand loop and the prompt comes down.
func _leave_dead_state() -> void:
	if not _player_dead:
		return
	_player_dead = false
	_player_one_shot_hold = false
	_player_one_shot = null
	if _hud_panels != null:
		_hud_panels.player_dead = false
		_hud_panels.hide_revive_prompt()

## A dead-window button (HudPanels.revive_requested, round 665), or the QA
## hook: ask the server (OpRevive 0x0028) with retail's option -- 1 the
## return point, 2 the present point. Only while dead -- the server refuses it
## otherwise, as the retail handler acts only in life state 2 (0x510077).
## Option 1 is answered with the zone change to the return point first and
## then the OpReviveResult (_on_revive_result).
func _on_revive_requested(option: int = 1) -> void:
	if not _player_dead or not NetClient.is_connected_to_server():
		return
	NetClient.revive(option)
	print("World3D: revive requested (option %d)" % option)

## OpReviveResult 0x0029: the character is back at character.RespawnFraction
## of each maximum (WorldNet.ReviveResult), or the server refused. The HP is
## painted from the result; the MP through the stats refresh, which carries
## its maximum (this scene keeps none). A refusal (option 2 above level 10)
## leaves the dead window up.
func _on_revive_result(result: WorldNet.ReviveResult) -> void:
	if result == null:
		return
	if result.error != "":
		_log_system(result.error)
		print("World3D: revive refused: %s" % result.error)
		return
	_leave_dead_state()
	if _last_enter_world_max_hp > 0:
		_last_enter_world_hp = result.hp
		if _hud_player_info != null:
			_hud_player_info.set_hp(result.hp, _last_enter_world_max_hp)
		if _hud_panels != null:
			_hud_panels.set_character_vitals(result.hp, _last_enter_world_max_hp, 1)
	_request_world_stats()
	# This project's own wording.
	_log_system("Revived.")
	print("World3D: revived (HP %d, MP %d)" % [result.hp, result.mp])

## Draws one monster's blow from its push: the monster turned toward its target
## and playing its attack clip (TYPE_ATTACK), then, at that clip's hit event
## (_monster_strike_seconds), the target's hit reaction (TYPE_HIT, on the
## player's body or another player's) and the red number over it. A blocked
## blow is the swing alone: it dealt nothing. A target this client has not drawn
## gets the swing alone, unturned.
func _draw_monster_strike(attacked: CombatNet.MonsterAttacked, on_self: bool) -> void:
	var monster := attacked.monster_id
	var target_id := attacked.target_character_id
	var target: Node3D = null
	if on_self:
		target = player
	elif _other_bodies.has(target_id) and is_instance_valid(_other_bodies[target_id]):
		target = _other_bodies[target_id]
	var strike_after := 0.0
	var body = _monster_bodies.get(monster)
	if body != null and is_instance_valid(body) and not _dying_until.has(monster):
		if target != null:
			_face_monster_toward(monster, Vector2(target.position.x, target.position.z))
			if OS.get_environment("SRREVAMP_QA_FACING_LOG") != "":
				_qa_strike_facing(monster, target)
		_play_monster_action(monster, BsrReader.AnimationEntry.TYPE_ATTACK)
		strike_after = _monster_strike_seconds(monster)
	if target != null and attacked.blocked:
		# The block's sound at the blocker, a player character (round 614).
		_after(strike_after, func() -> void:
			var blocker = player if on_self else _other_bodies.get(target_id)
			if blocker != null and is_instance_valid(blocker):
				_audio_block(blocker, attacked.critical, "monster %d's blow on %s" % [
					monster, "the player" if on_self else "character %d" % target_id])
				_audio_monster_blow(monster, attacked.critical, "blocked blow on %s" % [
					"the player" if on_self else "character %d" % target_id]))
	if target == null or attacked.blocked:
		return
	var target_key := _fx_owner_key(_own_id() if on_self else target_id, SkillNet.OWNER_CHARACTER)
	if attacked.wall != null and attacked.wall.absorbed:
		# Round 640: the target's wall took the blow whole.
		_after(strike_after, func() -> void:
			var wall_anchor = player if on_self else _other_bodies.get(target_id)
			if wall_anchor != null and is_instance_valid(wall_anchor):
				_draw_wall_blow(wall_anchor, target_key, attacked.wall, monster,
					"the player" if on_self else "character %d" % target_id))
		return
	_after(strike_after, func() -> void:
		# Looked up again: another player may have left the zone meanwhile.
		var anchor = player if on_self else _other_bodies.get(target_id)
		if anchor == null or not is_instance_valid(anchor):
			return
		# Round 640: a buff naming a DefenseEfp (a wall's) shows it.
		var landed_efp := _defense_efp_on(target_key)
		if landed_efp != "":
			_play_hit_efp_on(anchor, 2.0 * PLAYER_SCALE_RATIO, landed_efp)
		if on_self:
			# The hit reaction -- or the held die clip when this blow left
			# the player dead (round 548).
			_audio_mark_hit(_player_skeleton, attacked.critical)
			_play_player_struck()
		else:
			_audio_mark_hit(_other_gaits.get(target_id, {}).get("skeleton"), attacked.critical)
			_play_other_hit(target_id)
		_audio_monster_blow(monster, attacked.critical, "blow on %s" % [
			"the player" if on_self else "character %d" % target_id])
		# Over the head, at the height the player's own number uses.
		_floating_damage(anchor, 2.0 * PLAYER_SCALE_RATIO, attacked.damage, DAMAGE_TAKEN_COLOUR))

## Turns a monster's body to face `at` (world x, z) by its model's front
## (MonsterMotion.front_of / facing_yaw). The capsule (no model), and a target
## on the body itself, leave it as it is. So does a body walking a
## leg: it keeps facing its path, as _face_monster_heading leaves it -- the leg
## faced it at its start (_apply_monster_leg) and nothing re-faces it mid-leg,
## so a turn here would have it walk sideways to its stop (round 544).
func _face_monster_toward(monster_id: int, at: Vector2) -> void:
	var body = _monster_bodies.get(monster_id)
	if body == null or not is_instance_valid(body) or _monster_is_moving(monster_id):
		return
	var front := MonsterMotion.front_of(String((body as Node3D).get_meta("model", "")))
	var dir := at - Vector2((body as Node3D).position.x, (body as Node3D).position.z)
	if front == "" or dir.is_zero_approx():
		return
	# A bare snap: a turn in progress goes on (INFERRED: a monster's strike is
	# retail's skill action, whose reader FUN_00a54be0 snaps with a bare
	# FUN_009c4260; round 637's review follow-up).
	(body as Node3D).rotation.y = MonsterMotion.facing_yaw(dir, front)

## Another player's hit reaction: the TYPE_HIT clip of their own body's
## gender and weapon group, once, back to their stand or run after
## (_play_once). A body with no assembled skeleton (the capsule) has none.
func _play_other_hit(character_id: int) -> void:
	var gait: Dictionary = _other_gaits.get(character_id, {})
	if gait.is_empty() or not is_instance_valid(gait["skeleton"]):
		return
	var hit := _body_animation_for(gait["body"], BsrReader.AnimationEntry.TYPE_HIT, gait["group"])
	if hit != null:
		_play_once(gait["skeleton"], hit)

# --- Skill visual effects (round 620) ------------------------------------------

## The skill hit and the level-up burst draw their decoded .efp (round 620);
## false falls back to HitEffect / LevelUpEffect's designed animation.
const USE_EFP_HITS := true
const USE_EFP_LEVELUP := true
const LEVELUP_EFP := "system\\system_levelup.efp"
#
# SkillEffects plays skilleffectset's .efp rows through EfpEffect; its header
# carries the READ / INFERRED / OURS labels. These are World3D's bindings:
# which body a monster id or a buff owner is, and the buff-token auras.

## A monster's body, or null.
func _fx_monster_body(monster_id: int) -> Node3D:
	if monster_id < 0:
		return null
	var body = _monster_bodies.get(monster_id)
	return body if body != null and is_instance_valid(body) else null

## The body a buff owner is (ownerKind 0 character, 1 monster -- rounds
## 616-618's OpBuffStart suffix), or null when it is not in view. This player
## is decided by the buff board's own check (_buff_owner_is_self: ownerKind 0
## and the id _sync_own_id settles on, OpSelfId's when the server sent it), so
## the aura goes on the body whose icons the board shows (round 616-620
## integration; round 620 compared NetClient.own_character_id alone). Another
## character is its drawn body in _other_bodies; a monster (ownerKind 1) is
## its body in _monster_bodies, whatever its id.
func _fx_owner_body(owner_id: int, owner_kind: int) -> Node3D:
	if owner_kind == SkillNet.OWNER_MONSTER:
		return _fx_monster_body(owner_id)
	if _buff_owner_is_self(owner_id, owner_kind):
		return player
	var body = _other_bodies.get(owner_id)
	return body if body != null and is_instance_valid(body) else null

static func _fx_owner_key(owner_id: int, owner_kind: int) -> String:
	return "%s:%d" % ["monster" if owner_kind == 1 else "character", owner_id]

## OpBuffStart (from _on_buff_started, after the owner is settled): the
## skill's ACT_L aura on the owner's body, kept by token. When it answers this
## player's own self cast of the same skill, that cast's SHOT and ACT play
## first (_fx_self_cast_acts): a buff acts when it applies.
func _fx_on_buff_started(start: SkillNet.BuffStart) -> void:
	var kind := start.owner_kind
	var owner_id := start.owner_id
	var now_ms := Time.get_ticks_msec()
	for k in _recent_buff_starts.keys():
		if now_ms - int(_recent_buff_starts[k]) >= RECENT_BUFF_START_MS:
			_recent_buff_starts.erase(k)
	_recent_buff_starts["%s|%d" % [_fx_owner_key(owner_id, kind), start.skill_id]] = now_ms
	_note_owner_buff(_fx_owner_key(owner_id, kind), start.token, start.skill_id)
	var body := _fx_owner_body(owner_id, kind)
	if body == null:
		print("EFFECTS aura: buff token %d skill %d on %s, not in view -- no aura" % [
			start.token, start.skill_id, _fx_owner_key(owner_id, kind)])
		return
	if body == player:
		_fx_self_cast_acts(start.skill_id, "OpBuffStart token %d" % start.token, false)
	elif not _fx_self_cast.is_empty() and kind == SkillNet.OWNER_CHARACTER \
			and int(_fx_self_cast.get("character", -1)) == owner_id:
		# This player's friendly buff on another player (round 622) acts
		# when it applies, its aura held by the token below.
		_fx_self_cast_acts(start.skill_id, "OpBuffStart token %d on player %d" % [start.token, owner_id], false)
	# The buff's remaining time bounds the aura in case its end never
	# arrives (SkillEffects.AURA_GRACE_MS, OURS).
	var remaining := start.remaining_ms if start.remaining_ms > 0 else start.duration_ms
	# A re-sent start of a buff whose aura already draws on this body keeps it
	# (round 646, SkillEffects.ensure_aura).
	SkillEffects.ensure_aura(_fx_owner_key(owner_id, kind), start.token, start.skill_id, body, remaining)

## Round 646: every buff NetClient holds for `key` (BuffRoster, the server's
## word since the last entry or zone change) is in the target window's book,
## in the DefenseEfp / wall / toggle table, and -- when the owner's body is
## drawn here -- its aura on that body. Called when a body is built and when
## a zone change's arrival is laid out; a start already applied changes
## nothing (Book.start and _note_owner_buff key by token, ensure_aura keeps a
## live aura). The retail client applies a spawned object's buff list to the
## new body with the start effect skipped (FUN_009cf270 -> FUN_00a54020 with
## arg4 1, READ): only the ACT_L aura is put back here, no cast or act.
func _fx_resync_owner(key: String, why: String) -> int:
	var roster: BuffRoster = NetClient.get("buff_roster") as BuffRoster
	if roster == null:
		return 0
	var starts := roster.starts_of(key, Time.get_ticks_msec())
	if starts.is_empty():
		return 0
	var n := 0
	for bs in starts:
		var start: SkillNet.BuffStart = bs
		_target_buff_book.start(key, start.token, start.skill_id)
		_note_owner_buff(key, start.token, start.skill_id)
		var body := _fx_owner_body(start.owner_id, start.owner_kind)
		if body == null:
			continue
		var remaining := start.remaining_ms if start.remaining_ms > 0 else start.duration_ms
		SkillEffects.ensure_aura(key, start.token, start.skill_id, body, remaining)
		n += 1
	print("EFFECTS resync %s (%s): %d buff(s) held, %d on a drawn body" % [key, why, starts.size(), n])
	return n

## _fx_resync_owner for every owner NetClient holds buffs for.
func _fx_resync_all(why: String) -> void:
	var roster: BuffRoster = NetClient.get("buff_roster") as BuffRoster
	if roster == null:
		return
	for key in roster.owners():
		_fx_resync_owner(String(key), why)

## Round 646: the buffs the server sent before this world existed -- the
## in-view replay that follows OpEnterWorldResult, dispatched while
## CharacterSelect was swapping this scene in, when nothing heard
## buff_started -- go through the ordinary start handler now, once the
## bodies of the arrival list are built. Their auras, the book, this
## player's own run speed and ownership; the buff bar is seeded when it is
## built (_build_buff_board).
func _replay_held_buffs(why: String) -> void:
	var roster: BuffRoster = NetClient.get("buff_roster") as BuffRoster
	if roster == null:
		return
	var starts := roster.all_starts(Time.get_ticks_msec())
	print("BUFF replay (%s): %d buff(s) held for %d owner(s)" % [why, starts.size(), roster.owners().size()])
	for bs in starts:
		_on_buff_started(bs)
	# This player's run speed as the last packet said -- a /speed-only
	# OpBuffEnd carries no token for the replay above (round 646's review).
	_sync_own_id()
	if _own_id() >= 0:
		var speed := roster.run_speed_of(_fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER))
		if speed > 0:
			_apply_buff_run_speed(speed, "the run speed held from before this world existed")

## OpBuffEnd: each ended token's aura ends at once.
func _fx_on_buff_ended(ended: SkillNet.BuffEnd) -> void:
	var key := _fx_owner_key(ended.owner_id, ended.owner_kind)
	for t in ended.tokens:
		SkillEffects.detach_aura(key, int(t))
	_forget_owner_buffs(key, ended.tokens)

# --- The protection walls (round 640) -------------------------------------
#
# Fire Wall and Crystal Wall (server session/walls.go): 'onff' toggles whose
# 'pw' wall takes the monster blows of the type it covers. What the retail
# client does with them, READ in sro_client.exe (docs/protocol/skill_buffs.md
# "The protection walls"):
#   - the wall's aura is the buff's own ACT_L loop, held by its token (above);
#   - a blow the wall took arrives as a damage entry of kind 7 (FUN_00a55e00):
#     its number shows over the caster as an ordinary damage number -- always
#     display type 0, never the critical style (FUN_00a47720 sets type 1 only
#     for kinds 0 and 4) -- the HP bar does not move (FUN_00a49290 skips
#     FUN_009c78b0 for kind 7) and no hit reaction plays (state 0xb is skipped
#     too); the wall's remaining HP is shown nowhere (its two u16s are not
#     kept);
#   - while any skill deco whose aniset row names a DefenseEfp is attached, a
#     blow on that body plays that efp in place of the attacker's hit effect
#     (IDecoSkill::FUN_009cd480, the highest Priority); with none, the
#     attacker's DamageEfp plays;
#   - nothing in retail stops the walled player from moving (neither the
#     client's move gates -- FUN_009eb140's body-state mask 0x2476, the 500 ms
#     lock the 0x7074 senders set through FUN_009eb130, the modal checks --
#     nor the server's movement handler read the wall). The root below
#     (_wall_root) is OURS, at the user's request.

## owner key -> {token: skill id} of every buff this client has seen start
## and not end: which DefenseEfp a blow on that body plays.
var _fx_owner_buffs: Dictionary = {}

func _note_owner_buff(key: String, token: int, skill_id: int) -> void:
	var m: Dictionary = _fx_owner_buffs.get(key, {})
	m[token] = skill_id
	_fx_owner_buffs[key] = m

func _forget_owner_buffs(key: String, tokens: Array) -> void:
	var m: Dictionary = _fx_owner_buffs.get(key, {})
	for t in tokens:
		m.erase(int(t))
	if m.is_empty():
		_fx_owner_buffs.erase(key)

## The DefenseEfp a blow on the owner `key` plays (SkillEffectReader.
## defense_efp_for over the owner's running buffs), "" when none names one.
func _defense_efp_on(key: String) -> String:
	var m: Dictionary = _fx_owner_buffs.get(key, {})
	if m.is_empty() or _hud_buff_board == null or _hud_buff_board.catalog == null:
		return ""
	var codes: Array = []
	for t in m:
		var code := String(_hud_buff_board.catalog.info(int(m[t])).get("basic_code", ""))
		if code != "":
			codes.append(code)
	return SkillEffectReader.defense_efp_for(_skill_anisets(), codes)

## Whether this player runs an 'onff' toggle of `skill_id` (round 640): a
## recast of it switches it off on the server (Tick_UseSkill's phase 0,
## 0x4ae622..0x4ae64d, READ) and draws no cast -- the retail caster's cast is
## drawn from the server's 0xB070, which a toggle-off never sends.
func _own_toggle_running(skill_id: int) -> bool:
	if _hud_buff_board == null or _hud_buff_board.catalog == null:
		return false
	if not bool(_hud_buff_board.catalog.info(skill_id).get("onff", false)):
		return false
	var key := _fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER)
	return (_fx_owner_buffs.get(key, {}) as Dictionary).values().has(skill_id)

## The skill id of this player's own protection wall while one stands, else
## 0 (round 640). THE ROOT IS OURS -- the user's choice "Root while walled";
## retail's client and server both let a walled caster move (the probes are
## in docs/protocol/skill_buffs.md). While it holds, no ground click or walk
## into reach moves the player; attacks, skills and
## pick-ups go out from where the player stands and the server's ordinary
## reach rules judge them. The server drops a rooted caster's moves too
## (session/walls.go wallRoots). Whatever ends the wall's buff ends it.
func _wall_root() -> int:
	if _hud_buff_board == null or _hud_buff_board.catalog == null:
		return 0
	var mine: Dictionary = _fx_owner_buffs.get(_fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER), {})
	for t in mine:
		var skill := int(mine[t])
		if bool(_hud_buff_board.catalog.info(skill).get("pw", false)):
			return skill
	return 0

## When a refused move was last logged (an approach is re-asked every tick).
var _root_logged_ms := -100000

## Logs a move the wall refused, at most once a second.
func _log_root(what: String, skill: int) -> void:
	var now := Time.get_ticks_msec()
	if now - _root_logged_ms < 1000:
		return
	_root_logged_ms = now
	print("ROOT: %s refused -- this player's wall (skill %d) roots it (OURS: the user's request, not in retail's binaries)" % [what, skill])

## A monster's blow a protection wall took (round 640): the number over
## `anchor` as an ordinary damage number, the DefenseEfp of the body's
## buffs, the monster's own blow sound -- and no hit reaction and no HP
## change (kind 7, READ). Which sounds retail plays for kind 7 was not read
## (OPEN): the monster's blow sound is kept, the "struck" one is not.
func _draw_wall_blow(anchor: Node3D, owner_key: String, wall: CombatNet.WallHit, monster: int, who: String) -> void:
	if anchor == null or not is_instance_valid(anchor):
		return
	var efp := _defense_efp_on(owner_key)
	print("WALL: monster %d's blow on %s taken by the wall: %d, wall HP %d/%d%s; DefenseEfp '%s'" % [monster, who,
		wall.damage, wall.hp, wall.max_hp, " -- BROKEN" if wall.broke else "",
		efp if efp != "" else "none: the attacker's hit effect"])
	_audio_monster_blow(monster, wall.critical, "blow on %s's wall" % who)
	# With no DefenseEfp on the body (the wall's buff already ended by the
	# breaking blow, say), retail plays the attacker's DamageEfp. The
	# monster's skill is not on srrevamp's wire, so HitEffect's default
	# layers stand in for it (OURS).
	_play_hit_efp_on(anchor, 2.0 * PLAYER_SCALE_RATIO, efp)
	_floating_damage(anchor, 2.0 * PLAYER_SCALE_RATIO, wall.damage, DAMAGE_TAKEN_COLOUR)

## This player's self or ground cast whose effects wait for the server's
## answer (_send_self_cast): {skill, ground, acted}; empty when none.
var _fx_self_cast: Dictionary = {}

## The server answered this player's self or ground cast of `skill_id`
## (OpBuffStart for a buff, OpSkillMove for a ground cast, the accepted reply
## otherwise): the cast leaves WAIT for SHOT (SkillEffects.shot -- READ, the
## server's skill-action message forces SHOT, FUN_00a56680 -> FUN_00a53090),
## its SHOT/1 rows fire (the blow's hit in the monster path; a self cast has
## no clip events here, INFERRED) and ACT_S plays on the player (the object a
## self cast acts on). `with_aura` plays ACT_L one cycle, for a cast no buff
## token will hold. Once per cast: the accepted reply after a buff's start
## adds nothing.
func _fx_self_cast_acts(skill_id: int, why: String, with_aura: bool) -> void:
	if _fx_self_cast.is_empty() or int(_fx_self_cast["skill"]) != skill_id or bool(_fx_self_cast["acted"]):
		return
	_fx_self_cast["acted"] = true
	# A cast at a player (round 622) acts on that player's body: the object
	# the skill acts on (Heal's ACT_S water_hpheal_effect_a.efp at Bip01).
	var on: Node3D = player
	var target_id := int(_fx_self_cast.get("character", -1))
	if target_id >= 0:
		var body = _other_bodies.get(target_id)
		if body != null and is_instance_valid(body):
			on = body
	SkillEffects.shot(player)
	SkillEffects.hit(player, on, skill_id)
	# ACT plays on the object the skill acts on (skills_spec §1.2, INFERRED
	# from the rows: Heal's ACT_S at the healed body's Bip01), so that body is
	# both host arguments: an AT_ONE_FOLLOW row would otherwise go on the
	# caster (SkillEffects.host_for).
	var n := SkillEffects.act(skill_id, on, on, with_aura).size()
	print("EFFECTS self cast: skill %d acts on %s (%d ACT effect(s)%s)" % [skill_id, why, n,
		", on player %d" % target_id if on != player else ""])

## The accepted reply to a self or ground cast: a skill no OpBuffStart or
## OpSkillMove answered (a self-heal, a zero-damage self row) acts now, with
## its ACT_L one cycle.
func _fx_self_cast_accepted() -> void:
	if not _fx_self_cast.is_empty() and _fx_self_cast.has("character") and not bool(_fx_self_cast["acted"]):
		# A cast at a player (round 622) acts after its own prep + cast from
		# the send (_send_character_cast).
		var fx := _fx_self_cast
		var left := int(fx["act_after_ms"]) - (Time.get_ticks_msec() - int(fx["sent_ms"]))
		_after(maxf(float(left), 0.0) / 1000.0, func() -> void:
			var keep := _fx_self_cast
			_fx_self_cast = fx
			_fx_self_cast_acts(int(fx["skill"]), "the accepted reply, %d ms after the send" % int(fx["act_after_ms"]), true)
			_fx_self_cast = keep)
		_fx_self_cast = {}
		return
	if not _fx_self_cast.is_empty():
		_fx_self_cast_acts(int(_fx_self_cast["skill"]), "the accepted reply", true)
	_fx_self_cast = {}

## A refused self or ground cast: its READY / WAIT loops end, nothing more fires.
func _fx_self_cast_refused() -> void:
	if not _fx_self_cast.is_empty():
		print("EFFECTS self cast: skill %d refused -- its cast effects end" % int(_fx_self_cast["skill"]))
	SkillEffects.cancel_cast(player)
	_fx_self_cast = {}

## SRREVAMP_QA_EFFECT's plays (see the hook).
func _qa_play_effects(spec: String) -> void:
	var particles := _open_particles_pk2_if_set()
	var spacing_text := OS.get_environment("SRREVAMP_QA_EFFECT_SPACING")
	var spacing := float(spacing_text) if spacing_text.is_valid_float() else 40.0
	var paths := spec.split(";", false)
	for i in range(paths.size()):
		var path := String(paths[i]).strip_edges()
		var fx := EfpEffect.create(path, particles)
		if fx == null:
			print("QA EFFECT %s: did not build (%s)" % [path, EfpEffect.last_error])
			continue
		fx.loop = true
		var x := (float(i) - float(paths.size() - 1) * 0.5) * spacing
		# SRREVAMP_QA_EFFECT_BONE (round 621) attaches them at that bone
		# instead ("Bip01 R Hand" shows a trail behind a swinging hand).
		var bone := OS.get_environment("SRREVAMP_QA_EFFECT_BONE")
		SkillEffects.attach(fx, player, bone if bone != "" else "none", Vector3(x, 0, 0))
		print("QA EFFECT %s at x %.0f: %d node(s) drawn, skipped %s" % [path, x, fx.draw_count(), str(fx.skipped)])

## SRREVAMP_QA_CAST's schedule (see the hook).
func _qa_cast_step(spec: String) -> void:
	var ids := spec.split(",", false)
	var period_text := OS.get_environment("SRREVAMP_QA_CAST_PERIOD")
	var period := int(period_text) if period_text.is_valid_int() else 160
	var t := _qa_tick - 20
	var idx := t / period
	var at := t % period
	if idx >= ids.size() or not String(ids[idx]).strip_edges().is_valid_int():
		if at == 0 and idx == ids.size():
			SkillEffects.detach_aura("qa:player", 1)
		return
	var skill := int(String(ids[idx]).strip_edges())
	var what := "QA cast"
	match at:
		0:
			SkillEffects.detach_aura("qa:player", 1)
			print("QA CAST tick %d skill %d cast (READY now, WAIT/SHOT by its timing %s)" % [_qa_tick, skill,
				str(SkillEffects._timings.get(skill, "none"))])
			SkillEffects.cast(skill, player, player)
		30:
			print("QA CAST tick %d skill %d shot + hit (SHOT/1)" % [_qa_tick, skill])
			SkillEffects.shot(player)
			SkillEffects.hit(player, player, skill)
		40:
			print("QA CAST tick %d skill %d act (ACT_S)" % [_qa_tick, skill])
			SkillEffects.act(skill, player, player)
		41:
			var n := SkillEffects.attach_aura("qa:player", 1, skill, player).size()
			print("QA CAST tick %d skill %d ACT_L aura: %d effect(s)" % [_qa_tick, skill, n])

# --- Combat and skill sounds (round 614) ---------------------------------------
#
# The code-fired half of the combat audio: CombatAudio builds retail's keys
# (its header has every READ / INFERRED / OURS label) and SkillAudio holds the
# skill tables and the skilleffectset cast sounds. The animation-fired half
# (swings, voices, footsteps) is the .bsr sound tracks'; it reads the player's
# current skill through SkillAudio.set_current / context_of.

## The TypeID4 of the weapon in hand: 0 with the slot empty, -1 for an item
## the item table does not name as a weapon.
func _player_weapon_type_id4() -> int:
	var weapon_id := int(_player_equipped_last.get(EquipmentNet.SLOT_WEAPON, 0))
	if weapon_id == 0:
		return 0
	return int(_item_kinds.get(weapon_id, -1))

## The weapon token FUN_00a648d0 would give for the weapon in hand.
func _player_weapon_token() -> String:
	var tid4 := _player_weapon_type_id4()
	return CombatAudio.weapon_token(tid4, tid4 != 0)

## A cast starts (its clip starts and OpUseSkill goes out): the skill becomes
## the player's current one, and its READY and first SHOT rows sound
## (SkillAudio's header: the phase timing is INFERRED). `fx_timings` goes to
## SkillEffects.cast (a self or ground cast's phase timing from its body clip,
## SelfCast.effect_timings; empty: the skilldata columns).
func _audio_cast_start(skill_id: int, monster_id: int = -1, fx_timings: Dictionary = {}) -> void:
	# A new cast supersedes a self cast still waiting for its answer
	# (_send_self_cast sets it again after this call).
	_fx_self_cast = {}
	SkillAudio.set_current(player, skill_id)
	var what := "cast start"
	SkillAudio.play_phase(skill_id, SkillAudio.READY, -1, player, what)
	SkillAudio.play_phase(skill_id, SkillAudio.SHOT, 0, player, what)
	# The effects run on SkillEffects' cast sequencer (round 620 review): READY
	# now, WAIT and SHOT by the skill's timing columns, SHOT/1 when the blow
	# lands (_audio_blow_lands), and a refusal cancels it (_on_attack_result).
	# The target is the monster this request names, not the last selection.
	SkillEffects.cast(skill_id, player, _fx_monster_body(monster_id), fx_timings)
	var left := SkillAudio.unplayed_rows(skill_id)
	if not left.is_empty():
		AudioLog.line("cast-unplayed:%d" % skill_id, "AUDIO cast: skill %d rows this client does not fire: %s" % [
			skill_id, ", ".join(PackedStringArray(left))])

## The player's blow lands on `monster`: the hit sound at the player (the
## attacker, CombatAudio's header), and for a cast its second SHOT rows, its
## activation (snd_activate) and its ACT_S / ACT_L rows.
## Retail makes the damage decoration, and so the hit sound, for EVERY damage
## record whose caster and target resolve -- no damage or kind check
## (IDecoSkill::FUN_00a4bdd0 / FUN_00a4f720, READ; review of round 614) -- so
## a plain swing sounds whatever it dealt, 0 included. A CAST that dealt 0 is
## silent here (OURS): OpAttackResult cannot tell a zero-damage blow from a
## cast that made no damage record at all (a self-heal, a buff).
func _audio_blow_lands(blow: Dictionary, dealt: int, monster: int) -> void:
	var skill := int(blow["skill"])
	var ctx := SkillAudio.context_for(skill)
	var what := "%s on monster %d, %d damage" % [
		"skill %d" % skill if bool(blow["cast"]) else "plain swing (skill %d)" % skill, monster, dealt]
	if dealt > 0 or not bool(blow["cast"]):
		CombatAudio.play_hit(bool(blow["critical"]), CombatAudio.PLAYER, bool(blow["hwan"]),
			String(ctx["group"]), String(ctx["code"]), _player_weapon_token(), player, what)
	if not bool(blow["cast"]):
		return
	SkillAudio.play_phase(skill, SkillAudio.SHOT, 1, player, what)
	CombatAudio.play_activate(CombatAudio.PLAYER, String(ctx["group"]), player, what)
	SkillAudio.play_phase(skill, SkillAudio.ACT_S, -1, player, what)
	SkillAudio.play_phase(skill, SkillAudio.ACT_L, -1, player, what)
	# The effects of the same phases (round 620): SHOT/1 on the struck body
	# where its row says so, ACT_S where the sound plays. ACT_L is the buff's
	# aura, held by token from OpBuffStart (_fx_on_buff_started), so it is
	# not played here (the 616-620 integration: NetClient always has the
	# signal now).
	var fx_target := _fx_monster_body(monster)
	SkillEffects.hit(player, fx_target, skill)
	SkillEffects.act(skill, player, player, false)

## A monster's blow lands on a character: its hit sound at the monster (the
## attacker), keyed by its sound object and its attack skill. srrevamp's
## server names no monster skill, so the skill token is "-" -- and every
## monster row names one (MEASURED), so this is logged and silent until the
## server sends the skill (OPEN).
func _audio_monster_blow(monster: int, critical: bool, what: String) -> void:
	var body = _monster_bodies.get(monster)
	var snap = _monster_snapshots.get(monster)
	var obj := SoundTable.sound_object(String(snap.code_name)) if snap != null else ""
	if body == null or not is_instance_valid(body):
		body = null
	CombatAudio.play_hit(critical, obj, false, CombatAudio.NONE, CombatAudio.NONE, "", body,
		"monster %d (%s) %s" % [monster, obj if obj != "" else "no sound object", what])

## A shield block on a player character, at the blocker. The blocked record
## still gets its damage decoration, so the attacker's snd_dmg / snd_cridmg
## plays beside it (FUN_00a49780 has no block check, READ): the callers pair
## this with _audio_monster_blow.
## Not implemented: retail's gate on the call that plays it -- FUN_00a49290
## reaches FUN_00a47bf0 only when the struck object's +0x65c & 1 is set, its
## +0xbc byte is non-zero, its +0x24c distance is under the constant at
## 0xe1b8b8 or param_3 is the local player (DAT_00eef5ec), and the global flag
## DAT_00ec4b58 is set (READ, 0xa49290's tail) -- none of which is modelled:
## every block the client learns of sounds.
func _audio_block(blocker: Node3D, critical: bool, what: String) -> void:
	CombatAudio.play_block(CombatAudio.PLAYER, critical, blocker, what)

# --- Sitting down and standing up (round 607) ----------------------------------
#
# docs/protocol/opcodes/motion.md. N asks the server (OP_MOTION_REQUEST [4]) and
# nothing animates until it answers with OP_STATE_CHANGE kind 1 -- as the retail
# client does (its N handler only sends; 0x8a80a0 animates on the answer). The
# clips are the body's own, looked up by action type in its .bsr: 13 sit down,
# 14 sitting (a loop), 15 stand up -- the retail sit entry (0xa5a270) plays 13
# only when it comes from standing, and its stand entry (0xa5a160) plays 15 only
# when it comes from sitting.

## N: ask to sit down or stand up. Not while dead, not while a request is
## already out or the server is still in its transition (it would refuse), and
## not without a server. The body stops first: the server sits a walker down by
## stopping it (slot 0x4b0), and this server cannot stop the client.
func _request_sit_toggle() -> String:
	if _player_dead or _is_typing() or not NetClient.is_connected_to_server() or _motion_locked():
		return "not sent (%s)" % ("dead" if _player_dead else "typing" if _is_typing()
			else "not connected" if not NetClient.is_connected_to_server() else "a motion change is in flight")
	var was_sitting := _sit.sitting
	_has_move_target = false
	_drop_pending_attack()
	player.velocity.x = 0.0
	player.velocity.z = 0.0
	# The stop is sent before the request, so the server does not take a
	# later position update for a move made in its transition.
	if player.position != _last_sent_pos:
		NetClient.move_to(player.position.x, player.position.y, player.position.z, _position_relocated())
		_last_sent_pos = player.position
		_walked_since_send = 0.0
		_time_since_send = 0.0
	_sit.press(_player_anim_time)
	print("SIT: N pressed -- sending 0x704f [04] (sitting=%s)" % str(was_sitting))
	NetClient.request_motion(WorldNet.MOTION_SIT)
	return "0x704f [04] sent (%s)" % ("standing up" if was_sitting else "sitting down")

## Whether movement input is held for the motion: a request in flight, or the
## server's transition after its answer.
func _motion_locked() -> bool:
	return _sit.locked(_player_anim_time)

# --- The keyboard (round 608) ---------------------------------------------------
#
# KeyMap is the retail client's key table and KeyInput runs it; this is what
# each action does in this world. The windows' keys are HudPanels'.

## Runs the key table against this world (_setup_keys).
var _key_input: KeyInput = null
## The last player who whispered this one, for R's reply (KeyMap slot 20).
var _last_whisperer := ""
## Whether V's hide is on the bodies now (_apply_key_holds).
var _objects_hidden := false
## The ground item under the mouse, or -1. Its name shows: CIItem::vslot_010
## (0x9e15b0) draws the name when the item's +0xf0 is set (read); that +0xf0
## is "hovered or selected" is inferred.
var _hovered_ground_item := -1
## When G's pick went out (-1: never), for the pending gate in
## _key_pick_up_nearest.
var _pickup_inflight_since_ms := -1
## 0x77c9b0 reports an action pending until the flag +0x4f8 is 20000 ms old
## (0x77c9ce, read); G gives up while one is.
const PICKUP_PENDING_MS := 20000
## G takes the nearest CIItem strictly closer than this, in 3-D (0x9e18f0,
## .rdata 0xd851a0 = 50.0, read).
const PICKUP_SEARCH_RADIUS := 50.0
## Z shows the names of dropped items strictly closer than this (0x9e15b0,
## `+0x24c < 300.0`, .rdata 0xd85224, read).
const ITEM_NAME_RADIUS := 300.0

func _setup_keys() -> void:
	if _key_input != null:
		return
	_key_input = KeyInput.new({
		"is_typing": Callable(self, "_is_typing"),
		"run": Callable(self, "_run_key_action"),
		"held": Callable(self, "_on_key_held"),
		"panel": Callable(self, "_run_panel_key"),
	})
	_key_input.name = "KeyInput"
	add_child(_key_input)

## A window's key (KeyMap's "panel:" slots, and M for the world map), read
## by KeyInput before the GUI so no focused control on the way can take it
## (v0.1.453 playtest: Tab, read there, worked; the window keys, left to
## HudPanels' _unhandled_key_input, did not). The same toggles HudPanels' own
## key handler uses. Returns a line for the log.
func _run_panel_key(action: String) -> String:
	if _hud_panels == null:
		return "no HUD"
	if action == "worldmap":
		_hud_panels.world_map_toggle_requested.emit()
		return "world map toggled"
	var panel_id := action.substr(6)
	_hud_panels.toggle(panel_id)
	return "%s %s" % [panel_id, "open" if _hud_panels.is_open(panel_id) else "closed"]

## One key action (KeyMap), and a line for the log saying what it did.
## The windows' keys come through _run_panel_key instead.
func _run_key_action(action: String, arg: int) -> String:
	match action:
		"berserk":
			if NetClient.current_character_name == "" or not NetClient.is_connected_to_server():
				return "not connected"
			# The client's own gate (0x00778ac0, READ): with fewer than five
			# orbs held it asks for nothing and says nothing. The count is the
			# HUD's, from the stats packet and every AttackResult; before any
			# has arrived it is unknown and the server decides.
			if _hud_player_info != null and _hud_player_info.hwan_known() and not _hud_player_info.hwan_ready():
				return "not requested: %d of 5 orbs held" % _hud_player_info.hwan_charges()
			# The server judges the five-orb gauge (the berserk_result
			# handler says "not full yet"); the retail client tests +0x886 >= 5
			# itself first (0x778ac0, read).
			NetClient.berserk(NetClient.current_character_name)
			return "berserk requested"
		"help":
			if _help_window == null:
				return "no help window"
			if _help_window.visible:
				_help_window.hide()
				return "help closed"
			_help_window.open()
			return "help opened"
		"mouse_slot":
			if _hud_underbar == null:
				return "no hotbar"
			_hud_underbar.activate_mouse_slot()
			return "quick slot 0 (m)"
		"sit":
			return _request_sit_toggle()
		"pickup":
			return _key_pick_up_nearest()
		"whisper_reply":
			return _key_whisper_reply()
		"page":
			if _hud_underbar == null:
				return "no hotbar"
			_hud_underbar.set_page(arg)
			return "page F%d" % _hud_underbar.current_page()
		"quickslot_key":
			if _hud_underbar == null:
				return "no hotbar"
			_hud_underbar.activate_key(arg - 1)
			return "quick slot %d" % _hud_underbar.slot_for_key(arg - 1)
		"quickslot":
			if _hud_underbar == null:
				return "no hotbar"
			_hud_underbar.activate_slot(arg)
			return "quick slot %d" % arg
		"camera_cycle":
			return _key_cycle_camera()
		"hide_ui":
			_toggle_ui_visibility()
			return "UI %s" % ("shown" if ui_control.visible else "hidden")
		"screenshot":
			return _save_screenshot()
		"dev_tools":
			_toggle_dev_ui()
			return "developer tools %s" % ("shown" if _dev_ui_visible else "hidden")
		"debug_tabs":
			_toggle_action_panels()
			return "debug tabs %s" % ("shown" if action_tabs.visible else "hidden")
		"debug_panel":
			if _debug_panel == null:
				return "no debug panel"
			_debug_panel.toggle()
			return "debug panel %s" % ("shown" if _debug_panel.visible else "hidden")
		"select_self":
			# 0x77f230 -> 0x78f5f0(player+0xf8) (read). This client's target
			# window shows monsters only.
			return "no-op: selecting yourself is not built (the target window shows monsters only)"
		"select_party":
			# 0x77f230 -> the quick party window's member n-2 (read). No player
			# can be targeted in this client.
			return "no-op: selecting party member %d is not built (no player targets)" % arg
		"pet_info", "pet_ride", "pet_unsummon", "pet_follow", "pet_attack", "pet_ai", "pet_switch":
			return "no-op: no pet or COS in this client"
	return "no-op: %s is not built" % action

## A held key went down or up (V, Z): applied at once, and every frame after
## (_apply_key_holds).
func _on_key_held(action: String, _down: bool) -> void:
	_apply_key_holds()
	# The cursor and the hovered item's name follow V at once, not on the
	# next mouse motion: a monster under the mouse stops (or starts) being
	# an attack target with the press.
	if action == "hide_objects":
		_cursor_last_check_ms = 0
		_settle_hover_cursor()

## V and Z, while held. V hides what KeyMap.hides_under_v names -- here the
## other players and the monsters, the only such objects this client draws;
## NPCs, the player and the dropped items stay. A hidden object also cannot
## be clicked or hovered (_pick_character, _hover_kind_at): 0x9d11c0,
## vtable slot 20, returns 0 for it, and 0x9c7620 tests slot 20 before its
## ray test (read), so that the pick skips it is **inferred**. The minimap
## still shows them (whether retail's minimap reads the flag was not read).
## Z shows the dropped items' names within ITEM_NAME_RADIUS; otherwise a
## name shows only while the mouse is on the item (GroundItems.update_labels).
func _apply_key_holds() -> void:
	var hiding := _key_input != null and _key_input.is_held("hide_objects")
	if hiding or hiding != _objects_hidden:
		var players := _show_bodies(_other_bodies, not (hiding and KeyMap.hides_under_v("other_player")))
		var monsters := _show_bodies(_monster_bodies, not (hiding and KeyMap.hides_under_v("monster")))
		if hiding != _objects_hidden:
			print("KEYS: V %s -- %d other player(s) and %d monster(s) %s; NPCs and dropped items kept" % [
				"held" if hiding else "released", players, monsters, "hidden" if hiding else "shown"])
	var changed := hiding != _objects_hidden
	_objects_hidden = hiding
	if changed and _qa_input_armed:
		_qa_probe_hidden_pick()
	if _ground_items != null and player != null:
		var near := _key_input != null and _key_input.is_held("item_names")
		var shown := _ground_items.update_labels(player.global_position,
			ITEM_NAME_RADIUS if near else -1.0, _hovered_ground_item)
		if near != _item_names_near:
			_item_names_near = near
			print("KEYS: Z %s -- %d of %d dropped item name(s) shown" % [
				"held" if near else "released", shown, _ground_items.count()])

var _item_names_near := false

## QA (SRREVAMP_QA_INPUT): at each V change, what the hover ray makes of the
## nearest monster's click capsule, and how many monster bodies are drawn --
## the measurement that a hidden monster is neither drawn nor picked.
func _qa_probe_hidden_pick() -> void:
	var best: Node3D = null
	var best_d := INF
	for id in _monster_bodies:
		var body := _monster_bodies[id] as Node3D
		if body == null or not is_instance_valid(body):
			continue
		var d := body.global_position.distance_to(player.global_position)
		if d < best_d:
			best_d = d
			best = body
	var drawn := 0
	for id in _monster_bodies:
		var b := _monster_bodies[id] as Node3D
		if b != null and is_instance_valid(b) and b.is_visible_in_tree():
			drawn += 1
	if best == null or camera_3d == null:
		print("QA KEYS: V %s -- no monster to probe (%d drawn)" % ["held" if _objects_hidden else "released", drawn])
		return
	var shape := best.get_node_or_null("ClickBody/CollisionShape3D") as Node3D
	var at := shape.global_position if shape != null else best.global_position
	var kind := "behind the camera"
	var screen := Vector2(-1, -1)
	if not camera_3d.is_position_behind(at):
		screen = camera_3d.unproject_position(at)
		kind = _hover_kind_at(screen)
	print("QA KEYS: V %s -- %d of %d monster bodies drawn; the nearest (#%s, %.1f away) at screen %s hovers as '%s'" % [
		"held" if _objects_hidden else "released", drawn, _monster_bodies.size(),
		str(best.get_meta("monster_id", "?")), best_d, screen, kind])

## Shows or hides every body in an id -> Node3D map; returns how many there are.
func _show_bodies(bodies: Dictionary, shown: bool) -> int:
	var n := 0
	for id in bodies:
		var body := bodies[id] as Node3D
		if body != null and is_instance_valid(body):
			n += 1
			if body.visible != shown:
				body.visible = shown
	return n

## G: the nearest ground item strictly within PICKUP_SEARCH_RADIUS of the
## player, in 3-D, as 0x9e18f0 searches (read); then this client's pick path
## (_pick_up_ground_item): a walk into the server's 10-unit reach and its
## pick request. Retail sends 0x7074 [01 02 01 <uid>] and leaves the approach
## to its server (inferred: the G path has no movement code); this server
## does not walk players. Retail's own refusals before sending (the item
## already taken, +0x258 == -1; client state 10; a UI lock; an owner that is
## neither the player nor a party member, 0x1812) are not all made here: the
## server makes the owner one and answers with the same 0x1812 line.
func _key_pick_up_nearest() -> String:
	if _player_dead:
		return "dead: nothing picked"
	if _ground_items == null or not NetClient.is_connected_to_server():
		return "no ground items"
	if _pickup_inflight and _pickup_inflight_since_ms >= 0 \
			and Time.get_ticks_msec() - _pickup_inflight_since_ms < PICKUP_PENDING_MS:
		return "a pick is still pending"
	var ground_id := _ground_items.nearest_within(player.global_position, PICKUP_SEARCH_RADIUS)
	if ground_id < 0:
		return "no item within %.0f" % PICKUP_SEARCH_RADIUS
	var dist := _ground_items.position_of(ground_id).distance_to(player.global_position)
	_pick_up_ground_item(ground_id)
	return "ground item %d at %.1f: %s" % [ground_id, dist,
		"walking to it" if _has_move_target else "picking it up"]

## R: the chat line opened with a whisper to the last player who whispered
## (KeyMap.reply_line has what was read). The line takes the keyboard so the
## player can type (ours: whether 0x7ab470 moves the focus was not read).
func _key_whisper_reply() -> String:
	var line := KeyMap.reply_line(_last_whisperer, NetClient.current_character_name)
	if line == "":
		return "no whisper to reply to"
	if _hud_chat == null or not _hud_chat.open_with(line):
		return "no chat line"
	return "chat line opened with '%s'" % line

## F9: the next camera view (KeyMap.next_camera_view), announced with the
## client's own line for it (0x780420 shows it through 0x7781b0(0, text),
## the system message window's add -- READ in round 639).
func _key_cycle_camera() -> String:
	var current := maxi(CAMERA_VIEWS.find(_camera_view), 0)
	var next := KeyMap.next_camera_view(current)
	set_camera_view(CAMERA_VIEWS[next])
	# Kept, as the debug panel's selector keeps it, and shown there.
	ClientSettings.set_value(ClientSettings.SECTION_UI, ClientSettings.KEY_CAMERA_VIEW, _camera_view)
	if _debug_panel != null:
		_debug_panel.sync_view()
	var line := _ui_text_table.get_text(KeyMap.camera_view_string(next), "") if _ui_text_table != null else ""
	if line != "":
		_log_system(line)
	return "camera view %s, announced '%s'" % [_camera_view, line]

## PrintScreen: the frame as a JPEG in user://screenshots/ -- beside
## user://logs/, under the file name and quality 0xba7240 uses (KeyMap).
## Retail writes `ScreenShot\` in its install folder; this client writes into
## its user folder, where the logs are (ours). The chat line is ours.
func _save_screenshot() -> String:
	var tex := get_viewport().get_texture()
	var img: Image = tex.get_image() if tex != null else null
	if img == null or img.is_empty():
		return "no frame to save"
	var dir := "user://screenshots"
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(dir))
	var path := "%s/%s" % [dir, KeyMap.screenshot_name(Time.get_datetime_dict_from_system(), randi())]
	var err := img.save_jpg(path, KeyMap.SCREENSHOT_JPEG_QUALITY / 100.0)
	if err != OK:
		return "screenshot not saved (error %d)" % err
	var full := ProjectSettings.globalize_path(path)
	_log_system("Screenshot saved: %s" % full)
	return "saved %s" % full

## QA: how high the body's Bip01 Pelvis is above the player's feet, in world
## units -- a sitting pose measured rather than looked at. "-" without a body.
func _qa_pelvis_height() -> String:
	if _player_skeleton == null or not is_instance_valid(_player_skeleton):
		return "-"
	var bone := _player_skeleton.find_bone("Bip01 Pelvis")
	if bone < 0:
		return "-"
	var at := _player_skeleton.global_transform * _player_skeleton.get_bone_global_pose(bone)
	return "%.2f" % (at.origin.y - player.global_position.y)

## A buff began (OpBuffStart, round 617). Only its run speed is applied here
## -- the icon is round 618's buff bar and the aura round 619's -- and only
## for this player (SelfCast.claims_start). runSpeed is the owner's new run
## speed in the units _move_speed moves by (characterdata Speed2, the same
## number the server moves the character by); 0 means unchanged.
func _on_buff_started(start: SkillNet.BuffStart) -> void:
	_sync_own_id()
	var mine := _self_cast.claims_start(start.owner_id, start.owner_kind, start.skill_id, start.token, _other_bodies, Time.get_ticks_msec())
	print("BUFF start handled: owner %d is %s" % [start.owner_id, "this player" if mine else "someone else"])
	if mine:
		_apply_buff_run_speed(start.run_speed, "OpBuffStart skill %d token %d" % [start.skill_id, start.token])
		_refresh_stat_panel("own buff started")
	_target_buff_book.start(_fx_owner_key(start.owner_id, start.owner_kind), start.token, start.skill_id)
	_fx_on_buff_started(start)

## Buffs ended (OpBuffEnd, round 617): this player's run speed, as for a start.
func _on_buff_ended(ended: SkillNet.BuffEnd) -> void:
	_sync_own_id()
	var mine := _self_cast.claims_end(ended.owner_id, ended.owner_kind, ended.tokens)
	print("BUFF end handled: owner %d is %s" % [ended.owner_id, "this player" if mine else "someone else"])
	if mine:
		_apply_buff_run_speed(ended.run_speed, "OpBuffEnd tokens %s" % str(ended.tokens))
		_refresh_stat_panel("own buff ended")
	_target_buff_book.end(_fx_owner_key(ended.owner_id, ended.owner_kind), ended.tokens)
	_fx_on_buff_ended(ended)

## OpSelfId arrived (round 617's review): this player's own id, for the buff
## and move handlers and the sit state alike.
func _on_self_id_received(_character_id: int) -> void:
	_sync_own_id()
	# This player selected before its id came (round 638 review): the target
	# window's owner "character:-1" becomes the real id's key.
	if _hud_target != null and _hud_target.buff_owner() == _fx_owner_key(-1, SkillNet.OWNER_CHARACTER) and _own_id() >= 0:
		_hud_target.set_buff_owner(_fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER))
		_selected_character = _own_id()

## Brings the two holders of this player's own id into line with the best
## source: OpSelfId (NetClient.own_character_id) when the server sent it --
## the sit state's learned id is checked against it and replaced -- else the
## id the sit answer taught, which SelfCast then takes as told instead of
## guessing from its own casts.
func _sync_own_id() -> void:
	var told := int(NetClient.own_character_id)
	if told >= 0:
		if _sit.own_id >= 0 and _sit.own_id != told:
			print("SELF id: the sit state had learned %d, OpSelfId says %d -- using %d" % [_sit.own_id, told, told])
		_sit.own_id = told
		if _self_cast.own_id != told or not _self_cast.own_id_told:
			if _self_cast.own_id >= 0 and _self_cast.own_id != told:
				print("SELF id: buffs had taught %d, OpSelfId says %d -- using %d" % [_self_cast.own_id, told, told])
			_self_cast.tell_own_id(told)
	elif _sit.own_id >= 0 and not _self_cast.own_id_told:
		_self_cast.tell_own_id(_sit.own_id)

## Sets the player's run speed from a buff packet; 0 leaves it.
func _apply_buff_run_speed(run_speed: int, why: String) -> void:
	if run_speed <= 0:
		print("SPEED: run speed stays %.0f (%s: runSpeed 0 = unchanged)" % [_move_speed, why])
		return
	print("SPEED: run speed %.0f -> %d (%s)" % [_move_speed, run_speed, why])
	_move_speed = float(run_speed)
	_server_run_speed = run_speed

## A skill moved a character (OpSkillMove, round 617: Ghost Walk's landing).
## This player is put at the point at once. The move's duration is OPEN
## (skills_spec §2.3: tele value[0] = 500 is unread by the server's clamp,
## perhaps milliseconds), so it is a SNAP, not a tween -- ours, until that is
## read. Another player's body is put there and its walk target with it.
func _on_skill_moved(moved: SkillNet.SkillMove) -> void:
	_sync_own_id()
	var to := Vector3(moved.x, moved.y, moved.z)
	if _other_bodies.has(moved.character_id):
		var body: Node3D = _other_bodies[moved.character_id]
		body.position = to
		_other_body_targets[moved.character_id] = to
		print("SKILL move handled: player %d snapped to (%.1f, %.1f, %.1f) by skill %d" % [
			moved.character_id, to.x, to.y, to.z, moved.skill_id])
		return
	# Round 640, OURS: the server dropped a move its wall's root refused and
	# answered with the position it holds -- this player stays there.
	if moved.character_id == _own_id() and moved.skill_id != 0 and moved.skill_id == _wall_root():
		_drop_pending_attack()
		_has_move_target = false
		player.velocity = Vector3.ZERO
		var held: Dictionary = _settle_skill_move_footing(to)
		player.position = held["to"]
		_last_sent_pos = player.position
		_walked_since_send = 0.0
		_time_since_send = 0.0
		print("ROOT: the server holds this player at (%.1f, %.1f, %.1f) -- its wall (skill %d) roots it" % [
			player.position.x, player.position.y, player.position.z, moved.skill_id])
		return
	if not _self_cast.claims_move(moved.character_id, moved.skill_id, _other_bodies, Time.get_ticks_msec()):
		print("SKILL move handled: character %d is neither drawn here nor this player's cast -- ignored" % moved.character_id)
		return
	# The ground cast's answer: its WAIT loop ends and SHOT/ACT play
	# (round 616-620 integration; skills_spec §1.5 -- Ghost Walk's rows are a
	# READY with no effect and the WAIT loop lightning_bobeop_move_a.efp).
	_fx_self_cast_acts(moved.skill_id, "OpSkillMove", true)
	# The skill's move ends the movement order (_player_move_order; INFERRED
	# from the skill paths' FUN_009e0150).
	_player_move_order = false
	var from := player.position
	_drop_pending_attack()
	_has_move_target = false
	player.velocity = Vector3.ZERO
	var settled := _settle_skill_move_footing(to)
	to = settled["to"]
	var footing: String = settled["footing"]
	player.position = to
	# The server already has the player there; do not send it back.
	_last_sent_pos = to
	_walked_since_send = 0.0
	_time_since_send = 0.0
	print("SKILL move handled: this player snapped (duration OPEN) from (%.1f, %.1f, %.1f) to (%.1f, %.1f, %.1f), %.1f units, by skill %d, footing %s" % [
		from.x, from.y, from.z, to.x, to.y, to.z, from.distance_to(to), moved.skill_id, footing])

## Puts the walk's footing (_nav_footing) at a skill-move landing at once, so
## the player stands on the graph there rather than at the packet's height
## until the next step (round 616-618 integration). The landing this client
## resolved and sent (_ground_landing) gives the footing and height when the
## server moved the player to that very point; any other point -- the server
## clamped it again, or no landing was resolved -- is settled from the graph
## under it (surface_at, reference the packet's height). Returns {"to": the
## point on the ground, "footing": the footing's name for the log}.
func _settle_skill_move_footing(to: Vector3) -> Dictionary:
	var landing := _ground_landing
	_ground_landing = null
	var pair := _nav_graph_for(to)
	if pair.is_empty():
		return {"to": to, "footing": "unsettled (no navmesh under the landing)"}
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	if landing != null and not landing.unchecked and landing.graph == graph \
			and Vector2(landing.sent.x, landing.sent.z).distance_to(Vector2(to.x, to.z)) < 0.01:
		_nav_footing = landing.footing
		to.y = landing.position.y
	else:
		var local := group.to_local(to)
		var surface := graph.surface_at(local.x, local.z, local.y)
		_nav_footing = surface.object_index
		to.y = group.to_global(Vector3(local.x, surface.height, local.z)).y
	_nav_footing_graph = graph
	_nav_footing_pos = to
	return {"to": to, "footing": _nav_footing_name(graph, _nav_footing)}

## OP_STATE_CHANGE: kind 1 is the motion state. This player's own id is
## OpSelfId's when the server sent one (round 617's review, _sync_own_id);
## otherwise the first answer to its own N teaches it; any other id is another
## player's body.
func _on_state_changed(change: WorldNet.StateChange) -> void:
	_sync_own_id()
	if change != null and change.kind == WorldNet.STATE_KIND_BODY_MODE:
		_on_body_mode(change)
		return
	if change == null or change.kind != WorldNet.STATE_KIND_MOTION:
		return
	match _sit.classify(change.object_id, _other_bodies.has(change.object_id), _player_anim_time):
		"other":
			_apply_other_motion(change.object_id, change.value)
		"self":
			_apply_player_motion(change.value)
		_:
			print("SIT: state change for unknown id %d (value %d) ignored" % [change.object_id, change.value])

## 0x30BF kind 4, the body mode (round 629's review). READ, 0x8a80a0: for this
## player and value 1 the client runs FUN_00778ae0(0, 1) -- the orbs' berserk
## display starts, the count now 0; value 0 ends the body mode and leaves the
## display to its own timer. Every body's berserk look -- this player's and
## every other player's -- follows its body mode (round 651, _berserk_apply).
func _on_body_mode(change: WorldNet.StateChange) -> void:
	var own := _own_id()
	var mine := own >= 0 and change.object_id == own
	print("World3D: body mode %d for %d (%s)" % [change.value, change.object_id, "this player" if mine else "someone else"])
	_berserk_apply(change.object_id, change.value, false)
	if mine and change.value == 1 and _hud_player_info != null:
		var was_running := _hud_player_info.hwan_display_active()
		_hud_player_info.set_hwan(0, true)
		if not was_running:
			print("World3D: berserk display started: drain step %.3f s (bonus %d s), %.3f s in all" % [
				_hud_player_info.drain_period(), _hud_player_info.hwan_time_bonus(),
				_hud_player_info.drain_period() * HudPlayerInfo.BERSERK_ORBS])

## Round 651: `object_id`'s berserk look follows its body mode -- on for 1,
## off for anything else (BerserkLook). The body is this player's when the id
## is its own, else the other player's drawn body; a body not drawn yet takes
## it when it is built (_berserk_resync, from NetClient.body_modes). Retail
## runs the setter on any object in view (0x8a80a0 -> FUN_009cf880, READ).
## `instant`: the body was already berserk when it came into view -- no start
## burst, no sound, no flash (the spawn's arg 1, READ). This player's own
## start also flashes the screen (0x8a827b, READ) and turns its swings to the
## hwan sounds, as another player's does theirs.
func _berserk_apply(object_id: int, value: int, instant: bool) -> void:
	var own := _own_id()
	var mine := own >= 0 and object_id == own
	var body: Node3D = player if mine else _other_bodies.get(object_id)
	if body == null or not is_instance_valid(body):
		return
	if value == 1:
		BerserkLook.start(body, instant, mine)
		if mine and not instant:
			_berserk_flash_t = 0.0
	else:
		# The server ends a running berserk with a zone change (endBerserk)
		# and tells the mover so on arrival. The original client meets that
		# arrival with a rebuilt object (a teleport is a re-entry, INFERRED),
		# so no end burst or hwanreturn.wav plays on it (round 651's review):
		# the mover's own look goes silently (BerserkLook.end).
		BerserkLook.end(body, mine and _arrival_pending)
	if mine:
		_audio_set_hwan(value == 1)
	elif _other_gaits.has(object_id):
		var skel = _other_gaits[object_id].get("skeleton")
		if skel != null and is_instance_valid(skel):
			var snd_owner = _anim_sounds.owner_of(skel)
			if snd_owner != null:
				snd_owner.hwan = value == 1

## Round 651: the body mode NetClient holds for `character_id` (the server's
## word since the last entry or zone change) goes on its freshly built body.
func _berserk_resync(character_id: int, why: String) -> void:
	var modes = NetClient.get("body_modes")
	if modes == null or int((modes as Dictionary).get(character_id, 0)) != 1:
		return
	print("BERSERK resync %d (%s): berserk" % [character_id, why])
	_berserk_apply(character_id, 1, true)

## _berserk_resync for every character NetClient holds a body mode for.
func _berserk_resync_all(why: String) -> void:
	var modes = NetClient.get("body_modes")
	if modes == null:
		return
	for id in (modes as Dictionary).keys():
		_berserk_resync(int(id), why)

## The own activation's screen flash (BerserkLook.flash_alpha, READ): a
## screen-sized quad adding white x alpha (SRCBLEND SRCALPHA, DESTBLEND
## SRCCOLOR, READ), drawn over the world and under the HUD (the weather
## manager draws it in the world pass, INFERRED from where vslot_010 runs).
## QA (round 651): SRREVAMP_QA_BERSERK_PROBE=1 prints, once a second, where
## every drawn player's chest is on this client's screen and the colour
## BerserkLook draws their body with -- the point a live run samples the
## frame at, so the glow is measured as pixels rather than judged by eye.
var _qa_berserk_probe_on := OS.get_environment("SRREVAMP_QA_BERSERK_PROBE") != ""
var _qa_berserk_probe_frame := 0

func _qa_berserk_probe() -> void:
	if not _qa_berserk_probe_on or camera_3d == null:
		return
	_qa_berserk_probe_frame += 1
	if _qa_berserk_probe_frame % 60 != 0:
		return
	var bodies := {"self": player}
	for id in _other_bodies:
		bodies[str(id)] = _other_bodies[id]
	for who in bodies:
		var body: Node3D = bodies[who]
		if body == null or not is_instance_valid(body) or not body.is_inside_tree():
			continue
		var skel := SkillEffects.skeleton_of(body)
		var top := _skeleton_top(skel) if skel != null else 1.8 * PLAYER_SCALE_RATIO
		var chest := body.global_position + Vector3.UP * top * 0.6
		var on := not camera_3d.is_position_behind(chest)
		var at := camera_3d.unproject_position(chest)
		var vp := get_viewport().get_visible_rect().size
		on = on and at.x >= 0 and at.y >= 0 and at.x < vp.x and at.y < vp.y
		var tint = BerserkLook.tint_of(body)
		print("QA BERSERK PROBE %s screen %d,%d of %dx%d %s tint %s scale %.3f" % [who, int(at.x), int(at.y),
			int(vp.x), int(vp.y), "on" if on else "off", "none" if tint == null else "%d,%d,%d" % [
			int(round(tint.r * 255)), int(round(tint.g * 255)), int(round(tint.b * 255))], BerserkLook.scale_of(body)])

var _berserk_flash_t := -1.0
var _berserk_flash: ColorRect = null

func _berserk_flash_step(delta: float) -> void:
	if _berserk_flash_t < 0.0:
		return
	var a := BerserkLook.flash_alpha(_berserk_flash_t)
	_berserk_flash_t += delta
	if _berserk_flash == null or not is_instance_valid(_berserk_flash):
		var layer := CanvasLayer.new()
		layer.name = "BerserkFlash"
		layer.layer = -1
		add_child(layer)
		_berserk_flash = ColorRect.new()
		_berserk_flash.set_anchors_preset(Control.PRESET_FULL_RECT)
		_berserk_flash.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var add := CanvasItemMaterial.new()
		add.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
		_berserk_flash.material = add
		layer.add_child(_berserk_flash)
	_berserk_flash.color = Color(1, 1, 1, a)
	_berserk_flash.visible = a > 0.0
	if _berserk_flash_t >= BerserkLook.FLASH_IN_S + BerserkLook.FLASH_OUT_S:
		_berserk_flash_t = -1.0
		_berserk_flash.visible = false

## The server's answer for this player: sit (4) or stand (0), through the 1.5 s
## transition in which it refuses a move.
func _apply_player_motion(value: int) -> void:
	var what := _sit.answer(value, _player_anim_time)
	match what:
		"sit_down", "sit":
			var loop := _body_animation_path(_player_body, BsrReader.AnimationEntry.TYPE_SITTING, _player_weapon_group)
			if what == "sit_down":
				var down := _body_animation_for(_player_body, BsrReader.AnimationEntry.TYPE_SIT_DOWN, _player_weapon_group)
				if _play_player_once(down) > 0.0:
					_player_sit_clip = down
				print("SIT: player sits -- clip %s (action type 13), then %s (type 14, loop)" % [
					_body_animation_path(_player_body, BsrReader.AnimationEntry.TYPE_SIT_DOWN, _player_weapon_group), loop])
			else:
				print("SIT: player sits -- clip %s (type 14, loop)" % loop)
		"stand_up", "stand":
			if what == "stand_up":
				var up := _body_animation_for(_player_body, BsrReader.AnimationEntry.TYPE_STAND_UP, _player_weapon_group)
				if _play_player_once(up) > 0.0:
					_player_sit_clip = up
				print("SIT: player stands -- clip %s (action type 15)" % _body_animation_path(
					_player_body, BsrReader.AnimationEntry.TYPE_STAND_UP, _player_weapon_group))
		_:
			print("SIT: motion value %d for the player is not one srrevamp plays" % value)

## A move while seated: the server accepts it and puts the character on its
## feet at once (its movement handler's SetMotionState(WALK/RUN), no
## transition), so the sit ends here without the stand-up clip, and a sit-down
## or stand-up clip still running gives way to the run.
func _leave_sit_by_moving() -> void:
	var was_sitting := _sit.leave_by_moving()
	if was_sitting and NetClient.is_connected_to_server():
		# The server stands a seated character on its first accepted move; a
		# tap too short for the ordinary send gate must still reach it, or the
		# server keeps her seated while this client draws her standing (round
		# 607's review).
		NetClient.move_to(player.position.x, player.position.y, player.position.z, _position_relocated())
		_last_sent_pos = player.position
		_walked_since_send = 0.0
		_time_since_send = 0.0
	if not _player_one_shot_hold and _player_sit_clip != null and _player_one_shot == _player_sit_clip:
		_player_one_shot = null
	_player_sit_clip = null
	if was_sitting:
		print("SIT: moved while seated -- standing at once, no clip (the server's move sets WALK/RUN)")

## Spawns the other players an enter-world or zone-change result lists, and
## seats the ones its Seated tail names (round 607): the result that spawns a
## body is where its motion has to arrive -- a 0x30bf behind it reached this
## client before the world scene, or the new zone's bodies, existed. A body
## drawn seated takes the sitting loop without the sit-down clip.
func _spawn_result_others(others: Array, seated: Array) -> void:
	for other in others:
		# Each faces its heading from the list's tail (round 637's review
		# follow-up; NAN from an older server).
		_spawn_or_update_other(other.character_id, other.char_name, Vector3(other.x, other.y, other.z), other.equipped,
			_snapshot_body(other), other.heading, other.scale if other.has_model else CharacterAppearance.DEFAULT_SCALE)
	for id in seated:
		if not _other_bodies.has(int(id)):
			continue
		_other_seated[int(id)] = true
		var gait: Dictionary = _other_gaits.get(int(id), {})
		if gait.is_empty() or not is_instance_valid(gait["skeleton"]):
			continue
		gait["sitting"] = true
		var loop := _body_animation_for(gait["body"], BsrReader.AnimationEntry.TYPE_SITTING, gait["group"])
		MonsterMotion.swap_loop(_animated, gait["skeleton"], loop, _frame_count(loop), _idle_anim_time)
		print("SIT: player %d drawn seated on spawn -- loop %s (type 14)" % [int(id),
			_body_animation_path(gait["body"], BsrReader.AnimationEntry.TYPE_SITTING, gait["group"])])

## Another player's answer: the sitting loop under the sit-down clip, or the
## stand loop under the stand-up clip, from their own body's table.
func _apply_other_motion(character_id: int, value: int) -> void:
	if value == WorldNet.MOTION_SIT:
		_other_seated[character_id] = true
	elif value == WorldNet.MOTION_STAND:
		_other_seated.erase(character_id)
	var gait: Dictionary = _other_gaits.get(character_id, {})
	if gait.is_empty() or not is_instance_valid(gait["skeleton"]):
		return
	var was_sitting := bool(gait.get("sitting", false))
	var loop_type := BsrReader.AnimationEntry.TYPE_STAND
	var once_type := -1
	match value:
		WorldNet.MOTION_SIT:
			gait["sitting"] = true
			loop_type = BsrReader.AnimationEntry.TYPE_SITTING
			if not was_sitting:
				once_type = BsrReader.AnimationEntry.TYPE_SIT_DOWN
		WorldNet.MOTION_STAND:
			gait["sitting"] = false
			if was_sitting:
				once_type = BsrReader.AnimationEntry.TYPE_STAND_UP
		_:
			return
	var loop := _body_animation_for(gait["body"], loop_type, gait["group"])
	MonsterMotion.swap_loop(_animated, gait["skeleton"], loop, _frame_count(loop), _idle_anim_time)
	if once_type != -1:
		var once := _body_animation_for(gait["body"], once_type, gait["group"])
		if once != null:
			_play_once(gait["skeleton"], once)
	print("SIT: player %d %s -- loop %s (type %d)%s" % [character_id, "sits" if value == WorldNet.MOTION_SIT else "stands",
		_body_animation_path(gait["body"], loop_type, gait["group"]), loop_type,
		"" if once_type == -1 else ", once %s (type %d)" % [_body_animation_path(gait["body"], once_type, gait["group"]), once_type]])

# --- A monster appearing (round 540) ------------------------------------------

## A monster that has just appeared (srrevamp's own OpMonsterSpawned, 0x007E: a
## respawn or a GM /spawn), pushed to the zone the moment it appears rather than
## found on the next list. Its body is made the way a listed one is
## (_spawn_or_update_monster) and faced along its heading. A server sends it
## only with its -monster-spawn-push flag on (round 542; off by default;
## docs/protocol/monster_ai.md).
func _on_monster_spawned(spawned: CombatNet.MonsterSpawned) -> void:
	if spawned == null or spawned.monster == null:
		return
	var m := spawned.monster
	# This server pushes spawns: no list after a death is needed (round 655).
	_spawn_push_seen = true
	if _dying_until.has(m.monster_id):
		return
	var known := _monster_bodies.has(m.monster_id)
	_spawn_or_update_monster(m)
	_face_monster_heading(m.monster_id, spawned.heading)
	print("World3D: monster %d spawned (push) %s at (%.1f,%.1f) heading %.2f%s" % [
		m.monster_id, m.monster_name, m.x, m.z, spawned.heading, " (already drawn)" if known else ""])

## Faces a standing monster's body along a server heading
## (MonsterMotion.heading_dir) by its model's front. A body walking a leg
## keeps facing its path; the capsule (no model) is left as it is.
func _face_monster_heading(monster_id: int, heading: float) -> void:
	var body = _monster_bodies.get(monster_id)
	if body == null or not is_instance_valid(body) or _monster_is_moving(monster_id):
		return
	var front := MonsterMotion.front_of(String((body as Node3D).get_meta("model", "")))
	if front == "":
		return
	# A spawn is a new object: its mover has no turn (0x9e0cd0 zeroes +0xa4),
	# and FUN_009d17e0 stores the angle with a bare FUN_009c4260.
	(body as Node3D).rotation.y = MonsterMotion.facing_yaw(MonsterMotion.heading_dir(heading), front)
	_remote_turns.erase((body as Node3D).get_instance_id())

func _on_monster_damaged(damaged: CombatNet.MonsterDamaged) -> void:
	# Someone else's hit on a monster: play its reaction now. The local
	# player's own hits are timed to the swing in _on_attack_result, which
	# marks the monster it is about to animate (see _own_hit_until) -- not
	# "whatever I am targeting now", which is a different monster after a
	# retarget.
	if damaged != null and int(_own_hit_until.get(damaged.monster_id, 0)) < Time.get_ticks_msec():
		# MonsterDamaged carries no critical flag: the NORMAL moan.
		var damaged_assembled = _monster_assembled.get(damaged.monster_id)
		if damaged_assembled != null:
			_audio_mark_hit(damaged_assembled.skeleton, false)
		_play_monster_action(damaged.monster_id, BsrReader.AnimationEntry.TYPE_HIT)
	# The health at once (the target window's gauge, when it is the target),
	# so it tracks each hit. The max comes from the last snapshot of this
	# monster. No list follows any more (round
	# 655): the push carries the health, and it is kept in the snapshot.
	if damaged != null:
		_apply_monster_hp(damaged.monster_id, damaged.remaining_hp)

## A monster's health as a result or a push reports it (round 655): kept in
## its snapshot, drawn on its bar and, for the target, in the target window.
## The max comes from the snapshot; a monster with none shows it full.
func _apply_monster_hp(monster_id: int, hp: int) -> void:
	_record_monster_hp(monster_id, hp)
	_paint_monster_hp(monster_id, hp)

## Keeps a reported health in the monster's snapshot, without drawing it.
func _record_monster_hp(monster_id: int, hp: int) -> void:
	var snap = _monster_snapshots.get(monster_id)
	if snap != null:
		snap.hp = hp

## Draws a monster's health in the target window when it is the target:
## `hp`, or the snapshot's when -1. (No bar over its head since round 673.)
func _paint_monster_hp(monster_id: int, hp: int = -1) -> void:
	var snap = _monster_snapshots.get(monster_id)
	if hp < 0:
		if snap == null:
			return
		hp = snap.hp
	var max_hp: int = snap.max_hp if snap != null else hp
	if monster_id == _last_attack_target:
		_set_target_hp(hp, max_hp)

## Runs `what` after `seconds` of scene time -- at once when zero.
func _after(seconds: float, what: Callable) -> void:
	if seconds <= 0.0:
		what.call()
		return
	get_tree().create_timer(seconds).timeout.connect(what)

## Someone else's kill (the zone's OpMonsterDied, which the killer never
## receives): the death plays at once and the body goes when it has run
## (_finish_monster_death; round 655 -- until then a full list was asked for
## here). The killer's own kill comes through _on_attack_result instead.
func _on_monster_died(monster_id: int) -> void:
	_begin_monster_death(monster_id)

## A monster's death plays its own die animation (type 4 of its `default`
## group, docs/protocol/BSR_FORMAT.md) and the body stays on its last frame
## until that has run; only then is the body removed (_finish_monster_death;
## until round 655 a fresh list removed it).
## Reached from a zone's died push (_on_monster_died) and, for the killer, as
## the killing blow lands (_on_attack_result).
func _begin_monster_death(monster_id: int) -> void:
	# The dead monster is nobody's target any more: its target window closes
	# as the clip starts -- for the killer too, since this path was added.
	if monster_id == _last_attack_target:
		_clear_target()
		_last_attack_target = -1
	_target_buff_book.drop(_fx_owner_key(monster_id, SkillNet.OWNER_MONSTER))
	_abnormal_states.erase(_fx_owner_key(monster_id, SkillNet.OWNER_MONSTER))
	# A kill of the monster this player was walking to: no attack to send,
	# and no reason to keep walking.
	if not _pending_attack.is_empty() and int(_pending_attack["monster"]) == monster_id:
		_drop_pending_attack()
	# A dead monster walks no further; its die clip replaces the gait below.
	_monster_motion.erase(monster_id)
	# Nor turns (round 637's review follow-up; OURS).
	var dying_body = _monster_bodies.get(monster_id)
	if dying_body != null and is_instance_valid(dying_body):
		_remote_turns.erase((dying_body as Node3D).get_instance_id())
	# Nor strikes again: a counter still waiting for its blow to land keeps
	# its own wait (the timer holds it), and nothing newer will come.
	_strike_waits.erase(monster_id)
	var seconds := _play_monster_action(monster_id, BsrReader.AnimationEntry.TYPE_DIE, true)
	# The corpse lies for its species' DecayTime from the death, then fades
	# out (round 677, _monster_corpse_seconds); with no DecayTime known, for
	# its die clip, as before.
	var decay := _monster_corpse_seconds(monster_id)
	var hold := decay if decay > 0.0 else seconds
	var has_body: bool = dying_body != null and is_instance_valid(dying_body)
	# The corpse cannot be clicked or targeted (round 677's review, OURS):
	# READ only that retail's pick, FUN_0078ee20, tests no life state (its
	# tests are +0x70 bit 0, the player and its ride, and the option classes);
	# whether its click handler refuses a dead target was not settled. Until
	# round 677 the corpse went with its clip; lying for its DecayTime, a
	# clickable corpse took clicks meant for what stands behind it.
	if has_body:
		_drop_click_body(dying_body as Node3D)
	# The respawn list a server without the spawn push needs is asked for when
	# the clip has run, as before the corpse hold (round 655).
	if seconds > 0.0:
		get_tree().create_timer(seconds).timeout.connect(_maybe_pull_after_death)
	else:
		_maybe_pull_after_death()
	if hold > 0.0 and has_body:
		# The hold restarts from the clip's real start, replacing the killer's
		# predicted one (MonsterBodies.hold_for_kill).
		_dying_until[monster_id] = _idle_anim_time + hold
		get_tree().create_timer(hold).timeout.connect(
			_finish_monster_death.bind(monster_id, (dying_body as Node).get_instance_id()))
	else:
		# Nothing to watch (no die clip and no DecayTime, a capsule, a monster
		# with no body): it goes now. Until round 655 a fresh list removed it.
		_finish_monster_death(monster_id)
	print("World3D: monster %d dies, holding %.2fs (clip %.2fs, corpse %.2fs) t=%.2f" % [
		monster_id, hold if has_body else 0.0, seconds, decay, _idle_anim_time])

## How long a dead monster's corpse lies before it is removed, seconds: its
## species' DecayTime (characterdata column 13, ms; _monster_decay_ms_by_code),
## or 0 when not known (no Media.pk2, no row, no snapshot). READ, the server:
## while a character's life state is 2 (dead), `CGObj::Update` (0x484d10,
## slot 211, reached from CGObjMob::Update -> CGObjChar::Update ->
## CGObjMobile::Update) adds each tick's seconds to +0x3c and, once they
## reach the float at ref+0x84 -- DecayTime, kept in seconds (round 227,
## docs/protocol/refobj_binary_format.md) -- calls slot 218 (0x484cf0:
## SetLifeState(3)); the main loop (CMainProcess::FUN_00413b30) deletes a
## state-3 non-player through FUN_00417090, whose leave-world sends the
## despawn 0x3016 (docs/protocol/appear_fade.md). So in retail the corpse
## lies DecayTime from the death and then fades over 1.5 s. OURS: this
## server drops a monster at its death and sends no despawn, so the client
## times the corpse itself, from when it learns of the death (the zone's
## died push, or the killing blow landing for the killer).
func _monster_corpse_seconds(monster_id: int) -> float:
	var snap = _monster_snapshots.get(monster_id)
	if snap == null:
		return 0.0
	return float(int(_monster_decay_ms_by_code.get(String(snap.code_name), 0))) / 1000.0

## A dead monster's corpse time has run (or it had no hold): its body fades
## out (round 677; READ, the despawn retail's server sends at the corpse's
## DecayTime makes a CIDecoDisappear) and its snapshot goes. The server has
## already dropped it -- a respawn is a new monster with a new id (cmd/server
## maintainMonster) -- so no list is asked for (round 655). `body_id`, from
## the hold's timer: the body that died; a different body under the same id
## by then (a fade-out and a fresh spawn) is not this death's to remove.
func _finish_monster_death(monster_id: int, body_id: int = 0) -> void:
	if not _monster_bodies.has(monster_id) and not _monster_snapshots.has(monster_id):
		return
	var had_body := _monster_bodies.has(monster_id)
	if body_id != 0:
		# The hold's timer: only for the body that died. Gone (faded on a
		# leave, or a zone change took it) or another body under the same id
		# (a fresh spawn, or the next zone's monster): not this death's.
		var now_body = _monster_bodies.get(monster_id)
		if now_body == null or not is_instance_valid(now_body) or (now_body as Node).get_instance_id() != body_id:
			return
	_forget_monster(monster_id, true)
	if had_body:
		print("World3D: monster %d corpse fades out t=%.2f" % [monster_id, _idle_anim_time])

## A server that sends no spawn push (-monster-spawn-push off, the default)
## tells this client of a respawn or a GM spawn only through a list (round
## 655's review). So until the zone's first OpMonsterSpawned has been seen,
## a death that has played out asks for one list, at most once every
## DEATH_PULL_SECONDS (OURS). A server that pushes spawns is never asked.
const DEATH_PULL_SECONDS := 10.0
var _spawn_push_seen := false
var _death_pull_msec := -1000000
## How many lists the throttle has asked for (for the log and the test).
var _death_pulls := 0

func _maybe_pull_after_death() -> void:
	if _spawn_push_seen or not NetClient.is_connected_to_server():
		return
	var now := Time.get_ticks_msec()
	if now - _death_pull_msec < int(DEATH_PULL_SECONDS * 1000.0):
		return
	_death_pull_msec = now
	_death_pulls += 1
	NetClient.list_monsters()

## A unique monster appeared or was killed (round 657; UniqueNoticeNet).
## 0x874ea0 picks the line by the monster's SN_ key and shows it twice: in
## the system window as a type-0 line (0xffdbc99b) and on GDR_WARNING_WND,
## the blue banner at the top centre. Both are logged for the tester's file
## ("UNIQUE NOTICE" / "UNIQUE BANNER"), the banner with the colour it draws.
func _on_unique_notice(n: UniqueNoticeNet.Notice) -> void:
	# The RefObjID -> SN_ key index is built off the main thread at load
	# (_preload_name_key_index). A notice that beats it waits for it on a
	# timer instead of blocking the frame.
	if _name_key_task >= 0 and not WorkerThreadPool.is_task_completed(_name_key_task):
		get_tree().create_timer(0.1).timeout.connect(_on_unique_notice.bind(n))
		return
	var looked := Time.get_ticks_usec()
	var key := _unique_name_key(n.ref_obj_id)
	print("UNIQUE NAME KEY: ref %d -> %s in %.3f ms on the main thread" % [
		n.ref_obj_id, key if key != "" else "(none)", (Time.get_ticks_usec() - looked) / 1000.0])
	var names := _object_names()
	var monster_name := ""
	if names != null and key != "":
		monster_name = names.get_text(key, "")
	var table := _ui_text_table
	var text_of := func(k: String) -> String: return table.get_text(k, "") if table != null else ""
	var line := UniqueNoticeNet.line_for(n, key, monster_name, text_of)
	print("UNIQUE NOTICE: kind 0x%04x ref %d key %s text %s killer '%s' line '%s'" % [
		n.kind, n.ref_obj_id, key if key != "" else "?", UniqueNoticeNet.keys_for(n, key), n.killer, line])
	if line == "":
		# No archive text to show (no Media.pk2): nothing retail would draw.
		return
	_log_system(line, UniqueNoticeNet.SYSTEM_TYPE)
	if _hud_warning != null:
		_show_banner("unique", line)
		# Where it is on the screen (the harness measures the pixels there).
		var xf := _hud_warning.get_global_transform_with_canvas()
		var r := Rect2(xf.origin, _hud_warning.size * xf.get_scale())
		print("UNIQUE BANNER: %s text '%s' fill #%s alpha %d frame %s at %d,%d size %dx%d system colour 0x%08x" % [
			_hud_warning.style_name(), line, _hud_warning.fill_color().to_html(false),
			HudNotice.fill_alpha_for(_hud_warning.alpha()), String(HudNotice.STYLE_WARNING["corner"]),
			int(r.position.x), int(r.position.y), int(r.size.x), int(r.size.y), HudSystemMessage.COLOR_DEFAULT])

## The SN_ name key of characterdata row `ref_id`, or "", from the index
## _preload_name_key_index builds. Scanning the parts per notice instead cost
## 62 ms for a known id and 113 ms for an unknown one on the main thread
## (round 657 review, tools/probe_name_key_cost.gd on the render box); a
## lookup in the index is under 0.01 ms.
func _unique_name_key(ref_id: int) -> String:
	return String(_name_key_index().get(ref_id, ""))

## Starts building {RefObjID -> SN_ key} from the characterdata parts on a
## WorkerThreadPool task (the skill-effect table's pattern; Pk2Reader locks
## its reads). 118 ms of parsing on the render box, none of it on the main
## thread.
func _preload_name_key_index() -> void:
	if _name_key_task >= 0 or _name_key_loaded or _media_pk2 == null:
		return
	var pk2 := _media_pk2
	var result := _name_key_result
	_name_key_task = WorkerThreadPool.add_task(func() -> void:
		var t := Time.get_ticks_msec()
		var index := {}
		for path in NpcTableReader.MODEL_TABLE_PATHS:
			var entry := ObjectLoader.find_file(pk2, path)
			if entry != null:
				NpcTableReader.parse_name_keys(pk2.read_file(entry), index)
		result["index"] = index
		result["ms"] = Time.get_ticks_msec() - t)

## The index, collected from the task once it has finished (the caller waits
## for completion first, _on_unique_notice); empty without an archive.
func _name_key_index() -> Dictionary:
	if _name_key_loaded:
		return _name_key_cache
	if _name_key_task < 0:
		_preload_name_key_index()
	if _name_key_task >= 0:
		WorkerThreadPool.wait_for_task_completion(_name_key_task)
		_name_key_task = -1
		_name_key_cache = _name_key_result.get("index", {})
		print("World3D: characterdata -> %d SN_ name keys (built in %d ms off the main thread)" % [
			_name_key_cache.size(), int(_name_key_result.get("ms", 0))])
		_name_key_result.clear()
	_name_key_loaded = true
	return _name_key_cache

var _name_key_task := -1
var _name_key_result: Dictionary = {}
var _name_key_cache: Dictionary = {}
var _name_key_loaded := false

## The player has advanced a level (server's OpLevelUp, only ever sent to
## the character that levelled). Announces it with the client's own recovered
## message and plays the real level-up burst on the player.
##
## stat_points is the character's total unspent points now (3 per level, see
## docs/LEVELING.md); the character window reads it when opened, so this
## handler does not need to push it anywhere -- it is here so the signal's
## full payload is on record at the call site.
func _on_level_up(new_level: int, _stat_points: int) -> void:
	var msg := level_up_line(new_level, _ui_text_table.get_text("UIIT_MSG_STRGERR_LEVEL", "") if _ui_text_table != null else "")
	# Round 639: retail's Client_ApplyExpAndLevelUp formats this with swprintf
	# (0x8a9bd3, 0x80 wide chars) and hands it to GDR_WARNING_WND, interface
	# child 0x23 (0x8a9c26 -> 0x77b580 -> CIFNotify 0x7b3eb0) -- not to the
	# system window. Logged for the tester's file all the same.
	print("SYSLOG warning: %s" % msg)
	if _hud_warning != null:
		_show_banner("level_up", msg)
	else:
		_log_system(msg)
	# 0x3054's handler 0x8a7020: snd_levup, 2-D (read; UiSounds.level_up).
	UiSounds.level_up("level up to %d" % new_level)
	_play_level_up_effect()
	# Refresh the HUD to the new level: the HP bar's higher maximum, the level
	# label, the reset EXP gauge and any new SP all come from the stats packet.
	_request_world_stats()

## Asks for fresh stats while the player block's stat panel is open, the
## way the client's own panel rewrites its rows every frame (vslot_012).
## Coalesced (round 629's review): any number of causes in one frame make one
## request, sent from a deferred call at the frame's end.
func _refresh_stat_panel(why: String) -> void:
	if _hud_player_info == null or not _hud_player_info.is_stat_panel_open():
		return
	_stat_panel_refresh_causes.append(why)
	if _stat_panel_refresh_causes.size() == 1:
		call_deferred("_flush_stat_panel_refresh")

var _stat_panel_refresh_causes: Array = []
## How many stats requests the panel has sent -- the QA log's measure of a storm.
var _stat_panel_refresh_sent := 0

func _flush_stat_panel_refresh() -> void:
	if _stat_panel_refresh_causes.is_empty():
		return
	_stat_panel_refresh_sent += 1
	print("World3D: player stat panel refresh #%d (%s)" % [_stat_panel_refresh_sent, ", ".join(PackedStringArray(_stat_panel_refresh_causes))])
	_stat_panel_refresh_causes.clear()
	_request_world_stats()

## What was worn at the last equipment list, as "slot:item" pairs, and
## whether a list has come yet (the world entry asks for one).
var _stat_panel_worn_sig := ""
var _stat_panel_worn_known := false

## An equipment list refreshes the panel only when what is worn CHANGED:
## every list is not a change (opening the bag asks for one). Every successful
## reply is a real list, an empty one included -- the server answers an equip
## and an unequip with the worn list itself (sendWornList), and a refusal
## carries an error and no list -- so an empty list is "nothing worn": taking
## off the last item, or putting one on a character wearing nothing, is a
## change (round 629-632 integration; round 629's review skipped empty lists
## as acknowledgements, which missed both).
func _stat_panel_on_equipment(items: Array, error: String) -> void:
	if error != "":
		return
	var pairs: Array = []
	for e in items:
		pairs.append("%d:%d" % [e.slot, e.item_id])
	pairs.sort()
	var sig := ",".join(PackedStringArray(pairs))
	var changed := _stat_panel_worn_known and sig != _stat_panel_worn_sig
	_stat_panel_worn_sig = sig
	_stat_panel_worn_known = true
	if changed:
		_refresh_stat_panel("equipment changed")

## The race emblem on the player block: the body's characterdata row's
## Country (column 14), 0 China / 1 Europe -- the byte CIFPlayerMiniInfo
## picks the emblem by (hud_player_info.gd, set_race).
func _apply_player_race() -> void:
	if _hud_player_info == null:
		return
	var code: String = _player_body if _player_body != "" else String(GENDER_BODY_CODE[DEFAULT_GENDER])
	if not _country_by_code.has(code):
		print("World3D: no characterdata Country for %s -- no race emblem" % code)
		return
	_hud_player_info.set_race(int(_country_by_code[code]))
	print("World3D: race emblem %s (%s Country %d)" % [_hud_player_info.race_mark_path(), code, int(_country_by_code[code])])

## Requests the character's full stats (level, exp, SP, HP max) so the HUD
## gauges stay live. Cheap; called on enter-world, each kill, and level-up.
func _request_world_stats() -> void:
	var who := NetClient.current_character_name
	if who != "" and NetClient.is_connected_to_server():
		NetClient.character_stats(who)

## Applies the stats packet to the always-on HUD: the level label, the HP bar
## (with its level-scaled maximum), the underbar EXP gauge and the SP readout.
func _on_world_stats(stats: StatsNet.Stats) -> void:
	if stats == null or stats.error != "":
		return
	if OS.get_environment("SRREVAMP_QA_STATS_LOG") != "":
		print("QA STATS: t=%.2f tick=%d HP %d/%d MP %d/%d sitting=%s pelvis %s" % [_player_anim_time, _qa_tick,
			stats.hp, stats.max_hp, stats.mp, stats.max_mp, str(_sit.sitting), _qa_pelvis_height()])
	# While dead the HP a stats reply carries is not taken (round 607's third
	# review): a regen push built before a lethal blow can arrive after the
	# blow's HP 0 and drew a live bar on a dead character. A dead character's
	# HP is 0 until the revive (_leave_dead_state, on OpReviveResult, which
	# the post-revive stats follow). The rest of the reply still applies.
	var take_hp := stats.max_hp > 0 and not _player_dead
	if take_hp:
		_last_enter_world_hp = stats.hp
		_last_enter_world_max_hp = stats.max_hp
	if _hud_target != null:
		_hud_target.set_player_level(stats.level)
	_player_level = stats.level
	if _hud_player_info != null:
		_hud_player_info.set_character(NetClient.current_character_name, stats.level)
		if take_hp:
			_hud_player_info.set_hp(stats.hp, stats.max_hp)
		# The mana bar drew blank while the server had no mana to report.
		# It does now -- the game's own base curve -- so show the real
		# number; a server too old to send it still gets the blank bar.
		if stats.max_mp > 0:
			_hud_player_info.set_mp(stats.mp, stats.max_mp)
		# The stat panel, the orbs and the "+" -- the same packet the
		# character window reads, applied on every arrival (round 629).
		# SRREVAMP_QA_PMI drives the orbs itself; the server's count would
		# undo each state it sets.
		if _qa_pmi_spec != "":
			stats.has_hwan_count = false
		_hud_player_info.set_stats(stats)
		if _hud_player_info.is_stat_panel_open():
			print("World3D: player stat panel: str %s int %s phy %s def %s mag %s def %s bal %s / %s hit %s parry %s (level %d)" % [
				_hud_player_info.stat_value("GDR_PMI_TXT_STRDAT"), _hud_player_info.stat_value("GDR_PMI_TXT_INTDAT"),
				_hud_player_info.stat_value("GDR_PMI_TXT_PHYATTDAT"), _hud_player_info.stat_value("GDR_PMI_TXT_PHYDEFDAT"),
				_hud_player_info.stat_value("GDR_PMI_TXT_MAGATTDAT"), _hud_player_info.stat_value("GDR_PMI_TXT_MAGDEFDAT"),
				_hud_player_info.stat_value("GDR_PMI_TXT_PHYBALDAT"), _hud_player_info.stat_value("GDR_PMI_TXT_MAGBALDAT"),
				_hud_player_info.stat_value("GDR_PMI_TXT_HITDAT"), _hud_player_info.stat_value("GDR_PMI_TXT_PARRYDAT"), stats.level])
	if _hud_underbar != null:
		_hud_underbar.set_level(stats.level)
		_hud_underbar.set_exp(stats.exp_percent())
		# A plain total: SP is not out of anything, and passing a maximum drew
		# the authored SP bar permanently full (playtest 2026-09-20, items 10
		# and 19). The bar's real fill is progress toward the next skill
		# point, which the server does not send yet.
		_hud_underbar.set_sp(stats.skill_points)

## The EXP-loss line (UIIT_MSG_STATE_LOSE_EXP, "[%I64d]Experience Points
## lost."), or "" when nothing was lost.
static func exp_loss_line(exp_lost: int, template: String) -> String:
	if exp_lost <= 0:
		return ""
	return _printf_one(template if template != "" else "[%I64d]Experience Points lost.",
		["%I64d", "%lld", "%d"], exp_lost)

## The level-up line: UIIT_MSG_STRGERR_LEVEL ("You have advanced to level
## [%d].") through swprintf, as 0x8a9bd3 formats it -- so the brackets stay
## ("level [5]."). Until round 639 this replaced "[%d]" whole and dropped them.
static func level_up_line(new_level: int, template: String) -> String:
	if template == "" or not template.contains("%d"):
		return "You have advanced to level [%d]." % new_level
	return template.replace("%d", str(new_level))

## The lines a kill's experience writes to the system window, as
## Client_ApplyExpAndLevelUp (0x8a97c0) writes them: UIIT_MSG_STATE_GAIN_EXP
## ("[%I64d]Experience Points gained.") when the experience is above 0
## (0x8a9a45..0x8a9a76) and UIIT_MSG_STATE_GET_SKILL_EXP ("[%u]skill
## experience point gained.") when the skill experience is (0x8a9cc3..
## 0x8a9cfa), both with type 1 (the GAIN filter). An empty template (no
## archive) falls back to that English.
static func exp_gain_lines(exp_gained: int, skill_exp_gained: int, exp_template: String,
		skill_template: String) -> PackedStringArray:
	var out := PackedStringArray()
	if exp_gained > 0:
		out.append(_printf_one(exp_template if exp_template != "" else "[%I64d]Experience Points gained.",
			["%I64d", "%lld", "%d"], exp_gained))
	if skill_exp_gained > 0:
		out.append(_printf_one(skill_template if skill_template != "" else "[%u]skill experience point gained.",
			["%u", "%d"], skill_exp_gained))
	return out

static func _printf_one(template: String, specs: Array, value: int) -> String:
	for spec in specs:
		if template.contains(String(spec)):
			return template.replace(String(spec), str(value))
	return template

## Spawns the real level-up burst on the player, sized to the player's own
## rendered height. Does nothing (beyond the message already logged) when the
## player has no Particles.pk2 -- no fabricated stand-in.
func _play_level_up_effect() -> void:
	if player == null or not is_instance_valid(player):
		return
	var particles := _open_particles_pk2_if_set()
	if particles == null:
		return
	# Round 620: the file's own particles, drawn by EfpEffect, when it decodes
	# and draws; the designed LevelUpEffect stays as the fallback.
	if USE_EFP_LEVELUP:
		var efp := EfpEffect.create(LEVELUP_EFP, particles)
		if efp != null and efp.draw_count() > 0:
			efp.reserved = true
			SkillEffects.attach(efp, player, "none", Vector3.ZERO)
			print("World3D: level-up plays %s (%d nodes drawn)" % [LEVELUP_EFP, efp.draw_count()])
			return
		if efp != null:
			efp.free()
	var fx := LevelUpEffect.create(particles, _player_world_height())
	if fx == null:
		return
	player.add_child(fx)

## Plays a specific skill's own hit effect on a body: looks up the skill's hit
## `.efp` in skilleffect.txt (by Basic_Code) and plays it, falling back to the
## generic critical-hit burst if the skill has no mapped effect.
func _play_skill_hit_effect_on(body: Node3D, world_height: float, basic_code: String) -> void:
	if body == null or not is_instance_valid(body):
		return
	var particles := _open_particles_pk2_if_set()
	if particles == null:
		return
	_play_hit_efp_on(body, world_height, SkillEffectReader.hit_efp_for(_skill_effects(), basic_code))

## A hit effect `efp` on `body` (round 640: split out of
## _play_skill_hit_effect_on, so a wall's DefenseEfp plays the same way); ""
## plays HitEffect's fallback.
func _play_hit_efp_on(body: Node3D, world_height: float, efp: String) -> void:
	if body == null or not is_instance_valid(body):
		return
	var particles := _open_particles_pk2_if_set()
	if particles == null:
		return
	# Round 620: the skill's own hit .efp through EfpEffect when it decodes
	# and draws something, at the same mid-height HitEffect uses (OURS: the
	# characterInfo DamageBone/DamagePos is not read yet); HitEffect is the
	# fallback.
	if USE_EFP_HITS and efp != "":
		var decoded := EfpEffect.create(efp, particles)
		if decoded != null and decoded.draw_count() > 0:
			var skel := SkillEffects.skeleton_of(body)
			var sy: float = skel.global_transform.basis.get_scale().y if skel != null else 1.0
			decoded.reserved = true
			SkillEffects.attach(decoded, body, "none", Vector3(0, world_height * 0.5 / maxf(sy, 0.0001), 0))
			return
		if decoded != null:
			decoded.free()
	var fx: HitEffect = null
	if efp != "":
		fx = HitEffect.create_from_efp(particles, efp, world_height)
	if fx == null:
		fx = HitEffect.create(particles, world_height)
	if fx == null:
		return
	fx.position = Vector3(0, world_height * 0.5, 0)
	body.add_child(fx)

## skilleffect.txt, read at world entry and parsed ONCE on a WorkerThreadPool
## task into both of its readings (SkillEffectReader.parse_all): the hit
## `.efp` map and the skillaniset rows (the 616-618 integration review -- the
## 4.5 MB table was parsed twice, ~120 ms each, on the first cast). A cast
## that comes before the task is done waits for it (it started at entry); a
## world that never preloaded parses it there, once.
func _preload_skill_effect_table() -> void:
	if _skill_table_task >= 0 or _skill_table_loaded or _media_pk2 == null:
		return
	var bytes := AssetSource.read_bytes(SkillEffectReader.TABLE, _media_pk2)
	if bytes.is_empty():
		_skill_table_loaded = true
		return
	var result := _skill_table_result
	_skill_table_task = WorkerThreadPool.add_task(func() -> void:
		var t := Time.get_ticks_msec()
		result["tables"] = SkillEffectReader.parse_all(bytes)
		result["ms"] = Time.get_ticks_msec() - t)

## Both readings, collected from the task (or parsed here when none ran).
func _skill_effect_tables() -> Dictionary:
	if _skill_table_loaded:
		return _skill_table_cache
	if _skill_table_task < 0:
		_preload_skill_effect_table()
	if _skill_table_task >= 0:
		var waited := Time.get_ticks_msec()
		WorkerThreadPool.wait_for_task_completion(_skill_table_task)
		_skill_table_task = -1
		_skill_table_cache = _skill_table_result.get("tables", {"hit": {}, "aniset": {}})
		print("World3D: skilleffect.txt -> %d skill hit effects, %d skillaniset rows (parsed in %d ms off the main thread; waited %d ms)" % [
			(_skill_table_cache["hit"] as Dictionary).size(), (_skill_table_cache["aniset"] as Dictionary).size(),
			int(_skill_table_result.get("ms", 0)), Time.get_ticks_msec() - waited])
		_skill_table_result.clear()
	_skill_table_loaded = true
	if _skill_table_cache.is_empty():
		_skill_table_cache = {"hit": {}, "aniset": {}}
	return _skill_table_cache

var _skill_table_task := -1
var _skill_table_result: Dictionary = {}
var _skill_table_cache: Dictionary = {}
var _skill_table_loaded := false

## Basic_Code -> hit `.efp` (skilleffect.txt). Empty when the archive has no table.
func _skill_effects() -> Dictionary:
	if _skill_hit_efp_loaded:
		return _skill_hit_efp
	_skill_hit_efp_loaded = true
	_skill_hit_efp = _skill_effect_tables()["hit"]
	return _skill_hit_efp

## The player's rendered height in world units -- measured from the assembled
## skeleton when one is up, else the file's standing yardstick (a character is
## about 2 * PLAYER_SCALE_RATIO tall, the same one the floating-text heights
## use).
func _player_world_height() -> float:
	if _player_skeleton != null and is_instance_valid(_player_skeleton):
		var h := _skeleton_top(_player_skeleton)  # _skeleton_bounds already applies the skeleton's scale (Height, round 689)
		if h > 0.1:
			return h
	return 2.0 * PLAYER_SCALE_RATIO

## Plays one of a monster's own animations by action type, once. Returns
## its length in seconds, 0 if the monster has no such animation.
func _play_monster_action(monster_id: int, action_type: int, hold: bool = false) -> float:
	var assembled: SkinnedBsrAssembler.AssembledCharacter = _monster_assembled.get(monster_id)
	if assembled == null or _data_pk2 == null:
		return 0.0
	var anim := SkinnedBsrAssembler.animation_for(_data_pk2, assembled, action_type)
	if anim == null:
		return 0.0
	return _play_once(assembled.skeleton, anim, hold)

## How long _play_monster_action(monster_id, action_type) would run, without
## playing it: the same lookup, and 0 wherever _play_once would play nothing
## (no assembled body, no clip, or a clip of one frame or fewer). The
## killer's death hold (MonsterBodies.hold_for_kill) is sized by it.
func _monster_action_seconds(monster_id: int, action_type: int) -> float:
	var assembled: SkinnedBsrAssembler.AssembledCharacter = _monster_assembled.get(monster_id)
	if assembled == null or assembled.skeleton == null or _data_pk2 == null:
		return 0.0
	var anim := SkinnedBsrAssembler.animation_for(_data_pk2, assembled, action_type)
	if anim == null or _frame_count(anim) <= 1:
		return 0.0
	return anim.duration_seconds()

## The client's own "item gained" chat line, from the UI text table: this
## archive's English is `item [%s %d pieces]gained.` for an expendable
## (UIIT_MSG_STATE_GET_ITEM_EXPENDABLE) and `item [%s]gained.` for one that
## is not (UIIT_MSG_STATE_GET_ITEM_NONEXPENDABLE) -- typos and spacing are the
## file's, not ours. A quantity above one is what marks a stack here (the
## client keys on the item's expendable class; the wording is the same). Only
## when the table lacks the key does our own wording stand in.
func _acquired_item_line(label: String, quantity: int) -> String:
	var key := "UIIT_MSG_STATE_GET_ITEM_EXPENDABLE" if quantity > 1 else "UIIT_MSG_STATE_GET_ITEM_NONEXPENDABLE"
	var template := _ui_text_table.get_text(key, "") if _ui_text_table != null else ""
	if template != "" and label != "":
		if quantity > 1:
			return template % [label, quantity]
		return template % [label]
	if label == "":
		return "Picked up %dx." % quantity
	return ("Picked up %dx %s." % [quantity, label]) if quantity > 1 else ("Picked up %s." % label)

func _on_loot_dropped(dropped: CombatNet.LootDropped) -> void:
	if dropped == null:
		return
	for d in dropped.drops:
		_log_system(_acquired_item_line(_item_label_for_line(d.item_id), d.quantity), HudSystemMessage.TYPE_GAIN)
	NetClient.list_inventory(NetClient.current_character_name)

