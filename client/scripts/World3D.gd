	for slot in _quickslot_actions:
		if int(_quickslot_actions[slot]) == id:
			_hud_underbar.set_slot_item(int(slot), _hud_panels.action_pane.icon_of(id))

## Another player's Walk/Run: their legs move at their walk speed and their
## dressed body walks (a ghost keeps its run clip, OPEN).
func _apply_other_walk_mode(character_id: int, walking: bool) -> void:
	if walking:
		var walk := WALK_SPEED_FALLBACK
		var gait: Dictionary = _other_gaits.get(character_id, {})
		var row: Array = _speeds_by_code.get(String(gait.get("body", "")), [])
		if row.size() == 2 and float(row[0]) > 0.0:
			walk = float(row[0])
		_other_walking[character_id] = walk
	else:
		_other_walking.erase(character_id)
	var leg = _other_legs.get(character_id)
	if leg != null:
		leg["speed"] = _other_speed(character_id)
	print("WALK: player %d %s" % [character_id, "walks" if walking else "runs"])

## An emote someone played (0x3091, FUN_008a7950 READ): their body plays
## action type 0x32 + the byte (ANI_EMOTION01..) once, from its own .bsr.
func _on_emote_received(object_id: int, emote: int) -> void:
	_sync_own_id()
	var own := _own_id()
	var action_type := ActionCommands.emote_animation(emote)
	if own >= 0 and object_id == own:
		var anim := _body_animation_for(_player_body, action_type, _player_weapon_group)
		# Round 808: state 13 fades in and out over 200 (0xa59bc0, READ).
		var played := _play_player_once(anim, ClipMixer.SHOT_IN_MS, ClipMixer.SHOT_OUT_MS) if anim != null else 0.0
		print("EMOTE: this player plays emote %d -- action type %d, %s (%.2f s)" % [emote, action_type,
			_body_animation_path(_player_body, action_type, _player_weapon_group), played])
		# Round 850: the weapon goes for the emote (HeldItems, READ 0xa59bc0).
		_held_emote(own, emote, anim if played > 0.0 else null, played)
		return
	if not _other_bodies.has(object_id):
		print("EMOTE: emote %d for unknown id %d ignored" % [emote, object_id])
		return
	_dress_ghost_now(object_id)
	var gait: Dictionary = _other_gaits.get(object_id, {})
	if gait.is_empty() or not is_instance_valid(gait["skeleton"]):
		return
	var once := _body_animation_for(gait["body"], action_type, gait["group"])
	var t := _play_once(gait["skeleton"], once) if once != null else 0.0
	print("EMOTE: player %d plays emote %d -- action type %d (%.2f s)" % [object_id, emote, action_type, t])
	# Round 850: another player's emote is state 13 too (FUN_008a7950).
	_held_emote(object_id, emote, once if t > 0.0 else null, t)

## An action's icon was put down on the quick slot bar (CIFUnderBar::vslot_028
## takes kind 0x4a, READ): the slot holds the action from now on.
func _on_action_drop_requested(at: Vector2, action_id: int, icon: Texture2D) -> void:
	if _hud_underbar == null or action_id <= 0:
		return
	var slot := _hud_underbar.slot_index_at(at)
	if slot < 0:
		return
	_quickslot_skills.erase(slot)
	_quickslot_items.erase(slot)
	_quickslot_actions[slot] = action_id
	_hud_underbar.set_slot_item(slot, icon)
	print("World3D: quickslot %d <- action %d" % [slot, action_id])
	_save_hotbar()

## The icon an action shows on the bar: the window's, or the row's own when
## the window is not built yet.
func _action_icon(action_id: int) -> Texture2D:
	if _hud_panels != null and _hud_panels.action_pane != null:
		var t := _hud_panels.action_pane.icon_of(action_id)
		if t != null:
			return t
	if _ui_builder == null:
		return null
	var e := ActionWndData.find(ActionWndData.load_from(_ui_builder.media_archive()), action_id)
	return _ui_builder.load_texture(e.icon) if e != null else null

## OPENSRO_QA_ACTIONS="<tick>:<id>,<id>,..." runs those action buttons one a
## second from that tick, as the window's right click would, and prints each
## (QA only). E.g. "200:1005,4000,1001,1000".
var _qa_actions := OS.get_environment("OPENSRO_QA_ACTIONS")
var _qa_actions_next := -1

func _qa_step_actions(tick: int) -> void:
	if _qa_actions == "" or not _qa_actions.contains(":"):
		return
	var parts := _qa_actions.split(":")
	var start := int(parts[0])
	var ids := parts[1].split(",", false)
	if tick < start:
		return
	var k := (tick - start) / 60
	if (tick - start) % 60 != 0 or k >= ids.size() or k == _qa_actions_next:
		return
	_qa_actions_next = k
	if k == 0 and _hud_panels != null and not _hud_panels.is_open("action"):
		_hud_panels.toggle("action")
	var step := String(ids[k])
	# "q<slot>=<id>": the action put on quick slot <slot>, as a drop there
	# does; "u<slot>": that quick slot used, as its key or click does.
	if step.begins_with("q") and step.contains("="):
		var slot := int(step.substr(1, step.find("=") - 1))
		var aid := int(step.substr(step.find("=") + 1))
		if _hud_underbar != null:
			_quickslot_skills.erase(slot)
			_quickslot_items.erase(slot)
			_quickslot_actions[slot] = aid
			_hud_underbar.set_slot_item(slot, _action_icon(aid))
			_save_hotbar()
		print("QA ACTION quick slot %d <- action %d at tick %d" % [slot, aid, tick])
		return
	if step.begins_with("u"):
		print("QA ACTION quick slot %d used at tick %d" % [int(step.substr(1)), tick])
		_on_quickslot_activated(int(step.substr(1)))
		return
	var id := int(step)
	print("QA ACTION %d at tick %d: %s" % [id, tick, _run_action(id)])

# --- The keyboard (round 608) ---------------------------------------------------
#
# KeyMap is the retail client's key table and KeyInput runs it; this is what
# each action does in this world. The windows' keys are HudPanels'.

## Runs the key table against this world (_setup_keys).
var _key_input: KeyInput = null
## The last player who whispered this one, for R's reply (KeyMap slot 20).
var _last_whisperer := ""
## Whether V's hide is on the bodies now (_apply_key_holds).
var _objects_hidden := false
## The ground item under the mouse, or -1. Its name shows: CIItem::vslot_010
## (0x9e15b0) draws the name when the item's +0xf0 is set (read); that +0xf0
## is "hovered or selected" is inferred.
var _hovered_ground_item := -1
## When G's pick went out (-1: never), for the pending gate in
## _key_pick_up_nearest.
var _pickup_inflight_since_ms := -1
## 0x77c9b0 reports an action pending until the flag +0x4f8 is 20000 ms old
## (0x77c9ce, read); G gives up while one is.
const PICKUP_PENDING_MS := 20000
## G takes the nearest CIItem strictly closer than this, in 3-D (0x9e18f0,
## .rdata 0xd851a0 = 50.0, read).
const PICKUP_SEARCH_RADIUS := 50.0
## Z shows the names of dropped items strictly closer than this (0x9e15b0,
## `+0x24c < 300.0`, .rdata 0xd85224, read).
const ITEM_NAME_RADIUS := 300.0

func _setup_keys() -> void:
	if _key_input != null:
		return
	_key_input = KeyInput.new({
		"is_typing": Callable(self, "_is_typing"),
		"run": Callable(self, "_run_key_action"),
		"held": Callable(self, "_on_key_held"),
		"panel": Callable(self, "_run_panel_key"),
		# Round 808: the arrow keys, presses (repeats too) and releases.
		"arrow": Callable(self, "_on_arrow_key"),
		"arrow_release_all": Callable(self, "_arrow_release_all"),
	})
	_key_input.name = "KeyInput"
	add_child(_key_input)

## A window's key (KeyMap's "panel:" slots, and M for the world map), read
## by KeyInput before the GUI so no focused control on the way can take it
## (v0.1.453 playtest: Tab, read there, worked; the window keys, left to
## HudPanels' _unhandled_key_input, did not). The same toggles HudPanels' own
## key handler uses. Returns a line for the log.
func _run_panel_key(action: String) -> String:
	if _hud_panels == null:
		return "no HUD"
	if action == "worldmap":
		_hud_panels.world_map_toggle_requested.emit()
		return "world map toggled"
	var panel_id := action.substr(6)
	_hud_panels.toggle(panel_id)
	return "%s %s" % [panel_id, "open" if _hud_panels.is_open(panel_id) else "closed"]

## One key action (KeyMap), and a line for the log saying what it did.
## The windows' keys come through _run_panel_key instead.
func _run_key_action(action: String, arg: int) -> String:
	match action:
		"berserk":
			if NetClient.current_character_name == "" or not NetClient.is_connected_to_server():
				return "not connected"
			# The client's own gate (0x00778ac0, READ): with fewer than five
			# orbs held it asks for nothing and says nothing. The count is the
			# HUD's, from the stats packet and every AttackResult; before any
			# has arrived it is unknown and the server decides.
			if _hud_player_info != null and _hud_player_info.hwan_known() and not _hud_player_info.hwan_ready():
				return "not requested: %d of 5 orbs held" % _hud_player_info.hwan_charges()
			# The server judges the five-orb gauge (the berserk_result
			# handler says "not full yet"); the retail client tests +0x886 >= 5
			# itself first (0x778ac0, read).
			NetClient.berserk(NetClient.current_character_name)
			return "berserk requested"
		"help":
			if _help_window == null:
				return "no help window"
			# 0x79f690 (READ): shown -> closed, else opened. Round 858: asked of
			# the window itself (root and frame), not the root's flag, which the
			# frame's X used to leave out of step.
			_help_window.toggle()
			return "help opened" if _help_window.is_open() else "help closed"
		"mouse_slot":
			if _hud_underbar == null:
				return "no hotbar"
			_hud_underbar.activate_mouse_slot()
			return "quick slot 0 (m)"
		"sit":
			return _request_sit_toggle()
		"pickup":
			return _key_pick_up_nearest()
		"whisper_reply":
			return _key_whisper_reply()
		"page":
			if _hud_underbar == null:
				return "no hotbar"
			_hud_underbar.set_page(arg)
			return "page F%d" % _hud_underbar.current_page()
		"quickslot_key":
			if _hud_underbar == null:
				return "no hotbar"
			_hud_underbar.activate_key(arg - 1)
			return "quick slot %d" % _hud_underbar.slot_for_key(arg - 1)
		"quickslot":
			if _hud_underbar == null:
				return "no hotbar"
			_hud_underbar.activate_slot(arg)
			return "quick slot %d" % arg
		"ext_quickslot":
			# OURS (round 788): Alt+digit, the first extra bar's page.
			if _hud_ext_slots == null:
				return "no extra bar"
			var fired := _hud_ext_slots.activate_key(arg)
			return ("quick slot %d (extra bar 1)" % fired) if fired >= 0 else "no extra bar"
		"camera_cycle":
			return _key_cycle_camera()
		"hide_ui":
			_toggle_ui_visibility()
			return "UI %s" % ("shown" if ui_control.visible else "hidden")
		"stall_network":
			# Round 841 (OURS key, default F): item 120's open, or the close
			# when the window is up (StallNetworkController.toggle).
			if _hud_panels == null:
				return "no HUD"
			return "stall network: %s" % _hud_panels._stall_network().toggle(_stall_network_in_town(), false)
		"item_mall":
			# Round 837 (0x7807aa): the "Enter Item Mall" box when the mall
			# is not open and no such box is up; F10 never closes it.
			if _hud_panels == null or _hud_panels.item_mall_open():
				return "item mall already open"
			_hud_panels.open_item_mall_entry()
			return "item mall entry box"
		"screenshot":
			return _save_screenshot()
		"debug_panel":
			if _debug_panel == null:
				return "no debug panel"
			_debug_panel.toggle()
			return "debug panel %s" % ("shown" if _debug_panel.visible else "hidden")
		"select_self":
			# 0x77f230 -> 0x78f5f0(player+0xf8) (read): the player selected,
			# as a press on the player block does (round 715).
			_select_self()
			return "selected this player"
		"select_party":
			# 0x77f230 -> 0x6da850(n - 2), the quick party window's slot n-2 (arg is n - 1),
			# then its member found by name (0x9c3640) and selected (read;
			# round 715). Not spawned: nothing to select.
			return _select_quick_party_member(int(arg) - 1)
		"pet_info", "pet_ride", "pet_unsummon", "pet_follow", "pet_attack", "pet_ai", "pet_switch":
			# Round 795: 0x7a0980(n) on the current COS (HudCos.run_command),
			# W the next one in summon order.
			if _hud_cos == null or not _hud_cos.has_any():
				return "no COS out"
			if action == "pet_switch":
				_hud_cos.switch_next()
				return "switched to COS %d" % _hud_cos.current_uid()
			var cmd := 0
			match action:
				"pet_ride": cmd = HudCosCommand.CMD_RIDE
				"pet_attack": cmd = HudCosCommand.CMD_ATTACK
				"pet_follow": cmd = HudCosCommand.CMD_FOLLOW
				"pet_unsummon": cmd = HudCos.pgup_command(CosNet.client_kind(_hud_cos.cos_kind(_hud_cos.current_uid())))
				"pet_ai": cmd = HudCosCommand.CMD_AI
			_hud_cos.run_command(cmd)
			return "COS command %d on %d" % [cmd, _hud_cos.current_uid()]
	return "no-op: %s is not built" % action

## A held key went down or up (V, Z): applied at once, and every frame after
## (_apply_key_holds).
func _on_key_held(action: String, _down: bool) -> void:
	_apply_key_holds()
	# The cursor and the hovered item's name follow V at once, not on the
	# next mouse motion: a monster under the mouse stops (or starts) being
	# an attack target with the press.
	if action == "hide_objects":
		_cursor_last_check_ms = 0
		_settle_hover_cursor()

## V and Z, while held. V hides what KeyMap.hides_under_v names (round 771,
## READ: while DAT_00eef5f4 is set, the predicate 0x9d0560 fails other
## players, monsters, CICMonsterNPC, CICRide and every COS but the ridden
## one, and the character's draw 0x9d20d0 then draws neither its body
## (0x9c4aa0), its attachments (+0x288) nor its name (0x9d0a80); its
## vslot 0x50, 0x9d11c0, returns 0, so it cannot be picked). Here that is
## every way such a body is drawn:
##   - the near bodies (Node3D holders), with what hangs under them -- the
##     name plates (the plate batch re-anchors through _other_moved), the
##     blob shadows, the attached effects, the dressed weapon effects;
##   - the far crowd (CrowdGpu.set_hidden: the far bodies, the ghosts and
##     the departures fading on the GPU), which never read the holders'
##     visibility -- most of a crowd, which V did not hide before;
##   - the ghosts' weapon effects (EquipFx.ghosts_hidden);
##   - a departing player or monster still fading out (_departing_bodies).
## NPCs, the player and the dropped items stay. The ring on a hidden target
## goes and does not come back (CIODecal::vslot_009 clears it, READ, round
## 698); the target window stays (its test, vslot 0x54, has no V check;
## READ); the minimap keeps the dots (its sign loop asks vslot 0x54 too;
## READ, 0x662bd0). The client draws no pet, COS, ride or stall yet.
## Z shows the dropped items' names within ITEM_NAME_RADIUS; otherwise a
## name shows only while the mouse is on the item (GroundItems.update_labels).
func _apply_key_holds() -> void:
	var hiding := _key_input != null and _key_input.is_held("hide_objects")
	var players_hidden := hiding and KeyMap.hides_under_v("other_player")
	if hiding or hiding != _objects_hidden:
		var players := _show_bodies(_other_bodies, not players_hidden, true)
		var monsters := _show_bodies(_monster_bodies, not (hiding and KeyMap.hides_under_v("monster")))
		var departing := _show_departing(hiding)
		if hiding != _objects_hidden:
			print("KEYS: V %s -- %d other player(s), %d monster(s), %d departing, the far crowd (%d) and its weapon effects %s; NPCs and dropped items kept" % [
				"held" if hiding else "released", players, monsters, departing,
				int(_crowd_gpu.stats.get("far", 0)) if _crowd_gpu != null else 0, "hidden" if hiding else "shown"])
	elif not _departing_bodies.is_empty() and Engine.get_physics_frames() % 60 == 0:
		_purge_departing()
	# Every frame (a CrowdGpu made again keeps no state of ours; both return
	# at once when nothing changed).
	if _crowd_gpu != null:
		_crowd_gpu.set_hidden(players_hidden)
	EquipFx.ghosts_hidden = players_hidden
	var changed := hiding != _objects_hidden
	_objects_hidden = hiding
	if changed and _qa_input_armed:
		_qa_probe_hidden_pick()
		_qa_probe_hidden_render(hiding)
	if _ground_items != null and player != null:
		var near := _key_input != null and _key_input.is_held("item_names")
		var shown := _ground_items.update_labels(player.global_position,
			ITEM_NAME_RADIUS if near else -1.0, _hovered_ground_item)
		if near != _item_names_near:
			_item_names_near = near
			print("KEYS: Z %s -- %d of %d dropped item name(s) shown" % [
				"held" if near else "released", shown, _ground_items.count()])

## Round 771: departing players' and monsters' bodies (fading out, freed when
## the fade ends), by instance id.
var _departing_bodies := {}

## Shows or hides the departing bodies, dropping the freed ones; returns how
## many are left. Only what V hid is shown again (meta V_HIDDEN): a departure
## that hides its own holder keeps it hidden.
const V_HIDDEN := "v_hidden"
func _show_departing(hiding: bool) -> int:
	var gone: Array = []
	for k in _departing_bodies:
		var b = _departing_bodies[k]
		if not is_instance_valid(b) or (b as Node).is_queued_for_deletion():
			gone.append(k)
			continue
		var node := b as Node3D
		var hide := hiding and KeyMap.hides_under_v("monster" if node.has_meta("monster_id") else "other_player")
		if hide and node.visible:
			node.visible = false
			node.set_meta(V_HIDDEN, true)
		elif not hide and node.has_meta(V_HIDDEN):
			node.remove_meta(V_HIDDEN)
			node.visible = true
	for k in gone:
		_departing_bodies.erase(k)
	return _departing_bodies.size()

var _item_names_near := false

## Drops the freed departing bodies (no visibility change).
func _purge_departing() -> void:
	for k in _departing_bodies.keys():
		var b = _departing_bodies[k]
		if not is_instance_valid(b) or (b as Node).is_queued_for_deletion():
			_departing_bodies.erase(k)

## QA (OPENSRO_QA_INPUT): at each V change, what the hover ray makes of the
## nearest monster's click capsule, and how many monster bodies are drawn --
## the measurement that a hidden monster is neither drawn nor picked.
func _qa_probe_hidden_pick() -> void:
	var best: Node3D = null
	var best_d := INF
	for id in _monster_bodies:
		var body := _monster_bodies[id] as Node3D
		if body == null or not is_instance_valid(body):
			continue
		var d := body.global_position.distance_to(player.global_position)
		if d < best_d:
			best_d = d
			best = body
	var drawn := 0
	for id in _monster_bodies:
		var b := _monster_bodies[id] as Node3D
		if b != null and is_instance_valid(b) and b.is_visible_in_tree():
			drawn += 1
	if best == null or camera_3d == null:
		print("QA KEYS: V %s -- no monster to probe (%d drawn)" % ["held" if _objects_hidden else "released", drawn])
		return
	var shape := best.get_node_or_null("ClickBody/CollisionShape3D") as Node3D
	var at := shape.global_position if shape != null else best.global_position
	var kind := "behind the camera"
	var screen := Vector2(-1, -1)
	if not camera_3d.is_position_behind(at):
		screen = camera_3d.unproject_position(at)
		kind = _hover_kind_at(screen)
	print("QA KEYS: V %s -- %d of %d monster bodies drawn; the nearest (#%s, %.1f away) at screen %s hovers as '%s'" % [
		"held" if _objects_hidden else "released", drawn, _monster_bodies.size(),
		str(best.get_meta("monster_id", "?")), best_d, screen, kind])

## QA (OPENSRO_QA_INPUT), round 771: five frames after a V change, what the
## renderer drew (its own counts for the last frame) and the far crowd's
## groups masked off -- the measurement that V hides the GPU-drawn crowd, not
## only the holders.
func _qa_probe_hidden_render(hiding: bool) -> void:
	for i in range(5):
		await get_tree().process_frame
	var masked := 0
	var groups := 0
	if _crowd_gpu != null:
		for g in _crowd_gpu._groups.values():
			groups += 1
			if not g.inst.is_valid() or _crowd_gpu._mask(g, g.shown_o) == 0:
				masked += 1
	print("QA KEYS: V %s, 5 frames on -- drawn: %d objects, %d primitives, %d draw calls; far crowd %d bodies, %d of %d groups masked off; ghost weapon effects %s" % [
		"held" if hiding else "released",
		RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_OBJECTS_IN_FRAME),
		RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_PRIMITIVES_IN_FRAME),
		RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_DRAW_CALLS_IN_FRAME),
		int(_crowd_gpu.stats.get("far", 0)) if _crowd_gpu != null else 0, masked, groups,
		"hidden" if EquipFx.ghosts_hidden else "shown"])

## Shows or hides every body in an id -> Node3D map; returns how many there are.
func _show_bodies(bodies: Dictionary, shown: bool, others: bool = false) -> int:
	var n := 0
	for id in bodies:
		var body := bodies[id] as Node3D
		if body != null and is_instance_valid(body):
			n += 1
			if body.visible != shown:
				body.visible = shown
				# Round 757's review, F4: other players' batched plates (and
				# signs) hide and show with their bodies in the same frame.
				if others:
					_other_moved(body)
	return n

## G: the nearest ground item strictly within PICKUP_SEARCH_RADIUS of the
## player, in 3-D, as 0x9e18f0 searches (read); then this client's pick path
## (_pick_up_ground_item): a walk into the server's 10-unit reach and its
## pick request. Retail sends 0x7074 [01 02 01 <uid>] and leaves the approach
## to its server (inferred: the G path has no movement code); this server
## does not walk players. Retail's own refusals before sending (the item
## already taken, +0x258 == -1; client state 10; a UI lock; an owner that is
## neither the player nor a party member, 0x1812) are not all made here: the
## server makes the owner one and answers with the same 0x1812 line.
func _key_pick_up_nearest() -> String:
	if _player_dead:
		return "dead: nothing picked"
	if _ground_items == null or not NetClient.is_connected_to_server():
		return "no ground items"
	if _pickup_inflight and _pickup_inflight_since_ms >= 0 \
			and Time.get_ticks_msec() - _pickup_inflight_since_ms < PICKUP_PENDING_MS:
		return "a pick is still pending"
	var ground_id := _ground_items.nearest_within(player.global_position, PICKUP_SEARCH_RADIUS)
	# Round 826 (READ, 0x793d1f): after the search, G does nothing while the
	# player is in state 10 (`[player+0x65c] >> 10 & 1`) -- one item a clip.
	if _player_pickup_clip != null:
		return "the pick-up clip plays: nothing picked"
	if ground_id < 0:
		return "no item within %.0f" % PICKUP_SEARCH_RADIUS
	var dist := _ground_items.position_of(ground_id).distance_to(player.global_position)
	_pick_up_ground_item(ground_id)
	return "ground item %d at %.1f: %s" % [ground_id, dist,
		"walking to it" if _has_move_target else "picking it up"]

## R: the chat line opened with a whisper to the last player who whispered
## (KeyMap.reply_line has what was read). The line takes the keyboard so the
## player can type (ours: whether 0x7ab470 moves the focus was not read).
func _key_whisper_reply() -> String:
	var line := KeyMap.reply_line(_last_whisperer, NetClient.current_character_name)
	if line == "":
		return "no whisper to reply to"
	if _hud_chat == null or not _hud_chat.open_with(line):
		return "no chat line"
	return "chat line opened with '%s'" % line

## F9: the next camera view (KeyMap.next_camera_view), announced with the
## client's own line for it (0x780420 shows it through 0x7781b0(0, text),
## the system message window's add -- READ in round 639).
func _key_cycle_camera() -> String:
	var current := maxi(CAMERA_VIEWS.find(_camera_view), 0)
	var next := KeyMap.next_camera_view(current)
	set_camera_view(CAMERA_VIEWS[next])
	# Kept, as the debug panel's selector keeps it, and shown there.
	ClientSettings.set_value(ClientSettings.SECTION_UI, ClientSettings.KEY_CAMERA_VIEW, _camera_view)
	if _debug_panel != null:
		_debug_panel.sync_view()
	var line := _ui_text_table.get_text(KeyMap.camera_view_string(next), "") if _ui_text_table != null else ""
	if line != "":
		_log_system(line)
	return "camera view %s, announced '%s'" % [_camera_view, line]

## PrintScreen: the frame as a JPEG in user://screenshots/ -- beside
## user://logs/, under the file name and quality 0xba7240 uses (KeyMap).
## Retail writes `ScreenShot\` in its install folder; this client writes into
## its user folder, where the logs are (ours). The chat line is ours.
func _save_screenshot() -> String:
	var tex := get_viewport().get_texture()
	var img: Image = tex.get_image() if tex != null else null
	if img == null or img.is_empty():
		return "no frame to save"
	var dir := "user://screenshots"
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(dir))
	var path := "%s/%s" % [dir, KeyMap.screenshot_name(Time.get_datetime_dict_from_system(), randi())]
	var err := img.save_jpg(path, KeyMap.SCREENSHOT_JPEG_QUALITY / 100.0)
	if err != OK:
		return "screenshot not saved (error %d)" % err
	var full := ProjectSettings.globalize_path(path)
	_log_system("Screenshot saved: %s" % full)
	return "saved %s" % full

## QA: how high the body's Bip01 Pelvis is above the player's feet, in world
## units -- a sitting pose measured rather than looked at. "-" without a body.
func _qa_pelvis_height() -> String:
	if _player_skeleton == null or not is_instance_valid(_player_skeleton):
		return "-"
	var bone := _player_skeleton.find_bone("Bip01 Pelvis")
	if bone < 0:
		return "-"
	var at := _player_skeleton.global_transform * _player_skeleton.get_bone_global_pose(bone)
	return "%.2f" % (at.origin.y - player.global_position.y)

## A buff began (OpBuffStart, round 617). Only its run speed is applied here
## -- the icon is round 618's buff bar and the aura round 619's -- and only
## for this player (SelfCast.claims_start). runSpeed is the owner's new run
## speed in the units _move_speed moves by (characterdata Speed2, the same
## number the server moves the character by); 0 means unchanged.
func _on_buff_started(start: SkillNet.BuffStart) -> void:
	_sync_own_id()
	var mine := _self_cast.claims_start(start.owner_id, start.owner_kind, start.skill_id, start.token, _other_bodies, Time.get_ticks_msec())
	print("BUFF start handled: owner %d is %s" % [start.owner_id, "this player" if mine else "someone else"])
	if mine:
		_apply_buff_run_speed(start.run_speed, "OpBuffStart skill %d token %d" % [start.skill_id, start.token])
		_refresh_stat_panel("own buff started")
	elif start.owner_kind == SkillNet.OWNER_CHARACTER:
		_note_other_speed(start.owner_id, start.run_speed)
	_target_buff_book.start(_fx_owner_key(start.owner_id, start.owner_kind), start.token, start.skill_id)
	_fx_on_buff_started(start)

## Buffs ended (OpBuffEnd, round 617): this player's run speed, as for a start.
func _on_buff_ended(ended: SkillNet.BuffEnd) -> void:
	_sync_own_id()
	var mine := _self_cast.claims_end(ended.owner_id, ended.owner_kind, ended.tokens)
	print("BUFF end handled: owner %d is %s" % [ended.owner_id, "this player" if mine else "someone else"])
	if mine:
		_apply_buff_run_speed(ended.run_speed, "OpBuffEnd tokens %s" % str(ended.tokens))
		_refresh_stat_panel("own buff ended")
	elif ended.owner_kind == SkillNet.OWNER_CHARACTER:
		_note_other_speed(ended.owner_id, ended.run_speed)
	_target_buff_book.end(_fx_owner_key(ended.owner_id, ended.owner_kind), ended.tokens)
	_fx_on_buff_ended(ended)

## OpSelfId arrived (round 617's review): this player's own id, for the buff
## and move handlers and the sit state alike.
func _on_self_id_received(_character_id: int) -> void:
	_sync_own_id()
	# Round 838: a plate built before the id came was drawn in the default
	# colours; the own 0x013B may already be in.
	_own_plate_colours_told()
	# This player selected before its id came (round 638 review): the target
	# window's owner "character:-1" becomes the real id's key.
	if _hud_target != null and _hud_target.buff_owner() == _fx_owner_key(-1, SkillNet.OWNER_CHARACTER) and _own_id() >= 0:
		_hud_target.set_buff_owner(_fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER))
		_selected_character = _own_id()

## Brings the two holders of this player's own id into line with the best
## source: OpSelfId (NetClient.own_character_id) when the server sent it --
## the sit state's learned id is checked against it and replaced -- else the
## id the sit answer taught, which SelfCast then takes as told instead of
## guessing from its own casts.
func _sync_own_id() -> void:
	var told := int(NetClient.own_character_id)
	if told >= 0:
		if _sit.own_id >= 0 and _sit.own_id != told:
			print("SELF id: the sit state had learned %d, OpSelfId says %d -- using %d" % [_sit.own_id, told, told])
		_sit.own_id = told
		if _self_cast.own_id != told or not _self_cast.own_id_told:
			if _self_cast.own_id >= 0 and _self_cast.own_id != told:
				print("SELF id: buffs had taught %d, OpSelfId says %d -- using %d" % [_self_cast.own_id, told, told])
			_self_cast.tell_own_id(told)
	elif _sit.own_id >= 0 and not _self_cast.own_id_told:
		_self_cast.tell_own_id(_sit.own_id)

## Sets the player's run speed from a buff packet; 0 leaves it.
func _apply_buff_run_speed(run_speed: int, why: String) -> void:
	if run_speed <= 0:
		print("SPEED: run speed stays %.0f (%s: runSpeed 0 = unchanged)" % [_move_speed, why])
		return
	# Round 796: riding, the speed is the mount's and no buff changes it
	# (READ GObjPC::FUN_004aa410 s:0x4aa410: the rider's walk/run are copied
	# from the COS, no multiplier); the buffed foot speed is kept for the
	# dismount (whose 0x30D0 carries it too).
	_sync_own_id()
	if _riders.has(_own_id()):
		print("SPEED: riding -- the mount's %.0f stays; foot speed now %d (%s)" % [_move_speed, run_speed, why])
		_foot_move_speed = float(run_speed)
		return
	print("SPEED: run speed %.0f -> %d (%s)" % [_move_speed, run_speed, why])
	_move_speed = float(run_speed)
	_server_run_speed = run_speed

## A skill moved a character (OpSkillMove, round 617: Ghost Walk's landing).
## Round 785, READ: retail does not snap. The 0xB070 move (flags & 8)
## starts IDecoSkill::FUN_00a51320(region, point, 500.0 @0xdcc19c,
## 20.0 @0xd88108): the caster turns to face the point (FUN_009c4260) and
## FUN_00a50f70 slides it there each frame at 500 units a second, on the
## ground, measuring only the horizontal distance (FUN_009ed850), leaving an
## afterimage of the body every 20 units (FUN_00a55ac0); its arrival ends the
## cast (FUN_00a50a00: the WAIT clip and its effect stop). The body plays
## the skill's WAIT clip the whole way (ANI_SKILL_7 in DEFAULT for Ghost
## Walk) with its WAIT effect (lightning_bobeop_move_a.efp).
func _on_skill_moved(moved: SkillNet.SkillMove) -> void:
	_sync_own_id()
	var to := Vector3(moved.x, moved.y, moved.z)
	if _other_bodies.has(moved.character_id):
		var body: Node3D = _other_bodies[moved.character_id]
		# Round 785's client review, finding 1: the walk's target is the
		# slide's end, and the eased walk (_step_other_bodies) leaves the body
		# to the slide until it arrives -- until then the walk pulled it back
		# toward its start every frame against the slide (MEASURED: a 100-unit
		# slide settled 25.00 short for 570 frames and never arrived).
		_other_body_targets[moved.character_id] = to
		_other_settled.erase(moved.character_id)
		# The server's Relocate ended any leg it walked (round 749).
		_other_legs.erase(moved.character_id)
		# Standing under the cast's WAIT clip, not running (the walk's gait).
		_set_other_gait(moved.character_id, false)
		_other_awake.erase(moved.character_id)
		var from := body.global_position
		_face_toward(body, to)
		if _deco_on(body).is_empty():
			_start_deco(body, moved.skill_id, null, "player %d's move" % moved.character_id, {"due_ms": -1})
		_start_skill_slide(body, to, _skill_move_speed(moved.skill_id), SKILL_MOVE_IMAGE_STEP, "skill %d" % moved.skill_id,
			_other_skill_move_arrived.bind(moved.character_id, body, to))
		print("SKILL move handled: player %d slides from (%.1f, %.1f, %.1f) to (%.1f, %.1f, %.1f), %.1f units, by skill %d" % [
			moved.character_id, from.x, from.y, from.z, to.x, to.y, to.z, from.distance_to(to), moved.skill_id])
		return
	# Round 640, OURS: the server dropped a move its wall's root refused and
	# answered with the position it holds -- this player stays there.
	if moved.character_id == _own_id() and moved.skill_id != 0 and moved.skill_id == _wall_root():
		_drop_pending_attack()
		_has_move_target = false
		player.velocity = Vector3.ZERO
		var held: Dictionary = _settle_skill_move_footing(to)
		player.position = held["to"]
		_note_position_sent() # round 749: the server holds it here, with no leg
		print("ROOT: the server holds this player at (%.1f, %.1f, %.1f) -- its wall (skill %d) roots it" % [
			player.position.x, player.position.y, player.position.z, moved.skill_id])
		return
	if not _self_cast.claims_move(moved.character_id, moved.skill_id, _other_bodies, Time.get_ticks_msec()):
		print("SKILL move handled: character %d is neither drawn here nor this player's cast -- ignored" % moved.character_id)
		return
	# The ground cast's answer: drawn now if the reply has not drawn it, and
	# it acts (ACT_S; the WAIT hold stays until the move ends it).
	_fx_self_cast_begin("OpSkillMove")
	_fx_self_cast_acts(moved.skill_id, "OpSkillMove", true)
	_fx_self_cast = {}
	# The skill's move ends the movement order (_player_move_order; INFERRED
	# from the skill paths' FUN_009e0150).
	_player_move_order = false
	var from := player.position
	_drop_pending_attack()
	_has_move_target = false
	player.velocity = Vector3.ZERO
	_face_toward(player, to)
	# The server already has the player there, with no leg (round 749: its
	# Relocate ended one); do not send it back.
	_note_position_sent()
	_start_skill_slide(player, to, _skill_move_speed(moved.skill_id), SKILL_MOVE_IMAGE_STEP, "skill %d" % moved.skill_id,
		_own_skill_move_arrived.bind(to, moved.skill_id))
	print("SKILL move handled: this player %s from (%.1f, %.1f, %.1f) to (%.1f, %.1f, %.1f), %.1f units, by skill %d" % [
		"slides at %.0f u/s" % _skill_move_speed(moved.skill_id) if _skill_move_speed(moved.skill_id) > 0.0 else "is put (tel2)",
		from.x, from.y, from.z, to.x, to.y, to.z, from.distance_to(to), moved.skill_id])

## READ: the move's speed and the afterimage spacing (0xdcc19c, 0xd88108).
const SKILL_MOVE_SPEED := 500.0
const SKILL_MOVE_IMAGE_STEP := 20.0

## How a skill's move goes: SKILL_MOVE_SPEED for a 'tele' row (the 0xB070
## move flag 8, the slide), 0 -- put there at once -- for a 'tel2' row (READ:
## FUN_00a54be0's flag 2 sets the point and puts the caster there,
## GlobalDataManager::FUN_009e0d50; the server lane: tel2 sets 2). A row the
## catalog does not know slides (OURS).
func _skill_move_speed(skill_id: int) -> float:
	if _hud_buff_board == null or _hud_buff_board.catalog == null:
		return SKILL_MOVE_SPEED
	var row: Dictionary = _hud_buff_board.catalog.info(skill_id)
	if (row.get("tele", []) as Array).is_empty() and not (row.get("tel2", []) as Array).is_empty():
		return 0.0
	return SKILL_MOVE_SPEED

## This player's Ghost Walk reached its point: it stands there, on the
## landing's footing, and the cast ends.
func _own_skill_move_arrived(to: Vector3, skill_id: int) -> void:
	var settled := _settle_skill_move_footing(to)
	player.position = settled["to"]
	player.velocity = Vector3.ZERO
	_note_position_sent()
	_end_deco(player, "the move arrived", true)
	print("SKILL move: this player arrived at (%.1f, %.1f, %.1f) by skill %d, footing %s" % [
		player.position.x, player.position.y, player.position.z, skill_id, settled["footing"]])

## Another player's skill move reached its point: the walk takes the body
## again there (it settles on its target, _step_other_bodies).
func _other_skill_move_arrived(character_id: int, body: Node3D, to: Vector3) -> void:
	if _other_bodies.get(character_id) == body:
		_other_body_targets[character_id] = to
		_other_awake[character_id] = true
	_end_deco(body, "the move arrived", true)

## Turns a body to face a point (FUN_009c4260 with the move's heading).
func _face_toward(body: Node3D, to: Vector3) -> void:
	var d := Vector2(to.x - body.global_position.x, to.z - body.global_position.z)
	if not d.is_zero_approx():
		body.rotation.y = atan2(d.x, d.y)
		if body != player:
			_other_moved(body)

# --- Skill slides (round 785): Ghost Walk's move and a knockback ---------------

## body instance id -> {body, from, to, speed, image_step, images (the
## afterimages left so far), t (seconds slid), limit (seconds), why,
## on_arrive}.
var _skill_slides: Dictionary = {}

## OURS (round 785's client review, finding 1): a slide ends at its point by
## this many seconds past the time its distance takes at its speed, wherever
## the body is -- so nothing can hold a slide open (and its cast's WAIT loop
## and afterimages) for ever.
const SKILL_SLIDE_GRACE_S := 1.0

## Slides `body` to `to` at `speed` units a second (horizontally, the
## height following the ground), leaving an afterimage every `image_step`
## units (0: none); `on_arrive` runs when it gets there.
func _start_skill_slide(body: Node3D, to: Vector3, speed: float, image_step: float, why: String,
		on_arrive: Callable = Callable()) -> void:
	if body == null or not is_instance_valid(body):
		return
	var key := body.get_instance_id()
	if _skill_slides.has(key):
		_finish_skill_slide(_skill_slides[key], false)
	if body != player:
		for id in _monster_bodies:
			if _monster_bodies[id] == body:
				_stop_monster_motion(int(id))
				break
	var from := body.global_position
	var flat_len := Vector2(to.x - from.x, to.z - from.z).length()
	var s := {"body": body, "from": from, "to": to, "speed": maxf(speed, 1.0),
		"image_step": image_step, "images": 0, "t": 0.0,
		"limit": flat_len / maxf(speed, 1.0) + SKILL_SLIDE_GRACE_S, "why": why, "on_arrive": on_arrive}
	_skill_slides[key] = s
	# A turn still running from a swing would fight the slide's heading
	# (round 785's client review, finding 11).
	_combat_faces.erase(key)
	if speed <= 0.0:
		# A put: there at once.
		_finish_skill_slide(s, true)

## Whether this player is being slid by a skill (its own walk waits).
func _own_slide_active() -> bool:
	return player != null and _skill_slides.has(player.get_instance_id())

func _tick_skill_slides(delta: float) -> void:
	if _skill_slides.is_empty():
		return
	for key in _skill_slides.keys():
		var s: Dictionary = _skill_slides.get(key, {})
		if s.is_empty():
			continue
		var body = s["body"]
		if body == null or not is_instance_valid(body):
			_skill_slides.erase(key)
			continue
		var b: Node3D = body
		var to: Vector3 = s["to"]
		var here := b.global_position
		var flat := Vector2(to.x - here.x, to.z - here.z)
		var step := float(s["speed"]) * delta
		s["t"] = float(s["t"]) + delta
		if flat.length() <= step:
			_finish_skill_slide(s, true)
			continue
		if float(s["t"]) > float(s["limit"]):
			print("SKILL slide (%s): not there %.2f s after it began, %.1f units short -- ended at its point" % [
				s["why"], float(s["t"]), flat.length()])
			_finish_skill_slide(s, true)
			continue
		var move := flat.normalized() * step
		var next := Vector3(here.x + move.x, here.y, here.z + move.y)
		var y = _ground_y_at(next)
		next.y = float(y) if y != null else lerpf(here.y, to.y, step / maxf(flat.length(), 0.001))
		b.global_position = next
		if b == player:
			player.velocity = Vector3.ZERO
			_has_move_target = false
		else:
			_other_moved(b)
		if float(s["image_step"]) > 0.0:
			# Every image_step units of the way actually covered from the start
			# (READ, FUN_00a50f70: every 20 units), not of the steps taken: a
			# body held back leaves none.
			var from: Vector3 = s["from"]
			var covered := Vector2(next.x - from.x, next.z - from.z).length()
			var due := int(floorf(covered / float(s["image_step"])))
			while int(s["images"]) < due:
				s["images"] = int(s["images"]) + 1
				_skill_afterimage(b)

func _finish_skill_slide(s: Dictionary, arrived: bool) -> void:
	var body = s["body"]
	if body != null and is_instance_valid(body):
		_skill_slides.erase((body as Node3D).get_instance_id())
		if arrived:
			(body as Node3D).global_position = s["to"]
			if body != player:
				_other_moved(body)
	var cb: Callable = s["on_arrive"]
	if arrived and cb.is_valid():
		cb.call()

## The ground's height under a world point (the walk's graph), or null.
func _ground_y_at(at: Vector3) -> Variant:
	var pair := _nav_graph_for(at)
	if pair.is_empty():
		return null
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	var local := group.to_local(at)
	var surface := graph.surface_at(local.x, local.z, local.y)
	return group.to_global(Vector3(local.x, surface.height, local.z)).y

## An afterimage of `body` where it stands (READ: FUN_00a50f70 makes one every
## 20 units of a skill move, FUN_00a55ac0 posing a new object as the body
## stands). How long it stays and how it fades were not read (OPEN): here a
## still copy of the posed skeleton and its meshes, half transparent, fading
## out over AFTERIMAGE_SECONDS (OURS).
const AFTERIMAGE_SECONDS := 0.5
const AFTERIMAGE_START_ALPHA := 0.5
func _skill_afterimage(body: Node3D) -> void:
	var skel := SkillEffects.skeleton_of(body)
	if skel == null or not skel.is_inside_tree():
		return
	var copy := skel.duplicate(0) as Skeleton3D
	if copy == null:
		return
	for i in skel.get_bone_count():
		copy.set_bone_pose_position(i, skel.get_bone_pose_position(i))
		copy.set_bone_pose_rotation(i, skel.get_bone_pose_rotation(i))
		copy.set_bone_pose_scale(i, skel.get_bone_pose_scale(i))
	var parent := body.get_parent()
	if parent == null:
		copy.free()
		return
	parent.add_child(copy)
	copy.global_transform = skel.global_transform
	var geoms: Array = copy.find_children("*", "GeometryInstance3D", true, false)
	for g in geoms:
		(g as GeometryInstance3D).transparency = 1.0 - AFTERIMAGE_START_ALPHA
		(g as GeometryInstance3D).cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	var tween := create_tween()
	tween.set_parallel(true)
	for g in geoms:
		tween.tween_property(g, "transparency", 1.0, AFTERIMAGE_SECONDS)
	tween.chain().tween_callback(copy.queue_free)

## Puts the walk's footing (_nav_footing) at a skill-move landing at once, so
## the player stands on the graph there rather than at the packet's height
## until the next step (round 616-618 integration). The landing this client
## resolved and sent (_ground_landing) gives the footing and height when the
## server moved the player to that very point; any other point -- the server
## clamped it again, or no landing was resolved -- is settled from the graph
## under it (surface_at, reference the packet's height). Returns {"to": the
## point on the ground, "footing": the footing's name for the log}.
func _settle_skill_move_footing(to: Vector3) -> Dictionary:
	var landing := _ground_landing
	_ground_landing = null
	var pair := _nav_graph_for(to)
	if pair.is_empty():
		return {"to": to, "footing": "unsettled (no navmesh under the landing)"}
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	if landing != null and not landing.unchecked and landing.graph == graph \
			and Vector2(landing.sent.x, landing.sent.z).distance_to(Vector2(to.x, to.z)) < 0.01:
		_nav_footing = landing.footing
		to.y = landing.position.y
	else:
		var local := group.to_local(to)
		var surface := graph.surface_at(local.x, local.z, local.y)
		_nav_footing = surface.object_index
		to.y = group.to_global(Vector3(local.x, surface.height, local.z)).y
	_nav_footing_graph = graph
	_nav_footing_pos = to
	return {"to": to, "footing": _nav_footing_name(graph, _nav_footing)}

## OP_STATE_CHANGE: kind 1 is the motion state. This player's own id is
## OpSelfId's when the server sent one (round 617's review, _sync_own_id);
## otherwise the first answer to its own N teaches it; any other id is another
## player's body.
func _on_state_changed(change: WorldNet.StateChange) -> void:
	_sync_own_id()
	if change != null and change.kind == WorldNet.STATE_KIND_BODY_MODE:
		_on_body_mode(change)
		return
	if change != null and change.kind == WorldNet.STATE_KIND_TELEPORT:
		_on_teleport_state(change)
		return
	if change == null or change.kind != WorldNet.STATE_KIND_MOTION:
		return
	match _sit.classify(change.object_id, _other_bodies.has(change.object_id), _player_anim_time):
		"other":
			_apply_other_motion(change.object_id, change.value)
		"self":
			_apply_player_motion(change.value)
		_:
			print("SIT: state change for unknown id %d (value %d) ignored" % [change.object_id, change.value])

## 0x30BF kind 4, the body mode (round 629's review). READ, 0x8a80a0: for this
## player and value 1 the client runs FUN_00778ae0(0, 1) -- the orbs' berserk
## display starts, the count now 0; value 0 ends the body mode and leaves the
## display to its own timer. Every body's berserk look -- this player's and
## every other player's -- follows its body mode (round 651, _berserk_apply).
func _on_body_mode(change: WorldNet.StateChange) -> void:
	var own := _own_id()
	var mine := own >= 0 and change.object_id == own
	print("World3D: body mode %d for %d (%s)" % [change.value, change.object_id, "this player" if mine else "someone else"])
	_berserk_apply(change.object_id, change.value, false)
	# Round 786: the protection's body mode 2 has no look of its own (READ,
	# SetBodyMode 0x9cf880), but this player's screen flashes for any
	# non-zero mode (0x8a826f; berserk's 1 flashes in _berserk_apply).
	if change.value != 1 and ArrivalGuard.flashes(mine, change.value):
		_berserk_flash_t = 0.0
		print("World3D: untouchable (body mode %d) -- screen flash" % change.value)
	if mine and change.value == 1 and _hud_player_info != null:
		var was_running := _hud_player_info.hwan_display_active()
		_hud_player_info.set_hwan(0, true)
		if not was_running:
			print("World3D: berserk display started: drain step %.3f s (bonus %d s), %.3f s in all" % [
				_hud_player_info.drain_period(), _hud_player_info.hwan_time_bonus(),
				_hud_player_info.drain_period() * HudPlayerInfo.BERSERK_ORBS])

## Round 651: `object_id`'s berserk look follows its body mode -- on for 1,
## off for anything else (BerserkLook). The body is this player's when the id
## is its own, else the other player's drawn body; a body not drawn yet takes
## it when it is built (_berserk_resync, from NetClient.body_modes). Retail
## runs the setter on any object in view (0x8a80a0 -> FUN_009cf880, READ).
## `instant`: the body was already berserk when it came into view -- no start
## burst, no sound, no flash (the spawn's arg 1, READ). This player's own
## start also flashes the screen (0x8a827b, READ) and turns its swings to the
## hwan sounds, as another player's does theirs.
func _berserk_apply(object_id: int, value: int, instant: bool) -> void:
	var own := _own_id()
	var mine := own >= 0 and object_id == own
	var body: Node3D = player if mine else _other_bodies.get(object_id)
	if body == null or not is_instance_valid(body):
		return
	# Not drawn while it waits to be dressed (round 739's review, F7):
	# _dress_other puts the look on from NetClient's body modes. Round 756:
	# a ghost is drawn: dressed now.
	if not mine:
		_dress_ghost_now(object_id)
	if not mine and _other_build_args.has(object_id):
		return
	# BerserkLook tints the body's meshes: a far body comes back first
	# (round 747, CrowdGpu).
	if not mine:
		_crowd_wake_node(body)
	if value == 1:
		BerserkLook.start(body, instant, mine)
		if mine and not instant:
			_berserk_flash_t = 0.0
	else:
		# The server ends a running berserk with a zone change (endBerserk)
		# and tells the mover so on arrival. The original client meets that
		# arrival with a rebuilt object (a teleport is a re-entry, INFERRED),
		# so no end burst or hwanreturn.wav plays on it (round 651's review):
		# the mover's own look goes silently (BerserkLook.end).
		BerserkLook.end(body, mine and _arrival_pending)
	if mine:
		_audio_set_hwan(value == 1)
	elif _other_gaits.has(object_id):
		var skel = _other_gaits[object_id].get("skeleton")
		if skel != null and is_instance_valid(skel):
			var snd_owner = _anim_sounds.owner_of(skel)
			if snd_owner != null:
				snd_owner.hwan = value == 1

## Round 651: the body mode NetClient holds for `character_id` (the server's
## word since the last entry or zone change) goes on its freshly built body.
func _berserk_resync(character_id: int, why: String) -> void:
	var modes = NetClient.get("body_modes")
	if modes == null or int((modes as Dictionary).get(character_id, 0)) != 1:
		return
	print("BERSERK resync %d (%s): berserk" % [character_id, why])
	_berserk_apply(character_id, 1, true)

## _berserk_resync for every character NetClient holds a body mode for.
func _berserk_resync_all(why: String) -> void:
	var modes = NetClient.get("body_modes")
	if modes == null:
		return
	for id in (modes as Dictionary).keys():
		_berserk_resync(int(id), why)

## The own activation's screen flash (BerserkLook.flash_alpha, READ): a
## screen-sized quad adding white x alpha (SRCBLEND SRCALPHA, DESTBLEND
## SRCCOLOR, READ), drawn over the world and under the HUD (the weather
## manager draws it in the world pass, INFERRED from where vslot_010 runs).
## QA (round 651): OPENSRO_QA_BERSERK_PROBE=1 prints, once a second, where
## every drawn player's chest is on this client's screen and the colour
## BerserkLook draws their body with -- the point a live run samples the
## frame at, so the glow is measured as pixels rather than judged by eye.
var _qa_berserk_probe_on := OS.get_environment("OPENSRO_QA_BERSERK_PROBE") != ""
var _qa_berserk_probe_frame := 0

func _qa_berserk_probe() -> void:
	if not _qa_berserk_probe_on or camera_3d == null:
		return
	_qa_berserk_probe_frame += 1
	if _qa_berserk_probe_frame % 60 != 0:
		return
	var bodies := {"self": player}
	for id in _other_bodies:
		bodies[str(id)] = _other_bodies[id]
	for who in bodies:
		var body: Node3D = bodies[who]
		if body == null or not is_instance_valid(body) or not body.is_inside_tree():
			continue
		var skel := SkillEffects.skeleton_of(body)
		var top := _skeleton_top(skel) if skel != null else 1.8 * PLAYER_SCALE_RATIO
		var chest := body.global_position + Vector3.UP * top * 0.6
		var on := not camera_3d.is_position_behind(chest)
		var at := camera_3d.unproject_position(chest)
		var vp := get_viewport().get_visible_rect().size
		on = on and at.x >= 0 and at.y >= 0 and at.x < vp.x and at.y < vp.y
		var tint = BerserkLook.tint_of(body)
		print("QA BERSERK PROBE %s screen %d,%d of %dx%d %s tint %s scale %.3f" % [who, int(at.x), int(at.y),
			int(vp.x), int(vp.y), "on" if on else "off", "none" if tint == null else "%d,%d,%d" % [
			int(round(tint.r * 255)), int(round(tint.g * 255)), int(round(tint.b * 255))], BerserkLook.scale_of(body)])

## QA (round 855): OPENSRO_QA_TINT_PROBE=1 measures, every frame, the colour
## each body is drawn with on its own meshes (TintProbe: the object_tint its
## materials carry), against whether a pulse should be on it (a state's or
## berserk's), and how many shared per-level materials carry a pulse colour.
## A line on every change and every 30th frame (`lit`: BodyPulse holds a
## colour on it; before round 855 a state's or berserk's look was on):
## `QA TINT f<frame> <who> lit <0|1> meshes <n> tinted <k> colour <r,g,b> shared <s> by <setter>`
## (round 856: the slot's setter, BodyPulse.who, "-" with none).
## The bodies: this player, every other player, every COS, and every monster
## an abnormal state was ever heard for.
var _qa_tint_probe_on := OS.get_environment("OPENSRO_QA_TINT_PROBE") != ""
var _qa_tint_last := {}
var _qa_tint_monsters := {}
var _qa_tint_frame := 0

func _qa_tint_probe() -> void:
	if not _qa_tint_probe_on:
		return
	_qa_tint_frame += 1
	var shared := TintProbe.shared_tinted()
	var bodies := {"self": player}
	for id in _other_bodies:
		bodies["char:%d" % int(id)] = _other_bodies[id]
	for id in _cos_bodies:
		bodies["cos:%d" % int(id)] = _cos_bodies[id]
	for key in _abnormal_states:
		if String(key).begins_with("monster:"):
			_qa_tint_monsters[String(key)] = true
	for mk in _qa_tint_monsters:
		bodies[mk] = _state_body_of(String(mk))
	for who in bodies:
		var body = bodies[who]
		if body == null or not is_instance_valid(body):
			continue
		var m := TintProbe.measure(body)
		var lit := BodyPulse.on(body)
		# Round 856: whose colour the slot holds ("state", "berserk", "deco").
		var setter := BodyPulse.who(body) if lit else "-"
		var sig := "%d/%d/%d/%d/%s" % [int(lit), int(m["meshes"]), int(m["tinted"]), shared, setter]
		if _qa_tint_last.get(who, "") == sig and _qa_tint_frame % 30 != 0:
			continue
		_qa_tint_last[who] = sig
		var c = m["colour"]
		print("QA TINT f%d %s lit %d meshes %d tinted %d colour %s shared %d by %s" % [Engine.get_frames_drawn(), who, int(lit),
			int(m["meshes"]), int(m["tinted"]), "-" if c == null else "%d,%d,%d" % [int(round(c.r * 255)), int(round(c.g * 255)), int(round(c.b * 255))], shared,
			setter])

var _berserk_flash_t := -1.0
var _berserk_flash: ColorRect = null

func _berserk_flash_step(delta: float) -> void:
	if _berserk_flash_t < 0.0:
		return
	var a := BerserkLook.flash_alpha(_berserk_flash_t)
	_berserk_flash_t += delta
	if _berserk_flash == null or not is_instance_valid(_berserk_flash):
		var layer := CanvasLayer.new()
		layer.name = "BerserkFlash"
		layer.layer = -1
		add_child(layer)
		_berserk_flash = ColorRect.new()
		_berserk_flash.set_anchors_preset(Control.PRESET_FULL_RECT)
		_berserk_flash.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var add := CanvasItemMaterial.new()
		add.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
		_berserk_flash.material = add
		layer.add_child(_berserk_flash)
	_berserk_flash.color = Color(1, 1, 1, a)
	_berserk_flash.visible = a > 0.0
	if _berserk_flash_t >= BerserkLook.FLASH_IN_S + BerserkLook.FLASH_OUT_S:
		_berserk_flash_t = -1.0
		_berserk_flash.visible = false

## The server's answer for this player: sit (4) or stand (0), through the 1.5 s
## transition in which it refuses a move.
func _apply_player_motion(value: int) -> void:
	# Walk/Run's answer (round 781): no transition, nothing to play.
	if value == WorldNet.MOTION_WALK or value == WorldNet.MOTION_RUN:
		_apply_walk_mode(value == WorldNet.MOTION_WALK)
		return
	var what := _sit.answer(value, _player_anim_time)
	# The action window's sit button follows (FUN_006a3fb0, round 781).
	if value == WorldNet.MOTION_SIT or value == WorldNet.MOTION_STAND:
		_action_motion_shown(value)
	match what:
		"sit_down", "sit":
			var loop := _body_animation_path(_player_body, BsrReader.AnimationEntry.TYPE_SITTING, _player_weapon_group)
			if what == "sit_down":
				var down := _body_animation_for(_player_body, BsrReader.AnimationEntry.TYPE_SIT_DOWN, _player_weapon_group)
				if _play_player_once(down) > 0.0:
					_player_sit_clip = down
				print("SIT: player sits -- clip %s (action type 13), then %s (type 14, loop)" % [
					_body_animation_path(_player_body, BsrReader.AnimationEntry.TYPE_SIT_DOWN, _player_weapon_group), loop])
			else:
				print("SIT: player sits -- clip %s (type 14, loop)" % loop)
		"stand_up", "stand":
			if what == "stand_up":
				var up := _body_animation_for(_player_body, BsrReader.AnimationEntry.TYPE_STAND_UP, _player_weapon_group)
				if _play_player_once(up) > 0.0:
					_player_sit_clip = up
				print("SIT: player stands -- clip %s (action type 15)" % _body_animation_path(
					_player_body, BsrReader.AnimationEntry.TYPE_STAND_UP, _player_weapon_group))
		_:
			print("SIT: motion value %d for the player is not one OpenSRO plays" % value)

## A move starting while the stand-up clip still runs: the clip gives way to
## the run. Round 808: a seated player no longer moves at all (_stand_instead,
## the physics step's seated_walk), so the seated branch below is only a
## safety net -- the server would stand a character whose move reached it
## seated (its movement handler's SetMotionState(WALK/RUN)), and this client
## must then agree.
func _leave_sit_by_moving() -> void:
	var was_sitting := _sit.leave_by_moving()
	if was_sitting and NetClient.is_connected_to_server():
		# The server stands a seated character on its first accepted move; it
		# must reach it, or the server keeps her seated while this client
		# draws her standing (round 607's review). Round 749: an order goes
		# out as its 0x7021 at the end of this tick (_sync_move_order), which
		# the server's move handler stands her for (SetMotionState(WALK/RUN),
		# READ); a walk with no order (the QA walk) reports where she stands.
		if not _has_move_target:
			_send_stop()
	if not _player_one_shot_hold and _player_sit_clip != null and _player_one_shot == _player_sit_clip:
		_player_one_shot = null
	_player_sit_clip = null
	if was_sitting:
		print("SIT: moved while seated -- standing at once, no clip (the server's move sets WALK/RUN)")

## Spawns the other players an enter-world or zone-change result lists, and
## seats the ones its Seated tail names (round 607): the result that spawns a
## body is where its motion has to arrive -- a 0x30bf behind it reached this
## client before the world scene, or the new zone's bodies, existed. A body
## drawn seated takes the sitting loop without the sit-down clip.
func _spawn_result_others(others: Array, seated: Array) -> void:
	# Round 739 (B4): the whole list queued first, so the frame's budget goes
	# to the nearest of them, not the first listed; dressed after the seats
	# are known (below), so a seated arrival is dressed seated.
	_other_build_defer += 1
	for other in others:
		_note_other_pluses(other)
		# Each faces its heading from the list's tail (round 637's review
		# follow-up; NAN from an older server).
		_spawn_or_update_other(other.character_id, other.char_name, Vector3(other.x, other.y, other.z), other.equipped,
			_snapshot_body(other), other.heading, other.scale if other.has_model else CharacterAppearance.DEFAULT_SCALE, other.pluses)
		# Round 749: one spawned walking walks on (the record's mover).
		_resume_other_leg(other)
		# Round 795: a rider rides (the record's ride state and COS uid).
		if other.mount_uid != 0:
			_cos_seat(other.character_id, other.mount_uid)
		elif _riders.has(other.character_id):
			_cos_unseat(other.character_id)
	_other_build_defer -= 1
	_seat_result_others(seated)
	if _other_build_defer == 0:
		_pump_other_builds()

## A group spawn's players (0x3017/0x3019/0x3018, round 737) arrive one
## entity_entered at a time; NetClient brackets them (round 739's review, F5),
## so the page is queued whole and the frame's budget goes to the nearest of
## it, not to the first the server listed.
func _on_user_group_begin() -> void:
	_other_build_defer += 1
	# Round 762's review, F6: a new group's first share may open a new page
	# (_arrival_page); a group's later shares join the page it is in.
	var serial := int(NetClient.get("group_serial")) if NetClient != null else -1
	if serial != _page_group_seen:
		_page_group_seen = serial
		_page_pick = true
		# Round 764: the group's receive time decides its page, not now.
		var rx = NetClient.get("group_rx_msec") if NetClient != null else null
		_page_pick_rx = int(rx) if rx != null and int(rx) > 0 else Time.get_ticks_msec()

func _on_user_group_end() -> void:
	_other_build_defer = maxi(_other_build_defer - 1, 0)
	if _other_build_defer == 0:
		_pump_other_builds()

## The seats of an enter-world or zone-change result (round 607): an arrival
## still waiting to be dressed is dressed seated (_dress_other reads
## _other_seated); one already drawn swaps to the sitting loop.
func _seat_result_others(seated: Array) -> void:
	for id in seated:
		if not _other_bodies.has(int(id)):
			continue
		_other_seated[int(id)] = true
		var gait: Dictionary = _other_gaits.get(int(id), {})
		if gait.is_empty() or not is_instance_valid(gait["skeleton"]):
			continue
		gait["sitting"] = true
		var loop := _body_animation_for(gait["body"], BsrReader.AnimationEntry.TYPE_SITTING, gait["group"])
		_swap_other_loop(gait["skeleton"], loop)
		print("SIT: player %d drawn seated on spawn -- loop %s (type 14)" % [int(id),
			_body_animation_path(gait["body"], BsrReader.AnimationEntry.TYPE_SITTING, gait["group"])])

## Another player's answer: the sitting loop under the sit-down clip, or the
## stand loop under the stand-up clip, from their own body's table.
func _apply_other_motion(character_id: int, value: int) -> void:
	if value == WorldNet.MOTION_WALK or value == WorldNet.MOTION_RUN:
		_apply_other_walk_mode(character_id, value == WorldNet.MOTION_WALK)
		return
	# Round 756: a ghost sitting down or getting up plays a one-shot: dressed.
	if value == WorldNet.MOTION_SIT or _other_seated.has(character_id):
		_dress_ghost_now(character_id)
	if value == WorldNet.MOTION_SIT:
		_other_seated[character_id] = true
	elif value == WorldNet.MOTION_STAND:
		_other_seated.erase(character_id)
	var gait: Dictionary = _other_gaits.get(character_id, {})
	if gait.is_empty() or not is_instance_valid(gait["skeleton"]):
		return
	var was_sitting := bool(gait.get("sitting", false))
	var loop_type := BsrReader.AnimationEntry.TYPE_STAND
	var once_type := -1
	match value:
		WorldNet.MOTION_SIT:
			gait["sitting"] = true
			loop_type = BsrReader.AnimationEntry.TYPE_SITTING
			if not was_sitting:
				once_type = BsrReader.AnimationEntry.TYPE_SIT_DOWN
		WorldNet.MOTION_STAND:
			gait["sitting"] = false
			if was_sitting:
				once_type = BsrReader.AnimationEntry.TYPE_STAND_UP
		_:
			return
	var loop := _body_animation_for(gait["body"], loop_type, gait["group"])
	_swap_other_loop(gait["skeleton"], loop, [], _loop_in_ms(loop_type))
	if once_type != -1:
		var once := _body_animation_for(gait["body"], once_type, gait["group"])
		if once != null:
			_play_once(gait["skeleton"], once)
	print("SIT: player %d %s -- loop %s (type %d)%s" % [character_id, "sits" if value == WorldNet.MOTION_SIT else "stands",
		_body_animation_path(gait["body"], loop_type, gait["group"]), loop_type,
		"" if once_type == -1 else ", once %s (type %d)" % [_body_animation_path(gait["body"], once_type, gait["group"]), once_type]])

# --- A monster appearing (round 540) ------------------------------------------

## A monster that has just appeared (OpenSRO's own OpMonsterSpawned, 0x007E: a
## respawn or a GM /spawn), pushed to the zone the moment it appears rather than
## found on the next list. Its body is made the way a listed one is
## (_spawn_or_update_monster) and faced along its heading. A server sends it
## only with its -monster-spawn-push flag on (round 542; off by default;
## docs/protocol/monster_ai.md).
func _on_monster_spawned(spawned: CombatNet.MonsterSpawned) -> void:
	if spawned == null or spawned.monster == null:
		return
	var m := spawned.monster
	# This server pushes spawns: no list after a death is needed (round 655).
	_spawn_push_seen = true
	if _dying_until.has(m.monster_id):
		return
	var known := _monster_bodies.has(m.monster_id)
	if LatencyProbe.on and not known:
		LatencyProbe.monster_recv(m.monster_id, Time.get_ticks_msec(), _xz_from_player(Vector3(m.x, m.y, m.z)), "push")
	_spawn_or_update_monster(m)
	_face_monster_heading(m.monster_id, spawned.heading)
	print("World3D: monster %d spawned (push) %s at (%.1f,%.1f) heading %.2f%s" % [
		m.monster_id, m.monster_name, m.x, m.z, spawned.heading, " (already drawn)" if known else ""])

## Faces a standing monster's body along a server heading
## (MonsterMotion.heading_dir) by its model's front. A body walking a leg
## keeps facing its path; the capsule (no model) is left as it is.
func _face_monster_heading(monster_id: int, heading: float) -> void:
	var body = _monster_bodies.get(monster_id)
	if body == null or not is_instance_valid(body) or _monster_is_moving(monster_id):
		return
	var front := MonsterMotion.front_of(String((body as Node3D).get_meta("model", "")))
	if front == "":
		return
	# A spawn is a new object: its mover has no turn (0x9e0cd0 zeroes +0xa4),
	# and FUN_009d17e0 stores the angle with a bare FUN_009c4260.
	(body as Node3D).rotation.y = MonsterMotion.facing_yaw(MonsterMotion.heading_dir(heading), front)
	_remote_turns.erase((body as Node3D).get_instance_id())

func _on_monster_damaged(damaged: CombatNet.MonsterDamaged) -> void:
	# Someone else's hit on a monster: play its reaction now. The local
	# player's own hits are timed to the swing in _on_attack_result, which
	# marks the monster it is about to animate (see _own_hit_until) -- not
	# "whatever I am targeting now", which is a different monster after a
	# retarget.
	if damaged != null and int(_own_hit_until.get(damaged.monster_id, 0)) < Time.get_ticks_msec():
		# MonsterDamaged carries no critical flag: the NORMAL moan.
		var damaged_assembled = _monster_assembled.get(damaged.monster_id)
		if damaged_assembled != null:
			_audio_mark_hit(damaged_assembled.skeleton, false)
		_play_monster_action(damaged.monster_id, BsrReader.AnimationEntry.TYPE_HIT)
	# The health at once (the target window's gauge, when it is the target),
	# so it tracks each hit. The max comes from the last snapshot of this
	# monster. No list follows any more (round
	# 655): the push carries the health, and it is kept in the snapshot.
	if damaged != null:
		_apply_monster_hp(damaged.monster_id, damaged.remaining_hp)

## A monster's health as a result or a push reports it (round 655): kept in
## its snapshot, drawn on its bar and, for the target, in the target window.
## The max comes from the snapshot; a monster with none shows it full.
func _apply_monster_hp(monster_id: int, hp: int) -> void:
	_record_monster_hp(monster_id, hp)
	_paint_monster_hp(monster_id, hp)

## Keeps a reported health in the monster's snapshot, without drawing it.
func _record_monster_hp(monster_id: int, hp: int) -> void:
	var snap = _monster_snapshots.get(monster_id)
	if snap != null:
		snap.hp = hp

## Draws a monster's health in the target window when it is the target:
## `hp`, or the snapshot's when -1. (No bar over its head since round 673.)
func _paint_monster_hp(monster_id: int, hp: int = -1) -> void:
	var snap = _monster_snapshots.get(monster_id)
	if hp < 0:
		if snap == null:
			return
		hp = snap.hp
	var max_hp: int = snap.max_hp if snap != null else hp
	if monster_id == _last_attack_target:
		_set_target_hp(hp, max_hp)

## Runs `what` after `seconds` of scene time -- at once when zero.
func _after(seconds: float, what: Callable) -> void:
	# Out of the tree (a headless test's bare World3D) there is no timer to
	# wait on: it runs at once (round 785: the 100 ms hit-sound delay made
	# such a call non-zero where it had been 0).
	if seconds <= 0.0 or not is_inside_tree():
		what.call()
		return
	get_tree().create_timer(seconds).timeout.connect(what)

## Someone else's kill (the zone's OpMonsterDied, which the killer never
## receives): the death plays at once and the body goes when it has run
## (_finish_monster_death; round 655 -- until then a full list was asked for
## here). The killer's own kill comes through _on_attack_result instead.
func _on_monster_died(monster_id: int) -> void:
	_begin_monster_death(monster_id)

## A monster's death plays its own die animation (type 4 of its `default`
## group, docs/protocol/BSR_FORMAT.md) and the body stays on its last frame
## until that has run; only then is the body removed (_finish_monster_death;
## until round 655 a fresh list removed it).
## Reached from a zone's died push (_on_monster_died) and, for the killer, as
## the killing blow lands (_on_attack_result).
func _begin_monster_death(monster_id: int) -> void:
	# Once a body (round 785): a skill's killing hit and the zone's
	# OpMonsterDied (a chain link's, which reaches the caster too) both come
	# here; the die clip plays once.
	var dbody = _monster_bodies.get(monster_id)
	if dbody != null and is_instance_valid(dbody):
		if (dbody as Node).has_meta("death_begun"):
			return
		(dbody as Node).set_meta("death_begun", true)
	# The dead monster is nobody's target any more: its target window closes
	# as the clip starts -- for the killer too, since this path was added.
	if monster_id == _last_attack_target:
		_clear_target()
		_last_attack_target = -1
	_target_buff_book.drop(_fx_owner_key(monster_id, SkillNet.OWNER_MONSTER))
	# Its states' look goes before the die clip (round 785's client review,
	# finding 6): a frozen monster's clips held at speed 0 and its corpse
	# stood; a frostbitten one fell at half speed, half way.
	_drop_state_look(_fx_owner_key(monster_id, SkillNet.OWNER_MONSTER),
		dbody as Node3D if dbody != null and is_instance_valid(dbody) else null)
	_abnormal_states.erase(_fx_owner_key(monster_id, SkillNet.OWNER_MONSTER))
	# A kill of the monster this player was walking to: no attack to send,
	# and no reason to keep walking.
	if not _pending_attack.is_empty() and int(_pending_attack["monster"]) == monster_id:
		_drop_pending_attack()
	# A dead monster walks no further; its die clip replaces the gait below.
	_monster_motion.erase(monster_id)
	# Nor turns (round 637's review follow-up; OURS).
	var dying_body = _monster_bodies.get(monster_id)
	if dying_body != null and is_instance_valid(dying_body):
		_remote_turns.erase((dying_body as Node3D).get_instance_id())
	# Nor strikes again: a counter still waiting for its blow to land keeps
	# its own wait (the timer holds it), and nothing newer will come.
	_strike_waits.erase(monster_id)
	# Round 809: its row's die model in its place, and its death effects at
	# the die clip's key (MonsterRide).
	_swap_to_die_model(monster_id)
	_schedule_death_effects(monster_id)
	var seconds := _play_monster_action(monster_id, BsrReader.AnimationEntry.TYPE_DIE, true)
	_orb_schedule_death(monster_id, seconds)
	# The corpse lies for its species' DecayTime from the death, then fades
	# out (round 677, _monster_corpse_seconds); with no DecayTime known, for
	# its die clip, as before.
	var decay := _monster_corpse_seconds(monster_id)
	var hold := decay if decay > 0.0 else seconds
	var has_body: bool = dying_body != null and is_instance_valid(dying_body)
	# The corpse cannot be clicked or targeted (round 677's review, OURS):
	# READ only that retail's pick, FUN_0078ee20, tests no life state (its
	# tests are +0x70 bit 0, the player and its ride, and the option classes);
	# whether its click handler refuses a dead target was not settled. Until
	# round 677 the corpse went with its clip; lying for its DecayTime, a
	# clickable corpse took clicks meant for what stands behind it.
	if has_body:
		_drop_click_body(dying_body as Node3D)
	# The respawn list a server without the spawn push needs is asked for when
	# the clip has run, as before the corpse hold (round 655).
	if seconds > 0.0:
		get_tree().create_timer(seconds).timeout.connect(_maybe_pull_after_death)
	else:
		_maybe_pull_after_death()
	if hold > 0.0 and has_body:
		# The hold restarts from the clip's real start, replacing the killer's
		# predicted one (MonsterBodies.hold_for_kill).
		_dying_until[monster_id] = _idle_anim_time + hold
		get_tree().create_timer(hold).timeout.connect(
			_finish_monster_death.bind(monster_id, (dying_body as Node).get_instance_id()))
	else:
		# Nothing to watch (no die clip and no DecayTime, a capsule, a monster
		# with no body): it goes now. Until round 655 a fresh list removed it.
		_finish_monster_death(monster_id)
	print("World3D: monster %d dies, holding %.2fs (clip %.2fs, corpse %.2fs) t=%.2f" % [
		monster_id, hold if has_body else 0.0, seconds, decay, _idle_anim_time])

## How long a dead monster's corpse lies before it is removed, seconds: its
## species' DecayTime (characterdata column 13, ms; _monster_decay_ms_by_code),
## or 0 when not known (no Media.pk2, no row, no snapshot). READ, the server:
## while a character's life state is 2 (dead), `CGObj::Update` (0x484d10,
## slot 211, reached from CGObjMob::Update -> CGObjChar::Update ->
## CGObjMobile::Update) adds each tick's seconds to +0x3c and, once they
## reach the float at ref+0x84 -- DecayTime, kept in seconds (round 227,
## docs/protocol/refobj_binary_format.md) -- calls slot 218 (0x484cf0:
## SetLifeState(3)); the main loop (CMainProcess::FUN_00413b30) deletes a
## state-3 non-player through FUN_00417090, whose leave-world sends the
## despawn 0x3016 (docs/protocol/appear_fade.md). So in retail the corpse
## lies DecayTime from the death and then fades over 1.5 s. OURS: this
## server drops a monster at its death and sends no despawn, so the client
## times the corpse itself, from when it learns of the death (the zone's
## died push, or the killing blow landing for the killer).
func _monster_corpse_seconds(monster_id: int) -> float:
	var snap = _monster_snapshots.get(monster_id)
	if snap == null:
		return 0.0
	return float(int(_monster_decay_ms_by_code.get(String(snap.code_name), 0))) / 1000.0

## A dead monster's corpse time has run (or it had no hold): its body fades
## out (round 677; READ, the despawn retail's server sends at the corpse's
## DecayTime makes a CIDecoDisappear) and its snapshot goes. The server has
## already dropped it -- a respawn is a new monster with a new id (cmd/server
## maintainMonster) -- so no list is asked for (round 655). `body_id`, from
## the hold's timer: the body that died; a different body under the same id
## by then (a fade-out and a fresh spawn) is not this death's to remove.
func _finish_monster_death(monster_id: int, body_id: int = 0) -> void:
	if not _monster_bodies.has(monster_id) and not _monster_snapshots.has(monster_id):
		return
	var had_body := _monster_bodies.has(monster_id)
	if body_id != 0:
		# The hold's timer: only for the body that died. Gone (faded on a
		# leave, or a zone change took it) or another body under the same id
		# (a fresh spawn, or the next zone's monster): not this death's.
		var now_body = _monster_bodies.get(monster_id)
		if now_body == null or not is_instance_valid(now_body) or (now_body as Node).get_instance_id() != body_id:
			return
	_forget_monster(monster_id, true)
	if had_body:
		print("World3D: monster %d corpse fades out t=%.2f" % [monster_id, _idle_anim_time])

## A server that sends no spawn push (-monster-spawn-push off, the default)
## tells this client of a respawn or a GM spawn only through a list (round
## 655's review). So until the zone's first OpMonsterSpawned has been seen,
## a death that has played out asks for one list, at most once every
## DEATH_PULL_SECONDS (OURS). A server that pushes spawns is never asked.
const DEATH_PULL_SECONDS := 10.0
var _spawn_push_seen := false
var _death_pull_msec := -1000000
## How many lists the throttle has asked for (for the log and the test).
var _death_pulls := 0

func _maybe_pull_after_death() -> void:
	if _spawn_push_seen or not NetClient.is_connected_to_server():
		return
	var now := Time.get_ticks_msec()
	if now - _death_pull_msec < int(DEATH_PULL_SECONDS * 1000.0):
		return
	_death_pull_msec = now
	_death_pulls += 1
	NetClient.list_monsters()

## A unique monster appeared or was killed (round 657; UniqueNoticeNet).
## 0x874ea0 picks the line by the monster's SN_ key and shows it twice: in
## the system window as a type-0 line (0xffdbc99b) and on GDR_WARNING_WND,
## the blue banner at the top centre. Both are logged for the tester's file
## ("UNIQUE NOTICE" / "UNIQUE BANNER"), the banner with the colour it draws.
func _on_unique_notice(n: UniqueNoticeNet.Notice) -> void:
	# The RefObjID -> SN_ key index is built off the main thread at load
	# (_preload_name_key_index). A notice that beats it waits for it on a
	# timer instead of blocking the frame.
	if _name_key_task >= 0 and not WorkerThreadPool.is_task_completed(_name_key_task):
		get_tree().create_timer(0.1).timeout.connect(_on_unique_notice.bind(n))
		return
	var looked := Time.get_ticks_usec()
	var key := _unique_name_key(n.ref_obj_id)
	print("UNIQUE NAME KEY: ref %d -> %s in %.3f ms on the main thread" % [
		n.ref_obj_id, key if key != "" else "(none)", (Time.get_ticks_usec() - looked) / 1000.0])
	var names := _object_names()
	var monster_name := ""
	if names != null and key != "":
		monster_name = names.get_text(key, "")
	var table := _ui_text_table
	var text_of := func(k: String) -> String: return table.get_text(k, "") if table != null else ""
	var line := UniqueNoticeNet.line_for(n, key, monster_name, text_of)
	print("UNIQUE NOTICE: kind 0x%04x ref %d key %s text %s killer '%s' line '%s'" % [
		n.kind, n.ref_obj_id, key if key != "" else "?", UniqueNoticeNet.keys_for(n, key), n.killer, line])
	if line == "":
		# No archive text to show (no Media.pk2): nothing retail would draw.
		return
	_log_system(line, UniqueNoticeNet.SYSTEM_TYPE)
	if _hud_warning != null:
		_show_banner("unique", line)
		# Where it is on the screen (the harness measures the pixels there).
		var xf := _hud_warning.get_global_transform_with_canvas()
		var r := Rect2(xf.origin, _hud_warning.size * xf.get_scale())
		print("UNIQUE BANNER: %s text '%s' fill #%s alpha %d frame %s at %d,%d size %dx%d system colour 0x%08x" % [
			_hud_warning.style_name(), line, _hud_warning.fill_color().to_html(false),
			HudNotice.fill_alpha_for(_hud_warning.alpha()), String(HudNotice.STYLE_WARNING["corner"]),
			int(r.position.x), int(r.position.y), int(r.size.x), int(r.size.y), HudSystemMessage.COLOR_DEFAULT])

## The SN_ name key of characterdata row `ref_id`, or "", from the index
## _preload_name_key_index builds. Scanning the parts per notice instead cost
## 62 ms for a known id and 113 ms for an unknown one on the main thread
## (round 657 review, tools/probe_name_key_cost.gd on the render box); a
## lookup in the index is under 0.01 ms.
func _unique_name_key(ref_id: int) -> String:
	return String(_name_key_index().get(ref_id, ""))

## Starts building {RefObjID -> SN_ key} from the characterdata parts on a
## WorkerThreadPool task (the skill-effect table's pattern; Pk2Reader locks
## its reads). 118 ms of parsing on the render box, none of it on the main
## thread.
func _preload_name_key_index() -> void:
	if _name_key_task >= 0 or _name_key_loaded or _media_pk2 == null:
		return
	var pk2 := _media_pk2
	var result := _name_key_result
	_name_key_task = WorkerThreadPool.add_task(func() -> void:
		var t := Time.get_ticks_msec()
		var index := {}
		for path in CharTables.table_paths(pk2):
			var entry := ObjectLoader.find_file(pk2, path)
			if entry != null:
				NpcTableReader.parse_name_keys(pk2.read_file(entry), index)
		result["index"] = index
		result["ms"] = Time.get_ticks_msec() - t)

## The index, collected from the task once it has finished (the caller waits
## for completion first, _on_unique_notice); empty without an archive.
func _name_key_index() -> Dictionary:
	if _name_key_loaded:
		return _name_key_cache
	if _name_key_task < 0:
		_preload_name_key_index()
	if _name_key_task >= 0:
		PoolWait.task(_name_key_task)
		_name_key_task = -1
		_name_key_cache = _name_key_result.get("index", {})
		print("World3D: characterdata -> %d SN_ name keys (built in %d ms off the main thread)" % [
			_name_key_cache.size(), int(_name_key_result.get("ms", 0))])
		_name_key_result.clear()
	_name_key_loaded = true
	return _name_key_cache

var _name_key_task := -1
var _name_key_result: Dictionary = {}
var _name_key_cache: Dictionary = {}
var _name_key_loaded := false

## The player has advanced a level (server's OpLevelUp, only ever sent to
## the character that levelled). Announces it with the client's own recovered
## message and plays the real level-up burst on the player.
##
## stat_points is the character's total unspent points now (3 per level, see
## docs/LEVELING.md); the character window reads it when opened, so this
## handler does not need to push it anywhere -- it is here so the signal's
## full payload is on record at the call site.
func _on_level_up(new_level: int, _stat_points: int) -> void:
	var msg := level_up_line(new_level, _ui_text_table.get_text("UIIT_MSG_STRGERR_LEVEL", "") if _ui_text_table != null else "")
	# Round 639: retail's Client_ApplyExpAndLevelUp formats this with swprintf
	# (0x8a9bd3, 0x80 wide chars) and hands it to GDR_WARNING_WND, interface
	# child 0x23 (0x8a9c26 -> 0x77b580 -> CIFNotify 0x7b3eb0) -- not to the
	# system window. Logged for the tester's file all the same.
	print("SYSLOG warning: %s" % msg)
	if _hud_warning != null:
		_show_banner("level_up", msg)
	else:
		_log_system(msg)
	# 0x3054's handler 0x8a7020: snd_levup, 2-D (read; UiSounds.level_up).
	# Round 859: the effect and the sound are 0x3054's, which this round's
	# server sends to everyone in view; from an older server OpLevelUp alone
	# plays them (SystemEffects.OWN_LEVEL_UP_DEDUPE_MS, OURS).
	_orb_level = new_level
	_own_level_up_fx("OpLevelUp, level %d" % new_level)
	# The quest guide icon's count (round 785, QuestHud.on_level_up).
	if _hud_panels != null:
		_hud_panels.quest_level_up(new_level)
	# Refresh the HUD to the new level: the HP bar's higher maximum, the level
	# label, the reset EXP gauge and any new SP all come from the stats packet.
	_request_world_stats()

## Asks for fresh stats while the player block's stat panel is open, the
## way the client's own panel rewrites its rows every frame (vslot_012).
## Coalesced (round 629's review): any number of causes in one frame make one
## request, sent from a deferred call at the frame's end.
func _refresh_stat_panel(why: String) -> void:
	if _hud_player_info == null or not _hud_player_info.is_stat_panel_open():
		return
	_stat_panel_refresh_causes.append(why)
	if _stat_panel_refresh_causes.size() == 1:
		call_deferred("_flush_stat_panel_refresh")

var _stat_panel_refresh_causes: Array = []
## How many stats requests the panel has sent -- the QA log's measure of a storm.
var _stat_panel_refresh_sent := 0

func _flush_stat_panel_refresh() -> void:
	if _stat_panel_refresh_causes.is_empty():
		return
	_stat_panel_refresh_sent += 1
	print("World3D: player stat panel refresh #%d (%s)" % [_stat_panel_refresh_sent, ", ".join(PackedStringArray(_stat_panel_refresh_causes))])
	_stat_panel_refresh_causes.clear()
	_request_world_stats()

## What was worn at the last equipment list, as "slot:item" pairs, and
## whether a list has come yet (the world entry asks for one).
var _stat_panel_worn_sig := ""
var _stat_panel_worn_known := false

## An equipment list refreshes the panel only when what is worn CHANGED:
## every list is not a change (opening the bag asks for one). Every successful
## reply is a real list, an empty one included -- the server answers an equip
## and an unequip with the worn list itself (sendWornList), and a refusal
## carries an error and no list -- so an empty list is "nothing worn": taking
## off the last item, or putting one on a character wearing nothing, is a
## change (round 629-632 integration; round 629's review skipped empty lists
## as acknowledgements, which missed both).
func _stat_panel_on_equipment(items: Array, error: String) -> void:
	if error != "":
		return
	var pairs: Array = []
	for e in items:
		pairs.append("%d:%d" % [e.slot, e.item_id])
	pairs.sort()
	var sig := ",".join(PackedStringArray(pairs))
	var changed := _stat_panel_worn_known and sig != _stat_panel_worn_sig
	_stat_panel_worn_sig = sig
	_stat_panel_worn_known = true
	if changed:
		_refresh_stat_panel("equipment changed")

## The race emblem on the player block: the body's characterdata row's
## Country (column 14), 0 China / 1 Europe -- the byte CIFPlayerMiniInfo
## picks the emblem by (hud_player_info.gd, set_race).
func _apply_player_race() -> void:
	if _hud_player_info == null:
		return
	var code: String = _player_body if _player_body != "" else String(GENDER_BODY_CODE[DEFAULT_GENDER])
	if not _country_by_code.has(code):
		print("World3D: no characterdata Country for %s -- no race emblem" % code)
		return
	_hud_player_info.set_race(int(_country_by_code[code]))
	print("World3D: race emblem %s (%s Country %d)" % [_hud_player_info.race_mark_path(), code, int(_country_by_code[code])])

## Requests the character's full stats (level, exp, SP, HP max) so the HUD
## gauges stay live. Called on enter-world, each kill, a level-up, 0x3056 and
## 0x304E; coalesced (round 716's review) so the two or three causes one kill
## brings make one request, sent from a deferred call at the frame's end.
func _request_world_stats() -> void:
	if _world_stats_queued:
		return
	_world_stats_queued = true
	call_deferred("_flush_world_stats")

var _world_stats_queued := false
## How many stats requests _flush_world_stats has sent (tests read it).
var _world_stats_sent := 0

func _flush_world_stats() -> void:
	_world_stats_queued = false
	var who := NetClient.current_character_name
	if who != "" and NetClient.is_connected_to_server():
		_world_stats_sent += 1
		NetClient.character_stats(who)

## Applies the stats packet to the always-on HUD: the level label, the HP bar
## (with its level-scaled maximum), the underbar EXP gauge and the SP readout.
func _on_world_stats(stats: StatsNet.Stats) -> void:
	if stats == null or stats.error != "":
		return
	# The 0x304E gold line's base (round 716's review): seeded by the first
	# reply, then moved by gold messages and by replies this client asked for
	# (OpenSRO's shop, trade and storage still change gold without a 0x304E,
	# and the refresh they request keeps the base true). An unprompted push
	# never moves it: a regen push can read a member's row between the gold
	# split's credit and its 0x304E, and would swallow the line.
	if _last_known_gold < 0 or NetClient.last_stats_reply_requested:
		_last_known_gold = stats.gold
	if OS.get_environment("OPENSRO_QA_STATS_LOG") != "":
		print("QA STATS: t=%.2f tick=%d HP %d/%d MP %d/%d STR %d INT %d sitting=%s pelvis %s" % [_player_anim_time, _qa_tick,
			stats.hp, stats.max_hp, stats.mp, stats.max_mp, stats.str, stats.intel, str(_sit.sitting), _qa_pelvis_height()])
	# While dead the HP a stats reply carries is not taken (round 607's third
	# review): a regen push built before a lethal blow can arrive after the
	# blow's HP 0 and drew a live bar on a dead character. A dead character's
	# HP is 0 until the revive (_leave_dead_state, on OpReviveResult, which
	# the post-revive stats follow). The rest of the reply still applies.
	var take_hp := stats.max_hp > 0 and not _player_dead
	if take_hp:
		_own_hp_told()
		_last_enter_world_hp = stats.hp
		_last_enter_world_max_hp = stats.max_hp
	if _hud_target != null:
		_hud_target.set_player_level(stats.level)
	_player_level = stats.level
	_orb_level = stats.level
	if _hud_panels != null:
		# Round 837: the item mall's info block shows it.
		_hud_panels.player_level = stats.level
	if _hud_player_info != null:
		_hud_player_info.set_character(NetClient.current_character_name, stats.level)
		if take_hp:
			_hud_player_info.set_hp(stats.hp, stats.max_hp)
		# The mana bar drew blank while the server had no mana to report.
		# It does now -- the game's own base curve -- so show the real
		# number; a server too old to send it still gets the blank bar.
		if stats.max_mp > 0:
			_hud_player_info.set_mp(stats.mp, stats.max_mp)
		# The stat panel, the orbs and the "+" -- the same packet the
		# character window reads, applied on every arrival (round 629).
		# OPENSRO_QA_PMI drives the orbs itself; the server's count would
		# undo each state it sets.
		if _qa_pmi_spec != "":
			stats.has_hwan_count = false
		_hud_player_info.set_stats(stats)
		if _hud_player_info.is_stat_panel_open():
			print("World3D: player stat panel: str %s int %s phy %s def %s mag %s def %s bal %s / %s hit %s parry %s (level %d)" % [
				_hud_player_info.stat_value("GDR_PMI_TXT_STRDAT"), _hud_player_info.stat_value("GDR_PMI_TXT_INTDAT"),
				_hud_player_info.stat_value("GDR_PMI_TXT_PHYATTDAT"), _hud_player_info.stat_value("GDR_PMI_TXT_PHYDEFDAT"),
				_hud_player_info.stat_value("GDR_PMI_TXT_MAGATTDAT"), _hud_player_info.stat_value("GDR_PMI_TXT_MAGDEFDAT"),
				_hud_player_info.stat_value("GDR_PMI_TXT_PHYBALDAT"), _hud_player_info.stat_value("GDR_PMI_TXT_MAGBALDAT"),
				_hud_player_info.stat_value("GDR_PMI_TXT_HITDAT"), _hud_player_info.stat_value("GDR_PMI_TXT_PARRYDAT"), stats.level])
	if _hud_underbar != null:
		_hud_underbar.set_level(stats.level)
		_hud_underbar.set_exp(stats.exp_percent())
		# A plain total: SP is not out of anything, and passing a maximum drew
		# the authored SP bar permanently full (playtest 2026-09-20, items 10
		# and 19). The bar's real fill is progress toward the next skill
		# point, which the server does not send yet.
		_hud_underbar.set_sp(stats.skill_points)
	_guild_sp_now = stats.skill_points

## The EXP-loss line (UIIT_MSG_STATE_LOSE_EXP, "[%I64d]Experience Points
## lost."), or "" when nothing was lost.
static func exp_loss_line(exp_lost: int, template: String) -> String:
	if exp_lost <= 0:
		return ""
	return _printf_one(template if template != "" else "[%I64d]Experience Points lost.",
		["%I64d", "%lld", "%d"], exp_lost)

## The level-up line: UIIT_MSG_STRGERR_LEVEL ("You have advanced to level
## [%d].") through swprintf, as 0x8a9bd3 formats it -- so the brackets stay
## ("level [5]."). Until round 639 this replaced "[%d]" whole and dropped them.
static func level_up_line(new_level: int, template: String) -> String:
	if template == "" or not template.contains("%d"):
		return "You have advanced to level [%d]." % new_level
	return template.replace("%d", str(new_level))

## The lines a kill's experience writes to the system window, as
## Client_ApplyExpAndLevelUp (0x8a97c0) writes them: UIIT_MSG_STATE_GAIN_EXP
## ("[%I64d]Experience Points gained.") when the experience is above 0
## (0x8a9a45..0x8a9a76) and UIIT_MSG_STATE_GET_SKILL_EXP ("[%u]skill
## experience point gained.") when the skill experience is (0x8a9cc3..
## 0x8a9cfa), both with type 1 (the GAIN filter). An empty template (no
## archive) falls back to that English.
static func exp_gain_lines(exp_gained: int, skill_exp_gained: int, exp_template: String,
		skill_template: String) -> PackedStringArray:
	var out := PackedStringArray()
	if exp_gained > 0:
		out.append(_printf_one(exp_template if exp_template != "" else "[%I64d]Experience Points gained.",
			["%I64d", "%lld", "%d"], exp_gained))
	if skill_exp_gained > 0:
		out.append(_printf_one(skill_template if skill_template != "" else "[%u]skill experience point gained.",
			["%u", "%d"], skill_exp_gained))
	return out

static func _printf_one(template: String, specs: Array, value: int) -> String:
	for spec in specs:
		if template.contains(String(spec)):
			return template.replace(String(spec), str(value))
	return template

## Round 716: retail 0x3056 (Client_ApplyExpAndLevelUp 0x8a97c0). Every
## receiver of a kill share gets it, so a party member who never hit sees its
## gain too. The lines are the client's (RewardNoticeNet.exp_lines); the EXP
## gauge and SP readout are refreshed from the server's stats rather than
## advanced locally (OURS: one source of truth for the level arithmetic). The
## level-up itself is still announced by OpLevelUp.
func _on_exp_gained(g: RewardNoticeNet.ExpGain) -> void:
	if g == null:
		return
	var gain_t := _ui_text_table.get_text("UIIT_MSG_STATE_GAIN_EXP", "") if _ui_text_table != null else ""
	var lose_t := _ui_text_table.get_text("UIIT_MSG_STATE_LOSE_EXP", "") if _ui_text_table != null else ""
	var skill_t := _ui_text_table.get_text("UIIT_MSG_STATE_GET_SKILL_EXP", "") if _ui_text_table != null else ""
	for line in RewardNoticeNet.exp_lines(g, gain_t, lose_t, skill_t):
		_log_system(line, HudSystemMessage.TYPE_GAIN)
	print("World3D: 0x3056 from %d: EXP %d, skill EXP %d%s" % [g.source, g.exp, g.skill_exp,
		(", level up, %d stat points" % g.stat_points) if g.level_up else ""])
	_orb_gain(g.source, g.exp, g.skill_exp)
	_request_world_stats()

# --- Round 859: the kill orbs (ExpOrbs has the READ) ---------------------------

var _exp_orbs := ExpOrbs.new()
## monster id -> [exp, sp] orbs waiting for its die clip's type-100 key.
var _orb_pending := {}
## monster ids whose type-100 key has passed: a gain told later goes at once.
var _orb_death_passed := {}
## The level the orbs' exp unit is read for (the last level-up, else the
## stats' level), and the unit table (LevelDataReader.parse_exp_unit).
var _orb_level := 0
var _exp_units = null

## 0x3056's orbs (READ, Client_ApplyExpAndLevelUp): counted against the
## level's exp unit and SP's 100, added to the source's count, and launched
## now when its type-100 key has passed, else when it comes or the body goes.
## OURS: only a monster source is drawn (a player or COS source -- job PvP,
## a COS's gain -- is not).
func _orb_gain(source: int, exp_gain: int, sp_gain: int) -> void:
	var body = _monster_bodies.get(source)
	if source == 0 or body == null or not is_instance_valid(body):
		return
	var level := _orb_level if _orb_level > 0 else _player_level
	var counts := ExpOrbs.gain_counts(exp_gain, sp_gain, _exp_unit_of(level))
	if int(counts[0]) + int(counts[1]) == 0:
		return
	_orb_add(source, [int(counts[0]), int(counts[1]), 0, 0])
	print("World3D: kill orbs from monster %d: +%d EXP, +%d SP (level %d unit %d)%s" % [source,
		counts[0], counts[1], level, _exp_unit_of(level), ", now" if _orb_death_passed.has(source) else ", at its die clip's end"])
	if _orb_death_passed.has(source):
		_orb_launch(source)

## Round 860: adds [exp, sp, hwan, cos] orbs to a source's pending counts
## (+0x759 / +0x75a / +0x75b / +0x75c, READ); `cos_uid` names kind 3's target
## (+0x760).
func _orb_add(source: int, counts: Array, cos_uid: int = -1) -> void:
	var had: Array = _orb_pending.get(source, [0, 0, 0, 0])
	var sum: Array = []
	for k in 4:
		sum.append(int(had[k]) + (int(counts[k]) if k < counts.size() else 0))
	_orb_pending[source] = sum
	if cos_uid >= 0:
		_orb_cos_of[source] = cos_uid

## Round 860: source -> the COS uid its kind-3 orbs fly to.
var _orb_cos_of := {}

## Round 860: 0x304E kind 4 (HwanGauge has the READ): the hwan count, and
## the monster it rose from. A rise from a body in view becomes violet orbs
## that fly with the kill's others (at its die clip's end) and light the
## gauge one by one as they land; anything else drops the violet orbs in
## flight and shows the count.
func _on_hwan_count(count: int, source: int) -> void:
	if _hud_player_info == null:
		return
	var body = _monster_bodies.get(source)
	var in_view: bool = source != 0 and body != null and is_instance_valid(body)
	var r: Dictionary = _hud_player_info.hwan_count_told(count, in_view)
	var fly := int(r["fly"])
	print("World3D: hwan count %d from %d (%s): %s" % [count, source, "in view" if in_view else "no body",
		"%d violet orb(s)" % fly if fly > 0 else "shown now"])
	if bool(r["reset"]):
		var dropped := _exp_orbs.drop_kind(ExpOrbs.KIND_HWAN)
		for id in _orb_pending:
			(_orb_pending[id] as Array)[ExpOrbs.KIND_HWAN] = 0
		if dropped > 0:
			print("World3D: %d violet orb(s) in flight dropped" % dropped)
		return
	if fly > 0:
		_orb_add(source, [0, 0, fly, 0])
		if _orb_death_passed.has(source):
			_orb_launch(source)

## Round 860: 0x30C9 kind 3, a COS's EXP (READ c:0x8aa340): for this
## player's own COS, a gain from a body in view adds
## count_for(float(exp / unit[the COS's level])) orbs (the 64-bit division
## before the float) to the source's +0x75c with the COS at +0x760; they fly
## hwan_g to the COS's Bip01 Spine1 with the kill's others, and land as the
## blue indraft and the chime -- no gauge.
func _cos_exp_orbs(u: CosNet.Update) -> void:
	if u.exp_delta <= 0 or u.source == 0 or _hud_cos == null:
		return
	var d: CosNet.Data = _hud_cos.cos_data(u.uid)
	var body = _monster_bodies.get(u.source)
	if d == null or body == null or not is_instance_valid(body):
		return
	var unit := _exp_unit_of(d.level)
	if unit <= 0:
		return
	@warning_ignore("integer_division")
	var n := ExpOrbs.count_for(float(u.exp_delta / unit))
	if n <= 0:
		return
	_orb_add(u.source, [0, 0, 0, n], u.uid)
	print("World3D: COS %d EXP orbs from monster %d: +%d (level %d unit %d)%s" % [u.uid, u.source, n, d.level, unit,
		", now" if _orb_death_passed.has(u.source) else ", at its die clip's end"])
	if _orb_death_passed.has(u.source):
		_orb_launch(u.source)

func _exp_unit_of(level: int) -> int:
	if _exp_units == null:
		_exp_units = {}
		if _media_pk2 != null:
			var e := ObjectLoader.find_file(_media_pk2, LevelDataReader.TABLE_PATH)
			if e != null:
				_exp_units = LevelDataReader.parse_exp_unit(_media_pk2.read_file(e))
	return int((_exp_units as Dictionary).get(level, 0))

## The DEAD state's event 100 (READ c:0xa59e30) is the die clip's end
## (ExpOrbs.DEATH_EVENT): scheduled as the clip starts, `seconds` long; no
## clip leaves the orbs to the body's removal.
func _orb_schedule_death(monster_id: int, seconds: float) -> void:
	if seconds <= 0.0:
		return
	if not is_inside_tree():
		_orb_death_event(monster_id)
	else:
		get_tree().create_timer(seconds).timeout.connect(_orb_death_event.bind(monster_id))

func _orb_death_event(monster_id: int) -> void:
	_orb_death_passed[monster_id] = true
	_orb_launch(monster_id)

## FUN_009cb7c0 (READ): from the monster's Bip01 (its position without one)
## to this player; dropped below Effect Quality 2.
func _orb_launch(monster_id: int) -> void:
	var counts: Array = _orb_pending.get(monster_id, [])
	_orb_pending.erase(monster_id)
	var cos_uid := int(_orb_cos_of.get(monster_id, -1))
	_orb_cos_of.erase(monster_id)
	var body = _monster_bodies.get(monster_id)
	var violet := int(counts[ExpOrbs.KIND_HWAN]) if counts.size() > ExpOrbs.KIND_HWAN else 0
	if counts.is_empty() or body == null or not is_instance_valid(body) or player == null:
		_orb_violet_at_once(violet)
		return
	if SkillEffects.quality < ExpOrbs.QUALITY_NEEDED:
		# READ (FUN_009cb7c0): below 2 only the violet count reaches the
		# gauge, at once; the rest are dropped.
		print("World3D: kill orbs of monster %d dropped (Effect Quality %d)" % [monster_id, SkillEffects.quality])
		_orb_violet_at_once(violet)
		return
	var particles := _open_particles_pk2_if_set()
	if particles == null:
		return
	if _exp_orbs.parent == null:
		_exp_orbs.parent = self
		_exp_orbs.arrived = func(kind: int) -> void:
			if kind == ExpOrbs.KIND_HWAN and _hud_player_info != null:
				_hud_player_info.hwan_orb_arrived()
				print("World3D: violet orb arrived -- the gauge shows %d of %d" % [
					_hud_player_info.hwan_gauge.display, _hud_player_info.hwan_gauge.real])
		_exp_orbs.factory = func(path: String) -> EfpEffect: return EfpEffect.create(path, _open_particles_pk2_if_set())
		_exp_orbs.sound = func(path: String, at: Vector3) -> void:
			SoundTable.play_file(path, at)
			print("World3D: kill orb absorbed (%d of %d) -- %s at %s" % [_exp_orbs.absorbed, _exp_orbs.launched,
				path, at.snapped(Vector3(0.1, 0.1, 0.1))])
	var skel := SkillEffects.skeleton_of(body)
	var start: Vector3 = (body as Node3D).global_position
	if skel != null and skel.is_inside_tree() and skel.find_bone(ExpOrbs.SOURCE_BONE) >= 0:
		start = SkillEffects.bone_point(body, ExpOrbs.SOURCE_BONE, Vector3.ZERO)
	var cos_body: Node3D = _cos_bodies.get(cos_uid) if cos_uid >= 0 else null
	var n := _exp_orbs.launch(start, counts, player, cos_body)
	print("World3D: kill orbs launched from monster %d: %d EXP + %d SP + %d violet + %d COS = %d in flight" % [monster_id,
		counts[0], counts[1], counts[2], counts[3], n])

## Round 860: violet orbs that will not fly (no body, Effect Quality below 2)
## reach the gauge at once.
func _orb_violet_at_once(violet: int) -> void:
	if violet <= 0 or _hud_player_info == null:
		return
	for _i in violet:
		_hud_player_info.hwan_orb_arrived()

## Round 716: retail 0x304E kind 1, the new gold total (c:0x8a70d0): a shown
## update prints UIIT_MSG_STATE_GAIN_GOLD with the rise over the last total
## this client knew, then the purse is refreshed from the server's stats.
