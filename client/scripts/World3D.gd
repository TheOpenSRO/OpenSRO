## with the points, and the master's "Level Up Guild" button on the Guild tab
## (our own dev control, not the real client's guild window) shows the cost.
var _guild_level := 0
var _guild_max_members := 0
var _guild_next_gold := 0
var _guild_next_gp := 0
## Regions whose NPCs have already been placed live in _grid.npc_regions_done,
## so streaming back into a still-loaded region doesn't stack a second copy
## of everyone in it; a streamed-out region's mark goes with its terrain
## node (RegionGridState.unload), so it is populated again on return.

func _load_npc_tables() -> void:
	if _npc_tables_loaded:
		return
	_npc_tables_loaded = true
	# Opened here rather than reusing _media_pk2: region streaming starts
	# before _try_initialize_pk2_ui() runs, so that handle is still null the
	# first time a region asks for its NPCs.
	if _media_pk2 == null:
		_media_pk2 = _open_media_pk2_if_set()
	if _media_pk2 == null:
		return
	# The same characterdata parts give the model and the name: a row
	# carries an id, an `SN_` key and a `.bsr`, and textdata_object turns
	# the key into what the game calls the NPC. Read once, joined twice.
	# Both object-name files (round 731, ItemTableReader.load_object_names).
	var t_npc := Time.get_ticks_usec()
	_adopt_char_entry()
	var centry := CharTables.entry(_media_pk2)
	var names: UiTextTable = centry.names
	# NPC greetings resolve through a different table than names: npcchat's SN_
	# ids live in textquest_speechname.txt (with the English in a later column,
	# which UiTextTable picks by content).
	var greet_entry := ObjectLoader.find_file(_media_pk2, "server_dep\\silkroad\\textdata\\textquest_speechname.txt")
	if greet_entry != null:
		_npc_text_table = UiTextTable.parse(_media_pk2.read_file(greet_entry))
	# Every characterdata part (round 746), read by CharTables' entry task.
	_npc_models = centry.npc_models
	_npc_codes = centry.npc_codes
	_npc_names = centry.npc_names
	print("World3D: characterdata entry tables (read %d us on a worker; this call %d us, of which %d us waiting)" % [
		centry.usec, Time.get_ticks_usec() - t_npc, CharTables.last_entry_wait_usec])
	# What each NPC offers: shops (refshopgroup) and greetings (npcchat).
	var shop_entry := ObjectLoader.find_file(_media_pk2, NpcServiceReader.SHOP_TABLE)
	if shop_entry != null:
		_npc_shop_set = NpcServiceReader.parse_shop_npcs(_media_pk2.read_file(shop_entry))
	var chat_entry := ObjectLoader.find_file(_media_pk2, NpcServiceReader.CHAT_TABLE)
	if chat_entry != null:
		_npc_greetings = NpcServiceReader.parse_greetings(_media_pk2.read_file(chat_entry))
	# The shop goods chain (refshopgroup -> ... -> item codename), so Buy shows
	# the NPC's real wares. Reads through _media_pk2 by archive path.
	_shop_reader = ShopReader.new().load(func(archive_path: String) -> PackedByteArray:
		var e := ObjectLoader.find_file(_media_pk2, archive_path)
		return _media_pk2.read_file(e) if e != null else PackedByteArray())
	# The teleport network (round 577): a gate is not in npcpos -- the
	# town's Dimensional Gate is a placed object, bound per region by
	# _bind_region_gates from teleportbuilding's position.
	_teleport_reader = TeleportReader.new().load(func(archive_path: String) -> PackedByteArray:
		var e := ObjectLoader.find_file(_media_pk2, archive_path)
		return _media_pk2.read_file(e) if e != null else PackedByteArray())
	_load_walk_in_points()
	# The gate's name resolves through the same textdata_object table
	# (_object_names); it was just parsed, so it is kept rather than parsed
	# a second time on the first gate.
	if _object_name_table == null and names != null:
		_object_name_table = names
	print("World3D: NPC tables -- %d model(s), %d name(s), %d shop, %d greetings; %s (NPC placements come from the server's spawns, round 708)" % [
		_npc_models.size(), _npc_names.size(), _npc_shop_set.size(), _npc_greetings.size(),
		_teleport_reader.summary()])
	_qa_feed_local_npcs()

## A floating name over an NPC's head.
##
## Height comes from the assembled skeleton's own bones rather than a fixed
## offset: NPC models vary a great deal in size (the same reason the monster
## labels measure their skeleton), and one number puts a label through a
## tall NPC's face and far above a short one.

## The alias and job level the own plate was last built with (round 805).
var _plate_alias := ""
var _plate_job_level := -1

## Puts (or replaces) the local player's name plate, the same one every other
## entity carries.
##
## The guild line the original draws ABOVE the name is not here: the client is
## not told its own guild yet, and a plate is not the place to invent one. It
## goes in as soon as the server sends it -- see docs/PLAYTEST_2026_09_20.md
## item 18.
func _refresh_player_name_plate() -> void:
	if player == null or not is_instance_valid(player):
		return
	var existing := player.get_node_or_null("Name")
	# Round 831: a plate re-made over a shown one stays shown (the sweep hides
	# a new plate until it first measures it: a flicker on every redress).
	var was_shown: bool = existing != null and (existing as Node3D).visible
	if existing != null:
		# Out of the tree at once: a plate re-made in the same frame (round
		# 800's suit change) must take the name "Name" itself.
		player.remove_child(existing)
		existing.queue_free()
	var who := NetClient.current_character_name
	if who == "":
		return
	var top := _skeleton_top(_player_skeleton) if _player_skeleton != null else 1.8 * PLAYER_SCALE_RATIO
	# Round 800: "*" + the name and the job mark while a suit is worn.
	# Round 805: the name is the job alias then (READ: CICPlayer::vslot_025
	# c:0x9da2aa..0x9da2cf hands the name setter, slot 29, the alias at
	# +0x2098 -- 0x3013's second string -- when the job state is not 4). The
	# alias on a wear or an alias change mid-game is OURS (the original's
	# refresh after 0x3038 is OPEN); it matches what others see.
	var js := _own_job_state()
	_plate_alias = NetClient.job_alias
	if js >= 1 and js <= 3 and _plate_alias != "":
		who = _plate_alias
	var plate := _name_plate(job_plate_text(who, js), top)
	# Round 811: the original's plate (_retail_plate_look), white (c:0x9cfd50).
	# Round 838 (OURS): a Name Color scroll's colour instead.
	_retail_plate_look(plate, _plate_name_colour(_own_id()))
	player.add_child(plate)
	if was_shown:
		plate.visible = true
	_plate_job_level = NetClient.job_level
	_job_plate_decor(plate, plate, js, NetClient.job_level, _race_of_body(_player_body) == 1, false)
	# Round 814: its own guild line, in the own colour.
	_apply_guild_line(plate, plate, NetClient.own_guild_line, js, true, false)
	# Round 808: a plate re-made on a mount (a suit worn, the alias landing)
	# goes straight over it, not into it for a frame.
	var own := _own_id()
	var mount: Node3D = _cos_bodies.get(int(_riders.get(own, 0))) if _riders.has(own) else null
	if mount != null and is_instance_valid(mount):
		_raise_rider_plate(own, mount, true)

## `swept` (round 673's review): whether the plate follows the 300-from-the-
## player rule (NamePlates.Sweep), which owns its `visible`. A ground item's
## plate has its own rule -- shown only while hovered or Z is held
## (GroundItems.update_labels, round 608) -- so it is made unswept: the sweep
## setting `visible` every frame showed every item name in range.
func _name_plate(text: String, above: float, swept: bool = true) -> Label3D:
	var label := Label3D.new()
	label.name = "Name"
	label.text = text
	label.position = Vector3(0.0, above * (1.0 + NAME_PLATE_CLEARANCE_FRACTION), 0.0)
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	# **Fixed size, not world size.** The real client draws a name plate in
	# screen space from the entity's position, so it reads the same however
	# far away the entity is. A world-scaled Label3D instead shrinks with
	# distance, and at this world's scale -- a character is
	# REAL_CHARACTER_NATIVE_HEIGHT units tall, not 1.8 -- the default 0.005
	# pixel size made every plate a smear a few pixels high. That is why the
	# monster labels have never shown up in a render either.
	label.fixed_size = true
	label.pixel_size = NAME_PLATE_PIXEL_SIZE
	label.modulate = NAME_PLATE_COLOUR
	label.outline_size = NAME_PLATE_OUTLINE
	label.outline_modulate = NAME_PLATE_OUTLINE_COLOUR
	# Round 760: 4.2.2's oversampled raster at the UI scale (FontOversampling).
	FontOversampling.label3d(label, label.font_size, NAME_PLATE_OUTLINE, NAME_PLATE_PIXEL_SIZE)
	# Names read over whatever they stand in front of, which is what makes a
	# crowd of NPCs legible -- and retail's name is a screen-space draw over
	# the scene (NamePlates).
	label.no_depth_test = true
	label.render_priority = 1
	# Drawn after the bloom, as retail's 2D names (OverlayView, round 702).
	label.layers = OverlayView.BIT
	label.add_to_group("name_plates")
	# Shown while its owner is within NamePlates.RANGE of the player (READ),
	# from any camera angle; hidden until the sweep first measures it.
	if swept:
		_plate_sweep.add(label)
	return label

## The party monster's mark (round 660): retail's CICMonster vslot 15
## (0x9d3e70) draws, in its name pass, one 16 x 16 quad of
## `icon\item\etc\europe_partymob.ddj` (the name table 0xec7570, index 5)
## 20 px left of the name box's left edge -- so 4 px clear of it -- top-aligned
## with the box, for a monster whose +0x7ad is 1 (0x9d3f2a). READ. The name
## plate itself is ours (see below), so the mark is sized to its text's line
## height, with the gap kept at the retail 4 : 16 of the icon (OURS), and is
## drawn as the plate is: billboarded, fixed size, over the scene.
const PARTY_MARK_TEXTURE := "icon\\item\\etc\\europe_partymob.ddj"
const PARTY_MARK_PX := 16.0
const PARTY_MARK_GAP_PX := 4.0

func _party_mark(label: Label3D) -> Sprite3D:
	if _ui_builder == null:
		return null
	var tex: Texture2D = _ui_builder.load_texture(PARTY_MARK_TEXTURE)
	if tex == null:
		return null
	var mark := Sprite3D.new()
	mark.name = "PartyMark"
	mark.texture = tex
	mark.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	mark.fixed_size = true
	mark.no_depth_test = true
	mark.render_priority = label.render_priority
	mark.layers = OverlayView.BIT
	_fit_party_mark(label, mark)
	# A child of the plate: shown and hidden with it (round 673).
	return mark

## Sizes and places a party mark against its plate's text and scale. Called
## again whenever the plate is re-sized (_fit_monster_name_box, round 673's
## review): the mark's pixel_size is the plate's times its own ratio, so a
## UI-scale change or a resize that re-sized only the plate left the mark
## at the old scale, over the text or adrift.
func _fit_party_mark(label: Label3D, mark: Sprite3D) -> void:
	if mark == null or mark.texture == null:
		return
	var tex := mark.texture
	var font: Font = label.font if label.font != null else ThemeDB.fallback_font
	var text_size := font.get_string_size(label.text, HORIZONTAL_ALIGNMENT_LEFT, -1, label.font_size)
	var k := text_size.y / PARTY_MARK_PX  # icon pixels -> the plate's font pixels
	mark.pixel_size = label.pixel_size * k * float(PARTY_MARK_PX) / float(tex.get_height())
	# The plate is centred on its node: the mark's centre is half the text, the
	# gap and half itself to the left, in its own texture pixels.
	var tex_px := float(tex.get_height()) / PARTY_MARK_PX
	mark.offset = Vector2(-(text_size.x * 0.5 / k + PARTY_MARK_GAP_PX + PARTY_MARK_PX * 0.5) * tex_px, 0.0)

# --- Job mode on the plates (round 800) ---------------------------------------
#
# READ, GlobalDataManager::FUN_009cbb90 (the name setter, vtable slot 29): a
# CICUser whose job state (vslot 43, +0x50d) is not 4 shows "*" + its name
# (L"*" at 0xd92240); the name is the spawn's, which carries the job alias
# while a suit is worn (pc_spawn row 21). FUN_009dea30 (the overhead draw,
# 0x9dec35..0x9dec73) draws a 16 x 16 quad of com_job_merchant / _thief /
# _hunter.ddj (the table at 0xec7570, indexes 0..2) by the job state, its left
# 20 px left of the name box's (`fsub 0xe1b830` = 20.0 on the box's x, which
# FUN_008b2d30 writes first; `fadd 0xe1b8e0` = 16.0), top-aligned with the
# box (round 805 corrected round 800's reading of the 20 as a rise), and the
# guild line only at job state 4 (0x9df082..0x9df09d). An observer's job state
# comes only from the spawn record: a suit put on in view changes nothing
# for it (READ: the 0x3038 handler only re-dresses), so a plate keeps what it
# spawned with until the player is spawned again.
const JOB_MARK_TEXTURES := {
	1: "interface\\ifcommon\\com_job_merchant.ddj",
	2: "interface\\ifcommon\\com_job_thief.ddj",
	3: "interface\\ifcommon\\com_job_hunter.ddj",
}
const JOB_MARK_PX := 16.0
## The gap between the quad and the name box (READ: the quad's left 20.0 left
## of the box, 16.0 wide -- 4 px clear; round 800 had read the 20 as a rise).
const JOB_MARK_GAP_PX := 4.0

## The plate text for a name at a job state ("*" + name out of state 4).
static func job_plate_text(name: String, job_state: int) -> String:
	if job_state >= 1 and job_state <= 3 and name != "":
		return "*" + name
	return name

## The job mark over `label` (a child of `holder`, swept with it), or null for
## job state 4. Placed by _layout_job_decor.
func _job_mark(label: Label3D, holder: Node3D, job_state: int, swept: bool) -> Sprite3D:
	var old := holder.get_node_or_null("JobMark")
	if old != null:
		if swept:
			_plate_sweep.drop(old as Node3D)
		# Out of the tree at once, so a mark re-made this frame is "JobMark".
		holder.remove_child(old)
		old.queue_free()
	if _ui_builder == null or not JOB_MARK_TEXTURES.has(job_state):
		return null
	var tex: Texture2D = _ui_builder.load_texture(String(JOB_MARK_TEXTURES[job_state]))
	if tex == null:
		return null
	var mark := Sprite3D.new()
	mark.name = "JobMark"
	mark.texture = tex
	mark.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	mark.fixed_size = true
	mark.no_depth_test = true
	mark.render_priority = label.render_priority
	mark.layers = OverlayView.BIT
	mark.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	mark.position = label.position if holder != label else Vector3.ZERO
	holder.add_child(mark)
	if swept:
		_plate_sweep.add(mark)
	return mark

## A suited player's plate extras (round 805): the job mark, and with the OURS
## Job Titles on Names row on (VideoOptions.JOB_TITLES) the class title.
##   - Off, the original's: no title -- the title slot (vtable slot 30,
##     c:0x9c28a0) is emptied for a CICharactor whose job state is not 4,
##     READ -- and the mark left of the name (_job_mark).
##   - On, OURS (the user's private-server reference): the class title
##     UIIT_STT_CLASS_[EU_]X_<job level> (JobText.class_key, the race's table
##     as CIFPlayerInfo picks it) in the original's title colour #FFE65B
##     (READ, 0xffffe65b at c:0x9c28ed) left of "*alias", laid out as the
##     original lays out any title (_layout_job_decor), and the mark right of
##     the name.
## Job state 4 (no suit) has neither.
func _job_plate_decor(label: Label3D, holder: Node3D, job_state: int, job_level: int, europe: bool, swept: bool) -> void:
	var old := holder.get_node_or_null("JobTitle")
	if old != null:
		if swept:
			_plate_sweep.drop(old as Node3D)
		holder.remove_child(old)
		old.queue_free()
	var titled := job_state >= 1 and job_state <= 3 and job_titles_on()
	var title_text := ""
	if titled:
		title_text = _resolve_any_text(JobText.class_key(job_state, job_level, europe), "")
	elif job_state == UserSpawnNet.JOB_STATE_NONE:
		# Round 838: the hwan level's title (TitleNet; READ FUN_009ca930 ->
		# the title slot, which a job suit empties).
		title_text = _hwan_title_text(_own_id() if holder == label else int(holder.get_meta("character_id", -1)), europe)
	_job_mark(label, holder, job_state, swept)
	if title_text != "":
		var title := _name_plate(title_text, 0.0, false)
		title.name = "JobTitle"
		title.remove_from_group("name_plates")
		title.position = label.position if holder != label else Vector3.ZERO
		# Round 811: the title setter's text item (READ c:0x9c28a0): font 0
		# with the box (FUN_008b3bd0), its style flags 3 (FUN_008b4400(5, 3)):
		# bit 0 the shadow, the glyph drawn first at +1, +1 in black at the
		# colour's alpha (FUN_008b2290's param_5, from FUN_008b48b0's `+0x60 &
		# 1`), bit 1 the bold glyph set (FUN_008b39e0: +0x60 & 2 selects the
		# font's style 2 -- INFERRED the client's weight-600 variant, MEASURED
		# 2-px stems in the user's private-server picture).
		# Round 838 (OURS): a Title Color scroll's colour instead of the yellow.
		var title_colour := _plate_title_colour(_own_id() if holder == label else int(holder.get_meta("character_id", -1)))
		_retail_plate_look(title, title_colour, false)
		var bold := _plate_bold_font()
		if bold != null:
			title.font = bold
		title.render_priority = label.render_priority + 1
		var shadow := Label3D.new()
		shadow.name = "Shadow"
		shadow.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		shadow.fixed_size = true
		shadow.no_depth_test = true
		shadow.outline_size = 0
		shadow.modulate = Color(0.0, 0.0, 0.0, title_colour.a)
		shadow.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
		shadow.render_priority = label.render_priority
		shadow.layers = OverlayView.BIT
		title.add_child(shadow)
		holder.add_child(title)
		if swept:
			_plate_sweep.add(title)
	_layout_job_decor(label, holder)

## Round 814: the guild line over a character's name (docs/protocol/
## guild_plate.md), READ from the original's draw (CICUser slot 15 event 4,
## GlobalDataManager::FUN_009dea30, asm 0x9df0b2..0x9df21f) and its plate
## (FUN_009dc460 -> FUN_009a4f40):
## - the text GuildPlateNet.plate_text: "[guild * grant]" or "[guild]";
## - its own plate item (FUN_008b4f30) through the name setter FUN_008b3bd0:
##   font 0 with the 0x40000000 box, as the name's (READ: FUN_008b48b0 fills
##   the box whenever +0xc is set). Round 823, OURS (GUILD_LINE_BOX): drawn
##   with no box, as the user's reference client draws it (`[Verizon *
##   GayRoasters]` bare over a boxed name, rounds 817 and 823) -- the user's
##   call over the retail binary's box;
## - drawn at the name's projected point less 20.0 px in y (`fsub
##   [0xe1b830]`, 20.0, on +0x4f4 at 0x9df0c0): GUILD_LINE_RAISE_PX above the
##   name line, centred where the name block is (the plate's point), so it
##   rides a mount with the name (_set_plate_y);
## - only while the job state is 4 (no suit; vslot 0xac at 0x9df099) -- a
##   suit's record carries no guild block either;
## - round 842: its colour is GuildLineColour's -- the own guild's lines
##   (the player's and every fellow member's: one shared plate item per guild
##   name, recoloured orange by the own player's) GUILD_LINE_OWN_COLOUR, a
##   union guild's green, a war enemy's red (no wars: OPEN), the rest
##   GUILD_LINE_COLOUR; all recoloured when the own line or the union
##   changes (_recolour_guild_lines, the original's FUN_009a4450);
## - the option byte that also gates it (FUN_004f9d00()+0x10) is OPEN: on;
## - round 824: the crest drawn left of it (_fit_guild_crest; the entry's
##   guild texture +0x34 -- the union's +0x38 is OPEN, no unions).
const GUILD_LINE_RAISE_PX := 20.0
## Round 823, OURS: the guild line has no box (retail's has one; see above).
const GUILD_LINE_BOX := false
const GUILD_LINE_OWN_COLOUR := GuildLineColour.OWN
const GUILD_LINE_COLOUR := GuildLineColour.OTHER

## Round 842: the line colour for a character of guild_name (own: the
## player's own line).
func _guild_line_colour(guild_name: String, own: bool) -> Color:
	if own:
		return GUILD_LINE_OWN_COLOUR
	return GuildLineColour.colour_for(guild_name, String(NetClient.own_guild_line.get("guild_name", "")),
		NetClient.guild_data.union.is_allied, NetClient.guild_data.hostile.is_hostile)

## Round 842: every other player's guild line recoloured (FUN_009a4450, after
## the own line or the union changed).
func _recolour_guild_lines() -> void:
	for id in _other_bodies:
		var node = _other_bodies[id]
		if node == null or not is_instance_valid(node):
			continue
		var g := (node as Node).get_node_or_null("GuildLine") as Label3D
		if g == null:
			continue
		var line: Dictionary = NetClient.user_guilds.get(int(id) & 0xffffffff, {})
		g.modulate = _guild_line_colour(String(line.get("guild_name", "")), false)

## Re-makes the guild line under `holder` for `label` (the "Name" plate) from
## `line` ({guild_name, nickname}); none without a guild or in a job suit.
func _apply_guild_line(label: Label3D, holder: Node3D, line: Dictionary, job_state: int, own: bool, swept: bool) -> void:
	if label == null or holder == null:
		return
	var old := holder.get_node_or_null("GuildLine")
	if old != null:
		if swept:
			_plate_sweep.drop(old as Node3D)
		holder.remove_child(old)
		old.queue_free()
	var text := GuildPlateNet.plate_text(String(line.get("guild_name", "")), String(line.get("nickname", "")))
	if text == "" or job_state != UserSpawnNet.JOB_STATE_NONE:
		return
	var g := _name_plate(text, 0.0, false)
	g.name = "GuildLine"
	g.remove_from_group("name_plates")
	g.position = label.position if holder != label else Vector3.ZERO
	_retail_plate_look(g, _guild_line_colour(String(line.get("guild_name", "")), own), GUILD_LINE_BOX)
	if not GUILD_LINE_BOX:
		# No box anywhere: the batch draws one for a label carrying the meta.
		g.remove_meta(NamePlates.BOX_META)
	g.render_priority = label.render_priority
	holder.add_child(g)
	if swept:
		_plate_sweep.add(g)
	var crest := NetClient.crest_cache.texture_for(String(line.get("guild_name", "")))
	if crest != null:
		var s := Sprite3D.new()
		s.name = "GuildCrest"
		s.texture = crest
		s.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		s.fixed_size = true
		s.no_depth_test = true
		s.shaded = false
		s.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
		s.render_priority = g.render_priority
		s.layers = OverlayView.BIT
		g.add_child(s)
	# Round 844: the union's crest (+0x38), 36 px left of the guild text.
	var ucrest := NetClient.crest_cache.union_texture_for(String(line.get("guild_name", "")))
	if ucrest != null:
		var us := Sprite3D.new()
		us.name = "UnionCrest"
		us.texture = ucrest
		us.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		us.fixed_size = true
		us.no_depth_test = true
		us.shaded = false
		us.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
		us.render_priority = g.render_priority
		us.layers = OverlayView.BIT
		g.add_child(us)
	_layout_guild_line(label, holder)

## Puts the guild line GUILD_LINE_RAISE_PX above the name line, centred on the
## plate's point (the name block is centred there, _layout_job_decor).
func _layout_guild_line(label: Label3D, holder: Node3D) -> void:
	if label == null or holder == null:
		return
	var g := holder.get_node_or_null("GuildLine") as Label3D
	if g == null:
		return
	g.pixel_size = label.pixel_size
	g.offset = Vector2(0.0, label.offset.y + GUILD_LINE_RAISE_PX * _plate_fk(label))
	_fit_monster_name_box(g)
	_fit_guild_crest(g)

## Round 824: the guild's crest beside its line. READ (GlobalDataManager::
## FUN_009dea30, 0x9df370..0x9df4ad): with the crest cache entry's guild
## texture (+0x34) set, a 16 x 16 quad (0xe1b8e0 = 16.0) whose left edge is
## the guild text item's left less 20.0 (0xe1b830) and whose top is the item's
## top (both from FUN_008b2d30, the item's top-left; 0x9df390). The item is
## drawn centred on its point (FUN_008b4d90: x - w/2, y - h/2), w the text's
## width + 2 and h 14 (round 817: the box fills 1 px around the item). In the
## line's font pixels (y up): the item's left is -(text + 2)/2, its top 1 px
## under the box's (NamePlates.box_rect). The union's crest (+0x38, 36 px
## left) is OPEN: OpenSRO has no unions.
const GUILD_CREST_PX := 16.0
const GUILD_CREST_LEFT_PX := 20.0

func _fit_guild_crest(g: Label3D) -> void:
	# Round 844: the union's crest, the same quad 36 px left (0x9df4ad..
	# 0x9df5ea: 0xde3048 = 36.0 in place of 20.0).
	for pair in [["GuildCrest", GUILD_CREST_LEFT_PX], ["UnionCrest", UNION_CREST_LEFT_PX]]:
		_fit_crest_sprite(g, g.get_node_or_null(String(pair[0])) as Sprite3D, float(pair[1]))

## Round 844: UnionCrest's offset (READ: 0xde3048 = 36.0).
const UNION_CREST_LEFT_PX := 36.0

func _fit_crest_sprite(g: Label3D, s: Sprite3D, left_px: float) -> void:
	if s == null:
		return
	var fk := _plate_fk(g)
	var font: Font = g.font if g.font != null else ThemeDB.fallback_font
	var text_w := font.get_string_size(g.text, HORIZONTAL_ALIGNMENT_LEFT, -1, g.font_size).x
	var r := NamePlates.box_rect(g)
	var item_left := g.offset.x - text_w * 0.5 - 1.0 * fk
	var item_top := r.position.y + r.size.y * 0.5 - NamePlates.BOX_OVER_CELL_PX * fk
	var centre := Vector2(item_left - (left_px - GUILD_CREST_PX * 0.5) * fk,
		item_top - GUILD_CREST_PX * 0.5 * fk)
	# The 16 texels at 16 font pixels: the sprite's pixel is fk of the line's.
	s.pixel_size = g.pixel_size * fk
	s.offset = centre / fk
	s.visible = g.text != ""

## A guild's crest came, changed or went (CrestCache.changed): every line of
