## QA (round 800): OPENSRO_QA_JOB="<step>@<tick>;..." drives the job guild
## through the client's own paths: pick:<key> (a talk line by its service
## key, e.g. pick:job_join:1), yes (the open job confirm box's Yes),
## alias:<name> (the alias window's edit and Check), alias_ok (its OK),
## select_self, state (a log line: the job, the plate, the target window),
## close (the talk box shut, round 810).
var _qa_job_spec := OS.get_environment("OPENSRO_QA_JOB")

var _qa_job_talked := {}

func _qa_job_step() -> void:
	for step in _qa_job_spec.split(";", false):
		var at := step.split("@")
		if at.size() != 2:
			continue
		var what := at[0]
		# talk:<CODE>@<tick>: from that tick on, every tick until the server
		# has spawned the NPC, then its select (a click's).
		if what.begins_with("talk:"):
			if _qa_tick >= int(at[1]) and not _qa_job_talked.has(step):
				var holder := _qa_server_npc(what.substr(5))
				if holder != null:
					_qa_job_talked[step] = true
					print("QA JOB: tick %d talk %s" % [_qa_tick, what.substr(5)])
					_open_talk(holder)
			continue
		if int(at[1]) != _qa_tick:
			continue
		if what.begins_with("pick:"):
			var key := what.substr(5)
			print("QA JOB: tick %d pick %s" % [_qa_tick, key])
			_on_npc_service_selected(key)
		elif what == "close":
			# Round 810: the talk box shut, so a later frame shows the world.
			print("QA JOB: tick %d close the talk box" % _qa_tick)
			_hud_panels.close("npctalk")
		elif what == "yes":
			var box: JobConfirmBox = null
			for c in _hud_panels.get_children():
				if c is JobConfirmBox and not c.is_queued_for_deletion():
					box = c
			print("QA JOB: tick %d yes on %s" % [_qa_tick, str(box)])
			if box != null:
				box.confirmed.emit()
				box.close()
		elif what.begins_with("alias:"):
			var b := _job_flow.alias_box if _job_flow != null else null
			if b != null and is_instance_valid(b):
				var e := b.node(JobAliasBox.EDIT) as LineEdit
				if e != null:
					e.text = what.substr(6)
					e.text_changed.emit(e.text)
				b.press_check()
			print("QA JOB: tick %d alias %s (window %s)" % [_qa_tick, what.substr(6), str(b)])
		elif what == "alias_ok":
			var b2 := _job_flow.alias_box if _job_flow != null else null
			if b2 != null and is_instance_valid(b2):
				b2.press_ok()
			print("QA JOB: tick %d alias OK" % _qa_tick)
		elif what == "select_self":
			_select_self()
		# Round 802, job PvP (QA only): pvp:<name> clicks the player drawn
		# under that name twice (the select, then the attack -- or Alt's
		# rules: JobPvpNet.player_click), printing each click's path and his
		# plate's colour; pvp_state prints the fight's state.
		elif what.begins_with("pvp:"):
			var who := what.substr(4)
			var found := -1
			for oid in _other_bodies:
				var ob = _other_bodies[oid]
				if ob != null and is_instance_valid(ob) and String((ob as Node).get_meta("character_name", "")) == who:
					found = int(oid)
			if found < 0:
				print("QA PVP: tick %d %s is not drawn" % [_qa_tick, who])
			else:
				var plate := (_other_bodies[found] as Node3D).get_node_or_null("Name") as Label3D
				print("QA PVP: tick %d %s (id %d, job %d) plate '%s' colour %s, own job %d, enemy %s" % [_qa_tick, who, found,
					_their_job_state(found), plate.text if plate != null else "-", plate.modulate.to_html() if plate != null else "-",
					_own_job_state(), str(_player_is_enemy(found, false))])
				print("QA PVP: click 1 -> %s" % _click_player(found, who))
				print("QA PVP: click 2 -> %s" % _click_player(found, who))
		# Round 804 (QA only): walk:<x>,<z> walks to that world point, as a
		# ground click there would.
		elif what.begins_with("walk:"):
			var xz := what.substr(5).split(",")
			if xz.size() == 2:
				_move_target = Vector3(float(xz[0]), player.position.y, float(xz[1]))
				_has_move_target = true
				print("QA JOB: tick %d walk to (%s, %s) from (%.0f, %.0f)" % [_qa_tick, xz[0], xz[1], player.position.x, player.position.z])
		# Round 832 (QA only): the trace and the target menu. select:<name> selects that player
		# as a click does; rclick:<name> right-clicks his drawn body (press
		# and release at its screen point); menu:<id> presses a target menu
		# button; click_walk:<dx>,<dz> is a ground click that far from the
		# player (its cancel
		# included); trace_state logs the trace; ping_fps:<0|1> the counter.
		elif what.begins_with("select:") or what.begins_with("rclick:"):
			var who := what.substr(what.find(":") + 1)
			var found := -1
			for oid in _other_bodies:
				var ob = _other_bodies[oid]
				if ob != null and is_instance_valid(ob) and String((ob as Node).get_meta("character_name", "")) == who:
					found = int(oid)
			if found < 0:
				print("QA TRACE: tick %d %s is not drawn" % [_qa_tick, who])
			elif what.begins_with("select:"):
				_select_character(found, who)
			else:
				var at3 := (_other_bodies[found] as Node3D).global_position + Vector3(0, 8, 0)
				var at2 := camera_3d.unproject_position(at3)
				_target_menu_right_button(true, at2)
				_target_menu_right_button(false, at2)
				print("QA TRACE: tick %d right click on %s at %s -> menu %s" % [_qa_tick, who, str(at2.round()),
					"open" if _target_menu != null and _target_menu.visible else "not open"])
		elif what.begins_with("menu:"):
			if _target_menu != null and _target_menu.visible and _target_menu.button(int(what.substr(5))) != null:
				_target_menu.button(int(what.substr(5))).pressed.emit()
			print("QA TRACE: tick %d menu button %s" % [_qa_tick, what.substr(5)])
		elif what.begins_with("click_walk:"):
			var cxz := what.substr(11).split(",")
			if cxz.size() == 2:
				_cancel_action_for_click()
				print("QA TRACE: tick %d ground click (%s, %s) -> %s" % [_qa_tick, cxz[0], cxz[1],
					_issue_walk(_walkable_point(player.global_position + Vector3(float(cxz[0]), 0.0, float(cxz[1]))))])
		elif what == "trace_state":
			var tb = _other_bodies.get(int(_trace.get("target", -1)))
			print("QA TRACE: tick %d depth %d trace %s dist %s walk mode %s moving %s" % [_qa_tick, _action_depth, str(_trace),
				"%.1f" % player.global_position.distance_to((tb as Node3D).global_position) if tb != null and is_instance_valid(tb) else "-",
				str(_walk_mode), str(_has_move_target)])
		elif what == "option":
			_hud_panels.toggle_option()
			print("QA TRACE: tick %d option window toggled" % _qa_tick)
		elif what.begins_with("option_tab:"):
			var ow := _hud_panels.option_window() if _hud_panels != null else null
			var tab := ow.control([int(what.substr(11))]) as BaseButton if ow != null else null
			if tab != null:
				tab.pressed.emit()
			print("QA TRACE: tick %d option tab %s (%s)" % [_qa_tick, what.substr(11), "pressed" if tab != null else "missing"])
		elif what.begins_with("key_row:"):
			# Round 833 (QA only): a press on the Key Map tab's visible slot n.
			var kow := _hud_panels.option_window() if _hud_panels != null else null
			if kow != null and kow.keymap_page != null:
				kow.keymap_page.select_row(kow.keymap_page.row_at_slot(int(what.substr(8))))
			print("QA TRACE: tick %d key row %s" % [_qa_tick, what.substr(8)])
		# Round 834 (QA only): the exchange and friends. xreq:<name> asks that
		# player to exchange; xans:<0|1> answers the request box; xoffer:<bag
		# index> offers it through the item box's OK; xgold:<n> through the
		# gold box's; xbtn clicks Confirm / Approve (a real click, so a
		# disabled button refuses it); xcancel the Cancel;
		# xstate prints the exchange; fask:<name> asks to be friends;
		# fans:<0|1> answers the friend box; panel:<id> opens a panel;
		# fstate prints the friend list.
		elif what.begins_with("xreq:") or what.begins_with("fask:"):
			var who := what.substr(5)
			var found := -1
			for oid in _other_bodies:
				var ob = _other_bodies[oid]
				if ob != null and is_instance_valid(ob) and String((ob as Node).get_meta("character_name", "")) == who:
					found = int(oid)
			if what.begins_with("xreq:") and _hud_panels != null and _hud_panels.exchange_mode():
				print("QA SOCIAL: tick %d exchange request skipped: already exchanging" % _qa_tick)
			elif what.begins_with("xreq:") and found < 0:
				print("QA SOCIAL: tick %d exchange request skipped: %s not in view" % [_qa_tick, who])
			elif what.begins_with("xreq:"):
				print("QA SOCIAL: tick %d exchange request to %s (%d) -> %s" % [_qa_tick, who, found, exchange_request(found)])
			else:
				friend_ask(who)
				print("QA SOCIAL: tick %d friend ask %s" % [_qa_tick, who])
		elif what.begins_with("xans:c"):
			# Round 841: a real click on the request box's Accept (1) or
			# Refuse (0).
			var xcb = _hud_panels.exchange_request_box()
			var xcbtn: Control = null
			if xcb != null:
				xcbtn = xcb.node("GDR_MBIN_BTN_OK" if what.substr(6) == "1" else "GDR_MBIN_BTN_CANCEL") as Control
			if xcbtn == null or not xcbtn.is_visible_in_tree():
				print("QA SOCIAL: tick %d exchange box click: no box" % _qa_tick)
			else:
				print("QA SOCIAL: tick %d exchange box clicked %s at %s" % [_qa_tick, what.substr(6), str(xcbtn.get_global_rect().get_center())])
				_qa_push_click(xcbtn.get_global_rect().get_center(), MOUSE_BUTTON_LEFT, true)
		elif what == "xbust":
			# Round 841: each bust's clip, its clock and a bone of its pose.
			for own in [false, true]:
				var bp: PlayerPortrait = _hud_panels.exchange_portrait(own)
				var bk: Skeleton3D = bp.character() if bp != null else null
				var bc: BanReader.ParsedAnimation = bp.clip() if bp != null else null
				if bk == null or not is_instance_valid(bk):
					print("QA BUST: tick %d %s none" % [_qa_tick, "own" if own else "partner"])
					continue
				var spine := bk.find_bone("Bip01 Spine1")
				var head := bk.find_bone("Bip01 Head")
				var bv: TextureRect = _hud_panels.exchange_portrait_view(own)
				print("QA BUST: tick %d %s clip %s %d ms cyclic %s at %.1f ms (frames %d) spine1 %s head %s view %s" % [_qa_tick,
					"own" if own else "partner", bc.animation_name if bc != null else "-", bc.duration_ms if bc != null else 0,
					str(bc.cyclic) if bc != null else "-", bp.clip_ms, bp.clip_frames,
					str(bk.get_bone_pose_rotation(spine)) if spine >= 0 else "-",
					str(bk.get_bone_global_pose(head).origin) if head >= 0 else "-",
					str(bv.get_global_rect()) if bv != null else "-"])
			var fv := _hud_player_info.portrait_view() if _hud_player_info != null else null
			print("QA BUST: tick %d player block face view %s" % [_qa_tick, str(fv.get_global_rect()) if fv != null else "-"])
		elif what.begins_with("xans:"):
			var xb = _hud_panels.exchange_request_box()
			print("QA SOCIAL: tick %d exchange box %s answered %s" % [_qa_tick, str(xb), what.substr(5)])
			if xb != null:
				if what.substr(5) == "1":
					xb.press_ok()
				else:
					xb.press_cancel()
		elif what.begins_with("fans:"):
			var fb = _hud_panels.friend_request_box()
			print("QA SOCIAL: tick %d friend box %s answered %s" % [_qa_tick, str(fb), what.substr(5)])
			if fb != null:
				if what.substr(5) == "1":
					fb.press_ok()
				else:
					fb.press_cancel()
		elif what.begins_with("xoffer:"):
			var arg := what.substr(7)
			var by_item := arg.begins_with("i")
			var slot := -1 if by_item else int(arg)
			var item := -1
			var qty := 1
			for e in _hud_panels._bag_slots:
				var es = _hud_panels._first_field(e, ["slot", "slot_index", "index"])
