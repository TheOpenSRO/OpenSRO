var _qa_mix_log := OS.get_environment("OPENSRO_QA_MIX_LOG") != ""

func _qa_mix_report() -> void:
	var parts := PackedStringArray()
	for l in _player_mixer.loops + _player_mixer.shots:
		var ly := l as ClipMixer.Layer
		parts.append("%s %s w=%.2f t=%.0f%s" % ["once" if ly.once else "loop", ly.clip.animation_name.get_file(), ly.w, ly.t,
			" stopping" if ly.stopping else ""])
	print("QA MIX tick %d: %s" % [_qa_tick, " | ".join(parts)])

## Round 808: the idle fidget (READ: the character tick 0x9d1ef8..0x9d1f4e and
## state 7, 0xa59460). A countdown of 15 s runs only while the body stands
## idle -- not moving, sitting, acting or in the battle stance -- and starts
## over at anything else; at 0 it picks one of the types 122, 61 and 81 at
## random (a missing one tries 122, and with no 122 either nothing plays),
## plays it once fading in over 400 ms, and re-arms at 10 + rand % 5 s. A
## player body has only 61 (MEASURED, round 808: none of the 56 has 81 or
## 122), so one draw in three plays it. A move leaves it (state 9 clears bit 7,
## 0x21a0), as does its end (a 200 ms stop, 0xa59560).
## OURS: a rider does not fidget (its group is "cart", and the standing clip
## the lookup would fall back to is not a rider's).
const FIDGET_FIRST_MS := 15000.0
const FIDGET_AGAIN_MS := 10000.0
const FIDGET_SPREAD_MS := 5000
const FIDGET_TYPES := [0x7a, 61, 81]
var _fidget_ms := FIDGET_FIRST_MS
var _player_fidget_clip: BanReader.ParsedAnimation = null
var _fidget_rng := RandomNumberGenerator.new()

func _step_player_fidget(moving: bool, action: int, dt_ms: float) -> void:
	if _player_fidget_clip != null and _player_one_shot == _player_fidget_clip and (moving or _sit.sitting or _player_dead):
		_player_one_shot = null
	if _player_one_shot != _player_fidget_clip:
		_player_fidget_clip = null
	var idle := not moving and not _sit.sitting and not _player_dead and _player_one_shot == null \
		and action == BsrReader.AnimationEntry.TYPE_STAND and not _riders.has(_own_id())
	if not idle:
		_fidget_ms = FIDGET_FIRST_MS
		return
	_fidget_ms -= dt_ms
	if _fidget_ms > 0.0:
		return
	_fidget_ms = FIDGET_AGAIN_MS + float(_fidget_rng.randi() % FIDGET_SPREAD_MS)
	var pick: int = FIDGET_TYPES[_fidget_rng.randi() % FIDGET_TYPES.size()]
	var clip := _body_animation_for(_player_body, pick, _player_anim_group())
	if clip == null and pick != 0x7a:
		clip = _body_animation_for(_player_body, 0x7a, _player_anim_group())
	if clip == null:
		return
	if _play_player_once(clip, ClipMixer.FIDGET_MS, ClipMixer.STOP_MS) > 0.0:
		_player_fidget_clip = clip
		print("FIDGET: the player plays type %d (%s)" % [pick, clip.animation_name])

## Round 748: other players standing on their target with their gait at
## rest (id -> true), whom _step_other_bodies passes over.
var _other_settled := {}

## Round 739 (B1): one rendered frame of the others' walk, covering `steps`
## physics steps of `delta` seconds in all (OtherCrowd.lerp_factor: the
## per-step lerp folded, so one step a frame is exactly the old pass, and the
## gait tests the distance the old last step saw), then their turns. Called
## from _process, after the frame's physics.
func _step_other_bodies(delta: float, steps: int) -> void:
	# Round 749: the bodies on a leg (0xB021) walk it; the rest ease toward
	# their last position as before (an older server's OpEntityMoved stream).
	_step_other_legs(delta)
	var n := maxi(steps, 1)
	var step_delta := delta / float(n)
	var f := OtherCrowd.lerp_factor(OTHER_BODY_INTERPOLATION_SPEED, step_delta, n)
	# The gait test's fold, once a frame (round 748): distance_before_last is
	# the distance times this factor (exactly 1 at one step a frame).
	var before_last := OtherCrowd.distance_before_last(1.0, OTHER_BODY_INTERPOLATION_SPEED, step_delta, n)
	# Round 757: only the awake bodies (_other_awake): every target write and
	# every cleared settled mark wakes a body, and it sleeps again once it is
	# settled on its target -- a standing crowd costs nothing here. MEASURED at
	# 7,000 standing: the pass over every target was 5.8 ms a frame. A body
	# moved off its target by a path that wrote neither is woken by the spread
	# re-check (_other_wake_scan).
	_other_wake_scan()
	for character_id in _other_awake.keys():
		var body = _other_bodies.get(character_id)
		if body == null or _other_legs.has(character_id) or not _other_body_targets.has(character_id):
			_other_awake.erase(character_id)
			continue
		# A skill slide moves it (round 785's client review, finding 1); its
		# arrival wakes it again.
		if not _skill_slides.is_empty() and _skill_slides.has((body as Node3D).get_instance_id()):
			_other_awake.erase(character_id)
			continue
		var target: Vector3 = _other_body_targets[character_id]
		var at: Vector3 = (body as Node3D).position
		# Round 748: on its target and already standing (settled below): the
		# frame has nothing to do for it. A move, a placement or a gait set
		# elsewhere moves it off the target or clears the mark.
		if at == target and _other_settled.has(character_id):
			_other_awake.erase(character_id)
			continue
		if at.distance_squared_to(target) < OtherCrowd.SNAP_DISTANCE_SQ:
			# On it, or an ulp or two short (its review's F6): put on it once,
			# then never written again while the target stays.
			if at != target:
				(body as Node3D).position = target
				_other_moved(body)
			_set_other_gait(character_id, false)
			_other_settled[character_id] = true
			_other_awake.erase(character_id)
			continue
		_other_settled.erase(character_id)
		_other_awake[character_id] = true
		# Still catching up to the last update means the player is on the
		# move; arrived means standing. The threshold is a fraction of the
		# body's own height, so a settled body does not flicker between the
		# two on the last inch of the lerp.
		_set_other_gait(character_id, at.distance_to(target) * before_last > OTHER_GAIT_THRESHOLD)
		(body as Node3D).position = at.lerp(target, f)
		# A far body's transform is re-read at the frame's flush (round 747).
		_other_moved(body)
	_step_remote_turns(delta)

## Round 757: the bodies the eased walk looks at this frame (id -> true).
var _other_awake := {}
var _other_wake_keys: Array = []
var _other_wake_at := 0
const OTHER_WAKE_SCAN_FRAMES := 30

## A share of every body a frame (all of them once in OTHER_WAKE_SCAN_FRAMES):
## one off its target or not settled is woken.
func _other_wake_scan() -> void:
	if _other_wake_at >= _other_wake_keys.size():
		_other_wake_keys = _other_body_targets.keys()
		_other_wake_at = 0
	var per := ceili(float(_other_wake_keys.size()) / float(OTHER_WAKE_SCAN_FRAMES))
	var end := mini(_other_wake_at + per, _other_wake_keys.size())
	while _other_wake_at < end:
		var id = _other_wake_keys[_other_wake_at]
		_other_wake_at += 1
		if _other_awake.has(id) or _other_legs.has(id):
			continue
		var body = _other_bodies.get(id)
		if body == null or not is_instance_valid(body) or not _other_body_targets.has(id):
			continue
		if not _skill_slides.is_empty() and _skill_slides.has((body as Node3D).get_instance_id()):
			continue
		if not _other_settled.has(id) or (body as Node3D).position != _other_body_targets[id]:
			_other_awake[id] = true

## One frame of every turn in progress: FUN_009e02f0 with the frame's time
## (the mover's tick, FUN_009e0e60 -> FUN_009e0c10). A turn that reaches its
## target ends there; a body that has gone is dropped.
func _step_remote_turns(delta: float) -> void:
	if _remote_turns.is_empty():
		return
	for id in _remote_turns.keys():
		var body := instance_from_id(id) as Node3D
		if body == null or not is_instance_valid(body):
			_remote_turns.erase(id)
			continue
		var turn: Dictionary = _remote_turns[id]
		var front := float(turn["front"])
		var r := RemoteFacing.turn(RemoteFacing.heading_of_yaw(body.rotation.y, front), float(turn["target"]), delta * 1000.0)
		body.rotation.y = RemoteFacing.yaw_of(float(r["heading"]), front)
		_other_moved(body)
		if not bool(r["turning"]):
			_remote_turns.erase(id)

## `heading` (round 637's review follow-up) is OpEntityEntered's: the body is
## placed facing it -- FUN_009d17e0 stores the spawn's angle with a bare
## FUN_009c4260, no turn -- and a turn left from before ends (a spawn is a new
## object, whose mover starts with none: 0x9e0cd0 zeroes +0xa4). NAN (a list,
## an older server) leaves the facing as it is. A snapshot is a placement, not
## a walk, so it never aims the body.
##
## `body` and `scale` (round 689) are the character's own model -- a Figure's
## code name (_body_key_for of the snapshot's RefObjID, or of its gender from
## an older server) and its scale byte -- drawn as the local player's is.
##
## `pluses` (round 734, the hook for the plus of others' gear) is slot -> the
## plus byte retail carries per item (0x3038's OptLevel; the spawn's, OPEN
## 3): their weapon and shield glow at it (EquipGlow). null leaves what the
## body has; given for a body already drawn, the glow is redrawn on it
## (CharacterAppearance.reglow) without rebuilding the body.
func _spawn_or_update_other(character_id: int, char_name: String, pos: Vector3, equipped: Dictionary = {}, body: String = "", heading: float = NAN, scale: int = CharacterAppearance.DEFAULT_SCALE, pluses = null) -> void:
	# Round 762: one whose departure still waits in the queue left first.
	if _depart_pending.has(character_id):
		_depart_pending.erase(character_id)
		_on_entity_left_now(character_id)
	var sp0 := Time.get_ticks_usec() if FrameSplit.on else 0
	# Round 847: what they look like (CharacterLook): the spawn's worn items,
	# pluses and body; a model switcher's own ids from the 0x3038s since.
	var look := _other_look(character_id)
	look.spawned(equipped, pluses, scale, body, not _other_bodies.has(character_id))
	if pluses is Dictionary:
		_forget_other_kind(character_id)
		_reglow_other(character_id, pluses)
	if _other_bodies.has(character_id):
		# Sets the real interpolation *target* only -- see
		# _other_body_targets' own doc comment for why this replaced a
		# direct position snap.
		_other_body_targets[character_id] = pos
		_other_awake[character_id] = true
		# Still waiting to be dressed: dressed in what this spawn names
		# (round 739's review, F8; a drawn body is not redressed by it).
		if _other_build_args.has(character_id) and not equipped.is_empty():
			_other_build_args[character_id].erase("kind")
			_reghost_later(character_id)
		if not is_nan(heading):
			var drawn: Node3D = _other_bodies[character_id]
			drawn.rotation.y = RemoteFacing.yaw_of(heading, 0.0)
			_other_moved(drawn)
			_remote_turns.erase(drawn.get_instance_id())
		return

	var sp1 := Time.get_ticks_usec() if FrameSplit.on else 0
	var node := Node3D.new()
	node.position = pos
	if not is_nan(heading):
		node.rotation.y = RemoteFacing.yaw_of(heading, 0.0)
	node.set_meta("character_id", character_id)
	node.set_meta("character_name", char_name)
	# Its body key, for the target window's race emblem (round 638; its own
	# model since round 689).
	node.set_meta("body", body)
	other_entities.add_child(node)
	var sp2 := Time.get_ticks_usec() if FrameSplit.on else 0
	_other_bodies[character_id] = node
	# Round 839: a stalling owner's booth and title from the start (the
	# dressing places the title again over the built body).
	_stall_refresh.call_deferred(character_id)
	# Round 771: made while V is held, it starts hidden (not one frame shown).
	if _objects_hidden and KeyMap.hides_under_v("other_player"):
		node.visible = false
	_other_body_targets[character_id] = pos
	_other_awake[character_id] = true
	_other_uids.add(character_id)
	# Round 739 (B4, OtherCrowd.BuildQueue, OURS): the node is theirs from now
	# -- moves, the departure and equipment changes act on it -- and it is
	# dressed (_dress_other) over the next frames, nearest the player first,
	# with what they wear and do by then. A frame with budget left dresses it
	# at once, as before.
	_other_build_args[character_id] = {}
	_other_builds.queue(character_id)
	# Round 756: drawn at once as a ghost when its kind's templates are made.
	if _ghosts_on and CrowdGpu.enabled:
		_other_ghosts.queue(character_id)
		_ghost_queued_ms[character_id] = Time.get_ticks_msec()
		# Round 762: a group spawn's page (inside its bracket) is held and
		# shown whole; a single arrival (0x3015) fades in as it is made, as
		# retail's single spawn does.
		if _other_build_defer > 0 and _holds_on:
			_page_wait[character_id] = _arrival_page()
	if FrameSplit.on:
		# QA (round 762): an arrival's own cost -- its books and pluses, the
		# holder made and put in the tree, the queues.
		var sp3 := Time.get_ticks_usec()
		FrameSplit.add("sp_pre", sp1 - sp0)
		FrameSplit.add("sp_node", sp2 - sp1)
		FrameSplit.add("sp_post", sp3 - sp2)
	if _other_build_defer == 0:
		_pump_other_builds()

## Round 739 (B4): the frame's share of the arrived bodies to dress, nearest
## the player first (OtherCrowd.BuildQueue). Logs the queue's totals as it
## drains.
func _pump_other_builds() -> int:
	# Round 762: templates adopted every frame (a prewarm's too), and a held
	# page or its plates still to come keep the pump going with nothing to dress.
	if _appearance != null and _appearance.awaiting():
		var ta := Time.get_ticks_usec()
		if _appearance.poll_prepared() > 0 and FrameSplit.on:
			FrameSplit.add("tmpl_adopted", 1)
		if FrameSplit.on:
			FrameSplit.add("tmpl_adopt", Time.get_ticks_usec() - ta)
	if _other_builds.is_empty() and _other_ghosts.is_empty() and _pages.is_empty() and _activate_at >= _activate_ids.size():
		return 0
	var from := Vector3.ZERO
	if player != null and other_entities != null and player.is_inside_tree() and other_entities.is_inside_tree():
		from = other_entities.to_local(player.global_position)
	# Round 748: a body whose templates are still being made off the main
	# thread waits in the queue (_other_template_ready) and the next nearest
	# ready one is dressed.
	if _appearance != null:
		# Something adopted since the last pump: every waiting body may be
		# ready now, even in a frame whose pump already went through them.
		if _appearance.prep_generation != _other_prep_seen:
			_other_prep_seen = _appearance.prep_generation
			_other_builds.reopen()
	# Round 756: every arrived body whose kind is ready drawn now (ghosts),
	# then the dressing: background work once every waiting body is drawn.
	var frame := Engine.get_process_frames()
	if not _other_ghosts.is_empty():
		if _appearance != null and _appearance.prep_generation != _ghost_prep_seen:
			_ghost_prep_seen = _appearance.prep_generation
			_other_ghosts.reopen()
		var gt := Time.get_ticks_usec()
		if _crowd_gpu != null and _crowd_gpu.clip_generation != _ghost_clip_seen:
			_ghost_clip_seen = _crowd_gpu.clip_generation
			_other_ghosts.reopen()
		# Round 762: a queue resting on its last pass is looked at again now
		# and then whatever happened (a missed wake-up costs a second, not the
		# crowd).
		if frame % 60 == 0:
			_other_ghosts.reopen()
		if FrameSplit.on and frame % 600 == 0 and _appearance != null:
			_qa_ghost_diag()
		# Round 762: what the frame's crowd budget leaves (one ghost at least).
		_other_ghosts.cap_usec = maxi(OtherCrowd.FrameBudget.left(), 0)
		var made_g := _other_ghosts.pump(frame, from, _other_bodies, _ghost_other, _ghost_ready)
		if FrameSplit.on and Time.get_ticks_usec() - gt > 30000:
			print("QA GHOSTS slow pump: %d made in %.1f ms (%s)" % [made_g, (Time.get_ticks_usec() - gt) / 1000.0,
				str(_crowd_gpu.stats.get("ghosts", 0)) if _crowd_gpu != null else "-"])
		if _other_ghosts.is_empty() and _other_ghosts.started_usec >= 0 and _other_ghosts.built > 1:
			print("World3D: %d ghost(s) drawn over %d frame(s) in %.0f ms, longest frame %.1f ms" % [_other_ghosts.built,
				_other_ghosts.frames, (Time.get_ticks_usec() - _other_ghosts.started_usec) / 1000.0, _other_ghosts.longest_usec / 1000.0])
			_other_ghosts.started_usec = -1
		OtherCrowd.FrameBudget.spend(Time.get_ticks_usec() - gt)
		if FrameSplit.on:
			FrameSplit.add("ghosts", Time.get_ticks_usec() - gt)
	_retry_ghost_gaits()
	_hold_step()
	# A body that cannot be a ghost (refused) is the only one the dressing
	# makes visible; while none waits, the dressing is background work.
	# (Round 757's merge: the QA hitch override, OPENSRO_QA_OTHER_BUILD_HITCH_MS,
	# applies to both, so a measured boot dresses in minutes.)
	var background := _ghost_refused.is_empty() and _ghosts_on and CrowdGpu.enabled and not _other_builds.hitch_qa
	_other_builds.target_usec = OtherCrowd.GHOST_HITCH_TARGET_USEC if background else _other_builds.hitch_usec
	# Round 762: the background dressing (every waiting body drawn) takes only
	# a frame with room for a body under the frames the crowd itself makes
	# (_dress_room): a dressing is 6-30 ms of the swarm's kits (MEASURED
	# r762.md), so it never makes a frame worse than standing in the crowd.
	_other_builds.cap_usec = OtherCrowd.GHOST_DRESS_BUDGET_USEC if background else (1 << 30)
	# Round 762: while a page arrives (ghosts still to make, or held) the
	# dressing takes only what cannot be a ghost (refused) or is wanted now
	# (urgent): a body dressed meanwhile would show before its page.
	var arriving := _ghosts_on and CrowdGpu.enabled and _holds_on and (not _other_ghosts.is_empty() or _pages_holding())
	var made := 0
	# While a page arrives with no ghost yet and nothing refused or urgent,
	# nothing can be dressed: no pass over the queue.
	if not arriving or not _ghost_refused.is_empty() or not _other_builds.urgent.is_empty():
		var room := _dress_room() if background else -1
		var pt := Time.get_ticks_usec()
		made = _other_builds.pump(frame, from, _other_bodies, _dress_other,
			_dress_ready if arriving else (_other_template_ready if _other_async_templates else Callable()), _ghost_ids, _dress_within_sq,
			room)
		if made > 0 and background:
			_dress_last_frame = frame
			# Round 762's review, F1: the whole pass a background dressing
			# takes (its sort of the queue too), the room the next one needs:
			# up at once to a longer one, down slowly.
			var cost := float(Time.get_ticks_usec() - pt)
			_dress_avg_usec = cost if cost > _dress_avg_usec else lerpf(_dress_avg_usec, cost, 0.05)
	if _other_builds.is_empty() and _other_builds.started_usec >= 0 and _other_builds.built > 1:
		var spent: Array = _other_builds.spent_summary()
		print("World3D: %d other player bod(ies) dressed over %d frame(s) in %.0f ms, longest frame %.1f ms, p50 %.1f, p95 %.1f, %d over 100 ms (budget %.1f ms)" % [
			_other_builds.built, _other_builds.frames, (Time.get_ticks_usec() - _other_builds.started_usec) / 1000.0,
			_other_builds.longest_usec / 1000.0, float(spent[0]), float(spent[1]), int(spent[2]), _other_builds.budget_usec / 1000.0])
		_other_builds.started_usec = -1
	return made

## QA (round 762): why arrived bodies wait to be ghosts -- the queue, and the
## template requests' state.
func _qa_ghost_diag() -> void:
	var ready := 0
	var waiting := 0
	var unknown := 0
	var sample := ""
	for id in _other_ghosts.ids().slice(0, 400):
		var args = _other_build_args.get(id)
		var kind := String((args as Dictionary).get("kind", "")) if args != null else ""
		var st := _appearance.kind_state(kind) if kind != "" else -1
		if st == 1:
			ready += 1
		elif st == 0:
			waiting += 1
			if sample == "":
				sample = _appearance.kind_debug(kind)
		else:
			unknown += 1
	print("QA GHOSTS waiting: queue %d (of 400 looked at: ready %d, waiting %d, unknown %d); appearance %s; first waiting kind %s" % [
		_other_ghosts.size(), ready, waiting, unknown, _appearance.prep_debug(), sample])

## Round 762's review, F1 (OURS): a background dressing's whole pass (its
## sort of the queue and the body: up at once to a longer one, down slowly;
## usec), and the last frame's main-thread work without the dressing (its
## wall time less the wait between frames: OtherCrowd.FrameMark). Round 762
## judged the room against the steady frames' p95 less the last frame's wall
## time, which left none (the review).
var _dress_avg_usec := 9000.0
var _frame_work_usec := 0.0

func _note_steady_frame(usec: int) -> void:
	_frame_work_usec = maxf(float(usec - OtherCrowd.FrameMark.wait_usec), 0.0)

## The background dressing's room this frame (round 762, OURS): none while a
## crowd arrives or leaves -- its work has the frame's crowd budget
## (OtherCrowd.FrameBudget), and a dressing (3-34 ms of the swarm's kits,
## MEASURED r762.md) cannot be split to fit beside it -- one body every
## DRESS_EVERY frames at most, and otherwise:
## - room for a dressing as long as the longest seen (_dress_avg_usec: up at
##   once, down slowly) under an absolute frame: the larger of the crowd
##   budget's aim (the steady frames' p90) and a 60 fps frame
##   (DRESS_FRAME_USEC), less the last frame's WORK -- its wall time less the
##   wait between frames (OtherCrowd.FrameMark), so a vsync wait is room;
## - or, whatever the room, one body every DRESS_MIN_EVERY frames: the
##   guaranteed rate (one frame in 600, about 10 s at 60 fps: the steady p95
##   does not move; MEASURED at 4,000 ghosts, a background dressing's frame is
##   18-23 ms against a 16 ms p95).
## Round 762's review, F1: the first rule (the crowd's p95 less the last
## frame's wall time) never left room -- with vsync every frame is 16.7 ms,
## without it a steady scene's p95 is a fraction of a millisecond over its
## frame -- and the background dressing never ran. A ghost's weapon particles
## no longer wait for it (_ghost_fx); what it still gives is the posed near
## body. A trickle tried first in round 762 (one every 30 frames whatever the
## room, during a crowd's transition too) made 30-34 ms frames in the live
## walk-out; a transition still takes none.
const DRESS_EVERY := 30
const DRESS_MIN_EVERY := 600
const DRESS_FRAME_USEC := 16700.0
var _dress_last_frame := -DRESS_MIN_EVERY
## Round 764 (OURS; r764.md section 3): idle ghosts are not dressed in the
## background. A ghost draws the dressed body's pixels (round 756's parity) and,
## since this round, every weapon particle within its budget (EquipFxBatch), so
## a background dressing changed nothing seen -- but a dressed body costs the
## render thread every frame after: on a fast machine the room rule above (a
## 60 fps frame less the work) dressed one every 30 frames for minutes
## (v0.1.515's log: 1,573 dressings), and on the box a step with room dressed
## enough to add 1,330 draws and 2 ms to the in-crowd frame (MEASURED). What
## needs a body dressed -- a hit, a cast, an aura, sitting, a buff at
## arrival -- still promotes it (urgent). OPENSRO_QA_DRESS_IDLE=1: as round 762.
var _dress_idle := OS.get_environment("OPENSRO_QA_DRESS_IDLE") == "1"
func _dress_room() -> int:
	if not _dress_idle:
		return 0
	if _crowd_transition():
		return 0
	var f := Engine.get_process_frames()
	var since := f - _dress_last_frame
	if since < DRESS_EVERY:
		return 0
	var room := maxf(float(OtherCrowd.FrameBudget.aim_usec()), DRESS_FRAME_USEC) - _frame_work_usec
	if room >= _dress_avg_usec:
		return int(room)
	return 1 if since >= DRESS_MIN_EVERY else 0

## QA (round 762): the crowd budget for QaLineup's and QaCrowdProbe's
## hand-overs (as NetClient reads a group), through the world so the same QA
## scripts run on a tree without OtherCrowd.FrameBudget (the "before" boots).
func qa_group_step_usec(cap_usec: int) -> int:
	return mini(cap_usec, OtherCrowd.FrameBudget.group_step_usec())

func qa_budget_spend(usec: int) -> void:
	OtherCrowd.FrameBudget.spend(usec)

func qa_budget_cols() -> Array:
	return [OtherCrowd.FrameBudget.aim_usec() / 1000.0, OtherCrowd.FrameBudget.last_own / 1000.0, OtherCrowd.FrameBudget.last_spent / 1000.0]

## Round 762: whether a crowd is arriving or leaving: a group still being
## read, ghosts still to make, a page held or its plates still to show, many
## bodies fading (a page's fade-in, a crowd's fade-out), departures queued or
## holders waiting to be freed. A live crowd's few single arrivals and leaves
## a second (a ghost or two queued, a few fading) do not count.
const TRANSITION_FEW := 16
func _crowd_transition() -> bool:
	if _pages_holding() or _activate_at < _activate_ids.size() or _depart_ids_at < _depart_ids.size():
		return true
	if NetClient.group_reading() or _other_ghosts.size() > TRANSITION_FEW:
		return true
	if _depart_free_left() > TRANSITION_FEW:
		return true
	return _crowd_gpu != null and _crowd_gpu.fading_count() > TRANSITION_FEW * 4

## Round 762: the dressing's `ready` while a page arrives.
func _dress_ready(character_id: int) -> bool:
	# A refused body or an urgent one: not one still to be made a ghost (it
	# would show before its page), nor a ghost (the dressing is background
	# work, after the page; MEASURED live: dressing during a walk-in's hold
	# made its frames longer).
	if not _ghost_refused.has(character_id) and not _other_builds.urgent.has(character_id):
		return false
	return not _other_async_templates or _other_template_ready(character_id)

## Round 748 (OURS): whether an arrived body's templates are made, so its
## dressing assembles nothing on the main thread (CharacterAppearance.prepare:
## the body and item templates on a WorkerThreadPool task, the glow's particle
## files on EfpEffect's preload). A body whose kind is not ready waits in the
## queue; asking starts the work. The answer is kept per kind (body, worn
## items, pluses) and asked again only after the appearance adopts something
## (prep_generation). A body this cannot resolve answers true and is dressed
## the old way. OPENSRO_QA_SYNC_TEMPLATES=1 dresses everything as before.
var _other_async_templates := OS.get_environment("OPENSRO_QA_SYNC_TEMPLATES") == ""
## (Round 762: a kind's readiness is CharacterAppearance.kind_ready's.)
var _other_prep_seen := 0
var _ghost_prep_seen := 0
var _ghost_clip_seen := 0
## kind key -> the CrowdGpu.clip_generation its loop was found not drawable
## at: its ghosts wait in the queue until a clip goes up (_ghost_ready).
var _ghost_clip_wait := {}

## Round 756: whether a queued body can be made a ghost now: its kind's
## templates made, and its loop not known to be still baking.
func _ghost_ready(character_id: int) -> bool:
	if _other_async_templates and not _other_template_ready(character_id):
		return false
	var args = _other_build_args.get(character_id)
	if args == null or _crowd_gpu == null:
		return true
	var w = _ghost_clip_wait.get(String((args as Dictionary).get("kind", "")))
	return w == null or int(w) != _crowd_gpu.clip_generation

## Round 748's review, F8: a queued body's pluses changed, so its kind (the
## glow's particle files it waits on) is worked out again.
func _forget_other_kind(character_id: int) -> void:
	var args = _other_build_args.get(character_id)
	if args != null:
		(args as Dictionary).erase("kind")
		_reghost_later(character_id)

## Round 756: a ghost whose kind changed (an item, a plus) is drawn again in
## the new one once its templates are made (_ghost_other); until then it
## shows the old.
func _reghost_later(character_id: int) -> void:
	if not _ghost_ids.has(character_id):
		return
	var args = _other_build_args.get(character_id)
	if args != null:
		(args as Dictionary)["reghost"] = true
		_other_ghosts.queue(character_id)

func _other_template_ready(character_id: int) -> bool:
	if _appearance == null:
		return true
	var args = _other_build_args.get(character_id)
	var node = _other_bodies.get(character_id)
	if args == null or not is_instance_valid(node):
		return true
	var kind: String = (args as Dictionary).get("kind", "")
	var look := _other_look(character_id)
	if kind == "":
		# Round 843: a model switcher's own ids make another kind.
		kind = look.kind(String((node as Node).get_meta("body", "")))
		args["kind"] = kind
	# Round 762: the kind's own state, looked at again only when something
	# it can use arrived (CharacterAppearance.kind_ready); its spec worked out
	# once, the first time it is asked.
	var state := _appearance.kind_state(kind)
	if state >= 0:
		return state == 1
	var kt := Time.get_ticks_usec() if FrameSplit.on else 0
	var ref := _other_build_ref(String((node as Node).get_meta("body", "")))
	if ref < 0:
		return true
	var ok := _appearance.kind_ready_look(kind, look, ref, _item_drawable)
	if FrameSplit.on:
		FrameSplit.add("k_new", Time.get_ticks_usec() - kt)
	return ok

## The model id _build_assembled_character would draw `body` on, worked out
## without building anything (the default gender's for an unknown body), or -1
## when even that cannot be resolved (it then builds the old way). What is
## worn is the look's (CharacterLook.items, round 847).
func _other_build_ref(body: String) -> int:
	var ref := _body_ref_for(body)
	if ref < 0:
		ref = _body_ref_for(String(GENDER_BODY_CODE[DEFAULT_GENDER]))
	return ref

## A body key's model id as _body_assets would find it, without assembling
## its template; -1 when unknown.
func _body_ref_for(body: String) -> int:
	if _character_assets.has(body):
		var a: Dictionary = _character_assets[body]
		return int(a.get("ref", -1)) if not a.is_empty() else -1
	if _appearance != null and _body_id_by_code.has(body):
		return int(_body_id_by_code[body])
	return -1

## Round 756: draws an arrived player at once from its kind's recipe
## (CrowdGpu.add_ghost), with what is the holder's own: the name plate and
## the click body over the body's height (as _dress_other makes them), its
## circle shadow, its clip sounds. A body that cannot be a ghost (a blended
## part, an unknown body, a kind build() would grow) is left to the dressing;
## one whose clip is still baking is asked again next frame. With `reghost`
## set (its kind changed) the ghost is drawn again in its new kind, the
## clip's phase kept and no fade.
func _ghost_other(character_id: int) -> void:
	_ghost_other_now(character_id)
	# Round 762's review, F3: an arrival that is neither a ghost now nor queued
	# to be one again (no appearance yet, its holder gone) waits for nothing:
	# off its page, which would otherwise hold until its deadline.
	if _page_wait.has(character_id) and not _other_ghosts.has(character_id):
		var n = _other_bodies.get(character_id)
		if _crowd_gpu == null or n == null or not _crowd_gpu.is_ghost(n):
			_page_unwait(character_id)

func _ghost_other_now(character_id: int) -> void:
	var held = _other_bodies.get(character_id)
	var args = _other_build_args.get(character_id)
	if args == null or not is_instance_valid(held) or (held as Node).is_queued_for_deletion() or _appearance == null:
		return
	var node: Node3D = held
	if not node.is_inside_tree():
		return
	var crowd := _crowd_gpu_get()
	if crowd == null:
		return
	var re := bool((args as Dictionary).get("reghost", false))
	var old: CrowdGpu.Body = crowd.body_of(node)
	if old != null and not re:
		return
	# Round 839: a stalling owner is left to the dressing (its vendor loop
	# and booth are the full path's, StallWorld).
	if old == null and _stall_world != null and _stall_world.stalling(character_id):
		_ghost_refused[character_id] = true
		_page_unwait(character_id)
		return
	var body := String(node.get_meta("body", ""))
	if _body_assets(body).is_empty():
		body = String(GENDER_BODY_CODE[DEFAULT_GENDER])
	var look := _other_look(character_id)
	var ref := _other_build_ref(body)
	if ref < 0:
		if old == null:
			_ghost_refused[character_id] = true
			_page_unwait(character_id)
		return
	var qt := Time.get_ticks_usec() if FrameSplit.on else 0
	var recipe := _appearance.far_recipe_look(look, ref, _item_drawable)
	if FrameSplit.on:
		FrameSplit.add("g_recipe", Time.get_ticks_usec() - qt)
		qt = Time.get_ticks_usec()
	if recipe == null or not crowd.can_ghost(recipe):
		if re:
			(args as Dictionary).erase("reghost")
			# Its new kind cannot be a ghost (a blended part): dressed next,
			# not when the queue reaches it (review F7).
			_promote_ghost(character_id)
		elif old == null:
			_ghost_refused[character_id] = true
			_page_unwait(character_id)
		return
	var group := _weapon_group_for(look.worn, body)
	var moving := bool(_ghost_moving.get(character_id, false))
	var action := BsrReader.AnimationEntry.TYPE_STAND
	if _other_seated.has(character_id):
		action = BsrReader.AnimationEntry.TYPE_SITTING
	elif moving:
		action = BsrReader.AnimationEntry.TYPE_RUN
	var anim := _body_animation_for(body, action, group)
	var frames := _frame_count(anim)
	if frames <= 1:
		# No loop to draw it with: only the dressing shows it (review F9).
		if old == null:
			_ghost_refused[character_id] = true
			_page_unwait(character_id)
		return
	# Its run baked ahead, so its first step finds it (review F3).
	if action != BsrReader.AnimationEntry.TYPE_RUN:
		crowd.prebake_recipe(recipe, _body_animation_for(body, BsrReader.AnimationEntry.TYPE_RUN, group))
	# Its loop not drawable yet (baking): its kind waits for the next clip
	# to go up (_ghost_ready), still queued.
	if not crowd.ghost_clip_ready(recipe, anim):
		_ghost_clip_wait[String((args as Dictionary).get("kind", ""))] = crowd.clip_generation
		_other_ghosts.queue(character_id)
		return
	var phase := float(old.entry[3]) if old != null else float(_animated_total()) * 0.37
	var entry := [node, anim, frames, phase, true, _idle_anim_time, null]
	if FrameSplit.on:
		FrameSplit.add("g_geo_clip", Time.get_ticks_usec() - qt)
		qt = Time.get_ticks_usec()
	# Lit where it stands as it appears (review F4: the original sets a
	# character's colour with its position; a late light was a visible step).
	var light := old.light if old != null else _ghost_light_at(node)
	if FrameSplit.on:
		FrameSplit.add("g_light", Time.get_ticks_usec() - qt)
		qt = Time.get_ticks_usec()
	var heard := node.global_position.distance_squared_to(_crowd_listener()) <= SoundTable.CULL_DISTANCE_SQ
	# A ghost drawn again mid fade-in goes on with its fade; one still held
	# with its page stays held (round 762).
	var fading_from := crowd.fade_start_of(node) if old != null else NAN
	var hold := crowd.hold_of(node) if old != null and crowd.is_held(node) else -1
	var page: ArrivalPage = _page_wait.get(character_id) if old == null else null
	if page != null:
		hold = _page_hold_slot(page, crowd)
	if old == null:
		_page_unwait(character_id)
	if old != null:
		crowd.remove(node)
	var added := crowd.add_ghost(node, recipe, entry, _ghost_local_for(recipe.height), light, _idle_anim_time, old == null or hold >= 0, hold)
	if FrameSplit.on:
		FrameSplit.add("g_add", Time.get_ticks_usec() - qt)
		FrameSplit.add("g_add_calls", 1)
		qt = Time.get_ticks_usec()
	if not added:
		if old != null:
			# Its new clip is still baking: the old look stays meanwhile.
			crowd.add_ghost(node, old.recipe, old.entry, old.local, old.light, _idle_anim_time, hold >= 0, hold)
			if not is_nan(fading_from):
				crowd.continue_fade_in(node, fading_from)
		var b0 := crowd.body_of(node)
		if b0 != null:
			crowd.set_heard(b0, heard)
			b0.sound_due = -INF if heard else INF
			_sound_schedule(b0)  # round 757's merge, S1
		_other_ghosts.queue(character_id)
		return
	(args as Dictionary).erase("reghost")
	# Round 764's review, F9: a ghost held in its page gets its weapons'
	# particles at its activation (_hold_step), not now: no host work for a
	# page that shows nothing yet.
	if crowd.is_held(node):
		node.set_meta(FX_DUE_META, true)
	else:
		_ghost_fx(node, recipe)
	var b := crowd.body_of(node)
	crowd.set_heard(b, heard)
	b.sound_due = -INF if heard else INF
	_sound_schedule(b)  # round 757's merge, S1
	if not is_nan(fading_from):
		crowd.continue_fade_in(node, fading_from)
	node.set_meta(GHOST_KIND_META, [body, group])
	if old != null:
		return
	_ghost_ids[character_id] = true
	if light >= 0.0:
		# CharacterLight's own visits find it lit where it stands.
		node.set_meta(CharacterLight.META_VALUE, light)
		node.set_meta(CharacterLight.META_POS, node.global_position)
	if not node.tree_exiting.is_connected(_crowd_ghost_exit):
		node.tree_exiting.connect(_crowd_ghost_exit.bind(node))
	node.set_meta(GHOST_TOP_META, _skeleton_top(recipe.skeleton) * recipe.height)
	if crowd.is_held(node):
		# Round 762: held with its page: its plate, click body and sound owner
		# are made now, held (the plate's anchor hidden, the click body on no
		# layer, the circle and the sounds not registered), and switched on
		# when the page is revealed (_activate_extras, a few microseconds a
		# body); it is not dressed meanwhile.
		var held_page := _page_of_slot(crowd.hold_of(node))
		if held_page != null:
			held_page.ids.append(character_id)
			held_page.oldest_ms = mini(held_page.oldest_ms, int(_ghost_queued_ms.get(character_id, held_page.oldest_ms)))
		_other_builds.drop(character_id)
		_ghost_extras(character_id, node, true)
	else:
		_ghost_extras(character_id, node)
		# Round 762's review, F2: a buff that came before it was a ghost.
		_other_builds.wake(character_id)
	if FrameSplit.on:
		FrameSplit.add("g_holder", Time.get_ticks_usec() - qt)

## What _dress_other gives the holder, made for a ghost (round 756; round 762:
## when its page is revealed): the plate and the click body over the body's
## height (the body template's meshes: build() hangs no other drawn child on
## the skeleton itself) times its Height, as the built skeleton's scale gives
## it (review F6; the dressing re-places them from the built skeleton), the
## circle shadow, its clip sounds.
func _ghost_extras(character_id: int, node: Node3D, held: bool = false) -> void:
	if node.has_meta(GHOST_HOLDER_META):
		return
	var kind: Array = node.get_meta(GHOST_KIND_META, [String(node.get_meta("body", "")), ""])
	var body := String(kind[0])
	var top := float(node.get_meta(GHOST_TOP_META, 1.8 * PLAYER_SCALE_RATIO))
	# Batched (round 757's merge, S2), as a dressed body's.
	_add_other_plate(node, String(node.get_meta("character_name", "")), top)
	var click := _other_player_collider(top)
	node.add_child(click)
	node.set_meta(GHOST_HOLDER_META, true)
	# Its clip sounds, keyed by the holder until it has a skeleton.
	var owner := _audio_pc_owner("player %d" % character_id, body, _other_worn(character_id), node)
	owner.material = func() -> int: return _audio_material_at(node.global_position, -2) if is_instance_valid(node) else -1
	if held:
		click.collision_layer = 0
		if _plate_batch != null:
			for c in node.get_children():
				if c is Label3D:
					_plate_batch.hold(c as Label3D)
		node.set_meta(HELD_EXTRAS_META, owner)
		return
	CharacterBlobs.register(node, float(_bc_radius_by_code.get(body, 0.0)))
	_anim_sounds.register(node, owner)

## Round 762: what a held ghost's holder was given, switched on at its page's
## reveal: the plate drawn, the click body on its layer, the circle, the
## sounds. A few microseconds a body (the plate and click body were made while
## the page was held).
func _activate_extras(node: Node3D) -> void:
	var owner = node.get_meta(HELD_EXTRAS_META)
	node.remove_meta(HELD_EXTRAS_META)
	for c in node.get_children():
		if c is Label3D and _plate_batch != null:
			_plate_batch.release(c as Label3D)
		elif c is StaticBody3D and String(c.name) == "PlayerClickBody":
			(c as StaticBody3D).collision_layer = OTHER_PLAYER_COLLISION_LAYER
	CharacterBlobs.register(node, float(_bc_radius_by_code.get(String(node.get_meta("body", "")), 0.0)))
	if owner != null and _ghost_ids.has(int(node.get_meta("character_id", -1))):
		_anim_sounds.register(node, owner)

## Meta on a held ghost's holder: its sound owner, until the reveal.
const HELD_EXTRAS_META := &"opensro_held_extras"
## Round 764's review, F9: meta on a held ghost's holder whose weapons'
## particles are still to be registered (at its activation).
const FX_DUE_META := &"opensro_fx_due"

## Meta on a ghost's holder: its body's top (the plate's and click body's height).
const GHOST_TOP_META := &"opensro_ghost_top"
## Round 762: meta on a holder dressed while its page was held: its plate,
## click body and circle are still to be made (at the reveal).
const EXTRAS_DUE_META := &"opensro_extras_due"

## Round 762 (OURS; docs/rounds/r762.md): an arriving page is held, then shown
## whole. Retail creates every character of a group spawn in the one 0x3018
## call and they fade in together (READ, r756.md / r762.md); here each body's
## ghost is made a frame's share at a time (OtherCrowd.GHOST_BUDGET_USEC) at
## alpha 0 in a CrowdGpu hold slot, and the slot is revealed in one frame --
## every body fading in together -- once every arrived body whose kind can be
## drawn is a ghost, or HOLD_MAX_MSEC after the page was opened (a cold kind's
## templates still on their way are not waited for longer; their bodies come
## with the next reveal). Their plates, click bodies, circles and
## sounds follow, nearest first, ACTIVATE_BUDGET_USEC a frame.
const HOLD_MAX_MSEC := 20000
const ACTIVATE_BUDGET_USEC := 2000
var _holds_on := OS.get_environment("OPENSRO_QA_HOLD") != "0"
## id -> the msec it was queued to be a ghost (the hold's deadline).
var _ghost_queued_ms := {}
var _activate_ids: Array = []
var _activate_at := 0

## Round 762's review, F6 (OURS): a page -- the group spawns that arrive
## together -- held in its own CrowdGpu hold slot and revealed when its own
## arrivals are all ghosts (or HOLD_MAX_MSEC after it opened). A group whose
## first share comes more than PAGE_JOIN_MSEC after the current page opened
## opens a new page: before, every group arriving while a page was held joined
## it, and running through a dense area (a crossing every few seconds) kept
## refilling it until the 20 s deadline, its players unseen meanwhile.
class ArrivalPage:
	## Its hold slot (-1: none yet, or every slot in use: its ghosts fade in
	## as made), the ghosts held in it, when its first arrival came, the
	## oldest of its ghosts' queue times, and its arrivals not made ghosts yet.
	var slot := -1
	var ids: Array = []
	var opened_ms := 0
	var oldest_ms := 0
	var waiting := 0
	var revealed := false
	## Round 764: when its LAST group came off the socket (NetClient.group_rx_msec);
	## the review's F8: a group joins within PAGE_JOIN_MSEC of the one before
	## it, so a window delivered over a slow link stays one page.
	var rx_ms := 0

## Round 764: measured between the groups' RECEIVE times, not between the
## frames their first shares were read in. A server window is one batch (the
## neighbour blocks' groups, then the own block's: playerview.go, retail's
## CMsgBlock slot 2), all of it on the wire within milliseconds; read a
## frame's share at a time, a 4,000 crowd's last group starts 3-5 s after its
## first, and the read-time rule split one window into two pages shown seconds
## apart -- whole blocks of the crowd missing meanwhile (the user's "only a
## portion shows up ... in a chunk that isn't a radius", v0.1.515 / v0.1.516
## logs, r764.md section 1). A run across block lines (a batch every few
## seconds) still opens a page per batch.
const PAGE_JOIN_MSEC := 3000
## The pages not revealed yet, oldest first; the one arrivals join now; the
## NetClient group whose shares it takes; arrivals still to be ghosts -> page.
var _pages: Array = []
var _page_cur: ArrivalPage = null
var _page_group_seen := -1
var _page_pick := false
## Round 764: the receive time of the group whose first share _page_pick marks.
var _page_pick_rx := 0
var _page_wait := {}

## The page an arrival inside a group bracket joins: the current one, unless
## this is a new group's first share and the current page opened more than
## PAGE_JOIN_MSEC ago (or was revealed).
func _arrival_page() -> ArrivalPage:
	var now := Time.get_ticks_msec()
	var rx := _page_pick_rx if _page_pick and _page_pick_rx > 0 else now
	if _page_cur == null or _page_cur.revealed or (_page_pick and rx - _page_cur.rx_ms > PAGE_JOIN_MSEC):
		_page_cur = ArrivalPage.new()
		_page_cur.opened_ms = now
		_page_cur.oldest_ms = now
		# The re-review's R9: its clock from its first arrival, picked or not.
		_page_cur.rx_ms = rx
		_pages.append(_page_cur)
	if _page_pick:
		_page_cur.rx_ms = maxi(_page_cur.rx_ms, rx)
	_page_pick = false
	_page_pick_rx = 0
	_page_cur.waiting += 1
	return _page_cur

## An arrival no longer waits to be a ghost (made one, refused, dressed, gone).
func _page_unwait(character_id: int) -> void:
	var page = _page_wait.get(character_id)
	if page == null:
		return
	_page_wait.erase(character_id)
	(page as ArrivalPage).waiting -= 1

## The slot `page`'s ghosts are held in (opened on its first ghost), or -1:
## holds off, every slot in use (they fade in at once), or the page revealed.
func _page_hold_slot(page: ArrivalPage, crowd: CrowdGpu) -> int:
	if not _holds_on or page.revealed:
		return -1
	if page.slot < 0 or not crowd.hold_pending(page.slot):
		page.slot = crowd.hold_open()
		page.ids = []
	return page.slot

## The unrevealed page held in `slot`, or null.
func _page_of_slot(slot: int) -> ArrivalPage:
	if slot < 0:
		return null
	for pg in _pages:
		if (pg as ArrivalPage).slot == slot and not (pg as ArrivalPage).revealed:
			return pg
	return null

## Whether a page holds ghosts not revealed yet.
func _pages_holding() -> bool:
	for pg in _pages:
		if not (pg as ArrivalPage).ids.is_empty():
			return true
	return false

## QA (QaCrowdProbe's frame log): the ghosts held in unrevealed pages.
func qa_held_count() -> int:
	var n := 0
	for pg in _pages:
		n += (pg as ArrivalPage).ids.size()
	return n

## Round 762's review, F3: every page's hold state reset (a zone change: the
## bodies are gone). A slot still held is revealed so it frees once its (now
## empty) fade has run.
func _reset_pages() -> void:
	if _crowd_gpu != null:
		for pg in _pages:
			var page: ArrivalPage = pg
			if page.slot >= 0 and _crowd_gpu.hold_pending(page.slot):
				_crowd_gpu.reveal(page.slot, _idle_anim_time)
	_pages.clear()
	_page_cur = null
	_page_pick = false
	_page_pick_rx = 0
	_page_wait.clear()
	_activate_ids.clear()
	_activate_at = 0
	_ghost_queued_ms.clear()

## Each frame (_pump_other_builds, after the ghosts): each held page revealed
## when it is complete or due, then the revealed ghosts' plates and the rest.
func _hold_step() -> void:
	var crowd := _crowd_gpu
	if not _pages.is_empty():
		var now_ms := Time.get_ticks_msec()
		for pg in _pages.duplicate():
			var page: ArrivalPage = pg
			var due := now_ms - page.opened_ms >= HOLD_MAX_MSEC
			if page.waiting > 0 and not due:
				continue
			# Not while the group it takes is still being read (its next share
			# may come after this one's ghosts are all made).
			if not due and page == _page_cur and NetClient != null and bool(NetClient.call("group_reading")):
				continue
			_pages.erase(page)
			page.revealed = true
			var n := 0
			if crowd != null and page.slot >= 0 and crowd.hold_pending(page.slot):
				n = crowd.reveal(page.slot, _idle_anim_time)
			var ids := page.ids
			# Nearest first: their plates and click bodies come in that order.
			var from := player.global_position if player != null else Vector3.ZERO
			var keyed := PackedInt64Array()
			for i in ids.size():
				var nd = _other_bodies.get(ids[i])
				if nd == null or not is_instance_valid(nd):
					continue
				var d := minf((nd as Node3D).global_position.distance_squared_to(from), 1.0e12)
				keyed.append((int(d) << 20) | i)
			keyed.sort()
			for k in keyed:
				_activate_ids.append(ids[k & ((1 << 20) - 1)])
			for id in ids:
				_ghost_queued_ms.erase(id)
			var late := 0
			if page.waiting > 0:
				# Revealed by its deadline (round 762's review, F3): its arrivals
				# still waiting go to a page of their own (they come together
				# with its reveal); an id whose body is gone is dropped.
				var rest: ArrivalPage = null
				for id in _page_wait.keys():
					if _page_wait[id] != page:
						continue
					var nd = _other_bodies.get(id)
					if nd == null or not is_instance_valid(nd) or (nd as Node).is_queued_for_deletion():
						_page_wait.erase(id)
						continue
					if rest == null:
						rest = ArrivalPage.new()
						rest.opened_ms = now_ms
						rest.oldest_ms = now_ms
						_pages.append(rest)
					_page_wait[id] = rest
					rest.waiting += 1
					late += 1
				page.waiting = 0
				if _page_cur == page:
					_page_cur = rest
			if page.slot >= 0 or not ids.is_empty():
				print("World3D: %d arriving bod(ies) revealed together, %d ms after the first of them arrived%s; templates %s" % [n,
					now_ms - page.oldest_ms, "" if late == 0 else " (%d still waiting: due)" % late,
					str(_appearance.prep_stats) if _appearance != null else "-"])
	if _activate_at >= _activate_ids.size():
		if not _activate_ids.is_empty():
			_activate_ids.clear()
			_activate_at = 0
		return
	var t0 := Time.get_ticks_usec()
	# Round 762: within the frame's crowd budget too, one body at least.
	var act_budget := clampi(OtherCrowd.FrameBudget.left(), 0, ACTIVATE_BUDGET_USEC)
	var acted := 0
	while _activate_at < _activate_ids.size():
		if acted > 0 and Time.get_ticks_usec() - t0 >= act_budget:
			break
		acted += 1
		var id: int = _activate_ids[_activate_at]
		_activate_at += 1
		var node = _other_bodies.get(id)
		if node == null or not is_instance_valid(node):
			continue
		if (node as Node).has_meta(HELD_EXTRAS_META):
			_activate_extras(node)
		elif _ghost_ids.has(id):
			_ghost_extras(id, node)
		if (node as Node).has_meta(FX_DUE_META):
			(node as Node).remove_meta(FX_DUE_META)
			var fb = _crowd_gpu.body_of(node) if _crowd_gpu != null else null
			if fb != null and fb.ghost and fb.recipe != null:
				_ghost_fx(node, fb.recipe)
		# Round 762's review, F7 (F10): dressed while its page was held -- its
		# plate and click body go over the built body's height now, and its
		# meshes take the level CharacterLight finds.
		if (node as Node).has_meta(EXTRAS_DUE_META):
			_extras_due(id, node)
		# Dressed from now, nearest first, as any ghost.
		if _ghost_ids.has(id) and _other_build_args.has(id):
			_other_builds.queue(id)
			# Round 762's review, F2: one that arrived with buffs is dressed
			# first, so its auras are drawn (_dress_other resyncs them).
			if not _target_buff_book.list_of(_fx_owner_key(id, SkillNet.OWNER_CHARACTER)).is_empty():
				_other_builds.promote(id)
	OtherCrowd.FrameBudget.spend(Time.get_ticks_usec() - t0)
	if FrameSplit.on:
		FrameSplit.add("g_activate", Time.get_ticks_usec() - t0)

## Round 762's review, F7 (F10): a body dressed while its page was held
## (_dress_other left EXTRAS_DUE_META): the plate and click body its ghost made
## re-placed over the built body's height, or made when it had none.
func _extras_due(character_id: int, node: Node3D) -> void:
	node.remove_meta(EXTRAS_DUE_META)
	var top := float(node.get_meta(GHOST_TOP_META, 1.8 * PLAYER_SCALE_RATIO))
	var has_plate := false
	for c in node.get_children():
		if c is StaticBody3D and String(c.name) == "PlayerClickBody":
			has_plate = true
	if has_plate:
		_replace_plate_and_click(node, top)
	else:
		_add_other_plate(node, String(node.get_meta("character_name", "")), top)
		node.add_child(_other_player_collider(top))
		CharacterBlobs.register(node, float(_bc_radius_by_code.get(String(node.get_meta("body", "")), 0.0)))
	node.remove_meta(CharacterLight.META_VALUE)

## Meta on a ghost's holder: [body key, animation group] its loops are read in.
const GHOST_KIND_META := &"opensro_ghost_kind"
## Meta on a holder a ghost gave its plate, click body, circle and sound
## owner: the dressing does not make them again (it re-places the first two).
const GHOST_HOLDER_META := &"opensro_ghost_holder"

## Round 756's review, F1: a ghost something wants dressed but not this frame
## (an aura) goes to the front of the budgeted dressing.
func _promote_ghost(character_id: int) -> void:
	# Round 762's review, F2: one held with its page, or not a ghost yet, is
	# remembered and goes first once it is queued after its page shows (or
	# once it is a ghost); before, the promote was lost and the auras it
	# arrived with were never drawn.
	if _ghost_ids.has(character_id) and _other_builds.has(character_id) and not _page_wait.has(character_id) \
			and (_crowd_gpu == null or not _crowd_gpu.is_held(_other_bodies.get(character_id))):
		_other_builds.promote(character_id)
	elif _other_build_args.has(character_id):
		_other_builds.promote_later(character_id)

## A ghost's holder leaving the tree (freed, a zone change): off the instances.
func _crowd_ghost_exit(node: Node3D) -> void:
	_ghost_fx_off(node)
	if _crowd_gpu != null and _crowd_gpu.is_ghost(node):
		_crowd_gpu.remove(node)
	if is_instance_valid(node):
		_anim_sounds.unregister(node)

## The object colour a ghost is drawn at: CharacterLight's for where it
## stands, or -1 (its materials as they are) where no region is loaded, as
## CharacterLight.visit leaves a body there.
func _ghost_light_at(node: Node3D) -> float:
	if _character_light == null:
		return -1.0
	var pos := node.global_position
	var pair: Array = _character_light.lookup.call(pos) if _character_light.lookup.is_valid() else []
	if _character_light.lookup.is_valid() and pair.is_empty():
		return -1.0
	if _character_light._qa_value >= 0.0:
		return _character_light._qa_value
	return _character_light.color_at_pair(pos, pair)

## The skeleton's place under its holder that _dress_other gives it (turned
## by PI) times _build_assembled_character's Height.
func _ghost_local_for(height: float) -> Transform3D:
	var got = _ghost_local.get(height)
	if got != null:
		return got
	var n := Node3D.new()
	n.rotation.y = PI
	n.scale = BodyMirror.SCALE * height
	var t := n.transform
	n.free()
	_ghost_local[height] = t
	return t

## CharacterLight read a new colour under `body`: a ghost's parts take it.
func _crowd_ghost_light(body: Node3D, value: float) -> void:
	if _crowd_gpu != null:
		_crowd_gpu.ghost_light(body, value)

## Round 756: dresses a ghost now, out of the queue's turn (something needs
## its skeleton this frame). True when it was a ghost.
func _dress_ghost_now(character_id: int) -> bool:
	if not _ghost_ids.has(character_id) or not _other_build_args.has(character_id):
		return false
	_other_builds.drop(character_id)
	_dress_other(character_id)
	return true

## The near path's bookkeeping for a body just drawn far (CrowdGpu.add): its
## clip sounds from the CPU within hearing (round 747's review, F2), its run
## baked ahead, its exit hook.
func _crowd_went_far(character_id: int, node: Node3D, skel: Skeleton3D) -> void:
	var fb := _crowd_gpu.body_of(skel)
	var heard := node.global_position.distance_squared_to(_crowd_listener()) <= SoundTable.CULL_DISTANCE_SQ
	_crowd_gpu.set_heard(fb, heard)
	fb.sound_due = -INF if heard else INF
	# Round 757's merge: filed on the sound wheel.
	_sound_schedule(fb)
	var gait: Dictionary = _other_gaits.get(character_id, {})
	if not gait.is_empty():
		_crowd_gpu.prebake(skel, _body_animation_for(gait["body"], BsrReader.AnimationEntry.TYPE_RUN, gait["group"]))
	if not skel.has_meta(CROWD_EXIT_META):
		var cb := _crowd_on_exit.bind(skel)
		skel.set_meta(CROWD_EXIT_META, cb)
		skel.tree_exiting.connect(cb)

## Dresses an arrived player's node (round 739, B4: split out of
## _spawn_or_update_other, which made it all in one call): the body, the
## plate, the click body, the sounds and the loop. What it is dressed with is
## what is known by now: the worn items and pluses as 0x3038/0x3039 left them
## (_redress_other keeps the queued items current), the seat (_other_seated),
## the place it has walked to.
func _dress_other(character_id: int) -> void:
	var held = _other_bodies.get(character_id)
	var args: Dictionary = _other_build_args.get(character_id, {})
	_other_build_args.erase(character_id)
	_other_ghosts.drop(character_id)
	_ghost_ids.erase(character_id)
	_ghost_refused.erase(character_id)
	_ghost_queued_ms.erase(character_id)
	_page_unwait(character_id)
	if not is_instance_valid(held) or (held as Node).is_queued_for_deletion():
		return
	var node: Node3D = held
	# Round 756: drawn as a ghost until now -- its plate, click body, circle
	# shadow and sounds are made; its clip entry (phase and all) goes on.
	var ghost: CrowdGpu.Body = _crowd_gpu.body_of(node) if _crowd_gpu != null else null
	if ghost != null and not ghost.ghost:
		ghost = null
	# Round 762's review, F1: its weapons' particles are the built items' now.
	if ghost != null:
		_ghost_fx_off(node)
	# Round 762: a ghost held with its page gets its plate, click body and
	# circle when the page is revealed (_hold_step), dressed or not.
	var page_held := ghost != null and _crowd_gpu.is_held(node)
	var held_ghost := node.has_meta(GHOST_HOLDER_META)
	node.remove_meta(GHOST_HOLDER_META)
	var look := _other_look(character_id)
	var equipped: Dictionary = look.worn
	var scale: int = look.scale
	var body := String(node.get_meta("body", ""))
	var char_name := String(node.get_meta("character_name", ""))
	# QA (round 748): where a slow dressing goes (FrameSplit's probe only).
	var dt := DressTimer.new() if FrameSplit.on else null
	var stats_before := _appearance.stats.duplicate() if dt != null and _appearance != null else {}

	# The same builder and the same dressing as the local player: their
	# model, scale byte and every worn item's id come in the snapshot (see
	# bodyOf and equippedItems in server/internal/session/world.go, both
	# queried live), and each item is drawn from its own model. Falls back to
	# the labeled placeholder capsule if the bodies never loaded.
	var skeleton := _build_assembled_character(look, body)
	if dt != null:
		dt.mark("build")
	if skeleton != null:
		# Same 180deg front correction as the local player (see
		# _try_apply_real_player_character) -- the body's own front is -Z, and
		# the node points +Z where it moves/faces.
		skeleton.rotation.y = PI
		BodyMirror.apply(skeleton)
		node.add_child(skeleton)
		if dt != null:
			dt.mark("enter")
		# Another player stands in the town idle of the group their weapon
		# selects, and runs while their body is still catching up to a
		# position update (see _set_other_gait). Without this they stood
		# in the bind pose, arms out, which no character in the game does.
		body = String(skeleton.get_meta("body", body))
		node.set_meta("body", body)
		var group := _weapon_group_for(equipped, body)
		# Seated while they waited (a Seated tail, a 0x30bf): the sitting
		# loop without the sit-down clip, as _spawn_result_others seats a
		# body drawn at once (round 607).
		var seated := _other_seated.has(character_id)
		_other_gaits[character_id] = {"skeleton": skeleton, "body": body, "scale": scale, "group": group, "moving": false}
		_held_rebuilt(character_id)
		if seated:
			_other_gaits[character_id]["sitting"] = true
		# Their sounds come from where their body is; the cell under them is
		# found from the height (_audio_material_at), not carried as the
		# local player's is. Their berserk arrives as their body mode (round
		# 651, _berserk_apply), which turns their swings to the hwan ones.
		var owner := _audio_pc_owner("player %d" % character_id, body, equipped, node)
		owner.material = func() -> int: return _audio_material_at(node.global_position, -2) if is_instance_valid(node) else -1
		if held_ghost:
			_anim_sounds.unregister(node)
		_anim_sounds.register(skeleton, owner)
		if dt != null:
			dt.mark("sounds")
		var idle := _body_animation_for(body, BsrReader.AnimationEntry.TYPE_SITTING if seated else BsrReader.AnimationEntry.TYPE_STAND, group)
		var frames := _frame_count(idle)
		if ghost != null:
			pass # its entry is handed over below
		elif frames > 1:
			_animated.append([skeleton, idle, frames, float(_animated_total()) * 0.37, true, _idle_anim_time, null])
		# Round 808: its idle fidget, from its body's table in its weapon's
		# group as it is then (_step_body_fidgets); none while it rides.
		skeleton.set_meta(FIDGET_META, [null, func(t: int) -> BanReader.ParsedAnimation:
			var g: Dictionary = _other_gaits.get(character_id, {})
			if g.is_empty() or _riders.has(character_id):
				return null
			return _body_animation_for(g["body"], t, g["group"])])
		if dt != null:
			dt.mark("clip")
		if seated:
			print("SIT: player %d drawn seated on spawn -- loop %s (type 14)" % [character_id,
				_body_animation_path(body, BsrReader.AnimationEntry.TYPE_SITTING, group)])
	else:
		var mesh := MeshInstance3D.new()
		var capsule := CapsuleMesh.new()
		capsule.radius = 0.4 * PLAYER_SCALE_RATIO
		capsule.height = 1.8 * PLAYER_SCALE_RATIO
		mesh.mesh = capsule
		var mat := StandardMaterial3D.new()
		mat.albedo_color = Color(0.9, 0.3, 0.3)
		mesh.material_override = mat
		mesh.position.y = 0.9 * PLAYER_SCALE_RATIO
		node.add_child(mesh)

	# The same plate as an NPC's -- fixed screen size, outlined, shown only
	# within range -- over the assembled body's own height.
	var top := _skeleton_top(skeleton) if skeleton != null else 1.8 * PLAYER_SCALE_RATIO
	if page_held:
		node.set_meta(GHOST_TOP_META, top)
		node.set_meta(EXTRAS_DUE_META, true)
	elif not held_ghost:
		# Round 757: batched (NamePlateBatch) unless it is off.
		_add_other_plate(node, char_name, top)
		# A click body on its own layer (round 622), so the player can be selected.
		node.add_child(_other_player_collider(top))
		# Its round shadow in Circle (round 702, CharacterBlobs).
		CharacterBlobs.register(node, float(_bc_radius_by_code.get(String(node.get_meta("body", "")), 0.0)))
	else:
		# The plate and click body the ghost made, re-placed over the built
		# body's own height (review F6).
		_replace_plate_and_click(node, top)
		# Its meshes take the level the ghost was drawn at (CharacterLight
		# skips a body whose colour has not changed).
		node.remove_meta(CharacterLight.META_VALUE)
	# Under Detail it arrives casting nothing; the next pass lets it cast if it
	# is one of the ten nearest (round 739, B2, CharacterBlobs.select_detail).
	if video_options().value(VideoOptions.SHADOW) >= 2:
		CharacterBlobs.set_casting(node, false)
	_light_character(node)
	# Round 839: a stalling owner gets its booth and title (StallWorld).
	node.set_meta(STALL_TOP_META, top)
	_stall_refresh(character_id)
	if dt != null:
		dt.mark("plate_click_light")
	# The auras of the buffs this client holds for them go on the new body
	# (round 646): a zone change's arrival list and the world entry build the
	# body after the server's replay may already have arrived.
	_fx_resync_owner(_fx_owner_key(character_id, SkillNet.OWNER_CHARACTER), "their body was built")
	# And their berserk, if they are (round 651): the spawn's own body mode,
	# applied without the start burst (FUN_009cf880(mode, 1, 0), READ).
	_berserk_resync(character_id, "their body was built")
	# They fade into existence over 2.0 s, as a monster does (round 676,
	# AppearFade: READ, CICUser vslot 0x6c FUN_009dbcc0 -> FUN_009d17e0).
	if ghost == null:
		_appear_fades.start(node)
	elif skeleton != null:
		_ghost_handover(character_id, node, skeleton, ghost)
	else:
		_crowd_gpu.remove(node)
	if dt != null:
		dt.mark("fade")
		dt.report(character_id, body, stats_before, _appearance.stats if _appearance != null else {})

## Round 756: a ghost's built skeleton takes its place in the same frame: the
## ghost's clip entry (its clip and phase) is the skeleton's now; the body is
## drawn far at once from the skeleton (the same meshes, materials and clip:
## the same pixels) unless it is among the nearest the last cycle kept near,
## still fading in (it then fades on from where the ghost's fade was) or not
## eligible -- then it is posed on the full path at its clip's frame, as a
## body brought back is (_crowd_wake).
func _ghost_handover(character_id: int, node: Node3D, skeleton: Skeleton3D, ghost: CrowdGpu.Body) -> void:
	var entry: Array = ghost.entry
	entry[0] = skeleton
	var fade_e := _crowd_gpu.fade_elapsed(node)
	# Round 762: a far body fades on the GPU too, so a ghost fading in goes on
	# with its fade there (its page's start; one still held starts it now).
	var fade_from := _crowd_gpu.fade_start_of(node)
	# Round 762: one dressed while its page is held stays held, far, until
	# the reveal (the near set takes it after its fade).
	var held_slot := _crowd_gpu.hold_of(node) if _crowd_gpu.is_held(node) else -1
	if fade_e >= 0.0 and is_nan(fade_from) and held_slot < 0:
		fade_from = _idle_anim_time
	_crowd_gpu.remove(node)
	_crowd_cull.info(skeleton)
	var cam := get_viewport().get_camera_3d() if get_viewport() != null else null
	var near := cam == null or cam.global_position.distance_to(node.global_position) <= _crowd_come
	if (not near or held_slot >= 0) and _crowd_eligible(character_id, node, skeleton) == "" \
			and _crowd_gpu.add(node, skeleton, entry, _idle_anim_time, fade_from, held_slot):
		_crowd_went_far(character_id, node, skeleton)
	else:
		_animated.append(entry)
		MonsterCrowd.pose_at(skeleton, entry[1], _idle_anim_time + float(entry[3]), true)
		var info: Array = _crowd_cull.info(skeleton)
		if info.size() == CrowdAnim.PLAYER_INFO_SIZE:
			info[4] = 1.0
		if fade_e >= 0.0:
			_appear_fades.start(node, AppearFade.APPEAR_SECONDS, fade_e)
	# Walking as a ghost: the gait now, through the swap, so the loop is the
	# run whatever the ghost could draw (review F3: it may have slid on its
	# stand loop while the run baked).
	var moving := bool(_ghost_moving.get(character_id, false))
	_ghost_moving.erase(character_id)
	_ghost_gait_wait.erase(character_id)
	if moving:
		var gait: Dictionary = _other_gaits.get(character_id, {})
		if not gait.is_empty():
			gait["moving"] = false
			_set_other_gait(character_id, true)

## The plate and click body a ghost gave `node`, set to `top` as
## _name_plate and _other_player_collider make them.
func _replace_plate_and_click(node: Node3D, top: float) -> void:
	for c in node.get_children():
		if c is Label3D and String(c.name) == "Name":
			# A batched plate takes its new height now (round 757's merge,
			# S2). Round 808: a rider's stays over its mount (the body's own
			# top is put back at the dismount), and the job mark and title
			# move with it.
			var rid := int(node.get_meta("character_id", -1))
			var y := top * (1.0 + NAME_PLATE_CLEARANCE_FRACTION)
			if rid >= 0 and _rider_plate_y.has(rid):
				_rider_plate_y[rid] = y
			else:
				_set_plate_y(node, c as Label3D, y)
		elif c is StaticBody3D and String(c.name) == "PlayerClickBody":
			for cs in c.get_children():
				if cs is CollisionShape3D and (cs as CollisionShape3D).shape is CapsuleShape3D:
					var shape := (cs as CollisionShape3D).shape as CapsuleShape3D
					shape.height = maxf(top, 1.0)
					shape.radius = maxf(top * 0.3, 1.0)
					(cs as CollisionShape3D).position = Vector3(0.0, shape.height * 0.5, 0.0)

## QA (round 748): one dressing's phases, printed when it took over
## REPORT_MS (`QA DRESS` lines; the crowd probe's FrameSplit only).
class DressTimer:
	## Round 762 (QA): OPENSRO_QA_DRESS_REPORT_MS lowers the line's floor.
	static var REPORT_MS := float(OS.get_environment("OPENSRO_QA_DRESS_REPORT_MS")) if OS.get_environment("OPENSRO_QA_DRESS_REPORT_MS").is_valid_float() else 40.0
	var t0 := Time.get_ticks_usec()
	var last := t0
	var parts := PackedStringArray()
	func mark(label: String) -> void:
		var now := Time.get_ticks_usec()
		parts.append("%s=%.1f" % [label, float(now - last) / 1000.0])
		last = now
	func report(id: int, body: String, before: Dictionary, after: Dictionary) -> void:
		var total := float(Time.get_ticks_usec() - t0) / 1000.0
		FrameSplit.add("dress", Time.get_ticks_usec() - t0)
		FrameSplit.add("dress_calls", 1)
		if total < REPORT_MS:
			return
		print("QA DRESS player %d %s total=%.1f ms %s body_assemblies+%d item_assemblies+%d" % [id, body, total, " ".join(parts),
			int(after.get("body_assemblies", 0)) - int(before.get("body_assemblies", 0)),
			int(after.get("item_assemblies", 0)) - int(before.get("item_assemblies", 0))])

## Another player's body key: their model's (round 689), or their gender's from
## an older server (_body_key_for).
func _snapshot_body(snapshot: WorldNet.EntitySnapshot) -> String:
	return _body_key_for(snapshot.ref_obj_id if snapshot.has_model else 0, snapshot.gender)

func _on_entity_entered(snapshot: WorldNet.EntitySnapshot) -> void:
	# During a zone change's load the old zone's bodies are still drawn and
	# the arrival list is not laid out yet: an arrival is kept for it
	# (round 646's review, _replace_others_for_arrival), not built to be freed.
	# Round 737's review: the chat line is for a real arrival in the zone
	# (OpPlayerZoneNotice), not a walk into view; a sitter is drawn seated
	# (its record's motion byte), here or when the arrival list is laid out.
	if _arrival_pending:
		_arrival_left.erase(snapshot.character_id)
		_arrival_entries[snapshot.character_id] = snapshot
		if snapshot.zone_arrival:
			_log_system("%s entered the zone." % snapshot.char_name)
		return
	_spawn_result_others([snapshot], [snapshot.character_id] if snapshot.seated else [])
	if snapshot.zone_arrival:
		_log_system("%s entered the zone." % snapshot.char_name)

## Keeps another player's worn pluses from their snapshot (round 735), and
## logs the ones they have -- the two-client check reads it.
func _note_other_pluses(snapshot: WorldNet.EntitySnapshot) -> void:
	_other_look(snapshot.character_id).pluses = snapshot.pluses.duplicate()
	_forget_other_kind(snapshot.character_id)
	# Round 762: not for a group spawn's records -- a crowd's page printed a
	# line an item, some 10,000 lines for the live walk-in's 1,471 bots,
	# inside its reading. A single arrival (the two-client check) still logs.
	if _other_build_defer > 0:
		return
	for slot in snapshot.pluses:
		print("World3D: player %d spawns with slot %d item %d at +%d" % [snapshot.character_id, int(slot),
			snapshot.item_in(int(slot)), int(snapshot.pluses[slot])])

## The character id retail's u32 uid names (round 735): the other player whose
## id's low 32 bits it is, drawn or waiting in a zone change's arrival list.
## -1 when there is none.
func _other_by_uid(uid: int) -> int:
	# Round 739 (B7): from the map _spawn_or_update_other keeps, not a scan of
	# every body.
	# Every body comes through _spawn_or_update_other, which adds it; a miss
	# (a uid out of view) costs no scan (its review's F9).
	var drawn := _other_uids.find(uid)
	if drawn >= 0 and _other_bodies.has(drawn):
		return drawn
	for id in _arrival_entries:
		if (int(id) & 0xffffffff) == uid:
			return int(id)
	return -1

## Retail 0x3038 / 0x3039 (round 735, NetClient.other_player_equipment_changed):
## another player put an item on (or its plus changed) or took one off. The
## retail client redresses the character by the item's visual slot
## (FUN_008a9260 / FUN_008a9560 -> ResolveVisualSlotForItem); OpenSRO keys its
## worn map by equip slot, which is the message's slot byte. plus -1 is a
## removal.
func _on_other_equipment_changed(uid: int, slot: int, ref_id: int, plus: int, own_ref: int = 0) -> void:
	var op := 0x3038 if plus >= 0 else 0x3039
	var avatar := _is_avatar_item(ref_id)
	# Retail tells the mover too (its handlers' own-uid branch updates the
	# character window and preview); this client did that from its equipment
	# result (0x0041), which the server sends first.
	if NetClient.own_character_id >= 0 and uid == (NetClient.own_character_id & 0xffffffff):
		if avatar:
			# Round 789: an avatar is drawn from the broadcast, as retail draws
			# it (READ c:0x8a9260 own-uid branch -> AttachAvatarVisual).
			var mine := _player_avatars.duplicate()
			var mine_pluses := _player_avatar_pluses.duplicate()
			CharacterLook.avatar_into(mine, mine_pluses, ref_id, plus)
			_set_player_avatars(mine, mine_pluses, "0x%x avatar %d" % [op, ref_id])
			_set_fx_on(player, ref_id, plus >= 0, {}, {})
			return
		print("World3D: 0x%x for this player -- drawn from the equipment result" % op)
		# Round 860 (SetItemFx): the set's look. The equipment result came
		# first, so the worn list is the new one; the old is it with this
		# slot's piece back (taken off) or out (put on).
		var now_worn: Dictionary = _player_equipped_last.duplicate()
		var was_worn := now_worn.duplicate()
		if plus >= 0:
			was_worn.erase(slot)
		else:
			was_worn[slot] = ref_id
		_set_fx_on(player, ref_id, plus >= 0, SetItemFx.complete_sets(was_worn, _set_of_item, SetItemFx.sizes()),
			SetItemFx.complete_sets(now_worn, _set_of_item, SetItemFx.sizes()))
		return
	var id := _other_by_uid(uid)
	if id < 0:
		# A zone change's result is laid out after its loading screen; until
		# then its others are nowhere this handler can reach (round 735's
		# review, finding 1). Kept and replayed once they are drawn.
		if _arrival_pending:
			_pending_equip_changes.append([uid, slot, ref_id, plus, own_ref])
			print("World3D: 0x%x for uid %d kept until the arrival list is drawn" % [op, uid])
			return
		print("World3D: 0x%x for uid %d, who is not drawn -- ignored" % [op, uid])
		return
	# A player waiting in the arrival list changes their kept snapshot, not
	# whatever this client last drew of them (round 735's review, finding 1).
	# Round 847: the change itself is the look's (CharacterLook
	# .apply_broadcast); a kept snapshot's items and pluses go through a look
	# made of them, the own ids are the player's look's either way.
	var kept: WorldNet.EntitySnapshot = _arrival_entries.get(id)
	var look := _other_look(id)
	var target := look
	if kept != null:
		target = CharacterLook.from_spawn(kept)
		target.own = look.own
	# Round 843 (OURS): the item's own id beside a model switcher's row; a
	# change of it redraws the body (its glow and seal come from it).
	var sets_before := SetItemFx.complete_sets(target.worn, _set_of_item, SetItemFx.sizes()) if not avatar else {}
	var change := target.apply_broadcast(slot, ref_id, plus, own_ref, avatar)
	# Round 860 (SetItemFx, READ c:0x8a9260 / 0x8a9560): the itemeffect row or
	# the set's look, on a body that is drawn.
	if kept == null:
		_set_fx_on(_other_bodies.get(id), ref_id, plus >= 0, sets_before,
			SetItemFx.complete_sets(target.worn, _set_of_item, SetItemFx.sizes()) if not avatar else {})
	var same_item := bool(change["same_item"])
	if bool(change["own_changed"]) and target.own.has(slot):
		print("World3D: player %d slot %d is drawn as item %d with item %d's own glow and seal" % [id, slot, ref_id, int(target.own[slot])])
	if avatar:
		# Round 789: by RefItemID, the slot byte ignored (READ c:0x8a9260 /
		# c:0x8a9560 -> FUN_00a60ef0 / FUN_00a60470).
		print("World3D: player %d avatar %s item %d at +%d; avatars %s" % [id, "on" if plus >= 0 else "off", ref_id, maxi(plus, 0),
			str(target.worn.keys().filter(func(k): return CharacterAppearance.is_avatar_key(int(k))))])
	else:
		print("World3D: player %d now wears slot %d item %d at +%d" % [id, slot, target.item_at(slot), int(target.pluses.get(slot, 0))])
	if kept != null:
		kept.equipped = target.worn
		kept.pluses = target.pluses
		look.own = target.own
		return
	var pluses := look.pluses
	_forget_other_kind(id)
	# Only the plus changed (the slot's item is the one drawn): the glow is
	# redrawn on the body as it stands, not the whole body rebuilt (round 734's
	# review, F2) -- the server sends one 0x3038 per plused item of every
	# player in an arrival list too long for one frame.
	if same_item and _reglow_other(id, pluses):
		return
	_redress_other(id)

## Round 860: an item's set id (0 none).
func _set_of_item(item_id: int) -> int:
	var row: ItemTableReader.Item = _item_rows.get(item_id)
	return row.set_id if row != null else 0

func _set_fx_on(body, ref_id: int, put_on: bool, before: Dictionary, after: Dictionary) -> void:
	if body == null or not is_instance_valid(body):
		return
	var row: ItemTableReader.Item = _item_rows.get(ref_id)
	var code := row.code_name if row != null else ""
	var played := SetItemFx.play(body, code, put_on, before, after)
	if played != "":
		print("World3D: %s on %s (%s %s)" % [played, (body as Node).name, "put on" if put_on else "taken off", code])

## Redraws another player's weapon and shield glow at `pluses` on the body
## drawn now (CharacterAppearance.reglow), only when they differ from those it
## was drawn with (_build_assembled_character marks them), and lights it again:
## a glow taken off gives back the plain material at the default object
## colour (round 734's review, F6). False when no body is drawn to redraw.
func _reglow_other(character_id: int, pluses: Dictionary) -> bool:
	var gait: Dictionary = _other_gaits.get(character_id, {})
	var skel: Skeleton3D = gait.get("skeleton") as Skeleton3D
	if _appearance == null or skel == null or not is_instance_valid(skel):
		return false
	if skel.get_meta("glow_pluses", {}) != pluses:
		# New glow materials: a far body comes back (round 747, CrowdGpu); the
		# next cycle draws it far with them.
		_crowd_wake(skel)
		_appearance.reglow(skel, pluses)
		skel.set_meta("glow_pluses", pluses.duplicate())
		var node: Node3D = _other_bodies.get(character_id)
		if node != null and is_instance_valid(node):
			node.remove_meta(CharacterLight.META_VALUE)
			_light_character(node)
	return true

## Broadcasts kept while a zone change's arrival list was not drawn (round 735's
## review, finding 1): [uid, slot, ref_id, plus] in arrival order.
var _pending_equip_changes: Array = []

## Replays the kept broadcasts once the arrival list is drawn; a uid still not
## drawn is then ignored as any other.
func _flush_pending_equip_changes() -> void:
	var pending := _pending_equip_changes
	_pending_equip_changes = []
	for c in pending:
		_on_other_equipment_changed(int(c[0]), int(c[1]), int(c[2]), int(c[3]), int(c[4]) if c.size() > 4 else 0)

## Rebuilds another player's dressed body inside their node from their look
## (round 735; _other_looks), as _apply_player_equipment_visual redresses the
## player's: the new skeleton replaces the old, keeping the node, its plate,
## its click body, its place and its facing; the gait, sounds and idle or run
## follow the new weapon's group.
func _redress_other(character_id: int) -> void:
	# Still waiting to be dressed (round 739, B4): it is dressed in its look
	# as it stands when its turn comes.
	if _other_build_args.has(character_id):
		_other_build_args[character_id].erase("kind")
		_reghost_later(character_id)
		return
	var node: Node3D = _other_bodies.get(character_id)
	var gait: Dictionary = _other_gaits.get(character_id, {})
	if node == null or not is_instance_valid(node) or gait.is_empty():
		return
	var look := _other_look(character_id)
	var equipped: Dictionary = look.worn
	var body := String(gait.get("body", node.get_meta("body", "")))
	var scale := look.scale
	var skeleton := _build_assembled_character(look, body)
	if skeleton == null:
		return
	var old = gait.get("skeleton")
	# Round 831: the old body's clip entries, moved onto the new body below.
	var carried := 0
	if old != null and is_instance_valid(old):
		# Posed as the old body is, not in its bind pose for a frame.
		Skeleton3DBuilder.copy_pose(old, skeleton)
		# Off the far instances now, not when it leaves the tree at the end of
		# the frame (round 747, CrowdGpu).
		_crowd_wake(old)
		_end_body_fidget(old)
		_pose_fades.erase((old as Object).get_instance_id())
		_other_hint_by_skel.erase((old as Object).get_instance_id())
		carried = _repoint_animated(old, skeleton)
		_anim_sounds.unregister(old)
		old.queue_free()
	skeleton.rotation.y = PI
	BodyMirror.apply(skeleton)
	node.add_child(skeleton)
	# The new meshes take the body's Detail state (round 739, B2): casting
	# only if it is one of the ten.
	CharacterBlobs.refresh_detail(node)
	body = String(skeleton.get_meta("body", body))
	var group := _weapon_group_for(equipped, body)
	var moving := bool(gait.get("moving", false))
	var sitting := bool(gait.get("sitting", false))
	var regrouped := group != String(gait.get("group", "")) or body != String(gait.get("body", ""))
	var owner := _audio_pc_owner("player %d" % character_id, body, equipped, node)
	owner.material = func() -> int: return _audio_material_at(node.global_position, -2) if is_instance_valid(node) else -1
	_anim_sounds.register(skeleton, owner)
	if carried > 0:
		# Round 831, as the original: the item goes onto the same character
		# (CObjCharacter::InstallEquipVisual 0xa61010 from 0x3038's handler
		# 0x8a9260), then CCObjCharacter vslot 8 (0xa61c60) ->
		# RefreshAnimationGroup (0xa5bd10). An unchanged group touches no
		# clip; a new one leaves and re-enters the live states 9 (move), 3
		# (stand -> 8, idle or stance) and 6 (sit), each of which plays its
		# loop in the new group from its first frame over the old (100 ms for
		# the run, 200 for the rest: animation_mixer.md).
		_other_gaits[character_id] = {"skeleton": skeleton, "body": body, "scale": scale, "group": group, "moving": moving, "sitting": sitting}
		_held_rebuilt(character_id)
		if regrouped:
			# Its loop in the new group; the clip already playing is restarted
			# from its first frame (the mixer's replay, 0xc55360), any other
			# swapped in with the state's fades.
			var action := BsrReader.AnimationEntry.TYPE_SITTING if sitting else _other_loop_action(character_id)
			var want := _body_animation_for(body, action, group)
			var entry := _animated_loop_entry(skeleton)
			if not entry.is_empty() and entry[1] == want:
				entry[3] = -_idle_anim_time
				entry[5] = _idle_anim_time
			elif sitting:
				if _frame_count(want) > 1:
					_swap_other_loop(skeleton, want, [], _loop_in_ms(action))
			else:
				_refresh_other_loop(character_id)
	else:
		# No entry to carry (a body not posed yet): its loop from the start.
		_other_gaits[character_id] = {"skeleton": skeleton, "body": body, "scale": scale, "group": group, "moving": false, "sitting": sitting}
		_held_rebuilt(character_id)
		var action := BsrReader.AnimationEntry.TYPE_SITTING if sitting else BsrReader.AnimationEntry.TYPE_STAND
		var loop := _body_animation_for(body, action, group)
		var frames := _frame_count(loop)
		if frames > 1:
			_animated.append([skeleton, loop, frames, 0.0, true, _idle_anim_time, null])
		if moving:
			_set_other_gait(character_id, true)
	node.remove_meta(CharacterLight.META_VALUE)
	_light_character(node)

## Round 831: every clip entry of `old` in _animated (its loop, a one-shot
## and the loop it resumes) now drives `fresh`, its clip, phase and start
## kept. Returns how many entries moved.
func _repoint_animated(old: Skeleton3D, fresh: Skeleton3D) -> int:
	var moved := 0
	for entry in _animated:
		if entry[0] == old:
			entry[0] = fresh
			moved += 1
		if entry.size() > 6 and entry[6] is Array and not (entry[6] as Array).is_empty() and entry[6][0] == old:
			entry[6][0] = fresh
	return moved

## Another player's position (OpEntityMoved): their body's new walk target,
## and (round 637) the heading toward it, which the body turns to at the
## client's own rate (RemoteFacing; _step_remote_turns). OpenSRO streams
## positions, not retail's destinations (0xB021), so each position is the
## destination the client's mover would aim at from where the body is drawn
## (FUN_009e0550 aims from the object's own position, +0x74). Nothing turns
## the body once the positions stop, so it keeps its last heading.
##
## A relocation (moved.relocated, round 637's review follow-up: a teleport,
## a recovery, a placement) puts the body there and turns nothing, as the
## client places an object at a message's source position (FUN_009e11e0)
## without aiming it; a turn already in progress goes on.
func _on_entity_moved(moved: WorldNet.EntityMoved) -> void:
	if _qa_move_log:
		print("MOVE recv %d ms=%d pos=(%.3f,%.3f)%s%s" % [moved.character_id, Time.get_ticks_msec(), moved.x, moved.z,
			" relocated" if moved.relocated else "", (" heading=%d" % moved.heading_wire) if moved.heading_wire >= 0 else ""])
	if _arrival_pending and _arrival_entries.has(moved.character_id):
		var kept: WorldNet.EntitySnapshot = _arrival_entries[moved.character_id]
		kept.x = moved.x
		kept.y = moved.y
		kept.z = moved.z
		return
	if _other_bodies.has(moved.character_id):
		var to := Vector3(moved.x, moved.y, moved.z)
		_other_body_targets[moved.character_id] = to
		_other_awake[moved.character_id] = true
		var body: Node3D = _other_bodies[moved.character_id]
		if moved.relocated:
			body.position = to
			_other_moved(body)
			return
		# A sitter still waiting to be dressed who walks off is on their feet
		# (round 739's review, F2): the server sends no stand for it (its
		# move handler stands them), and a dressed body's gait would have
		# cleared the seat at its first step (_set_other_gait).
		if _other_build_args.has(moved.character_id):
			_other_seated.erase(moved.character_id)
		# Round 653: a heading run faces its heading (retail's echo of the
		# heading form, FUN_008a5750 -> FUN_009e08a0 -> FUN_009e02f0, turns
		# the mover to it at 3 pi rad/s), not the next position.
		if moved.heading_wire >= 0:
			var hf := RemoteFacing.facing_of(RemoteFacing.from_wire_angle(moved.heading_wire))
			_aim_remote_body(body, Vector3(hf.x, 0.0, hf.y), 0.0)
			return
		_aim_remote_body(body, to - body.position, 0.0)

## Round 749: another player's run speed from a buff packet (0: unchanged).
func _note_other_speed(character_id: int, run_speed: int) -> void:
	# Round 796: a rider moves at its mount's speed whatever its buffs.
	if run_speed <= 0 or _riders.has(character_id):
		return
	_other_speeds[character_id] = float(run_speed)
	var leg = _other_legs.get(character_id)
	if leg != null:
		leg["speed"] = float(run_speed)

func _other_speed(character_id: int) -> float:
	# A walker's legs at its walk speed (round 781, _apply_other_walk_mode);
	# a walking rider's at its mount's (round 798).
	if _other_walking.has(character_id):
		var mount_walk := _rider_walk_speed(character_id)
		if mount_walk > 0.0:
			return mount_walk
		return float(_other_walking[character_id])
	return float(_other_speeds.get(character_id, OtherWalk.DEFAULT_SPEED))

## Round 749: retail's 0xB021 (NetProcessInNavAndSkill::FUN_008a5750), an
## accepted move. Another player's body walks it (OtherWalk): from where it is
## drawn (or the source, when it has drifted), toward the destination or
## along the heading, at its run speed, turning at 3 pi rad/s
## (_aim_remote_body). This player's own echo is its receipt: its walk began
## on the click (MoveOrderSync), so nothing changes -- no rubber-banding.
func _on_entity_move_echo(echo: DestMoveNet.Echo) -> void:
	_sync_own_id()
	# Round 795: a COS's (or the ridden one's, which is the rider's) move.
	if _cos_move_echo(echo):
		return
	var id := int(echo.uid)
	if _own_id() >= 0 and id == (_own_id() & 0xffffffff):
		if _qa_move_log:
			print("MOVE echo self ms=%d kind=%d dest=(%.3f,%.3f)" % [Time.get_ticks_msec(), echo.kind, echo.dest_world.x, echo.dest_world.z])
		# Round 749's review, F3: it confirms the order it names; round 846:
		# and says when the server's leg is over (MoveOrderSync.held).
		_move_sync.confirm(echo.kind, echo.dest_world, echo.angle, _own_leg_free_ms(echo))
		return
	var other := _other_by_uid(id)
	if other >= 0:
		id = other
	if _qa_move_log:
		print("MOVE recv %d ms=%d 0xB021 kind=%d dest=(%.3f,%.3f) src=(%.3f,%.3f)" % [id, Time.get_ticks_msec(), echo.kind,
			echo.dest_world.x, echo.dest_world.z, echo.source_world.x, echo.source_world.z])
	var leg := OtherWalk.to_point(echo.dest_world, _other_speed(id)) if echo.kind == DestMoveNet.KIND_DESTINATION \
		else OtherWalk.on_heading(echo.angle, _other_speed(id))
	if _arrival_pending and _arrival_entries.has(id):
		# Laid out with the arrival list: it walks on from there.
		var kept: WorldNet.EntitySnapshot = _arrival_entries[id]
		if echo.has_source:
			kept.x = echo.source_world.x
			kept.y = echo.source_world.y
			kept.z = echo.source_world.z
		kept.has_dest = echo.kind == DestMoveNet.KIND_DESTINATION
		kept.dest = echo.dest_world
		kept.run_wire = echo.angle if echo.kind == DestMoveNet.KIND_HEADING else -1
		return
	if not _other_bodies.has(id):
		return
	var body: Node3D = _other_bodies[id]
	body.position = OtherWalk.start_at(body.position, echo.source_world, echo.has_source)
	# Round 846 (READ, FUN_009e0550): a body drawn behind where the server has
	# its mover walks on from there, faster, to reach the point with it.
	if echo.kind == DestMoveNet.KIND_DESTINATION:
		leg["mult"] = OtherWalk.catch_up(body.position, echo.source_world, echo.has_source, echo.dest_world)
	if _qa_move_log:
		print("MOVE leg %d ms=%d from (%.3f,%.3f) x%.2f" % [id, Time.get_ticks_msec(), body.position.x, body.position.z, float(leg.get("mult", 1.0))])
	# A sitter still waiting to be dressed who walks off is on their feet
	# (round 739's review, F2): the server's move stands them, no 0x30BF.
	if _other_build_args.has(id):
		_other_seated.erase(id)
	_start_other_leg(id, leg)

## Round 846: when the server's leg this player's own 0xB021 names is over at
## the latest (MoveOrderSync.confirm): now plus its length from the source to
## the destination at the speed this player walks it; -1 for a heading run or
## an echo with no source.
func _own_leg_free_ms(echo: DestMoveNet.Echo) -> int:
	if echo.kind != DestMoveNet.KIND_DESTINATION or not echo.has_source:
		return -1
	var length := Vector2(echo.dest_world.x - echo.source_world.x, echo.dest_world.z - echo.source_world.z).length()
	var speed := maxf(_gait_speed(), 1.0)
	return Time.get_ticks_msec() + int(ceil(length / speed * 1000.0))

## Starts `leg` on another player's body (OtherWalk), turned toward it.
## Round 852: told whether it meets a wall (_plan_body_leg).
func _start_other_leg(id: int, leg: Dictionary) -> void:
	var body: Node3D = _other_bodies[id]
	_plan_body_leg(leg, body.position)
	_other_legs[id] = leg
	_other_body_targets[id] = body.position
	_other_awake[id] = true
	# Off its target's rest (round 748's settled mark), and a far body's
	# transform re-read at the frame's flush (round 747): the echo may have
	# put it at the source.
	_other_settled.erase(id)
	_other_awake[id] = true
	_other_moved(body)
	var fs := FrameSplit.on
	var t0 := Time.get_ticks_usec() if fs else 0
	_aim_remote_body(body, OtherWalk.facing(leg, body.position), 0.0)
	var t1 := Time.get_ticks_usec() if fs else 0
	_set_other_gait(id, true)
	if fs:
		FrameSplit.add("o_start_aim", t1 - t0)
		FrameSplit.add("o_start_gait", Time.get_ticks_usec() - t1)

## Round 852 (OURS): the most a frame spends walking legs' plans
## (_plan_body_leg). MEASURED (tools/walk_probe.gd --bench-legs=2000, Jangan
## 97/168): a plan is 146 us at the median, 652 at the 99th percentile -- a
## crowd's every leg at once would freeze the frame. A leg the frame has no
## room for walks straight on and is planned from where it is drawn on a
## later frame ("plan").
const BODY_PLAN_BUDGET_USEC := 1500
var _body_plan_frame := -1
var _body_plan_spent := 0

## Round 852: `leg` (an OtherWalk leg, from `from`) walked once on the graph
## under the body (BodyWalk.plan): clear, it is the straight step; walled, its
## end becomes the wall's stop ("dest", and "wall" true), where the straight
## step stops as the frame-by-frame walk would; one the walk cannot answer --
## and a heading run -- is walked through the graph a frame at a time
## ("walled", _body_walk_step). Over the frame's budget: "plan", done later
## (the step loops call this again while it is set).
func _plan_body_leg(leg: Dictionary, from: Vector3) -> void:
	leg.erase("on")
	leg.erase("graph")
	if bool(leg.get("run", false)):
		leg["walled"] = true
		leg.erase("plan")
		return
	var f := Engine.get_process_frames()
	if f != _body_plan_frame:
		_body_plan_frame = f
		_body_plan_spent = 0
	if _body_plan_spent >= BODY_PLAN_BUDGET_USEC:
		leg["walled"] = false
		leg["plan"] = true
		return
	leg.erase("plan")
	var t0 := Time.get_ticks_usec()
	var dest: Vector3 = leg["dest"]
	var pair := _nav_graph_for(from)
	var p := BodyWalk.plan(null if pair.is_empty() else pair[0],
		Transform3D.IDENTITY if pair.is_empty() else (pair[1] as Node3D).global_transform, from, Vector2(dest.x, dest.z))
	var kind := int(p["kind"])
	leg["walled"] = kind == BodyWalk.FRAMES
	if kind == BodyWalk.STOP:
		var stop: Vector2 = p["stop"]
		leg["dest"] = Vector3(stop.x, dest.y, stop.y)
		leg["wall"] = true
		# Turned toward the end it was told of (OtherWalk.facing).
		leg["aim"] = dest
		if _qa_move_log:
			print("MOVE plan ms=%d from (%.3f,%.3f) to (%.3f,%.3f): a wall at (%.3f,%.3f)" % [
				Time.get_ticks_msec(), from.x, from.z, dest.x, dest.z, stop.x, stop.y])
	var spent := Time.get_ticks_usec() - t0
	_body_plan_spent += spent
	if FrameSplit.on:
		FrameSplit.add("o_leg_plan", spent)

## Round 852: one frame of a walled leg, from `from` (the body's drawn place)
## to `next` (x, z), walked on the graph under the body with no slide
## (BodyWalk.step, READ c:0x9e0fca: every mover's step meets the walls).
## leg["blocked"] is true when a wall ended it.
func _body_walk_step(leg: Dictionary, from: Vector3, next: Vector2) -> Vector2:
	var pair := _nav_graph_for(from)
	return BodyWalk.step(leg, null if pair.is_empty() else pair[0],
		Transform3D.IDENTITY if pair.is_empty() else (pair[1] as Node3D).global_transform, from, next)

## A spawn that names a move (round 749: the record's mover, 0x48be00) walks
## on, as FUN_009ca320 aims a body that spawned moving; and its run speed is
## kept.
func _resume_other_leg(snapshot: WorldNet.EntitySnapshot) -> void:
	var id := snapshot.character_id
	if snapshot.run_speed > 0.0:
		_other_speeds[id] = snapshot.run_speed
	# Its run flag (round 781): 0 walks, at the record's walk speed.
	if snapshot.walk_speed > 0.0:
		_other_walking[id] = snapshot.walk_speed
	else:
		_other_walking.erase(id)
	if not _other_bodies.has(id):
		return
	if snapshot.has_dest:
		_start_other_leg(id, OtherWalk.to_point(snapshot.dest, _other_speed(id)))
	elif snapshot.run_wire >= 0:
		_start_other_leg(id, OtherWalk.on_heading(snapshot.run_wire, _other_speed(id)))
	else:
		_other_legs.erase(id)

## Round 749: retail's 0xB023 (FUN_008a4f80): a stop or placement. Another
## player's body is put there, facing the message's angle, its turn and its
## leg over (FUN_009e00f0 / FUN_009e11e0). For this player it is the server's
## correction -- a stop or placement it did not take -- and the player is
## put where the server has it.
func _on_entity_move_stop(stop: DestMoveNet.Stop) -> void:
	_sync_own_id()
	if _cos_move_stop(stop):
		return
	var id := int(stop.uid)
	var h := RemoteFacing.from_wire_angle(stop.angle)
	if _own_id() >= 0 and id == (_own_id() & 0xffffffff):
		if _own_arrow_stop(stop.world, h):
			return
		_apply_own_correction(stop.world, h)
		return
	var other := _other_by_uid(id)
	if other >= 0:
		id = other
	if _qa_move_log:
		print("MOVE recv %d ms=%d 0xB023 pos=(%.3f,%.3f)" % [id, Time.get_ticks_msec(), stop.world.x, stop.world.z])
	if _arrival_pending and _arrival_entries.has(id):
		var kept: WorldNet.EntitySnapshot = _arrival_entries[id]
		kept.x = stop.world.x
		kept.y = stop.world.y
		kept.z = stop.world.z
		kept.has_dest = false
		kept.run_wire = -1
		kept.heading = h
		return
	if not _other_bodies.has(id):
		return
	_other_stop_at(id, stop.world, h)

## Round 846 (READ, c:FUN_008a4f80): a stop ends the mover's movement and
## snaps its heading to the message's angle (FUN_009e00f0 -> FUN_009e0050), and
## its point goes through the same placement as 0xB021's source,
## FUN_009e11e0(..., 0), which re-places the drawn body only when it is more
## than 50.0 from it (FUN_009e1050, 0xd8f0b0). So a body up to 50 off is not
## put there: it walks the rest, at OtherWalk.CATCH_UP_MAX times its speed (OURS:
## the factor FUN_009e0550 gives a mover already on its point, 0xe1b808; how
## retail's drawn object meets the record after a stop was not read), facing
## the message's angle, and stands. An arrow key's stop at a raised /speed is
## the case: the body was within a few units of the server's point, and was
## put there in one frame (MEASURED, round 846: 0.1-19 units at 7x).
func _other_stop_at(id: int, at: Vector3, h: float) -> void:
	var body: Node3D = _other_bodies[id]
	_other_legs.erase(id)
	body.rotation.y = RemoteFacing.yaw_of(h, 0.0)
	_remote_turns.erase(body.get_instance_id())
	_other_awake[id] = true
	var off := Vector2(at.x - body.position.x, at.z - body.position.z).length()
	if not OtherWalk.stop_walks(body.position, at):
		body.position = at
		_other_body_targets[id] = at
		_set_other_gait(id, false)
		# Standing on its target (round 748: _step_other_bodies passes over it),
		# and a far body re-read at the flush (round 747).
		_other_settled[id] = true
		_other_moved(body)
		return
	_other_legs[id] = OtherWalk.to_point(at, _other_speed(id), OtherWalk.CATCH_UP_MAX)
	_plan_body_leg(_other_legs[id], body.position)
	_other_body_targets[id] = body.position
	_other_settled.erase(id)
	_other_moved(body)
	if _qa_move_log:
		print("MOVE leg %d ms=%d from (%.3f,%.3f) stop %.3f off x%.2f" % [id, Time.get_ticks_msec(), body.position.x, body.position.z, off, OtherWalk.CATCH_UP_MAX])

## Round 808: 0xB024 (c:0x8a4ec0, READ): another body's new heading, the
## arrow keys' turn. This player's own is ignored; another body (or the rider
## of the COS named) turns toward it at 3 pi rad/s (FUN_009e02f0), and its
## heading run, if it runs one, bends there and goes on (FUN_009e0090).
func _on_entity_turned(uid: int, angle: int) -> void:
	_sync_own_id()
	if _own_id() >= 0 and uid == (_own_id() & 0xffffffff):
		return
	if NetClient.riding_mount != 0 and uid == NetClient.riding_mount:
		return
	var id := uid
	if _cos_recs.has(uid):
		id = _cos_rider_of(uid)
		if id < 0:
			return
	else:
		var other := _other_by_uid(uid)
		if other >= 0:
			id = other
	var h := RemoteFacing.from_wire_angle(angle)
	if _qa_move_log:
		print("MOVE recv %d ms=%d 0xB024 heading=%.4f" % [id, Time.get_ticks_msec(), h])
	if _arrival_pending and _arrival_entries.has(id):
		var kept: WorldNet.EntitySnapshot = _arrival_entries[id]
		kept.heading = h
		if kept.run_wire >= 0:
			kept.run_wire = angle
		return
	if not _other_bodies.has(id):
		return
	var body: Node3D = _other_bodies[id]
	var leg = _other_legs.get(id)
	if leg != null and bool((leg as Dictionary)["run"]):
		_other_legs[id] = OtherWalk.on_heading(angle, float((leg as Dictionary)["speed"]))
	_remote_turns[body.get_instance_id()] = {"target": h, "front": 0.0}
	_other_awake[id] = true
	_other_moved(body)

## The server did not take this player's stop or placement (round 749,
## destmove.go correctMover) -- or anything that moved it out of its walk's
## reach: it stands where the server has it, its order over.
func _apply_own_correction(at: Vector3, heading: float) -> void:
	print("MOVE correction: the server has this player at (%.2f, %.2f, %.2f), the client at (%.2f, %.2f, %.2f) -- put there" % [
		at.x, at.y, at.z, player.position.x, player.position.y, player.position.z])
	_has_move_target = false
	_move_heading_run = false
	player.velocity = Vector3.ZERO
	# Stood on the ground the walk stands on (round 749's verification): the
	# walkable graph's surface nearest the server's height, as a skill move's
	# landing is settled (the walk's own footing carried from there), the
	# terrain ray only where no graph is loaded -- the terrain-only ray put a
	# player corrected on a bridge or a deck under it.
	player.position = _ground_on_walk_surface(at)
	player.rotation.y = RemoteFacing.yaw_of(heading, 0.0)
	_player_turn_target = NAN
	_relocated_pending = false
	# Round 749's verification (FP1-FP3): a stop answers a correction only
	# when a 0x7021 may still be in flight -- the server would take it after
	# this and start a leg from here that this client does not walk; the stop
	# here ends it (on that leg at its start, so the server takes it) -- and
	# never twice for the same server point (MoveOrderSync.corrected). Any
	# other correction is the server's last word: nothing is sent, so no
	# correction can loop.
	var answer := _move_sync.corrected(at)
	_last_sent_pos = player.position
	_walked_since_send = 0.0
	_time_since_send = 0.0
	if answer:
		_send_stop()

## A point the server named (its correction, its /unstuck), stood on the ground
## the walk stands on: the walkable graph's surface at its (x, z) under its
## height -- or, near the player, under the player's own (round 822,
## NavGraph.correction_surface: the server's height is a guess, and a guess
## under a bridge deck put a rider crossing it on the river bed) -- the walk's
## footing settled there as a skill move's is; else the terrain ray, else the
## point as it is.
func _ground_on_walk_surface(at: Vector3) -> Vector3:
	var pair := _nav_graph_for(at)
	if pair.is_empty():
		var ground := _terrain_hit_height(at)
		if not is_nan(ground):
			at.y = ground
		return at
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	var local := group.to_local(at)
	# The player's own position in the same graph's space, when the walk left
	# it there (a player moved by something else, or off this graph, has none
	# to keep: the server's height decides).
	var own := Vector3(NAN, NAN, NAN)
	if _nav_footing_graph == graph and player.global_position.distance_to(_nav_footing_pos) <= NAV_FOOTING_RESETTLE_DISTANCE:
		own = group.to_local(player.global_position)
	var surface := graph.correction_surface(local.x, local.z, local.y, own)
	_nav_footing = surface.object_index
	_nav_footing_graph = graph
	var spot := group.to_global(Vector3(local.x, surface.height, local.z))
	_nav_footing_pos = spot
	return spot

## Round 749: one frame of every other player's leg (OtherWalk.step), before
## the eased bodies: the body steps along it at its run speed and its height is
## resolved from the ground as it goes (MonsterMotion.needs_height, a budget a
## frame -- the monsters' rule). A leg that lands on its point ends.
##
## The arrival's height takes the same budget (round 749's merge with 747/748,
## MEASURED at 1000 walking by retail's 0xB021 a body a second: 12.8 ms a
## frame of height rays when every arrival took one outside it). One that finds
## the budget spent stands where its last resolve put it and waits on
## _other_heights_pending, served first the next frame.
##
## Round 757: the frame's heights are found together, on WorkerThreadPool's
## threads (HeightBatch: the walkable graph's landing height, plain data), and
## applied after; a point with no loaded graph under it takes the terrain ray
## on the main thread as before. With the work spread, the budget a frame is
## OTHER_HEIGHT_BUDGET (OURS) instead of the monsters' 32.
const OTHER_HEIGHT_BUDGET := 128
var _height_batch := HeightBatch.new()

func _step_other_legs(delta: float) -> void:
	# Round 757's review, F3: the helpers' groups left from earlier frames freed.
	HeightBatch.reap()
	if _other_legs.is_empty() and _other_heights_pending.is_empty():
		return
	var fs := FrameSplit.on
	var t_legs := Time.get_ticks_usec() if fs else 0
	var g_usec := 0
	var budget := OTHER_HEIGHT_BUDGET
	# The frame's points: [kind (0 a landing that waited, 1 a leg), id, body,
	# point, result Dictionary or null, xz], and where each gets its height.
	var asks: Array = []
	var ask_index := PackedInt32Array()
	var ask_height := PackedFloat32Array()
	_height_batch.clear()
	for id in _other_heights_pending.keys():
		if budget <= 0:
			break
		_other_heights_pending.erase(id)
		var standing = _other_bodies.get(id)
		if standing == null or not is_instance_valid(standing) or _other_legs.has(id):
			continue
		budget -= 1
		asks.append([0, id, standing, (standing as Node3D).position, null, Vector2.ZERO])
	var stepped: Array = []
	for id in _other_legs.keys():
		var body = _other_bodies.get(id)
		if body == null or not is_instance_valid(body):
			_other_legs.erase(id)
			continue
		var leg: Dictionary = _other_legs[id]
		if leg.has("plan"):
			_plan_body_leg(leg, (body as Node3D).position)
		var r := OtherWalk.step(leg, (body as Node3D).position, delta)
		var at: Vector3 = r["pos"]
		# Round 852: a leg that meets a wall is walked through the graph, and
		# the wall ends it there (BodyWalk; READ c:0x9e0fca).
		if bool(leg.get("walled", false)):
			var walked := _body_walk_step(leg, (body as Node3D).position, Vector2(at.x, at.z))
			at.x = walked.x
			at.z = walked.y
			r["pos"] = at
			if bool(leg.get("blocked", false)):
				r["done"] = true
				if _qa_move_log:
					print("MOVE wall %d ms=%d at (%.3f,%.3f)" % [id, Time.get_ticks_msec(), at.x, at.z])
		var xz := Vector2(at.x, at.z)
		var done := bool(r["done"])
		var entry := [1, id, body, at, r, xz, leg, -1]
		if done and budget <= 0:
			_other_heights_pending[id] = true
		elif budget > 0 and (done or MonsterMotion.needs_height(leg["h_xz"], xz)):
			budget -= 1
			entry[7] = asks.size()
			asks.append(entry)
		stepped.append(entry)
	# The heights: the graph's on the pool, the terrain ray here. The loaded
	# regions' transforms are read once for the frame (_nav_graph_for reads
	# each region group's transform per point).
	var th := Time.get_ticks_usec() if fs else 0
	ask_index.resize(asks.size())
	ask_height.resize(asks.size())
	var regions: Array = []
	if not asks.is_empty():
		for pair in _grid.nav_graph_pairs():
			var xf: Transform3D = (pair[1] as Node3D).global_transform
			regions.append([pair[0], xf, xf.affine_inverse()])
	for i in range(asks.size()):
		var point: Vector3 = asks[i][3]
		var found := -1
		var local := Vector3.ZERO
		for ri in range(regions.size()):
			local = (regions[ri][2] as Transform3D) * point
			if (regions[ri][0] as NavGraph).dungeon \
					or (local.x >= 0.0 and local.z >= 0.0 and local.x <= REGION_SPAN and local.z <= REGION_SPAN):
				found = ri
				break
		if found < 0:
			ask_index[i] = -1
			ask_height[i] = _terrain_hit_height(point)
		else:
			# A dungeon's floors stack: the point's own height picks one.
			ask_index[i] = _height_batch.add(regions[found][0], regions[found][1], local.x, local.z,
				local.y if (regions[found][0] as NavGraph).dungeon else NAN)
	if _height_batch.size() > 0:
		_height_batch.resolve()
	for i in range(asks.size()):
		if ask_index[i] >= 0:
			ask_height[i] = float(_height_batch.out[ask_index[i]])
	if fs:
		FrameSplit.add("o_leg_h", Time.get_ticks_usec() - th)
		if _height_batch.last_threaded:
			FrameSplit.add("o_leg_h_threaded_calls", 1000)
			# Points a pool helper did, in thousandths (the rest: the main thread).
			FrameSplit.add("o_leg_h_helped_calls", _height_batch.last_by_helpers * 1000)
	# The landings that waited.
	for i in range(asks.size()):
		var a: Array = asks[i]
		if int(a[0]) != 0:
			continue
		var standing: Node3D = a[2]
		var spot: Vector3 = a[3]
		var ground0 := ask_height[i]
		if is_nan(ground0) or ground0 == spot.y:
			continue
		spot.y = ground0
		standing.position = spot
		_other_body_targets[a[1]] = spot
		_other_awake[a[1]] = true
		_other_moved(standing)
	# The legs.
	for entry in stepped:
		var id: int = entry[1]
		var body: Node3D = entry[2]
		var at: Vector3 = entry[3]
		var r: Dictionary = entry[4]
		if int(entry[7]) >= 0:
			var ground := ask_height[int(entry[7])]
			if not is_nan(ground):
				at.y = ground
				(entry[6] as Dictionary)["h_xz"] = entry[5]
		body.position = at
		_other_body_targets[id] = at
		# A far body's transform is re-read at the frame's flush (round 747).
		_other_moved(body)
		# Every frame, so a body dressed mid-leg (round 739's queue) takes its
		# run at once; a no-op once it plays it (round 748's swap hint keeps it
		# cheap).
		var tg := Time.get_ticks_usec() if fs else 0
		_set_other_gait(id, not bool(r["done"]))
		if fs:
			g_usec += Time.get_ticks_usec() - tg
		if bool(r["done"]):
			_other_legs.erase(id)
			# On its point and standing: the eased pass skips it (round 748).
			_other_settled[id] = true
	if fs:
		FrameSplit.add("o_legs", Time.get_ticks_usec() - t_legs)
		FrameSplit.add("o_leg_gait", g_usec)

## Round 757: every place that moves or turns another player's holder reports
## it here, once a move: CrowdGpu re-reads a far body's transform at its flush
## (round 747), the minimap's signs (MinimapSigns) and the batched name plates
## (NamePlateBatch) take the new place at their next refresh -- so none of them
## walks every body every frame. A body moved by a path that does not report is
## caught by each consumer's spread re-read.
func _other_moved(body: Node3D) -> void:
	if _crowd_gpu != null:
		_crowd_gpu.moved(body)
	_minimap_moved[body] = true
	_plates_moved[body] = true

## Round 749's merge: other players whose arrival found the frame's height
## budget spent (id -> true), resolved first the next frame (_step_other_legs).
var _other_heights_pending := {}

## Another player left (0x3016, a group despawn's every id). Round 762: taken
## at once while the frame's DEPART_BUDGET_USEC lasts, else queued and taken
## from _depart_step a frame's share at a time, oldest first -- a crowd of
## 4,000 leaving at once is one 0x3018 (READ: retail handles them all in that
## call). A queued player who comes back first is taken then (_spawn_or_update_other).
func _on_entity_left(character_id: int) -> void:
	_depart_roll()
	if _depart_ids_at < _depart_ids.size() or _depart_spent_usec >= DEPART_BUDGET_USEC or OtherCrowd.FrameBudget.left() <= 0:
		if not _depart_pending.has(character_id):
			_depart_pending[character_id] = true
			_depart_ids.append(character_id)
			# Not dressed nor made a ghost while it waits to go.
			_other_builds.drop(character_id)
			_other_ghosts.drop(character_id)
		return
	var t := Time.get_ticks_usec()
	_on_entity_left_now(character_id)
	_depart_spent_usec += Time.get_ticks_usec() - t
	OtherCrowd.FrameBudget.spend(Time.get_ticks_usec() - t)

## The departures' share of this frame: started again each frame.
func _depart_roll() -> void:
	var f := Engine.get_process_frames()
	if f != _depart_frame:
		_depart_frame = f
		_depart_spent_usec = 0

func _on_entity_left_now(character_id: int) -> void:
	var tl := Time.get_ticks_usec() if FrameSplit.on else 0
	if _hud_minimap != null and is_instance_valid(_hud_minimap):
		_hud_minimap.drop_other(character_id)
	_other_legs.erase(character_id)
	_other_heights_pending.erase(character_id)
	_other_speeds.erase(character_id)
	_other_walking.erase(character_id)
	if _arrival_pending:
		_arrival_entries.erase(character_id)
		_arrival_left[character_id] = true
	if character_id == _selected_character:
		_selected_character = -1
		_clear_target()
	if not _pending_friend_cast.is_empty() and int(_pending_friend_cast["character"]) == character_id:
		print("World3D: player %d left before the walk reached them -- friendly cast dropped" % character_id)
		_drop_pending_attack()
	# A departing body stops running before it fades (OURS, as a monster's
	# does in _free_monster_body: whether retail's mover runs on during the
	# 1.5 s was not read). Round 762: a far body (CrowdGpu) fades out where it
	# is drawn, on the GPU (_fade_out_body), and keeps its loop: it was
	# brought back to the full path to fade, so a crowd leaving at once was
	# thousands of bodies posed and drawn on the CPU for 1.5 s (MEASURED
	# r762.md: 48-50 ms frames at 1,000 against a 14 ms crowd).
	var gone_skel = (_other_gaits.get(character_id, {}) as Dictionary).get("skeleton")
	if _crowd_gpu == null or gone_skel == null or not is_instance_valid(gone_skel) or not _crowd_gpu.has(gone_skel):
		_crowd_wake(gone_skel)
		_set_other_gait(character_id, false)
	var gone_gait: Dictionary = _other_gaits.get(character_id, {})
	if gone_gait.has("skeleton") and is_instance_valid(gone_gait["skeleton"]):
		_other_hint_by_skel.erase((gone_gait["skeleton"] as Object).get_instance_id())
	_other_gaits.erase(character_id)
	_other_settled.erase(character_id)
	_other_awake[character_id] = true
	_other_looks.erase(character_id)
	# Gone before their turn to be dressed came (round 739, B4).
	_other_builds.drop(character_id)
	_other_build_args.erase(character_id)
	_other_ghosts.drop(character_id)
	_ghost_ids.erase(character_id)
	_ghost_moving.erase(character_id)
	_ghost_refused.erase(character_id)
	_ghost_queued_ms.erase(character_id)
	_page_unwait(character_id)
	_other_builds.forget(character_id)
	_other_uids.remove(character_id)
	SkillEffects.detach_owner(_fx_owner_key(character_id, 0))
	_target_buff_book.drop(_fx_owner_key(character_id, SkillNet.OWNER_CHARACTER))
	_abnormal_states.erase(_fx_owner_key(character_id, SkillNet.OWNER_CHARACTER))
	_fx_owner_buffs.erase(_fx_owner_key(character_id, 0))
	_other_seated.erase(character_id)
	# A monster's blow on this player may cross the notice (round 546,
	# MonsterStrikes.is_own_unpaired); remembered for the grace window.
	var now_ms := Time.get_ticks_msec()
	# Round 762: oldest first (each id is put at the end), so the expired
	# ones are a run at the front -- not a pass over every one (a crowd of
	# 4,000 leaving at once made that 8 million steps in one frame).
	var expired: Array = []
	for id in _recently_left:
		if now_ms - int(_recently_left[id]) <= MonsterStrikes.LEFT_GRACE_MS:
			break
		expired.append(id)
	for id in expired:
		_recently_left.erase(id)
	_recently_left.erase(character_id)
	_recently_left[character_id] = now_ms
	if _other_bodies.has(character_id):
		var body: Node3D = _other_bodies[character_id]
		var departing_name := "Someone"
		for child in body.get_children():
			if child is Label3D:
				departing_name = child.text
				break
		# A body not dressed yet has no plate (round 739, B4): its name is on
		# the node.
		if departing_name == "Someone" and body.has_meta("character_name"):
			departing_name = String(body.get_meta("character_name"))
		# They fade out over 1.5 s (round 677; READ: CICUser's vslot 0x4c,
		# 0x9daf10, ends in IGIDObject::FUN_009c32f0's CIDecoDisappear -- but
		# for its modes 4/6/7, which this client does not draw), no longer
		# their body: coming back is a fresh body fading in. Round 762: its
		# plate, circle and click body go now; its holder is freed from the
		# free queue when the fade is over.
		var ta := Time.get_ticks_usec() if FrameSplit.on else 0
		# Round 762's review, F1: a ghost's weapon particles go with it.
		_ghost_fx_off(body)
		_depart_teardown(body)
		var tb := Time.get_ticks_usec() if FrameSplit.on else 0
		_fade_out_body(body, false)
		if FrameSplit.on:
			FrameSplit.add("dep_teardown", tb - ta)
			FrameSplit.add("dep_fade", Time.get_ticks_usec() - tb)
		_other_bodies.erase(character_id)
		_other_body_targets.erase(character_id)
		# Only a real leave of the zone (OpPlayerZoneNotice, round 737's
		# review), not a walk out of view.
		if NetClient.zone_departures.has(character_id):
			_log_system("%s left the zone." % departing_name)
	NetClient.zone_departures.erase(character_id)
	if FrameSplit.on:
		FrameSplit.add("w_left", Time.get_ticks_usec() - tl)

## Sends a real OpChangeZone for a zone typed in the debug panel's zone box
## (dev-only since round 848; the native zone box beside the player block is
## gone -- players travel by the teleport gates, GMs by /tp and /goto).
## _on_change_zone_result (connected in _ready()) handles the reply --
## success reloads real terrain/objects for the new
## zone, failure is silently ignored here (no dedicated error UI for this
## yet, same honest scope as the rest of this scene's dev-facing controls).
## The region-local spot a zone change should land on, parsed out of the
## zone box's optional `@x,z` suffix and consumed by
## _on_change_zone_result once the new region has actually loaded. null
## means "wherever the server puts us", the original behavior.
var _pending_zone_local: Variant = null
## A GM /tp or /goto world position (Vector2 x,z) to stand at once a
## cross-zone change finishes loading; null when there is none.
var _pending_gm_pos: Variant = null

## Splits what was typed into the zone box into the zone the server is
## asked for and an optional region-local spot to stand on afterwards:
## `97/168` keeps the server's own landing position, `97/168@1002,917`
## additionally walks the player to that spot in the new region.
##
## The suffix exists because the server has no map data at all (see
## ChangeZoneRequest in server/internal/session/world.go) -- it can only
## put an arriving player at one fixed position per zone, which in a
## region 1920 units across is rarely anywhere near what someone wanted to
## look at. Typing the coordinates the zone label already prints is the
## shortest path from "I want to see that" to standing there.
static func _split_zone_target(text: String) -> Dictionary:
	var at := text.find("@")
	if at < 0:
		return {"zone": text}
	var zone := text.substr(0, at).strip_edges()
	var parts := text.substr(at + 1).split(",")
	if parts.size() != 2:
		return {"zone": zone}
	var lx := parts[0].strip_edges()
	var lz := parts[1].strip_edges()
	if not lx.is_valid_float() or not lz.is_valid_float():
		return {"zone": zone}
	return {"zone": zone, "local": Vector2(float(lx), float(lz))}

## How far above the walkable graph's answer to look for a surface that is
## actually drawn there.
##
## The graph and the rendered world do not always agree: measured in Jangan
## town at local 985,1000, the graph reports terrain at -46.4 while the
## drawn surface is at -32.6, because the octagonal plaza is a placed object
## whose navigation mesh was never resolved into the graph. Standing on the
## graph's answer puts the player 13.8 units inside the plaza, which is what
## a zone change looked like.
##
## Bounded deliberately. An earlier probe cast from 200 units up and came
## back with 119.9 at one spot -- it had hit a gate roof, because
## TERRAIN_COLLISION_LAYER includes the default layer that map objects also
## use. Casting from just above the graph's answer finds the deck underfoot
## without finding the building over it.
const DRAWN_SURFACE_CLEARANCE := 30.0

## The height actually drawn at a region-local (x, z), if something is drawn
## within DRAWN_SURFACE_CLEARANCE of graph_height. Returns graph_height
## unchanged when nothing is, so a region whose graph and geometry agree is
## untouched.
func _drawn_surface_height(group: Node3D, local_x: float, local_z: float, graph_height: float) -> float:
	var space := get_world_3d().direct_space_state
	if space == null:
		return graph_height
	var top := group.to_global(Vector3(local_x, graph_height + DRAWN_SURFACE_CLEARANCE, local_z))
	var bottom := group.to_global(Vector3(local_x, graph_height - DRAWN_SURFACE_CLEARANCE, local_z))
	# Off the heightfield's grid lines (TerrainCollision.vertical_ray, round
	# 572): a zone's spawn is a round local position, often on one.
	var hit := TerrainCollision.vertical_ray(space, top.x, top.z, top.y, bottom.y,
		TERRAIN_COLLISION_LAYER, [player.get_rid()])
	if hit.is_empty():
		return graph_height
	var drawn: float = group.to_local(hit.position).y
	# Only ever lift, never drop: dropping would undo the graph's own answer
	# in the cases it gets right, and the failure being fixed is always
	# "standing inside something".
	return maxf(graph_height, drawn)

## Stands the player at a region-local (x, z) in one loaded region cell,
## at whatever height the real walkable graph reports there -- the same
## real signal ordinary movement stands on, so this lands on a staircase
## or a bridge deck rather than in the terrain under it.
func _place_at_region_local(region_x: int, region_y: int, local_x: float, local_z: float) -> bool:
	var pair := _grid.nav_graph_for_region(region_x, region_y)
	if pair.is_empty():
		return false
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	# Landing, not walking: someone placed into the world arrives from
	# above and comes to rest on the highest surface here.
	player.global_position = group.to_global(
		Vector3(local_x, graph.landing_height_at(local_x, local_z), local_z))
	player.velocity = Vector3.ZERO
	# Round 646: _last_sent_pos stays what the server has (the arrival point
	# a zone change or the world entry set it to), so the send loop reports
	# this placement at once. It used to be set to the placement, and nothing
	# went out until the player walked: the server -- and every other client
	# -- kept the character, and its buffs' auras, at the server's landing
	# (MEASURED live: after /goto jangan, A's client at the spawn spot, local
	# 1002,1020, and B drawing A and its Fire Wall inside the dragon's
	# pedestal at the square's centre).
	_walked_since_send = 0.0
	# The server still has the old position: the next OpMove is a relocation
	# (round 637's review follow-up).
	_relocated_pending = true
	return true

## A gate teleport's receipt (round 576, TeleportNet): on success the server's
## OpChangeZoneResult follows at once, and it is marked here as this
## teleport's arrival (_teleport_arrival_pending), whose position is kept. The
## receipt is a chat line in the archive's own format
## (TeleportNet.receipt_line), the place named through textdata_object; a
## refusal is ErrorText.teleport_line's.
func _on_teleport_result(result: TeleportNet.Result) -> void:
	if result == null:
		return
	if result.ok:
		_teleport_arrival_pending = true
		# The talk box and its list stay until the zone change that follows
		# (_close_gate_ui). The request stays pending until then too (round
		# 603's review): the server sends this receipt, then warpTo does its
		# per-entity work before OpChangeZoneResult, so the two can land in
		# different frames, and a click on a destination line between them
		# would send a second OpTeleportUse -- which the server, measuring the
		# range from where the first put the player (round 642's review),
		# refuses, but the click must not go out. _close_gate_ui clears it on
		# the arrival; a refused zone change clears it (_on_change_zone_result; the server
		# refunds a move that failed).
		var receipt := TeleportNet.receipt_line(_teleport_place_name(result.destination), result.fee, _ui_text_table)
		_log_system(receipt)
		print("World3D: teleport accepted -- to %s, %d gold charged, waiver %d: %s" % [result.destination, result.fee, result.waiver, receipt])
	else:
		# A refusal leaves the list up to choose again.
		_teleport_request_pending = false
		_log_system(ErrorText.teleport_line(result.code, _ui_text_table, result.reason))
		print("World3D: teleport refused -- code 0x%x (%s)" % [result.code, result.reason])

## The next OpChangeZoneResult is a gate teleport's arrival (round 576): set by
## an accepted OpTeleportResult, which the server sends just before it, and
## consumed by _on_change_zone_result.
var _teleport_arrival_pending := false
## A teleport arrival waiting to be stood on its ground, Vector2 world (x, z),
## or null: set by _on_change_zone_result, cleared by _step_teleport_landing
## once the point's region has a walkable graph, or after the zone's drain.
var _teleport_landing: Variant = null

## A destination's name for the receipt: its zone-name token (SN_ZONE_22002)
## through textdata_object, as every SN_ name is (_object_names), or "" --
## never the token itself.
func _teleport_place_name(token: String) -> String:
	var names := _object_names()
	if token == "" or names == null or not names.has(token):
		return ""
	var text := names.get_text(token).strip_edges()
	return "" if text == token else text

## Lands a pending teleport arrival if its region is built, else holds the
## player at the point: no walk, no fall (the region under it may be a
## neighbour cell still queued behind the loading screen -- Samarkand's gate
## stands in 106/108, beside its 106/107 centre).
func _step_teleport_landing() -> void:
	var spot: Vector2 = _teleport_landing
	if _land_teleport_arrival(spot.x, spot.y):
		_teleport_landing = null
		return
	player.position.x = spot.x
	player.position.z = spot.y
	player.velocity = Vector3.ZERO

## Stands the player at a world (x, z) on the walkable graph of the region
## under it, as _place_at_region_local stands a typed `@x,z` -- the height is
## the graph's landing height, not the server's 0. False when no loaded region
## holds the point. Prints the region-local spot, so a run measures where a
## teleport landed rather than inferring it from a picture.
func _land_teleport_arrival(x: float, z: float) -> bool:
	var pair := _nav_graph_for(Vector3(x, player.global_position.y, z))
	if pair.is_empty():
		return false
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	var local := group.to_local(Vector3(x, player.global_position.y, z))
	# The server's height picks the floor in a dungeon (round 773); the field
	# ignores it (landing_height_at).
	player.global_position = group.to_global(Vector3(local.x, graph.landing_height_at(local.x, local.z, local.y), local.z))
	player.velocity = Vector3.ZERO
	# Round 749's verification (c): the server has the point at a height it
	# only guesses (a teleport's 0, a landing's), so the arrival goes out as
	# a placement with the ground's -- once, at the point the server named,
	# which it takes (destmove.go claimBound's Named). _last_sent_pos stays
	# the server's point, so the send loop reports it on its next tick.
	_walked_since_send = 0.0
	_relocated_pending = true
	_refresh_zone_label_position()
	print("World3D: arrival in %s at local (%.1f, %.1f), height %.2f -- the server's point, on the walkable graph" % [
		group.name, local.x, local.z, player.global_position.y])
	return true

## Moves the player to a zone's landing whatever the zone (round 573, for
## /unstuck after a restored entry): its own landing spot where one is known
## (_place_at_zone_spawn, ZONE_SPAWN_LOCAL), else the middle of its centre
## region, local (960, 960) -- where the server lands every entry and zone
## change that restores nothing (server/internal/worldmap.Landing). False when
## the zone's centre region has no walkable graph loaded to land on.
func _place_at_zone_landing(zone: String) -> bool:
	if _place_at_zone_spawn(zone):
		return true
	var coords := _parse_region_coords(_resolve_zone_region(zone))
	if coords.is_empty():
		return false
	return _place_at_region_local(coords["x"], coords["y"], REGION_SPAN / 2.0, REGION_SPAN / 2.0)

## Moves the player to a zone's own landing spot (see ZONE_SPAWN_LOCAL) if
## one is known, once that zone's region has actually loaded. Zones with
## no entry keep the server's fixed spawn position.
func _place_at_zone_spawn(zone: String) -> bool:
	var region := _resolve_zone_region(zone)
	if not ZONE_SPAWN_LOCAL.has(region):
		return false
	var coords := _parse_region_coords(region)
	if coords.is_empty():
		return false
	var spot: Vector2 = ZONE_SPAWN_LOCAL[region]
	if not _place_at_region_local(coords["x"], coords["y"], spot.x, spot.y):
		return false
	_refresh_zone_label_position()
	return true

func travel_to_zone(zone_text: String) -> void:
	var typed := zone_text.strip_edges()
	if typed == "":
		return
	var target := _split_zone_target(typed)
	var zone: String = target["zone"]
	if zone == "":
		return
	_pending_zone_local = target.get("local", null)
	# A zone change leaves the old zone's monsters behind: drop the target
	# with them, or the window keeps showing (and skills keep aiming at) a
	# Mangyang two zones away -- the reporter's Alexandria screenshot.
	_last_attack_target = -1
	if _hud_target != null:
		_hud_target.clear()
	# Round 764: the spot goes to the server, which lands the character there
	# (its view window around it); before, it landed at the region's middle,
	# refused the placement here and snapped the player back (r764.md).
	_request_zone_change(zone, _pending_zone_local)

## Sends OpChangeZone and remembers it (round 690): every zone change this
## client asks for goes through here, so _on_change_zone_result can tell an
## answer to one from a move the server made on its own
## (arrival_keeps_server_point).
func _request_zone_change(zone: String, spot: Variant = null) -> void:
	_note_zone_change_request(zone)
	NetClient.change_zone(zone, spot)

## The zone labels of the OpChangeZone requests sent and not yet answered,
## oldest first (_request_zone_change).
var _zone_change_requests: Array[String] = []

func _note_zone_change_request(zone: String) -> void:
	_zone_change_requests.append(zone.strip_edges().to_lower())

## Whether a zone change's result answers one of this client's requests, and
## if so consumes that request (round 690's review). The server answers a
## request with the label asked for (handleChangeZone -> warpTo(req.Zone)) at
## that zone's landing; a move to the return point (warpHome) comes with the
## return point's label at a teleport point, and can arrive between a request
## and its answer, or before it. So:
## - a refused change answers the oldest request (the server answers in order;
##   warpHome's only refusal is for a session that has left the world);
## - an accepted one answers the oldest request for its label, unless it
##   lands on a teleport point (`at_point`): no zone's landing is one (the
##   town landings are their centres' middles, local (960, 960) -- MEASURED
##   against the 64 open-world points, none there), so that is the server's
##   own move, and the request stays for its answer.
## Whether a zone change's result answers this client: a gate teleport's
## arrival always does (its receipt marked it, round 576) and takes no zone
## request; any other result is matched (_match_zone_change_request).
func _zone_result_requested(teleport_arrival: bool, zone: String, ok: bool, at_point: bool) -> bool:
	if teleport_arrival:
		return true
	return _match_zone_change_request(zone, ok, at_point)

func _match_zone_change_request(zone: String, ok: bool, at_point: bool) -> bool:
	if not ok:
		if not _zone_change_requests.is_empty():
			_zone_change_requests.pop_front()
		return true
	if at_point:
		return false
	var i := _zone_change_requests.find(zone.strip_edges().to_lower())
	if i < 0:
		return false
	_zone_change_requests.remove_at(i)
	return true

## Whether a zone change's arrival keeps the server's position and stands it
## on the walkable graph (round 690), rather than moving it to the zone's own
## landing spot (_place_at_zone_spawn): a gate teleport's (the receipt came
## first, round 576), and a move to the return point -- one that finds the
## player dead (option 1 of the dead window: the server warps a dead
## character, then revives it, deadstate.go) or one this client never asked
## for (the flag-off respawn after a kill). A zone change this client asked
## for lands where it always has.
static func arrival_keeps_server_point(teleport: bool, requested: bool, dead: bool) -> bool:
	return teleport or dead or not requested

## Chat panel, ported from the 2D World.gd HUD (see docs/PROGRESS.md) --
## this scene is becoming the one real client, so its UI needs to cover
## everything the 2D view used to.
## A chat line from the server (round 634): the chat files and colours it
## by type (HudChat.add_chat); a whisper's sender is who R answers; a notice
## also raises GDR_NOTICE (0x876810's type-7 branch -> 0x777bf0).
func _on_chat_update(u: ChatNet.Update) -> void:
	if u == null:
		return
	print("CHAT: type %d from '%s': %s" % [u.type, u.sender_name, u.message_text])
	# A party line carrying the player's own name is dropped (Chat_OnChatUpdate
	# 0x877810, case 4: FUN_004e9530(own name, sender) skips it): the server
	# echoes party chat to its sender (gs:0x5bef50, round 710), and the client
	# shows its own line from the 0xB025 OK instead (0x877340, case 4).
	# Round 865 stage 3: an academy line too -- case 0x10 makes the same
	# compare (FUN_004e9530(own name, sender) at c:0x877f4d, `je` at
	# c:0x877f71 to the display, else the line is freed) and drops
	# the copy the server sends its sender; the sender's line came twice
	# (MEASURED once).
	if HudChat.drops_own_copy(u.type, u.sender_name, NetClient.current_character_name):
		return
	# Round 839: type 9 is the stall window's chat module (0x778a10).
	if u.type == StallNet.CHAT_TYPE:
		if _hud_panels != null and _hud_panels.stall != null:
			_hud_panels.stall.chat_line(u.sender_name, u.message_text)
		return
	if u.type == HudChat.TYPE_WHISPER:
		# R replies to this name (KeyMap slot 20; _key_whisper_reply).
		_last_whisperer = u.sender_name
	if _hud_chat != null:
		_hud_chat.add_chat(u.type, u.sender_name, u.message_text, false, u.color)
	if u.type == HudChat.TYPE_NOTICE:
		_show_banner("gm_notice", u.message_text)
	_tail_log("%s: %s" % [u.sender_name, u.message_text])

## The server's answer to a line this client sent (0xB025's fields): the
## player's own line, or the refusal. A global's answer refreshes the bag,
## whose stack of global chatting items shrank.
func _on_chat_result(r: ChatNet.Result) -> void:
	if r == null:
		return
	print("CHAT RESULT: type %d index %d ok %s code 0x%x" % [r.type, r.index, str(r.ok), r.code])
	# Round 839: a stall line's answer -- its line comes back as 0x3026.
	if r.type == StallNet.CHAT_TYPE:
		return
	if r.type == HudChat.TYPE_GLOBAL:
		if r.ok:
			if NetClient.current_character_name != "":
				NetClient.list_inventory(NetClient.current_character_name)
			if _hud_whole_chat != null and _hud_whole_chat.visible:
				_hud_whole_chat.set_count(maxi(0, _hud_whole_chat.count - 1))
		elif _hud_chat != null:
			_log_system(_hud_chat.refusal_text(r.code, ""))
		return
	if _hud_chat != null:
		_hud_chat.on_result(r.ok, r.type, r.index, r.code, r.target)

## A pet's potion, food or cure from bag slot `slot` (round 805;
## SendItem_HandleUseItem 0x796660, READ): it lands on the CURRENT COS
## (COS manager +0x10, HudCos.current_uid). None out: UIIT_MSG_COSPETERR_
## CANT_USEITEM; an ability pet or a guild soldier: _CANT_USE_WRONGOBJECT --
## both as game lines (0x7781b0 type 5) and nothing sent. A ride, a transport
## or a growth pet gets 0x704C with its uid.
func _use_cos_item(slot: int) -> void:
	if NetClient.current_character_name == "":
		return
	var uid := _hud_cos.current_uid() if _hud_cos != null else 0
	var data: CosNet.Data = NetClient.cos_own.get(uid)
	if uid == 0 or data == null:
		_log_system(_resolve_any_text(COS_CANT_USE_ITEM_KEY, "The item cannot be used by the pet."), HudSystemMessage.TYPE_GAME)
		return
	var kind := CosNet.client_kind(data.kind)
	if kind == 2 or kind == 4:
		_log_system(_resolve_any_text(COS_WRONG_OBJECT_KEY, "The item cannot be used on that pet."), HudSystemMessage.TYPE_GAME)
		return
	print("World3D: bag slot %d used on COS %d" % [slot, uid])
	if _hud_panels != null:
		UiSounds.expect_use(_hud_panels.bag_item_types(slot))
	NetClient.use_item_option(NetClient.current_character_name, slot, UseItemNet.OPTION_COS_TARGET, uid)

## Round 838: the use-on mode's send (HudPanels.use_on_check passed): the
## pet forms carry the target's bag index as OPTION_COS_TARGET's u32; the
## Nasrun extension the target's wire slot (bag index + 13) as its option
## byte (avataruse.go).
func _on_use_on_requested(src: int, target: int) -> void:
	if NetClient.current_character_name == "":
		return
	var types := _hud_panels.bag_item_types(src) if _hud_panels != null else PackedInt32Array()
	if _hud_panels != null:
		UiSounds.expect_use(types)
	# The Nasrun extension (3/3/13/16) and, round 838 lane 2, the switch tools
	# (3/3/13/8, session/switcher.go) carry the target's wire slot (bag index
	# + 13) as the option byte, as retail's 0x704C its u8.
	if types.size() >= 4 and types[2] == 13 and (types[3] == 16 or types[3] == 8):
		print("World3D: bag slot %d used on bag slot %d (wire slot %d)" % [src, target, target + 13])
		NetClient.use_item_option(NetClient.current_character_name, src, target + 13, 0)
		return
	print("World3D: bag slot %d used on the pet item in bag slot %d" % [src, target])
	NetClient.use_item_option(NetClient.current_character_name, src, UseItemNet.OPTION_COS_TARGET, target)

