## Applies a consumable's effect to the HUD. The restored amounts are the
## game's own (the item table's Param block), so the message reports what the
## player actually got back, which is capped at what was missing.
func _on_use_item_result(result) -> void:
	if result == null:
		return
	# A potion's success sounds snd_potion (0xb04c's handler, read; UiSounds).
	UiSounds.use_replied(result.error == "")
	if result.error != "":
		# Logged, so a tester's log shows every refusal (composite review).
		print("World3D: use item refused: %s" % result.error)
		_log_system(result.error)
		return
	if _hud_player_info != null:
		if result.max_hp > 0:
			_hud_player_info.set_hp(result.hp, result.max_hp)
			_last_enter_world_max_hp = result.max_hp
		if result.max_mp > 0:
			_hud_player_info.set_mp(result.mp, result.max_mp)
	var parts: Array[String] = []
	if result.restored_hp > 0:
		parts.append("%d HP" % result.restored_hp)
	if result.restored_mp > 0:
		parts.append("%d MP" % result.restored_mp)
	if not parts.is_empty():
		_log_system("Recovered %s." % " and ".join(parts))
	# A berserk potion (round 632) fills the orbs instead of the bars.
	if result.has_berserk:
		print("World3D: berserk potion: gauge %d, active %s" % [result.berserk_gauge, str(result.berserk_active)])
		if _hud_player_info != null:
			_hud_player_info.set_berserk(result.berserk_gauge, result.berserk_active)
	# The stack shrank, so redraw the bag.
	if NetClient.current_character_name != "":
		NetClient.list_inventory(NetClient.current_character_name)

## QA only: uses the first potion found in the bag, once. Driven by
## SRREVAMP_QA_USEITEM; the ids are the real consumables the loot tables drop.
var _qa_used_potion := false
func _qa_use_first_potion(slots: Array, _error: String) -> void:
	if _qa_used_potion or NetClient.current_character_name == "" or _player_dead:
		return
	for entry in slots:
		var slot: InventoryNet.Slot = entry
		if slot.item_id in [4, 6, 11, 13]:
			_qa_used_potion = true
			if _hud_panels != null:
				UiSounds.expect_use(_hud_panels.item_types(slot.item_id))
			NetClient.use_item(NetClient.current_character_name, slot.slot_index)
			return

# --- The front-end's 3D backdrop (round 678) ---------------------------------
#
# FrontEndBackdrop instances this scene with `title_mode` set before it enters
# the tree: the login screen's fly-through (and, later, character select and
# create) reuse the world's own region loaders -- terrain, objects, water, sky
# and environment -- and nothing else. No player body, HUD, server, keys,
# NPCs or loading screen; the backdrop drives the camera and the region
# window follows the point it hands title_focus. Everything here is OURS
# plumbing around READ behaviour the backdrop documents.

## Set before add_child: this World3D is a front-end backdrop.
var title_mode := false
## The region window around the focus, in regions (OURS: 1, a 3x3 window,
## at the title). It does not reach the camera's far plane (7680 units,
## _apply_camera_far_plane) and the exponential fog (FOG_DENSITY 0.00005)
## leaves ~88-90 % showing at 2000-2700 units, so the built world's edge can
## show in the distance -- OPEN, docs/TODO.md "The 3D title screen". (Retail's
## view distance, DAT_00ec54b0, is 2500, and its fog is linear, ending at the
## environment's far-plane channel times that distance -- the FOG_DENSITY
## comment.)
var _title_radius := 1

## The backdrop's half of _ready: the water reflection and the sky, the camera
## freed from the player's spring arm, the world's own UI hidden.
func _title_ready() -> void:
	print("World3D: title mode (round 678) -- a front-end backdrop: no player, HUD, server or loading screen")
	($UI as CanvasLayer).visible = false
	player.visible = false
	# The camera leaves the spring arm for this node (round 685's review):
	# SpringArm3D re-places its children from its INTERNAL physics process,
	# which set_physics_process(false) does not stop -- MEASURED, the eye
	# drifted 55.6 units over a backdrop left without show_pose, so every
	# screen had to re-pose it each frame. Detached, the camera stays where
	# the backdrop puts it; the arm is idle too.
	camera_arm.set_physics_process(false)
	camera_arm.set_physics_process_internal(false)
	camera_3d.reparent(self, true)
	camera_3d.top_level = true
	camera_3d.make_current()
	_water_reflection_on = WaterReflection.enabled()
	WaterReflection.ensure_globals()
	camera_3d.cull_mask &= ~WaterReflection.MIRROR_TERRAIN_BIT
	_water_reflection = WaterReflection.new()
	_water_reflection.name = "WaterReflection"
	add_child(_water_reflection)
	_try_add_real_sky()
	_apply_camera_far_plane()
	# The saved video record (round 694), as an entered world applies it.
	apply_video_options(video_options())
	# Round 680: the swaying trees and the like stay drawn (their clocks
	# paused) out of MapAnimation's 2020-unit range, instead of switching on
	# in view as the camera nears them -- a pop the title's probe counted
	# (OURS; retail fades them, MapAnimation's header).
	_map_animations.keep_drawn = true

## Starts the backdrop's region window on region (hi, lo) -- `centre` is
## Vector2i(hi, lo), this project's "hi/lo" -- with that region as the frame
## and a vertical anchor of 0 (OURS: world y is the region's own height, so
## a script's camera heights need no offset), its environment applied at
## `env_time` before any cell builds (so every cell bakes its light), and
## every cell of the window, the centre included, queued for the threaded
## pipeline -- nothing is built on this frame. False, with a printed reason,
## when Map.pk2 or the centre's `.m` is missing.
##
## `plan` (round 680): the whole scene instead of a window -- every cell, as
## Vector2i(dx, dy) from the frame region, in the order to build them
## (TitleCellPlan). A planned backdrop queues exactly those cells and then
## neither streams nor unloads: what is built stays, so nothing appears or
## goes while the camera flies (the user's "preload the scene entirely").
func title_begin(centre: Vector2i, radius: int, env_time: float, plan: Array = []) -> bool:
	_title_radius = maxi(radius, 0)
	_env_time = env_time
	var map_pk2 := _open_map_pk2_if_set()
	if map_pk2 == null:
		print("World3D: title backdrop -- no Map.pk2 (path='%s')" % Pk2Config.map_path())
		return false
	var mapm_path := "%d\\%d.m" % [centre.x, centre.y]
	var sw := Time.get_ticks_usec()
	var bytes := AssetSource.read_bytes(mapm_path, map_pk2)
	var region: MapmReader.ParsedRegion = MapmReader.parse(bytes) if not bytes.is_empty() else null
	if region == null:
		print("World3D: title backdrop -- region %d/%d has no terrain (%s)" % [centre.x, centre.y, mapm_path])
		return false
	_apply_real_environment_lighting(region, map_pk2)
	print("World3D: title backdrop at %d/%d, radius %d, environment phase %.4f (read and applied in %.1f ms)" % [
		centre.x, centre.y, _title_radius, env_time, (Time.get_ticks_usec() - sw) / 1000.0])
	_drop_cell_jobs("a new title backdrop")
	_grid_builds += 1
	_grid_origin_region = centre
	_grid_centre_region = centre
	_grid_shared_anchor_height = 0.0
	_grid_origin_world = _frame_corner(0.0)
	_grid_has_origin = true
	_grid.loaded_cells.clear()
	_grid.queued_cells.clear()
	_load_queue.clear()
	_last_stream_cell = Vector2i.ZERO
	var cells: Array = []
	_title_planned = not plan.is_empty()
	if _title_planned:
		for c in plan:
			var at := c as Vector2i
			cells.append({"rx": centre.x + at.x, "ry": centre.y + at.y, "dx": at.x, "dy": at.y,
				"key": "%d_%d" % [at.x, at.y], "dist": absi(at.x) + absi(at.y)})
		print("World3D: title backdrop planned -- %d cell(s) queued, no streaming while it flies" % cells.size())
	else:
		for dy in range(-_title_radius, _title_radius + 1):
			for dx in range(-_title_radius, _title_radius + 1):
				cells.append({"rx": centre.x + dx, "ry": centre.y + dy, "dx": dx, "dy": dy,
					"key": "%d_%d" % [dx, dy], "dist": absi(dx) + absi(dy)})
		cells.sort_custom(func(a, b): return a["dist"] < b["dist"])
	for cell in cells:
		_grid.queued_cells[cell["key"]] = true
		_load_queue.append(cell)
	return true

## The point the region window follows (the camera's target, in world
## space): the hidden player stands there, which is what
## _maybe_stream_regions measures from.
func title_focus(world_position: Vector3) -> void:
	player.position = world_position

## Cells built so far, and cells still queued or preparing.
func title_cells_loaded() -> int:
	return _grid.loaded_cells.size()

func title_cells_pending() -> int:
	return _load_queue.size() + _cell_jobs.size()

## Where a point given relative to the backdrop's frame region lands in the
## world, for a backdrop begun with title_begin (anchor 0): the region
## group's corner (_group_position, the same placement every cell uses) plus
## the point with z mirrored (the group's scale.z = -1). Positions outside
## [0, 1920) fall in the neighbouring cells, as they do in retail's frame.
static func title_world_from_local(local: Vector3) -> Vector3:
	var corner := _group_position(Vector3.ZERO, 0.0)
	return corner + Vector3(local.x, local.y, -local.z)

## Stops starting new cells (round 678's review): the queue is dropped and
## the window no longer follows the focus; cells already preparing still
## commit, so leaving the screen has little or nothing left to wait for.
func title_hold() -> void:
	_title_held = true
	for cell in _load_queue:
		_grid.queued_cells.erase(cell["key"])
	_load_queue.clear()

var _title_held := false
## A planned backdrop (title_begin's `plan`, round 680): its cells are the
## whole scene, so the window neither follows the focus nor unloads, and the
## stale-cell guard (_outside_stream_window) never drops one of them.
var _title_planned := false

func _title_physics(_delta: float) -> void:
	if _sky_dome != null:
		_cloud_uv_offset.x = fposmod(Time.get_ticks_msec() / CLOUD_SCROLL_MS, 1.0)
		_sky_dome_material.set_shader_parameter("uv_offset", _cloud_uv_offset)
	if _sun_glow != null:
		_sun_glow.global_position = camera_3d.global_position + _sun_glow_offset
	_tick_map_animations()
	if not _title_held and not _title_planned:
		_maybe_stream_regions()
	_process_stream_queue()
