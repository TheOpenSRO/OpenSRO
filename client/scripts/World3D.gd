func _try_set_move_target(screen_pos: Vector2) -> void:
	# Round 808: seated, the click only stands (retail tests it before the pick).
	if _stand_instead("a click on the world"):
		return
	var root := _wall_root()
	if root != 0:
		_log_root("a move to the clicked point", root)
		return
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	_move_by_pick_ray(from, dir, get_world_3d().direct_space_state)

## The walk's click on the world, from the camera ray `from` + `dir` (round
## 653; SkyRun has the reading). The pick reaches SkyRun.PICK_LENGTH (1000)
## from the camera, as retail's SWorld::vslot_034 does: ground or a placed
## object inside it is walked to; a ray that meets nothing there -- the sky,
## or ground farther away -- starts a heading run along the ray's ground
## direction (FUN_0078f8d0 -> FUN_009ebec0). Returns "walk", "run", "keep"
## (a run already on that heading goes on unchanged) or "ignore".
func _move_by_pick_ray(from: Vector3, dir: Vector3, space: PhysicsDirectSpaceState3D) -> String:
	# Round 832: the ground click (0x78f8d0) first cancels a running action.
	_cancel_action_for_click()
	# Only the ground and placed objects can be a destination. Left to the
	# default mask the ray also hit the player's own capsule, the invisible
	# navmesh walls (NAVMESH_WALL_COLLISION_LAYER) and NPC capsules, and a
	# click across the plaza landed on the nearest of those instead -- "the
	# character does not move to the direction you click".
	# Round 781: the terrain and the walkable cells only, as retail's pick
	# (GroundPick, SWorld::vslot_034) -- the drawn meshes' collision put grass,
	# flowers and lamps in the way of every click in a grassy field.
	var hit := _walk_pick(from, dir, space)
	if hit.is_empty():
		return _start_heading_run(dir)
	var point: Vector3 = hit["position"]
	# Within 20 units of an NPC the click does nothing: no walk, no ring
	# (round 698's review; READ, FUN_009ec570 0x9ec5a0..0x9ec5eb,
	# GroundMarkers.NPC_CLICK_BLOCK_SQ).
	var npc := GroundMarkers.npc_blocking(point, _markers().npcs())
	if npc != null:
		print("CLICK: ground at (%.1f, %.1f, %.1f) ignored -- %.1f from NPC %s (retail walks nowhere within 20 of an NPC)" % [
			point.x, point.y, point.z, npc.global_position.distance_to(point), str(npc.get_meta("npc_name", npc.name))])
		return "npc_near"
	# The ring goes to the point (round 698; FUN_009ec570 places it whatever
	# the click filter below decides).
	_markers().place_at(point)
	return _issue_walk(point)

## A walk to `point` as retail's destination record sends it: FUN_009ec570's
## tail and FUN_009ec6b0's (the talk approach, round 701) both store the point
## and run the click filter FUN_009ec240. The caller has placed the ring.
## Returns "walk" or "ignore" (the filter sent nothing).
func _issue_walk(point: Vector3) -> String:
	# Round 808: no walk is ordered from the seat (_stand_instead; the click
	# paths stop before this, the QA click does not).
	if _stand_instead("a walk order"):
		return "stand"
	if _own_move_blocked():
		return "ignore"
	# Round 846: whether the walk in effect is an approach (its point re-aims
	# every tick; the click below supersedes it rather than meeting its point).
	var was_approach := not _pending_attack.is_empty() or not _pending_friend_cast.is_empty() \
		or not _pending_pvp.is_empty() or _pending_pickup_id != -1
	# A click on the ground supersedes an attack that was walking into reach,
	# and a friendly cast walking to its player (round 622's review) -- even
	# one the filter below does not send (OURS: where retail drops a pending
	# action on a click is not read).
	_pending_attack = {}
	_released_attack = {}
	_pending_friend_cast = {}
	# And a walk to a ground item (round 653's review): its arrival or wall
	# stop would ask for the item from wherever this walk ends.
	_pending_pickup_id = -1
	# Round 826: the click filter FUN_009ec240 first asks FUN_009eb140 --
	# `([player+0x65c] & 0x2476) == 0` -- and sends nothing otherwise. +0x65c
	# holds a bit per character state (the state enter ORs 1 << state in,
	# 0x9c9a19); 0x2476 includes 0x400, state 10, the pick-up: a click while
	# the pick-up clip plays walks nowhere (READ).
	if _player_pickup_clip != null:
		print("CLICK: walk refused -- the pick-up clip plays (state 10)")
		return "ignore"
	# The client's own click filter (FUN_009eb2a0, round 637's review
	# follow-up; RemoteFacing.click_rule): with no movement order in effect a
	# click under 5 units away is not sent -- nothing moves; a far click
	# within 5 degrees of a far order snaps the heading instead of turning.
	# Round 863: the order a far click is measured against is the one the
	# mover holds -- the server's echo's (MoveOrderSync.mover_dest, READ) --
	# not the click this client already walks (OURS, round 749). Before, a
	# second far click within 5 degrees of the first, before the first's echo,
	# snapped the body in one frame (up to 180 degrees: MEASURED 115 in one
	# frame) where the original was still turning; a heading run keeps its
	# own point (OURS, SkyRun).
	match RemoteFacing.click_rule(_player_move_order, point - player.position, _click_rule_dest() - player.position):
		"ignore":
			return "ignore"
		"snap":
			_player_turn_snap = true
			_move_sync.mover_snapped(point)
	# Round 846: a click within 5.0 of the point this walk is still going to.
	# READ: the server refuses it (GObjPC::FUN_004b0ea0, 0xb45b28, while the
	# leg runs) and retail's client walks only on its echo, so nothing moves.
	# This client walked such a click at once and sent nothing (the server
	# would refuse it), so it stood up to 5 from where the server and every
	# other player had it, until a stop put it there in one jump.
	if not was_approach and _move_click_refused(point):
		print("CLICK: walk to (%.1f, %.1f) ignored -- within %.0f of the point the walk is going to (%.1f, %.1f); the server refuses it" % [
			point.x, point.z, MoveOrderSync.NEAR_DESTINATION, _move_sync.dest.x, _move_sync.dest.z])
		return "ignore"
	_arrow_wait_clear()
	_player_move_order = true
	_move_target = point
	_has_move_target = true
	_move_heading_run = false
	_end_own_cast_for_move("a walk order")
	return "walk"

## Round 863: the destination the ground click's filter measures a click
## against (RemoteFacing.click_rule): the mover's, which is the server's echo
## of an order (MoveOrderSync.mover_dest; READ, UI_SILKMALL::FUN_009eb2a0
## reads the mover's +0x684, written on the echo by FUN_009e0550); where the
## mover holds none, the player's own spot (no snap). A heading run's is its
## pick-reach point, as before (OURS).
func _click_rule_dest() -> Vector3:
	if _has_move_target and _move_heading_run:
		return _move_target
	return _move_sync.mover_dest if _move_sync.mover_dest != Vector3.INF else player.position

## Round 846: whether a walk to `point` is one the server refuses: this
## player's walk to a destination it sent is still in progress (an order, not
## a heading run; the caller rules out an approach) and `point`, truncated as
## the wire carries it, is within MoveOrderSync.NEAR_DESTINATION of that
## destination.
func _move_click_refused(point: Vector3) -> bool:
	if not _has_move_target or _move_heading_run or not _move_sync.active or _move_sync.heading_run:
		return false
	var q := NetClient.quantize_destination(point)
	return q != Vector3.INF and _move_sync.dest != Vector3.INF \
		and Vector2(q.x - _move_sync.dest.x, q.z - _move_sync.dest.z).length() <= MoveOrderSync.NEAR_DESTINATION

## Round 860: this player's own scroll state, 0x30BF kind 0xb (the
## _on_teleport_state handler; 0 again on the state's end, a zone change, a
## death).
var _own_teleport_state := 0

## Round 860: whether the scroll state holds this player. READ (server,
## scrollhold.go): the PC's message filter s:0x4296a0 lets only chat, item
## use, the cancel 0x705B and two more through while the state
## (GetTeleportState) is 1 -- group 11 of RegisterValueListFilters has one
## record, value 1 (ScrollHold.HOLD_VALUE). The move, the arrow keys and the
## action request are dropped there; the retail client walks only on its
## move's echo, so nothing moves. OURS: this client walks its click at once
## (MoveOrderSync), so it sends none of them while held instead of walking
## and being put back.
func _scroll_hold() -> bool:
	return ScrollHold.holds(_own_teleport_state)

## The abnormal states that refuse a move: freeze, sleep, root (0xc1) and stun
## (0x4000). READ: the server's 0x7021 handler (GObjPC::FUN_004b0ea0, `test
## al,0xc1` 0x4b0fa6, `test eax,0x4000` 0x4b0fae; statuseffect.Holder.CanMove).
const MOVE_BLOCKING_STATES := 0xc1 | 0x4000

## Whether this player may not start a walk now (round 749's verification):
## its own abnormal states hold one of MOVE_BLOCKING_STATES, or a trade is
## established (the server refuses a move in either, destmove.go). OURS: the
## click is not sent rather than sent and refused -- where retail's client
## filters it is not read.
func _own_move_blocked() -> bool:
	if _trade_established:
		return true
	# Round 860: the scroll's hold (_scroll_hold).
	if _scroll_hold():
		return true
	# Round 839: c:0x77c8e0 -- no walk while a stall window is shown (the
	# server drops a move at INTERACTMODE 2 and 4 too, s:0x4b0ea0).
	if _hud_panels != null and _hud_panels.stall_window_shown():
		return true
	var id := _own_id()
	if id < 0:
		return false
	var st: Dictionary = _abnormal_states.get(_fx_owner_key(id, SkillNet.OWNER_CHARACTER), {})
	return not st.is_empty() and (int(st["mask"]) & MOVE_BLOCKING_STATES) != 0

## Starts a heading run along the pick ray `dir` (round 653, SkyRun): the ray's
## ground direction becomes the run's heading, and the body turns to it at the
## client's rate while it runs (FUN_009e08a0 -> FUN_009e02f0, 3 pi rad/s). Not
## started -- "keep" -- when the player is moving and the heading is within 5
## degrees of its facing (FUN_0078f8d0, READ; SkyRun.click_rule).
func _start_heading_run(dir: Vector3) -> String:
	if _stand_instead("a heading run"):
		return "stand"
	if _own_move_blocked():
		return "ignore"
	var current := RemoteFacing.heading_of_yaw(player.rotation.y, 0.0)
	var h := SkyRun.heading_of_ray(current, dir)
	# READ: retail keeps the run only while the player moves (state bit 9)
	# AND its move kind is not a walk to a point (+0x6e8 != 1; +0x6e8 is the
	# mover's +0x80: 1 a destination, 2 a heading). A sky click within 5
	# degrees during a ground walk therefore starts a run.
	if SkyRun.click_rule(_has_move_target and _move_heading_run, current, h) == "keep":
		return "keep"
	return _begin_heading_run(h)

## A heading run along `h` (the sky click's, and round 808's Up key's): the
## order, the local run and the turn toward it; its 0x7021 goes out at the
## end of the tick (_sync_move_order).
func _begin_heading_run(h: float) -> String:
	# The click supersedes an attack or friendly cast walking into reach, as
	# a ground click does.
	_pending_attack = {}
	_released_attack = {}
	_pending_friend_cast = {}
	# And a walk to a ground item (round 653's review): the run is the order
	# now, so a wall that stops it must not ask for the item from there.
	_pending_pickup_id = -1
	var flat := RemoteFacing.facing_of(h)
	_arrow_wait_clear()
	_player_move_order = true
	_move_heading_run = true
	_move_heading = h
	# OURS: the order's point, for the ground click's own filter
	# (RemoteFacing.click_rule) should a ground click follow: the pick's reach
	# along the heading. What retail's destination record holds during a
	# heading move is not read.
	_move_target = player.position + Vector3(flat.x, 0.0, flat.y) * SkyRun.PICK_LENGTH
	_has_move_target = true
	_end_own_cast_for_move("a heading run")
	_aim_local_player(Vector3(flat.x, 0.0, flat.y))
	# A heading move hides the ring (round 698; retail on its 0xB021 echo).
	if _ground_markers != null:
		_ground_markers.heading_move()
	if _qa_move_log:
		print("MOVE run t=%d ms=%d heading=%.4f wire=%d dir=(%.3f,%.3f)" % [_qa_move_tick + 1, Time.get_ticks_msec(), h, SkyRun.wire_angle(h), flat.x, flat.y])
	return "run"

# --- The arrow keys (round 808) ---------------------------------------------
#
# READ, sro_client.exe (docs/protocol/opcodes/movement.md, "The arrow keys";
# the key-down handler 0x780610, the key-up 0x77d8d0):
#   - Up runs along the facing: one heading-form 0x7021 per press
#     (FUN_009ebec0, command 1), nothing while a heading run is already on --
#     so a held key's repeats send nothing -- and its release sends 0x7023
#     {u16 the facing} (FUN_009eb6e0), which the server answers with 0xB023 to
#     the 3 x 3, the player included. Up while seated sends nothing and does
#     not stand (the key never reaches the click's sit test).
#   - Left / Right turn the body at pi rad/s (FUN_009e0c10, 0xd81948), Left
#     winning when both are held, standing or running; no clip. During a click
#     walk they do nothing (the +0x6e8 != 1 test of 0x9ebf40).
#   - The turn reaches the server as 0x7024 {u16 the facing} (FUN_009eb470)
#     only when the facing has moved from the last one sent by pi/4 (a key-down
#     or the OS's key-repeat, and each frame of a run while turning; double
#     0xde47f8) or by 1 degree (the release, and the run's 500 ms timer 7;
#     float 0xde4800) -- the raw difference, not wrapped. So a spin in place is
#     seen by the server, and so by everyone else (0xB024), in 45-degree steps
#     at the key repeats, and exactly when the key is let go.
#   - Down has no key-down case at all.
#   - Every press first cancels an attack or cast in progress (0x78f7c0:
#     0x7074 [02] in the attack state).
#   - For 500 ms after an attack or skill request none of these go out (the
#     record's +0x48, FUN_009eb130 called from the attack sender 0x791d40;
#     INFERRED from the callers).
# OURS: the cancel is local (this client has no 0x7074 [02] sender; the
# server's keep-up ends at the run's 0x7021); the run's 500 ms re-plot
# (0x9eb8e0's steering) is not modelled beyond its 1-degree re-send; the keys
# are let go when the window loses the focus or a text line takes the keyboard.
# Seated (round 808's follow-up, the user: "A seated character in the original
# game spins with the arrow keys"): the body turns -- the mover tick turns on
# the turn bits whatever the motion state (FUN_009e0e60 -> FUN_009e0c10) --
# and nothing is sent, the sit bit being in the move gate 0x2476 that
# FUN_009eb470 tests first; the server and everyone else keep the old facing
# until the next move.
const ARROW_TURN_RATE := PI
const TURN_SEND_COARSE := 0.78539818525314331
const TURN_SEND_FINE := 0.0174532924
const ARROW_RESEND_MS := 500.0
const MOVE_SEND_BLOCK_MS := 500.0
const TURN_LEFT := 0x10
const TURN_RIGHT := 0x20
## The turn keys held (+0x88's 0x10 / 0x30).
var _turn_keys := 0
## Up's press started the run in effect (+0x7e0).
var _arrow_up_run := false
## The facing the last 0x7024 carried (+0x40), NAN before the first.
var _turn_sent := NAN
## Timer 7's ms left (-1 off) and the send block's (+0x48).
var _arrow_resend_ms := -1.0
var _move_send_block_ms := 0.0

## A new world entry, a zone change, a death: no turn held, nothing sent yet.
func _arrow_reset() -> void:
	_turn_keys = 0
	_arrow_up_run = false
	_turn_sent = NAN
	_arrow_resend_ms = -1.0
	_move_send_block_ms = 0.0
	_arrow_wait = ""
	_arrow_stop_superseded = false
	_own_settle = Vector3.INF

## A key event of the arrows (KeyInput's "arrow" callable): `down` with
## `echo` for the OS's repeats, which retail's WM_KEYDOWN runs in full.
func _on_arrow_key(keycode: int, down: bool, echo: bool) -> String:
	if title_mode or player == null:
		return "no world"
	if down and _is_typing():
		return "typing"
	var what := ""
	match keycode:
		KEY_UP:
			what = _arrow_up(down)
		KEY_LEFT:
			what = _arrow_turn(TURN_LEFT, down)
		KEY_RIGHT:
			what = _arrow_turn(TURN_RIGHT, down)
		_:
			what = "nothing (no key-down case, READ)"
	if _qa_move_log or (not echo and keycode != KEY_DOWN):
		print("ARROW %s %s%s: %s (facing %.4f)" % [OS.get_keycode_string(keycode), "down" if down else "up", " (repeat)" if echo else "",
			what, _arrow_facing()])
	return what

## The facing, as the arrows turn and send it.
func _arrow_facing() -> float:
	return RemoteFacing.heading_of_yaw(player.rotation.y, 0.0)

## The move gate the arrows' sends pass (FUN_009eb140's states: dead, sitting
## or getting up, acting, picking up; the +0x48 block).
func _arrow_send_allowed() -> bool:
	# Round 860: and not while the scroll holds (_scroll_hold).
	return not _player_dead and not _sit.sitting and not _motion_locked() and _move_send_block_ms <= 0.0 \
		and _player_pickup_clip == null and not _scroll_hold() and NetClient.is_connected_to_server()

## Round 846: the Up key's stop. READ (sro_client.exe): the press only sends
## (c:FUN_009ebec0 -> FUN_009ebd10 builds the heading form; the run starts on
## its echo, 0xB021 -> FUN_008a5750 -> FUN_009e08a0) and the release only
## sends 0x7023 (FUN_009eb6e0); the run ends on the server's 0xB023
## (FUN_008a4f80 -> FUN_009e00f0), whose point goes through FUN_009e11e0, the
## placement that re-places the drawn body only when it is more than 50.0 from
## it (FUN_009e1050, 0xd8f0b0).
## OURS, kept: this client runs from the press to the release, as before. The
## original's client runs from the echo to the stop, one transit later than the
## server's mover at both ends; this one runs one transit EARLIER at both ends.
## Either way the two runs differ only by the network's jitter -- MEASURED
## (round 846, 40 ms +- 20 ms): the stop landed 0-18 units from this client's
## point at /speed 1-10 both ways -- but an echo-started run reaches a wall one
## round trip after the server and every observer started it, and the
## observers, which walk a straight line (OtherWalk), ran that far past it
## before the stop came: 50-90 units at /speed 10, put back (MEASURED). So the
## run starts on the press, and the stop that answers its release is not
## jumped to: within 50 the body walks the difference (_own_settle), more than
## 50 it is put there, as an observer's is (_other_stop_at).
## _arrow_wait is "stop" from the release until that 0xB023.
var _arrow_wait := ""
## A 0x7021 went out after the 0x7023 (a click, a new Up press): the 0xB023
## that answers the 0x7023 is not the end of that walk.
var _arrow_stop_superseded := false
## The settle walk to a stop's point: the point, or Vector3.INF for none.
var _own_settle := Vector3.INF

## Up: the run along the facing, or its stop.
func _arrow_up(down: bool) -> String:
	if down:
		_arrow_cancel_action()
		if _has_move_target and _move_heading_run:
			return "already running"
		if not _arrow_send_allowed() or _own_move_blocked() or _wall_root() != 0:
			return "refused (the move gate)"
		var took := _begin_heading_run(_arrow_facing())
		_arrow_up_run = took == "run"
		if _arrow_up_run:
			_arrow_resend_ms = ARROW_RESEND_MS
		return took
	_arrow_resend_ms = -1.0
	var was := _arrow_up_run
	_arrow_up_run = false
	if not _arrow_send_allowed():
		return "release refused (the move gate)"
	var h := _arrow_facing()
	NetClient.move_stop_request(SkyRun.wire_angle(h))
	if was and _has_move_target and _move_heading_run:
		# Stopped here; the server's 0xB023 says where it has the body
		# (_own_arrow_stop).
		_has_move_target = false
		_move_heading_run = false
		player.velocity.x = 0.0
		player.velocity.z = 0.0
		_move_sync.placed(player.position)
		_arrow_wait = "stop"
		_arrow_stop_superseded = false
	return "0x7023 sent (angle %d)" % SkyRun.wire_angle(h)

## Round 846: this player's own 0xB023 while the Up key's release waits for it
## (READ, FUN_009e00f0 + FUN_009e11e0): the run is over; within 50 of where it
## stands the body walks to the server's point (_own_settle), farther it is put
## there. One a newer order superseded is the end of the run that order
## replaced: the order goes on. True when it was the arrow's.
func _own_arrow_stop(at: Vector3, heading: float) -> bool:
	if _arrow_stop_superseded:
		_arrow_stop_superseded = false
		if _qa_move_log:
			print("MOVE arrow stop at (%.3f,%.3f) after a newer order -- the walk goes on" % [at.x, at.z])
		return true
	if _arrow_wait != "stop":
		return false
	_arrow_wait = ""
	var off := Vector2(at.x - player.position.x, at.z - player.position.z).length()
	print("MOVE arrow stop: the server's point (%.2f, %.2f), this client's (%.2f, %.2f), %.2f apart%s" % [at.x, at.z,
		player.position.x, player.position.z, off, " -- walked" if off <= OtherWalk.RESYNC_DISTANCE else " -- put there"])
	_has_move_target = false
	_move_heading_run = false
	player.velocity = Vector3.ZERO
	player.rotation.y = RemoteFacing.yaw_of(heading, 0.0)
	_player_turn_target = NAN
	if off > OtherWalk.RESYNC_DISTANCE:
		player.position = _ground_on_walk_surface(at)
		_own_settle = Vector3.INF
	elif off >= 0.01:
		_own_settle = at
	_move_sync.placed(at)
	_last_sent_pos = player.position
	_walked_since_send = 0.0
	_time_since_send = 0.0
	return true

## Round 846: one physics step of the settle walk (_own_arrow_stop): the body
## moves toward the server's point at OtherWalk.CATCH_UP_MAX times its speed
## on the walkable graph, facing as the stop left it; any order of the
## player's ends it where it is. True while it moves.
func _step_own_settle(delta: float) -> bool:
	if _own_settle == Vector3.INF:
		return false
	if _has_move_target:
		_own_settle = Vector3.INF
		return false
	var to := Vector2(_own_settle.x - player.position.x, _own_settle.z - player.position.z)
	var step := _gait_speed() * OtherWalk.CATCH_UP_MAX * delta
	var p := player.position
	if to.length() <= step:
		p.x = _own_settle.x
		p.z = _own_settle.z
		_own_settle = Vector3.INF
	else:
		var d := to.normalized() * step
		p.x += d.x
		p.z += d.y
	player.position = _ground_on_walk_surface(p)
	_last_sent_pos = player.position
	_walked_since_send = 0.0
	return true

## Round 846: the Up key's release is no longer waited on (a new order).
func _arrow_wait_clear() -> void:
	if _arrow_wait == "stop":
		_arrow_stop_superseded = true
	_arrow_wait = ""
	_own_settle = Vector3.INF

## Left / Right: the turn bit and the coarse send, or its release.
func _arrow_turn(bit: int, down: bool) -> String:
	if down:
		_arrow_cancel_action()
		if _has_move_target and not _move_heading_run:
			return "ignored (a click walk is in progress)"
		# Round 860 (OURS on this client, _scroll_hold): the server drops the
		# 0x7024, so the body does not turn here either -- the others see it
		# facing as it stood.
		if _scroll_hold():
			return "refused (the scroll holds the player)"
		var sent := _send_turn_if(_arrow_facing(), TURN_SEND_COARSE)
		_turn_keys |= bit
		return "turning (%s)" % sent
	_turn_keys &= ~bit
	var sent := _send_turn_if(_arrow_facing(), TURN_SEND_FINE)
	# FUN_009e0160(facing, 0x30, 1): both turn bits clear, the facing and the
	# travel direction take the facing.
	_turn_keys = 0
	if _has_move_target and _move_heading_run:
		_move_heading = _arrow_facing()
		_move_sync.heading_wire = SkyRun.wire_angle(_move_heading)
	return "released (%s)" % sent

## FUN_009eb470: 0x7024 with `h` when it has moved `threshold` from the last
## sent; "sent", "within" or "refused".
func _send_turn_if(h: float, threshold: float) -> String:
	if not _arrow_send_allowed():
		return "refused"
	if not is_nan(_turn_sent) and absf(_turn_sent - h) < threshold:
		return "within"
	NetClient.move_turn(SkyRun.wire_angle(h))
	_turn_sent = h
	if _qa_move_log:
		print("MOVE send t=%d ms=%d 0x7024 heading=%.4f wire=%d" % [_qa_move_tick + 1, Time.get_ticks_msec(), h, SkyRun.wire_angle(h)])
	return "sent"

## An arrow press ends an attack or cast in progress (OURS, locally).
func _arrow_cancel_action() -> void:
	_drop_pending_attack()
	_end_own_cast_for_move("an arrow key")

## The keys let go without their release events (the focus lost, typing):
## the turn stops, and an Up run stops as its release would.
func _arrow_release_all() -> void:
	if _turn_keys != 0:
		_arrow_turn(TURN_LEFT, false)
	if _arrow_up_run:
		_arrow_up(false)

## Each physics step: the turn (FUN_009e0c10, standing or running), the
## per-frame coarse send of a run, timer 7's fine re-send, and the block.
func _step_arrow_keys(delta: float) -> void:
	if _move_send_block_ms > 0.0:
		_move_send_block_ms -= delta * 1000.0
	var running := _has_move_target and _move_heading_run
	if _turn_keys != 0 and not _player_dead:
		var h := _arrow_facing()
		h += delta * ARROW_TURN_RATE if (_turn_keys & TURN_LEFT) != 0 else -delta * ARROW_TURN_RATE
		h = RemoteFacing.wrap_heading(h)
		player.rotation.y = RemoteFacing.yaw_of(h, 0.0)
		_player_turn_target = NAN
		if running:
			# The run follows the turn; the server hears it by 0x7024, not
			# by a new 0x7021.
			_move_heading = h
			_move_sync.heading_wire = SkyRun.wire_angle(h)
			_send_turn_if(h, TURN_SEND_COARSE)
	if _arrow_resend_ms >= 0.0:
		if not running or not _arrow_up_run:
			_arrow_resend_ms = -1.0
		else:
			_arrow_resend_ms -= delta * 1000.0
			if _arrow_resend_ms <= 0.0:
				_arrow_resend_ms += ARROW_RESEND_MS
				_send_turn_if(_move_heading, TURN_SEND_FINE)

## The point on the ground or a placed object's walkable surface under a
## screen point, or null: the click-to-move pick, shared with the ground-pick
## cast (round 617; round 781: GroundPick's terrain-and-cells rule).
func _ground_point_at(screen_pos: Vector2, length: float = 2000.0) -> Variant:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	var hit := _walk_pick(from, dir, get_world_3d().direct_space_state, length)
	if hit.is_empty():
		return null
	return hit["position"]

## QA only (OPENSRO_QA_PICK_SWEEP, round 781): a 32 x 18 grid of clicks over
## the screen, picked by the round-653 rule (every drawn mesh's collision,
## TERRAIN_COLLISION_LAYER) and by GroundPick's: how many the old rule stopped
## on a placed object's drawn mesh, how many of those the new one sends to
## the ground or a walkable cell instead, and the objects most in the way.
func _qa_pick_sweep(shot: String) -> void:
	var space := get_world_3d().direct_space_state
	var vp := get_viewport().get_visible_rect().size
	var total := 0
	var old_object := 0
	var moved := 0
	var by_name := {}
	for row in 18:
		for col in 32:
			var sp := Vector2((col + 0.5) / 32.0 * vp.x, (row + 0.5) / 18.0 * vp.y)
			var from := camera_3d.project_ray_origin(sp)
			var dir := camera_3d.project_ray_normal(sp)
			var old := space.intersect_ray(SkyRun.pick_query(from, dir, TERRAIN_COLLISION_LAYER, [player.get_rid()]))
			var new_hit := _walk_pick(from, dir, space)
			if old.is_empty():
				continue
			total += 1
			var collider = old.get("collider")
			var layer: int = (collider as CollisionObject3D).collision_layer if collider is CollisionObject3D else 0
			if layer & TERRAIN_ONLY_COLLISION_MASK:
				continue
			old_object += 1
			var n: Node = collider as Node
			var label := "?"
			while n != null and n != self:
				if n.get_parent() != null and (n.get_parent().name.begins_with("RealMapObjects") or n.get_parent().name.begins_with("Dungeon")):
					label = String(n.name)
					break
				n = n.get_parent()
			by_name[label] = int(by_name.get(label, 0)) + 1
			if not new_hit.is_empty() and (new_hit["position"] as Vector3).distance_to(old["position"]) > 0.5:
				moved += 1
	var names := by_name.keys()
	names.sort_custom(func(a, b): return int(by_name[a]) > int(by_name[b]))
	var top := PackedStringArray()
	for k in names.slice(0, 8):
		top.append("%s x%d" % [k, by_name[k]])
	print("QA PICK SWEEP %s: %d clicks hit something; the old rule stopped %d on a drawn object, %d of them land elsewhere now; in the way: %s" % [
		shot, total, old_object, moved, ", ".join(top)])

## Retail's pick (GroundPick, round 781): the terrain alone by physics, the
## placed objects by their walkable cells; the nearer within `length`.
func _walk_pick(from: Vector3, dir: Vector3, space: PhysicsDirectSpaceState3D, length: float = SkyRun.PICK_LENGTH) -> Dictionary:
	var q := SkyRun.pick_query(from, dir, TERRAIN_ONLY_COLLISION_MASK, [player.get_rid()])
	q.to = from + dir.normalized() * length
	var terrain := space.intersect_ray(q)
	var cells := GroundPick.object_cells_hit(_grid.nav_graph_pairs(), from, dir, length)
	return GroundPick.nearest(from, terrain, cells)

## The authored chat window's input line (HudChat).
func _on_chat_submitted(text: String) -> void:
	_send_chat(text)

func _send_chat(text: String) -> void:
	if text.is_empty():
		return
	# Every slash line goes through the console (scripts/ui/console.gd): it
	# runs the client commands, forwards GM commands to the server, and
	# answers an unknown one with the help line -- never silence. Anything
	# else is ordinary chat.
	if text.begins_with("/") and _console != null and _console.submit(text):
		return
	# A chat line (round 634): the channel from its first character
	# (HudChat.parse_line, 0x7ad400), kept under an index for the echo.
	if _hud_chat != null:
		_hud_chat.own_name = NetClient.current_character_name
		_hud_chat.is_gm = _is_gm
		var req := _hud_chat.request_for(text)
		if req.is_empty():
			return
		print("CHAT SEND: type %d index %d to '%s': %s" % [int(req["type"]), int(req["index"]), String(req["target"]), String(req["message"])])
		NetClient.send_chat(int(req["type"]), int(req["index"]), String(req["target"]), String(req["message"]))
		return
	NetClient.say(text)

## Frees a player wedged into geometry: teleports them back to the zone's own
## entry spawn (a known-open point the server placed them at) and clears any
## velocity. A stopgap until movement is navmesh-constrained -- free-physics
## movement lets the capsule wedge into a concave building corner. The debug
## panel's zone travel (dev-only) does the same the heavy way; this stays in
## the zone. The move
## sync in _process sends the new position (it differs from _last_sent_pos).
func _unstuck_player() -> void:
	# Round 749's verification (FP6): online, /unstuck is the server's -- it
	# takes a client's placement only near where it has the character, so the
	# client's own landing was corrected back into the spot it was stuck at.
	# The server puts the character at its zone's landing spot (its 0xB023,
	# _apply_own_correction) and answers _on_unstuck_result. Offline, the
	# client's own path below.
	if NetClient.is_connected_to_server():
		NetClient.request_unstuck()
		return
	var result = NetClient.last_enter_world_result
	if result == null or not result.ok:
		_log_system("Unstuck: no spawn point known yet.")
		return
	player.velocity = Vector3.ZERO
	# A restored entry's point is where the character logged out (round 573)
	# -- the very spot a player may be wedged at -- so /unstuck lands it at
	# the current zone's landing instead. The move sync reports the landing,
	# as it reports the entry point below: _place_at_region_local leaves
	# _last_sent_pos alone since round 646.
	if result.restored:
		var zone: String = NetClient.current_zone if NetClient.current_zone != "" else result.zone
		if _place_at_zone_landing(zone):
			_log_system("Unstuck: returned to the zone's landing spot.")
			return
	player.position = Vector3(result.x, result.y, result.z)
	_log_system("Unstuck: returned to the zone entry point.")

## The server's answer to /unstuck (round 749's verification, FP6): done --
## its 0xB023 has put the player at the zone's landing spot -- or refused,
## with how long until it may be asked again (0: not here at all -- dead,
## stunned, trading, or no landing known in this zone).
func _on_unstuck_result(ok: bool, wait_seconds: int) -> void:
	if ok:
		_log_system("Unstuck: returned to the zone's landing spot.")
	elif wait_seconds > 0:
		_log_system("Unstuck: wait %d s before using it again." % wait_seconds)
	else:
		_log_system("Unstuck: not possible right now.")
	print("World3D: /unstuck answered ok=%s wait=%d" % [str(ok), wait_seconds])

func _on_disconnected() -> void:
	get_tree().change_scene_to_file("res://scenes/Login.tscn")

# --- Monsters tab ---------------------------------------------------------

## Raycasts straight down (and up, to cover terrain that loaded after this
## was called) through pos's X/Z and returns the real surface height found,
## or pos.y unchanged if nothing was hit -- the same practical safety net
## _snap_player_onto_terrain uses for the player, reused here so monsters
## don't spawn embedded in or floating above the real terrain grid either.
func _terrain_height_at(pos: Vector3) -> float:
	var height := _terrain_hit_height(pos)
	return pos.y if is_nan(height) else height

## The same ray as _terrain_height_at, but a miss says so: NAN when nothing on
## the terrain layer lies under pos's X/Z -- no region there has committed its
## terrain collision yet, or none ever will. A caller that places something
## once and never looks again (a monster body, a ground item) keeps it on a
## retry list on a miss instead of leaving it at the server's height (round
## 572: every Mangyang was drawn at the server's y 0 when the monster list
## beat its region's terrain).
##
## The ray is TerrainCollision.vertical_ray's, off the heightfield's grid
## lines (round 572: a plain vertical ray found nothing under 7 of the 9
## Jangan monsters standing on 97/168's grid vertices), and it passes through
## the scene's two stand-in floors (_stand_in_floor_rids): only real terrain
## counts as ground here.
func _terrain_hit_height(pos: Vector3) -> float:
	var space := get_world_3d().direct_space_state
	var hit := TerrainCollision.vertical_ray(space, pos.x, pos.z,
		pos.y + 1000.0, pos.y - 1000.0,
		TERRAIN_ONLY_COLLISION_MASK, # see its own doc comment -- same "landed on a roof" bug applies to monster placement
		_stand_in_floor_rids())
	if hit.is_empty():
		# Round 808 (the user: Hashades "aren't showing up at all ... They can
		# still hurt me and I see them on the minimap"): nothing within 1000 --
		# the whole column, once. A field monster's y is the server's 0 (its
		# nest's own height is not carried, cmd/server/nest.go), and every
		# ground above raw ~997 or below ~-1002 -- Karakoram, Roc Mountain,
		# Tiger Mountain, 2,103 nests of 171 rows (MEASURED, heightat over the
		# nest table) -- was missed: the body stayed 1,000+ under the ground,
		# retried for ever. The terrain is the only thing on this layer (the
		# stand-ins excluded), one surface per (x, z), so it cannot land on a
		# roof.
		hit = TerrainCollision.vertical_ray(space, pos.x, pos.z, pos.y + TERRAIN_COLUMN, pos.y - TERRAIN_COLUMN,
			TERRAIN_ONLY_COLLISION_MASK, _stand_in_floor_rids())
	if hit.is_empty():
		return NAN
	return hit.position.y + 0.05 * PLAYER_SCALE_RATIO

## Round 808: the column a missed terrain ray is retried over: raw heights run
## -1800 (the sea) to 5898 (Roc Mountain's Wing Tribe nests, MEASURED over the
## nest table), and a frame's anchor moves them by up to its own height.
const TERRAIN_COLUMN := 8000.0

## The scene's stand-in floors, which sit on the terrain-only layer
## (collision_layer 9, World3D.tscn) but are not terrain: the placeholder
## `Ground` (a 200 x 1 x 200 box at the origin, top at y 0.5), switched off
## when the first terrain group commits (_terrain_commit) and on again by
## _reload_zone_assets, and `VoidCatchFloor` (top at y -1995). A placement ray
## that answered from either would place a body on it for good and never
## retry it: on the loading-screen path the monster list is applied before
## the centre commits, so a body listed within 100 of the origin was drawn on
## the placeholder at 0.898 (round 572's review). _terrain_hit_height -- and
## so every monster, ground-item and player placement that goes through it --
## excludes them. Left as they are for everything else: the player's body
## stands on the placeholder until the terrain commits (move_and_slide, layer
## 1), its ground check keeps _last_grounded_position there (the void-fall
## return), and the snap runs after the centre's commit has switched the
## placeholder off; VoidCatchFloor is the void catch.
func _stand_in_floor_rids() -> Array:
	if _stand_in_rids.is_empty():
		for path in ["Ground", "VoidCatchFloor"]:
			var body := get_node_or_null(path) as CollisionObject3D
			if body != null:
				_stand_in_rids.append(body.get_rid())
	return _stand_in_rids

## The height the region's walkable graph gives a world position: its landing
## height -- the highest walkable surface there, the terrain or a placed
## object's navigation mesh (a bridge, a floor, Jangan's plaza deck) -- the
## same NavGraph.landing_height_at an NPC is placed with (_try_spawn_region_npcs
## asks its region's own graph on the authored region-local position; its doc
## comment has the plaza deck measured 13.8 above the terrain against
## height_at's 12.0 reach). The graph is found here by _nav_graph_for and the
## position carried through the region group's to_local/to_global, the
## click-target and zone-entry placement pattern. NAN when no loaded region
## covers the point, so the caller can fall back to the terrain ray.
## landing_height_at is the HIGHEST surface, so a body under an overpass is
## drawn on top of it -- the limit the NPC path shares.
func _navmesh_height_at(pos: Vector3) -> float:
	var pair := _nav_graph_for(pos)
	if pair.is_empty():
		return NAN
	var group: Node3D = pair[1]
	var local := group.to_local(pos)
	return group.to_global(Vector3(local.x, (pair[0] as NavGraph).landing_height_at(local.x, local.z, local.y), local.z)).y

## A moving monster's height (round 557): the navmesh first, the terrain ray
## where no loaded region covers the point. Before this round a walking body
## took _terrain_height_at alone, whose ray sees only the terrain layer
## (TERRAIN_ONLY_COLLISION_MASK), so a body walking onto a structure sank to
## the ground under it. The authored heights are no help: they disagree with
## the navmesh by 10-40 units on real rows (server/internal/worldmap, the
## ToWorld comment). A standing body's placement (_spawn_or_update_monster)
## still takes the ray.
func _moving_monster_height_at(pos: Vector3) -> float:
	var height := _moving_monster_hit_height(pos)
	return pos.y if is_nan(height) else height

## _moving_monster_height_at, but NAN when neither the navmesh nor the
## terrain ray has an answer (_terrain_hit_height).
func _moving_monster_hit_height(pos: Vector3) -> float:
	var nav := _navmesh_height_at(pos)
	if is_nan(nav):
		return _terrain_hit_height(pos)
	return nav

## Books one height answer for a monster's body (a *_hit_height result) and
## returns the height to draw it at. A miss (NAN) returns `fallback` -- what
## the body was placed at before round 572, the server's y -- and puts the
## body on _monster_heights_pending, keeping the frame it first went there; a
## hit takes it off (_monster_height_found) and is returned.
func _book_monster_height(monster_id: int, height: float, fallback: float) -> float:
	if is_nan(height):
		if not _monster_heights_pending.has(monster_id):
			_monster_heights_pending[monster_id] = Engine.get_physics_frames()
		return fallback
	_monster_height_found(monster_id, height)
	return height

## A body's height was found: off the retry list, saying so once if it was on
## it.
func _monster_height_found(monster_id: int, height: float) -> void:
	if not _monster_heights_pending.has(monster_id):
		return
	var frames: int = Engine.get_physics_frames() - int(_monster_heights_pending[monster_id])
	_monster_heights_pending.erase(monster_id)
	# Per monster, so only with the monster log on (round 655).
	if not _mob_logging():
		return
	var snap = _monster_snapshots.get(monster_id)
	print("World3D: monster %d %s height resolved after %d frame(s): %.2f at frame %d" % [
		monster_id, snap.monster_name if snap != null else "?", frames, height, Engine.get_frames_drawn()])

## Creates or moves the real 3D body representing one live server-tracked
## monster (see CombatNet.MonsterSnapshot's X/Y/Z). Those coordinates are
## world-space and are used as sent; only the height is resolved here, off
## the terrain, because the authored height and the walkable graph disagree.
##
## Whether a position is REAL now varies by species, and the server is the
## place that says which. Mangyang stands on its four real npcpos rows in
## region 96/168, converted by the server's worldmap package; every other
## species is still on an own-design anchor. This comment said "not real
## per-monster coordinate data" flatly until 2026-09-15, which stopped being
## true for the first species that day.
## A plain colored capsule for now, same honest
## "placeholder until a real per-species model mapping exists" approach
## World3D already uses for other players before a real character loads --
## no real monster model/skeleton mapping has been found or attempted yet
## (a real next step, not this one).
## Superseded 2026-09-09. Two species were hand-wired here -- a golem and a
## scorpion -- each with its own skeleton path, mesh directory, piece list,
## material path, material layer and a hand-derived piece-to-bone table in
## MonsterAssembler. All of it is replaced by reading the species' own .bsr:
## it names its skeleton and mesh pieces, and the bone mapping is computed
## (SkinnedBsrAssembler). What was seven constants and a table per creature
## is now a name lookup that covers 642 species.

## Species -> model, built once from the player's own Media.pk2, two ways:
## {code name -> .bsr path} (`MOB_CH_MANGNYANG`, the row's own key, the same
## in every archive) and {lowercased display name -> .bsr path} for a
## server that sends no code. The code comes first: a display name is
## whatever language column an archive carries, and on one archive the
## name join drew a Mangyang as a treasure chest and a Weasel as nothing.
## See NpcTableReader.parse_models_by_code / parse_models_by_name.
var _monster_models_by_code: Dictionary = {}
var _monster_models_by_name: Dictionary = {}
## {code name -> OrgObjCodeName} (round 655): the row a `_CLON` takes its
## model from (NpcTableReader.parse_org_codes / model_with_org).
var _monster_org_by_code: Dictionary = {}
## Round 809: monster and COS code -> its non-zero TextureType (CharTables).
var _monster_texture_by_code: Dictionary = {}
## Round 813: monster and COS code -> its non-zero characterdata column 80,
## the slope tilt's factors (CharTables, SlopeTilt).
var _slope_tilt_by_code: Dictionary = {}
var _monster_models_loaded := false
## The object name table as parsed from the player's archive, kept so the
## debug panel can show what language its columns yield.
var _object_name_table: UiTextTable = null

func _monster_model_path(code_name: String, species_name: String) -> String:
	if not _monster_models_loaded:
		_monster_models_loaded = true
		if _media_pk2 == null:
			_media_pk2 = _open_media_pk2_if_set()
		if _media_pk2 != null:
			# One parse of textdata_object.txt for the whole world (the item
			# names use it too) -- see _object_names().
			# Every characterdata part (round 746), read by CharTables' entry
			# task with the object-name table they join through.
			_adopt_char_entry()
			var centry := CharTables.entry(_media_pk2)
			if _object_name_table == null:
				_object_name_table = centry.names
			_monster_models_by_code = centry.mob_models_by_code
			_monster_org_by_code = centry.mob_org
			_monster_texture_by_code = centry.mob_texture
			_slope_tilt_by_code = centry.slope_tilt
			_monster_models_by_name = centry.mob_models_by_name
			var through_org := 0
			for code in _monster_org_by_code:
				if not _monster_models_by_code.has(code) and _monster_models_by_code.has(_monster_org_by_code[code]):
					through_org += 1
			print("World3D: %d species resolvable by code, %d more through their Org row, %d by name" % [
				_monster_models_by_code.size(), through_org, _monster_models_by_name.size()])
	if code_name != "":
		# Its own model, else its Org row's (a `_CLON`; READ, round 655).
		var by_code := NpcTableReader.model_with_org(code_name, _monster_models_by_code, _monster_org_by_code)
		if by_code != "":
			return by_code
	return _monster_models_by_name.get(species_name.to_lower(), "")

func _spawn_or_update_monster(monster: CombatNet.MonsterSnapshot) -> void:
	_monster_snapshots[monster.monster_id] = monster

	if _monster_bodies.has(monster.monster_id):
		# A body walking a server-driven leg keeps where it is drawn unless it
		# has drifted past OtherWalk.RESYNC_DISTANCE; a standing one goes
		# where the list says. Before round 533 every refresh set the list's
		# position, which would teleport a walking body back by its lag.
		var existing: Node3D = _monster_bodies[monster.monster_id]
		var state = _monster_motion.get(monster.monster_id)
		var moving: bool = state != null and bool(state["moving"])
		var placed := MonsterMotion.reconcile(Vector2(existing.position.x, existing.position.z),
			Vector2(monster.x, monster.z), moving)
		# The height is resolved where the body is placed, not at the list's
		# x/z, which can be up to OtherWalk.RESYNC_DISTANCE away -- and for a walking
		# body from the navmesh (round 557), as the leg's own resolves are,
		# so a mid-leg refresh does not drop it off a deck for the two units
		# until the next one.
		# A miss keeps the list's y, as before, and puts the body on the retry
		# list (_book_monster_height); a hit takes it off.
		if _qa_mob_track:
			print("MOB list %d ums=%d drawn=(%.3f,%.3f) list=(%.3f,%.3f) moving=%s jump=%.3f" % [monster.monster_id, _qa_unix_ms(),
				existing.position.x, existing.position.z, monster.x, monster.z, "1" if moving else "0",
				placed.distance_to(Vector2(existing.position.x, existing.position.z))])
		var at := Vector3(placed.x, monster.y, placed.y)
		var found := _moving_monster_hit_height(at) if moving else _terrain_hit_height(at)
		existing.position = Vector3(placed.x, _book_monster_height(monster.monster_id, found, at.y), placed.y)
		monster.x = placed.x
		monster.z = placed.y
		if state != null:
			state["pos"] = placed
			state["h_xz"] = placed
		var existing_label: Label3D = existing.get_node("Label")
		if existing_label.text != monster.monster_name:
			existing_label.text = monster.monster_name
			_fit_monster_name_box(existing_label)
		return

	# Round 655: no body outside the loaded regions. The snapshot is kept, and
	# the body is built when its region loads (_monster_cells_changed).
	if not _monster_region_loaded(Vector3(monster.x, monster.y, monster.z)):
		LatencyProbe.monster_waits(monster.monster_id, "region")
		_monster_build_queued.erase(monster.monster_id)
		_monster_deferred[monster.monster_id] = true
		return
	_monster_deferred.erase(monster.monster_id)
	_monster_build_queued.erase(monster.monster_id)
	_build_monster_body(monster)

# --- The NPC thieves' and hunters' bodies (round 805, JobMobDress) -----------

## code -> JobMobDress.Row and skill id -> weapon type, read once on a worker
## (_job_mob_tables_start, after the entry); the race's body list by Country.
var _job_mob_rows: Dictionary = {}
var _job_mob_weapons: Dictionary = {}
var _job_mob_task := -1
var _job_mob_box: Array = [null]
var _job_mob_loaded := false
var _job_mob_bodies: Dictionary = {}
## The first armour piece became "HA" (JobMobDress.PIECES, c:0x9e42c2).
var _job_mob_ha := false
var _item_id_by_code: Dictionary = {}

func _job_mob_tables_start() -> void:
	if _job_mob_task >= 0 or _job_mob_loaded or _media_pk2 == null:
		return
	var media := _media_pk2
	var box: Array = [null]
	_job_mob_box = box
	_job_mob_task = WorkerThreadPool.add_task(func() -> void:
		box[0] = JobMobDress.read_tables(media), false, "job mob tables")

## The tables, waited for (or read now when the worker never ran).
func _job_mob_tables_ready() -> bool:
	if _job_mob_loaded:
		return not _job_mob_rows.is_empty()
	if _job_mob_task < 0:
		_job_mob_tables_start()
	if _job_mob_task < 0:
		return false
	var t0 := Time.get_ticks_usec()
	PoolWait.task(_job_mob_task)
	_job_mob_task = -1
	_job_mob_loaded = true
	var got = _job_mob_box[0]
	if got is Array and (got as Array).size() == 2:
		_job_mob_rows = got[0]
		_job_mob_weapons = got[1]
	print("World3D: %d NPC thief/hunter row(s), %d skill weapon(s) (waited %d us)" % [
		_job_mob_rows.size(), _job_mob_weapons.size(), Time.get_ticks_usec() - t0])
	return not _job_mob_rows.is_empty()

## The id of the first code in `codes` that has a worn model, else 0 (the
## original's step-down: FUN_009e3890 fails on an item that does not load).
func _first_worn(codes: Array) -> int:
	if _item_id_by_code.is_empty():
		for id in _item_rows:
			var row = _item_rows[id]
			if row != null:
				_item_id_by_code[String(row.code_name)] = int(id)
	for code in codes:
		var id := int(_item_id_by_code.get(String(code), 0))
		if id > 0 and _item_models.has(id):
			return id
	return 0

## A dressed body for an NPC thief or hunter (JobMobDress, READ rules):
## {"assembled", "label_height", "radius", "scale"}, or {} for any other
## monster or when the tables or the body are missing.
func _dress_job_mob(monster: CombatNet.MonsterSnapshot) -> Dictionary:
	if _appearance == null or not JobMobDress.maybe_job_code(monster.code_name) or not _job_mob_tables_ready():
		return {}
	var row: JobMobDress.Row = _job_mob_rows.get(monster.code_name)
	if row == null:
		return {}
	var race := 1 if row.country == 1 else 0
	if not _job_mob_bodies.has(race):
		_job_mob_bodies[race] = JobMobDress.bodies(_appearance.catalog(), row.country)
	# The server's byte; OURS: the monster id's low byte from a server that
	# sends none (every viewer still agrees).
	var body_byte := monster.body if monster.body >= 0 else (monster.monster_id & 0xff)
	var pick := JobMobDress.pick_body(_job_mob_bodies[race], body_byte)
	if pick.is_empty():
		return {}
	var ref := int(pick[0])
	var man := bool(pick[1])
	# The default skill's ReqCast_Weapon1, 2 without a skill (c:0x9d35d0..).
	var weapon_type := int(_job_mob_weapons.get(row.skill, 2)) if row.skill != 0 else 2
	if row.type4 == JobMobDress.TYPE4_HUNTER and JobMobDress.armour_class(weapon_type) > 0 and (randi() & 1) == 1:
		_job_mob_ha = true
	var plan := JobMobDress.outfit(row, weapon_type, man, randi() & 1, _job_mob_ha)
	var ids: Array = []
	for id in [_first_worn(plan["weapon"]), _first_worn(plan["shield"]), _first_worn([plan["suit"]])]:
		if int(id) > 0:
			ids.append(int(id))
	for tries in plan["armour"]:
		var a := _first_worn(tries)
		if a > 0:
			ids.append(a)
	# Round 847: an outfit is a look too (CharacterLook.from_ids).
	var outfit := CharacterLook.from_ids(ref, CharacterAppearance.DEFAULT_SCALE, ids)
	var items := outfit.items()
	var built := _appearance.build_look(outfit)
	if built == null or built.assembled == null:
		return {}
	var skeleton := built.skeleton
	built.remove_child(skeleton)
	skeleton.scale = built.scale
	var group := built.weapon_group
	var tmpl := built.assembled
	built.free()
	var a := SkinnedBsrAssembler.AssembledCharacter.new()
	a.skeleton = skeleton
	a.animation_paths = tmpl.animation_paths
	a.parsed = tmpl.parsed
	a.animation_cache = tmpl.animation_cache
	a.piece_bones = tmpl.piece_bones
	a.piece_distances = tmpl.piece_distances
	a.skinned_pieces = tmpl.skinned_pieces
	a.default_group = group
	var idle := SkinnedBsrAssembler.animation_for(_data_pk2, a, BsrReader.AnimationEntry.TYPE_STAND) if _data_pk2 != null else null
	a.idle_animation = idle if idle != null else tmpl.idle_animation
	var lh := MonsterDraw.label_height(skeleton) * absf(skeleton.scale.y)
	print("World3D: NPC %s (body byte %d) dressed as %d (%s) in %s, weapon type %d, group %s" % [
		monster.code_name, body_byte, ref, "man" if man else "woman", str(items), weapon_type, group])
	return {"assembled": a, "label_height": lh, "radius": MonsterDraw.cull_radius(skeleton, lh),
		"scale": float(row.scale) / 100.0, "model": _appearance.body_path(ref)}

## Builds the body of one monster that has none (round 655: split from
## _spawn_or_update_monster; the body comes from its species' template,
## MonsterDraw.Templates). The caller has checked its region is loaded.
func _build_monster_body(monster: CombatNet.MonsterSnapshot) -> void:
	# Round 661: a species met for the first time has its template assembled
	# off the main thread; the monster waits for it (the pump queues it again
	# when poll() reports the model), its snapshot kept.
	var wanted_model := _monster_template_key(monster)
	if wanted_model != "" and _monster_async_wanted() and not _monster_templates.has(wanted_model):
		# Round 661's review: the archive is opened here, on the main thread,
		# never lazily by the worker (_assemble_monster_model's open).
		if not _monster_assemble.is_valid() and _data_pk2 == null:
			_data_pk2 = _open_pk2_if_set()
		_monster_templates.request(wanted_model, _monster_assemble if _monster_assemble.is_valid() else _assemble_monster_model)
		LatencyProbe.monster_waits(monster.monster_id, "template")
		var waiters: Dictionary = _monster_template_waiters.get(wanted_model, {})
		waiters[monster.monster_id] = true
		_monster_template_waiters[wanted_model] = waiters
		return
	# Round 809: its characterInfo row's ride (MonsterRide) is assembled off the
	# main thread too, and the body waits for it, so the two fade in together;
	# its die model is asked for now, ahead of its death (not waited for).
	var char_rec: SoundTable.CharacterInfo = _monster_char_record(monster.code_name) if wanted_model != "" else null
	var ride_model := char_rec.ride if char_rec != null and not _qa_no_rides else ""
	if char_rec != null and _monster_async_wanted():
		if char_rec.die_bsr != "" and not _monster_templates.has(char_rec.die_bsr):
			if not _monster_assemble.is_valid() and _data_pk2 == null:
				_data_pk2 = _open_pk2_if_set()
			_monster_templates.request(char_rec.die_bsr, _monster_assemble if _monster_assemble.is_valid() else _assemble_monster_model)
		if ride_model != "" and not _monster_templates.has(ride_model):
			if not _monster_assemble.is_valid() and _data_pk2 == null:
				_data_pk2 = _open_pk2_if_set()
			_monster_templates.request(ride_model, _monster_assemble if _monster_assemble.is_valid() else _assemble_monster_model)
			var ride_waiters: Dictionary = _monster_template_waiters.get(ride_model, {})
			ride_waiters[monster.monster_id] = true
			_monster_template_waiters[ride_model] = ride_waiters
			return
	# The ray finds no ground where the monster's region has not committed its
	# terrain collision yet -- the list asked for in _ready routinely arrives
	# before the neighbour cells do -- and nothing else re-places a standing
	# body. So a miss is drawn at the server's y for now and retried each
	# physics frame (_book_monster_height, _step_monster_bodies).
	LatencyProbe.lap_start()
	# Round 786: the frame's one wait for the render thread, up front and
	# taken off the reading's and the pump's budgets (RenderSync).
	var waited := RenderSync.wait_once()
	if waited > 0:
		NetClient.credit_render_sync(waited)
		_monster_pump_credit_usec += waited
	LatencyProbe.lap("render_sync")
	var pos := Vector3(monster.x, monster.y, monster.z)
	pos.y = _book_monster_height(monster.monster_id, _terrain_hit_height(pos), pos.y)
	LatencyProbe.lap("height")
	var body := Node3D.new()
	body.position = pos

	# The species' own model, resolved from the real tables by the name the
	# server calls it. Nothing is hardcoded per creature: characterdata
	# carries each row's SN_ name key and its .bsr, textdata_object resolves
	# that key to a display name, and joining the two gives 642 species by
	# name. A species the tables do not know still gets the labelled capsule.
	#
	# This replaces two hand-built species (a golem and a scorpion), each
	# with its own skeleton path, mesh directory, piece list, material and a
	# hand-derived piece-to-bone table. All of that is superseded:
	# SkinnedBsrAssembler reads the .bsr's own skeleton and meshes, and
	# computes the bone mapping.
	#
	# Round 655: assembled once per model (MonsterDraw.Templates) and
	# duplicated per body, as the NPCs are (_npc_model_cache).
	var monster_skeleton: Skeleton3D = null
	var monster_model := _monster_model_path(monster.code_name, monster.monster_name)
	# Round 809: the template of its model AND material slot (TextureType).
	var template_key := _monster_template_key(monster)
	var label_height := 2.0 * PLAYER_SCALE_RATIO
	# Round 805: an NPC thief or hunter has no model; it is a creatable body,
	# dressed (_dress_job_mob, JobMobDress).
	var dressed: Dictionary = _dress_job_mob(monster) if monster_model == "" else {}
	if monster_model != "" or not dressed.is_empty():
		var assembled: SkinnedBsrAssembler.AssembledCharacter = dressed.get("assembled") if not dressed.is_empty() \
			else _monster_templates.instance(template_key, _monster_assemble if _monster_assemble.is_valid() else _assemble_monster_model)
		LatencyProbe.lap("instance")
		if assembled != null:
			monster_skeleton = assembled.skeleton
			_monster_assembled[monster.monster_id] = assembled
			label_height = float(dressed["label_height"]) if not dressed.is_empty() else _monster_templates.label_height_of(template_key)
			monster_skeleton.set_meta(MonsterDraw.META_CULL, true)
			monster_skeleton.set_meta(MonsterDraw.META_HIDE, true)
			# Every body of this model has its template's bones (round 664,
			# MonsterCrowd.pose_at): its clips' bone indices are found once.
			# A dressed body keeps the layout its builder named.
			if dressed.is_empty():
				monster_skeleton.set_meta(MonsterCrowd.META_LAYOUT, monster_model)
			# The class's model scale (round 660, MonsterDraw.class_scale:
			# champion 1.5, giant 3.0, elite 1.7 -- READ, CICMonster::vslot_025
			# 0x9d3995), with the label, the cull radius and the collider
			# grown by it. A dressed body's also by its row's Scale / 100
			# (0x9d3a22..0x9d3a53, round 805).
			var class_scale := MonsterDraw.class_scale(monster.rarity) * float(dressed.get("scale", 1.0))
			if class_scale != 1.0:
				monster_skeleton.scale *= class_scale
				label_height *= class_scale
			var radius := float(dressed["radius"]) if not dressed.is_empty() else _monster_templates.radius_of(template_key)
			monster_skeleton.set_meta(MonsterDraw.META_RADIUS, radius * class_scale)
			# Round 794: a unique's LOD factor is 0 (an exact CICMonster of
			# rarity 3 or 8, GlobalDataManager::FUN_009c4aa0), so its cloth
			# runs at any distance (ClothDriver).
			if monster.rarity == 3 or monster.rarity == 8:
				monster_skeleton.set_meta(ClothDriver.ALWAYS_NEAR_META, true)
			_animate(assembled)
			LatencyProbe.lap("animate")
			# Round 809: its .bsr's own particles (BodyFx): the ambient set,
			# and its clips' effect files decoded off the main thread.
			_body_fx_attach(monster_skeleton, assembled.parsed, template_key)
	# Says which of the three ways a monster can come out wrong happened:
	# the species not in the tables, the model not assembling, or a real
	# model placed somewhere the player will never be. Per monster, so only
	# with the monster log on (round 655); the build summary counts them.
	if monster_skeleton == null:
		_monster_build_capsules += 1
	if _mob_logging():
		print("World3D: monster %s (%s) -> model '%s' skeleton=%s at %.0f,%.0f,%.0f (%.0f from the player)%s" % [
			monster.monster_name, monster.code_name if monster.code_name != "" else "no code",
			monster_model, "yes" if monster_skeleton != null else "NO",
			pos.x, pos.y, pos.z, pos.distance_to(player.global_position),
			" (height pending: no ground under it yet)" if _monster_heights_pending.has(monster.monster_id) else ""])

	# Real model height varies a lot by species/asset (real monster
	# skeletons are nowhere near the human PLAYER_SCALE_RATIO-derived
	# height, unscaled real native units) -- computed directly from the
	# real assembled skeleton's own bone bounds rather than reusing the
	# capsule-calibrated label offset, which would float the label wildly
	# too high (or low) above a real model of very different real size.
	# (MonsterDraw.label_height, once per template since round 655.)
	if monster_skeleton != null:
		BodyMirror.apply(monster_skeleton)
		body.add_child(monster_skeleton)
		# Round 809: its ride, under the same body (MonsterRide).
		if ride_model != "" and dressed.is_empty():
			_attach_monster_ride(monster.monster_id, body, monster_skeleton, ride_model, char_rec.ride_type)
	else:
		var mesh := MeshInstance3D.new()
		var capsule := CapsuleMesh.new()
		capsule.radius = 0.5 * PLAYER_SCALE_RATIO
		capsule.height = 1.6 * PLAYER_SCALE_RATIO
		mesh.mesh = capsule
		var mat := StandardMaterial3D.new()
		mat.albedo_color = Color(0.55, 0.15, 0.1) # dark red -- visually distinct from other players' capsules
		mesh.material_override = mat
		mesh.position.y = 0.8 * PLAYER_SCALE_RATIO
		body.add_child(mesh)

	var label := _name_plate(monster.monster_name,
		label_height / (1.0 + NAME_PLATE_CLEARANCE_FRACTION))
	label.name = "Label"
	_monster_name_look(label)
	LatencyProbe.lap("name_look")
	body.add_child(label)
	# A party monster's mark beside its name (round 660, _party_mark).
	if monster.party:
		var mark := _party_mark(label)
		if mark != null:
			label.add_child(mark)
	# A clickable collider so a left click on the monster selects or attacks
	# it (_pick_character), tagged with the id the attack is sent for.
	body.set_meta("monster_id", monster.monster_id)
	# The model drawn, which is what its measured front is keyed by
	# (MonsterMotion.front_of); "" for the capsule.
	# A dressed NPC thief or hunter (round 805) is a creatable body, whose
	# front is the same -Z (CharacterAppearance.Body): keyed by its body.
	var drawn_model := monster_model if dressed.is_empty() else String(dressed.get("model", ""))
	body.set_meta("model", drawn_model if monster_skeleton != null else "")
	body.add_child(_monster_collider(label_height))
	LatencyProbe.lap("plate+collider")

	if _qa_split != null and not _qa_split_off.is_empty():
		_qa_split_strip(body, monster_skeleton)
	# Round 813: it leans with the ground if its row says so (SlopeTilt).
	if monster_skeleton != null:
		_slope_tilt_register(body, monster.code_name, SLOPE_MOB, monster.monster_id)
	other_entities.add_child(body)
	LatencyProbe.lap("add_child")
	_monster_bodies[monster.monster_id] = body
	if LatencyProbe.on:
		LatencyProbe.monster_body(monster.monster_id, Time.get_ticks_msec(), _xz_from_player(pos))
	# Its minimap sign, decided once here (round 786, HudMinimap.monster_sign_kind).
	if HudMinimap.monster_sign_kind(monster.rarity) == "unique":
		_minimap_unique_bodies[monster.monster_id] = body
	else:
		_minimap_unique_bodies.erase(monster.monster_id)
	# Round 771: made while V is held, it starts hidden.
	if _objects_hidden and KeyMap.hides_under_v("monster"):
		body.visible = false
	# Its round shadow in Circle (round 702, CharacterBlobs).
	CharacterBlobs.register(body, float(_bc_radius_by_code.get(monster.code_name, 0.0)))
	# Its object colour before its fade starts, so the fade's twins are made
	# from the right copies (round 706 review).
	_light_character(body)
	LatencyProbe.lap("light")
	_monster_builds += 1
	# It fades into existence over 2.0 s, as retail's spawn does (round 676,
	# AppearFade: READ, CICharactor vslot 0x6c FUN_009d17e0 -> CIDecoAppear).
	_appear_fades.start(body)
	LatencyProbe.lap("fade")
	# Its buffs' auras, if the zone told any (round 646, BuffRoster).
	_fx_resync_owner(_fx_owner_key(monster.monster_id, SkillNet.OWNER_MONSTER), "its body was built")
	# Its sounds: keyed by its own sound object (MOB_CH_MANGNYANG ->
	# MOB_MANGNYANG), with no footstep material -- the handler builds a
	# monster's key without one.
	if monster_skeleton != null and _monster_assembled.has(monster.monster_id):
		var sound_owner := AnimSounds.Owner.new()
		sound_owner.label = "monster %d %s" % [monster.monster_id, monster.code_name]
		sound_owner.token = _sound_object_for(monster.code_name)
		sound_owner.parsed = (_monster_assembled[monster.monster_id] as SkinnedBsrAssembler.AssembledCharacter).parsed
		sound_owner.node = body
		# Only whether it stands on a navmesh cell matters for a monster's
		# footstep (0xa6ffc0 returns early without one); its key has no material.
		sound_owner.material = func() -> int: return _audio_material_at(body.global_position, -2) if is_instance_valid(body) else -1
		# Round 785: its swing and shout key by the attack skill it swings
		# (OpMonsterAttacked's skill id; _draw_monster_strike sets it).
		sound_owner.skill_ctx = func() -> Dictionary: return SkillAudio.context_of(body)
		_anim_sounds.register(monster_skeleton, sound_owner)
	LatencyProbe.lap("sound")
	LatencyProbe.lap_end(monster.monster_id)

# --- Many monsters (round 655) ------------------------------------------------
#
# MonsterDraw has the rules; what follows is the glue: the species templates,
# the build queue and its per-frame budget, and the region gate.

## One template per species model (MonsterDraw.Templates), freed with the
## world (_exit_tree). Kept across zone changes, like _npc_model_cache.
var _monster_templates := MonsterDraw.Templates.new()
## Bodies fading into existence (round 676, AppearFade): every monster body
## built and every other player's body; and bodies fading out of it (round
## 677, _fade_out_body), which free themselves. Stepped in _physics_process.
var _appear_fades := _make_appear_fades()

## Round 762: AppearFade's fades, whose finished fade-outs' models are freed
## from the departure free queue (a frame's share at a time) rather than all
## in the frame their fade ends.
func _make_appear_fades() -> AppearFade.Fades:
	var f := AppearFade.Fades.new()
	f.free_hook = func(model: Node) -> void: _depart_free_later(model, 0.0)
	return f
## How a template is assembled: the model's own `.bsr` out of Data.pk2. A
## Callable so the headless test can hand it a synthetic model.
var _monster_assemble := Callable()
## Round 661: a species' template is assembled on a WorkerThreadPool task
## (MonsterDraw.Templates.request) and its first bodies wait for it, instead
## of the frame that met the species assembling it on the main thread. On
## whenever the threaded load is (OPENSRO_SYNC_LOAD unset) and the model
## comes from the archive; a test with its own assembler sets it itself.
var _monster_async_templates := true
## Whether the off-thread assembly also runs a test's own assembler
## (_monster_assemble); round 655's tests keep the synchronous path.
var _monster_async_with_hook := false
## Monsters waiting for their species' template: model -> {monster id: true}.
var _monster_template_waiters := {}
## Monsters listed but not built yet, oldest first, and the same ids as a set.
var _monster_build_queue: Array[int] = []
var _monster_build_queued := {}
## Monsters whose region is not loaded: a snapshot, no body. Built when their
## region loads (_monster_cells_changed).
var _monster_deferred := {}
## Set when a region cell loads or unloads, so the next pump re-sorts the
## deferred monsters and the bodies against the loaded cells.
var _monster_cells_dirty := false
## Bodies built, of them capsules, and bodies dropped with their region --
## for the build summary line.
var _monster_builds := 0
var _monster_build_capsules := 0
var _monster_region_drops := 0
## When the queue last became non-empty (usec) and the frames it took, for
## the summary printed when it drains.
var _monster_queue_started_usec := -1
var _monster_queue_frames := 0
var _monster_queue_longest_usec := 0

## Whether a species' template is assembled off the main thread (round 661):
## the flag, the threaded load, and -- unless a test forces it -- the
## archive's own assembler.
func _monster_async_wanted() -> bool:
	return _monster_async_templates and _threaded_load() and (not _monster_assemble.is_valid() or _monster_async_with_hook)

func _assemble_monster_model(model: String) -> SkinnedBsrAssembler.AssembledCharacter:
	if _data_pk2 == null:
		_data_pk2 = _open_pk2_if_set()
	if _data_pk2 == null:
		return null
	# Round 809: a key may carry a material slot (MonsterDraw.template_key).
	# Round 860: any skeletal .bsr, whatever its type word (skinned_object).
	# The original's resource factory builds one class for types 1, 2, 3, 4,
	# 6 and 7 (READ, ResourceMgr::FUN_00be9250: all to FUN_00be8dc0, vtable
	# 0xe0b670), and a body animates whenever its resource has a skeleton and
	# clips (CCompChar::FUN_00c2b930). The horses, the unicorn and the trade
	# horses and camels are type 6 (cos\c_horse1.bsr: a .bsk, two .bms, six
	# clips; MEASURED), and were refused here and drawn as a capsule.
	return SkinnedBsrAssembler.assemble_from_archive(_data_pk2, MonsterDraw.model_of_key(model), true, false,
		MonsterDraw.slot_of_key(model), true)

## Round 809: a body's own particle effects (BodyFx).
var _body_fx := BodyFx.new()
## Models whose clip effects were sent to be decoded (EfpEffect.preload_paths).
var _body_fx_preloaded := {}

## A body's ambient set on its skeleton, and its clips' effect files decoded
## off the main thread once per model.
func _body_fx_attach(skel: Skeleton3D, parsed: BsrReader.ParsedObject, model: String) -> void:
	if skel == null or parsed == null or parsed.particle_mods.is_empty():
		return
	var archive := _open_particles_pk2_if_set()
	if archive == null:
		return
	_body_fx.particles = archive
	BodyFx.attach_ambient(skel, parsed, archive)
	if not _body_fx_preloaded.has(model):
		_body_fx_preloaded[model] = true
		var paths := BodyFx.clip_paths(parsed)
		if not paths.is_empty():
			EfpEffect.preload_paths(paths, archive)

## AnimSounds.clip_fx: a body's clip passed keys of its particle set.
func _on_clip_fx(owner: AnimSounds.Owner, skeleton: Object, set_key: String, entries: Array, restarted: bool) -> void:
	if restarted:
		_body_fx.restart(skeleton, set_key)
	if entries.is_empty() or owner == null or not is_instance_valid(owner.node) or not (skeleton is Skeleton3D):
		return
	if _body_fx.particles == null:
		_body_fx.particles = _open_particles_pk2_if_set()
	var fx := _body_fx.fire(owner.node, skeleton as Skeleton3D, set_key, entries)
	if _mob_logging() and not fx.is_empty():
		print("BODYFX %s clip %s: %d effect(s)" % [owner.label, set_key, fx.size()])

## Round 809: a monster's template key -- its model and the material slot
## its TextureType and rarity give (NpcTableReader.texture_slot, READ).
func _monster_template_key(monster: CombatNet.MonsterSnapshot) -> String:
	var model := _monster_model_path(monster.code_name, monster.monster_name)
	var tex := int(_monster_texture_by_code.get(monster.code_name, 0))
	return MonsterDraw.template_key(model, NpcTableReader.texture_slot(tex, monster.rarity))

# --- Monster rides and deaths (round 809, MonsterRide) ------------------------
#
# skilleffect.txt's characterInfo row of a monster: its ride (a second body the
# monster stands in or sits on), its die model and its death effects. The
# rules are MonsterRide's; what follows is the glue.

## Monster skeleton instance id -> its MonsterRide.
var _monster_rides := {}
## Test seam: code -> SoundTable.CharacterInfo, in place of AudioService's.
var _char_records_override = null
## OURS: the client's option byte +0x12e that lets a body with its own type-36
## clip swap to its die model (READ: the inverse of the shard entry's flag,
## 0x868bb3..0x868bd9; the default shard's flag is OPEN). On: every row's die
## model plays, as on a shard whose flag is 0.
var _die_model_option := true
## OURS (DEFFECT_FLASH): the white flash's alpha and times. READ only the call
## (FUN_00a42d20(&{255,255,255,128}, 0.2, 0.5), a CGWeatherManager colour);
## what 0.2 and 0.5 time is OPEN -- here a rise over 0.2 s and a fall over 0.5 s.
const DEAD_FLASH_ALPHA := 128.0 / 255.0
const DEAD_FLASH_IN := 0.2
const DEAD_FLASH_OUT := 0.5
var _dead_flash: ColorRect = null

## OPENSRO_QA_NO_RIDES=1 (round 809, QA A/B only): no monster builds its ride,
## so the perf gate's --ab-env can price the rides on one build.
var _qa_no_rides := OS.get_environment("OPENSRO_QA_NO_RIDES") != ""
## OPENSRO_QA_RIDE_STATIC=1 (QA A/B only): rides are built but never
## animated, mirrored or placed -- the price of the nodes alone.
var _qa_ride_static := OS.get_environment("OPENSRO_QA_RIDE_STATIC") != ""

## A monster code's characterInfo row: the code's, its OrgCodeName's, else the
## file's first (AudioService.character_record, READ FUN_00a95d30).
func _monster_char_record(code: String) -> SoundTable.CharacterInfo:
	if code == "":
		return null
	if _char_records_override is Dictionary:
		var o: Dictionary = _char_records_override
		if o.has(code):
			return o[code]
		var org := String(_monster_org_by_code.get(code, ""))
		return o.get(org) if org != "" else null
	var svc := AudioService.instance()
	if svc == null:
		return null
	return svc.character_record(code, String(_monster_org_by_code.get(code, "")))

## Builds a monster's ride from its template and hangs it under the body.
func _attach_monster_ride(monster_id: int, body: Node3D, rider: Skeleton3D, model: String, ride_type: int) -> void:
	var a: SkinnedBsrAssembler.AssembledCharacter = _monster_templates.instance(model,
		_monster_assemble if _monster_assemble.is_valid() else _assemble_monster_model)
	if a == null or a.skeleton == null:
		print("World3D: monster %d's ride %s did not assemble" % [monster_id, model])
		return
	var root := Node3D.new()
	root.name = MonsterRide.NODE
	body.add_child(root)
	a.skeleton.set_meta(MonsterDraw.META_CULL, true)
	a.skeleton.set_meta(MonsterDraw.META_HIDE, true)
	a.skeleton.set_meta(MonsterDraw.META_RADIUS, _monster_templates.radius_of(model))
	a.skeleton.set_meta(MonsterCrowd.META_LAYOUT, model)
	BodyMirror.apply(a.skeleton)
	root.add_child(a.skeleton)
	# Its own particles (BodyFx): the ambient set (Tahomet's devil glow) and its
	# clips' keys (Uruchi's dragon dust), through a silent sound owner.
	_body_fx_attach(a.skeleton, a.parsed, model)
	if not BodyFx.clip_paths(a.parsed).is_empty():
		var ride_owner := AnimSounds.Owner.new()
		ride_owner.label = "monster %d's ride" % monster_id
		ride_owner.parsed = a.parsed
		ride_owner.node = root
		ride_owner.silent = true
		_anim_sounds.register(a.skeleton, ride_owner)
	var r := MonsterRide.new()
	r.monster_id = monster_id
	r.body = body
	r.rider = rider
	r.rider_rest = rider.transform
	r.root = root
	r.assembled = a
	r.ride_type = ride_type
	r.model = model
	_monster_rides[rider.get_instance_id()] = r
	# Its stand (READ: group "cart" type 0 at the spawn), its own clip-tick body.
	# Its stand (READ: group "cart" type 0 at the spawn), posed with its
	# monster from now on (_pose_ride).
	r.clip = a.idle_animation
	r.clip_loop = true
	if r.clip != null and not _qa_ride_static:
		MonsterCrowd.pose_at(a.skeleton, r.clip, _idle_anim_time, true)
	r.place()
	if _mob_logging():
		print("World3D: monster %d rides %s (type %d)" % [monster_id, model, ride_type])

## The ride of monster `monster_id`, or null.
func _monster_ride_of(monster_id: int) -> MonsterRide:
	for key in _monster_rides:
		var r: MonsterRide = _monster_rides[key]
		if r.monster_id == monster_id:
			return r
	return null

func _drop_monster_ride(monster_id: int) -> void:
	if _monster_rides.is_empty():
		return
	for key in _monster_rides.keys():
		if (_monster_rides[key] as MonsterRide).monster_id == monster_id:
			_monster_rides.erase(key)

## An assembled body's clip of `action_type` (SkinnedBsrAssembler.animation_for),
## from its cache alone when there is no archive (a test's synthetic body).
func _assembled_clip(a: SkinnedBsrAssembler.AssembledCharacter, action_type: int, group: String = "default") -> BanReader.ParsedAnimation:
	if a == null or a.parsed == null:
		return null
	if _data_pk2 == null:
		var path := a.parsed.animation_for(action_type, group)
		if path == "" or not a.animation_cache.has(path):
			return null
	return SkinnedBsrAssembler.animation_for(_data_pk2, a, action_type, group)

## Round 813: the bodies that lean with the ground they stand on (SlopeTilt,
## docs/protocol/slope_tilt.md): body instance id -> [body, SlopeTilt.State,
## kind (SLOPE_MOB or SLOPE_COS), its monster id or COS uid, its region pair
## (the [NavGraph, group] it last stood in)]. Only a monster's or a COS's,
## and only with a non-zero characterdata column 80 (READ: nothing else ever
## marks its normal stale).
var _slope_tilts := {}
## The bodies to look at this frame: those a move or a turn filed
## (SlopeTiltBody, the original's slot-15 events) and those still easing.
## Standing bodies whose eases ended cost nothing (round 813's perf gate:
## polling 2,500 every frame cost 14 ms).
var _slope_hot := {}
const SLOPE_MOB := 0
const SLOPE_COS := 1

## Puts a body on the slope tilt's list when its row tilts, before it enters
## the tree (its script, SlopeTiltBody, reports its moves and turns).
func _slope_tilt_register(body: Node3D, code: String, kind: int, id: int) -> void:
	var value := int(_slope_tilt_by_code.get(code, 0))
	if value == 0 or body == null or body.get_script() != null:
		return
	body.set_script(SlopeTiltBody)
	(body as SlopeTiltBody).hot = _slope_hot
	body.set_notify_transform(true)
	var key := body.get_instance_id()
	_slope_tilts[key] = [body, SlopeTilt.State.new(value), kind, id, []]
	_slope_hot[key] = true

## The node a tilting body's model hangs from: its skeleton (the die model's
## after a swap, which takes the old one's transform as the original keeps its
## matrix, READ 0xa59cc0).
func _slope_tilt_model(kind: int, id: int) -> Node3D:
	var a: SkinnedBsrAssembler.AssembledCharacter = _monster_assembled.get(id) if kind == SLOPE_MOB else _cos_assembled.get(id)
	if a == null or a.skeleton == null or not is_instance_valid(a.skeleton):
		return null
	return a.skeleton

## Every frame: each hot tilting body that is not a ridden mount (those lean
## in _cos_place_riders, before their riders are seated on them); one whose
## eases have ended and whose normal is current leaves the hot set.
func _step_slope_tilts(delta: float) -> void:
	if not _slope_hot.is_empty():
		for key in _slope_hot.keys():
			var e = _slope_tilts.get(key)
			if e == null:
				_slope_hot.erase(key)
				continue
			if not is_instance_valid(e[0]):
				if _qa_slope_on:
					print("QA SLOPE: body of %d is gone" % int(e[3]))
				_slope_tilts.erase(key)
				_slope_hot.erase(key)
				continue
			if int(e[2]) == SLOPE_COS and _cos_rider_of(int(e[3])) >= 0:
				continue
			if not _slope_tilt_body(e, delta):
				_slope_hot.erase(key)
	if _qa_slope_due():
		_qa_slope_report()
	if _qa_guild_on and Engine.get_process_frames() % 60 == 0:
		_qa_guild_report()

## The [NavGraph, group] a body stands in: the one it stood in last when the
## point is still inside it, else the lookup (_nav_graph_for).
func _slope_pair(e: Array, pos: Vector3) -> Array:
	var pair: Array = e[4]
	if pair.size() == 2 and is_instance_valid(pair[1]):
		var graph: NavGraph = pair[0]
		var local := (pair[1] as Node3D).to_local(pos)
		if graph.dungeon or (local.x >= 0.0 and local.z >= 0.0 and local.x <= REGION_SPAN and local.z <= REGION_SPAN):
			return pair
	pair = _nav_graph_for(pos)
	e[4] = pair
	return pair

## One body's frame of the slope tilt (SlopeTilt's header): a moved or turned
## body asks the ground under it for a new normal, both eases advance, and on a
## frame either moved its model node is turned about the feet. False when
## there is nothing more to do until it moves or turns again.
func _slope_tilt_body(e: Array, delta: float) -> bool:
	var body: Node3D = e[0]
	var st: SlopeTilt.State = e[1]
	var model := _slope_tilt_model(int(e[2]), int(e[3]))
	if model == null or not body.is_inside_tree():
		# Not drawn yet (or its skeleton is being swapped): looked at again
		# when it moves, or while its normal is stale.
		return st.stale
	# A monster seated on its ride's saddle takes the saddle's matrix after
	# its own (ICharactor::FUN_009d05d0 runs after FUN_009c9400): it never
	# leans (MonsterRide, type none).
	var ride: MonsterRide = _monster_rides.get(model.get_instance_id()) if int(e[2]) == SLOPE_MOB else null
	if ride != null and ride.ride_type == SoundTable.RIDE_NONE:
		return false
	if not st.has_rest:
		st.rest = model.transform
		st.has_rest = true
	var pos := body.global_position
	var front: Vector3 = body.global_basis * st.rest.basis.z
	if pos != st.last_pos or not front.is_equal_approx(st.last_front):
		st.stale = true
		st.last_pos = pos
		st.last_front = front
	if st.stale:
		var pair := _slope_pair(e, pos)
		if not pair.is_empty():
			var group: Node3D = pair[1]
			var local := group.to_local(pos)
			st.region_basis = group.global_basis
			st.retarget((pair[0] as NavGraph).ground_normal_at(local.x, local.z, local.y))
			st.stale = false
	if st.advance(delta):
		st.applied = SlopeTilt.in_body(st.n, front, st.k, st.region_basis, body.global_basis)
		model.transform = Transform3D(st.applied, Vector3.ZERO) * st.rest
		# A dummy ride is the monster's whole transform (FUN_009d0660).
		if ride != null and ride.ride_type == SoundTable.RIDE_DUMMY and is_instance_valid(ride.root):
			ride.root.transform = BodyMirror.unmirrored(model.transform)
	return st.stale or (st.enabled and not (st.n_done and st.k_done))

## OPENSRO_QA_GUILD (round 814): every 60 frames, every guild line drawn --
## its text, its colour (8-bit), and how far above its name line it sits on
## the screen (a fixed-size plate's offsets are screen pixels times the font
## factor, _plate_fk).
var _qa_guild_on := OS.get_environment("OPENSRO_QA_GUILD") != ""
func _qa_guild_report() -> void:
	var holders: Array = [player]
	for id in _other_bodies:
		holders.append(_other_bodies[id])
	for h in holders:
		if h == null or not is_instance_valid(h):
			continue
		_qa_plate_boxes(h as Node)
		var g := (h as Node).find_child("GuildLine", true, false) as Label3D
		if g == null:
			continue
		var name_label := g.get_parent().get_node_or_null("Name") as Label3D
		if name_label == null and g.get_parent() is Label3D:
			name_label = g.get_parent() as Label3D
		var fk := _plate_fk(g)
		var gap := (g.offset.y - name_label.offset.y) / fk if name_label != null else NAN
		var c := g.modulate
		print("QA GUILD: %s '%s' colour (%d, %d, %d) %.1f px above its name (fixed size %s), shown %s" % [
			"own" if h == player else String((h as Node).name), g.text, roundi(c.r8), roundi(c.g8), roundi(c.b8),
			gap, g.fixed_size, g.is_visible_in_tree()])

## Round 842 (QA only, with OPENSRO_QA_GUILD): a holder's name box and its
## stall title's box -- text, box size and box centre in plate pixels -- so a
## run can tell whether a box widened.
func _qa_plate_boxes(h: Node) -> void:
	var parts: PackedStringArray = []
	for n in ["Name", StallWorld.TITLE_NODE]:
		var l := h.get_node_or_null(n) as Label3D
		if l == null:
			continue
		var b := l.get_node_or_null("NameBox") as Sprite3D
		var fk := _plate_fk(l)
		var r := NamePlates.box_rect(l)
		parts.append("%s '%s' box %s at y %.1f px (rect %.0fx%.0f)" % [n, l.text,
			str(b.texture.get_size()) if b != null and b.texture != null else "none (batched)",
			(b.offset.y if b != null else r.position.y) / fk, r.size.x / fk, r.size.y / fk])
	if not parts.is_empty():
		print("QA PLATE: frame %d %s %s" % [Engine.get_frames_drawn(), "own" if h == player else String(h.name), "; ".join(parts)])

## OPENSRO_QA_SLOPE: every 60 frames, the tilting bodies nearest the player --
## the ground's normal, the eased one, the factors and the model's lean.
var _qa_slope_on := OS.get_environment("OPENSRO_QA_SLOPE") != ""
func _qa_slope_due() -> bool:
	return _qa_slope_on and Engine.get_process_frames() % 60 == 0
func _qa_slope_report() -> void:
	print("QA SLOPE: %d bod(ies) on the list, %d hot" % [_slope_tilts.size(), _slope_hot.size()])
	var rows: Array = []
	for key in _slope_tilts:
		var e: Array = _slope_tilts[key]
		if is_instance_valid(e[0]):
			rows.append([(e[0] as Node3D).global_position.distance_to(player.global_position), e])
	rows.sort_custom(func(a: Array, b: Array) -> bool: return a[0] < b[0])
	for r in rows.slice(0, 6):
		var e: Array = r[1]
		var st: SlopeTilt.State = e[1]
		var model := _slope_tilt_model(int(e[2]), int(e[3]))
		var lean := 0.0
		if model != null:
			lean = rad_to_deg(model.global_basis.y.normalized().angle_to(Vector3.UP))
		var n_world: Vector3 = st.region_basis * st.n
		print("QA SLOPE: %s %d at (%.1f, %.1f, %.1f) %.0f away: normal %s (%.1f deg off up) eased %.2f/%.2f, factors %s, model up %.2f deg off vertical" % [
			"mob" if int(e[2]) == SLOPE_MOB else "cos", e[3], (e[0] as Node3D).global_position.x, (e[0] as Node3D).global_position.y, (e[0] as Node3D).global_position.z,
			float(r[0]), str(n_world.normalized()), rad_to_deg(n_world.normalized().angle_to(Vector3.UP)),
			st.n_t, st.k_t, str(st.k), lean])

## Every frame: each ride where its type puts it, and a seated rider on its
## saddle (MonsterRide.place). Round 809's perf gate: a ride is posed and
## placed with its monster (_pose_ride); this only keeps every ride's
## visibility its monster's (the clip tick hides a body out of range) and
## drops the dead, every MonsterRide.SYNC_EVERY frames (`force`: now).
func _step_monster_rides(force: bool = false) -> void:
	if _qa_ride_static or _monster_rides.is_empty():
		return
	if not force and Engine.get_process_frames() % MonsterRide.SYNC_EVERY != 0:
		return
	for key in _monster_rides.keys():
		var r: MonsterRide = _monster_rides[key]
		if not r.valid():
			_monster_rides.erase(key)
			continue
		var skel := r.assembled.skeleton
		if skel.visible != r.rider.visible:
			skel.visible = r.rider.visible
		r.place()

## The clip tick posed `skeleton` with `anim` at `t` (seconds: a loop's clock,
## a one-shot's elapsed time): its ride, if it has one, takes the clip of the
## same action type and is posed with it, then seated (MonsterRide's header).
func _pose_ride(skeleton: Skeleton3D, anim: BanReader.ParsedAnimation, t: float, loop: bool, audible: bool) -> void:
	var r: MonsterRide = _monster_rides.get(skeleton.get_instance_id())
	if r == null or _qa_ride_static:
		return
	var skel := r.assembled.skeleton if r.assembled != null else null
	if skel == null or not is_instance_valid(skel):
		return
	if r.src != anim:
		r.src = anim
		var c = r._clips.get(anim.get_instance_id(), false)
		if typeof(c) == TYPE_BOOL:
			var tag = (anim.get_meta(BsrReader.CLIP_META) if anim.has_meta(BsrReader.CLIP_META) else null)
			c = _assembled_clip(r.assembled, int(tag[0]), MonsterRide.GROUP) if tag != null else null
			if c != null and _frame_count(c) <= 1:
				c = null
			r._clips[anim.get_instance_id()] = c
		if c != null:
			r.clip = c
			r.clip_loop = loop
			r.clip_start = _idle_anim_time - (0.0 if loop else t)
			r.follows = true
		else:
			r.follows = false
	if r.clip == null:
		return
	var at := t
	if not r.follows:
		at = _idle_anim_time if r.clip_loop else minf(_idle_anim_time - r.clip_start, r.clip.duration_seconds())
	MonsterCrowd.pose_at(skel, r.clip, at, r.clip_loop)
	r.place()
	if audible and _anim_sounds.owner_of(skel) != null:
		_anim_sounds.advance(skel, r.clip, r.clip_start, _loop_ms(r.clip, at) if r.clip_loop else at * 1000.0, r.clip_loop)

## A dying monster's body becomes its row's die model, in place, at its scale
## (READ, the DEAD state's enter 0xa59cc0: FUN_009c4ec0(die bsr) then the
## scale +0xc4 again); the die clip then plays on it (_begin_monster_death).
## OURS: a die model whose template is not assembled yet is skipped (it was
## asked for when the body was built).
func _swap_to_die_model(monster_id: int) -> bool:
	var snap = _monster_snapshots.get(monster_id)
	var old: SkinnedBsrAssembler.AssembledCharacter = _monster_assembled.get(monster_id)
	if snap == null or old == null or old.skeleton == null or not is_instance_valid(old.skeleton):
		return false
	var rec := _monster_char_record(String(snap.code_name))
	if rec == null or rec.die_bsr == "":
		return false
	var own_36 := old.parsed != null and old.parsed.animation_entry_for(BsrReader.AnimationEntry.TYPE_DIE_LOOP) != null
	if not MonsterRide.die_swaps(_die_model_option, own_36):
		return false
	if _monster_async_wanted() and not _monster_templates.has(rec.die_bsr):
		print("World3D: monster %d's die model %s is not assembled yet -- its own body dies" % [monster_id, rec.die_bsr])
		return false
	var a: SkinnedBsrAssembler.AssembledCharacter = _monster_templates.instance(rec.die_bsr,
		_monster_assemble if _monster_assemble.is_valid() else _assemble_monster_model)
	if a == null or a.skeleton == null:
		return false
	var oskel := old.skeleton
	var holder := oskel.get_parent()
	if holder == null:
		a.skeleton.free()
		return false
	a.skeleton.transform = oskel.transform
	for m in [MonsterDraw.META_CULL, MonsterDraw.META_HIDE, MonsterDraw.META_RADIUS]:
		if oskel.has_meta(m):
			a.skeleton.set_meta(m, oskel.get_meta(m))
	a.skeleton.set_meta(MonsterCrowd.META_LAYOUT, rec.die_bsr)
	holder.add_child(a.skeleton)
	holder.move_child(a.skeleton, oskel.get_index())
	# Its sounds go on with the new body's own tracks.
	var owner: AnimSounds.Owner = _anim_sounds.owner_of(oskel) if _anim_sounds != null else null
	if owner != null:
		var o2 := AnimSounds.Owner.new()
		o2.label = owner.label
		o2.token = owner.token
		o2.parsed = a.parsed
		o2.node = owner.node
		o2.material = owner.material
		o2.skill_ctx = owner.skill_ctx
		_anim_sounds.register(a.skeleton, o2)
	var ride: MonsterRide = _monster_rides.get(oskel.get_instance_id())
	if ride != null:
		_monster_rides.erase(oskel.get_instance_id())
		ride.rider = a.skeleton
		_monster_rides[a.skeleton.get_instance_id()] = ride
	_pose_fades.erase(oskel.get_instance_id())
	oskel.queue_free()
	_monster_assembled[monster_id] = a
	# Its die loop (36) under the die clip the caller plays (READ: 36 in over
	# 200 ms, then 4 at once; OpenSRO holds 4's last frame, the death pose).
	var loop36 := _assembled_clip(a, BsrReader.AnimationEntry.TYPE_DIE_LOOP)
	_animate_skeleton(a.skeleton, loop36 if loop36 != null else a.idle_animation)
	if holder is Node3D:
		_light_character(holder as Node3D)
	print("World3D: monster %d dies as %s" % [monster_id, rec.die_bsr])
	return true

## The row's Die Effect (its ACT_S rows on the body) and Dead Effect (a white
## flash) at the die clip's first type-1 key (READ, the DEAD state's event
## 0xa59e30). Nothing when the clip has no such key.
func _schedule_death_effects(monster_id: int) -> void:
	var snap = _monster_snapshots.get(monster_id)
	var a: SkinnedBsrAssembler.AssembledCharacter = _monster_assembled.get(monster_id)
	if snap == null:
		return
	var rec := _monster_char_record(String(snap.code_name))
	if rec == null or (rec.die_effect == "" and rec.dead_effect == SoundTable.DEAD_EFFECT_NONE):
		return
	var entry = a.parsed.animation_entry_for(BsrReader.AnimationEntry.TYPE_DIE) if a != null and a.parsed != null else null
	var key := MonsterRide.first_hit_key(entry)
	if key < 0:
		print("World3D: monster %d's die clip has no type-1 key -- its death effects (%s, %d) do not play" % [
			monster_id, rec.die_effect, rec.dead_effect])
		return
	var body = _monster_bodies.get(monster_id)
	var fire := func() -> void:
		print("World3D: monster %d's death effects at its die clip's key %d ms: %s%s" % [monster_id, key,
			rec.die_effect, " + DEFFECT_FLASH" if rec.dead_effect == SoundTable.DEAD_EFFECT_FLASH else ""])
		if rec.die_effect != "" and body != null and is_instance_valid(body):
			SkillEffects.play_named(rec.die_effect, SkillAudio.ACT_S, body as Node3D)
		if rec.dead_effect == SoundTable.DEAD_EFFECT_FLASH:
			_dead_flash_start()
	if key <= 0 or not is_inside_tree():
		fire.call()
	else:
		get_tree().create_timer(float(key) / 1000.0).timeout.connect(fire)

## DEFFECT_FLASH: the screen goes white at alpha 128/255 and back (INFERRED a
## whole-screen flash; times OURS, see DEAD_FLASH_IN).
func _dead_flash_start() -> void:
	if not is_inside_tree():
		return
	if _dead_flash == null or not is_instance_valid(_dead_flash):
		var layer := CanvasLayer.new()
		layer.layer = 50
		layer.name = "DeadFlash"
		add_child(layer)
		_dead_flash = ColorRect.new()
		_dead_flash.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_dead_flash.set_anchors_preset(Control.PRESET_FULL_RECT)
		layer.add_child(_dead_flash)
	_dead_flash.color = Color(1, 1, 1, 0)
	var tw := create_tween()
	tw.tween_property(_dead_flash, "color:a", DEAD_FLASH_ALPHA, DEAD_FLASH_IN)
	tw.tween_property(_dead_flash, "color:a", 0.0, DEAD_FLASH_OUT)

## Whether a world position lies in a loaded region cell (the streamed grid's
## _grid.loaded_cells, RegionGridState.cell_at). With no grid -- a loose dev
## file, the headless tests -- there is nothing to gate against: true.
func _monster_region_loaded(pos: Vector3) -> bool:
	if not _grid_has_origin:
		return true
	var cell := RegionGridState.cell_at(pos - _grid_origin_world)
	return _grid.loaded_cells.has("%d_%d" % [cell.x, cell.y])

## The render thread's wait a body build in this pump made (RenderSync),
## taken off the pump's budget.
var _monster_pump_credit_usec := 0

## Queues a listed monster's body for _pump_monster_builds.
func _queue_monster_build(monster_id: int) -> void:
	if _monster_build_queued.has(monster_id) or _monster_bodies.has(monster_id):
		return
	if _monster_build_queue.is_empty():
		_monster_queue_started_usec = Time.get_ticks_usec()
		_monster_queue_frames = 0
		_monster_queue_longest_usec = 0
		_monster_builds = 0
		_monster_build_capsules = 0
	_monster_build_queued[monster_id] = true
	_monster_build_queue.append(monster_id)

## One frame's share of the body builds: queued monsters until
## MonsterDraw.BUILD_BUDGET_USEC is spent (at least MIN_BUILDS_PER_FRAME). A
## monster gone from the snapshots (dead, or left the list) is skipped; one
## whose region is not loaded is deferred. Returns the bodies built.
func _pump_monster_builds(budget_usec: int = MonsterDraw.BUILD_BUDGET_USEC) -> int:
	# Round 661: the templates assembled off the main thread since the last
	# frame, and the monsters that waited for them back on the queue.
	for model in _monster_templates.poll():
		var waiters: Dictionary = _monster_template_waiters.get(model, {})
		_monster_template_waiters.erase(model)
		for monster_id in waiters.keys():
			_queue_monster_build(monster_id)
	if _monster_cells_dirty:
		_monster_cells_dirty = false
		_monster_cells_changed()
	if _monster_build_queue.is_empty():
		return 0
	var started := Time.get_ticks_usec()
	var built := 0
	var taken := 0
	_monster_pump_credit_usec = 0
	while taken < _monster_build_queue.size():
		if built >= MonsterDraw.MIN_BUILDS_PER_FRAME and Time.get_ticks_usec() - started - _monster_pump_credit_usec >= budget_usec:
			break
		var monster_id: int = _monster_build_queue[taken]
		taken += 1
		_monster_build_queued.erase(monster_id)
		var snap = _monster_snapshots.get(monster_id)
		if snap == null or _monster_bodies.has(monster_id) or _dying_until.has(monster_id):
			continue
		var before := _monster_bodies.size()
		_spawn_or_update_monster(snap)
		if _monster_bodies.size() > before:
			built += 1
	_monster_build_queue = _monster_build_queue.slice(taken)
	var spent := Time.get_ticks_usec() - started
	_monster_queue_frames += 1
	_monster_queue_longest_usec = maxi(_monster_queue_longest_usec, spent)
	if _monster_build_queue.is_empty() and _monster_queue_started_usec >= 0:
		print("World3D: %d monster bod(ies) built over %d frame(s) in %.0f ms, longest frame %.1f ms (%d capsule(s)); %d species template(s), %d assembled in %.0f ms, %d instanced in %.0f ms; %d waiting for their region" % [
			_monster_builds, _monster_queue_frames, (Time.get_ticks_usec() - _monster_queue_started_usec) / 1000.0,
			_monster_queue_longest_usec / 1000.0, _monster_build_capsules, _monster_templates.size(),
			_monster_templates.assembles, _monster_templates.assemble_usec / 1000.0,
			_monster_templates.instances, _monster_templates.instance_usec / 1000.0, _monster_deferred.size()])
		_monster_queue_started_usec = -1
	return built

## A region cell loaded or unloaded: deferred monsters whose region is now
## loaded are queued, and bodies whose region has gone are dropped (their
## snapshots kept, deferred until it loads again).
func _monster_cells_changed() -> void:
	for monster_id in _monster_deferred.keys():
		var snap = _monster_snapshots.get(monster_id)
		if snap == null:
			_monster_deferred.erase(monster_id)
			continue
		if _monster_region_loaded(Vector3(snap.x, snap.y, snap.z)):
			_monster_deferred.erase(monster_id)
			_queue_monster_build(monster_id)
	var dropped := 0
	for monster_id in _monster_bodies.keys():
		if _dying_until.has(monster_id):
			continue
		var body = _monster_bodies[monster_id]
		if body == null or not is_instance_valid(body):
			continue
		if _monster_region_loaded((body as Node3D).position):
			continue
		_free_monster_body(monster_id, true)
		if _monster_snapshots.has(monster_id):
			_monster_deferred[monster_id] = true
		dropped += 1
	if dropped > 0:
		_monster_region_drops += dropped
		print("World3D: %d monster bod(ies) dropped with their region; %d waiting for their region" % [dropped, _monster_deferred.size()])

## Takes one monster's body out of the world and everything kept about the
## body (not the snapshot): the list's removal, a region unloading, a death
## played out. `keep_buffs` (a region unloading: the monster lives on) keeps
## the buffs the zone told of it, so the rebuilt body's auras come back
## (_fx_resync_owner). `fade` (round 677: a despawn -- the monster left the
## area, entered a town, or its corpse's time ran out) hands the body to
## _fade_out_body instead of freeing it: it fades over 1.5 s and frees
## itself, no longer this monster's body.
func _free_monster_body(monster_id: int, keep_buffs: bool = false, fade: bool = false) -> void:
	# Round 859 (READ, CICharactor's destructor GlobalDataManager::FUN_009d2900
	# runs FUN_009cb7c0): orbs still waiting leave as the body goes.
	if _orb_pending.has(monster_id):
		_orb_launch(monster_id)
	_orb_death_passed.erase(monster_id)
	var body = _monster_bodies.get(monster_id)
	# Its look (round 785's client review, finding 6): the pulse, the clip
	# speed (keyed by its skeleton, which goes) and the look's book; a body
	# rebuilt later takes its states again (_state_look_resync).
	_drop_state_look(_fx_owner_key(monster_id, SkillNet.OWNER_MONSTER),
		body as Node3D if body != null and is_instance_valid(body) else null)
	if body != null and is_instance_valid(body):
		if fade:
			if monster_id == _last_attack_target:
				# The target window closes as the fade starts. INFERRED: retail
				# takes the object out of its id hash and zeroes its id at once
				# (IGIDObject::FUN_009c3270), so nothing names it any more.
				_clear_target()
				_last_attack_target = -1
				_target_buff_book.drop(_fx_owner_key(monster_id, SkillNet.OWNER_MONSTER))
			if not _pending_attack.is_empty() and int(_pending_attack["monster"]) == monster_id:
				_drop_pending_attack()
			# It stops where it is (OURS: whether retail's mover runs on for
			# the 1.5 s was not read).
			if _monster_motion.has(monster_id) and bool((_monster_motion[monster_id] as Dictionary).get("moving", false)):
				_set_monster_gait(monster_id, BsrReader.AnimationEntry.TYPE_STAND)
			_fade_out_body(body as Node3D)
		else:
			(body as Node).queue_free()
	_monster_bodies.erase(monster_id)
	_minimap_unique_bodies.erase(monster_id)
	_drop_monster_ride(monster_id)
	SkillEffects.detach_owner(_fx_owner_key(monster_id, 1))
	if not keep_buffs:
		_fx_owner_buffs.erase(_fx_owner_key(monster_id, 1))
	_monster_assembled.erase(monster_id)
	_dying_until.erase(monster_id)
	_monster_motion.erase(monster_id)
	_monster_heights_pending.erase(monster_id)
	_strike_waits.erase(monster_id)

## Round 786 (QA, LatencyProbe): how far `at` is from the player on the
## ground plane.
func _xz_from_player(at: Vector3) -> float:
	if player == null:
		return 0.0
	return Vector2(at.x - player.global_position.x, at.z - player.global_position.z).length()

## Forgets a monster entirely: its body, its snapshot and any queued or
## deferred build. `fade`: its body fades out (_free_monster_body).
func _forget_monster(monster_id: int, fade: bool = false) -> void:
	LatencyProbe.monster_forget(monster_id)
	_free_monster_body(monster_id, false, fade)
	_monster_snapshots.erase(monster_id)
	_monster_deferred.erase(monster_id)
	_monster_build_queued.erase(monster_id)
	_monster_server_pos.erase(monster_id)
	_monster_swing_until.erase(monster_id)

## A body leaving the world fades out (round 677, AppearFade.Fades.start_out;
## READ: a despawn makes a 1.5 s CIDecoDisappear, docs/protocol/appear_fade.md)
## and frees itself when the fade ends. From here it is nobody's body: the
## caller has dropped it from its map (retail's FUN_009c3270 takes the
## object out of the id hash before the deco starts), so the same id coming
## back is a fresh body fading in beside this one fading out, as in retail.
## Its click collider goes now, so it cannot be picked or attacked (OURS;
## READ only that its id is zeroed -- what retail's pick, FUN_0078ee20,
## does with a fading body it still lists is OPEN). Its name plate and party
## mark stay as they are until it is freed: retail draws the name while the
## object exists, at full alpha (FUN_009d20d0 -> FUN_009d0a80, no id test;
## the deco never touches it). Its effects (buff auras) are detached by the
## caller (READ: vslot 0x3c(1, 0) -> FUN_009ccf50 stops the object's
## attached list at the despawn).
## Round 762 (OURS; docs/rounds/r762.md): a crowd leaving at once -- a walk out
## of its blocks, a group despawn of thousands -- is taken apart a frame's
## share at a time. Retail takes every body of a group despawn in the one
## handler and deletes them together when their 1.5 s fades end (READ,
## r762.md); here that was a 410 ms frame and a 593 ms one at 1,000 bodies
## (MEASURED). A departure is taken whole -- every book, its plate, circle and
## click body, its fade-out begun -- while the frame's DEPART_BUDGET_USEC
## lasts, and queued by id past it (_depart_ids, oldest first); its holder is
## freed from _depart_free when the fade is over (DEPART_FREE_BUDGET_USEC a
## frame), drawing nothing meanwhile.
var _depart_ids: Array = []
var _depart_ids_at := 0
var _depart_pending := {}
var _depart_frame := -1
var _depart_spent_usec := 0
var _depart_free: Array = []   # [holder, due (_idle_anim_time, s), CrowdGpu key or null]
var _depart_free_at := 0
const DEPART_BUDGET_USEC := 2000
const DEPART_FREE_BUDGET_USEC := 2000
## Round 762's review, F4 (OURS): the departures' least time a frame, whatever
## the crowd budget left (a departure is about 37 us: some 27 a frame).
const DEPART_FLOOR_USEC := 1000
## Round 762's review, F7: holders due at once (an AppearFade model's
## free_hook) wait in their own queue, not behind a player's 1.5 s fade.
var _depart_free_now: Array = []
var _depart_free_now_at := 0

## The queued departures, oldest first, while the frame's DEPART_BUDGET_USEC
## lasts (one at least); then the holders whose fade-out is over.
func _depart_step() -> void:
	var fs := FrameSplit.on
	_depart_roll()
	var t0 := Time.get_ticks_usec()
	var n := 0
	var dep_budget := clampi(maxi(OtherCrowd.FrameBudget.left(), DEPART_FLOOR_USEC), 0, DEPART_BUDGET_USEC - _depart_spent_usec)
	while _depart_ids_at < _depart_ids.size():
		if n > 0 and Time.get_ticks_usec() - t0 >= dep_budget:
			break
		var id: int = _depart_ids[_depart_ids_at]
		_depart_ids_at += 1
		if not _depart_pending.has(id):
			continue
		_depart_pending.erase(id)
		n += 1
		_on_entity_left_now(id)
	_depart_spent_usec += Time.get_ticks_usec() - t0
	OtherCrowd.FrameBudget.spend(Time.get_ticks_usec() - t0)
	if _depart_ids_at >= _depart_ids.size():
		_depart_ids.clear()
		_depart_ids_at = 0
	var t1 := Time.get_ticks_usec()
	var free_budget := clampi(OtherCrowd.FrameBudget.left(), 0, DEPART_FREE_BUDGET_USEC)
	if fs:
		FrameSplit.add("w_depart", t1 - t0)
	# The holders whose fade is over, freed oldest first (the fades' clock:
	# CrowdGpu's, the clip time): those due at once first, then the fades'.
	# Each queue's entries are due in the order they came (one delay each),
	# so neither waits behind an entry of the other not due yet.
	var freed := _depart_free_queue(_depart_free_now, true, t1, free_budget, 0)
	freed = _depart_free_queue(_depart_free, false, t1, free_budget, freed)
	OtherCrowd.FrameBudget.spend(Time.get_ticks_usec() - t1)
	if fs:
		FrameSplit.add("w_depart_free", Time.get_ticks_usec() - t1)

## Frees the due holders at the head of `q` (_depart_free_now when `now`,
## else _depart_free) until `budget` from `t1` (one at least a frame, counting
## `freed` already). Returns the frees counted.
func _depart_free_queue(q: Array, now: bool, t1: int, budget: int, freed: int) -> int:
	var at := _depart_free_now_at if now else _depart_free_at
	while at < q.size():
		var e: Array = q[at]
		if float(e[1]) > _idle_anim_time or (freed > 0 and Time.get_ticks_usec() - t1 >= budget):
			break
		at += 1
		freed += 1
		var holder = e[0]
		if holder == null or not is_instance_valid(holder):
			continue
		if _crowd_gpu != null:
			var key = e[2]
			if key != null and is_instance_valid(key):
				_crowd_gpu.remove(key, false, true)
		# Freed now, not queued: a queue_free's deletion runs at the frame's
		# end, outside this budget (MEASURED live: 8-15 ms of post_flush a
		# frame while a crowd's holders were freed).
		if (holder as Node).is_queued_for_deletion():
			continue
		(holder as Node).free()
	if at >= q.size():
		q.clear()
		at = 0
	elif at > 512:
		var rest := q.slice(at)
		q.clear()
		q.append_array(rest)
		at = 0
	if now:
		_depart_free_now_at = at
	else:
		_depart_free_at = at
	return freed

## The holders waiting to be freed, both queues.
func _depart_free_left() -> int:
	return _depart_free.size() - _depart_free_at + _depart_free_now.size() - _depart_free_now_at

## A departing body's plate, circle and click body go at once (OURS: the
## original's name over a fading character was not read), so nothing of it
## outlives its fade while its holder waits to be freed.
func _depart_teardown(body: Node3D) -> void:
	for c in body.get_children():
		if c is Label3D and _plate_batch != null:
			_plate_batch.remove(c as Label3D)
	if body.is_in_group(CharacterBlobs.GROUP):
		body.remove_from_group(CharacterBlobs.GROUP)

## Every queued departure freed now (a zone change: the old zone's bodies go
## at once, as everything else of it does).
func _depart_flush() -> void:
	# The queued departures' bodies are the zone's (freed with it).
	_depart_ids.clear()
	_depart_ids_at = 0
	_depart_pending.clear()
	for pair in [[_depart_free, _depart_free_at], [_depart_free_now, _depart_free_now_at]]:
		var q: Array = pair[0]
		for i in range(int(pair[1]), q.size()):
			var e: Array = q[i]
			var holder = e[0]
			if holder == null or not is_instance_valid(holder):
				continue
			var key = e[2]
			if _crowd_gpu != null and key != null and is_instance_valid(key):
				_crowd_gpu.remove(key, false, true)
			(holder as Node).queue_free()
	_depart_free.clear()
	_depart_free_at = 0
	_depart_free_now.clear()
	_depart_free_now_at = 0

## `holder`'s fade-out is over in `seconds`: then it is freed (its far body off
## the instances first) from the free queue.
func _depart_free_later(holder: Node, seconds: float) -> void:
	var key: Object = null
	if _crowd_gpu != null and holder != null:
		var b: CrowdGpu.Body = _crowd_gpu.body_by_node(holder)
		if b != null:
			key = b.key if b.ghost else b.skel
	(_depart_free_now if seconds <= 0.0 else _depart_free).append([holder, _idle_anim_time + seconds, key])

## Round 762: a departing near body (another player's, posed on the CPU) put
## on the GPU, from its skeleton and its clip tick's entry, so it fades out
## there. False when it cannot be (not a player's, still fading in on the
## CPU, a part the far path does not draw): AppearFade fades it.
func _far_for_departure(body: Node3D) -> bool:
	if not body.has_meta("character_id") or _appear_fades.fading(body):
		return false
	var skel: Skeleton3D = null
	for c in body.get_children():
		if c is Skeleton3D:
			skel = c
			break
	if skel == null or not skel.is_inside_tree():
		return false
	var at := -1
	for i in range(_animated.size()):
		if (_animated[i] as Array)[0] == skel:
			at = i
			break
	if at < 0 or not _crowd_gpu.add(body, skel, _animated[at], _idle_anim_time):
		return false
	_animated.remove_at(at)
	return true

func _fade_out_body(body: Node3D, free_click: bool = true) -> void:
	if body == null or not is_instance_valid(body) or body.is_queued_for_deletion():
		return
	_drop_click_body(body, free_click)
	# Round 771: a departing player or monster is still the object it was
	# until it is freed, and V hides it as it hid it before (the original's
	# draw keeps its predicate test while the disappear deco runs; READ).
	if body.has_meta("character_id") or body.has_meta("monster_id"):
		_departing_bodies[body.get_instance_id()] = body
		if _objects_hidden and body.visible:
			body.visible = false
			body.set_meta(V_HIDDEN, true)
	# Round 756: a ghost fades out on the GPU over the same 1.5 s. Round 762: a
	# built far body too, and a near one is put on the GPU to fade there
	# (AppearFade's material twins for a near body were 7-12 ms each,
	# MEASURED r762.md); then its holder is freed from the free queue.
	if _crowd_gpu != null and (_crowd_gpu.fade_out(body) or (_far_for_departure(body) and _crowd_gpu.fade_out(body))):
		_depart_free_later(body, AppearFade.DISAPPEAR_SECONDS)
		return
	if not _mob_logging():
		_appear_fades.start_out(body)
		return
	var what := "monster %d" % int(body.get_meta("monster_id")) if body.has_meta("monster_id") \
		else "player %d" % int(body.get_meta("character_id")) if body.has_meta("character_id") \
		else "ground item %d" % int(body.get_meta("ground_item_id", -1))
	var started_ms := Time.get_ticks_msec()
	print("World3D: %s fades out over %.1fs (ticks %d)" % [what, AppearFade.DISAPPEAR_SECONDS, started_ms])
	_appear_fades.start_out(body, AppearFade.DISAPPEAR_SECONDS, func(_m: Node) -> void:
		print("World3D: %s faded out and is freed after %d ms" % [what, Time.get_ticks_msec() - started_ms]))

## Takes a body's click colliders away: out of the physics layers at once,
## so a ray this frame passes through to what is behind, and freed. A dead
## monster's (round 677's review) and a fading body's.
func _drop_click_body(body: Node3D, free: bool = true) -> void:
	if body == null or not is_instance_valid(body):
		return
	for c in body.get_children():
		if c is CollisionObject3D:
			(c as CollisionObject3D).collision_layer = 0
			# Round 762: a departure's goes with its holder (the free queue).
			if free:
				c.queue_free()

## A click-target collider for a monster: a capsule as tall as the model,
## on the monster layer only, so a ray can pick it out for an attack while
## it neither blocks movement nor catches the ground-snap ray.
func _monster_collider(height: float) -> StaticBody3D:
	var shape := CapsuleShape3D.new()
	shape.height = maxf(height, 1.0)
	shape.radius = maxf(height * 0.3, 1.0)
	var sb := StaticBody3D.new()
	sb.name = "ClickBody"
	sb.collision_layer = MONSTER_COLLISION_LAYER
	sb.collision_mask = 0
	var cs := CollisionShape3D.new()
	cs.shape = shape
	cs.position = Vector3(0.0, shape.height * 0.5, 0.0)
	sb.add_child(cs)
	return sb

## The monster under a screen point (the monster layer only), or -1: the
## double click's pick (_dispatch_double_click). A dying monster is none.
func _monster_at(screen_pos: Vector2) -> int:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
	query.exclude = [player.get_rid()]
	query.collision_mask = MONSTER_COLLISION_LAYER
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	if hit.is_empty():
		return -1
	var node := hit["collider"] as Node
	while node != null and not node.has_meta("monster_id"):
		node = node.get_parent()
	if node == null or _dying_until.has(int(node.get_meta("monster_id"))):
		return -1
	return int(node.get_meta("monster_id"))

## Side-effect-free version of both click rays, for the QA hook: what the
## NPC-layer ray and the monster-layer ray each hit at this screen point,
## whatever order the dispatcher runs them in.
func _probe_click_rays(screen_pos: Vector2) -> void:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	for probe in [["npc", NPC_COLLISION_LAYER | GATE_PICK_COLLISION_LAYER, "npc_name"], ["monster", MONSTER_COLLISION_LAYER, "monster_id"]]:
		var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
		query.exclude = [player.get_rid()]
		query.collision_mask = int(probe[1])
		var hit := get_world_3d().direct_space_state.intersect_ray(query)
		print("QA CLICK   probe %-7s layer 0b%s: %s" % [probe[0], String.num_int64(int(probe[1]), 2), _describe_click_hit(hit, str(probe[2]))])

## The items on the ground: a GroundItems node under other_entities, fed by
## the server's list and its spawned/removed/released broadcasts, drawing
## each stack with its drop model out of Data.pk2. Skipped without an
## archive (nothing to draw them with).
func _try_setup_ground_items() -> void:
	if _data_pk2 == null:
		return
	_ground_items = GroundItems.new()
	_ground_items.name = "GroundItems"
	# Unswept plates: an item's name has its own visibility rule (_name_plate).
	_ground_items.setup(_data_pk2, _item_drop_models, _item_display_name, _ground_item_plate, _terrain_hit_height)
	_ground_items.set_types_for(func(item_id: int) -> PackedInt32Array:
		var row = _item_rows.get(item_id)
		return row.type_ids if row != null else PackedInt32Array())
	# Round 862: a drop model's own `ambient` effects (GroundItems.set_effects_for).
	_ground_items.set_effects_for(_attach_drop_effects)
	other_entities.add_child(_ground_items)

## A ground item's name (round 862): the original's plate look -- font 0 at
## 12 px, 1:1 on screen, no outline (_retail_plate_look) -- in white and with
## no box. READ: CIItem::vslot_025 (c:0x9e1d00) leaves the name in the plate's
## own colour and sets 0xff72bfff through 0x8b2b70 only when the spawn's last
## byte (+0x260) is 1 (0x9e2121..0x9e212a). MEASURED: the plain box, the three
## seals (that byte 2), a +7 blade, gold and a potion (0) all draw their
## names in pure white (255, 255, 255) with no box behind them; the name has no
## plus ("Copper Blade" for a +7: vslot_025 reads the spawn's plus byte into a
## local it never uses). Until this round the pale NAME_PLATE_COLOUR placeholder drew it.
## OPEN: which items the server sends byte 1 for (not measured), so the blue
## name is not built.
const ITEM_NAME_COLOUR := Color(1.0, 1.0, 1.0)

func _ground_item_plate(text: String, above: float) -> Label3D:
	var label := _name_plate(text, above, false)
	_retail_plate_look(label, ITEM_NAME_COLOUR, false)
	label.remove_meta(NamePlates.BOX_META)
	return label

## Round 862: plays a ground item's drop model's `ambient` effects through
## the objects' ambient path (AmbientParticles.attach: the display blend, the
## glow pass), as the original draws them on the ground. They are the
## model's children, so they go with it (a pick-up's fade, a despawn).
## OPENSRO_QA_AMBIENT=off leaves them out, as it does the objects'.
func _attach_drop_effects(model: Node3D) -> int:
	if OS.get_environment("OPENSRO_QA_AMBIENT") == "off":
		return 0
	var particles := _open_particles_pk2_if_set()
	if particles == null:
		return 0
	var made := _ambient.attach(model, model.get_meta(AmbientParticles.META_ENTRIES), particles)
	if OS.get_environment("OPENSRO_QA_GROUND_DROPS") != "":
		print("GROUND DROP FX %s: %d effect(s) %s" % [model.name, made.size(), str(AmbientParticles.efp_paths(model.get_meta(AmbientParticles.META_ENTRIES)))])
	return made.size()

## The object-name table (textdata_object.txt), parsed once on first use and
## shared with the monster-model loader, which fills the same variable.
## This is where item and NPC `SN_` names live -- the UI-string catalog
## (_ui_text_table, textuisystem.txt) has none of the 9,315 `SN_ITEM_` keys,
## which is how a dropped potion came to be labelled with its mangled
## column-3 name ("HP ?? ??") while the same item's tooltip, resolved by the
## HUD through this table, read "HP Recovery Herb".
func _object_names() -> UiTextTable:
	if _object_name_table == null and _media_pk2 != null:
		# Round 731: with textdata_equip&skill.txt, the other half of the
		# client's object names (ItemTableReader.load_object_names).
		_object_name_table = ItemTableReader.load_object_names(_media_pk2)
	return _object_name_table

## The client's own English name for an item id, resolved the way the
## tooltips resolve it (ItemTableReader.Item.display_name through the
## object-name table), or "" -- never an id. A key whose first row has no
## English resolves to what the client draws for it, typically "0"
## (UiTextTable.parse).
## A name plate or a chat line that gets "" shows nothing for the name.
func _item_display_name(item_id: int) -> String:
	var row = _item_rows.get(item_id)
	if row == null:
		return ""
	return row.display_name(_object_names())

## What a chat or log line calls an item: its display name, else its code
## name (the game's own `ITEM_*` identifier from the item table -- English,
## and a real fact about the item, unlike an invented label), else nothing.
## The code name is for lines, not plates: a plate shows the name or nothing.
func _item_label_for_line(item_id: int) -> String:
	var name := _item_display_name(item_id)
	if name != "":
		return name
	var row = _item_rows.get(item_id)
	if row != null and String(row.code_name) != "":
		return String(row.code_name)
	return ""

func _on_ground_item_list_result(items: Array, error: String) -> void:
	if error != "":
		print("World3D: ground item list: %s" % error)
		return
	if _ground_items == null:
		return
	_ground_items.apply_list(items)
	print("World3D: %d item(s) on the ground in this zone (%d with no ground under them yet)" % [
		_ground_items.count(), _ground_items.pending_count()])

## OPENSRO_QA_GROUND_DROPS (round 862, QA only; see the QA tick block).
func _qa_ground_drops(spec: String) -> void:
	var n := 0
	for part in spec.split(",", false):
		var f := part.strip_edges().split(":")
		if f.size() < 3:
			continue
		var idq := f[0].split("x")
		var snap := GroundItemsNet.Snapshot.new()
		snap.id = 900000 + n
		snap.item_id = int(idq[0])
		snap.quantity = int(idq[1]) if idq.size() > 1 else 1
		snap.gold = snap.item_id == 1
		snap.x = player.global_position.x + float(f[1])
		snap.y = player.global_position.y
		snap.z = player.global_position.z + float(f[2])
		_on_ground_item_spawned(snap)
		n += 1
		print("QA GROUND DROP: item %d x%d at (%.1f, %.1f) -> %s" % [snap.item_id, snap.quantity, snap.x, snap.z,
			_ground_items.label_text(snap) if _ground_items != null else ""])
	if _ground_items != null:
		_ground_items.update_labels(player.global_position, 300.0, -1)

func _on_ground_item_spawned(snap: GroundItemsNet.Snapshot) -> void:
	if _ground_items == null:
		return
	_ground_items.spawn(snap)
	# CIItem::vslot_024: a drop sounds its kind -- gold and elixirs only, the
	# box and bag rows are commented out (read; UiSounds.item_dropped). That
	# this signal is retail's fresh drop (its +0xec == 0) is inferred.
	if _hud_panels != null:
		UiSounds.item_dropped(_hud_panels.item_types(snap.item_id), snap.gold, "ground item %d dropped" % snap.id)
	# The server's x, y, z, then the y it is drawn at: the server has no ground
	# height (a monster's drop carries the corpse's listed y), so the stack
	# stands on the terrain under its x, z, or waits for it (round 785).
	var drawn := _ground_items.position_of(snap.id)
	print("World3D: ground item %d (%s) at %.1f,%.1f,%.1f owner %d (%.1f from the player) drawn at y %.2f%s" % [
		snap.id, _ground_items.label_text(snap), snap.x, snap.y, snap.z, snap.owner_id,
		drawn.distance_to(player.global_position), drawn.y,
		" (no ground under it yet)" if _ground_items.is_pending(snap.id) else ""])
	# QA: step onto the drop and pick it, so a render's log carries the
	# server's own verdict and the bag after (see the hook list above).
	if OS.get_environment("OPENSRO_QA_PICKUP") != "" and NetClient.is_connected_to_server():
		_pending_pickup_id = snap.id
		var pos := _ground_items.position_of(snap.id)
		player.global_position = pos + Vector3(2.0, 0.0, 0.0)
		player.velocity = Vector3.ZERO
		# Tell the server where we now stand and let that packet land before the
		# pick, so its range check sees us on the item, not where we were (a
		# QA placement, round 749: under -trust-client-positions).
		_send_placement()
		print("QA PICKUP: standing at %.1f,%.1f,%.1f next to ground item %d; picking shortly" % [
			player.global_position.x, player.global_position.y, player.global_position.z, snap.id])
		# A moment on the ground (frames show the drop lying there), then pick.
		# The attack loop is gated off while _pending_pickup_id is set, so
		# nothing teleports us away in between.
		await get_tree().create_timer(1.2).timeout
		if _ground_items != null and _ground_items.has(snap.id):
			_send_placement()
			await get_tree().create_timer(0.2).timeout
			NetClient.pick_up(NetClient.current_character_name, snap.id)

func _on_ground_item_removed(removed: GroundItemsNet.Removed) -> void:
	if _ground_items == null:
		return
	# It fades out over 1.5 s (round 677; READ: CIItem's vslot 0x4c,
	# 0x9e21c0, makes the same 1.5 s CIDecoDisappear on a despawn).
	_ground_items.remove(removed.id, _fade_out_body)
	if _pending_pickup_id == removed.id:
		_pending_pickup_id = -1
	print("World3D: ground item %d gone (%s)" % [removed.id,
		"picked by %d" % removed.picker_id if removed.reason == GroundItemsNet.REMOVED_PICKED else "expired"])

func _on_ground_item_owner_released(ground_id: int) -> void:
	if _ground_items != null:
		_ground_items.release_owner(ground_id)

## The server's verdict on our pick. Too far keeps the walk going (the
## arrival branch of the movement code asks again); anything else ends it.
## A success refreshes what changed hands: the bag, or the gold on the stats.
func _on_pick_up_result(result: GroundItemsNet.PickUpResult) -> void:
	_pickup_inflight = false
	match result.code:
		0:
			_pending_pickup_id = -1
			# The item's own name in the chat line, never its id (a name the
			# table cannot give falls to the code name, see _item_label_for_line).
			var what: String
			if result.gold:
				what = "%d gold" % result.quantity
				print("World3D: picked up %s (ground item %d, item %d)" % [what, result.ground_id, result.item_id])
				# Retail's own line (round 639, READ): the ground-item handler
				# 0x87ba20 writes UIIT_MSG_STATE_GAIN_GOLD ("[%d]gold gained.")
				# for the gold kind (0xfe) through 0x778210 with type 1, the
				# GAIN filter (0x87bef4..0x87bf20).
				var gold_t := _ui_text_table.get_text("UIIT_MSG_STATE_GAIN_GOLD", "") if _ui_text_table != null else ""
				_log_system(gold_t.replace("%d", str(result.quantity)) if gold_t.contains("%d") else "Picked up %s." % what,
					HudSystemMessage.TYPE_GAIN)
			else:
				var label := _item_label_for_line(result.item_id)
				what = ("%dx %s" % [result.quantity, label]) if label != "" else ("%dx" % result.quantity)
				print("World3D: picked up %s (ground item %d, item %d)" % [what, result.ground_id, result.item_id])
				# 0x87ba20's item lines are type 1 too (0x87bec4..0x87becf).
				_log_system(_acquired_item_line(label, result.quantity), HudSystemMessage.TYPE_GAIN)
			if NetClient.is_connected_to_server():
				if result.gold:
					NetClient.character_stats(NetClient.current_character_name)
				else:
					NetClient.list_inventory(NetClient.current_character_name)
			if OS.get_environment("OPENSRO_QA_PICKUP") != "":
				print("QA PICKUP: result 0 -> %s" % what)
		GroundItemsNet.ERR_TOO_FAR:
			print("World3D: ground item %d is out of reach (%.0f units) -- walking to it" % [result.ground_id, GroundItemsNet.PICK_RANGE])
			if OS.get_environment("OPENSRO_QA_PICKUP") != "":
				print("QA PICKUP: result 4 (too far)")
		GroundItemsNet.ERR_REFUSED:
			# Round 862: held by a return scroll's cast -- no line (MEASURED:
			# the pick-up is refused and nothing is shown).
			_pending_pickup_id = -1
			print("World3D: pick of ground item %d refused (0x4004, shown nowhere)" % result.ground_id)
		_:
			_pending_pickup_id = -1
			print("World3D: cannot pick up ground item %d (server code 0x%x)" % [result.ground_id, result.code])
			# ...and SAY so. A refusal used to go to the log file only, so a
			# player saw the item stay on the ground with no reason given and
			# reported it as "loot does not go into my inventory" (playtest
			# 2026-09-20, item 9). The server has the reason; show it.
			_log_system(_pick_up_refusal_line(result.code))
			if OS.get_environment("OPENSRO_QA_PICKUP") != "":
				print("QA PICKUP: result 0x%x" % result.code)

## Retail 0x3036 (round 785): `motion.object_id` picked something up. READ,
## sro_client.exe FUN_008a78b0: the object is found by its id; it is set to
## face the angle at once (FUN_009c4260, no turn) and put in character state
## 10 (round 826: its bit 0x400 in +0x65c, which the click filter and G
## refuse on -- _issue_walk), whose enter (0xa59a00) plays the body's action type 38 once
## (BsrReader.AnimationEntry.TYPE_PICKUP, the `_pickup` clip of the body's own
## table, through the lookup every type uses; its two 0xc8 arguments read as
## 200 ms blends, INFERRED -- OpenSRO's one-shots cut in and out) and leaves
## the state when no clip is found; its event handler (0xa59a60) leaves it when
## the clip ends. The state's prerequisite and exclusion masks (0xec6168 ..
## 0xec616c) are zero: it blocks no other state (round 826: but the click
## filter and G test its bit, above). The clip's own sound track carries
## `snd_pickup` (SOUND_FORMAT.md), which AnimSounds fires as for any one-shot.
## Not modelled: the handler skips an object for which FUN_009ce930 answers
## non-zero (its +0x2ac, looked up in 0x110f7d8 -- a ridden transport,
## INFERRED; OpenSRO draws none), and state 10's other exit, event 2.
func _on_pick_up_motion(motion: GroundItemsNet.PickUpMotion) -> void:
	_sync_own_id()
	var h := GroundItemsNet.heading_of_pickup_angle(motion.angle)
	# Round 795: an ability pet's pick.
	if _cos_pick_motion(motion.object_id, h):
		return
	var own := _own_id()
	if own >= 0 and motion.object_id == (own & 0xffffffff):
		player.rotation.y = RemoteFacing.yaw_of(h, 0.0)
		_player_turn_target = NAN
		# The pick-up's heading stays (round 785's client review, finding 11).
		_combat_faces.erase(player.get_instance_id())
		if _player_skeleton == null:
			print("PICKUP MOTION: self ms=%d angle %d -- no body to animate" % [Time.get_ticks_msec(), motion.angle])
			return
		var clip := _body_animation_for(_player_body, BsrReader.AnimationEntry.TYPE_PICKUP, _player_weapon_group)
		# Round 808: state 10 fades in and out over 200 (0xa59a00, READ).
		var secs := _play_player_once(clip, ClipMixer.SHOT_IN_MS, ClipMixer.SHOT_OUT_MS)
		_player_pickup_clip = clip if secs > 0.0 else null
		print("PICKUP MOTION: self ms=%d t=%.3f angle %d heading %.3f -- clip %s, %.3f s" % [Time.get_ticks_msec(), _player_anim_time,
			motion.angle, h, _body_animation_path(_player_body, BsrReader.AnimationEntry.TYPE_PICKUP, _player_weapon_group), secs])
		return
	var id := _other_by_uid(motion.object_id)
	if id < 0 or not _other_bodies.has(id):
		print("PICKUP MOTION: id %d not drawn -- ignored" % motion.object_id)
		return
	var body: Node3D = _other_bodies[id]
	body.rotation.y = RemoteFacing.yaw_of(h, 0.0)
	_remote_turns.erase(body.get_instance_id())
	_combat_faces.erase(body.get_instance_id())
	# A far body drawn as a ghost is dressed for a one-shot (round 756).
	_dress_ghost_now(id)
	var gait: Dictionary = _other_gaits.get(id, {})
	if gait.is_empty() or not is_instance_valid(gait["skeleton"]):
		print("PICKUP MOTION: player %d ms=%d angle %d -- no assembled body" % [id, Time.get_ticks_msec(), motion.angle])
		return
	var once := _body_animation_for(gait["body"], BsrReader.AnimationEntry.TYPE_PICKUP, gait["group"])
	var secs := _play_once(gait["skeleton"], once) if once != null else 0.0
	print("PICKUP MOTION: player %d ms=%d angle %d heading %.3f -- clip %s, %.3f s" % [id, Time.get_ticks_msec(), motion.angle, h,
		_body_animation_path(gait["body"], BsrReader.AnimationEntry.TYPE_PICKUP, gait["group"]), secs])

## A move while the pick-up clip plays: the run takes over at once (OURS --
## retail's state 10 leaves on its event 2 without stopping the clip,
## 0xa59a87, and the next motion replaces it; which event 2 is was not read).
func _leave_pickup_by_moving() -> void:
	if not _player_one_shot_hold and _player_one_shot == _player_pickup_clip:
		_player_one_shot = null
		print("PICKUP MOTION: self ms=%d t=%.3f -- a move ends the clip" % [Time.get_ticks_msec(), _player_anim_time])
	_player_pickup_clip = null

## A server refusal code in words.
const ErrorText = preload("res://scripts/net/error_text.gd")
## Round 651: a berserk body's colour, size, fire, sounds and the own flash.
const BerserkLook = preload("res://scripts/effects/berserk_look.gd")

## The server's pick-up refusal in words: the game's own message from the UI
## text table where the client has one (0x1812, 0x1839), our own wording
## otherwise. The code-to-message table, its grounding in sro_client.exe and
## the codes left out are in scripts/net/error_text.gd.
func _pick_up_refusal_line(code: int) -> String:
	return ErrorText.pick_up_line(code, _ui_text_table)

## A left click on a ground item picks it up, the way clicking one does in
## the original. Ray-tests the ground-item layer only; on a hit, asks the
## server (which judges the 10-unit range and the ownership) and, so the
## player ends up in reach if they were not, walks toward the item; the
## arrival branch asks again. Returns true so the click does not also walk.
func _try_pick_up_item(screen_pos: Vector2) -> bool:
	if _ground_items == null or not NetClient.is_connected_to_server():
		return false
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
	query.exclude = [player.get_rid()]
	query.collision_mask = GroundItems.GROUND_ITEM_COLLISION_LAYER
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	if hit.is_empty():
		return false
	var node := hit["collider"] as Node
	while node != null and not node.has_meta("ground_item_id"):
		node = node.get_parent()
	if node == null:
		return false
	_pick_up_ground_item(int(node.get_meta("ground_item_id")))
	return true

## Picks up a ground item: a click on it, or G (_key_pick_up_nearest). Asks
## the server, which judges the 10-unit range and the ownership, and, so the
## player ends up in reach if they were not, walks toward the item; the
## arrival branch asks again.
func _pick_up_ground_item(ground_id: int) -> void:
	# Round 832: a pick-up is an action (0x7074 kind 2 in retail) and takes a
	# trace's place.
	_drop_trace_for_action(0, "a pick-up of ground item %d" % ground_id)
	_pending_pickup_id = ground_id
	# Only WALK if the drop is actually out of reach. Setting a move target
	# unconditionally is what made a pick-up report its own success as a
	# failure (playtest 2026-09-20): gold falls at your feet, so the arrival
	# branch fired immediately and sent a SECOND pick_up for the same id. The
	# server granted the first, removed the item, and answered the duplicate
	# with 0x1839 (3 since round 493, the engine's code for a drop that is not
	# there) -- which this client then displayed as "your inventory may be
	# full". The player had the gold and an error message about it.
	var target := _ground_items.position_of(ground_id)
	# Round 808 (OURS): seated and out of reach, the click stands instead of
	# walking, as every other walk does (retail sends a pick-up with no sit
	# test, 0x793570's DAT_00ef1c28 branch; what its server does with a
	# seated pick-up is not read).
	if target != Vector3.INF and player.global_position.distance_to(target) > GroundItemsNet.PICK_RANGE \
			and _stand_instead("a walk to ground item %d" % ground_id):
		_pending_pickup_id = -1
		return
	# Round 640 (OURS): rooted, the pick-up is asked for from where the player
	# stands and the server judges the range.
	var pick_root := _wall_root()
	if pick_root != 0 and target != Vector3.INF and player.global_position.distance_to(target) > GroundItemsNet.PICK_RANGE:
		_log_root("the walk to ground item %d" % ground_id, pick_root)
	if pick_root == 0 and target != Vector3.INF and player.global_position.distance_to(target) > GroundItemsNet.PICK_RANGE:
		_move_target = target
		_has_move_target = true
		_move_heading_run = false
		_pending_attack = {}
		_released_attack = {}
	else:
		# Picked up from where the player stands: an attack still walking into
		# reach ends here, with its walk.
		_drop_pending_attack()
	_pickup_inflight = true
	_pickup_inflight_since_ms = Time.get_ticks_msec()
	NetClient.pick_up(NetClient.current_character_name, ground_id)

## Reconciles _monster_bodies against live, the authoritative full monster
## list for the player's current zone (see _on_monster_list_result) --
## updates the body of everything in live that has one, queues a body for
## the rest (round 655: built over the next frames by _pump_monster_builds,
## and only in a loaded region), removes any tracked body no longer present
## (dead, or the player changed zones), the same snapshot-driven approach
## world.Hub's own zone-change teardown uses rather than trying to diff
## individual damaged/died events.
func _sync_monster_bodies(live: Array) -> void:
	var live_ids := {}
	for m in live:
		live_ids[m.monster_id] = true
		if _monster_bodies.has(m.monster_id):
			_spawn_or_update_monster(m)
			continue
		_monster_snapshots[m.monster_id] = m
		if _dying_until.has(m.monster_id):
			continue
		if LatencyProbe.on:
			LatencyProbe.monster_recv(m.monster_id, Time.get_ticks_msec(), _xz_from_player(Vector3(m.x, m.y, m.z)), "list")
		if not _monster_region_loaded(Vector3(m.x, m.y, m.z)):
			LatencyProbe.monster_waits(m.monster_id, "region")
			_monster_deferred[m.monster_id] = true
			continue
		_monster_deferred.erase(m.monster_id)
		LatencyProbe.monster_waits(m.monster_id, "queue")
		_queue_monster_build(m.monster_id)

	var removed: Array = []
	for monster_id in _monster_bodies.keys():
		# A monster still playing its death is left where it fell until the
		# animation has run; _finish_monster_death removes it then
		# (MonsterBodies.should_free).
		if not MonsterBodies.should_free(monster_id, live_ids, _dying_until, _idle_anim_time):
			continue
		_forget_monster(monster_id)
		removed.append(monster_id)
	# One line per body for a few (a kill's timing reads it), one for many.
	if removed.size() <= 4:
		for monster_id in removed:
			print("World3D: monster %d body removed t=%.2f" % [monster_id, _idle_anim_time])
	else:
		print("World3D: %d monster bodies removed t=%.2f" % [removed.size(), _idle_anim_time])
	# Listed before, gone now, and never built (queued or waiting for its
	# region): forgotten too.
	for monster_id in _monster_snapshots.keys():
		if not live_ids.has(monster_id) and not _monster_bodies.has(monster_id):
			_forget_monster(monster_id)
	# The first share at once, so a small list is drawn in the frame it came.
	_pump_monster_builds()

func _on_monster_list_result(monsters: Array, error: String) -> void:
	if error != "":
		push_warning("World3D: monster list refused: %s" % error)
		return
	# One line, not one per monster (round 655); OPENSRO_QA_MOB_LOG or /wire
	# lists them.
	print("World3D: server reports %d monster(s)" % monsters.size())
	if _mob_logging():
		for m in monsters:
			print("  %s at %.0f, %.0f, %.0f (%d/%d hp)" % [
				m.monster_name, m.x, m.y, m.z, m.hp, m.max_hp])
	# Before the sync: it rewrites a walking monster's listed position.
	var goto_plan := _qa_goto_plan(monsters)
	_monsters.assign(monsters)
	_sync_monster_bodies(_monsters)
	if not goto_plan.is_empty():
		_qa_goto_from_list(goto_plan)

## Monsters that left the player's area of interest (round 656,
## OP_MONSTER_LEFT) or were removed by the server -- a monster entering a
## town (round 674, session/safezone.go) is told the same way: each body
## fades out over 1.5 s and frees itself (round 677, _fade_out_body; READ:
## retail's despawn 0x3016 makes a CIDecoDisappear), and the monster leaves
## the list. A corpse still lying there fades too: retail's
## corpse leaves through the same despawn. A monster listed but not built
## yet (queued, or waiting for its region) is forgotten, so no body is built
## for it later.
func _on_monster_left(ids: Array) -> void:
	var gone := {}
	for id in ids:
		gone[int(id)] = true
	for monster_id in gone.keys():
		_forget_monster(monster_id, true)
	var kept: Array[CombatNet.MonsterSnapshot] = []
	for m in _monsters:
		if not gone.has(m.monster_id):
			kept.append(m)
	if kept.size() != _monsters.size():
		_monsters = kept
	if _mob_logging():
		print("World3D: %d monster(s) left the area of interest" % gone.size())

# --- Server-driven monster movement (round 533) ---------------------------
#
# OpenSRO's own OpMonsterMoved (0x007C) and OpMonsterMotionList (0x007F),
# docs/protocol/monster_ai.md "OpenSRO's own monster protocol
# (placeholders)". The server sends both only with its -monster-ai flag on
# (round 537, off by default); OPENSRO_QA_MOB_MOVE drives the path without it.
# The rules are MonsterMotion's; what follows is the glue.

## Whether the move lines are printed: OPENSRO_QA_MOB_LOG, or the /wire
## console switch (NetClient.wire_logging).
func _mob_logging() -> bool:
	return OS.get_environment("OPENSRO_QA_MOB_LOG") != "" or NetClient.wire_logging

## QA (round 853): OPENSRO_QA_MOB_TRACK=1 logs each monster leg as it starts
## (where the body was drawn, the message's source and end, its speed and
## factor, where the leg starts and how far that put the body), every frame
## each walking body's drawn place, and every list refresh and server snap
## that moves one -- with the wall clock in ms, against the server's own
## "aipos" pass trace (OPENSRO_AI_POS_TRACE).
var _qa_mob_track := OS.get_environment("OPENSRO_QA_MOB_TRACK") != ""

static func _qa_unix_ms() -> int:
	return int(Time.get_unix_time_from_system() * 1000.0)

## Whether `monster_id`'s body is walking a leg (a stop's glide does not count):
## the approach walk then releases only inside the stop distance
## (CombatNet.approach_releases).
func _monster_is_moving(monster_id: int) -> bool:
	var state = _monster_motion.get(monster_id)
	return state != null and MonsterMotion.turns_to_face(state)

## One monster's new leg (OpMonsterMoved). A move for a monster this client
## has no body for asks for the list, at most once every
## UNKNOWN_MOVE_PULL_SECONDS; a dying body ignores it.
func _on_monster_moved(moved: CombatNet.MonsterMoved) -> void:
	if moved == null:
		return
	# Round 785: where the server had it when it sent this, and when; a reach
	# refusal right behind a resync puts the body there (_snap_to_server_pos).
	_monster_server_pos[moved.monster_id] = [Vector2(moved.x, moved.z), Time.get_ticks_msec()]
	# Listed but not drawn (round 655): queued, or waiting for its region. Its
	# snapshot takes the leg's destination -- where the server will have it
	# (OURS: the body is built standing there, not mid-leg) -- and it is
	# queued if that is in a loaded region. No list is asked for: the
	# client knows this monster.
	var known = _monster_snapshots.get(moved.monster_id)
	if known != null and not _monster_bodies.has(moved.monster_id):
		known.x = moved.dest_x
		known.z = moved.dest_z
		if _monster_deferred.has(moved.monster_id) and _monster_region_loaded(Vector3(known.x, known.y, known.z)):
			_monster_deferred.erase(moved.monster_id)
			_queue_monster_build(moved.monster_id)
		return
	if not _monster_bodies.has(moved.monster_id):
		var now := Time.get_ticks_msec()
		if now - _unknown_move_pull_msec >= int(MonsterMotion.UNKNOWN_MOVE_PULL_SECONDS * 1000.0) \
				and NetClient.is_connected_to_server():
			_unknown_move_pull_msec = now
			NetClient.list_monsters()
		return
	if _dying_until.has(moved.monster_id):
		return
	_apply_monster_leg(moved)

## The legs of the monsters just listed (OpMonsterMotionList, sent right after
## the list result). A listed body starts or re-aims its leg when the
## destination differs from where it is heading by more than REAIM_EPSILON;
## a body the list leaves out finishes the leg it is on.
func _on_monster_motion_list(entries: Array) -> void:
	for e in entries:
		var entry: CombatNet.MotionEntry = e
		var body = _monster_bodies.get(entry.monster_id)
		if body == null or not is_instance_valid(body) or _dying_until.has(entry.monster_id):
			continue
		var here := Vector2((body as Node3D).position.x, (body as Node3D).position.z)
		var heading := here
		var state = _monster_motion.get(entry.monster_id)
		if state != null and bool(state["moving"]):
			heading = state["dest"]
		var dest := Vector2(entry.dest_x, entry.dest_z)
		if heading.distance_to(dest) <= MonsterMotion.REAIM_EPSILON:
			continue
		# The list result just placed the body (reconcile), so where it is drawn
		# is the position this leg starts from.
		var moved := CombatNet.MonsterMoved.new()
		moved.monster_id = entry.monster_id
		moved.x = here.x
		moved.z = here.y
		moved.dest_x = entry.dest_x
		moved.dest_z = entry.dest_z
		moved.speed = entry.speed
		moved.mode = entry.mode
		_apply_monster_leg(moved)

## Starts a known, living body on a leg: from where it is drawn
## (MonsterMotion.begin), in the leg's clip, turned toward its destination
## unless the leg is a stop.
func _apply_monster_leg(moved: CombatNet.MonsterMoved) -> void:
	var body: Node3D = _monster_bodies[moved.monster_id]
	var displayed := Vector2(body.position.x, body.position.z)
	var state := MonsterMotion.begin(displayed, moved)
	var previous = _monster_motion.get(moved.monster_id)
	state["h_xz"] = previous["h_xz"] if previous != null else displayed
	state["log_frames"] = 0
	_monster_motion[moved.monster_id] = state
	var pos: Vector2 = state["pos"]
	if pos != displayed:
		# Too far from the server's position, or a leg with no speed: placed
		# at once; the height follows in _step_monster_bodies.
		body.position.x = pos.x
		body.position.z = pos.y
		var snap = _monster_snapshots.get(moved.monster_id)
		if snap != null:
			snap.x = pos.x
			snap.z = pos.y
	if _qa_mob_track:
		print("MOB leg %d ums=%d drawn=(%.3f,%.3f) src=(%.3f,%.3f) dest=(%.3f,%.3f) speed=%.2f mult=%.3f start=(%.3f,%.3f) jump=%.3f stop=%s" % [
			moved.monster_id, _qa_unix_ms(), displayed.x, displayed.y, moved.x, moved.z, moved.dest_x, moved.dest_z,
			float(state["speed"]), float(state.get("mult", 1.0)), pos.x, pos.y, pos.distance_to(displayed),
			"1" if bool(state["stop"]) else "0"])
	_set_monster_gait(moved.monster_id, MonsterMotion.state_gait(state))
	var front := MonsterMotion.front_of(String(body.get_meta("model", "")))
	if MonsterMotion.turns_to_face(state) and front != "":
		# Turned toward the destination at the client's rate (round 637), not
		# snapped: the same mover as another player's (_aim_remote_body).
		var to_dest: Vector2 = state["dest"] - pos
		_aim_remote_body(body, Vector3(to_dest.x, 0.0, to_dest.y), MonsterMotion.front_yaw(front))
	elif bool(state["stop"]) and _remote_turns.has(body.get_instance_id()):
		# A stop: the client's stop message snaps the heading to the server's
		# angle and ends the turn (FUN_008a4f80 -> FUN_009e00f0 ->
		# FUN_009e0050, round 637's review follow-up). OpenSRO's stop carries
		# no angle; the turn's own target stands in for it (INFERRED: the
		# server's heading is its last leg's).
		var stopping: Dictionary = _remote_turns[body.get_instance_id()]
		body.rotation.y = RemoteFacing.yaw_of(float(stopping["target"]), float(stopping["front"]))
		_remote_turns.erase(body.get_instance_id())
	# Round 852 (after the turn, which aims at the end it was told of): a
	# monster's drawn leg meets the walls its server-side mover meets
	# (BodyWalk; READ c:0x9e0fca, every mover's step, flag 0). The server's
	# leg already ends at the first wall (round 812), so a leg drawn from
	# where the server had it is clear; one drawn from a body up to
	# OtherWalk.RESYNC_DISTANCE off may not be.
	if bool(state["moving"]):
		_plan_monster_leg(state, body)
	if _mob_logging():
		var kind := "stop"
		if MonsterMotion.turns_to_face(state):
			kind = "run" if int(state["mode"]) == MonsterMotion.MODE_RUN else "walk"
		var turn = _remote_turns.get(body.get_instance_id())
		print("World3D: monster %d %s from (%.1f,%.1f) to (%.1f,%.1f) at %.1f/s yaw %.2f%s%s" % [
			moved.monster_id, kind, pos.x, pos.y, moved.dest_x, moved.dest_z, float(state["speed"]),
			body.rotation.y, "" if turn == null else " turning to %.2f" % RemoteFacing.yaw_of(float(turn["target"]), float(turn["front"])),
			"" if front != "" else " (no model: the capsule)"])

## Round 852: a monster's leg (MonsterMotion's state, from where `body` is
## drawn) planned as every body's is (_plan_body_leg): its end moved to a
## wall's stop, "walled" for a frame-by-frame walk, "plan" for a later frame.
func _plan_monster_leg(state: Dictionary, body: Node3D) -> void:
	var leg_dest: Vector2 = state["dest"]
	var leg := {"run": false, "dest": Vector3(leg_dest.x, body.position.y, leg_dest.y)}
	_plan_body_leg(leg, body.position)
	state["walled"] = bool(leg["walled"])
	if leg.has("plan"):
		state["plan"] = true
	else:
		state.erase("plan")
	var d: Vector3 = leg["dest"]
	state["dest"] = Vector2(d.x, d.z)

## Plays a gait on a monster's body: its own idle for 0 (stand), its walk or
## run clip otherwise (_body_gait: a model with no walk or run clip plays
## nothing, round 853).
func _set_monster_gait(monster_id: int, gait: int) -> void:
	if OS.get_environment("OPENSRO_NO_IDLE_ANIM") != "":
		return
	var assembled: SkinnedBsrAssembler.AssembledCharacter = _monster_assembled.get(monster_id)
	if assembled == null:
		return
	_body_gait(assembled, gait)

## Round 853: a body's stand, walk or run loop, the way the client's states
## play it -- the one path for monsters and COS (_set_monster_gait, _cos_gait;
## a mount's walk or run too, _cos_mount_gait).
##
## READ (sro_client.exe): the MOVE state's enter (c:0xa59680, every
## character's) plays type 1 (walk, 200 ms in) or 7 (run, 100 ms in) by the
## gait index +0x678 through the play call (vtable +0xbc, c:0x9cfb40 ->
## CCObjCharacter slot 3 c:0xa5faf0 -> CCObjAnimation::FUN_00a5b550
## c:0xa5b550): the type in the body's group, then in `default` (the string
## at 0xec6280, "default", c:0xd77672), and when both miss it returns 0 and
## plays nothing -- and MOVE does not look at the answer (c:0xa596fc): there is
## no fallback, not to run, not to stand. The IDLE state has one of its own
## (c:0xa59398..0xa593c8: the battle stance 6 missing, it plays 0) and MOVE
## has none. Entering MOVE has already stopped what played: IDLE's exit
## (c:0xa59660 -> 0xa592f0(1)) stops the stand over 200 ms, and a moving
## body's walk-run change leaves MOVE first (FUN_009ca430(2/3) c:0x9ca430 ->
## the exit c:0xa5a6b0: the gait it played stopped over 200, IDLE entered and
## left again). A stopped loop keeps cycling while its weight falls (a lone
## clip shows fully whatever its weight, ClipMixer) and is dropped at 0; with
## nothing on the lists the mixer writes no bone (AniMixer::FUN_00c54200
## c:0xc54200 commits only when a list had a clip), so the body holds the pose
## it had then and glides in it until a clip plays again: the arrival's stand
## (MOVE's exit -> IDLE, 0 ms in, from its first frame).
##
## Who it reaches (MEASURED, tools/census_gait_clips.gd over the box's
## Data.pk2, every characterdata model): of the in-service bodies that move,
## only the trade lizard (COS_T_LIZARD, cos\t_lizard.bsr: no type 1) -- it walks
## when its rider walks. Every other model without a walk or run clip has
## walk and run speeds of 0. The rabbit's walk (type 1) is its run clip
## (p_rabbit_run.ban), so it plays that as its walk.
func _body_gait(assembled: SkinnedBsrAssembler.AssembledCharacter, gait: int) -> void:
	if assembled == null or not is_instance_valid(assembled.skeleton):
		return
	var skel := assembled.skeleton
	var clip := MonsterMotion.gait_clip(_data_pk2, assembled, gait)
	if clip == null:
		# The stand with no clip (a file whose groups name none: OURS, the idle
		# hint) keeps what it has, as before.
		if gait != BsrReader.AnimationEntry.TYPE_STAND:
			_gait_drop(skel)
		return
	var id := skel.get_instance_id()
	var drop = _gait_drops.get(id)
	_gait_drops.erase(id)
	_end_body_fidget(skel)
	MonsterMotion.swap_loop(_animated, skel, clip, _frame_count(clip), _idle_anim_time, [], _pose_fades, _loop_in_ms(gait))
	if drop != null and bool(drop["held"]):
		# Nothing was playing: the clip starts at its first frame at full
		# weight (a loop played starts over; nothing to fade from).
		_pose_fades.erase(id)
		for entry in _animated:
			if entry[0] == skel and entry[4]:
				entry[3] = -_idle_anim_time
				entry[5] = _idle_anim_time
				break

## Round 853 (_body_gait): skeleton id -> {"skel", "at": the clip clock its
## loop is dropped at (ClipMixer.STOP_MS after the gait it had no clip for),
## "held": dropped, nothing playing}.
var _gait_drops := {}

func _gait_drop(skel: Skeleton3D) -> void:
	var id := skel.get_instance_id()
	if _gait_drops.has(id):
		return
	_end_body_fidget(skel)
	_gait_drops[id] = {"skel": skel, "at": _idle_anim_time + ClipMixer.STOP_MS / 1000.0, "held": false}

## The drops whose 200 ms are over: the skeleton's loop leaves the clip list
## (a one-shot over it keeps playing and then holds its last frame, having
## nothing to hand back to), and its bones keep the pose they have.
func _step_gait_drops() -> void:
	for id in _gait_drops.keys():
		var d: Dictionary = _gait_drops[id]
		if not is_instance_valid(d["skel"]):
			_gait_drops.erase(id)
			continue
		if bool(d["held"]) or _idle_anim_time < float(d["at"]):
			continue
		d["held"] = true
		var skel: Skeleton3D = d["skel"]
		_crowd_wake(skel)
		_pose_fades.erase(id)
		var i := 0
		while i < _animated.size():
			var entry: Array = _animated[i]
			if entry[0] == skel:
				if entry[4]:
					_animated.remove_at(i)
					continue
				entry[6] = null
			i += 1
		if _qa_cos_gait or _qa_mob_track:
			print("QA GAIT drop skel %d at %.3f: no clip plays, the pose is held" % [id, _idle_anim_time])

## Ends a monster's leg where its body is drawn, in its stand clip.
func _stop_monster_motion(monster_id: int) -> void:
	var state = _monster_motion.get(monster_id)
	if state == null:
		return
	_monster_motion.erase(monster_id)
	if bool(state["moving"]):
		_set_monster_gait(monster_id, BsrReader.AnimationEntry.TYPE_STAND)

## One physics frame of every walking body: the engine's mover
## (MonsterMotion.step), the drawn x/z written into the monster's snapshot so
## the approach walk aims at the body the player sees, and the height from
## the navmesh -- the terrain ray where no loaded region covers the body
## (_moving_monster_height_at, round 557) -- only every HEIGHT_RESOLVE_STEP
## units and for at most MAX_HEIGHT_RESOLVES_PER_FRAME bodies a frame -- the
## rest keep their height until a later frame, and take their turn first then
## (MonsterMotion.height_turns, _mob_height_cursor). An arrival switches to the
## stand clip and keeps the facing.
##
## The same budget serves the bodies whose height ray found no ground
## (_monster_heights_pending): each wants a resolve every frame until one hits
## -- a body with a leg by the leg's rule above, a standing one by the
## terrain ray its placement took (_spawn_or_update_monster). Nothing tries
## from inside a region's commit: the StaticBody3D it adds may not answer a
## ray before the next physics step, and the retry every frame finds it then.
## At most `budget` resolves (_step_heights hands it the monsters' share);
## returns the resolves spent, so the ground items' retry takes what is left.
func _step_monster_bodies(delta: float, budget: int = MonsterMotion.MAX_HEIGHT_RESOLVES_PER_FRAME) -> int:
	if _monster_motion.is_empty() and _monster_heights_pending.is_empty():
		return 0
	var logging := _mob_logging()
	# OPENSRO_QA_MOB_LOG alone, not /wire: the measurement line below fires
	# the terrain ray beside the navmesh lookup, a second answer per resolve.
	var compare := logging and OS.get_environment("OPENSRO_QA_MOB_LOG") != ""
	# The bodies stepped this frame and whether each wants a height resolve,
	# in the same order; the resolves are handed out after the loop.
	var stepped: Array = []
	var wants: Array = []
	for monster_id in _monster_motion.keys():
		var body = _monster_bodies.get(monster_id)
		if body == null or not is_instance_valid(body):
			_monster_motion.erase(monster_id)
			continue
		var state: Dictionary = _monster_motion[monster_id]
		var pos: Vector2 = state["pos"]
		if bool(state["moving"]):
			if state.has("plan"):
				_plan_monster_leg(state, body)
			pos = MonsterMotion.step_state(state, delta)
			# Round 852: a leg that meets a wall walks the graph and ends there
			# (BodyWalk, _apply_monster_leg).
			if bool(state.get("walled", false)):
				pos = _body_walk_step(state, (body as Node3D).position, pos)
				if bool(state.get("blocked", false)):
					state["dest"] = pos
			state["pos"] = pos
			(body as Node3D).position.x = pos.x
			(body as Node3D).position.z = pos.y
			if _qa_mob_track:
				print("MOB body %d ums=%d pos=(%.3f,%.3f)" % [monster_id, _qa_unix_ms(), pos.x, pos.y])
			var snap = _monster_snapshots.get(monster_id)
			if snap != null:
				snap.x = pos.x
				snap.z = pos.y
			if pos == state["dest"]:
				state["moving"] = false
				_set_monster_gait(monster_id, BsrReader.AnimationEntry.TYPE_STAND)
				if logging:
					print("World3D: monster %d arrived at (%.1f,%.1f)" % [monster_id, pos.x, pos.y])
			elif logging:
				state["log_frames"] = int(state["log_frames"]) + 1
				if int(state["log_frames"]) % 30 == 0:
					print("World3D: monster %d at (%.1f,%.1f) %.1f to go" % [
						monster_id, pos.x, pos.y, pos.distance_to(state["dest"])])
		var last: Vector2 = state["h_xz"]
		stepped.append([body, state, monster_id])
		wants.append(MonsterMotion.needs_height(last, pos) or (not bool(state["moving"]) and last != pos)
			or _monster_heights_pending.has(monster_id))
	# Standing bodies still waiting for ground, after the walking ones.
	for monster_id in _monster_heights_pending.keys():
		if _monster_motion.has(monster_id):
			continue
		var body = _monster_bodies.get(monster_id)
		if body == null or not is_instance_valid(body):
			_monster_heights_pending.erase(monster_id)
			continue
		stepped.append([body, null, monster_id])
		wants.append(true)
	var turns := MonsterMotion.height_turns(wants, _mob_height_cursor, budget)
	_mob_height_cursor = int(turns["cursor"])
	var resolved := 0
	var spent := 0
	var retried := 0
	var retry_spent := 0
	for i in turns["picked"]:
		var body: Node3D = stepped[i][0]
		var state = stepped[i][1]
		var monster_id: int = stepped[i][2]
		var retry := _monster_heights_pending.has(monster_id)
		var started := Time.get_ticks_usec()
		var height := _moving_monster_hit_height(body.position) if state != null else _terrain_hit_height(body.position)
		if retry:
			retry_spent += Time.get_ticks_usec() - started
			retried += 1
		else:
			spent += Time.get_ticks_usec() - started
		if compare:
			var nav := _navmesh_height_at(body.position)
			print("World3D: monster %d height at (%.1f,%.1f): navmesh %s, terrain ray %.2f" % [
				monster_id, body.position.x, body.position.z,
				"none" if is_nan(nav) else "%.2f" % nav, _terrain_height_at(body.position)])
		# A miss leaves the height as it is -- what the walking resolve did
		# before, when the ray's miss returned the body's own y.
		if not is_nan(height):
			body.position.y = height
			_monster_height_found(monster_id, height)
		if state != null:
			state["h_xz"] = state["pos"]
		if not retry:
			resolved += 1
	_mob_height_resolves += resolved
	_mob_height_max = maxi(_mob_height_max, resolved)
	_mob_height_usec += spent
	_mob_height_usec_max = maxi(_mob_height_usec_max, spent)
	_mob_height_retries += retried
	_mob_height_retries_max = maxi(_mob_height_retries_max, retried)
	_mob_height_retry_usec += retry_spent
	_mob_height_window += delta
	if _mob_height_window >= 10.0:
		if logging:
			print("World3D: monster height resolves %d/s, max %d in a frame; %.2f ms in them over %.1f s, max %.3f ms in a frame; waiting-for-ground retries %d/s, max %d in a frame, %.2f ms in them" % [
				int(round(float(_mob_height_resolves) / _mob_height_window)), _mob_height_max,
				float(_mob_height_usec) / 1000.0, _mob_height_window, float(_mob_height_usec_max) / 1000.0,
				int(round(float(_mob_height_retries) / _mob_height_window)), _mob_height_retries_max,
				float(_mob_height_retry_usec) / 1000.0])
		_mob_height_resolves = 0
		_mob_height_max = 0
		_mob_height_usec = 0
		_mob_height_usec_max = 0
		_mob_height_retries = 0
		_mob_height_retries_max = 0
		_mob_height_retry_usec = 0
		_mob_height_window = 0.0
	return resolved + retried

## One physics frame's height work (round 572): the monsters' walking legs
## and waiting bodies (_step_monster_bodies) and the ground items waiting for
## ground (GroundItems.resolve_pending) share MAX_HEIGHT_RESOLVES_PER_FRAME --
## the monsters up to MonsterMotion.monster_height_share of it, the items
## whatever the monsters leave, which is at least half the budget whenever
## they want that much. Until round 572 the items took only what the
## monsters left.
func _step_heights(delta: float) -> void:
	var budget := MonsterMotion.MAX_HEIGHT_RESOLVES_PER_FRAME
	var item_wants := _ground_items.pending_count() if _ground_items != null else 0
	var spent := _step_monster_bodies(delta, MonsterMotion.monster_height_share(budget, item_wants))
	if _ground_items != null:
		_ground_items.resolve_pending(budget - spent)

func _on_attack_result(result: CombatNet.AttackResult) -> void:
	if result == null:
		return
	if LatencyProbe.on:
		LatencyProbe.attack_result(result.monster_id, Time.get_ticks_msec(), result.error)
	# Round 802: the answer to a blow at a player or a COS (job PvP).
	if _is_pvp_reply(result):
		_on_pvp_result(result)
		return
	# A self or ground cast's reply (round 617) is not a blow on the target:
	# no swing, no flinch, no counter, and the monster cast still in flight
	# keeps its hit effect. The health bar is painted by the other handler.
	if SelfCast.is_self_reply(result.target_type, result.target_type_echoed, result.monster_damage,
			result.monster_died, result.player_died, result.error):
		if result.error != "":
			print("CAST reply: self/ground cast (targetType %d, %s) refused: %s" % [result.target_type,
				"echoed" if result.target_type_echoed else "from the request queue", result.error])
			_fx_self_cast_refused()
			if result.target_type == SkillNet.TARGET_CHARACTER:
				_log_system(result.error)
		elif result.wall != null and result.wall.toggled_off:
			# Round 640: the recast switched a running toggle off; its
			# OpBuffEnd ends the icon and the aura. The server's answer
			# decides (review): a cast this client drew because it did not
			# know the toggle was running is ended here.
			print("CAST reply: the toggle was switched off (no cast, no cost), HP %d" % result.player_hp)
			_fx_self_cast_refused()
		else:
			print("CAST reply: self/ground cast (targetType %d, %s) accepted, HP %d" % [result.target_type,
				"echoed" if result.target_type_echoed else "from the request queue", result.player_hp])
			_fx_self_cast_accepted()
			NetClient.list_skills(NetClient.current_character_name)
		return
	if result.error != "":
		_combat_line = "Attack failed: %s" % result.error
		print("World3D: attack refused: %s" % result.error)
		if _combat_trace and result.monster_id != 0:
			var rs = _monster_snapshots.get(result.monster_id)
			var rb = _monster_bodies.get(result.monster_id)
			print("COMBAT refusal ms=%d monster %d: player (%.1f,%.1f) snapshot %s body %s%s" % [
				Time.get_ticks_msec(), result.monster_id, player.position.x, player.position.z,
				"(%.1f,%.1f)" % [rs.x, rs.z] if rs != null else "none",
				"(%.1f,%.1f)" % [(rb as Node3D).position.x, (rb as Node3D).position.z] if rb != null and is_instance_valid(rb) else "none",
				" walking" if _monster_is_moving(result.monster_id) else ""])
		# The server's target test (round 622): a friendly skill at a monster.
		if result.error == SelfCast.INVALID_TARGET_TEXT or result.error == SelfCast.NO_TARGET_TEXT:
			_log_system(result.error)
		_pending_skill_id = 0
		_pending_skill_hit_code = ""
		# A refusal of a request the approach walk released is that walk's
		# (_rewalk_after_refusal); any other is the keep-up's own (round 785).
		var answers_release := not _released_attack.is_empty()
		if result.error == CombatNet.REFUSED_TOO_FAR and result.monster_id != 0:
			_snap_to_server_pos(result.monster_id)
		if not _rewalk_after_refusal(result) and not answers_release:
			_rewalk_after_keepup_refusal(result)
		return
	# Round 785: this player's cast at a monster is drawn by its decoration,
	# with no plain swing. Round 785's client review, finding 7: a result
	# that names the skill it answers (SkillHits.skill_id, the server lane's
	# u32) is routed by it -- 0 is a plain swing (a keep-up's, in flight while
	# a cast was sent) and leaves the cast pending; a skill id is the cast's
	# (or its chain link's) answer. A result that does not say (an older
	# server) keeps the old rule: any answer while a cast is pending is its.
	var told := result.hits != null and result.hits.has_skill_id()
	if _combat_trace:
		print("COMBAT result ms=%d names %s, cast pending %d" % [Time.get_ticks_msec(),
			("skill %d" % result.hits.skill_id if result.hits.skill_id != 0 else "a plain swing") if told else "nothing (an older server)",
			_pending_skill_id])
	if told and result.hits.skill_id != 0:
		var answered := result.hits.skill_id
		var answered_code := _pending_skill_hit_code if answered == _pending_skill_id else ""
		if answered_code == "" and not _fx_self_cast.is_empty() and int(_fx_self_cast["skill"]) == answered:
			answered_code = String(_fx_self_cast.get("code", ""))
			_fx_self_cast = {}
		if answered == _pending_skill_id:
			_pending_skill_id = 0
			_pending_skill_hit_code = ""
		_own_skill_result(result, answered, answered_code)
		return
	if not told and _pending_skill_id != 0:
		var cast_id := _pending_skill_id
		var cast_code := _pending_skill_hit_code
		_pending_skill_id = 0
		_pending_skill_hit_code = ""
		_own_skill_result(result, cast_id, cast_code)
		return
	# A self cast that dealt damage (a Target_Required 0 attack row, the spear
	# spin): its answer is a blow, drawn by the cast's decoration as well. (A
	# result that names a plain swing is not.)
	if not told and not _fx_self_cast.is_empty() and not bool(_fx_self_cast.get("begun", false)) \
			and result.target_type_echoed and result.target_type != SkillNet.TARGET_ENTITY:
		var self_id := int(_fx_self_cast["skill"])
		var self_code := String(_fx_self_cast.get("code", ""))
		_fx_self_cast = {}
		_own_skill_result(result, self_id, self_code)
		return
	_released_attack = {}
	# One line per exchange, so a render's log says what the fight did
	# without reading it off a label. t is the animation clock the death
	# hold and the "body removed" line read, so a kill can be timed against
	# its body's removal.
	print("World3D: attack hit for %d%s (%d left%s), took %d%s (HP %d)%s t=%.2f" % [
		result.monster_damage, " CRIT" if result.player_critical else "",
		result.monster_remaining_hp, ", died" if result.monster_died else "",
		result.player_damage_taken,
		" BLOCKED" if result.player_blocked else (" CRIT" if result.monster_critical else ""),
		result.player_hp,
		", lost %d exp" % result.death_exp_lost if result.death_exp_lost > 0 else "",
		_idle_anim_time])
	# A combat exchange keeps the player in the battle stance while idle.
	_last_combat_time = _player_anim_time
	# The player's swing, once. Its hit event says when the blow lands, and
	# that is when the monster's own hit reaction plays. Round 785: for a
	# plain swing the clip is one of the base attack's skillaniset2 SHOT list
	# at random, as retail picks it (_plain_swing_type).
	var swing_type := _plain_swing_type()
	if swing_type < 0:
		swing_type = ATTACK_SEQUENCE[_attack_step % ATTACK_SEQUENCE.size()]
		_attack_step += 1
	var swing_entry := _body_animation_entry(_player_body, swing_type, _player_weapon_group)
	if swing_entry == null:
		swing_entry = _body_animation_entry(_player_body, BsrReader.AnimationEntry.TYPE_ATTACK, _player_weapon_group)
	var lands_after := 0.0
	var swing_seconds := 0.0
	if swing_entry != null:
		var swing := _body_animation_for(_player_body, swing_entry.action_type, _player_weapon_group)
		if swing != null:
			swing_seconds = _play_player_once(swing)
			_player_swing_until = Time.get_ticks_msec() + int(swing_seconds * 1000.0)
		var hit_ms := swing_entry.first_event_time(BsrReader.AnimationEntry.EVENT_HIT)
		lands_after = float(hit_ms) / 1000.0 if hit_ms > 0 else 0.0
	# Round 786: each hit of the swing draws its own number at its own hit
	# event (FUN_00a49290 per entry, READ); the later hits' offsets from the
	# first.
	var swing_hit_offsets := _hit_event_offsets(swing_entry)
	if _combat_trace:
		print("COMBAT swing ms=%d type %d (%s) %.3f s, lands at %.3f s" % [Time.get_ticks_msec(), swing_type,
			_body_animation_path(_player_body, swing_entry.action_type, _player_weapon_group) if swing_entry != null else "none",
			swing_seconds, lands_after])
	# The monster this result is about. The server names it (AttackResult.
	# MonsterID; NetClient fills it from the target the attack was sent at
	# when a server predates the field). It is NOT _last_attack_target: the
	# result lands a swing later than it was sent, and a retarget in between
	# used to make the new target flinch, take the number and swing back
	# while the old one fell -- "one Mangyang killed another". Every
	# animation, number and effect below is pinned to this id.
	var monster: int = result.monster_id if result.monster_id != 0 else _last_attack_target
	if monster != _last_attack_target:
		print("World3D: attack result for monster %d while targeting %d -- animating %d" % [
			monster, _last_attack_target, monster])
	elif OS.get_environment("OPENSRO_QA_ATTACK") != "":
		print("World3D: attack result for monster %d -> animating %d" % [monster, monster])
	if _qa_retreat_pending and monster != -1 and result.monster_damage > 0 and not result.monster_died:
		_qa_retreat(monster)
	# Round 785: the player turns to face what it strikes while the swing
	# plays (CombatFacing: retail's skill deco turns its caster every frame).
	# A blow resets the walk-back count of the keep-up's refusals.
	if monster != -1:
		_face_while_striking(player, 0.0, _monster_position_of.bind(monster), swing_seconds, monster)
		_keepup_rewalks = 0
	# A skill cast (not a plain attack) plays that skill's own hit effect on the
	# target when the blow lands. Consumed here so the next plain attack doesn't
	# inherit it.
	# A result naming a plain swing (finding 7) leaves a cast still pending
	# to its own answer.
	var skill_hit_code := "" if told else _pending_skill_hit_code
	var cast_skill := 0 if told else _pending_skill_id
	if not told:
		_pending_skill_hit_code = ""
		_pending_skill_id = 0
	# The skill this blow carries, for its sounds: the cast's, or the weapon's
	# base attack for a plain swing (CombatAudio.base_attack_skill), recorded
	# as the player's current skill for the animation-fired sounds.
	var blow_skill := cast_skill if cast_skill != 0 else \
		CombatAudio.base_attack_skill(maxi(_player_weapon_type_id4(), 0))
	if cast_skill == 0:
		SkillAudio.set_current(player, blow_skill)
	var blow_audio := {"skill": blow_skill, "cast": cast_skill != 0,
		"critical": result.player_critical, "hwan": result.berserk_active}
	if monster != -1:
		var dealt := result.monster_damage
		var died := result.monster_died
		# The result's health is recorded now, in wire order with the zone's
		# pushes, and painted as the blow lands (round 655 and its review):
		# a newer OpMonsterDamaged arriving before the landing is not undone
		# by this older number. Only a result that reports a blow carries
		# health: a zero-damage cast (a stun, a debuff) resolves none, and a
		# server before round 655's review sent 0 there.
		var blow := dealt > 0 or died
		if blow:
			_record_monster_hp(monster, result.monster_remaining_hp)
		_own_hit_until[monster] = Time.get_ticks_msec() + int(lands_after * 1000.0) + 750
		if died:
			# The killer is the one player the server never sends
			# OpMonsterDied (session/combat.go performAttack skips the
			# attacker), and the list requested at the end of this handler no
			# longer names the monster -- which used to free its body at once,
			# before any death was seen. Hold it now, before that request,
			# for the rest of the swing and the die clip's own length; the
			# clip itself starts when the blow lands, below. The races this
			# leaves are disclosed at MonsterBodies.hold_for_kill.
			MonsterBodies.hold_for_kill(_dying_until, monster, _idle_anim_time, lands_after,
				_monster_action_seconds(monster, BsrReader.AnimationEntry.TYPE_DIE))
			# Killed mid-walk: it stops here, in its stand clip, rather than
			# walking on until the blow lands and the die clip starts.
			_stop_monster_motion(monster)
			print("World3D: monster %d killed by own blow t=%.2f, clip starts in %.2fs" % [
				monster, _idle_anim_time, lands_after])
		_after(lands_after, func() -> void:
			# The moment that used to go wrong: the blow lands a swing after it
			# was sent, and the live target may already be another monster.
			if OS.get_environment("OPENSRO_QA_ATTACK") != "" and monster != _last_attack_target:
				print("World3D: blow lands on monster %d (now targeting %d) -- animating %d" % [
					monster, _last_attack_target, monster])
			# A monster this blow killed plays its die animation as the blow
			# lands (held by the kill hold above); a surviving one flinches.
			# The monster's health, as the snapshot has it by now (the result's,
			# or a newer push's), drawn as the blow lands (round 655): until
			# then the full list this handler asked for after every result
			# brought it. OURS: shown with the blow rather than when the reply
			# arrives.
			if blow:
				_paint_monster_hp(monster)
			if died:
				_begin_monster_death(monster)
			elif dealt > 0 and not _swing_runs(int(_monster_swing_until.get(monster, 0))):
				# Round 785: the hit reaction only for a blow that dealt
				# something (READ: FUN_00a49290 enters state 0xb only when the
				# record's damage is non-zero and its kind is not 2 or 7), and
				# not over the monster's own swing (_swing_runs).
				var hit_assembled = _monster_assembled.get(monster)
				if hit_assembled != null:
					_audio_mark_hit(hit_assembled.skeleton, result.player_critical)
				_play_monster_action(monster, BsrReader.AnimationEntry.TYPE_HIT)
			# Round 785: the hit sound follows the landing by the damage
			# decoration's 100 ms (READ: CIDecoDamageEffect::vslot_014 adds
			# the frame milliseconds to +0x3c and fires FUN_00a49780's
			# snd_dmg / snd_cridmg once the sum passes the immediate 100).
			_after(HIT_SOUND_DELAY, _audio_blow_lands.bind(blow_audio, dealt, monster))
			var hit_body = _monster_bodies.get(monster)
			if hit_body != null and is_instance_valid(hit_body):
				# Round 786: one number per entry of the swing's hit block, at
				# its hit event -- the digits, the critical or the block word
				# (DamageText, READ: no "miss" and no zero). From a server
				# that sends no block, the result's sum as one number.
				_swing_numbers(hit_body, monster, result, swing_hit_offsets)
				# Round 859: a plain swing is its weapon's base attack skill
				# (SKILL_CH_SWORD_BASE...), whose skillaniset2 row names a
				# DamageEfp (hit_3_normal, hit_3_bow; MEASURED) and blood, as
				# a cast's does (READ, FUN_00a4bdd0 for any decoration); until
				# this round it drew none. OURS: once a blow, not per entry.
				var hit_code := skill_hit_code if skill_hit_code != "" else \
					String(SkillAudio.context_for(blow_skill).get("code", ""))
				if hit_code != "" and hit_code != SkillAudio.NONE:
					_play_skill_hit_effect_on(hit_body, _monster_text_height(monster), hit_code))
	# The monster strikes back as the player's blow lands -- from the zone's
	# OpMonsterAttacked when a server sends one, else from this result
	# (_draw_counter_at_landing, round 540). Only the monster that took the
	# blow counterattacks, so it is pinned to `monster` too.
	_draw_counter_at_landing(monster, result, lands_after)
	if OS.get_environment("OPENSRO_QA_MOB_STRIKE") != "":
		_qa_mob_strike(monster, result)
	if result.monster_died:
		_combat_line = "Hit for %d%s -- it died!" % [
			result.monster_damage, " CRITICAL!" if result.player_critical else ""]
		# A kill's quest progress arrives as 0x30D5 (round 785): nothing to
		# ask.
	else:
		_combat_line = _exchange_line(result)
		# Dying was silent until now: the server has reported it since the
		# first combat release and nothing read the flag. Above level 10 it
		# also costs experience -- the real penalty, see
		# leveldata.DeathPenaltyExp.
		if result.player_died:
			_combat_line = _death_line(result.death_exp_lost)
			# Left dead, at HP 0 (round 548) -- or, from today's server, put
			# back on its feet in the same call (MonsterStrikes.leaves_dead).
			if MonsterStrikes.leaves_dead(result.player_died, result.player_hp):
				_enter_dead_state(result.death_exp_lost)
	# No monster list here any more (round 655): the result carries the
	# monster's health and death, applied as the blow lands, and a full list
	# of a 500-monster view after every swing was the cost.
	# OpUseSkill's response reuses this same OpAttackResult (see
	# SkillNet's doc comment) -- refresh here too so a just-used skill's
	# updated cooldown shows up in the Skills tab. Harmless no-op extra
	# traffic for a plain (non-skill) attack, same tradeoff the quest
	# refresh above already makes.
	NetClient.list_skills(NetClient.current_character_name)

# --- A monster's blow (round 540) -------------------------------------------
#
# OpenSRO's own OpMonsterAttacked (0x007D), docs/protocol/monster_ai.md
# "OpenSRO's own monster protocol (placeholders)": one monster's blow on a
# player, sent to everyone in the zone, the attacker included, right behind the
# attacker's own OpAttackResult. No server sends it yet. Without it a counter is
# drawn from the attacker's result, on the attacker's screen only; with it,
# every player in the zone sees the blow. MonsterStrikes decides which of the
# two draws a counter on the attacker's own screen.

## The death line a blow that killed this player shows on the combat status
## label. Above level 10 a death also costs experience, the real penalty
## (leveldata.DeathPenaltyExp).
func _death_line(exp_lost: int) -> String:
	return "You were killed.%s" % (" Lost %d experience." % exp_lost if exp_lost > 0 else "")

## The combat status label's line for an exchange the monster survived. The
## recovered combat mechanics are only worth recovering if a player can see
## them happen: a critical doubles the blow, a block stops it dead. Both were
## computed and sent for several releases before anything read them. A swing
## inside the monster's ReuseDelay draws no counter (combat.Hub.
## CounterattackReady), and the line says nothing about one: "Took 0" read as
## a blow that did nothing.
func _exchange_line(result: CombatNet.AttackResult) -> String:
	var taken := ""
	if result.wall != null and result.wall.absorbed:
		taken = " Your wall took %d%s (HP %d)." % [result.wall.damage,
			" -- critical!" if result.wall.critical else "", result.player_hp]
	elif result.player_blocked:
		taken = " Blocked it (HP %d)." % result.player_hp
	elif result.player_damage_taken > 0:
		taken = " Took %d%s (HP %d)." % [result.player_damage_taken,
			" -- critical!" if result.monster_critical else " damage", result.player_hp]
	return "Hit for %d%s (%d HP left).%s" % [
		result.monster_damage, " CRITICAL!" if result.player_critical else "",
		result.monster_remaining_hp, taken]

## When the monster's attack clip lands its blow, in seconds after the clip
## starts: the first hit event (BsrReader.AnimationEntry.EVENT_HIT) of its
## TYPE_ATTACK entry -- mangnyang's attack01 at 651. The millisecond unit is
## inferred from the key times, not read from the client's use of them
## (docs/protocol/BSR_FORMAT.md, "Events and walk points"). 0 when the monster
## has no assembled body or no such event.
func _monster_strike_seconds(monster_id: int, action_type: int = BsrReader.AnimationEntry.TYPE_ATTACK) -> float:
	var assembled: SkinnedBsrAssembler.AssembledCharacter = _monster_assembled.get(monster_id)
	if assembled == null or assembled.parsed == null:
		return 0.0
	var strike := assembled.parsed.animation_entry_for(action_type)
	if strike == null:
		return 0.0
	var ms := strike.first_event_time(BsrReader.AnimationEntry.EVENT_HIT)
	return float(ms) / 1000.0 if ms > 0 else 0.0

## The counterattack `result` reports, drawn `lands_after` seconds from now,
## when the player's own blow lands: from the zone's OpMonsterAttacked if it
## has come by then (_settle_counter), else from the result. A result that
## reports none draws none.
func _draw_counter_at_landing(monster: int, result: CombatNet.AttackResult, lands_after: float) -> void:
	if monster == -1 or not MonsterStrikes.result_countered(result):
		# No monster to pin a push to (a server that names none and a queue
		# that had nothing in flight): the result draws it, as before.
		if result.player_damage_taken > 0:
			_after(lands_after, _draw_counter_from_result.bind(monster, result))
		return
	var wait := MonsterStrikes.expect(_strike_waits, monster, result)
	_after(lands_after, _settle_counter.bind(monster, result, wait))

## The blow has landed: the counter is drawn from the push that claimed `wait`
## (on this screen too the monster swings as the player's blow lands, not when
## the push arrived), or, when none came, from the result.
func _settle_counter(monster: int, result: CombatNet.AttackResult, wait: Dictionary) -> void:
	var pushed := MonsterStrikes.settle(_strike_waits, monster, wait)
	if pushed != null:
		_draw_monster_strike(pushed, true)
		return
	print("World3D: monster %d counter from the result (no push)" % monster)
	_draw_counter_from_result(monster, result)

## The counter as the attacker's result reports it, for a server that sends no
## OpMonsterAttacked: the monster's attack clip now, and the player's hit
## reaction (type 3) and the number when that clip's hit event falls. Only a
## blow that dealt damage is drawn, and only on an assembled body -- as before
## round 540.
func _draw_counter_from_result(monster: int, result: CombatNet.AttackResult) -> void:
	if result.player_blocked:
		# Nothing is drawn for a blocked counter; its sound is (round 614),
		# when the monster's blow would land.
		var block_after := _monster_strike_seconds(monster) if monster != -1 else 0.0
		_after(block_after, func() -> void:
			# Round 786: the block word over the player, red (DamageText,
			# READ: kind 2 draws "blocking" alone).
			_damage_text(player, DamageText.Art.BLOCK, 0, true, false)
			_audio_block(player, result.monster_critical, "monster %d's counter, from the result" % monster)
			_audio_monster_blow(monster, result.monster_critical, "blocked counter on the player, from the result"))
	if result.wall != null and result.wall.absorbed:
		# Round 640: the player's wall took the counter whole.
		var wall_after := 0.0
		if monster != -1:
			wall_after = _monster_strike_seconds(monster)
			_play_monster_action(monster, BsrReader.AnimationEntry.TYPE_ATTACK)
		var own_key := _fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER)
		_after(wall_after, _draw_wall_blow.bind(player, own_key, result.wall, monster, "the player (from the result)"))
		return
	if result.player_damage_taken <= 0 or _player_skeleton == null:
		return
	var strike_after := 0.0
	if monster != -1:
		strike_after = _monster_strike_seconds(monster)
		if OS.get_environment("OPENSRO_QA_ATTACK") != "" and monster != _last_attack_target:
			print("World3D: counter-swing by monster %d (now targeting %d) -- animating %d" % [
				monster, _last_attack_target, monster])
		_play_monster_action(monster, BsrReader.AnimationEntry.TYPE_ATTACK)
	_after(strike_after, func() -> void:
		# The hit reaction -- or the held die clip when this blow left the
		# player dead (round 548).
		_audio_mark_hit(_player_skeleton, result.monster_critical)
		_play_player_struck()
		_audio_monster_blow(monster, result.monster_critical, "counter on the player, from the result")
		# Round 640: a buff naming a DefenseEfp (a wall's) shows it.
		var own_efp := _defense_efp_on(_fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER))
		if own_efp != "":
			_play_hit_efp_on(player, 2.0 * PLAYER_SCALE_RATIO, own_efp)
		# The damage the player took, timed to when the counter-blow lands:
		# red, the critical's art for a critical (round 786, DamageText).
		_damage_text(player, _number_art(result.monster_critical), result.player_damage_taken, true, false))

## One monster's blow (OpMonsterAttacked), for everyone in the zone. A blow on
## this player repeats a counter its own result reported (MonsterStrikes.claim):
## it is drawn when this player's blow lands (_settle_counter), or was already
## drawn from the result. Any other blow -- on another player, or on a target
## this client has not drawn -- is drawn at once.
func _on_monster_attacked(attacked: CombatNet.MonsterAttacked) -> void:
	if attacked == null:
		return
	# A state's damage tick (round 659's review, STRIKE_STATUS_TICK): the
	# server sends one when a tick kills. No swing is drawn and no counter
	# claimed; the target takes it as a blow's report -- the HUD, the death
	# line and the dead state for this player, the hit clip for another.
	if attacked.status_tick:
		_on_status_tick_strike(attacked)
		return
	# Round 804: a blow on a COS -- a wave's NPC thief on a transport
	# (session/mobcos.go) -- names its uid.
	if JobPvpNet.is_cos_uid(attacked.target_character_id):
		_draw_monster_strike_on_cos(attacked)
		return
	var claim := MonsterStrikes.CLAIM_NONE
	if not _other_bodies.has(attacked.target_character_id):
		claim = MonsterStrikes.claim(_strike_waits, attacked)
	# A blow with no counter result to pair with -- the monster's own swing,
	# from a server with -monster-battle (round 546) -- is this player's when
	# its target is drawn nowhere here (MonsterStrikes.is_own_unpaired).
	var own_unpaired := claim == MonsterStrikes.CLAIM_NONE and MonsterStrikes.is_own_unpaired(
		attacked.target_character_id, _other_bodies, _recently_left, Time.get_ticks_msec(), NetClient.own_character_id)
	var how := "on another player"
	match claim:
		MonsterStrikes.CLAIM_HELD:
			how = "own counter, drawn as the blow lands"
		MonsterStrikes.CLAIM_DRAWN:
			how = "own counter, already drawn from the result"
		_:
			if own_unpaired:
				how = "own blow, no result to pair with (the monster's own swing): its swing now, the blow at the clip's hit event"
			elif not _other_bodies.has(attacked.target_character_id):
				how = "target not drawn here"
	# One line per push: a live run counts them against the counter results.
	print("World3D: monster %d strikes %d for %d (HP %d)%s%s -- %s" % [
		attacked.monster_id, attacked.target_character_id, attacked.damage, attacked.target_hp,
		" BLOCKED" if attacked.blocked else (" CRIT" if attacked.critical else ""),
		", died" if attacked.target_died else "", how])
	# Only a push that claimed a counter still waiting for its blow repaints
	# the vitals; a late one (CLAIM_DRAWN) is swallowed whole (round 544).
	if claim == MonsterStrikes.CLAIM_HELD:
		_show_own_strike(attacked)
	if claim != MonsterStrikes.CLAIM_NONE:
		return
	if own_unpaired:
		# The push is the only report of this blow: the HUD's HP and the
		# death line come from it, and it is drawn now, on this player --
		# the HP and the death as the blow LANDS (round 785: retail lowers
		# the HP, starts the hit reaction or the death and draws the number
		# together, at the swing clip's hit event -- IDecoSkill::FUN_00a4f720
		# -> FUN_00a49290, READ), not when the push arrives.
		_draw_monster_strike(attacked, true, true)
		return
	_draw_monster_strike(attacked, false)

## A state's damage tick reported as OpMonsterAttacked (round 659's review):
## on this player, _show_own_strike (bar, death line, dead state) and the hit
## -- or held die -- clip; on another drawn player, their hit clip.
func _on_status_tick_strike(attacked: CombatNet.MonsterAttacked) -> void:
	var own := attacked.target_character_id == _own_id()
	print("World3D: a state's tick on %d for %d (HP %d)%s -- %s" % [
		attacked.target_character_id, attacked.damage, attacked.target_hp,
		", died" if attacked.target_died else "", "this player" if own else "another player"])
	# Round 786: a state's tick has no attacker -- retail's FUN_008a4b00
	# case 1 -> FUN_00a56230 draws it in the attacker-less gold (DamageText).
	var tick_body = player if own else _other_bodies.get(attacked.target_character_id)
	if tick_body != null and is_instance_valid(tick_body):
		_damage_text(tick_body, DamageText.Art.NUMBER, attacked.damage, true, false, false)
	if own:
		_show_own_strike(attacked)
		_play_player_struck()
	elif _other_bodies.has(attacked.target_character_id):
		_play_other_hit(attacked.target_character_id)

## A blow on this player, from a push that claimed a counter still waiting for
## its blow to land (CLAIM_HELD): the HUD's HP from the push's target HP, and
## the death line when it killed. The result that reported the same counter
## set both a moment earlier (the push repeats its numbers,
## MonsterStrikes.repeats), so this changes nothing against a server that
## sends both. Never from a late push (CLAIM_DRAWN): its counter was drawn
## from the result, and a newer result -- a kill's level-up heal, the next
## counter -- may have moved the HP since, so repainting from it put a stale
## number on the bar until the next result (round 544).
func _show_own_strike(attacked: CombatNet.MonsterAttacked, write_hp: bool = true) -> void:
	if write_hp and _last_enter_world_max_hp > 0:
		_own_hp_told()
		if _hud_player_info != null:
			_hud_player_info.set_hp(attacked.target_hp, _last_enter_world_max_hp)
		if _hud_panels != null:
			_hud_panels.set_character_vitals(attacked.target_hp, _last_enter_world_max_hp, 1)
	if attacked.target_died:
		_combat_line = _death_line(attacked.death_exp_lost)
		# Left dead, at HP 0 (round 548): the monster's own swing under
		# -monster-battle reports a kill here alone, with no result before it.
		if MonsterStrikes.leaves_dead(attacked.target_died, attacked.target_hp):
			_enter_dead_state(attacked.death_exp_lost)

## How many times the server has told this player's HP (round 785's client
## review, finding 12): a blow drawn later than its push (_draw_monster_strike,
## up to its clip's hit event) writes its HP only if no newer report -- a
## potion, a stats update, a result, a revive -- came since its push.
var _own_hp_seq := 0

func _own_hp_told() -> void:
	_own_hp_seq += 1

## A blow whose push came when _own_hp_seq was `seq` lands: its HP only when
## nothing newer has told it; its death line and dead state whatever came.
func _show_own_strike_landed(attacked: CombatNet.MonsterAttacked, seq: int) -> void:
	var current := seq == _own_hp_seq
	if not current:
		print("World3D: the blow of monster %d lands -- its HP %d is older than the HP shown, kept" % [
			attacked.monster_id, attacked.target_hp])
	_show_own_strike(attacked, current)

# --- The player's dead state (round 548) --------------------------------------
#
# A server with -player-dead-state on (the server half; off by default) leaves
# a player a monster kills at HP 0 in life state 2 -- docs/protocol/
# character_state.md, rounds 411-413: 1 is ALIVE (the "must be alive" guards
# answer GUILDERR_IM_DEAD and 0x6807 on GetLifeState() != 1), 2 is a PC the
# engine revives into 1 (GObjPC::Revive 0x4df290) -- refuses its moves, blows,
# casts and items, and revives it where it lies on OpRevive, at
# character.RespawnFraction (0.4) of each maximum. That fraction is the retail
# resurrect handler's own: GObjPC_HandleResurrectMsg_053 (0x50fee0) acts only
# in life state 2 (`cmp al,0x2` at 0x510077), calls GObjPC::Revive(1) (`push
# 0x1; call 0x4df290` at 0x5100e3) and lands GetParam(3) x 0.4 and GetParam(4)
# x 0.4 through ApplyHPMPDelta (`fmul QWORD PTR ds:0xb460f0` at 0x5100fa and
# 0x510130; 0xb460f0 = 00 00 00 a0 99 99 d9 3f, the double 0.4). Its u8 option
# -- 1 return to the return point, 2 revive in place while the max level is at
# most 10 -- is carried since round 665: the dead window offers retail's two
# buttons (HudPanels.show_revive_prompt) and option 1 comes back as a zone
# change to the return point followed by the OpReviveResult. With the flag
# off a kill arrives with the respawned HP above 0
# (MonsterStrikes.leaves_dead) and is followed by the zone change to the
# return point; no OpReviveResult comes.

## The player's own reaction to a blow that has just landed on it: the hit
## clip (type 3) once, over stand or run -- or, when the blow left the player
## dead (_player_dead), the die clip (type 4 of the weapon group's table,
## `_a_diehardhit` by the body's own hints) held on its last frame until the
## revive. That the retail client plays a death clip and leaves the body down
## was not read here; the clip type is the body table's own.
func _play_player_struck() -> void:
	# Round 808: a blow on a player arms the 5 s battle stance (READ,
	# FUN_00a49290 0xa4966b; COMBAT_STANCE_SECONDS).
	_last_combat_time = _player_anim_time
	if _player_skeleton == null:
		return
	if _player_dead:
		_play_player_death_pose()
		return
	# Round 785: a hit does not cut the player's own swing (_swing_runs).
	if _swing_runs(_player_swing_until):
		return
	var hit := _body_animation_for(_player_body, BsrReader.AnimationEntry.TYPE_HIT, _player_weapon_group)
	if hit != null:
		_play_player_once(hit)

## Round 785: the msec the player's swing clip ends (_on_attack_result), and
## each monster's (monster id -> msec, _draw_monster_strike).
var _player_swing_until := 0
var _monster_swing_until: Dictionary = {}

## Whether a swing clip ending at `until` (msec) still plays. A hit reaction
## does not replace it (OURS on an INFERENCE: retail shows a blow's number and
## reaction at its SHOT clip's own hit events -- FUN_00a59970 counts an event
## only while the deco's clip is the one playing -- so a swing cut by the
## attacker's own hit reaction would never show its blow, and in retail every
## blow of an exchange shows; the hit state 0xb itself enters from any state,
## its masks at 0xec6190 are 0, READ). Before round 785 the reaction replaced
## the swing: a monster struck as it swung lost its swing and shout sounds
## (MEASURED: 5 swing sounds for 14 Mangyang and Yeoha swings on the box).
func _swing_runs(until: int) -> bool:
	return Time.get_ticks_msec() < until

## Plays the die clip once and holds its last frame (_player_one_shot_hold).
## A body with no such clip keeps whatever it plays.
func _play_player_death_pose() -> void:
	_hold_player_one_shot(_body_animation_for(_player_body, BsrReader.AnimationEntry.TYPE_DIE, _player_weapon_group))

## Plays `die` once and holds it -- only if it STARTED (round 550): a clip of
## one frame, or none, starts nothing (_play_player_once), and setting the
## hold regardless pinned whatever one-shot was current, a swing among them.
## A pose already held stays held (the repeated kill report's second call).
func _hold_player_one_shot(die: BanReader.ParsedAnimation) -> void:
	if die == null:
		return
	_play_player_once(die)
	if _player_one_shot == die:
		_player_one_shot_hold = true

## This player has been left dead: every walk and attack under way ends, the
## input locks (_player_dead), the death line goes to the system window and the HUD shows
## the Revive button. The pose itself is played when the killing blow lands
## (_play_player_struck), on the counter's own timing. Idempotent: a push that
## repeats a result's kill (MonsterStrikes.CLAIM_HELD) reaches here twice.
func _enter_dead_state(exp_lost: int) -> void:
	if _player_dead:
		return
	_player_dead = true
	# The next loading screen is the rebirth one (FUN_008a80a0: this player's
	# life state 2 -> FUN_0084ab10(1), then the death; READ).
	_loading_mode = LoadingBackdrop.MODE_REBIRTH
	_sit.reset()
	_arrow_reset()
	# The body stops turning where it fell (round 637's review follow-up; OURS).
	_player_turn_target = NAN
	# Retail's death (0x30BF kind 0 value 2 -> FUN_0077b000) runs FUN_007b5300:
	# the berserk display fades out (round 629's review).
	if _hud_player_info != null:
		_hud_player_info.reset_hwan_display()
		print("World3D: death -- berserk display reset (active now %s)" % str(_hud_player_info.hwan_display_active()))
	# ... and FUN_007b1300: the casting bar goes, silently (round 779).
	if _hud_panels != null and _hud_panels.close_cast_bar():
		print("CASTBAR closed by the death")
	# Round 860: a death cancels the cast (s:0x529be9), so the hold goes.
	_own_teleport_state = 0
	_drop_pending_attack()
	_cancel_talk_approach("death")
	# A cast running on this player ends (round 785's client review, finding
	# 4, OURS: the die clip is not to be looped or replaced by its WAIT; its
	# hits land, as retail's end lands them, FUN_00a50a00).
	_end_deco(player, "the player died", true)
	_player_one_shot_loop = false
	_has_move_target = false
	player.velocity.x = 0.0
	player.velocity.z = 0.0
	# The QA attack loop stops here for good; OPENSRO_QA_REVIVE_AFTER counts
	# from this tick.
	_qa_attacking = false
	_qa_dead_tick = _qa_tick
	_qa_revive_sent = false
	var line := _death_line(exp_lost)
	# The system window gets retail's own line for the loss (round 639's
	# review): Client_ApplyExpAndLevelUp writes UIIT_MSG_STATE_LOSE_EXP
	# ("[%I64d]Experience Points lost.") with type 1 when the EXP goes down
	# (0x8a9b76..0x8a9baa). No other death line was found among the system
	# window's callers; the revive prompt keeps ours.
	var loss := exp_loss_line(exp_lost, _ui_text_table.get_text("UIIT_MSG_STATE_LOSE_EXP", "") if _ui_text_table != null else "")
	if loss != "":
		_log_system(loss, HudSystemMessage.TYPE_GAIN)
	print("World3D: %s" % line)
	if _hud_panels != null:
		_hud_panels.player_dead = true # the bag's right-click use (round 550)
		_hud_panels.show_revive_prompt(line, _player_level)
	print("World3D: left dead (HP 0) t=%.2f -- input locked until the revive" % _idle_anim_time)

## Back on its feet: an OpReviveResult with no error (_on_revive_result). The
## held die clip is released to the stand loop and the prompt comes down.
func _leave_dead_state() -> void:
	if not _player_dead:
		return
	_player_dead = false
	_player_one_shot_hold = false
	_player_one_shot = null
	if _hud_panels != null:
		_hud_panels.player_dead = false
		_hud_panels.hide_revive_prompt()

## A dead-window button (HudPanels.revive_requested, round 665), or the QA
## hook: ask the server (OpRevive 0x0028) with retail's option -- 1 the
## return point, 2 the present point. Only while dead -- the server refuses it
## otherwise, as the retail handler acts only in life state 2 (0x510077).
## Option 1 is answered with the zone change to the return point first and
## then the OpReviveResult (_on_revive_result).
func _on_revive_requested(option: int = 1) -> void:
	if not _player_dead or not NetClient.is_connected_to_server():
		return
	NetClient.revive(option)
	print("World3D: revive requested (option %d)" % option)

## OpReviveResult 0x0029: the character is back at character.RespawnFraction
## of each maximum (WorldNet.ReviveResult), or the server refused. The HP is
## painted from the result; the MP through the stats refresh, which carries
## its maximum (this scene keeps none). A refusal (option 2 above level 10)
## leaves the dead window up.
func _on_revive_result(result: WorldNet.ReviveResult) -> void:
	if result == null:
		return
	if result.error != "":
		_log_system(result.error)
		print("World3D: revive refused: %s" % result.error)
		return
	_leave_dead_state()
	_own_hp_told()
	if _last_enter_world_max_hp > 0:
		_last_enter_world_hp = result.hp
		if _hud_player_info != null:
			_hud_player_info.set_hp(result.hp, _last_enter_world_max_hp)
		if _hud_panels != null:
			_hud_panels.set_character_vitals(result.hp, _last_enter_world_max_hp, 1)
	_request_world_stats()
	# This project's own wording.
	_log_system("Revived.")
	print("World3D: revived (HP %d, MP %d)" % [result.hp, result.mp])

## Draws one monster's blow from its push: the monster turned toward its target
## and playing its attack clip (TYPE_ATTACK), then, at that clip's hit event
## (_monster_strike_seconds), the target's hit reaction (TYPE_HIT, on the
## player's body or another player's) and the red number over it. A blocked
## blow is the swing alone: it dealt nothing. A target this client has not drawn
## gets the swing alone, unturned.
## The monster's swing of a strike on `target` (null: none drawn): its clip,
## its sound context, its turn toward the target; the seconds until the blow
## lands (its clip's hit event), 0 when no body is drawn. Round 804: split out
## of _draw_monster_strike for a blow on a COS.
func _play_monster_swing(attacked: CombatNet.MonsterAttacked, target: Node3D) -> float:
	var monster := attacked.monster_id
	var strike_after := 0.0
	var body = _monster_bodies.get(monster)
	if body != null and is_instance_valid(body) and not _dying_until.has(monster):
		# Round 785: the swing is the skill the server names -- its clip one
		# of the skill's skillaniset2 SHOT list (MSKILL_CH_MANGNYANG_ATTACK01:
		# ANI_ATTACK1, type 2; _ATTACK02: ANI_ATTACK2, type 5), the body's
		# current skill set for the clip's swing and shout sounds
		# (AnimSounds' SWING and SKILL handlers key by its Basic_Code). A
		# server that names none plays the attack clip as before.
		SkillAudio.set_current(body, attacked.skill_id)
		var code := String(SkillAudio.context_for(attacked.skill_id)["code"]) if attacked.skill_id != 0 else ""
		var clip_type := _shot_clip_type(code)
		if clip_type < 0 or _monster_action_seconds(monster, clip_type) <= 0.0:
			clip_type = BsrReader.AnimationEntry.TYPE_ATTACK
		var clip_seconds := _play_monster_action(monster, clip_type)
		_monster_swing_until[monster] = Time.get_ticks_msec() + int(clip_seconds * 1000.0)
		strike_after = _monster_strike_seconds(monster, clip_type)
		# Round 809: the swing is a skill decoration, as every cast is (READ,
		# FUN_00a54f00 from 0xB070 -- the monster's swing is that message,
		# combat_presentation.md): its SHOT effect groups fire at the clip's
		# hit events -- Hashade's ice pillar and frozen star, a bone hunter's
		# arrow. Before, a monster's swing played its clip alone and none of
		# the table's 3,146 MSKILL effect rows (MEASURED) ever showed. The
		# clip above is the deco's SHOT clip ("shot_type", "no_clip"); the
		# blow still lands by the clip's hit event below (round 785).
		_deco_archive()
		SkillEffects.preload_skill_once(attacked.skill_id)
		if attacked.skill_id != 0 and clip_seconds > 0.0 and not _aniset_row_for(attacked.skill_id, code).is_empty():
			_start_deco(body, attacked.skill_id, target, "monster %d swing" % monster,
				{"code": code, "hits": 1, "shot_type": clip_type, "no_clip": true})
		if target != null:
			# Turned toward its target while it swings (CombatFacing), not
			# snapped.
			var front := MonsterMotion.front_of(String((body as Node3D).get_meta("model", "")))
			if front != "":
				var target_ref: WeakRef = weakref(target)
				_face_while_striking(body, MonsterMotion.front_yaw(front), func() -> Variant:
					var t = target_ref.get_ref()
					return _world_pos(t) if t != null and is_instance_valid(t) else null,
					clip_seconds, monster)
			if OS.get_environment("OPENSRO_QA_FACING_LOG") != "":
				_qa_strike_facing(monster, target)
		if _combat_trace:
			print("COMBAT monster %d swing ms=%d skill %d (%s) clip type %d %.3f s, lands at %.3f s" % [
				monster, Time.get_ticks_msec(), attacked.skill_id, code, clip_type, clip_seconds, strike_after])
	return strike_after

## A monster's blow on a COS (round 804, session/mobcos.go): the swing, then
## at its hit event the number over the COS (a player's-side red, as on a
## player; the COS's HP reaches its owner by the COS's own HP update) and its
## hit clip. Its death and its goods' drop come by the COS's own messages.
func _draw_monster_strike_on_cos(attacked: CombatNet.MonsterAttacked) -> void:
	var uid := attacked.target_character_id
	var body: Node3D = _cos_bodies.get(uid)
	if body != null and not is_instance_valid(body):
		body = null
	print("World3D: monster %d strikes COS %d for %d (HP %d)%s%s" % [attacked.monster_id, uid, attacked.damage,
		attacked.target_hp, " BLOCKED" if attacked.blocked else (" CRIT" if attacked.critical else ""),
		", died" if attacked.target_died else ""])
	var strike_after := _play_monster_swing(attacked, body)
	if body == null:
		return
	var body_ref: WeakRef = weakref(body)
	_after(strike_after, func() -> void:
		var b = body_ref.get_ref()
		if b == null or not is_instance_valid(b):
			return
		if attacked.blocked:
			_damage_text(b, DamageText.Art.BLOCK, 0, true, false)
			return
		if attacked.damage > 0:
			_damage_text(b, _number_art(attacked.critical), attacked.damage, true, false)
			_cos_play(uid, BsrReader.AnimationEntry.TYPE_HIT))

func _draw_monster_strike(attacked: CombatNet.MonsterAttacked, on_self: bool, report_own: bool = false) -> void:
	var monster := attacked.monster_id
	var target_id := attacked.target_character_id
	var target: Node3D = null
	if on_self:
		target = player
	elif _other_bodies.has(target_id) and is_instance_valid(_other_bodies[target_id]):
		target = _other_bodies[target_id]
	var strike_after := _play_monster_swing(attacked, target)
	if report_own:
		# The HUD's HP, the death line and the dead state, as the blow lands --
		# the HP only if nothing newer told it meanwhile (round 785's client
		# review, finding 12: _own_hp_seq).
		_after(strike_after, _show_own_strike_landed.bind(attacked, _own_hp_seq))
	if target != null and attacked.blocked:
		# The block's sound at the blocker, a player character (round 614).
		_after(strike_after, func() -> void:
			var blocker = player if on_self else _other_bodies.get(target_id)
			if blocker != null and is_instance_valid(blocker):
				# Round 786: the block word over the blocker, red (DamageText).
				_damage_text(blocker, DamageText.Art.BLOCK, 0, true, false)
				_audio_block(blocker, attacked.critical, "monster %d's blow on %s" % [
					monster, "the player" if on_self else "character %d" % target_id])
				_after(HIT_SOUND_DELAY, _audio_monster_blow.bind(monster, attacked.critical, "blocked blow on %s" % [
					"the player" if on_self else "character %d" % target_id], attacked.skill_id)))
	if target == null or attacked.blocked:
		return
	var target_key := _fx_owner_key(_own_id() if on_self else target_id, SkillNet.OWNER_CHARACTER)
	if attacked.wall != null and attacked.wall.absorbed:
		# Round 640: the target's wall took the blow whole.
		_after(strike_after, func() -> void:
			var wall_anchor = player if on_self else _other_bodies.get(target_id)
			if wall_anchor != null and is_instance_valid(wall_anchor):
				_draw_wall_blow(wall_anchor, target_key, attacked.wall, monster,
					"the player" if on_self else "character %d" % target_id))
		return
	_after(strike_after, func() -> void:
		# Looked up again: another player may have left the zone meanwhile.
		var anchor = player if on_self else _other_bodies.get(target_id)
		if anchor == null or not is_instance_valid(anchor):
			return
		# Round 640: a buff naming a DefenseEfp (a wall's) shows it.
		var landed_efp := _defense_efp_on(target_key)
		if landed_efp != "":
			_play_hit_efp_on(anchor, 2.0 * PLAYER_SCALE_RATIO, landed_efp)
		# The hit reaction only for a blow that dealt something, or killed
		# (round 785, READ: FUN_00a49290 enters state 0xb only for non-zero
		# damage, state 1 for the death bit).
		if on_self and (attacked.damage > 0 or _player_dead):
			# The hit reaction -- or the held die clip when this blow left
			# the player dead (round 548).
			_audio_mark_hit(_player_skeleton, attacked.critical)
			_play_player_struck()
		elif not on_self and (attacked.damage > 0 or attacked.target_died):
			_audio_mark_hit(_other_gaits.get(target_id, {}).get("skeleton"), attacked.critical)
			_play_other_hit(target_id)
		# Its hit sound 100 ms after the landing, keyed by the skill it swung
		# (round 785).
		_after(HIT_SOUND_DELAY, _audio_monster_blow.bind(monster, attacked.critical, "blow on %s" % [
			"the player" if on_self else "character %d" % target_id], attacked.skill_id))
		if _combat_trace:
			print("COMBAT monster %d blow lands ms=%d on %s for %d" % [monster, Time.get_ticks_msec(),
				"the player" if on_self else "character %d" % target_id, attacked.damage])
		# Red over a player, the critical's art for a critical; none for a
		# blow that dealt nothing (READ: no zero or "miss" text); another
		# player's only within 200 units of this one (round 786, DamageText).
		_damage_text(anchor, _number_art(attacked.critical), attacked.damage, true, false))

## The numbers of this player's plain swing on `monster` (round 786): one per
## hit of the monster's entry in the result's hit block, hit i drawn
## `offsets[i]` seconds after the first (the swing's hit events); without a
## block, the result's damage as one number, critical by PlayerCritical.
func _swing_numbers(body: Node3D, monster: int, result: CombatNet.AttackResult, offsets: Array) -> void:
	var t: SkillHits.Target = null
	if result.hits != null:
		t = result.hits.target(monster, SkillNet.OWNER_MONSTER)
	if t == null:
		if result.monster_damage > 0:
			_damage_text(body, _number_art(result.player_critical), result.monster_damage, false, true)
		# Round 826: the blow's shake (FUN_00a49290, one damage entry).
		_own_blow_shake(result.player_critical)
		return
	for i in t.hits.size():
		var hit: SkillHits.Hit = t.hits[i]
		var later: float = float(offsets[i]) if i < offsets.size() else 0.0
		if later <= 0.0:
			_damage_text_of_hit(body, hit, false, true)
			_own_blow_shake(hit.critical())
		else:
			var body_ref: WeakRef = weakref(body)
			_after(later, func() -> void:
				var b = body_ref.get_ref()
				if b != null and is_instance_valid(b):
					_damage_text_of_hit(b, hit, false, true)
				_own_blow_shake(hit.critical()))

## The offsets, in seconds, of a clip entry's hit events from its first (the
## BSR key times read as milliseconds, BsrReader.AnimationEntry.events); [0.0]
## for an entry with one, [] for none.
static func _hit_event_offsets(entry: BsrReader.AnimationEntry) -> Array:
	var out: Array = []
	if entry == null:
		return out
	var first := -1
	for e in entry.events:
		var ev := e as PackedInt32Array
		if ev[1] != BsrReader.AnimationEntry.EVENT_HIT:
			continue
		if first < 0:
			first = ev[0]
		out.append(float(ev[0] - first) / 1000.0)
	return out

## Turns a monster's body to face `at` (world x, z) by its model's front
## (MonsterMotion.front_of / facing_yaw). The capsule (no model), and a target
## on the body itself, leave it as it is. So does a body walking a
## leg: it keeps facing its path, as _face_monster_heading leaves it -- the leg
## faced it at its start (_apply_monster_leg) and nothing re-faces it mid-leg,
## so a turn here would have it walk sideways to its stop (round 544).
func _face_monster_toward(monster_id: int, at: Vector2) -> void:
	var body = _monster_bodies.get(monster_id)
	if body == null or not is_instance_valid(body) or _monster_is_moving(monster_id):
		return
	var front := MonsterMotion.front_of(String((body as Node3D).get_meta("model", "")))
	var dir := at - Vector2((body as Node3D).position.x, (body as Node3D).position.z)
	if front == "" or dir.is_zero_approx():
		return
	# A bare snap: a turn in progress goes on (INFERRED: a monster's strike is
	# retail's skill action, whose reader FUN_00a54be0 snaps with a bare
	# FUN_009c4260; round 637's review follow-up).
	(body as Node3D).rotation.y = MonsterMotion.facing_yaw(dir, front)

## Another player's hit reaction: the TYPE_HIT clip of their own body's
## gender and weapon group, once, back to their stand or run after
## (_play_once). A body with no assembled skeleton (the capsule) has none.
func _play_other_hit(character_id: int) -> void:
	_dress_ghost_now(character_id)
	var gait: Dictionary = _other_gaits.get(character_id, {})
	if gait.is_empty() or not is_instance_valid(gait["skeleton"]):
		return
	var hit := _body_animation_for(gait["body"], BsrReader.AnimationEntry.TYPE_HIT, gait["group"])
	if hit != null:
		_play_once(gait["skeleton"], hit)
	_arm_other_stance(character_id)

# --- Skill visual effects (round 620) ------------------------------------------

## The skill hit and the level-up burst draw their decoded .efp (round 620);
## false falls back to HitEffect / LevelUpEffect's designed animation.
const USE_EFP_HITS := true
const USE_EFP_LEVELUP := true
const LEVELUP_EFP := "system\\system_levelup.efp"
#
# SkillEffects plays skilleffectset's .efp rows through EfpEffect; its header
# carries the READ / INFERRED / OURS labels. These are World3D's bindings:
# which body a monster id or a buff owner is, and the buff-token auras.

## A monster's body, or null.
func _fx_monster_body(monster_id: int) -> Node3D:
	if monster_id < 0:
		return null
	var body = _monster_bodies.get(monster_id)
	return body if body != null and is_instance_valid(body) else null

## The body a buff owner is (ownerKind 0 character, 1 monster -- rounds
## 616-618's OpBuffStart suffix), or null when it is not in view. This player
## is decided by the buff board's own check (_buff_owner_is_self: ownerKind 0
## and the id _sync_own_id settles on, OpSelfId's when the server sent it), so
## the aura goes on the body whose icons the board shows (round 616-620
## integration; round 620 compared NetClient.own_character_id alone). Another
## character is its drawn body in _other_bodies; a monster (ownerKind 1) is
## its body in _monster_bodies, whatever its id.
func _fx_owner_body(owner_id: int, owner_kind: int) -> Node3D:
	if owner_kind == SkillNet.OWNER_MONSTER:
		return _fx_monster_body(owner_id)
	if _buff_owner_is_self(owner_id, owner_kind):
		return player
	# A body still waiting to be dressed is not drawn (round 739's review,
	# F7): its auras come with it, _dress_other resyncs them from the book.
	# Round 756's review, F1: a ghost is not dressed here -- every arriving
	# player's buffs follow its page, and dressing each on its buff froze the
	# frame (726 ms for 260). It goes to the front of the budgeted dressing,
	# which resyncs its auras (_dress_other).
	if _other_build_args.has(owner_id):
		_promote_ghost(owner_id)
		return null
	var body = _other_bodies.get(owner_id)
	# An effect follows a bone of the posed skeleton (EfpEffect.follow_host):
	# a far body comes back to the full path first (round 747, CrowdGpu).
	_crowd_wake_node(body)
	return body if body != null and is_instance_valid(body) else null

static func _fx_owner_key(owner_id: int, owner_kind: int) -> String:
	return "%s:%d" % ["monster" if owner_kind == 1 else "character", owner_id]

## OpBuffStart (from _on_buff_started, after the owner is settled): the
## skill's ACT_L aura on the owner's body, kept by token. When it answers this
## player's own self cast of the same skill, that cast's SHOT and ACT play
## first (_fx_self_cast_acts): a buff acts when it applies.
func _fx_on_buff_started(start: SkillNet.BuffStart) -> void:
	var kind := start.owner_kind
	var owner_id := start.owner_id
	var now_ms := Time.get_ticks_msec()
	for k in _recent_buff_starts.keys():
		if now_ms - int(_recent_buff_starts[k]) >= RECENT_BUFF_START_MS:
			_recent_buff_starts.erase(k)
	_recent_buff_starts["%s|%d" % [_fx_owner_key(owner_id, kind), start.skill_id]] = now_ms
	_note_owner_buff(_fx_owner_key(owner_id, kind), start.token, start.skill_id)
	var body := _fx_owner_body(owner_id, kind)
	if body == null:
		print("EFFECTS aura: buff token %d skill %d on %s, not in view -- no aura" % [
			start.token, start.skill_id, _fx_owner_key(owner_id, kind)])
		return
	if body == player:
		_fx_self_cast_acts(start.skill_id, "OpBuffStart token %d" % start.token, false)
	elif not _fx_self_cast.is_empty() and kind == SkillNet.OWNER_CHARACTER \
			and int(_fx_self_cast.get("character", -1)) == owner_id:
		# This player's friendly buff on another player (round 622) acts
		# when it applies, its aura held by the token below.
		_fx_self_cast_acts(start.skill_id, "OpBuffStart token %d on player %d" % [start.token, owner_id], false)
	# The buff's remaining time bounds the aura in case its end never
	# arrives (SkillEffects.AURA_GRACE_MS, OURS).
	var remaining := start.remaining_ms if start.remaining_ms > 0 else start.duration_ms
	# Round 838: an aura's .bsr models (AuraModel) load from Data.pk2.
	_deco_archive()
	# A re-sent start of a buff whose aura already draws on this body keeps it
	# (round 646, SkillEffects.ensure_aura).
	SkillEffects.ensure_aura(_fx_owner_key(owner_id, kind), start.token, start.skill_id, body, remaining)

## Round 646: every buff NetClient holds for `key` (BuffRoster, the server's
## word since the last entry or zone change) is in the target window's book,
## in the DefenseEfp / wall / toggle table, and -- when the owner's body is
## drawn here -- its aura on that body. Called when a body is built and when
## a zone change's arrival is laid out; a start already applied changes
## nothing (Book.start and _note_owner_buff key by token, ensure_aura keeps a
## live aura). The retail client applies a spawned object's buff list to the
## new body with the start effect skipped (FUN_009cf270 -> FUN_00a54020 with
## arg4 1, READ): only the ACT_L aura is put back here, no cast or act.
func _fx_resync_owner(key: String, why: String) -> int:
	# Round 785: the owner's abnormal states on its (new) body too.
	_state_look_resync(key)
	var roster: BuffRoster = NetClient.get("buff_roster") as BuffRoster
	if roster == null:
		return 0
	var starts := roster.starts_of(key, Time.get_ticks_msec())
	if starts.is_empty():
		return 0
	_deco_archive() # round 838: the auras' .bsr models (AuraModel)
	var n := 0
	for bs in starts:
		var start: SkillNet.BuffStart = bs
		_target_buff_book.start(key, start.token, start.skill_id)
		_note_owner_buff(key, start.token, start.skill_id)
		var body := _fx_owner_body(start.owner_id, start.owner_kind)
		if body == null:
			continue
		var remaining := start.remaining_ms if start.remaining_ms > 0 else start.duration_ms
		SkillEffects.ensure_aura(key, start.token, start.skill_id, body, remaining)
		n += 1
	print("EFFECTS resync %s (%s): %d buff(s) held, %d on a drawn body" % [key, why, starts.size(), n])
	return n

## _fx_resync_owner for every owner NetClient holds buffs for.
func _fx_resync_all(why: String) -> void:
	var roster: BuffRoster = NetClient.get("buff_roster") as BuffRoster
	if roster == null:
		return
	for key in roster.owners():
		_fx_resync_owner(String(key), why)

## Round 646: the buffs the server sent before this world existed -- the
## in-view replay that follows OpEnterWorldResult, dispatched while
## CharacterSelect was swapping this scene in, when nothing heard
## buff_started -- go through the ordinary start handler now, once the
## bodies of the arrival list are built. Their auras, the book, this
## player's own run speed and ownership; the buff bar is seeded when it is
## built (_build_buff_board).
func _replay_held_buffs(why: String) -> void:
	var roster: BuffRoster = NetClient.get("buff_roster") as BuffRoster
	if roster == null:
		return
	var starts := roster.all_starts(Time.get_ticks_msec())
	print("BUFF replay (%s): %d buff(s) held for %d owner(s)" % [why, starts.size(), roster.owners().size()])
	for bs in starts:
		_on_buff_started(bs)
	# This player's run speed as the last packet said -- a /speed-only
	# OpBuffEnd carries no token for the replay above (round 646's review).
	_sync_own_id()
	if _own_id() >= 0:
		var speed := roster.run_speed_of(_fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER))
		if speed > 0:
			_apply_buff_run_speed(speed, "the run speed held from before this world existed")

## OpBuffEnd: each ended token's aura ends at once.
func _fx_on_buff_ended(ended: SkillNet.BuffEnd) -> void:
	var key := _fx_owner_key(ended.owner_id, ended.owner_kind)
	for t in ended.tokens:
		SkillEffects.detach_aura(key, int(t))
	_forget_owner_buffs(key, ended.tokens)

# --- The protection walls (round 640) -------------------------------------
#
# Fire Wall and Crystal Wall (server session/walls.go): 'onff' toggles whose
# 'pw' wall takes the monster blows of the type it covers. What the retail
# client does with them, READ in sro_client.exe (docs/protocol/skill_buffs.md
# "The protection walls"):
#   - the wall's aura is the buff's own ACT_L loop, held by its token (above);
#   - a blow the wall took arrives as a damage entry of kind 7 (FUN_00a55e00):
#     its number shows over the caster as an ordinary damage number -- always
#     display type 0, never the critical style (FUN_00a47720 sets type 1 only
#     for kinds 0 and 4) -- the HP bar does not move (FUN_00a49290 skips
#     FUN_009c78b0 for kind 7) and no hit reaction plays (state 0xb is skipped
#     too); the wall's remaining HP is shown nowhere (its two u16s are not
#     kept);
#   - while any skill deco whose aniset row names a DefenseEfp is attached, a
#     blow on that body plays that efp in place of the attacker's hit effect
#     (IDecoSkill::FUN_009cd480, the highest Priority); with none, the
#     attacker's DamageEfp plays;
#   - nothing in retail stops the walled player from moving (neither the
#     client's move gates -- FUN_009eb140's body-state mask 0x2476, the 500 ms
#     lock the 0x7074 senders set through FUN_009eb130, the modal checks --
#     nor the server's movement handler read the wall). The root below
#     (_wall_root) is OURS, at the user's request.

## owner key -> {token: skill id} of every buff this client has seen start
## and not end: which DefenseEfp a blow on that body plays.
var _fx_owner_buffs: Dictionary = {}

func _note_owner_buff(key: String, token: int, skill_id: int) -> void:
	var m: Dictionary = _fx_owner_buffs.get(key, {})
	m[token] = skill_id
	_fx_owner_buffs[key] = m

func _forget_owner_buffs(key: String, tokens: Array) -> void:
	var m: Dictionary = _fx_owner_buffs.get(key, {})
	for t in tokens:
		m.erase(int(t))
	if m.is_empty():
		_fx_owner_buffs.erase(key)

## The DefenseEfp a blow on the owner `key` plays (SkillEffectReader.
## defense_efp_for over the owner's running buffs), "" when none names one.
func _defense_efp_on(key: String) -> String:
	var m: Dictionary = _fx_owner_buffs.get(key, {})
	if m.is_empty() or _hud_buff_board == null or _hud_buff_board.catalog == null:
		return ""
	var codes: Array = []
	for t in m:
		var code := String(_hud_buff_board.catalog.info(int(m[t])).get("basic_code", ""))
		if code != "":
			codes.append(code)
	return SkillEffectReader.defense_efp_for(_skill_anisets(), codes)

## Whether this player runs an 'onff' toggle of `skill_id` (round 640): a
## recast of it switches it off on the server (Tick_UseSkill's phase 0,
## 0x4ae622..0x4ae64d, READ) and draws no cast -- the retail caster's cast is
## drawn from the server's 0xB070, which a toggle-off never sends.
func _own_toggle_running(skill_id: int) -> bool:
	if _hud_buff_board == null or _hud_buff_board.catalog == null:
		return false
	if not bool(_hud_buff_board.catalog.info(skill_id).get("onff", false)):
		return false
	var key := _fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER)
	return (_fx_owner_buffs.get(key, {}) as Dictionary).values().has(skill_id)

## The skill id of this player's own protection wall while one stands, else
## 0 (round 640). THE ROOT IS OURS -- the user's choice "Root while walled";
## retail's client and server both let a walled caster move (the probes are
## in docs/protocol/skill_buffs.md). While it holds, no ground click or walk
## into reach moves the player; attacks, skills and
## pick-ups go out from where the player stands and the server's ordinary
## reach rules judge them. The server drops a rooted caster's moves too
## (session/walls.go wallRoots). Whatever ends the wall's buff ends it.
func _wall_root() -> int:
	if _hud_buff_board == null or _hud_buff_board.catalog == null:
		return 0
	var mine: Dictionary = _fx_owner_buffs.get(_fx_owner_key(_own_id(), SkillNet.OWNER_CHARACTER), {})
	for t in mine:
		var skill := int(mine[t])
		if bool(_hud_buff_board.catalog.info(skill).get("pw", false)):
			return skill
	return 0

## When a refused move was last logged (an approach is re-asked every tick).
var _root_logged_ms := -100000

## Logs a move the wall refused, at most once a second.
func _log_root(what: String, skill: int) -> void:
	var now := Time.get_ticks_msec()
	if now - _root_logged_ms < 1000:
		return
	_root_logged_ms = now
	print("ROOT: %s refused -- this player's wall (skill %d) roots it (OURS: the user's request, not in retail's binaries)" % [what, skill])

## A monster's blow a protection wall took (round 640): the number over
## `anchor` as an ordinary damage number, the DefenseEfp of the body's
## buffs, the monster's own blow sound -- and no hit reaction and no HP
## change (kind 7, READ). Which sounds retail plays for kind 7 was not read
## (OPEN): the monster's blow sound is kept, the "struck" one is not.
func _draw_wall_blow(anchor: Node3D, owner_key: String, wall: CombatNet.WallHit, monster: int, who: String) -> void:
	if anchor == null or not is_instance_valid(anchor):
		return
	var efp := _defense_efp_on(owner_key)
	print("WALL: monster %d's blow on %s taken by the wall: %d, wall HP %d/%d%s; DefenseEfp '%s'" % [monster, who,
		wall.damage, wall.hp, wall.max_hp, " -- BROKEN" if wall.broke else "",
		efp if efp != "" else "none: the attacker's hit effect"])
	_audio_monster_blow(monster, wall.critical, "blow on %s's wall" % who)
	# With no DefenseEfp on the body (the wall's buff already ended by the
	# breaking blow, say), retail plays the attacker's DamageEfp. The
	# monster's skill is not on OpenSRO's wire, so HitEffect's default
	# layers stand in for it (OURS).
	_play_hit_efp_on(anchor, 2.0 * PLAYER_SCALE_RATIO, efp)
	# Kind 7 draws the plain number whatever its flags (FUN_00a47720, READ).
	# Retail's entry names the wall's own object, whose class -- so whether
	# it is tinted as a player's -- was not read (OPEN); drawn over the
	# player in the player's red (OURS; round 786, DamageText).
	_damage_text(anchor, DamageText.Art.NUMBER, wall.damage, true, false)

## This player's self, ground or friendly cast waiting for the server's
## answer (_send_self_cast, _send_character_cast): {skill, code, ground,
## acted, begun, sent_ms, [character, act_after_ms]}; empty when none.
var _fx_self_cast: Dictionary = {}

## The server answered this player's own pending cast (the accepted reply,
## OpBuffStart or OpSkillMove, whichever comes first): its decoration starts
## -- retail's caster starts its on 0xB070 (READ, FUN_008a5fd0 ->
## FUN_00a54f00) -- and its re-use time is armed (FUN_00778910). Once a cast.
func _fx_self_cast_begin(why: String) -> void:
	if _fx_self_cast.is_empty() or bool(_fx_self_cast.get("begun", false)):
		return
	_fx_self_cast["begun"] = true
	var skill_id := int(_fx_self_cast["skill"])
	_arm_skill_cooldown(skill_id)
	var on: Node3D = player
	var target_id := int(_fx_self_cast.get("character", -1))
	if target_id >= 0:
		var body = _other_bodies.get(target_id)
		if body != null and is_instance_valid(body):
			on = body
	var opts := {"code": String(_fx_self_cast.get("code", ""))}
	if bool(_fx_self_cast["ground"]):
		# Ghost Walk's WAIT holds through the move; the move's arrival ends
		# the decoration (READ, FUN_00a50f70 -> FUN_00a50a00).
		opts["due_ms"] = -1
	_start_deco(player, skill_id, on, "own cast (%s)" % why, opts)

## The server answered this player's self or ground cast of `skill_id`
## (OpBuffStart for a buff, OpSkillMove for a ground cast, the accepted reply
## otherwise): ACT_S plays on the body the skill acts on, and with
## `with_aura` ACT_L one cycle, for a cast no buff token will hold. Once per
## cast. The WAIT hold of a skill that has one goes to SHOT here (the
## server's act, 0xB071's analogue) -- except a ground cast's, which its
## move ends.
func _fx_self_cast_acts(skill_id: int, why: String, with_aura: bool) -> void:
	if _fx_self_cast.is_empty() or int(_fx_self_cast["skill"]) != skill_id or bool(_fx_self_cast["acted"]):
		return
	_fx_self_cast_begin(why)
	_fx_self_cast["acted"] = true
	# A cast at a player (round 622) acts on that player's body: the object
	# the skill acts on (Heal's ACT_S water_hpheal_effect_a.efp at Bip01).
	var on: Node3D = player
	var target_id := int(_fx_self_cast.get("character", -1))
	if target_id >= 0:
		var body = _other_bodies.get(target_id)
		if body != null and is_instance_valid(body):
			on = body
	# Only this cast's own WAIT goes to SHOT (round 785's client review,
	# finding 10): another cast still running on the player is not its act.
	if not bool(_fx_self_cast["ground"]) and int(_deco_on(player).get("skill", 0)) == skill_id:
		_shot_deco(player)
	# ACT plays on the object the skill acts on (skills_spec §1.2, INFERRED
	# from the rows: Heal's ACT_S at the healed body's Bip01), so that body is
	# both host arguments: an AT_ONE_FOLLOW row would otherwise go on the
	# caster (SkillEffects.host_for).
	SkillAudio.play_phase(skill_id, SkillAudio.ACT_S, -1, on, "act (%s)" % why)
	var n := SkillEffects.act(skill_id, on, on, with_aura).size()
	print("EFFECTS self cast: skill %d acts on %s (%d ACT effect(s)%s)" % [skill_id, why, n,
		", on player %d" % target_id if on != player else ""])

## The accepted reply to a self or ground cast: the cast is drawn now if
## nothing drew it yet, and a skill no OpBuffStart or OpSkillMove answered (a
## self-heal, a zero-damage self row) acts now, with its ACT_L one cycle.
func _fx_self_cast_accepted() -> void:
	if _fx_self_cast.is_empty():
		return
	_fx_self_cast_begin("the accepted reply")
	if _fx_self_cast.has("character") and not bool(_fx_self_cast["acted"]):
		# A cast at a player (round 622) acts after its own prep + cast.
		var fx := _fx_self_cast
		_after(maxf(float(int(fx["act_after_ms"])), 0.0) / 1000.0, func() -> void:
			var keep := _fx_self_cast
			_fx_self_cast = fx
			_fx_self_cast_acts(int(fx["skill"]), "the accepted reply, %d ms after it" % int(fx["act_after_ms"]), true)
			_fx_self_cast = keep)
		_fx_self_cast = {}
		return
	if bool(_fx_self_cast["ground"]):
		# Its move (OpSkillMove) acts; the reply may come first.
		return
	_fx_self_cast_acts(int(_fx_self_cast["skill"]), "the accepted reply", true)
	_fx_self_cast = {}

## A refused self or ground cast: a decoration already drawn ends, nothing
## more fires.
func _fx_self_cast_refused() -> void:
	if not _fx_self_cast.is_empty():
		print("EFFECTS self cast: skill %d refused -- nothing more is drawn" % int(_fx_self_cast["skill"]))
		if bool(_fx_self_cast.get("begun", false)):
			_end_deco(player, "refused")
	_fx_self_cast = {}

## OPENSRO_QA_EFFECT's plays (see the hook).
func _qa_play_effects(spec: String) -> void:
	var particles := _open_particles_pk2_if_set()
	var spacing_text := OS.get_environment("OPENSRO_QA_EFFECT_SPACING")
	var spacing := float(spacing_text) if spacing_text.is_valid_float() else 40.0
	var paths := spec.split(";", false)
	for i in range(paths.size()):
		var path := String(paths[i]).strip_edges()
		var fx := EfpEffect.create(path, particles)
		if fx == null:
			print("QA EFFECT %s: did not build (%s)" % [path, EfpEffect.last_error])
			continue
		fx.loop = true
		var x := (float(i) - float(paths.size() - 1) * 0.5) * spacing
		# OPENSRO_QA_EFFECT_BONE (round 621) attaches them at that bone
		# instead ("Bip01 R Hand" shows a trail behind a swinging hand).
		var bone := OS.get_environment("OPENSRO_QA_EFFECT_BONE")
		SkillEffects.attach(fx, player, bone if bone != "" else "none", Vector3(x, 0, 0))
		print("QA EFFECT %s at x %.0f: %d node(s) drawn, skipped %s" % [path, x, fx.draw_count(), str(fx.skipped)])

## OPENSRO_QA_FXDRIFT="<tick>:<action>;..." (round 786, FxDriftProbe): where
## the effects on the player draw against where each is placed, sampled every
## OPENSRO_QA_FXDRIFT_EVERY ticks (default 5) from the first action on, over a
## script of actions:
##   auras:<id>,<id>   start those skills' ACT_L auras on the player (tokens
##                     from 1, owner "qa:fxdrift"), as OpBuffStart does
##   phase:<name>      the phase the next samples count under ("stand", the
##                     first, measures each effect's still bound)
##   turn:<deg>        turn the body that many degrees a tick (0 stops)
##   jump:<dx>,<dz>    move the body that far in one tick (a GM move)
##   speed:<v>         run at v units a second (_apply_buff_run_speed)
##   corr:<dx>,<dz>    the server's correction that far away (a snap,
##                     _apply_own_correction)
##   zone:<zone>@<x>,<z>[,<frame>]  a gate teleport's arrival as the server
##                     sends it (OpChangeZoneResult: that zone at (x, 0, z) in
##                     its frame, the gate's receipt first), through
##                     _on_change_zone_result -- the user's Donwhang -> Jangan
##   end               print the phase totals
##   quit              end the run (a real-time run, QA_SHOT_REALTIME=1)
## A walk is OPENSRO_QA_WALK_TO's (a ground click). QA only.
var _qa_fx_drift_spec := OS.get_environment("OPENSRO_QA_FXDRIFT")
var _qa_fx_drift: FxDriftProbe = null
var _qa_fx_drift_turn := 0.0

func _qa_fx_drift_step() -> void:
	for part in _qa_fx_drift_spec.split(";", false):
		var bits := String(part).split(":", true, 1)
		if bits.size() < 2 or not bits[0].is_valid_int() or int(bits[0]) != _qa_tick:
			continue
		if _qa_fx_drift == null:
			_qa_fx_drift = FxDriftProbe.new()
			_qa_fx_drift.verbose = OS.get_environment("OPENSRO_QA_FXDRIFT_QUIET") == ""
		var act := String(bits[1])
		var arg := act.get_slice(":", 1) if act.contains(":") else ""
		var verb := act.get_slice(":", 0)
		match verb:
			"auras":
				var token := 1
				for sid in arg.split(",", false):
					var n := SkillEffects.attach_aura("qa:fxdrift", token, int(sid), player).size()
					print("QA FXDRIFT tick %d aura %d skill %s: %d effect(s)" % [_qa_tick, token, sid, n])
					token += 1
			"phase":
				_qa_fx_drift.set_phase(arg, _qa_tick)
			"turn":
				_qa_fx_drift_turn = float(arg)
				print("QA FXDRIFT tick %d turn %.1f degrees a tick" % [_qa_tick, _qa_fx_drift_turn])
			"jump":
				var d := arg.split(",")
				var by := Vector3(float(d[0]), 0.0, float(d[1]))
				print("QA FXDRIFT tick %d jump by %s" % [_qa_tick, by])
				player.global_position += by
			"zone":
				var at := arg.get_slice("@", 1).split(",")
				var r := WorldNet.ChangeZoneResult.new()
				r.ok = true
				r.zone = arg.get_slice("@", 0)
				r.x = float(at[0])
				r.y = 0.0
				r.z = float(at[1])
				r.frame = at[2] if at.size() > 2 else ""
				print("QA FXDRIFT tick %d zone change to %s at (%.1f, 0, %.1f) frame '%s' from %s" % [
					_qa_tick, r.zone, r.x, r.z, r.frame, player.global_position])
				_teleport_arrival_pending = true
				_on_change_zone_result(r)
			"speed":
				# Round 786: a run speed as a buff or /speed sets it.
				_apply_buff_run_speed(int(arg), "QA FXDRIFT")
			"corr":
				# Round 786: the server's correction of this player that far
				# from where it stands (_apply_own_correction, a snap).
				var c := arg.split(",")
				print("QA FXDRIFT tick %d correction by (%s, %s)" % [_qa_tick, c[0], c[1]])
				_apply_own_correction(player.position + Vector3(float(c[0]), 0.0, float(c[1])), 0.0)
			"end":
				_qa_fx_drift.finish()
				print("QA FXDRIFT tick %d: %d frames drawn so far" % [_qa_tick, Engine.get_frames_drawn()])
			"quit":
				get_tree().quit()
	if _qa_fx_drift == null:
		return
	_qa_fx_drift.track(player)
	if _qa_fx_drift_turn != 0.0:
		player.rotation.y += deg_to_rad(_qa_fx_drift_turn)
	var every_text := OS.get_environment("OPENSRO_QA_FXDRIFT_EVERY")
	var every := maxi(int(every_text), 1) if every_text.is_valid_int() else 5
	if _qa_tick % every == 0:
		_qa_fx_drift.sample(player, _qa_tick)

## OPENSRO_QA_CAST's schedule (see the hook): each listed skill's decoration
## runs on the player (round 785, _start_deco) at the start of its period, its
## WAIT hold forced to SHOT 30 ticks in, its ACT 40 ticks in and its ACT_L
## aura 41 ticks in.
func _qa_cast_step(spec: String) -> void:
	var ids := spec.split(",", false)
	var period_text := OS.get_environment("OPENSRO_QA_CAST_PERIOD")
	var period := int(period_text) if period_text.is_valid_int() else 160
	var t := _qa_tick - 20
	var idx := t / period
	var at := t % period
	if idx >= ids.size() or not String(ids[idx]).strip_edges().is_valid_int():
		if at == 0 and idx == ids.size():
			SkillEffects.detach_aura("qa:player", 1)
		return
	var skill := int(String(ids[idx]).strip_edges())
	match at:
		0:
			SkillEffects.detach_aura("qa:player", 1)
			print("QA CAST tick %d skill %d: its decoration starts (timing %s)" % [_qa_tick, skill,
				str(SkillEffects._timings.get(skill, "none"))])
			_start_deco(player, skill, _fx_monster_body(_last_attack_target), "QA cast", {"due_ms": -1})
		30:
			print("QA CAST tick %d skill %d: the act (WAIT -> SHOT)" % [_qa_tick, skill])
			_shot_deco(player)
		40:
			print("QA CAST tick %d skill %d act (ACT_S)" % [_qa_tick, skill])
			SkillEffects.act(skill, player, player)
		41:
			var n := SkillEffects.attach_aura("qa:player", 1, skill, player).size()
			print("QA CAST tick %d skill %d ACT_L aura: %d effect(s)" % [_qa_tick, skill, n])

# --- Combat and skill sounds (round 614) ---------------------------------------
#
# The code-fired half of the combat audio: CombatAudio builds retail's keys
# (its header has every READ / INFERRED / OURS label) and SkillAudio holds the
# skill tables and the skilleffectset cast sounds. The animation-fired half
# (swings, voices, footsteps) is the .bsr sound tracks'; it reads the player's
# current skill through SkillAudio.set_current / context_of.

## The TypeID4 of the weapon in hand: 0 with the slot empty, -1 for an item
## the item table does not name as a weapon.
func _player_weapon_type_id4() -> int:
	var weapon_id := int(_player_equipped_last.get(EquipmentNet.SLOT_WEAPON, 0))
	if weapon_id == 0:
		return 0
	return int(_item_kinds.get(weapon_id, -1))

## The weapon token FUN_00a648d0 would give for the weapon in hand.
func _player_weapon_token() -> String:
	var tid4 := _player_weapon_type_id4()
	return CombatAudio.weapon_token(tid4, tid4 != 0)

## The player's blow lands on `monster`: the hit sound at the player (the
## attacker, CombatAudio's header), and for a cast its activation
## (snd_activate). A cast's SHOT and ACT rows are its decoration's (round
## 785, _start_deco), not this landing's.
## Retail makes the damage decoration, and so the hit sound, for EVERY damage
## record whose caster and target resolve -- no damage or kind check
## (IDecoSkill::FUN_00a4bdd0 / FUN_00a4f720, READ; review of round 614) -- so
## a plain swing sounds whatever it dealt, 0 included. A CAST that dealt 0 is
## silent here (OURS): OpAttackResult cannot tell a zero-damage blow from a
## cast that made no damage record at all (a self-heal, a buff).
func _audio_blow_lands(blow: Dictionary, dealt: int, monster: int) -> void:
	var skill := int(blow["skill"])
	var ctx := SkillAudio.context_for(skill)
	var what := "%s on monster %d, %d damage" % [
		"skill %d" % skill if bool(blow["cast"]) else "plain swing (skill %d)" % skill, monster, dealt]
	if dealt > 0 or not bool(blow["cast"]):
		CombatAudio.play_hit(bool(blow["critical"]), CombatAudio.PLAYER, bool(blow["hwan"]),
			String(ctx["group"]), String(ctx["code"]), _player_weapon_token(), player, what)
	if not bool(blow["cast"]):
		return
	CombatAudio.play_activate(CombatAudio.PLAYER, String(ctx["group"]), player, what)

## A monster's blow lands on a character: its hit sound at the monster (the
## attacker), keyed by its sound object and its attack skill. OpenSRO's
## server names no monster skill, so the skill token is "-" -- and every
## monster row names one (MEASURED), so this is logged and silent until the
## server sends the skill (OPEN).
func _audio_monster_blow(monster: int, critical: bool, what: String, skill_id: int = 0) -> void:
	var body = _monster_bodies.get(monster)
	var snap = _monster_snapshots.get(monster)
	var obj := SoundTable.sound_object(String(snap.code_name)) if snap != null else ""
	if body == null or not is_instance_valid(body):
		body = null
	# Round 785: keyed by the skill the blow names (OpMonsterAttacked's skill
	# id, its Basic_Code after Basic_Original: MOB_MANGNYANG:snd_dmg:
	# MSKILL_CH_MANGNYANG_ATTACK01); "-" when the server names none.
	var ctx := SkillAudio.context_for(skill_id) if skill_id != 0 else {"code": CombatAudio.NONE, "group": CombatAudio.NONE}
	CombatAudio.play_hit(critical, obj, false, String(ctx["group"]), String(ctx["code"]), "", body,
		"monster %d (%s) %s" % [monster, obj if obj != "" else "no sound object", what])

## A shield block on a player character, at the blocker. The blocked record
## still gets its damage decoration, so the attacker's snd_dmg / snd_cridmg
## plays beside it (FUN_00a49780 has no block check, READ): the callers pair
## this with _audio_monster_blow.
## Not implemented: retail's gate on the call that plays it -- FUN_00a49290
## reaches FUN_00a47bf0 only when the struck object's +0x65c & 1 is set, its
## +0xbc byte is non-zero, its +0x24c distance is under the constant at
## 0xe1b8b8 or param_3 is the local player (DAT_00eef5ec), and the global flag
## DAT_00ec4b58 is set (READ, 0xa49290's tail) -- none of which is modelled:
## every block the client learns of sounds.
func _audio_block(blocker: Node3D, critical: bool, what: String) -> void:
	CombatAudio.play_block(CombatAudio.PLAYER, critical, blocker, what)

# --- Sitting down and standing up (round 607) ----------------------------------
#
# docs/protocol/opcodes/motion.md. N asks the server (OP_MOTION_REQUEST [4]) and
# nothing animates until it answers with OP_STATE_CHANGE kind 1 -- as the retail
# client does (its N handler only sends; 0x8a80a0 animates on the answer). The
# clips are the body's own, looked up by action type in its .bsr: 13 sit down,
# 14 sitting (a loop), 15 stand up -- the retail sit entry (0xa5a270) plays 13
# only when it comes from standing, and its stand entry (0xa5a160) plays 15 only
# when it comes from sitting.

## N: ask to sit down or stand up. Not while dead, not while a request is
## already out or the server is still in its transition (it would refuse), and
## not without a server. The body stops first: the server sits a walker down by
## stopping it (slot 0x4b0), and this server cannot stop the client.
func _request_sit_toggle() -> String:
	if _player_dead or _is_typing() or not NetClient.is_connected_to_server() or _motion_locked():
		return "not sent (%s)" % ("dead" if _player_dead else "typing" if _is_typing()
			else "not connected" if not NetClient.is_connected_to_server() else "a motion change is in flight")
	var was_sitting := _sit.sitting
	_has_move_target = false
	_drop_pending_attack()
	player.velocity.x = 0.0
	player.velocity.z = 0.0
	# The stop is sent before the request, so the server does not take a
	# later position update for a move made in its transition (round 749:
	# the stop report, when the walk ended short of where the server walks).
	if not was_sitting:
		_flush_position()
	_sit.press(_player_anim_time)
	print("SIT: N pressed -- sending 0x704f [04] (sitting=%s)" % str(was_sitting))
	NetClient.request_motion(WorldNet.MOTION_SIT)
	return "0x704f [04] sent (%s)" % ("standing up" if was_sitting else "sitting down")

## Round 808: a click that would walk, approach or swing while seated asks to
## stand instead and does nothing else -- no ring, no walk, no attack; the
## player clicks again once standing (READ: the world click 0x78f8d0 tests the
## sit state, +0x65c bit 6, before its pick, 0x78f9c4..0x78f9d7; the basic
## attack's sender 0x791d40 right after its target lookup, 0x791d9b..
## 0x791daa; both call 0x9d4a20, the N key's 0x704f [04] -- and the move gate
## 0x9eb140 never lets a 0x7021 out while seated). The stand-up clip plays
## from the server's answer (_apply_player_motion). True when the player was
## seated, and the caller stops.
func _stand_instead(what: String) -> bool:
	if not _sit.sitting:
		return false
	print("SIT: %s while seated -- standing up instead: %s" % [what, _request_sit_toggle()])
	return true

## Whether movement input is held for the motion: a request in flight, or the
## server's transition after its answer.
func _motion_locked() -> bool:
	return _sit.locked(_player_anim_time)

# --- The action window (round 781) ----------------------------------------------
#
# ActionCommands has the retail dispatcher's table (0x793b00); HudActionPane
# fills the window. This is what each button does in this world. The window's
# right click and a quick slot holding an action both come here.

## Whether this player walks (the mover's run flag cleared): set by the
## server's answer to Walk/Run, 0x30BF kind 1 value 2 (walk) / 3 (run). A new
## entry and a zone change run again (the server's runAgain; OURS).
var _walk_mode := false
## Other players who walk: character id -> their walk speed (characterdata
## column 46 of their body), from their 0x30BF value 2 or a spawn record whose
## run flag is 0.
var _other_walking := {}
## The quick slots holding an action (round 781): slot -> action id. Retail's
## slot kind 0x4a, whose use is 0x793b00(owner, id) (0x60bace, READ).
var _quickslot_actions := {}

## The speed this player's legs move at: the run speed, or the walk speed of
## its body (characterdata column 46, the server's PlayerWalkSpeed) while it
## walks.
func _gait_speed() -> float:
	if not _walk_mode:
		return _move_speed
	# Round 798: a walking rider moves at its mount's walk speed (s:0x4aa410,
	# the server's motionSpeed), not its own feet's.
	var mount_walk := _rider_walk_speed(_own_id())
	if mount_walk > 0.0:
		return mount_walk
	var row: Array = _speeds_by_code.get(_player_body, [])
	if row.size() == 2 and float(row[0]) > 0.0:
		return float(row[0])
	return WALK_SPEED_FALLBACK

## A walker's speed when its body has no characterdata row: the server's
## PlayerWalkSpeed (16, characterdata column 46 on all 52 creatable bodies,
## MEASURED round 737).
const WALK_SPEED_FALLBACK := 16.0

## A world entry or a zone change: this player runs again and stands (the
## server's enter / runAgain and stand), so the window's buttons that show
## otherwise swap back; nobody else is known to walk until told.
func _reset_walk_for_entry() -> void:
	# Round 832: no action runs in the new zone (GI+0x620 is reset by
	# CGInterface::FUN_0078d050, READ; the server ended the trace).
	_action_depth = 0
	_trace = {}
	_trace_sent = -1
	_trace_run_due = false
	var was_walking := _walk_mode
	_walk_mode = false
	_other_walking.clear()
	if was_walking:
		_action_motion_shown(WorldNet.MOTION_RUN)
	if _hud_panels != null and _hud_panels.action_pane != null \
			and String(_hud_panels.action_pane.icon_paths.get(ActionCommands.SIT, "")).ends_with("icon_cha_stand.ddj"):
		_action_motion_shown(WorldNet.MOTION_STAND)

## Round 832: the right-click target menu (TargetMenu, CNIFTargetMenu). READ,
## CGInterface::vslot_017 (0x77c260), in retail only while the option byte
## +0x1a ("Activate action short cut") is set; OpenSRO has it always on
## (OURS, round 834, the user's call), so the option is gone:
##   - WM_RBUTTONDOWN destroys the menu and arms GI+0x82c;
##   - a right drag of more than 5 pixels disarms it;
##   - WM_RBUTTONUP, armed, over a CICUser (FUN_0077b5e0): the player is
##     selected (FUN_00778650 + 0x7045) and the menu opens, its top-left at
##     the cursor.
## The name box is filled by the select reply's target-window update, and
## the select request is not sent for a player already selected with the
## target window up (0x78f5f0) -- so the box stays empty then (INFERRED from
## those two READ steps).
var _target_menu: TargetMenu = null
var _target_menu_armed := false
var _target_menu_press := Vector2.ZERO

func _target_menu_right_button(pressed: bool, at: Vector2) -> void:
	if pressed:
		_close_target_menu()
		_target_menu_armed = true
		_target_menu_press = at
		return
	if not _target_menu_armed:
		return
	_target_menu_armed = false
	var who := _player_under_cursor(at)
	if who.is_empty():
		return
	var id := int(who["id"])
	var already := _selected_character == id and _hud_target != null and _hud_target.visible
	if _selected_character != id:
		_select_character(id, String(who["name"]))
	_open_target_menu(at, "" if already else String(who["name"]))

## The player under the cursor: the first body the click's pick meets
## (monsters and other players, as _pick_character), if it is a player.
func _player_under_cursor(at: Vector2) -> Dictionary:
	if not NetClient.is_connected_to_server() or _objects_hidden or camera_3d == null:
		return {}
	var from := camera_3d.project_ray_origin(at)
	var dir := camera_3d.project_ray_normal(at)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
	query.exclude = [player.get_rid()]
	query.collision_mask = MONSTER_COLLISION_LAYER | OTHER_PLAYER_COLLISION_LAYER
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	if hit.is_empty():
		return {}
	var node := hit["collider"] as Node
	while node != null and not (node.has_meta("monster_id") or node.has_meta("character_id") or node.has_meta("cos_uid")):
		node = node.get_parent()
	if node == null or not node.has_meta("character_id"):
		return {}
	return {"id": int(node.get_meta("character_id")), "name": String(node.get_meta("character_name", ""))}

func _open_target_menu(at: Vector2, target_name: String) -> void:
	if _target_menu == null or not is_instance_valid(_target_menu):
		_target_menu = TargetMenu.new()
		if not _target_menu.build(_ui_builder):
			print("TARGET MENU: %s did not build" % TargetMenu.FILE)
			_target_menu.free()
			_target_menu = null
			return
		ui_control.add_child(_target_menu)
		_target_menu.chosen.connect(_on_target_menu_chosen)
		_target_menu.chosen_extra.connect(_on_target_menu_extra)
	_target_menu.open_at(at, target_name)
	print("TARGET MENU: open at %s for '%s'" % [str(at), target_name])

func _close_target_menu() -> void:
	if _target_menu != null and is_instance_valid(_target_menu) and _target_menu.visible:
		_target_menu.hide()

## The five handlers (message map 0xeb4ec8, READ). The first four need the
## selection (GI+0x628) to be another player (exists, not this one, a
## CICUser) and do nothing otherwise; Trace is the action dispatcher's 1003
## with no test of its own.
func _on_target_menu_chosen(id: int) -> void:
	if id == TargetMenu.ID_TRACE:
		print("TARGET MENU: trace -> %s" % _run_action(ActionCommands.TRACE))
		return
	var target := _selected_character
	if target < 0 or target == _own_id() or not _other_bodies.has(target):
		print("TARGET MENU: button %d -- the selection is no other player, nothing done" % id)
		return
	var body = _other_bodies.get(target)
	var who := String((body as Node).get_meta("character_name", "")) if body != null and is_instance_valid(body) else ""
	match id:
		TargetMenu.ID_WHISPER:
			# 0x60a1f0: the chat line "$name " (FUN_007ab470), shown and focused.
			if who != "" and who != NetClient.current_character_name and _hud_chat != null:
				_hud_chat.open_with("$%s " % who)
		TargetMenu.ID_EXCHANGE:
			# 0x60a280 -> SendTradeMsg_081 (exchange_request).
			print("TARGET MENU: exchange -> %s" % exchange_request(target))
		TargetMenu.ID_FRIEND:
			# 0x60a2d0 -> SendMessengerMsg_302: the name, no line.
			if who != "":
				friend_ask(who)
		TargetMenu.ID_PARTY:
			# 0x60a330: create out of a party, invite as leader or with
			# anyone-invite, else nothing (HudPartyPane.press_invite).
			if _hud_panels != null and _hud_panels.party_pane != null:
				_hud_panels.party_pane.press_invite()

## Round 834 (OURS): an entry of TargetMenu.EXTRA_ENTRIES, by key. Each new
## entry is a branch here; the selection is the player the menu opened on.
func _on_target_menu_extra(key: String) -> void:
	match key:
		_:
			print("TARGET MENU: extra entry '%s' has no action" % key)

## Round 832: Trace. The request, its answers and its end are retail's
## (ActionNet, server/internal/session/trace.go); the walk is the server's
## walker (TraceFollow), run here because OpenSRO's server does not move
## players (OURS: the place, not the rules). docs/protocol/trace.md.
##
## The action byte GI+0x620 (READ): the depth the last 0xB074 carried. At 2
## or more the client sends no action and no cancel (FUN_0077c9b0).
var _action_depth := 0
## The running trace: {"target", "stop", "restart", "next_ms", "walking"};
## empty when none. Set by the 0xB074 that starts it, ended by the one that
## ends it, by the ground click's cancel, or by another action (Push).
var _trace := {}
## The target of a trace request not yet answered, or -1 (OURS bookkeeping:
## retail's client keeps no trace target, its server walks).
var _trace_sent := -1
## A trace walk went out this tick and asks for the run after it.
var _trace_run_due := false

## Trace (0x793b00 case 1003, READ): the UI gate FUN_0077c8e0(0) and the busy
## test FUN_0077c9b0, then 0x7074 [01 03 01 <selection>] -- no test of what is
## selected (a monster, nothing at all: the server refuses it). OpenSRO's
## monster ids overlap its character ids, so a selection that is no player
## goes out as 0, which the server resolves to no one, as retail's resolves a
## monster to no PC (OURS).
func _action_trace() -> String:
	if not NetClient.is_connected_to_server():
		return "not sent (not connected)"
	if _action_ui_blocked():
		return "not sent (a window that holds actions is open)"
	if _action_depth >= ActionNet.BUSY_DEPTH:
		return "not sent (busy: action depth %d)" % _action_depth
	var target := trace_target_of(_selected_character, _own_id(), _other_bodies.has(_selected_character))
	_trace_sent = target
	NetClient.action_trace(target)
	return "0x7074 [01 03 01 %d] sent" % target

## The uid a trace names for the selection (see _action_trace).
static func trace_target_of(selected: int, own: int, is_other_player: bool) -> int:
	if selected >= 0 and (is_other_player or selected == own):
		return selected
	return 0

## FUN_0077c8e0(0), the part of it this client has windows for (READ): the
## alchemy window existing (0xa8), the exchange window shown (0x1a). Its
## other windows and modes (the stall 0x21, 0x8c, 0x96, the open market 0xbe,
## the delay board's busy flag, GI+0x504) are not built.
func _action_ui_blocked() -> bool:
	if _hud_panels == null:
		return false
	if _hud_panels.alchemy_window() != null:
		return true
	return _hud_panels.is_open("exchange")

## 0xB074 (FUN_00880b60, READ): the depth is stored; a result of 3 shows its
## code's line. The trace starts and ends with it here (OURS bookkeeping).
func _on_action_result(result: int, depth: int, code: int) -> void:
	_action_depth = depth
	match result:
		ActionNet.RESULT_STARTED:
			if _trace_sent >= 0:
				_start_trace(_trace_sent)
			_trace_sent = -1
		ActionNet.RESULT_ENDED:
			if not _trace.is_empty():
				_end_trace("the server ended it", true)
		ActionNet.RESULT_ERROR:
			_trace_sent = -1
			var key := String(ActionNet.ERROR_LINES.get(code, ""))
			if key != "":
				_log_system(_resolve_any_text(key, key))
			print("ACTION: refused 0x%04x%s" % [code, "" if key != "" else " (no line, as retail's 0x4003/0x4004)"])

func _start_trace(target: int) -> void:
	var body_code: String = _player_body if _player_body != "" else String(GENDER_BODY_CODE[DEFAULT_GENDER])
	var own_bc := int(_bc_radius_by_code.get(body_code, CombatNet.PLAYER_BC_RADIUS))
	var target_bc := CombatNet.PLAYER_BC_RADIUS
	var gait: Dictionary = _other_gaits.get(target, {})
	if not gait.is_empty():
		target_bc = int(_bc_radius_by_code.get(String(gait["body"]), CombatNet.PLAYER_BC_RADIUS))
	var bands := TraceFollow.bands(own_bc, target_bc)
	_trace = {"target": target, "own_bc": own_bc, "target_bc": target_bc, "stop": bands.x, "restart": bands.y,
		"next_ms": 0, "walking": false}
	print("TRACE: started on %d (stop %d, walk again beyond %d)" % [target, bands.x, bands.y])

## Ends the trace here. `stop_walk`: the walk it ordered stops where it is
## (FinishFront's 0x4b03f0, READ).
func _end_trace(why: String, stop_walk: bool) -> void:
	if _trace.is_empty():
		return
	if stop_walk and bool(_trace["walking"]) and _has_move_target:
		_stop_own_walk()
	print("TRACE: ended (%s)" % why)
	_trace = {}
	_trace_run_due = false

func _stop_own_walk() -> void:
	_has_move_target = false
	_move_heading_run = false
	player.velocity.x = 0.0
	player.velocity.z = 0.0

## The ground click's cancel (0x78f8d0, READ): 0x7074 [02] when an action
## runs (GI+0x620 not 0) and the client is not busy (below 2). The trace ends
## here at once; the click's own walk follows.
func _cancel_action_for_click() -> void:
	if _action_depth == 0 or _action_depth >= ActionNet.BUSY_DEPTH:
		return
	NetClient.action_cancel()
	_end_trace("a click walk cancelled it", false)

## Push (READ, 0x4ad630): a new action drops a running trace, silently -- a
## cast of Basic_Activity 2, a swing (skill 0), a pick-up. A cast of another
## Activity runs at once and leaves it (0x4ad870). The server drops its own
## copy when the request arrives (trace.go).
func _drop_trace_for_action(skill_id: int, why: String) -> void:
	if _trace.is_empty():
		return
	if skill_id != 0 and _hud_panels != null:
		var reach: Dictionary = _hud_panels.skill_reach(skill_id)
		if int(reach.get("activity", 2)) != 2:
			return
	_action_depth = 0
	_end_trace("%s took its place" % why, true)

## One walker tick (TraceFollow.step) every TICK_MS while a trace runs.
func _step_trace(locked: bool) -> void:
	if _trace.is_empty() or player == null:
		return
	var now := Time.get_ticks_msec()
	if now < int(_trace["next_ms"]):
		return
	_trace["next_ms"] = now + TraceFollow.TICK_MS
	if locked:
		return
	var body = _other_bodies.get(int(_trace["target"]))
	if body == null or not is_instance_valid(body):
		_trace_let_go()
		return
	# The walk's direction (pc+0x24..0x2c): a heading run's own heading
	# (SkyRun.velocity's), a destination walk's line to its point.
	var moving := Vector3.ZERO
	if _has_move_target and _move_heading_run:
		var f := RemoteFacing.facing_of(_move_heading)
		moving = Vector3(f.x, 0.0, f.y)
	elif _has_move_target:
		var d := _move_target - player.global_position
		d.y = 0.0
		if d.length() > 0.001:
			moving = d.normalized()
	var step := TraceFollow.step(player.global_position, (body as Node3D).global_position, moving,
		int(_trace["own_bc"]), int(_trace["target_bc"]), int(_trace["stop"]), int(_trace["restart"]))
	match String(step["do"]):
		"end":
			_trace_let_go()
		"walk":
			_trace_walk(step["point"], true)
		"back":
			_trace_walk(step["point"], false)

## The walker lets go (0x4b03f0): its walk stops; the trace stays, and the
## walker starts again on the next tick (the handler's phase 1, READ).
func _trace_let_go() -> void:
	if bool(_trace.get("walking", false)) and _has_move_target:
		_stop_own_walk()
	_trace["walking"] = false

## The walker's 0x7021 (and, walking forward, its 0x704f [03] after it).
## What the server's move handler refuses goes nowhere (the stun and root
## states, a trade, the pick-up clip, the seat -- the trace ends on a sit).
func _trace_walk(point: Vector3, run: bool) -> void:
	if _own_move_blocked() or _wall_root() != 0 or _player_pickup_clip != null or _sit.sitting:
		return
	_arrow_wait_clear()
	_player_move_order = true
	_move_target = _walkable_point(point)
	_has_move_target = true
	_move_heading_run = false
	_trace["walking"] = true
	_trace_run_due = run
	print("TRACE: %s to (%.1f, %.1f) from (%.1f, %.1f)" % ["walk" if run else "step back", _move_target.x, _move_target.z,
		player.global_position.x, player.global_position.z])

## Retail's walker asks for the run unless the motion state is already RUN
## (slot 63 != 3, READ): here, while the walk mode is on.
func _send_trace_run() -> void:
	if not _trace_run_due:
		return
	_trace_run_due = false
	if _walk_mode and not _motion_locked():
		NetClient.request_motion(ActionCommands.MOTION_RUN)
		print("TRACE: walking -> 0x704f [03], the walker's run")

## Runs an action-window button (ActionCommands.plan). Returns a line for the
## log saying what it did.
func _run_action(action_id: int) -> String:
	var plan := ActionCommands.plan(action_id)
	var kind := String(plan["kind"])
	var what := ""
	if _player_dead and kind != "panel" and kind != "unsupported":
		_log_system(DEAD_INPUT_LINE)
		what = "not run: dead"
	else:
		match kind:
			"sit":
				what = _request_sit_toggle()
			"walk_run":
				what = _request_walk_run()
			"emote":
				what = _request_emote(int(plan["emote"]))
			"auto_attack":
				what = _action_auto_attack()
			"auto_select":
				what = _action_auto_select()
			"exchange":
				what = _action_exchange()
			"stall":
				what = _action_stall()
			"party":
				what = _action_party()
			"auto_get":
				what = _key_pick_up_nearest()
			"trace":
				what = _action_trace()
			"panel":
				what = _run_panel_key("panel:" + String(plan["panel"]))
			"unsupported":
				_log_system(String(plan["line"]))
				what = "not available: " + String(plan["line"])
			_:
				what = "no such action"
	print("ACTION %d (%s): %s" % [action_id, kind, what])
	return what

## Walk/Run (0x9d4a00, READ): 0x704f [02] while running, [03] while walking.
## Nothing changes until the server answers (0x30BF kind 1, _apply_walk_mode).
## Not while sitting or in a sit transition: the server refuses both
## (FUN_004b1480's case 2/3 needs STAND, WALK or RUN).
func _request_walk_run() -> String:
	if not NetClient.is_connected_to_server():
		return "not sent (not connected)"
	if _sit.sitting or _motion_locked():
		return "not sent (%s)" % ("seated" if _sit.sitting else "a motion change is in flight")
	var value := ActionCommands.walk_run_request(not _walk_mode)
	NetClient.request_motion(value)
	return "0x704f [%02x] sent (%s)" % [value, "walk" if value == ActionCommands.MOTION_WALK else "run"]

## An emote (0x793b00's 4000..4006, READ): 0x3091 [byte]. The body plays it on
## the server's answer (_on_emote_received), as retail's does.
func _request_emote(emote: int) -> String:
	if not NetClient.is_connected_to_server():
		return "not sent (not connected)"
	NetClient.request_emote(emote)
	return "0x3091 [%02x] sent" % emote

## Auto Attack (0x793b00 case 0x3ea, READ): the object click 0x792f00 on the
## selection. A selected monster is attacked; anything else does nothing, as
## the click on a player does nothing more than select.
func _action_auto_attack() -> String:
	var id := _last_attack_target
	if id < 0 or not _monster_bodies.has(id) or _dying_until.has(id):
		return "no monster selected"
	_attack_monster(id)
	return "attacks monster %d" % id

## Auto Select (0x9d3340, READ): the nearest monster strictly within 70.0
## (3-D), selected as a click selects it (the ring, the target window). That
## the engine's list 0xec4d50 is the monsters is INFERRED (the selection the
## click would make; its entries' flag bit is not read).
func _action_auto_select() -> String:
	if player == null:
		return "no player"
	var candidates := {}
	for id in _monster_bodies:
		var body = _monster_bodies[id]
		if body == null or not is_instance_valid(body) or _dying_until.has(int(id)):
			continue
		candidates[int(id)] = (body as Node3D).global_position
	var pick := ActionCommands.nearest_within(player.global_position, candidates)
	if pick < 0:
		return "no monster within %.0f" % ActionCommands.AUTO_SELECT_RANGE
	_last_attack_target = pick
	_show_target(pick)
	_ring_on_monster(pick)
	return "selected monster %d (%.1f away)" % [pick, player.global_position.distance_to(candidates[pick])]

## Exchange (SendTradeMsg_081(0), READ): exchange_request for the
## selection.
func _action_exchange() -> String:
	return exchange_request(_selected_character)

## Stall (0x793b00 case 0x3f1, READ): a job suit refuses it (category 10,
## 0x3c3b), the alchemy window (category 0x12, 0x5416); then the avatar
## stall's question or the title box (StallController.start). The +0x7bc
## refusal (0x1834) is not made: what sets that byte is OPEN (exchange.md).
func _action_stall() -> String:
	if _hud_panels == null or not NetClient.is_connected_to_server():
		return "not connected"
	if _own_job_state() != JobPvpNet.STATE_NONE:
		_hud_panels.stall_code_message(0x3c3b)
		return "refused: a job suit"
	if _hud_panels.alchemy_window() != null and _hud_panels.alchemy_window().visible:
		_log_system(_resolve_any_text("UIIT_MSG_REINFORCERR_CANNOT_OPEN_FLEAMARKET", ""), HudSystemMessage.TYPE_GAME)
		return "refused: the alchemy window is open"
	return _hud_panels.start_stall()

