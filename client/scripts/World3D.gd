# OPENSRO_QA_PARTY (round 711): "<tick>:<step>;..." -- each step at its tick
# through the same controls a player uses (the party pane's buttons, the
# settings dialog, the invitation box's buttons). See the QA block above.
var _qa_party_answer := ""

func _qa_party_step(spec: String) -> void:
	PartyMatchQa.tick(_hud_panels)
	for part in spec.split(";", false):
		var colon := part.find(":")
		if colon < 0 or not part.substr(0, colon).is_valid_int():
			if _qa_tick == 70:
				printerr("QA PARTY: bad step '%s' (want <tick>:<step>)" % part)
			continue
		if int(part.substr(0, colon)) != _qa_tick:
			continue
		var step := part.substr(colon + 1)
		print("QA PARTY: tick %d %s" % [_qa_tick, step])
		_qa_party_do(step)

func _qa_party_do(step: String) -> void:
	if _hud_panels == null:
		return
	var arg := step.substr(step.find(":") + 1) if step.contains(":") else ""
	var verb := step.substr(0, step.find(":")) if step.contains(":") else step
	match verb:
		"window":
			_hud_panels.open("party")
		"settings":
			_hud_panels.open("party")
			if _hud_panels.party_pane != null:
				_hud_panels.party_pane.press_set()
		"set":
			var v := arg.split(",")
			_hud_panels.open("party")
			var dlg := _hud_panels.open_party_settings()
			if dlg != null and v.size() == 3:
				dlg.choose("exp", 0 if v[0] == "1" else 1)
				dlg.choose("item", 0 if v[1] == "1" else 1)
				if dlg.anyone_box != null:
					dlg.anyone_box.button_pressed = v[2] == "1"
				dlg.press_yes()
		"invite":
			var found := false
			for id in _other_bodies:
				var b = _other_bodies[id]
				if b != null and is_instance_valid(b) and String((b as Node).get_meta("character_name", "")) == arg:
					found = true
					_select_character(int(id), arg)
			if not found:
				print("QA PARTY: no spawned player named %s" % arg)
				return
			_hud_panels.open("party")
			if _hud_panels.party_pane != null:
				_hud_panels.party_pane.press_invite()
		"accept", "refuse":
			_qa_party_answer = verb
			_qa_party_answer_pending()
		"leave":
			_hud_panels.open("party")
			if _hud_panels.party_pane != null:
				_hud_panels.party_pane.press_dismiss()
		"kick":
			_hud_panels.open("party")
			var pane := _hud_panels.party_pane
			if pane == null:
				return
			var rows := NetClient.party.row_members()
			for i in rows.size():
				if rows[i].member_name == arg:
					var btn := pane.row_node(i, "GDR_PTYSLOT_BTN_EXITFROMPARTY") as BaseButton
					if btn != null:
						btn.pressed.emit()
		# Round 715, the party member boxes: a box clicked through its own
		# handler, the player selected, the lock pressed, and a log line with
		# every box's screen rect (for a real click aimed at one).
		"qpclick":
			if _hud_quick_party == null:
				return
			for i in _hud_quick_party.slot_count():
				var s := _hud_quick_party.slot(i)
				if s.member_name == arg:
					_hud_quick_party.click_slot(s)
		"selfselect":
			_select_self()
		"qplock":
			if _hud_quick_party != null:
				_hud_quick_party.toggle_lock()
		"maplog":
			var here_l := _party_here_local
			var inputs: PackedStringArray = []
			for m in NetClient.party.members:
				var b := _party_body_for_board(m.jid) as Node3D
				var bl := Vector3.INF
				if b != null and _dungeon != null:
					bl = DungeonWorld.to_dungeon(b.global_position)
				elif b != null and _minimap_group != null:
					bl = _minimap_group.to_local(b.global_position)
				inputs.append("%s(r%d/%d x%d z%d w%d body%s)" % [m.member_name, (m.region >> 8) & 0xFF, m.region & 0xFF,
					m.x, m.z, m.world_id, "(%.0f,%.0f)" % [bl.x, bl.z] if b != null else "-"])
			print("QA PARTY: map inputs here r%s local (%.0f,%.0f) tile_px %.1f: %s mini %s world %s" % [
				str(_minimap_region), here_l.x, here_l.z, _hud_minimap.tile_px() if _hud_minimap != null else -1.0,
				" ".join(inputs), str(_party_marks_mini), str(_party_marks_regions) + " " + str(_party_marks_pos)])
			print("QA PARTY: map marks minimap [%s] world map [%s] hover '%s'" % [
				_hud_minimap.party_marks_report() if _hud_minimap != null else "",
				_hud_worldmap.party_dots_report() if _hud_worldmap != null else "",
				_hud_worldmap.party_hover_text() if _hud_worldmap != null else ""])
		"wmap":
			if _hud_worldmap != null and not _hud_worldmap.visible:
				_hud_worldmap.open()
		"qplog":
			if _hud_quick_party != null:
				print("QA PARTY: quick party %s; player block glow %s, leader flag %s" % [_hud_quick_party.describe(),
					_hud_player_info.is_selected_shown() if _hud_player_info != null else false,
					_hud_player_info.is_leader_flag_shown() if _hud_player_info != null else false])
		_:
			# The party-matching steps (round 714): PartyMatchQa.
			if not PartyMatchQa.do(_hud_panels, verb, arg):
				printerr("QA PARTY: unknown step '%s'" % step)

## Presses the invitation box's Accept or Refuse when the QA run asked for
## one and a box is up.
func _qa_party_answer_pending() -> void:
	if _qa_party_answer == "" or _hud_panels == null:
		return
	var box := _hud_panels.get_node_or_null("PartyInvitation")
	if box == null:
		return
	var btn := box.find_child("GDR_MBIN_BTN_OK" if _qa_party_answer == "accept" else "GDR_MBIN_BTN_CANCEL", true, false) as BaseButton
	if btn != null:
		print("QA PARTY: pressing %s on the invitation" % _qa_party_answer)
		_qa_party_answer = ""
		btn.pressed.emit()

# --- The guild state ----------------------------------------------------------
#
# What the guild replies leave for the rest of the client (the guild NPC's
# talk lines, the level-up's system lines). The guild window draws the guild
# itself (HudPanels, rounds 822-844); round 848 removed the prototype's Guild
# tab (its member list, status line and Level Up button).

## Forgets the guild points and level shown, when the guild they belong to is
## gone or replaced (rounds 525, 528).
func _clear_guild_points() -> void:
	_guild_gathered_sp = -1
	_guild_donations = {}
	_guild_level = 0
	_guild_max_members = 0
	_guild_next_gold = 0
	_guild_next_gp = 0

## A guild reply (info, join or create). A success also records the player's
## guild state for the guild NPC's talk lines (round 521): the id (0 = none),
## and whether the player is the master -- the member with the player's name
## holding ROLE_LEADER. The name test mirrors the real client's, which
## compares the player's name with the guild's (FUN_00989ce0; see
## NpcServiceReader.guild_services). An error leaves the state as it was.
func _on_guild_result(result: GuildNet.Result) -> void:
	if result == null:
		return
	if result.error != "":
		print("World3D: guild reply refused: %s" % result.error)
		# Round 800: 0x4c56 UIIT_CTL_GUILD_JOIN_JOB_ERROR and the like.
		if result.error.begins_with("UIIT_"):
			_log_system(_resolve_any_text(result.error, result.error))
		return
	if result.guild_id != _guild_id:
		_clear_guild_points()
	_guild_id = result.guild_id
	_guild_master = false
	for m in result.members:
		if m.member_name == NetClient.current_character_name and m.role == GuildNet.ROLE_LEADER:
			_guild_master = true
	if result.guild_id == 0:
		_guild_roster = null
	else:
		_guild_roster = result
		# The points ride on their own reply (round 525): OpGuildPoints, and
		# the level on another (round 528): OpGuildLevel, a report only.
		NetClient.guild_points(NetClient.current_character_name)
		NetClient.guild_level(NetClient.current_character_name, false)
	_refresh_open_talk_menu()

## A guild points reply (round 525): the guild's GatheredSP and each member's
## GP_Donation, which the server credits from members' skill points
## (GObjPC_GainExpAndLevel 0x4e5250 -> CGuild::AddPoints 0x5c4110). A reply
## for a guild this client no longer shows, or a refusal, changes nothing:
## the guild reply is what sets the guild state.
func _on_guild_points_result(result: GuildNet.PointsResult) -> void:
	if result == null or result.error != "":
		return
	if _guild_roster == null or result.guild_id != _guild_id:
		return
	_guild_gathered_sp = result.gathered_sp
	_guild_donations = {}
	for m in result.members:
		_guild_donations[m.member_name] = m.gp_donation

## A guild level reply (round 528): a report of the level and the next
## level's cost, or a level-up's outcome. A refusal carrying an engine code is
## a level-up the server refused in CGuild::HandleLevelUp's order (dead,
## guildless, not the master, level 5, gold, guild points); it goes to the
## system window in the game's own words where ErrorText has them, else the
## server's. Any other refusal is printed only (the prototype's Guild tab
## showed it until round 848). A reply for a guild this client no longer
## shows changes nothing. A level-up spends gold and guild
## points and the server pushes neither, so a success re-reads the purse and
## the points.
func _on_guild_level_result(result: GuildNet.LevelResult) -> void:
	if result == null:
		return
	if result.error != "":
		var line: String = ErrorText.guild_level_up_line(result.code, _ui_text_table, result.error)
		print("World3D: guild level refused (code 0x%x): %s" % [result.code, line])
		if result.code != 0:
			_log_system("Could not level up the guild: %s" % line)
		return
	if _guild_roster == null or result.guild_id != _guild_id:
		return
	_guild_level = result.level
	_guild_max_members = result.max_members
	_guild_next_gold = result.next_gold
	_guild_next_gp = result.next_gp
	if result.levelled_up:
		_log_system("The guild reached level %d; it can now hold %d members." % [result.level, result.max_members])
		_request_world_stats()
		NetClient.guild_points(NetClient.current_character_name)

## Founding a guild costs 500,000 gold on the server (round 487: the create
## job's reply, trs_sm_guildjob::FUN_005c8bf0 -> GObjPC::FUN_004e4140), which
## pushes no gold update, so a success re-reads the purse the way a shop buy
## does -- the HUD's gold readout follows character_stats_result. The result
## goes to chat too (round 521): the talk box's create line has no other
## place to show it, and the server's refusals (the name, level and gold
## gates of rounds 481/487) are the useful part.
func _on_guild_create_result(result: GuildNet.Result) -> void:
	_on_guild_result(result)
	if result == null:
		return
	if result.error == "" and result.guild_id != 0:
		_log_system("Guild %s founded." % result.guild_name)
		_request_world_stats()
	elif result.error.begins_with("UIIT_"):
		# Round 800: a job suit refuses the founding with the client's own
		# message (0x4c57 UIIT_CTL_GUILD_CREATE_JOB_ERROR).
		_log_system(_resolve_any_text(result.error, result.error))
	elif result.error != "":
		_log_system("Could not found the guild: %s" % result.error)

## A leave reply. Success leaves the player guildless (round 521), so a guild
## NPC's open talk menu turns to the create line. A refusal means the state
## this client held may be stale -- the server's "not in a guild" is exactly
## that -- so it asks for the guild again, and the info reply
## (_on_guild_result) sets the state and the menu right.
func _on_guild_leave_result(ok: bool, reason: String) -> void:
	if ok:
		_guild_id = 0
		_guild_master = false
		_guild_roster = null
		_clear_guild_points()
		_log_system("Left the guild.")
	else:
		_log_system("Leave failed: %s" % reason)
		if NetClient.is_connected_to_server():
			NetClient.guild_info(NetClient.current_character_name)
	_refresh_open_talk_menu()

# --- The duel (OpenSRO's own; DuelNet) ------------------------------------------
#
# OURS throughout: the duel is the prototype's (server/internal/duel), not the
# original's, and its only way in was the native Duel tab until round 848.
# It is now the console's /duel (Console: /duel <name>, /duel accept,
# /duel decline, /duel hit), and its answers are system lines in the
# original's system message window -- the tab's own wording.

## The console's /duel: "challenge" with a name, "accept", "decline" or "hit".
func duel_command(verb: String, arg: String = "") -> void:
	match verb:
		"challenge":
			if arg.strip_edges() == "":
				_log_system("Usage: /duel <name>")
				return
			NetClient.duel_challenge(NetClient.current_character_name, arg.strip_edges())
		"accept", "decline":
			if _pending_duel_challenger.is_empty():
				_log_system("No pending duel challenge to answer.")
				return
			NetClient.duel_respond(NetClient.current_character_name, _pending_duel_challenger, verb == "accept")
			_pending_duel_challenger = ""
		"hit":
			NetClient.duel_attack(NetClient.current_character_name)

func _on_duel_challenge_result(ok: bool, reason: String) -> void:
	_log_system("Duel challenge sent." if ok else "Duel challenge failed: %s" % reason)

func _on_duel_invite(invite: DuelNet.Invite) -> void:
	if invite == null:
		return
	_pending_duel_challenger = invite.challenger_name
	_log_system("%s challenges you to a duel. Type /duel accept or /duel decline." % invite.challenger_name)

func _on_duel_respond_result(ok: bool, reason: String) -> void:
	if not ok:
		_log_system("Duel answer failed: %s" % reason)

func _on_duel_started(started: DuelNet.Started) -> void:
	if started == null:
		return
	_log_system("Dueling %s! /duel hit attacks." % started.opponent_name)

func _on_duel_declined(declined: DuelNet.Declined) -> void:
	if declined == null:
		return
	_log_system("%s declined your duel challenge." % declined.target_name)

func _on_duel_attack_result(result: DuelNet.AttackResult) -> void:
	if result == null:
		return
	if result.error != "":
		_log_system("Duel blow failed: %s" % result.error)
	elif result.opponent_died:
		_log_system("Hit for %d -- you won the duel!" % result.damage)
	else:
		_log_system("Hit for %d (opponent HP %d)." % [result.damage, result.opponent_hp])

func _on_duel_opponent_damaged(damaged: DuelNet.OpponentDamaged) -> void:
	if damaged == null:
		return
	_log_system("Took %d damage in the duel (HP %d)." % [damaged.damage, damaged.remaining_hp])

func _on_duel_ended(ended: DuelNet.Ended) -> void:
	if ended == null:
		return
	_log_system("The duel is over -- %s won." % ended.winner_name)

# --- The exchange (round 834) --------------------------------------------------
#
# Retail's exchange (ExchangeNet; docs/protocol/exchange.md and its review
# exchange_verify.md). The window, its boxes and the inventory's part are
# HudPanels' (ExchangeController); this keeps the state the world needs.

## An exchange is established (0xB081 {1} / 0x3085 until 0x3087 / 0x3088):
## the server refuses a move meanwhile (round 749's verification; trade.Hub.
## Established, INTERACTMODE 2), so the client sends none.
var _trade_established := false

## SendTradeMsg_081 (c:0x81d790), in its order: the alchemy window up
## refuses it (category 0x12, 0x5419); the selection is the target; the
## exchange already up or an NPC talk open (GI+0x508 / +0x7b4) sends nothing;
## no player, or this one, sends nothing; then the request-pending flag, the
## system line UIIT_MSG_DEAL_ASKING (type 5) and 0x7081. The +0x7bc refusal
## (0x1834) is not made: what sets that byte is OPEN (exchange.md OPEN 1).
func exchange_request(target_id: int) -> String:
	if _hud_panels != null and _hud_panels.alchemy_window() != null and _hud_panels.alchemy_window().visible:
		_log_system(_resolve_any_text("UIIT_MSG_REINFORCERR_CANNOT_TRADE", ""), HudSystemMessage.TYPE_GAME)
		return "refused: the alchemy window is open"
	if _trade_established or (_hud_panels != null and (_hud_panels.exchange_mode() or _hud_panels.is_open("npctalk"))):
		return "busy"
	if target_id < 0 or target_id == _own_id() or not _other_bodies.has(target_id):
		return "no player selected"
	var body = _other_bodies[target_id]
	var who := String((body as Node).get_meta("character_name", "")) if body != null and is_instance_valid(body) else ""
	var fmt := _resolve_any_text("UIIT_MSG_DEAL_ASKING", "")
	if fmt != "":
		_log_system(fmt.replace("%s", who), HudSystemMessage.TYPE_GAME)
	NetClient.exchange_request(target_id)
	return "exchange requested with %s" % who

## 0x3080 kind 1 (c:0x88aa60 case 1): dropped unless the asker is a player
## spawned here; otherwise the box (HUD request kind 7).
func _on_exchange_requested(asker_id: int) -> void:
	if not _other_bodies.has(asker_id):
		print("EXCHANGE: request from %d, not spawned here -- dropped (c:0x88aa60)" % asker_id)
		return
	var body = _other_bodies[asker_id]
	var who := String((body as Node).get_meta("character_name", "")) if body != null and is_instance_valid(body) else ""
	if _hud_panels != null:
		_hud_panels.show_exchange_request(asker_id, who)

func _on_exchange_request_result(ok: bool, value: int) -> void:
	if ok:
		_open_exchange(value)
	elif _hud_panels != null:
		_hud_panels.exchange_code_message(value)

func _on_exchange_started(asker_id: int) -> void:
	_open_exchange(asker_id)

## The window opens on both sides (CIFExchange::FUN_007b2530(1)).
func _open_exchange(partner_id: int) -> void:
	_trade_established = true
	if _hud_panels == null:
		return
	# The headers (c:0x7b2d00): the name and guild of each side; a player
	# out of the normal state (vslot 0xac != 4; the job suit, INFERRED) is
	# written "*name" with no guild.
	var body = _other_bodies.get(partner_id)
	var uid := partner_id & 0xffffffff
	var partner := {"id": partner_id, "name": "", "guild": String(NetClient.user_guilds.get(uid, {}).get("guild_name", "")),
		"normal": int(NetClient.user_jobs.get(uid, {}).get("state", UserSpawnNet.JOB_STATE_NONE)) == UserSpawnNet.JOB_STATE_NONE}
	if body != null and is_instance_valid(body):
		partner["name"] = String((body as Node).get_meta("character_name", ""))
	var own := {"id": _own_id(), "name": NetClient.current_character_name,
		"guild": String(NetClient.own_guild_line.get("guild_name", "")), "normal": _own_job_state() == UserSpawnNet.JOB_STATE_NONE}
	_hud_panels.open_exchange(partner, own)
	_exchange_portraits(partner_id)

## Round 836 (the portraits, OURS layout; HudPanels.set_exchange_portrait):
## both bodies as the world draws them, copied, playing their stand clip --
## retail clones each model with its equipment and plays animation type 0
## on the clone (c:0x7b2a20: 0xa61c30, then vt+0xc(0, ...)), stepped every
## frame by the window's tick (round 841, PlayerPortrait.animate).
func _exchange_portraits(partner_id: int) -> void:
	if _hud_panels == null or not _hud_panels.exchange_window_full():
		return
	var light: Array = _portrait_zone_light if _portrait_zone_light.size() == 2 else []
	if _player_skeleton != null and is_instance_valid(_player_skeleton):
		var group := _weapon_group_for(_player_look_last.worn, _player_body)
		_hud_panels.set_exchange_portrait(true, _exchange_body_copy(_player_skeleton),
			_body_animation_for(_player_body, BsrReader.AnimationEntry.TYPE_STAND, group), light)
	var node = _other_bodies.get(partner_id)
	if node == null or not is_instance_valid(node):
		return
	var found := (node as Node).find_children("*", "Skeleton3D", true, false)
	var skel: Skeleton3D = found[0] as Skeleton3D if not found.is_empty() else null
	var body := String((node as Node).get_meta("body", ""))
	if skel != null:
		body = String(skel.get_meta("body", body))
		_hud_panels.set_exchange_portrait(false, _exchange_body_copy(skel),
			_body_animation_for(body, BsrReader.AnimationEntry.TYPE_STAND, String(skel.get_meta("weapon_group", "default"))), light)
	elif _other_build_args.has(partner_id) and body != "":
		# Not dressed yet (drawn as a ghost or queued): dressed here from its
		# look. Round 847: with its pluses and a switched item's own id, as
		# its body will be dressed (before, from the spawn's items alone: no
		# glow).
		var look := _other_look(partner_id)
		var built := _build_assembled_character(look, body)
		if built != null:
			_hud_panels.set_exchange_portrait(false, built,
				_body_animation_for(body, BsrReader.AnimationEntry.TYPE_STAND, _weapon_group_for(look.worn, body)), light)

## A copy of a dressed body for a picture, as the player block's portrait
## takes one (_refresh_player_portrait): its cloth back on its own skin and
## no particle effects (a still picture would hold one frame of them).
func _exchange_body_copy(skel: Skeleton3D) -> Skeleton3D:
	var copy := skel.duplicate() as Skeleton3D
	if copy == null:
		return null
	ClothDriver.clean_copy(copy)
	EquipGlow.strip_particles(copy)
	return copy

func _on_exchange_closed(code: int) -> void:
	_trade_established = false
	if _hud_panels != null:
		_hud_panels.exchange_closed(code)

# --- Friends (round 834) ------------------------------------------------------
#
# The messenger's friend list on the retail wire (FriendNet,
# docs/protocol/friends.md). READ, sro_client.exe:
#   - every ask (the Add box c:0x5a7920, the target menu's 17 c:0x60a2d0,
#     /invite and /friend c:0x7af513) sends 0x7302 and sets the friend
#     pane's flag +0x790 to 1; an incoming request (c:0x886000) sets it to 2
#     and queues box 0x23; its answer sets it back to 0 (c:0x798a00);
#   - 0xB302 (c:0x885e50): 0x640b reason 0 puts UIIT_MSG_FRIENDERR_REFUSAL on
#     the warning banner whoever we are; reason 2 puts UIIT_MSG_FRIEND_
#     SYSCANCEL there with the flag at 1, or closes box 0x23 with it at 2;
#     any other code goes through 0x778190(0x13, code) -- the banner
#     (0x7b9124 -> 0x77b580, GDR_WARNING_WND) for the codes the switch
#     names (c:0x7baad7); the flag is then 0, whatever came;
#   - 0x3B07 kind 4: UIIT_MSG_FRIEND_CONNECT / _DISCONNECT with the friend's
#     name, not for our own name (c:0x592e00); kind 2 opens box 0x22.

## The friend pane's +0x790: 1 after our ask, 2 while a request box is up.
var _friend_flag := 0

## Asks `target_name` to be friends (0x7302), from every place the client
## sends it. An empty name or our own sends nothing (the Add box's test,
## c:0x5a7840).
func friend_ask(target_name: String) -> void:
	var who := target_name.strip_edges()
	if who == "" or who == NetClient.current_character_name:
		return
	NetClient.friend_ask(who)
	_friend_flag = 1

func _on_friend_requested(request: FriendNet.Request) -> void:
	_friend_flag = 2
	if _hud_panels != null:
		_hud_panels.show_friend_request(request)

## The request box's answer (HudPanels): 0x3303, and the flag back to 0.
func friend_answer(request: FriendNet.Request, accept: bool) -> void:
	if request == null:
		return
	NetClient.friend_answer(request.job, request.asker_jid, accept)
	_friend_flag = 0

func _on_friend_failed(failure: FriendNet.Failure) -> void:
	print("FRIEND failed code 0x%x reason %d '%s' (flag %d)" % [failure.code, failure.reason, failure.name, _friend_flag])
	if failure.code == FriendNet.CODE_REFUSED:
		if failure.reason == FriendNet.REASON_REFUSED:
			_friend_banner("UIIT_MSG_FRIENDERR_REFUSAL")
		elif failure.reason == FriendNet.REASON_TIMEOUT:
			if _friend_flag == 1:
				_friend_banner("UIIT_MSG_FRIEND_SYSCANCEL")
			elif _friend_flag == 2 and _hud_panels != null:
				_hud_panels.close_friend_request()
	else:
		_friend_banner(String(FriendNet.CODE_TEXTS.get(failure.code, "")))
	_friend_flag = 0

func _on_friend_delete_result(ok: bool, value: int) -> void:
	print("FRIEND delete %s %d" % ["ok" if ok else "refused", value])
	if not ok:
		_friend_banner(String(FriendNet.CODE_TEXTS.get(value, "")))

func _on_friend_pushed(push: FriendNet.Push) -> void:
	match push.kind:
		FriendNet.PUSH_ADDED:
			if _hud_panels != null:
				_hud_panels.show_friend_added(push.friend_name, NetClient.current_character_name)
		FriendNet.PUSH_STATE:
			var who := FriendNet.name_of(NetClient.last_friend_list, push.character_id)
			if who == "" or who == NetClient.current_character_name:
				return
			var key := "UIIT_MSG_FRIEND_CONNECT" if push.state == FriendNet.STATE_ONLINE else "UIIT_MSG_FRIEND_DISCONNECT"
			var fmt := _resolve_any_text(key, "")
			if fmt != "":
				_log_system(fmt.replace("%s", who) if fmt.contains("%s") else fmt, HudSystemMessage.TYPE_ALWAYS)

## A friend message on the warning banner (0x77b580), or nothing for a key
## the client has none for.
func _friend_banner(key: String) -> void:
	if key == "":
		return
	var t := _resolve_any_text(key, "")
	if t == "":
		print("World3D: friend message %s is not in the text table" % key)
		return
	_show_banner("friend", t)

## Applies a consumable's effect to the HUD. The restored amounts are the
## game's own (the item table's Param block), so the message reports what the
## player actually got back, which is capped at what was missing.
func _on_use_item_result(result) -> void:
	if result == null:
		return
	# A potion's success sounds snd_potion (0xb04c's handler, read; UiSounds).
	UiSounds.use_replied(result.error == "")
	if result.error != "":
		# Logged, so a tester's log shows every refusal (composite review).
		print("World3D: use item refused: %s (code 0x%x)" % [result.error, result.code])
		_skin_sent = []
		# A refusal with an engine code (round 778: the scrolls') is the
		# archive's own category-1 message (ErrorText.scroll_line).
		var refused_line: String = ErrorText.scroll_line(result.code, _ui_text_table, result.error) if result.code != 0 else result.error
		# Round 862 (READ, ErrorText.SCROLL_BANNER_CODES): some codes raise
		# the warning banner as well, as the original does.
		if ErrorText.scroll_banner(result.code):
			_show_banner("warning", refused_line)
		_log_system(refused_line)
		return
	# Round 826: its re-use timers.
	_arm_item_cooldowns(result)
	# Round 838: an accepted skin change puts the body on at the warp.
	if not _skin_sent.is_empty() and _hud_panels != null and result.item_id != 0 \
			and HudPanels.is_skin_change_item(_hud_panels.item_types(result.item_id)):
		_skin_pending = _skin_sent
		_skin_sent = []
		print("SKIN accepted: model %d at the warp" % int(_skin_pending[0]))
	# Round 838: the Nasrun extension's accepted use (Item_OnUseItemResult
	# case 0x10, c:0x87b047) prints UIIT_MSG_NASRUN_AWAKE_RENEW.
	if result.item_id != 0 and _hud_panels != null:
		var ut := _hud_panels.item_types(result.item_id)
		if ut.size() >= 4 and ut[0] == 3 and ut[1] == 3 and ut[2] == 13 and ut[3] == 16:
			_log_system(_resolve_any_text("UIIT_MSG_NASRUN_AWAKE_RENEW", "Awaken period is extended."), HudSystemMessage.TYPE_GAME)
	# Round 844 lane G part 2: the recall scroll's accepted use (c:0x87b0ca):
	# UIIT_MSG_GUILD_RECALL_CONFIRM.
	if result.item_id != 0 and _hud_panels != null and HudPanels.is_guild_recall_item(_hud_panels.item_types(result.item_id)):
		_log_system(_resolve_any_text("UIIT_MSG_GUILD_RECALL_CONFIRM", "Recall has been requested to all guild members."), HudSystemMessage.TYPE_GAME)
	# Round 824: a crest item's accepted use opens its result box.
	if result.item_id != 0 and _hud_panels != null:
		var code := _hud_panels.item_code_for_id(result.item_id)
		if HudPanels.CREST_ITEM_BOXES.has(code):
			_hud_panels.crest_used(code)
		# Round 838: the repair hammer's mended items arrive as 0x3052s; a
		# piece mended from broken counts again, so the doll and the stats
		# are asked for (OURS: retail's ChangeItemDurability pushes them).
		if HudPanels.is_repair_hammer(_hud_panels.item_types(result.item_id)) and NetClient.current_character_name != "":
			print("World3D: the repair hammer mended the worn and carried items")
			NetClient.list_equipment(NetClient.current_character_name)
			NetClient.character_stats(NetClient.current_character_name)
	# Round 786: every accepted use is logged with what it left, so a run
	# (the auto potion's QA) reads the count and the pools from the log.
	print("World3D: use item ok: %d left, HP %d/%d, MP %d/%d, restored %d HP %d MP" % [result.remaining,
		result.hp, result.max_hp, result.mp, result.max_mp, result.restored_hp, result.restored_mp])
	if result.cast_ms > 0:
		# An accepted scroll (round 778): the move follows when its delay
		# runs out, as an OpChangeZoneResult this client did not ask for.
		print("World3D: scroll accepted -- moving in %d ms" % result.cast_ms)
		# Round 779: the casting bar, kind 0 (Item_OnUseItemResult's cases 1
		# and 3 -> FUN_007b15a0(0, ref)), from the item's own row.
		if _hud_panels != null:
			_hud_panels.open_cast_bar(result.item_id, result.cast_ms)
	if result.max_hp > 0:
		_own_hp_told()
	if _hud_player_info != null:
		if result.max_hp > 0:
			_hud_player_info.set_hp(result.hp, result.max_hp)
			_last_enter_world_max_hp = result.max_hp
		if result.max_mp > 0:
			_hud_player_info.set_mp(result.mp, result.max_mp)
	var parts: Array[String] = []
	if result.restored_hp > 0:
		parts.append("%d HP" % result.restored_hp)
	if result.restored_mp > 0:
		parts.append("%d MP" % result.restored_mp)
	if not parts.is_empty():
		_log_system("Recovered %s." % " and ".join(parts))
	# A berserk potion (round 632) fills the orbs instead of the bars.
	if result.has_berserk:
		print("World3D: berserk potion: gauge %d, active %s" % [result.berserk_gauge, str(result.berserk_active)])
		if _hud_player_info != null:
			_hud_player_info.set_berserk(result.berserk_gauge, result.berserk_active)
	# The stack shrank, so redraw the bag.
	if NetClient.current_character_name != "":
		NetClient.list_inventory(NetClient.current_character_name)

## Round 859: retail's 0x305C (NetClient.item_use_effect): a player in view --
## this one too, the server tells the user -- used an item, accepted. The
## item's use effect plays on that body as 0x305C's handler (c:0x8735d0)
## plays it (ItemUseEffect: which effect, how it plays; READ).
func _on_item_use_effect(uid: int, ref_id: int) -> void:
	var body: Node3D = null
	var who := "uid %d (not drawn)" % uid
	if NetClient.own_character_id >= 0 and uid == (NetClient.own_character_id & 0xffffffff):
		body = player
		who = "self"
	else:
		var id := _other_by_uid(uid)
		if id >= 0:
			body = _fx_owner_body(id, SkillNet.OWNER_CHARACTER)
			who = "character:%d" % id
	var row: ItemTableReader.Item = _item_rows.get(ref_id)
	var types := row.type_ids if row != null else PackedInt32Array()
	var code := row.code_name if row != null else ""
	if _automob_ref == -2:
		_automob_ref = -1
		for id in _item_rows:
			if (_item_rows[id] as ItemTableReader.Item).code_name == ItemUseEffect.AUTOMOB_CODE:
				_automob_ref = int(id)
				break
	var effect := ItemUseEffect.effect_id(types, code, ref_id, _automob_ref, ItemUseEffect.use_rows(), ItemUseEffect.knows)
	if effect == ItemUseEffect.FIREWORK and body != null and is_instance_valid(body):
		_set_off_firework(ref_id, code, body, who)
		return
	if body == null or not is_instance_valid(body):
		print("ITEMUSE uid %d item %d %s %s: %s, no body drawn" % [uid, ref_id, code, str(types), effect if effect != "" else "no effect"])
		return
	var got := ItemUseEffect.play(effect, body, "%s used %s" % [who, code])
	var parts := PackedStringArray()
	var started := Time.get_ticks_msec()
	var started_frame := Engine.get_frames_drawn()
	for fx in got["fx"]:
		var e := fx as EfpEffect
		parts.append("%s@%s" % [e.path, e._follow_bone_name if e._follow_bone_name != "" else "none"])
		# QA: each effect's lifetime, from its start to its end.
		e.effect_finished.connect(func() -> void:
			print("ITEMUSE effect %s on %s ended after %d ms (%d frames)" % [e.path, who, Time.get_ticks_msec() - started,
				Engine.get_frames_drawn() - started_frame]), CONNECT_ONE_SHOT)
	print("ITEMUSE uid %d item %d %s %s on %s: effect %s, %d effect(s) [%s], sound(s) [%s] (frame %d)" % [uid, ref_id, code,
		str(types), who, effect if effect != "" else "none", (got["fx"] as Array).size(), ", ".join(parts),
		", ".join(got["sounds"]), Engine.get_frames_drawn()])

## Round 860: a firework (3/3/6) -- the original's CIParticleObj (Firework has
## the reading): the item's drop model where the user stands, turned as the
## user is, and its bursts from 8 above it every 2 s.
func _set_off_firework(ref_id: int, code: String, body: Node3D, who: String) -> void:
	var path: String = _item_drop_models.get(ref_id, "")
	var model: Node3D = null
	var archive := _data_pk2 if _data_pk2 != null else _open_pk2_if_set()
	if archive != null and path != "":
		if not path.to_lower().begins_with("res\\"):
			model = ObjectLoader.load_object(archive, "res\\" + path)
		if model == null:
			model = ObjectLoader.load_object(archive, path)
	var fwd := body.global_transform.basis.z
	var yaw := atan2(fwd.x, fwd.z) if Vector2(fwd.x, fwd.z).length() > 0.001 else 0.0
	var fw := Firework.make(code, model, body.global_position, yaw)
	if fw == null:
		print("ITEMUSE firework %d %s by %s: no rows, nothing made" % [ref_id, code, who])
		return
	var parent: Node = other_entities if other_entities != null else self
	parent.add_child(fw)
	print("ITEMUSE firework %d %s by %s: model %s %s at %s" % [ref_id, code, who, path,
		"drawn" if model != null else "missing", fw.global_position])

# --- Round 860: the guild war mark (GuildWarMark has the READ) -----------------

## uid -> AuraModel: the marks drawn.
var _war_marks := {}
var _war_mark_row := {}

## FUN_009ddb00 over every body this client draws, the own player too.
func _update_war_marks() -> void:
	if _war_mark_row.is_empty():
		_war_mark_row = GuildWarMark.row()
		if _war_mark_row.is_empty():
			return
		AuraModel.star_height_of = func(host: Node3D) -> float: return _star_height_of(host)
	var seen := {}
	# The model's archive (Data.pk2), as a cast's .bsr objects open it.
	if BsrEffect.archive == null:
		_deco_archive()
	if player != null and is_instance_valid(player) and NetClient.own_character_id >= 0:
		var own_uid := NetClient.own_character_id & 0xffffffff
		var gid := int(NetClient.guild_data.guild_id) if NetClient.guild_data.in_guild else int(NetClient.own_guild_line.get("guild_id", 0))
		_war_mark_on(own_uid, player, GuildWarMark.decide(gid, NetClient.war_guilds, _own_job_state()))
		seen[own_uid] = true
	for id in _other_bodies:
		var body: Node3D = _other_bodies[id]
		if body == null or not is_instance_valid(body):
			continue
		var uid := int(id) & 0xffffffff
		var line: Dictionary = NetClient.user_guilds.get(uid, {})
		var job: Dictionary = NetClient.user_jobs.get(uid, {})
		_war_mark_on(uid, body, GuildWarMark.decide(int(line.get("guild_id", 0)), NetClient.war_guilds,
			int(job.get("state", UserSpawnNet.JOB_STATE_NONE))))
		seen[uid] = true
	for uid in _war_marks.keys():
		if not seen.has(uid):
			_war_mark_on(int(uid), null, GuildWarMark.OFF)

func _war_mark_on(uid: int, body: Node3D, what: int) -> void:
	var had: AuraModel = _war_marks.get(uid)
	if had != null and (not is_instance_valid(had) or had.host != body):
		if is_instance_valid(had):
			had.release()
		_war_marks.erase(uid)
		had = null
	if what == GuildWarMark.ON and had == null and body != null:
		var m := AuraModel.spawn(String(_war_mark_row["path"]), body, String(_war_mark_row["bone"]), _war_mark_row["offset"])
		if m != null:
			m.name = "GuildWarMark"
			_war_marks[uid] = m
			print("World3D: guild war mark on uid %d (%s), %.1f above its foot (placed %.2f)" % [uid, body.name,
				_star_height_of(body) + float((_war_mark_row["offset"] as Vector3).y),
				m.global_position.y - body.global_position.y if m.is_inside_tree() else -1.0])
	elif what == GuildWarMark.OFF and had != null:
		had.release()
		_war_marks.erase(uid)
		print("World3D: guild war mark off uid %d" % uid)

## A body's `*` height (GuildWarMark.star_height of its characterInfo Size).
func _star_height_of(body: Node3D) -> float:
	var rec: SoundTable.CharacterInfo = null
	if body.has_meta("monster_id"):
		rec = _monster_char_record(_monster_code_of(int(body.get_meta("monster_id"))))
	else:
		var code := _player_body if body == player else String(body.get_meta("body", ""))
		var svc := AudioService.instance()
		if svc != null and code != "":
			rec = svc.character_record(code)
	return GuildWarMark.star_height(rec.size if rec != null else 0.0)

## ITEM_ETC_AUTOMOB's ref (ItemUseEffect.AUTOMOB_CODE): -2 not looked up yet,
## -1 not in the table.
var _automob_ref := -2

## The reverse return scroll's choice (round 778): the use with its option
## and, for the map option, the refoptionalteleport id.
func _on_reverse_return_requested(slot: int, option: int, target: int) -> void:
	if NetClient.current_character_name == "" or _player_dead:
		return
	# Round 838: a composite grant's reverse return fill (COMPOSITE_FILL_SLOT).
	if slot <= COMPOSITE_FILL_SLOT:
		var fill := COMPOSITE_FILL_SLOT - slot
		print("World3D: reverse return fill %d, option %d, point %d" % [fill, option, target])
		NetClient.composite_use(NetClient.current_character_name, fill, option, target)
		return
	print("World3D: reverse return scroll at bag slot %d, option %d, point %d" % [slot, option, target])
	UiSounds.expect_use(_hud_panels.bag_item_types(slot) if _hud_panels != null else PackedInt32Array())
	NetClient.use_item_option(NetClient.current_character_name, slot, option, target)

## The casting bar's cancel button (round 779, READ: 0x7b1a10 ->
## FUN_0081ee60 case 0): 0x705B. The bar stays until the state's 0x30BF.
func _on_cast_cancel_requested() -> void:
	print("CASTBAR cancel pressed -- sending 0x705B")
	NetClient.scroll_cancel()

## 0x30BF kind 0xb (round 779, READ 0x8a80a0 case 0xb): another player's
## value is only stored by the real client (+0x7c0, read by nothing found);
## this player's 0 ends the casting bar, saying
## UIIT_MSG_TRANSITION_CANCEL_RESULT when one was up (the board's +0x378).
func _on_teleport_state(change: WorldNet.StateChange) -> void:
	var own := _own_id()
	if own < 0 or change.object_id != (own & 0xffffffff):
		return
	print("CASTBAR teleport state %d" % change.value)
	_own_teleport_state = change.value
	if _scroll_hold():
		# Round 860: held from here (_scroll_hold): what was walking into
		# reach or toward a drop goes, and the walk stops on this tick.
		_drop_pending_attack()
		_pending_pickup_id = -1
		print("SCROLLHOLD on: no move, turn, attack or skill until the state's 0")
	if change.value != 0 or _hud_panels == null:
		return
	if _hud_panels.close_cast_bar():
		var text := _ui_text_table.get_text("UIIT_MSG_TRANSITION_CANCEL_RESULT", "") if _ui_text_table != null else ""
		_log_system(text if text != "" else "The teleportation has been cancelled.")

## QA only (OPENSRO_QA_FRAMELOG=1, round 785): a line a frame, so a real-time
## run's frames can be laid against what the window showed (tools/xcapture.sh
## stamps its grabs with the same wall clock). `screen` is whether the loading
## screen is in the tree as this frame's process runs -- what the frame draws,
## since it is put up and lifted only from coroutines resumed at the frame's
## start (process_frame) or from the network poll before this node's _process.
var _qa_framelog_on := OS.get_environment("OPENSRO_QA_FRAMELOG") != ""
var _qa_framelog_last_us := 0
func _qa_framelog_step() -> void:
	var now := Time.get_ticks_usec()
	print("QA FRAMELOG frame %d unix %.3f dt %.1f ms screen %s" % [Engine.get_frames_drawn(),
		Time.get_unix_time_from_system(), (now - _qa_framelog_last_us) / 1000.0,
		"up" if _loading_screen != null else "none"])
	_qa_framelog_last_us = now

## QA only (OPENSRO_QA_REVERSE, round 778): steps on the reverse return
## scroll's flow, groups separated by `;` running two seconds apart so a
## render catches each: `box` opens the box for the first reverse scroll in
## the bag (slot -1 when there is none), `map` presses its map button,
## `pick:<id>` clicks a map point's icon so its popup shows, `choose` presses
## the popup's first button (the real send), `recall` / `death` press the
## box's buttons, `send:<option>[:<id>]` sends a use directly, `wait` does
## nothing. Each step logs the frame it ran on.
func _qa_reverse_return(spec: String) -> void:
	if _hud_panels == null:
		return
	var groups := spec.split(";")
	for i in groups.size():
		var steps: String = groups[i]
		var run := func() -> void:
			var slot := -1
			for k in 128:
				if HudPanels.is_reverse_return_scroll(_hud_panels.bag_item_types(k)):
					slot = k
					break
			for step in steps.split(","):
				var st := step.strip_edges()
				var box := _hud_panels.reverse_return_box()
				if st == "box":
					_hud_panels.open_reverse_return_box(slot)
				elif st == "map" and box != null:
					box.member("MapPoint").emit_signal("pressed")
				elif st == "recall" and box != null:
					box.member("LastReturn").emit_signal("pressed")
				elif st == "death" and box != null:
					box.member("LastDeath").emit_signal("pressed")
				elif st.begins_with("pick:") and _hud_worldmap != null:
					_hud_worldmap.qa_pick(int(st.trim_prefix("pick:")))
				elif st == "choose" and _hud_worldmap != null:
					var buttons: Array = _hud_worldmap.select_popup_buttons()
					if not buttons.is_empty():
						(buttons[0] as BaseButton).emit_signal("pressed")
				elif st.begins_with("send:"):
					var parts := st.trim_prefix("send:").split(":")
					_on_reverse_return_requested(slot, int(parts[0]), int(parts[1]) if parts.size() > 1 else 0)
				elif st == "return":
					# Round 779: the first ordinary return scroll (3/3/3/1)
					# in the bag, used as a right-click uses it.
					for k in 128:
						var t := _hud_panels.bag_item_types(k)
						if t.size() >= 4 and t[0] == 3 and t[1] == 3 and t[2] == 3 and t[3] == 1:
							NetClient.use_item(NetClient.current_character_name, k)
							print("QA REVERSE return scroll at bag slot %d" % k)
							break
				elif st == "cancel":
					var bar := _hud_panels.cast_bar()
					if bar != null:
						bar.cancel_button().emit_signal("pressed")
				elif st == "bar":
					var bar := _hud_panels.cast_bar()
					print("QA REVERSE bar: %s" % ("none" if bar == null else "'%s' %d/%d ms at %s" % [bar.caption(), bar.total_ms - bar.remaining_ms, bar.total_ms, str(bar.position)]))
				print("QA REVERSE %s at frame %d (scroll slot %d)" % [st, Engine.get_frames_drawn(), slot])
		if i == 0:
			run.call()
		else:
			get_tree().create_timer(2.0 * i).timeout.connect(run)

## QA only: uses the first potion found in the bag, once. Driven by
## OPENSRO_QA_USEITEM; the ids are the real consumables the loot tables drop.
var _qa_used_potion := false
func _qa_use_first_potion(slots: Array, _error: String) -> void:
	if _qa_used_potion or NetClient.current_character_name == "" or _player_dead:
		return
	for entry in slots:
		var slot: InventoryNet.Slot = entry
		if slot.item_id in [4, 6, 11, 13]:
			_qa_used_potion = true
			if _hud_panels != null:
				UiSounds.expect_use(_hud_panels.item_types(slot.item_id))
			NetClient.use_item(NetClient.current_character_name, slot.slot_index)
			return

# --- The front-end's 3D backdrop (round 678) ---------------------------------
#
# FrontEndBackdrop instances this scene with `title_mode` set before it enters
# the tree: the login screen's fly-through (and, later, character select and
# create) reuse the world's own region loaders -- terrain, objects, water, sky
# and environment -- and nothing else. No player body, HUD, server, keys,
# NPCs or loading screen; the backdrop drives the camera and the region
# window follows the point it hands title_focus. Everything here is OURS
# plumbing around READ behaviour the backdrop documents.

## Set before add_child: this World3D is a front-end backdrop.
var title_mode := false
## The region window around the focus, in regions (OURS: 1, a 3x3 window,
## at the title). It does not reach the camera's far plane (7680 units,
## _apply_camera_far_plane). Since round 702 the fog is retail's linear fog
## (WorldFog), complete at the zone's end plane (Jangan 2250), so past it the
## window's edge is fog-coloured as retail's; before, an exponential fog left
## ~88-90 % showing at 2000-2700 units and the built world's edge could show
## (docs/TODO.md "The 3D title screen").
var _title_radius := 1

## The backdrop's half of _ready: the water reflection and the sky, the camera
## freed from the player's spring arm, the world's own UI hidden.
func _title_ready() -> void:
	print("World3D: title mode (round 678) -- a front-end backdrop: no player, HUD, server or loading screen")
	($UI as CanvasLayer).visible = false
	player.visible = false
	# The camera leaves the spring arm for this node (round 685's review):
	# SpringArm3D re-places its children from its INTERNAL physics process,
	# which set_physics_process(false) does not stop -- MEASURED, the eye
	# drifted 55.6 units over a backdrop left without show_pose, so every
	# screen had to re-pose it each frame. Detached, the camera stays where
	# the backdrop puts it; the arm is idle too.
	camera_arm.set_physics_process(false)
	camera_arm.set_physics_process_internal(false)
	camera_3d.reparent(self, true)
	camera_3d.top_level = true
	camera_3d.make_current()
	_water_reflection_on = WaterReflection.enabled()
	WaterReflection.ensure_globals()
	camera_3d.cull_mask &= ~WaterReflection.MIRROR_TERRAIN_BIT
	_water_reflection = WaterReflection.new()
	_water_reflection.name = "WaterReflection"
	add_child(_water_reflection)
	_try_add_real_sky()
	_apply_camera_far_plane()
	# The saved video record (round 694), as an entered world applies it.
	apply_video_options(video_options())
	# Round 680: the swaying trees and the like stay drawn (their clocks
	# paused) out of MapAnimation's 2020-unit range, instead of switching on
	# in view as the camera nears them -- a pop the title's probe counted
	# (OURS; retail fades them, MapAnimation's header).
	_map_animations.keep_drawn = true

## Starts the backdrop's region window on region (hi, lo) -- `centre` is
## Vector2i(hi, lo), this project's "hi/lo" -- with that region as the frame
## and a vertical anchor of 0 (OURS: world y is the region's own height, so
## a script's camera heights need no offset), its environment applied at
## `env_time` before any cell builds (so every cell bakes its light), and
## every cell of the window, the centre included, queued for the threaded
## pipeline -- nothing is built on this frame. False, with a printed reason,
## when Map.pk2 or the centre's `.m` is missing.
##
## `plan` (round 680): the whole scene instead of a window -- every cell, as
## Vector2i(dx, dy) from the frame region, in the order to build them
## (TitleCellPlan). A planned backdrop queues exactly those cells and then
## neither streams nor unloads: what is built stays, so nothing appears or
## goes while the camera flies (the user's "preload the scene entirely").
func title_begin(centre: Vector2i, radius: int, env_time: float, plan: Array = []) -> bool:
	_title_radius = maxi(radius, 0)
	_env_time = env_time
	# The front end's hour holds (round 786): no clock moves it (READ: only
	# CPSTitle::OnCreate sets SWorld's phase there).
	_env_fixed_phase = env_time
	var map_pk2 := _open_map_pk2_if_set()
	if map_pk2 == null:
		print("World3D: title backdrop -- no Map.pk2 (path='%s')" % Pk2Config.map_path())
		return false
	var mapm_path := "%d\\%d.m" % [centre.x, centre.y]
	var sw := Time.get_ticks_usec()
	var bytes := AssetSource.read_bytes(mapm_path, map_pk2)
	var region: MapmReader.ParsedRegion = MapmReader.parse(bytes) if not bytes.is_empty() else null
	if region == null:
		print("World3D: title backdrop -- region %d/%d has no terrain (%s)" % [centre.x, centre.y, mapm_path])
		return false
	_apply_real_environment_lighting(region, map_pk2)
	print("World3D: title backdrop at %d/%d, radius %d, environment phase %.4f (read and applied in %.1f ms)" % [
		centre.x, centre.y, _title_radius, env_time, (Time.get_ticks_usec() - sw) / 1000.0])
	_drop_cell_jobs("a new title backdrop")
	_grid_builds += 1
	_grid_origin_region = centre
	_grid_centre_region = centre
	_grid_shared_anchor_height = 0.0
	_grid_origin_world = _frame_corner(0.0)
	_grid_has_origin = true
	_grid.loaded_cells.clear()
	_grid.queued_cells.clear()
	_load_queue.clear()
	_last_stream_cell = Vector2i.ZERO
	var cells: Array = []
	_title_planned = not plan.is_empty()
	if _title_planned:
		for c in plan:
			var at := c as Vector2i
			cells.append({"rx": centre.x + at.x, "ry": centre.y + at.y, "dx": at.x, "dy": at.y,
				"key": "%d_%d" % [at.x, at.y], "dist": absi(at.x) + absi(at.y)})
		print("World3D: title backdrop planned -- %d cell(s) queued, no streaming while it flies" % cells.size())
	else:
		for dy in range(-_title_radius, _title_radius + 1):
			for dx in range(-_title_radius, _title_radius + 1):
				cells.append({"rx": centre.x + dx, "ry": centre.y + dy, "dx": dx, "dy": dy,
					"key": "%d_%d" % [dx, dy], "dist": absi(dx) + absi(dy)})
		cells.sort_custom(func(a, b): return a["dist"] < b["dist"])
	for cell in cells:
		_grid.queued_cells[cell["key"]] = true
		_load_queue.append(cell)
	return true

## The point the region window follows (the camera's target, in world
## space): the hidden player stands there, which is what
## _maybe_stream_regions measures from.
func title_focus(world_position: Vector3) -> void:
	player.position = world_position

## Cells built so far, and cells still queued or preparing.
func title_cells_loaded() -> int:
	return _grid.loaded_cells.size()

func title_cells_pending() -> int:
	return _load_queue.size() + _cell_jobs.size()

## Where a point given relative to the backdrop's frame region lands in the
## world, for a backdrop begun with title_begin (anchor 0): the region
## group's corner (_group_position, the same placement every cell uses) plus
## the point with z mirrored (the group's scale.z = -1). Positions outside
## [0, 1920) fall in the neighbouring cells, as they do in retail's frame.
static func title_world_from_local(local: Vector3) -> Vector3:
	var corner := _group_position(Vector3.ZERO, 0.0)
	return corner + Vector3(local.x, local.y, -local.z)

## Stops starting new cells (round 678's review): the queue is dropped and
## the window no longer follows the focus; cells already preparing still
## commit, so leaving the screen has little or nothing left to wait for.
func title_hold() -> void:
	_title_held = true
	for cell in _load_queue:
		_grid.queued_cells.erase(cell["key"])
	_load_queue.clear()

var _title_held := false
## A planned backdrop (title_begin's `plan`, round 680): its cells are the
## whole scene, so the window neither follows the focus nor unloads, and the
## stale-cell guard (_outside_stream_window) never drops one of them.
var _title_planned := false

func _title_physics(_delta: float) -> void:
	if _sky_dome != null:
		_cloud_uv_offset.x = fposmod(Time.get_ticks_msec() / CLOUD_SCROLL_MS, 1.0)
		_sky_dome_material.set_shader_parameter("uv_offset", _cloud_uv_offset)
	_tick_map_animations()
	if not _title_held and not _title_planned:
		_maybe_stream_regions()
	_process_stream_queue()

# --- COS: pets, rides and transports (round 795) ----------------------------
#
# A summoned COS reaches this client as retail's CICCos spawn record
# (CosSpawnNet, through the same 0x3015 / group spawns as the players), moves
# by 0xB021 / 0xB023 under its own uid, and is despawned by 0x3016. Its owner
# hears its data (0x30C8) and updates (0x30C9) for the COS windows (HudCos).
# docs/protocol/pets.md, "Round 795", has the rules; what is READ is cited
# where it is used.
#
# A rider (READ, ICharactor::FUN_009d05d0 every frame): its body's world
# transform is the mount's animated "saddle" bone times the mount's world
# transform, with no offset; the rider plays its "cart" group, the same action
# type as the mount (0x9cfa00..0x9cfcf0); a mount with a rider is drawn with it.
# OURS: here the rider's ROOT keeps walking on the ground (the own player's
# mover, another's OtherWalk leg, both at the mount's speeds) and the mount's
# body follows that root; the rider's skeleton alone is put on the saddle.

## The COS table (CharTables' boot task, round 795).
var _cos_table: CosTable = null
## uid -> the body's root Node3D, its record, its assembly, its motion.
var _cos_bodies := {}
var _cos_recs := {}
var _cos_assembled := {}
var _cos_motion := {}
## uid -> the model its body waits for (an async template).
var _cos_waiting := {}
## rider (character id, the own one included) -> mount uid.
var _riders := {}
## rider -> the skeleton's own local transform, put back at the dismount.
var _rider_rest := {}
## The own player's foot speed, kept while it rides.
var _foot_move_speed := -1.0

## The name line's colour: 0xffffff55, pale yellow (READ, CICCos::vslot_025
## FUN_008b2b70(0xffffff55)).
const COS_NAME_COLOUR := Color(1.0, 1.0, 0x55 / 255.0)
## The owner line sits 20.0 above the name line (READ, CICCos slot 15
## 0x9c6820, `fsub 0xe1b830`): screen pixels, since the plate is drawn in
## screen space (FUN_008b4d90 at the projected point). Round 796: a plate's
## offset is in its font's pixels, which FontOversampling multiplies, so it
## takes the same factor (_cos_owner_offset); round 795 set 20 font pixels,
## a few screen pixels, and the two lines overlapped.
const COS_OWNER_LINE_OFFSET := 20.0
## A rider's plate is 7.0 over its mount's height, where everyone else's is
## 2.0 over its own (READ, FUN_009d0a80 0x9d0b40..0x9d0b98: mount +0x22c +
## 7.0 at 0xda7c60). The mount's height is +0x228 (which +0x22c follows):
## CICCos slot 28 (0x9c7780) sets it to 20.0 x FUN_009c7740 = 20.0 x
## [+0x728]+8 x [+0xc4], where [+0x728] is the ref's skilleffect.txt
## characterInfo row and +8 its Size (column 3) x 0.5 (READ
## UI_ALCHEMYBOX::FUN_00a9ae80, 0.5 at 0xe1b7d0) -- Size x 10, the row
## found by code, then OrgCodeName, then the file's first row (READ
## FUN_00a95d30; Size 2 there, so a COS with no row of its own, Rudolph's,
## is 20). INFERRED: the scale +0xc4 is 1.0 (retail_camera.gd).
const COS_RIDER_PLATE_RAISE := 7.0
const COS_SIZE_HEIGHT := 0.5 * 20.0
## Round 810 (OURS): the least a rider's plate sits over the mount's seat --
## a seated rider's head bone over the saddle (MEASURED 5.6 on the donkey and
## the buffalo) + a standing plate's clearance over the head bone (MEASURED
## 21.5 - 16.1 = 5.4).
const COS_SEATED_PLATE := 11.0
## rider -> its plate's own height, put back at the dismount (round 796).
var _rider_plate_y := {}
## A pet runs above this speed and walks below it (READ, CICCos::vslot_009
## 0x9c59c0, 20.0 at 0xd88108).
const COS_RUN_ABOVE := 20.0

func _cos_connect() -> void:
	NetClient.cos_spawned.connect(_on_cos_spawned)
	NetClient.cos_despawned.connect(_on_cos_despawned)
	NetClient.cos_hp.connect(_on_cos_hp)
	NetClient.cos_level_up.connect(_on_cos_level_up)
	NetClient.ride_changed.connect(_on_ride_changed)
	NetClient.speed_changed.connect(_on_speed_changed)
	NetClient.cos_reply.connect(_on_cos_reply)
	NetClient.cos_command_result.connect(_on_cos_command_result)
	_cos_connect_ai()
	# Those already in view before this world came up.
	for uid in NetClient.cos_roster:
		_on_cos_spawned(NetClient.cos_roster[uid])

## The COS table from the boot tables, bound where the readers ask.
func _cos_bind_table(boot: CharTables.Boot) -> void:
	_cos_table = boot.cos if boot != null else CosTable.new()
	ItemInstance.cos_kind_of = _cos_table.kind_of
	ItemInstance.types_of = func(ref: int) -> PackedInt32Array:
		var it = _item_rows.get(ref)
		return it.type_ids if it != null else PackedInt32Array()
	print("World3D: %d COS rows (rides, transports, pets)" % _cos_table.size())

func _cos_kind_of(ref: int) -> int:
	return _cos_table.kind_of(ref) if _cos_table != null else 0

## A COS's display name: the record's (a pet's own), else its row's name text.
func _cos_display_name(rec: CosSpawnNet.Record) -> String:
	if rec.name != "":
		return rec.name
	# Round 797 (READ CICCos::vslot_034 0x9c6d46..0x9c6d82): with no name, an
	# owner in no job (the record's job byte 4) gives "No name"
	# (UIIT_STT_COSNEWUI_TITLE); any other gives the ref's own name -- a
	# job suit's "< sylph >". Round 839: a key with no text gives "" (no
	# name line), not the row's code (CosSpawnNet.display_name).
	# UiTextTable.get_text answers a missing key with the key itself, so
	# both lookups test has() first.
	var none := ""
	if _ui_text_table != null and _ui_text_table.has("UIIT_STT_COSNEWUI_TITLE"):
		none = _ui_text_table.get_text("UIIT_STT_COSNEWUI_TITLE")
	var row := _cos_table.row(rec.ref_id) if _cos_table != null else null
	var names := _object_names()
	var text := ""
	if row != null and names != null and row.name_key != "" and names.has(row.name_key):
		text = names.get_text(row.name_key)
	return CosSpawnNet.display_name(rec, none, text)



## The owner line: the owner's name, "*name" in a job, "[name]" for a soldier
## (READ, ICCos::FUN_009c5ea0).
static func cos_owner_line(rec: CosSpawnNet.Record) -> String:
	if rec.owner_name == "":
		return ""
	if rec.kind == CosSpawnNet.KIND_SOLDIER:
		return "[%s]" % rec.owner_name
	if rec.owner_job != 4 and rec.owner_job != 0:
		return "*" + rec.owner_name
	return rec.owner_name

func _on_cos_spawned(rec: CosSpawnNet.Record) -> void:
	var at := NetClient.spawn_world(rec.region, rec.local_position)
	var old: Node3D = _cos_bodies.get(rec.uid)
	_cos_recs[rec.uid] = rec
	# Round 859 (READ, CICCos::vslot_026 c:0x9c5d20): a pet called out (the
	# spawn's type byte 1) plays SYSTEM_PET_APPEAR on its body and
	# snd_cos_summon -- here as soon as its body stands (_cos_summon_fx).
	if SystemEffects.pet_summon_plays(rec.kind, rec.spawn_type):
		UiSounds.play(SystemEffects.KEY_COS_SUMMON, "COS %d summoned" % rec.uid)
		_cos_summon_pending[rec.uid] = true
	if old != null and is_instance_valid(old):
		# Spawned again (a summon's re-spawn, a death, a level's new row): a
		# new model is built anew, the same one is updated in place.
		var old_rec: CosSpawnNet.Record = old.get_meta("cos_rec")
		if old_rec != null and old_rec.ref_id == rec.ref_id:
			old.set_meta("cos_rec", rec)
			_cos_label(old, rec)
			# Round 796: where the record puts it -- an owner's arrival spawns
			# its pet again beside it; round 795 left the body where it was.
			if _cos_rider_of(rec.uid) < 0:
				var gy := _cos_ground(at)
				old.position = Vector3(at.x, at.y if is_nan(gy) else gy, at.z)
				_cos_ground_missed(rec.uid, gy)
				old.rotation.y = RemoteFacing.yaw_of(RemoteFacing.from_wire_angle(rec.angle), _cos_front())
				_cos_end_leg(rec.uid)
			if rec.life == 2:
				_cos_play(rec.uid, BsrReader.AnimationEntry.TYPE_DIE, true)
			_cos_summon_fx(rec.uid)
			return
		_cos_free_body(rec.uid)
	_cos_build_body(rec, at)

## Round 859: COS uids whose summon effect waits for their body.
var _cos_summon_pending := {}
func _cos_summon_fx(uid: int) -> void:
	if not _cos_summon_pending.has(uid):
		return
	var body = _cos_bodies.get(uid)
	if body == null or not is_instance_valid(body):
		return
	_cos_summon_pending.erase(uid)
	_play_system_fx(SystemEffects.PET_APPEAR, body, "COS %d summoned" % uid)

## Round 861: the model a COS row is drawn from (CosModelFallback): its own
## when the archive holds it, else its trade twin (OURS), else the original's
## Mangyang stand-in, else "" (nothing drawn). Decided once per named model;
## the world says once what it picked when it is not the row's own.
var _cos_model_picked := {}
## Row codes whose body could not be drawn, said once (round 861).
var _cos_undrawn_logged := {}
func _cos_model_of(row: CosTable.Row) -> String:
	if row == null or row.model == "":
		return ""
	if _cos_model_picked.has(row.model):
		return String(_cos_model_picked[row.model])
	var archive := _open_pk2_if_set()
	if archive == null:
		return row.model
	var has := func(p: String) -> bool:
		return ObjectLoader.find_file(archive, p) != null or ObjectLoader.find_file(archive, "res\\" + p) != null
	var picked := CosModelFallback.resolve(row.model, has)
	_cos_model_picked[row.model] = String(picked.path)
	var line := CosModelFallback.describe(row.code, row.model, picked)
	if line != "":
		print("World3D: " + line)
	return String(picked.path)

func _cos_build_body(rec: CosSpawnNet.Record, at: Vector3) -> void:
	var row := _cos_table.row(rec.ref_id) if _cos_table != null else null
	var model := _cos_model_of(row)
	# Round 809: its material slot, by the COS rule (NpcTableReader.texture_slot).
	if model != "":
		_monster_model_path("", "")
		model = MonsterDraw.template_key(model, NpcTableReader.texture_slot(
			int(_monster_texture_by_code.get(row.code, 0)), 0, true))
	if model != "" and _monster_async_wanted() and not _monster_templates.has(model):
		if not _monster_assemble.is_valid() and _data_pk2 == null:
			_data_pk2 = _open_pk2_if_set()
		_monster_templates.request(model, _monster_assemble if _monster_assemble.is_valid() else _assemble_monster_model)
		_cos_waiting[rec.uid] = model
		return
	_cos_waiting.erase(rec.uid)
	var body := Node3D.new()
	body.name = "Cos%d" % rec.uid
	var y := _cos_ground(at)
	body.position = Vector3(at.x, at.y if is_nan(y) else y, at.z)
	_cos_ground_missed(rec.uid, y)
	body.rotation.y = RemoteFacing.yaw_of(RemoteFacing.from_wire_angle(rec.angle), _cos_front())
	var height := 2.0 * PLAYER_SCALE_RATIO
	var skel: Skeleton3D = null
	if model != "":
		var assembled := _monster_templates.instance(model, _monster_assemble if _monster_assemble.is_valid() else _assemble_monster_model)
		if assembled != null:
			skel = assembled.skeleton
			_cos_assembled[rec.uid] = assembled
			height = _monster_templates.label_height_of(model)
			skel.set_meta(MonsterDraw.META_RADIUS, _monster_templates.radius_of(model))
			BodyMirror.apply(skel)
			body.add_child(skel)
			_animate(assembled)
			_body_fx_attach(skel, assembled.parsed, model)
	# Round 861: no white capsule for a COS (it had no material and drew
	# white; the user's "white blobs"). A body that cannot be drawn keeps its
	# collider and plates and draws nothing; the world says so once per row.
	if skel == null and row != null and not _cos_undrawn_logged.has(row.code):
		_cos_undrawn_logged[row.code] = true
		push_warning("World3D: COS %s (%s): no model could be drawn (%s) -- nothing drawn" % [
			row.code, row.model, model if model != "" else "no file"])
	body.set_meta("cos_uid", rec.uid)
	body.set_meta("cos_rec", rec)
	body.set_meta("cos_height", height)
	body.add_child(_monster_collider(height))
	var label := _name_plate("", height / (1.0 + NAME_PLATE_CLEARANCE_FRACTION))
	label.name = "Label"
	# Round 811: both lines in the original's plate (_retail_plate_look).
	_retail_plate_look(label, COS_NAME_COLOUR)
	body.add_child(label)
	var owner_label := _name_plate("", height / (1.0 + NAME_PLATE_CLEARANCE_FRACTION))
	owner_label.name = "OwnerLabel"
	_retail_plate_look(owner_label, Color.WHITE)
	owner_label.offset.y = _cos_owner_offset(owner_label)
	body.add_child(owner_label)
	_cos_label(body, rec)
	# Round 813: it leans with the ground if its row says so (SlopeTilt).
	if skel != null and row != null:
		_slope_tilt_register(body, row.code, SLOPE_COS, rec.uid)
	other_entities.add_child(body)
	_cos_bodies[rec.uid] = body
	CharacterBlobs.register(body, float(row.bc) if row != null else 0.0)
	_light_character(body)
	_appear_fades.start(body)
	_cos_summon_fx(rec.uid)
	if rec.life == 2:
		_cos_play(rec.uid, BsrReader.AnimationEntry.TYPE_DIE, true)
	elif rec.has_dest:
		var d := NetClient.spawn_world(rec.dest_region, Vector3(rec.dest_local))
		_cos_start_leg(rec.uid, Vector3(d.x, d.y, d.z), rec.run if rec.run_flag != 0 else rec.walk)
	print("World3D: COS %d %s (%s, TypeID4 %d) at (%.0f, %.0f) owner %s -- %s" % [rec.uid,
		_cos_display_name(rec), row.code if row != null else "?", rec.kind, at.x, at.z,
		rec.owner_name if rec.owner_name != "" else "-", "model " + model if skel != null else "no model: nothing drawn"])

## The two lines over a COS: its name in pale yellow, the owner's line above
## it in the owner's name colour (white when the owner is out of view).
## Round 796: neither while something rides it (READ, FUN_009cef40: a
## CICMonster's or a CICCos's name shows only while its rider link +0x2b0 is
## empty; CICCos slot 15 draws the owner line under the same test). Emptied
## rather than hidden: the plate sweep owns `visible`.
func _cos_label(body: Node3D, rec: CosSpawnNet.Record) -> void:
	var ridden := _cos_rider_of(rec.uid) >= 0
	var label: Label3D = body.get_node_or_null("Label")
	if label != null:
		label.text = "" if ridden else CosSpawnNet.plate_text(_cos_display_name(rec))
		label.modulate = COS_NAME_COLOUR
		_fit_monster_name_box(label)
	var owner_label: Label3D = body.get_node_or_null("OwnerLabel")
	if owner_label != null:
		owner_label.text = "" if ridden else cos_owner_line(rec)
		owner_label.modulate = Color.WHITE
		owner_label.visible = owner_label.text != ""
		_fit_monster_name_box(owner_label)

func _cos_free_body(uid: int) -> void:
	var body: Node3D = _cos_bodies.get(uid)
	_cos_bodies.erase(uid)
	_cos_assembled.erase(uid)
	_cos_motion.erase(uid)
	if body != null and is_instance_valid(body):
		var skel := body.get_node_or_null("Skeleton3D")
		for c in body.get_children():
			if c is Skeleton3D:
				_unanimate(c)
		body.queue_free()

func _on_cos_despawned(uid: int) -> void:
	_cos_waiting.erase(uid)
	_cos_recs.erase(uid)
	# A rider on it gets off (READ: CICCos slot 8 0x9d0a30 clears both links).
	for rider in _riders.keys():
		if int(_riders[rider]) == uid:
			_cos_unseat(int(rider))
	_cos_free_body(uid)

## Drops every skeleton entry the idle ticker drives for skel.
func _unanimate(skel: Skeleton3D) -> void:
	var i := 0
	while i < _animated.size():
		if (_animated[i] as Array)[0] == skel:
			_animated.remove_at(i)
		else:
			i += 1

## Plays one action on a COS's body: once, or held (a death).
func _cos_play(uid: int, action_type: int, hold: bool = false) -> float:
	var assembled: SkinnedBsrAssembler.AssembledCharacter = _cos_assembled.get(uid)
	if assembled == null or _data_pk2 == null or not is_instance_valid(assembled.skeleton):
		return 0.0
	var anim := SkinnedBsrAssembler.animation_for(_data_pk2, assembled, action_type)
	if anim == null:
		return 0.0
	return _play_once(assembled.skeleton, anim, hold)

## A COS's loop: stand, walk or run (_body_gait: a walk or run its model has no
## clip for plays nothing, round 853).
func _cos_gait(uid: int, gait: int) -> void:
	_body_gait(_cos_assembled.get(uid), gait)

## Round 796: a rider's weapon and shield are not drawn (READ,
## CharacterVisualChange::CObjItem::vslot_003 0x4e8830: an item in equip
## visual slot 6 or 7 -- the weapon at +0x80 and the shield at +0x8c,
## EQUIP_SLOTS.md -- answers 0, not shown, while CObjCharacter::FUN_00a5be70
## says the body has a mount). Round 850: the emote and the stall hide the
## same items (HeldItems has the rule, READ CCompChar slot 22 0xc29bd0), so
## the three are reasons on one switch: a character's held items are drawn
## when none holds (HeldItems.set_shown). Their own ambient particles on the
## body skeleton (WornItemFx.MARKER_META naming the node) go with them; their
## glow and EquipFx's holders hang under the node.
##
## Character id -> {"reasons": {HeldItems.REASON_*: true}, "skel": the
## skeleton id it was last applied to, "emote_clip": the emote's clip,
## "emote_until": the clip clock (_idle_anim_time) its clip ends at}. Only
## characters with a reason are here.
var _held := {}

## Turns a reason to hide `uid`'s weapon and shield on or off, and draws the
## result at once (a far body's instances re-read).
func _held_set(uid: int, reason: StringName, on: bool) -> void:
	var e: Dictionary = _held.get(uid, {})
	if e.is_empty():
		if not on:
			return
		e = {"reasons": {}, "skel": 0}
		_held[uid] = e
	var reasons: Dictionary = e["reasons"]
	if on == reasons.has(reason):
		return
	if on:
		reasons[reason] = true
	else:
		reasons.erase(reason)
	var n := _held_apply(uid, e)
	print("HELD: %d %s %s -> %s (%d item(s), reasons %s)" % [uid, reason, "on" if on else "off",
		"hidden" if not reasons.is_empty() else "shown", n, str(reasons.keys())])
	if reasons.is_empty():
		_held.erase(uid)

## Draws `uid`'s held items as its reasons say, on the skeleton it has now.
func _held_apply(uid: int, e: Dictionary) -> int:
	var skel := _rider_skeleton(uid)
	if skel == null or not is_instance_valid(skel):
		e["skel"] = 0
		return 0
	e["skel"] = skel.get_instance_id()
	var shown := (e["reasons"] as Dictionary).is_empty()
	var n := HeldItems.set_shown(skel, shown)
	if shown and n > 0:
		# Their effects (the + glow, a seal's stars) back with them this frame.
		EquipFx.hurry_in(get_viewport())
	var root := _rider_root(uid)
	if root != null and is_instance_valid(root):
		_crowd_light_changed(root)
	return n

## Each frame: a re-dress (a weapon swap, an equip) builds a new skeleton, so
## a reason that still holds is applied to it (the new weapon never shows,
## OURS -- see HeldItems on the original's op 2); an emote whose clip is over
## or cut lets go (state 13's leave, 0xa59c40); a character that has gone is
## forgotten.
func _step_held() -> void:
	if _qa_held_log:
		_qa_held_report()
	if _held.is_empty():
		return
	var own := _own_id()
	for uid in _held.keys():
		var e: Dictionary = _held[uid]
		var reasons: Dictionary = e["reasons"]
		if reasons.has(HeldItems.REASON_EMOTE):
			var over := false
			if own >= 0 and int(uid) == own:
				over = _player_one_shot == null or _player_one_shot != e.get("emote_clip")
			else:
				# The clip clock (not the wall's: a movie-mode run's game time
				# runs at its own pace), or the clip no longer on the body (a
				# move's loop, a hit, a re-dress swapped it), checked every
				# HELD_SCAN_FRAMES frames.
				over = _idle_anim_time >= float(e.get("emote_until", 0.0))
				if not over and Engine.get_process_frames() % HELD_SCAN_FRAMES == 0:
					over = not _held_clip_on(_rider_skeleton(int(uid)), e.get("emote_clip"))
			if over:
				_held_set(int(uid), HeldItems.REASON_EMOTE, false)
				if not _held.has(uid):
					continue
		var root := _rider_root(int(uid))
		if root == null or not is_instance_valid(root):
			_held.erase(uid)
			continue
		var skel := _rider_skeleton(int(uid))
		var sid := skel.get_instance_id() if skel != null and is_instance_valid(skel) else 0
		if sid != int(e["skel"]):
			var n := _held_apply(int(uid), e)
			if sid != 0:
				print("HELD: %d's new body -- %d item(s) kept hidden (reasons %s)" % [int(uid), n, str(reasons.keys())])

## An emote began on `uid`'s body (0x3091): state 13's enter hides the weapon
## for every emote but Rush (HeldItems.emote_hides); Rush leaves it drawn, and
## so ends a hiding emote it replaces (its leave shows it, 0xa59c40).
func _held_emote(uid: int, emote: int, clip: BanReader.ParsedAnimation, seconds: float) -> void:
	if clip == null or seconds <= 0.0 or not HeldItems.emote_hides(emote):
		_held_set(uid, HeldItems.REASON_EMOTE, false)
		return
	_held_set(uid, HeldItems.REASON_EMOTE, true)
	var e: Dictionary = _held.get(uid, {})
	e["emote_clip"] = clip
	e["emote_until"] = _idle_anim_time + seconds

## How often another body's emote is looked for on its skeleton (frames).
const HELD_SCAN_FRAMES := 6

## Whether `skel` still plays `clip` as its one-shot (its _animated entry).
func _held_clip_on(skel: Skeleton3D, clip) -> bool:
	if skel == null or not is_instance_valid(skel) or clip == null:
		return false
	for entry in _animated:
		if entry[0] == skel:
			return entry[1] == clip
	return false

## A body was (re)built for `uid`: a reason that holds is drawn on it from
## its first frame (not a frame later, from _step_held).
func _held_rebuilt(uid: int) -> void:
	var e: Dictionary = _held.get(uid, {})
	if not e.is_empty():
		_held_apply(uid, e)

## QA: "shown", "hidden", "mixed" or "none" for `uid`'s held items.
func _held_state(uid: int) -> String:
	return HeldItems.state_of(_rider_skeleton(uid))

## OPENSRO_QA_HELD_LOG=1 (round 850): every 60 ticks, and on every change, a
## "QA HELD" line with each character's held items as drawn -- the node's own
## visibility, each item's mesh count shown in the tree, its EquipFx holders
## and own effects shown -- and its reasons. Measured from the scene.
var _qa_held_log := OS.get_environment("OPENSRO_QA_HELD_LOG") == "1"
var _qa_held_last := ""
var _qa_held_tick := -1

func _qa_held_report() -> void:
	var parts: PackedStringArray = []
	var ids: Array = [_own_id()]
	ids.append_array(_other_gaits.keys())
	for uid in ids:
		var skel := _rider_skeleton(int(uid))
		if skel == null or not is_instance_valid(skel):
			continue
		var items: PackedStringArray = []
		for c in skel.get_children():
			if not (c is Node3D) or not HeldItems.is_held_node(c):
				continue
			var meshes := 0
			var drawn := 0
			for mi in (c as Node).find_children("*", "MeshInstance3D", true, false):
				meshes += 1
				if (mi as MeshInstance3D).is_visible_in_tree():
					drawn += 1
			var fx := 0
			var fx_on := 0
			for f in (c as Node).find_children("*", "Node3D", true, false):
				if f is EfpEffect or String(f.name).begins_with("EquipFx"):
					fx += 1
					if (f as Node3D).is_visible_in_tree():
						fx_on += 1
			items.append("%s kind %d %s meshes %d/%d fx %d/%d" % [c.name, int(c.get_meta(HeldItems.ATTACH_KIND_META, -1)),
				"visible" if (c as Node3D).visible else "HIDDEN", drawn, meshes, fx_on, fx])
		var e: Dictionary = _held.get(uid, {})
		var root := _rider_root(int(uid))
		var at := root.global_position if root != null and is_instance_valid(root) else Vector3.ZERO
		parts.append("%d%s at (%.0f,%.1f,%.0f) [%s] reasons %s" % [int(uid), " (self)" if int(uid) == _own_id() else "",
			at.x, at.y, at.z, "; ".join(items), str((e.get("reasons", {}) as Dictionary).keys())])
	var line := " | ".join(parts)
	if line != _qa_held_last or (_qa_tick % 60 == 0 and _qa_tick != _qa_held_tick):
		print("QA HELD tick %d ms %d: %s" % [_qa_tick, Time.get_ticks_msec(), line])
		_qa_held_tick = _qa_tick
	_qa_held_last = line

## The mount's seat: its `saddle` bone at rest over the mount's root (x its
## scale), 0 for a mount without one. The rest pose (not the live saddle) is
## OURS, so a plate does not bob with the gait.
func _cos_seat_height(mount: Node3D) -> float:
	var uid := int(mount.get_meta("cos_uid", -1))
	var assembled: SkinnedBsrAssembler.AssembledCharacter = _cos_assembled.get(uid) if uid >= 0 else null
	if assembled == null:
		for k in _cos_bodies:
			if _cos_bodies[k] == mount:
				assembled = _cos_assembled.get(k)
				break
	if assembled == null or not is_instance_valid(assembled.skeleton):
		return 0.0
	var skel := assembled.skeleton
	var bone := skel.find_bone("saddle")
	if bone < 0:
		return 0.0
	if skel.is_inside_tree() and mount.is_inside_tree():
		return (skel.global_transform * skel.get_bone_global_rest(bone)).origin.y - mount.global_position.y
	return (skel.transform * skel.get_bone_global_rest(bone)).origin.y

## A COS's +0x228 (see COS_RIDER_PLATE_RAISE): its characterInfo Size x 10;
## its measured height when no table is loaded.
func _cos_plate_height(mount: Node3D) -> float:
	var rec = (mount.get_meta("cos_rec") if mount.has_meta("cos_rec") else null)
	var row := _cos_table.row(rec.ref_id) if rec != null and _cos_table != null else null
	var svc := AudioService.instance()
	if row != null and svc != null:
		var size := svc.character_size(row.code, row.org)
		if size > 0.0:
			return size * COS_SIZE_HEIGHT
	return float(mount.get_meta("cos_height", 0.0))

## The owner line's offset in its plate's own offset units, so that it is
## COS_OWNER_LINE_OFFSET screen pixels (x the UI scale, as the plates' text)
## whatever the plate's pixel size: an offset unit is `pixel_size` world
## units at the fixed size, a screen pixel _monster_plate_pixel_size().
## Round 797: round 796 took the plate's font pixels for screen pixels, but
## a COS plate's pixel size is NAME_PLATE_PIXEL_SIZE, not the monsters'
## screen-exact one -- at the user's 1262-row window the 20 came out about 7
## screen pixels and the lines still overlapped.
func _cos_owner_offset(label: Label3D) -> float:
	return COS_OWNER_LINE_OFFSET * _monster_plate_pixel_size() / maxf(label.pixel_size, 1e-9)

## Round 796: a rider's plate at its mount's height + COS_RIDER_PLATE_RAISE,
## or back at its own height (`on` false). The original adds that to the
## RIDER's position (READ, FUN_009d0a80 0x9d0b40..0x9d0b9e: `fadd
## [esp+0x2c]`, the rider's +0x94), and that position is the ground under
## the mount, not the seat: the rider is drawn on the saddle through its
## render matrix only (READ ICharactor::FUN_009d05d0), and the dismount puts
## +0x90..+0x98 back into that matrix (FUN_009cf600) -- INFERRED that +0x94
## is not moved while riding. Round 809 measured from the seat and put the
## plate a rider's height too high (the user's screenshot on the Indian ox,
## COS_T_COW3: 29 + 20 + 7 = 56, the head bone at 35). Round 810: from the
## ground, but never below COS_SEATED_PLATE over the seat (OURS). The ox is
## why: it has no characterInfo row and its OrgCodeName is "xxx", so it takes
## the first row's Size 2 (READ FUN_00a95d30) -- 27 from the ground, under
## its 29 seat, the rider's waist in the user's round 808 screenshot, where
## the user reports the original's plate over the head. Its node is the rider root's
## "Name"; a batched plate is told it moved.
func _raise_rider_plate(rider: int, mount: Node3D, on: bool) -> void:
	var root := _rider_root(rider)
	if root == null or not is_instance_valid(root):
		return
	var plate := root.get_node_or_null("Name") as Label3D
	if plate == null:
		return
	var y := plate.position.y
	if on:
		if not _rider_plate_y.has(rider):
			_rider_plate_y[rider] = y
		y = maxf(_cos_plate_height(mount) + COS_RIDER_PLATE_RAISE, _cos_seat_height(mount) + COS_SEATED_PLATE)
	elif _rider_plate_y.has(rider):
		y = float(_rider_plate_y[rider])
		_rider_plate_y.erase(rider)
	_set_plate_y(root, plate, y)

## Round 808: a plate's height, with the job mark and title beside it. On
## another player they are the body's children, not the plate's
## (_job_plate_decor), so moving the name alone left them at the body's own
## height -- inside the mount while the name rode above it. The original
## draws both from the plate's one projected point (c:0x9dea30, the point
## FUN_009d0a80 leaves at +0x4f0), so they cannot part.
func _set_plate_y(holder: Node3D, plate: Label3D, y: float) -> void:
	if not is_equal_approx(plate.position.y, y):
		plate.position.y = y
		if _plate_batch != null and _plate_batch.has(plate):
			_plate_batch.moved(plate)
	if holder == null or holder == plate:
		return
	for decor in ["JobMark", "JobTitle", "GuildLine"]:
		var n := holder.get_node_or_null(decor) as Node3D
		if n != null and n.get_parent() == holder and not is_equal_approx(n.position.y, y):
			n.position.y = y

## Round 796: COS uid -> true while its body waits for ground (_cos_step).
var _cos_ground_pending := {}

## Books a ground answer for a COS's body: a miss (NAN) puts it on
## _cos_ground_pending, a hit takes it off.
func _cos_ground_missed(uid: int, ground: float) -> void:
	if is_nan(ground):
		_cos_ground_pending[uid] = true
	else:
		_cos_ground_pending.erase(uid)

## Round 796: a COS's ground, the walking monsters' (_moving_monster_hit_height:
## the navmesh, then the terrain ray). Round 795 took the terrain ray alone,
## which sees only the terrain layer, so a pet on Jangan's paved square ran
## under the paving. NAN when neither answers.
func _cos_ground(at: Vector3) -> float:
	return _moving_monster_hit_height(at)

## Round 796: the yaw a COS's front takes off its heading. A COS model is
## authored facing -Z like every monster's (MonsterMotion.MODEL_FRONT, round
## 637) and its skeleton is not turned under the body, so a heading h is
## rotation.y = h - PI; round 795 used 0 and every pet and mount ran
## backwards.
static func _cos_front() -> float:
	return MonsterMotion.front_yaw(MonsterMotion.MODEL_FRONT)

## Starts a COS's leg toward dest at speed, `mult` times faster while it
## catches up (round 852: the leg is an OtherWalk leg, walked as every other
## body's is -- OtherWalk.step, and BodyWalk where it meets a wall). Its gait:
## a pet's by PetGait (re-chosen every frame, _cos_pet_tick), any other COS's
## by the leg's speed against COS_RUN_ABOVE (OURS, round 795).
func _cos_start_leg(uid: int, dest: Vector3, speed: float, mult: float = 1.0) -> void:
	var body: Node3D = _cos_bodies.get(uid)
	if body == null:
		return
	var was: Dictionary = _cos_motion.get(uid, {})
	var leg := OtherWalk.to_point(dest, maxf(speed, 1.0), mult)
	leg["moving"] = true
	_plan_body_leg(leg, body.position)
	_cos_motion[uid] = leg
	var dir := Vector2(dest.x - body.position.x, dest.z - body.position.z)
	if dir.length() > 0.01:
		_aim_remote_body(body, Vector3(dir.x, 0.0, dir.y), _cos_front())
	var rec: CosSpawnNet.Record = _cos_recs.get(uid)
	if rec != null and rec.is_pet():
		leg["gait"] = int(was.get("gait", -1)) if bool(was.get("moving", false)) else -1
		_cos_pet_tick(uid, rec, leg)
		return
	if was.is_empty() or not bool(was.get("moving", false)) or (float(was.get("speed", 0.0)) > COS_RUN_ABOVE) != (speed > COS_RUN_ABOVE):
		_cos_gait(uid, BsrReader.AnimationEntry.TYPE_RUN if speed > COS_RUN_ABOVE else BsrReader.AnimationEntry.TYPE_WALK)

## A COS's leg over where it stands (a stop, a re-spawn): its stand clip, and
## a pet's clip rate back to its standing one (round 852, _cos_pet_tick).
func _cos_end_leg(uid: int) -> void:
	var st: Dictionary = _cos_motion.get(uid, {})
	if bool(st.get("moving", false)):
		_cos_gait(uid, BsrReader.AnimationEntry.TYPE_STAND)
		st["moving"] = false
		var rec: CosSpawnNet.Record = _cos_recs.get(uid)
		if rec != null and rec.is_pet():
			_cos_pet_tick(uid, rec, st)
	_cos_motion.erase(uid)

## Round 852: a pet's tick (PetGait, READ CICCos slot 9 c:0x9c59c0): its speed
## is its run speed x its leg's factor; above 20 it runs and its clip plays at
## speed / 50 (at most 1.5) while it moves, else it walks at 1.0; frostbite
## halves the rate. Every frame while it moves, and once as it stops.
func _cos_pet_tick(uid: int, rec: CosSpawnNet.Record, leg: Dictionary) -> void:
	var moving := bool(leg.get("moving", false))
	var s := float(leg.get("speed", rec.run)) * float(leg.get("mult", 1.0))
	var key := _fx_owner_key(uid, SkillNet.OWNER_CHARACTER)
	var mask := int((_abnormal_states.get(key, {}) as Dictionary).get("mask", 0))
	var rate := PetGait.rate(s, moving, (mask & StateLook.BIT_FB) != 0)
	if bool((_state_looks.get(key, {}) as Dictionary).get("frozen", false)):
		rate = 0.0
	if moving:
		var gait := BsrReader.AnimationEntry.TYPE_RUN if PetGait.runs(s) else BsrReader.AnimationEntry.TYPE_WALK
		if int(leg.get("gait", -1)) != gait:
			leg["gait"] = gait
			_cos_gait(uid, gait)
	var assembled: SkinnedBsrAssembler.AssembledCharacter = _cos_assembled.get(uid)
	if assembled != null and is_instance_valid(assembled.skeleton):
		_set_skeleton_clip_speed(assembled.skeleton, rate)
	leg["rate"] = rate

## The rider of a mount, -1 when none rides it.
func _cos_rider_of(uid: int) -> int:
	for rider in _riders:
		if int(_riders[rider]) == uid:
			return int(rider)
	return -1

## 0xB021 for a COS's uid: true when it was one. A ridden COS's move is its
## rider's: the rider's root walks it at the mount's speed (the own player's
## echo is its receipt).
func _cos_move_echo(echo: DestMoveNet.Echo) -> bool:
	var uid := int(echo.uid)
	if NetClient.riding_mount != 0 and uid == NetClient.riding_mount:
		_move_sync.confirm(echo.kind, echo.dest_world, echo.angle, _own_leg_free_ms(echo))
		return true
	if not _cos_recs.has(uid):
		return false
	var rider := _cos_rider_of(uid)
	if rider >= 0 and _other_bodies.has(rider):
		var leg := OtherWalk.to_point(echo.dest_world, _other_speed(rider)) if echo.kind == DestMoveNet.KIND_DESTINATION \
			else OtherWalk.on_heading(echo.angle, _other_speed(rider))
		var rbody: Node3D = _other_bodies[rider]
		rbody.position = OtherWalk.start_at(rbody.position, echo.source_world, echo.has_source)
		# Round 846: the rider catches up as a body on foot does (OtherWalk).
		if echo.kind == DestMoveNet.KIND_DESTINATION:
			leg["mult"] = OtherWalk.catch_up(rbody.position, echo.source_world, echo.has_source, echo.dest_world)
		_start_other_leg(rider, leg)
		return true
	var rec: CosSpawnNet.Record = _cos_recs[uid]
	if echo.kind == DestMoveNet.KIND_DESTINATION:
		var body: Node3D = _cos_bodies.get(uid)
		var mult := 1.0
		if body != null:
			# Round 852: the 0xB021 handler is every object's (READ round 846,
			# FUN_008a5750 -> FUN_009e11e0 / FUN_009e0550): a COS drawn more
			# than 50 from the source is put there (round 796: on its new
			# ground, not the height it had), a nearer one walks on from where
			# it is drawn and catches up (OtherWalk) -- the factor a pet's
			# speed, gait and clip rate take (PetGait). Before, the monsters'
			# 32 and no catch-up.
			var start := OtherWalk.start_at(body.position, echo.source_world, echo.has_source)
			if start != body.position:
				var gy := _cos_ground(echo.source_world)
				body.position = Vector3(echo.source_world.x, body.position.y if is_nan(gy) else gy, echo.source_world.z)
				_cos_ground_missed(uid, gy)
			mult = OtherWalk.catch_up(body.position, echo.source_world, echo.has_source, echo.dest_world)
		if _qa_cos_trace:
			print("QA COS leg %d ms %d to (%.1f,%.1f) speed %.1f x%.2f" % [uid, Time.get_ticks_msec(), echo.dest_world.x, echo.dest_world.z, rec.run, mult])
		_cos_start_leg(uid, echo.dest_world, rec.run, mult)
	elif _qa_cos_trace:
		print("QA COS leg %d ms %d heading (not walked) speed %.1f" % [uid, Time.get_ticks_msec(), rec.run])
	return true

## 0xB023 for a COS's uid: true when it was one.
func _cos_move_stop(stop: DestMoveNet.Stop) -> bool:
	var uid := int(stop.uid)
	if NetClient.riding_mount != 0 and uid == NetClient.riding_mount:
		if not _own_arrow_stop(stop.world, RemoteFacing.from_wire_angle(stop.angle)):
			_apply_own_correction(stop.world, RemoteFacing.from_wire_angle(stop.angle))
		return true
	if not _cos_recs.has(uid):
		return false
	# Round 846: a ridden COS's stop is its rider's (the rider's root walks the
	# mount's legs, _cos_move_echo): before, it was dropped, and a rider's run
	# on the arrow keys never ended on anyone else's screen.
	var rider := _cos_rider_of(uid)
	if rider >= 0 and _other_bodies.has(rider):
		if _qa_move_log:
			print("MOVE recv %d ms=%d 0xB023 (its mount %d) pos=(%.3f,%.3f)" % [rider, Time.get_ticks_msec(), uid, stop.world.x, stop.world.z])
		_other_stop_at(rider, stop.world, RemoteFacing.from_wire_angle(stop.angle))
		return true
	var body: Node3D = _cos_bodies.get(uid)
	if _qa_cos_trace:
		print("QA COS stop %d ms %d at (%.1f,%.1f)" % [uid, Time.get_ticks_msec(), stop.world.x, stop.world.z])
	if body != null and _cos_rider_of(uid) < 0:
		# Round 796: the stop's own ground, not the height the body had --
		# a pet put down beside its owner from far away kept the old one and
		# hung in the air.
		var y := _cos_ground(stop.world)
		body.position = Vector3(stop.world.x, stop.world.y if is_nan(y) else y, stop.world.z)
		_cos_ground_missed(uid, y)
		body.rotation.y = RemoteFacing.yaw_of(RemoteFacing.from_wire_angle(stop.angle), _cos_front())
		_cos_end_leg(uid)
	return true

## 0x3036 for a COS (an ability pet's pick, type 38 -- the players' pickup
## type, MEASURED in the rabbit's and myowon's default groups).
func _cos_pick_motion(uid: int, heading: float) -> bool:
	if not _cos_bodies.has(uid):
		return false
	var body: Node3D = _cos_bodies[uid]
	body.rotation.y = RemoteFacing.yaw_of(heading, _cos_front())
	_cos_play(uid, BsrReader.AnimationEntry.TYPE_PICKUP)
	return true

## Every physics frame: the waiting bodies whose template is in, and the
## walking ones' steps (MonsterMotion.step) with their ground.
func _cos_step(delta: float) -> void:
	for uid in _cos_waiting.keys():
		if _monster_templates.has(String(_cos_waiting[uid])) and _cos_recs.has(uid):
			var rec: CosSpawnNet.Record = _cos_recs[uid]
			_cos_waiting.erase(uid)
			_cos_build_body(rec, NetClient.spawn_world(rec.region, rec.local_position))
	# Round 796: a body put down where no ground was loaded yet (an owner's
	# teleport arrives before its region) takes the ground once it comes, as
	# a monster's does (_monster_heights_pending).
	for uid in _cos_ground_pending.keys():
		var pbody: Node3D = _cos_bodies.get(uid)
		if pbody == null or not is_instance_valid(pbody) or _cos_rider_of(int(uid)) >= 0:
			_cos_ground_pending.erase(uid)
			continue
		var gy := _cos_ground(pbody.position)
		if not is_nan(gy):
			pbody.position.y = gy
			_cos_ground_pending.erase(uid)
	for uid in _cos_motion.keys():
		var body: Node3D = _cos_bodies.get(uid)
		if body == null or not is_instance_valid(body):
			_cos_motion.erase(uid)
			continue
		var st: Dictionary = _cos_motion[uid]
		if not bool(st["moving"]):
			continue
		# Round 852: every body's leg (OtherWalk.step, the catch-up factor
		# included); one that meets a wall walks the navigation graph and the
		# wall ends it there (BodyWalk; READ c:0x9e0fca, every mover's step;
		# round 851's CosWalk).
		if st.has("plan"):
			_plan_body_leg(st, body.position)
		var r := OtherWalk.step(st, body.position, delta)
		var at: Vector3 = r["pos"]
		var arrived := bool(r["done"])
		var walled := false
		if bool(st.get("walled", false)):
			var walked := _body_walk_step(st, body.position, Vector2(at.x, at.z))
			at.x = walked.x
			at.z = walked.y
			walled = bool(st.get("blocked", false))
		var y := _cos_ground(Vector3(at.x, body.position.y, at.z))
		body.position = Vector3(at.x, body.position.y if is_nan(y) else y, at.z)
		var rec: CosSpawnNet.Record = _cos_recs.get(uid)
		if walled or arrived:
			st["moving"] = false
			_cos_gait(uid, BsrReader.AnimationEntry.TYPE_STAND)
			if _qa_cos_trace and walled:
				print("QA COS wall %d ms %d at (%.2f,%.2f)" % [int(uid), Time.get_ticks_msec(), at.x, at.z])
		if rec != null and rec.is_pet():
			_cos_pet_tick(uid, rec, st)
	if _qa_cos_gait:
		_qa_cos_gait_log()

## QA (round 852): OPENSRO_QA_COS_GAIT=1 logs, every physics tick, each COS
## body's playing clip as the clip list has it (its name, and its clock's
## advance over the clip tick's own clock since the last line: the rate it
## really plays at), against its leg (moving, gait, speed x factor, the
## PetGait rate asked) and its record's run speed (0x30D0's).
var _qa_cos_gait := OS.get_environment("OPENSRO_QA_COS_GAIT") != ""
var _qa_cos_gait_last := {}

func _qa_cos_gait_log() -> void:
	for uid in _cos_bodies:
		var a: SkinnedBsrAssembler.AssembledCharacter = _cos_assembled.get(uid)
		var rec: CosSpawnNet.Record = _cos_recs.get(uid)
		if a == null or rec == null or not is_instance_valid(a.skeleton):
			continue
		var clip := "-"
		var clock := NAN
		for entry in _animated:
			if entry[0] != a.skeleton:
				continue
			clip = (entry[1] as BanReader.ParsedAnimation).animation_name
			clock = _idle_anim_time + float(entry[3]) if entry[4] else _idle_anim_time - float(entry[5])
			break
		var measured := NAN
		var last = _qa_cos_gait_last.get(uid)
		if last != null and String(last[0]) == clip and _idle_anim_time > float(last[2]):
			measured = (clock - float(last[1])) / (_idle_anim_time - float(last[2]))
		_qa_cos_gait_last[uid] = [clip, clock, _idle_anim_time]
		var st: Dictionary = _cos_motion.get(uid, {})
		var body: Node3D = _cos_bodies[uid]
		print("QA COS GAIT %d ms %d kind %d pos (%.2f,%.2f) moving %s clip %s rate %s asked %.3f speed %.2f x%.2f run %.2f" % [
			int(uid), Time.get_ticks_msec(), rec.kind, body.global_position.x, body.global_position.z,
			"1" if bool(st.get("moving", false)) else "0", clip,
			"-" if is_nan(measured) else "%.3f" % measured, float(st.get("rate", 1.0)),
			float(st.get("speed", rec.run)), float(st.get("mult", 1.0)), rec.run])

## Every frame, after the walkers moved: each mount under its rider's root,
## and the rider's skeleton on the mount's saddle (READ ICharactor::
## FUN_009d05d0: rider world = saddle bone x mount world, no offset).
func _cos_place_riders(delta: float = 0.0) -> void:
	for rider in _riders.keys():
		var uid := int(_riders[rider])
		var mount: Node3D = _cos_bodies.get(uid)
		var assembled: SkinnedBsrAssembler.AssembledCharacter = _cos_assembled.get(uid)
		var root := _rider_root(int(rider))
		var rskel := _rider_skeleton(int(rider))
		if mount == null or not is_instance_valid(mount) or root == null or rskel == null:
			continue
		mount.global_position = root.global_position
		# The root's yaw is its heading (the player's skeleton is turned PI
		# under it); the mount's skeleton is not, so its front is taken off.
		mount.rotation.y = RemoteFacing.yaw_of(RemoteFacing.heading_of_yaw(root.rotation.y, 0.0), _cos_front())
		# Round 813: the mount leans with the ground (SlopeTilt), and the
		# saddle the rider is seated on below leans with it (READ: the rider's
		# world is the saddle x the mount's, ICharactor::FUN_009d05d0).
		var tilt_entry = _slope_tilts.get(mount.get_instance_id())
		if tilt_entry != null:
			_slope_tilt_body(tilt_entry, delta)
		# The mount's gait is its rider's: walk or run while the rider moves,
		# by the rider's Walk/Run (round 798; see _rider_walking).
		var gait := BsrReader.AnimationEntry.TYPE_STAND
		if _rider_moving(int(rider)):
			gait = BsrReader.AnimationEntry.TYPE_WALK if _rider_walking(int(rider)) else BsrReader.AnimationEntry.TYPE_RUN
		if int(mount.get_meta("cos_gait", -1)) != gait:
			mount.set_meta("cos_gait", gait)
			_cos_mount_gait(uid, gait)
		# Round 796: the rider's plate over the mount, and its weapon and
		# shield off -- re-applied to a skeleton a re-dress rebuilt.
		_raise_rider_plate(int(rider), mount, true)
		EfpEffect.mounts[root.get_instance_id()] = mount
		# Round 850: one of HeldItems' reasons; _step_held re-applies it to a
		# skeleton a re-dress rebuilt.
		_held_set(int(rider), HeldItems.REASON_RIDE, true)
		if assembled == null or not is_instance_valid(assembled.skeleton):
			continue
		var bone := assembled.skeleton.find_bone("saddle")
		if bone < 0:
			continue
		if not _rider_rest.has(rider):
			_rider_rest[rider] = rskel.transform
			_rider_group(int(rider), true)
		rskel.global_transform = assembled.skeleton.global_transform * assembled.skeleton.get_bone_global_pose(bone)

## The root node a rider walks: the own player, or another's body.
func _rider_root(rider: int) -> Node3D:
	_sync_own_id()
	if rider == _own_id():
		return player
	return _other_bodies.get(rider)

## The rider's skeleton (its drawn body).
func _rider_skeleton(rider: int) -> Skeleton3D:
	if rider == _own_id():
		return _player_skeleton
	var gait: Dictionary = _other_gaits.get(rider, {})
	if gait.is_empty() or not is_instance_valid(gait.get("skeleton")):
		return null
	return gait["skeleton"]

## Round 798: whether a rider is in Walk. Retail puts a rider's Walk/Run on
## its MOUNT (READ: 0x30BF kind 1, FUN_008a80a0 case 1, calls FUN_009cec60,
## which answers the mount -- FUN_009ce930, +0x2ac -- while the body rides,
## and GlobalDataManager::FUN_009ca430 sets that object's run flag +0x25d and
## its speed index +0x678, 0 walk / 1 run, restarting a moving state 9). The
## mount's moving clip is then its walk, which is why a pegasus only flies at
## a run. OpenSRO keeps the flag on the rider (_walk_mode, _other_walking),
## the same bit. INFERRED: a body that mounts already walking keeps walking
## (the server's motionSpeed takes the COS walk speed for it, motion.go).
func _rider_walking(rider: int) -> bool:
	if rider == _own_id():
		return _walk_mode
	return _other_walking.has(rider)

## Round 798: a rider's mount's walk speed, 0.0 when it does not ride.
func _rider_walk_speed(rider: int) -> float:
	if not _riders.has(rider):
		return 0.0
	var rec: CosSpawnNet.Record = _cos_recs.get(int(_riders[rider]))
	return rec.walk if rec != null else 0.0

## A ridden mount's loop: its rider's walk or run (the play and stop calls go
## to the mount too, READ c:0x9cfb40 / c:0x9cfc10). Round 853: a model with no
## walk clip plays nothing while its rider walks and holds its pose
## (_body_gait, READ c:0xa59680 / c:0xa5b550); before, OpenSRO ran it (OURS).
func _cos_mount_gait(uid: int, gait: int) -> void:
	_cos_gait(uid, gait)

func _rider_moving(rider: int) -> bool:
	if rider == _own_id():
		return _has_move_target
	return _other_legs.has(rider)

## The rider plays its "cart" group while it rides (READ CObjCharacter::
## RefreshAnimationGroup 0xa5bd10 forces it whenever the body has a mount).
func _rider_group(rider: int, on: bool) -> void:
	if rider == _own_id():
		return # the own gait reads _riders (_player_anim_group)
	var gait: Dictionary = _other_gaits.get(rider, {})
	if gait.is_empty():
		return
	if on:
		if not gait.has("foot_group"):
			gait["foot_group"] = gait["group"]
		gait["group"] = "cart"
	elif gait.has("foot_group"):
		gait["group"] = gait["foot_group"]
		gait.erase("foot_group")
	var moving := bool(gait["moving"])
	gait["moving"] = not moving
	_set_other_gait(rider, moving)

## The own player's animation group: "cart" while it rides.
func _player_anim_group() -> String:
	if _riders.has(_own_id()):
		return "cart"
	return _player_weapon_group

## Round 808: a ridden pet does not fidget (FIDGET_RIDDEN_META, OURS).
func _cos_fidget_ridden(uid: int, on: bool) -> void:
	var a: SkinnedBsrAssembler.AssembledCharacter = _cos_assembled.get(uid)
	if a == null or not is_instance_valid(a.skeleton):
		return
	if on:
		a.skeleton.set_meta(FIDGET_RIDDEN_META, true)
		_end_body_fidget(a.skeleton)
	elif a.skeleton.has_meta(FIDGET_RIDDEN_META):
		a.skeleton.remove_meta(FIDGET_RIDDEN_META)

## A rider takes the mount (0xB0CB flag 1, or a spawn record's ride state).
func _cos_seat(rider: int, uid: int) -> void:
	if int(_riders.get(rider, 0)) == uid:
		return
	if _riders.has(rider):
		_cos_unseat(rider)
	_riders[rider] = uid
	var rec: CosSpawnNet.Record = _cos_recs.get(uid)
	var seat_body: Node3D = _cos_bodies.get(uid)
	if rec != null and seat_body != null and is_instance_valid(seat_body):
		_cos_label(seat_body, rec)
	_cos_fidget_ridden(uid, true)
	if rider == _own_id():
		NetClient.riding_mount = uid
		if rec != null and rec.run > 0.0:
			if _foot_move_speed < 0.0:
				_foot_move_speed = _move_speed
			_move_speed = rec.run
	elif rec != null and rec.run > 0.0:
		_other_speeds[rider] = rec.run
	print("World3D: %s mounted COS %d" % ["the player" if rider == _own_id() else "player %d" % rider, uid])

## A rider leaves the mount: its skeleton back under its root.
func _cos_unseat(rider: int) -> void:
	if not _riders.has(rider):
		return
	var uid := int(_riders[rider])
	_riders.erase(rider)
	_cos_fidget_ridden(uid, false)
	var rskel := _rider_skeleton(rider)
	var unseat_root := _rider_root(rider)
	if unseat_root != null:
		EfpEffect.mounts.erase(unseat_root.get_instance_id())
	# Round 850: back unless an emote or a stall still holds them.
	_held_set(rider, HeldItems.REASON_RIDE, false)
	var plate_mount: Node3D = _cos_bodies.get(uid)
	if plate_mount != null and is_instance_valid(plate_mount):
		_raise_rider_plate(rider, plate_mount, false)
	else:
		_rider_plate_y.erase(rider)
	if _rider_rest.has(rider):
		if rskel != null and is_instance_valid(rskel):
			rskel.transform = _rider_rest[rider]
		_rider_rest.erase(rider)
		_rider_group(rider, false)
	if rider == _own_id():
		NetClient.riding_mount = 0
		if _foot_move_speed > 0.0:
			_move_speed = _foot_move_speed
			_foot_move_speed = -1.0
	var mount: Node3D = _cos_bodies.get(uid)
	if mount != null and is_instance_valid(mount):
		mount.remove_meta("cos_gait")
		_cos_gait(uid, BsrReader.AnimationEntry.TYPE_STAND)
		if _cos_recs.has(uid):
			_cos_label(mount, _cos_recs[uid])
	print("World3D: %s dismounted COS %d" % ["the player" if rider == _own_id() else "player %d" % rider, uid])

## 0xB0CB: a mount or dismount (to everyone holding the rider), or a refusal.
func _on_ride_changed(d: Dictionary) -> void:
	_sync_own_id()
	if not bool(d.get("ok", false)):
		var code := int(d.get("code", 0))
		var text := _cos_ride_error_text(code)
		if text != "":
			_log_system(text)
		return
	var rider_uid := int(d["rider"])
	var rider := _own_id() if _own_id() >= 0 and rider_uid == (_own_id() & 0xffffffff) else _other_by_uid(rider_uid)
	if rider < 0:
		return
	if bool(d["mounted"]):
		_cos_seat(rider, int(d["cos"]))
	else:
		_cos_unseat(rider)

## The ride refusals' texts, error category 0xe (READ c:0x7b9fc6, table
## c:0x7bba88).
func _cos_ride_error_text(code: int) -> String:
	var key := ""
	match code:
		4: key = "UIIT_MSG_CMSERR_TOO_FAR"
		7: key = "UIIT_MSG_CMSERR_ITS_NOT_MY_COS_OBJ"
		8: key = "UIIT_MSG_CMSERR_CANT_RIDE_ON_IT"
		10: key = "UIIT_MSG_CMSERR_HUNTER_CANT_RIDE_CART"
		11: key = "UIIT_MSG_COS_CAN_NOT_RIDE_BATTLE"
		12: key = "UIIT_MSG_COSERR_CANT_RIDE"
	if key == "" or _ui_text_table == null:
		return ""
	return _ui_text_table.get_text(key, "")

## 0x30D0: a character's speeds (a dismount gives the rider its own back).
func _on_speed_changed(d: Dictionary) -> void:
	_sync_own_id()
	var uid := int(d.get("uid", 0))
	var run := float(d.get("run", 0.0))
	if _own_id() >= 0 and uid == (_own_id() & 0xffffffff):
		if run > 0.0 and not _riders.has(_own_id()):
			_move_speed = run
			_server_run_speed = int(run)
			_foot_move_speed = -1.0
		return
	# Round 851: a pet's run speed follows its owner's (READ s:0x548a30, the
	# server's recompute broadcasts it, s:0x4aa4ce): its record's run and the
	# leg it walks take it.
	if _cos_recs.has(uid) and run > 0.0:
		var rec: CosSpawnNet.Record = _cos_recs[uid]
		rec.run = run
		if _cos_motion.has(uid):
			(_cos_motion[uid] as Dictionary)["speed"] = maxf(run, 1.0)
		if _qa_cos_trace:
			print("COS speed %d run=%.2f" % [uid, run])
		return
	var id := _other_by_uid(uid)
	if id >= 0 and run > 0.0:
		_other_speeds[id] = run

## A COS's HP (0x3057's flag 1): its owner's windows.
func _on_cos_hp(uid: int, hp: int) -> void:
	# Round 805's QA reads a pet potion's heal off this line.
	if NetClient.cos_own.has(uid):
		print("World3D: own COS %d HP %d" % [uid, hp])

## 0x3054 (round 859, READ c:0x8a7020): u32 an object in view has levelled.
## A COS plays SYSTEM_PET_LEVEL_UP (snd_levup when it is this player's own),
## anything else SYSTEM_LEVELUP (snd_levup when it is this player);
## SystemEffects has the rules. NetClient names the signal cos_level_up: the
## opcode was first met as the pet's.
func _on_cos_level_up(uid: int) -> void:
	var cos_body = _cos_bodies.get(uid)
	if cos_body != null and is_instance_valid(cos_body):
		var own_cos := NetClient.cos_own.has(uid)
		print("World3D: COS %d levelled up%s" % [uid, " (this player's)" if own_cos else ""])
		_play_system_fx(SystemEffects.level_up_effect(true), cos_body, "0x3054 COS %d" % uid)
		if SystemEffects.level_up_sounds(true, false, own_cos):
			UiSounds.level_up("COS %d level up" % uid)
		return
	if uid == (_own_id() & 0xffffffff):
		_own_level_up_fx("0x3054")
		return
	var id := _other_by_uid(uid)
	var body = _other_bodies.get(id) if id >= 0 else null
	if body == null or not is_instance_valid(body):
		print("World3D: 0x3054 for %d: not in view -- nothing plays" % uid)
		return
	print("World3D: 0x3054: player %d levelled up -- %s" % [id, SystemEffects.LEVELUP])
	_crowd_wake_node(body)
	_play_system_fx(SystemEffects.LEVELUP, body, "0x3054 player %d" % id)

## Round 859: this player's level-up effect and snd_levup, once for a level-up
## told by both OpLevelUp and 0x3054.
var _own_level_up_ms := -1
func _own_level_up_fx(why: String) -> void:
	var now := Time.get_ticks_msec()
	if not SystemEffects.own_level_up_is_new(_own_level_up_ms, now):
		print("World3D: level-up (%s) already shown %d ms ago" % [why, now - _own_level_up_ms])
		return
	_own_level_up_ms = now
	UiSounds.level_up("level up (%s)" % why)
	_play_level_up_effect()

## Round 859: a system decoration on `body` (SkillEffects.play_system): its
## rows' effects, one-shot. The Particles archive is opened first.
func _play_system_fx(effect_id: String, body: Node3D, why: String) -> int:
	if body == null or not is_instance_valid(body):
		return 0
	if _open_particles_pk2_if_set() == null:
		return 0
	var n := SkillEffects.play_system(effect_id, body).size()
	print("World3D: %s plays %s: %d effect(s)" % [why, effect_id, n])
	return n

## A two-field COS reply's refusal (0xB0C6, 0xB116, 0xB117): category 0xc.
func _on_cos_reply(op: int, d: Dictionary) -> void:
	if bool(d.get("ok", false)):
		return
	print("World3D: COS reply 0x%04x refused, code 0x%x" % [op, int(d.get("code", 0))])

func _on_cos_command_result(d: Dictionary) -> void:
	if not bool(d.get("ok", false)) and int(d.get("code", 0)) != 0:
		print("World3D: COS command %d refused, code 0x%x" % [int(d.get("type", 0)), int(d.get("code", 0))])

## A world entry or zone change: the COS in view start over.
func _cos_clear() -> void:
	for rider in _riders.keys():
		if int(rider) != _own_id():
			_cos_unseat(int(rider))
	for uid in _cos_bodies.keys():
		_cos_free_body(int(uid))
	_cos_recs.clear()
	_cos_waiting.clear()
	_cos_summon_pending.clear()
	_cos_ground_pending.clear()
	EfpEffect.mounts.clear()

## QA (round 796): each COS body's position at the last state line.
var _qa_cos_last := {}
## QA (round 851): OPENSRO_QA_COS_TRACE=1 logs every COS body's drawn place
## every 10 ticks and each COS leg, stop and speed the server sends.
var _qa_cos_trace := OS.get_environment("OPENSRO_QA_COS_TRACE") != ""

## QA (round 795): OPENSRO_QA_COS="<tick>:<action>;..." drives the COS through
## the client's own sends (needs a server): use=<RefItemID> (the first bag
## slot holding it: a pet item, a ride scroll), feed=<RefItemID> (a pet's
## consumable on the first COS, OPTION_COS_TARGET), ride / dismount (the
## first ride or transport), unsummon / terminate / follow (the first COS of
## that kind), name=<text> (the first pet), pick=<flags> (the first ability
## pet's pickup settings), walk=<deg> (the QA walk's heading; walk=off),
## goto=<dx>,<dz> (a click move that far from the player), walkrun (the
## Walk/Run toggle, round 798).
## Every tick it logs "QA COS" lines; OPENSRO_QA_COS_LOG=1 adds a state line
## every 60 ticks.
var _qa_cos_spec := OS.get_environment("OPENSRO_QA_COS")

func _qa_cos_first(kinds: Array) -> int:
	for uid in NetClient.cos_own:
		var d: CosNet.Data = NetClient.cos_own[uid]
		if d.kind in kinds:
			return int(uid)
	return 0

## QA (round 860): what each MeshInstance3D under `node` draws -- its name,
## its mesh's class, whether it is skinned, and per surface the material
## bound (the override, else the surface's) with its textures and colour:
## `name:ArrayMesh/skin{Standard tex 512x512 col (1,1,1,1)}`. "none" is a
## surface with no material at all (Godot's default white).
func _qa_draw_census(node: Node) -> String:
	var out: Array = []
	for n in node.find_children("*", "MeshInstance3D", true, false):
		var mi := n as MeshInstance3D
		if mi.mesh == null:
			out.append("%s:no mesh" % mi.name)
			continue
		var surfs: Array = []
		for s in mi.mesh.get_surface_count():
			var mat: Material = mi.material_override
			if mat == null:
				mat = mi.get_surface_override_material(s)
			if mat == null:
				mat = mi.mesh.surface_get_material(s)
			surfs.append(_qa_material_census(mat))
		out.append("%s:%s%s%s{%s}" % [mi.name, mi.mesh.get_class(), "/skin" if mi.skin != null else "",
			"" if mi.is_visible_in_tree() else "/hidden", "; ".join(surfs)])
	return ", ".join(out)

func _qa_material_census(mat: Material) -> String:
	if mat == null:
		return "none"
	var texs: Array = []
	var col := ""
	if mat is BaseMaterial3D:
		var bm := mat as BaseMaterial3D
		var t := bm.albedo_texture
		texs.append("albedo " + ("%dx%d" % [t.get_width(), t.get_height()] if t != null else "null"))
		col = " col %s" % str(bm.albedo_color)
		if bm.shading_mode == BaseMaterial3D.SHADING_MODE_UNSHADED:
			col += " unshaded"
	elif mat is ShaderMaterial:
		var sm := mat as ShaderMaterial
		if sm.shader != null:
			for u in sm.shader.get_shader_uniform_list():
				var v = sm.get_shader_parameter(u["name"])
				if v is Texture2D:
					texs.append("%s %dx%d" % [u["name"], (v as Texture2D).get_width(), (v as Texture2D).get_height()])
				elif int(u["type"]) == TYPE_OBJECT and v == null:
					texs.append("%s null" % u["name"])
	var next := " +next" if mat.next_pass != null else ""
	return "%s %s%s%s" % [mat.get_class(), " ".join(texs), col, next]

func _qa_cos_step() -> void:
	if not NetClient.is_connected_to_server():
		return
	if _qa_cos_trace and _qa_tick % 10 == 0:
		# Round 851: every COS body where the client draws it, with the
		# player's place, against the server's "cos: leg" lines.
		var drawn: Array = []
		for uid in _cos_bodies:
			var cb: Node3D = _cos_bodies[uid]
			var st: Dictionary = _cos_motion.get(uid, {})
			drawn.append("%d(%.1f,%.1f)%s" % [int(uid), cb.global_position.x, cb.global_position.z, " moving" if bool(st.get("moving", false)) else ""])
		print("QA COS drawn tick %d ms %d player (%.1f,%.1f) %s" % [_qa_tick, Time.get_ticks_msec(), player.global_position.x, player.global_position.z, " ".join(drawn)])
	if OS.get_environment("OPENSRO_QA_COS_LOG") != "" and _qa_tick % 60 == 0:
		var parts: Array = []
		for uid in _cos_bodies:
			var b: Node3D = _cos_bodies[uid]
			var meshes := 0
			var shown := 0
			var box := AABB()
			for mi in b.find_children("*", "MeshInstance3D", true, false):
				meshes += 1
				if (mi as MeshInstance3D).is_visible_in_tree():
					shown += 1
				var gb := (mi as MeshInstance3D).global_transform * (mi as MeshInstance3D).get_aabb()
				box = gb if box.size == Vector3.ZERO else box.merge(gb)
			# Round 796: where the model's -Z front points, the step since the
			# last line (front . step > 0 runs forwards), the ground under it,
			# and its two plate texts.
			var front := -b.global_transform.basis.z
			var was: Vector3 = _qa_cos_last.get(uid, b.global_position)
			var stepv := b.global_position - was
			_qa_cos_last[uid] = b.global_position
			var fwd := Vector2(front.x, front.z).normalized().dot(Vector2(stepv.x, stepv.z).normalized()) if Vector2(stepv.x, stepv.z).length() > 1.0 else 0.0
			var lbl := b.get_node_or_null("Label") as Label3D
			var olbl := b.get_node_or_null("OwnerLabel") as Label3D
			# Round 798: the loop the body plays (a ridden mount's walk or run).
			var clip := "-"
			var asm: SkinnedBsrAssembler.AssembledCharacter = _cos_assembled.get(uid)
			if asm != null:
				for e in _animated:
					if (e as Array)[0] == asm.skeleton and (e as Array)[1] != null:
						clip = ((e as Array)[1] as BanReader.ParsedAnimation).animation_name
			parts.append("%d@(%.2f,%.1f,%.2f) meshes %d shown %d box %s front.step %.2f ground %.1f name '%s' owner '%s' offset %.0f clip %s draw [%s]" % [int(uid), b.global_position.x, b.global_position.y,
				b.global_position.z, meshes, shown, str(box), fwd, _cos_ground(b.global_position),
				lbl.text if lbl != null else "-", olbl.text if olbl != null else "-", olbl.offset.y if olbl != null else 0.0, clip,
				_qa_draw_census(b)])
		var held := ""
		if _player_skeleton != null:
			for c in _player_skeleton.get_children():
				var vs := int((c as Node).get_meta(CharacterAppearance.VISUAL_SLOT_META, -1))
				if vs == CharacterAppearance.SLOT_WEAPON or vs == CharacterAppearance.SLOT_SHIELD:
					held += " slot%d=%s" % [vs, "shown" if (c as Node3D).visible else "hidden"]
		for key in SkillEffects._auras:
			var au: Dictionary = SkillEffects._auras[key]
			if au.get("host") == player:
				for fx in au["fx"]:
					if is_instance_valid(fx):
						held += " aura %d at dy %.1f off (%.1f,%.1f)" % [int(au["skill"]), (fx as EfpEffect).placed_at().y - player.global_position.y,
							(fx as EfpEffect).placed_at().x - player.global_position.x, (fx as EfpEffect).placed_at().z - player.global_position.z]
		var pplate := player.get_node_or_null("Name") as Label3D
		var pfront := -_player_skeleton.global_transform.basis.z if _player_skeleton != null else Vector3.ZERO
		print("QA COS state tick %d: own %s bodies [%s] riders %s player (%.0f,%.0f) speed %.0f gait %.1f %s plate y %.1f held%s rider front (%.2f,%.2f)" % [_qa_tick,
			str(NetClient.cos_own.keys()), ", ".join(parts), str(_riders), player.global_position.x, player.global_position.z, _move_speed,
			_gait_speed(), "walking" if _walk_mode else "running", pplate.position.y if pplate != null else -1.0, held, pfront.x, pfront.z])
	for entry in _qa_cos_spec.split(";", false):
		var at := String(entry).split(":", true, 1)
		if at.size() != 2:
			continue
		var tick := int(at[0])
		if _qa_tick == tick - 20:
			NetClient.list_inventory(NetClient.current_character_name)
		if _qa_tick != tick:
			continue
		var kv := at[1].split("=", true, 1)
		var action := kv[0]
		var arg := kv[1] if kv.size() > 1 else ""
		match action:
			"use", "feed":
				var found := false
				for s in _inventory_slots:
					if s.item_id == int(arg):
						if action == "use":
							NetClient.use_item(NetClient.current_character_name, s.slot_index)
						else:
							NetClient.use_item_option(NetClient.current_character_name, s.slot_index,
								UseItemNet.OPTION_COS_TARGET, _qa_cos_first([CosNet.KIND_GROWTH, CosNet.KIND_ABILITY]))
						print("QA COS: tick %d %s item %d from bag slot %d" % [_qa_tick, action, int(arg), s.slot_index])
						found = true
						break
				if not found:
					print("QA COS: tick %d item %d is not in the bag" % [_qa_tick, int(arg)])
			"ride":
				var uid := _qa_cos_first([CosNet.KIND_RIDE, CosNet.KIND_TRANSPORT])
				print("QA COS: tick %d ride %d" % [_qa_tick, uid])
				NetClient.send_cos_ride(true, uid)
			"dismount":
				print("QA COS: tick %d dismount %d" % [_qa_tick, NetClient.riding_mount])
				NetClient.send_cos_ride(false, NetClient.riding_mount)
			"unsummon":
				var uid := _qa_cos_first([CosNet.KIND_GROWTH, CosNet.KIND_ABILITY])
				print("QA COS: tick %d unsummon %d" % [_qa_tick, uid])
				NetClient.send_cos_unsummon(uid)
			"terminate":
				var uid := _qa_cos_first([CosNet.KIND_RIDE, CosNet.KIND_TRANSPORT])
				print("QA COS: tick %d terminate %d" % [_qa_tick, uid])
				NetClient.send_cos_terminate(uid)
			"follow":
				NetClient.send_cos_follow(_qa_cos_first([CosNet.KIND_GROWTH, CosNet.KIND_ABILITY]))
			"name":
				var uid := _qa_cos_first([CosNet.KIND_GROWTH, CosNet.KIND_ABILITY])
				print("QA COS: tick %d name %d %s" % [_qa_tick, uid, arg])
				NetClient.send_cos_name(uid, arg)
			"pick":
				var uid := _qa_cos_first([CosNet.KIND_ABILITY])
				print("QA COS: tick %d pickup flags %d on %d" % [_qa_tick, int(arg), uid])
				NetClient.send_cos_setting(uid, CosNet.SETTING_PICKUP, int(arg))
			"walk":
				_qa_walk = "" if arg == "off" else arg
				print("QA COS: tick %d walk %s" % [_qa_tick, arg])
			"snap":
				# Round 851: a frame of a real-time run (QA_SHOT_REALTIME writes
				# none) into OPENSRO_QA_SNAP_DIR as <arg>.png.
				var sdir := OS.get_environment("OPENSRO_QA_SNAP_DIR")
				var simg := get_viewport().get_texture().get_image()
				if sdir != "" and simg != null:
					simg.save_png(sdir.path_join("%s.png" % arg))
				print("QA COS: tick %d snap %s" % [_qa_tick, arg])
			"walkrun":
				# Round 798: the Walk/Run toggle (0x704F), as the action button.
				print("QA COS: tick %d walkrun %s" % [_qa_tick, _request_walk_run()])
			"cmd":
				# A GM line at this tick (e.g. cmd=/spawn mangyang 4).
				print("QA COS: tick %d cmd %s" % [_qa_tick, arg])
				NetClient.gm_command(NetClient.current_character_name, arg.trim_prefix("/"), 0)
			"goto":
				# A click move by (dx, dz) from where the player stands: the
				# move-order path (0x7021, or 0x70C5 while riding).
				var d := arg.split(",")
				if d.size() == 2:
					_move_target = player.position + Vector3(float(d[0]), 0.0, float(d[1]))
					_has_move_target = true
					_move_heading_run = false
					print("QA COS: tick %d goto (%.0f,%.0f)" % [_qa_tick, _move_target.x, _move_target.z])

# --- The ability pet's pick and the growth pet's attack (round 795) ---------
#
# Both are the CLIENT's in retail (docs/protocol/pets.md, "Round 795"):
#   - CDropItemManager (c:0xeedd14, the scan c:0x8afb50): every frame, for
#     each own ability pet whose grab is on (PetOption 0x80), the nearest
#     eligible ground item within 500 of the pet (squared 250000.0,
#     .rdata 0xddeff8) -- mine unless "grab all" (0x40), gold / equipment /
#     other by bits 1 / 2 / 4, never trade goods (3/3/8) -- is asked for with
#     0x70C5 {pet, 8, item}, one request out per pet at a time. A refused item
#     keeps its "requested" mark (the reply handler c:0x8af960 compares a
#     byte with u16 codes, so its retry branches never run: READ), and is not
#     asked for again.
#   - A growth pet in attack mode (PetOption 1) takes the target of its
#     owner's own offensive action on a monster when it has none (c:0x8a6311
#     on 0xB070; OURS: at the action's send), and forgets it when the target
#     is gone or the attack is refused.

## pet uid -> the item asked for (0: none out).
var _cos_pick_out := {}
## ground item id -> true once asked for (CDropItemManager's flag 2).
var _cos_pick_asked := {}
## pet uid -> the monster it was sent at.
var _cos_attack_target := {}

## The pick scan's radius (READ: 250000.0 squared, 0xddeff8).
const COS_PICK_RADIUS := 500.0

func _cos_connect_ai() -> void:
	NetClient.own_offensive.connect(_on_own_offensive)
	NetClient.cos_command_result.connect(_on_cos_pick_or_attack_result)
	NetClient.cos_bag_op.connect(func(d: Dictionary) -> void:
		if bool(d.get("ok", false)) and int(d.get("type", 0)) == CosNet.BAG_PICK:
			_cos_pick_out.erase(int(d.get("cos", 0))))
	NetClient.ride_refused_action.connect(func() -> void:
		if _ui_text_table != null:
			_log_system(_ui_text_table.get_text("UIIT_MSG_SKILL_USE_FAIL_CANT_USESKILL_IN_RIDESTATE", "")))

func _on_own_offensive(monster_id: int) -> void:
	if OS.get_environment("OPENSRO_QA_COS_LOG") != "":
		print("COS: own offensive on monster %d (%d COS of ours)" % [monster_id, NetClient.cos_own.size()])
	for uid in NetClient.cos_own:
		var d: CosNet.Data = NetClient.cos_own[uid]
		if d.kind != CosNet.KIND_GROWTH or d.pet_option != 1 or not _cos_bodies.has(int(uid)):
			continue
		if int(_cos_attack_target.get(int(uid), 0)) != 0 and _monster_bodies.has(int(_cos_attack_target[int(uid)])):
			continue
		_cos_attack_target[int(uid)] = monster_id
		NetClient.send_cos_attack(int(uid), monster_id)

func _on_cos_pick_or_attack_result(d: Dictionary) -> void:
	var uid := int(d.get("cos", 0))
	match int(d.get("type", 0)):
		CosNet.COMMAND_PICK:
			_cos_pick_out.erase(uid)
			if bool(d.get("ok", false)):
				_cos_pick_asked.erase(int(d.get("item", 0)))
		CosNet.COMMAND_ATTACK:
			if not bool(d.get("ok", false)):
				_cos_attack_target.erase(uid)

## One frame of the pick scan.
func _cos_pick_scan() -> void:
	if _ground_items == null or NetClient.cos_own.is_empty():
		return
	_sync_own_id()
	for uid in NetClient.cos_own:
		var d: CosNet.Data = NetClient.cos_own[uid]
		if d.kind != CosNet.KIND_ABILITY or (d.pet_option & CosNet.PICK_ON) == 0:
			continue
		if int(_cos_pick_out.get(int(uid), 0)) != 0 or _player_dead:
			continue
		var body: Node3D = _cos_bodies.get(int(uid))
		if body == null:
			continue
		var at := body.global_position
		var best := -1
		var best_d := COS_PICK_RADIUS * COS_PICK_RADIUS
		for gid in _ground_items.ids():
			if _cos_pick_asked.has(gid):
				continue
			var snap: GroundItemsNet.Snapshot = _ground_items.snapshot(gid)
			if snap == null:
				continue
			if not _cos_pick_wants(d.pet_option, snap):
				continue
			var dd := at.distance_squared_to(Vector3(snap.x, snap.y, snap.z))
			if dd <= best_d:
				best_d = dd
				best = gid
		if best >= 0:
			_cos_pick_asked[best] = true
			_cos_pick_out[int(uid)] = best
			NetClient.send_cos_pick(int(uid), best)

## Whether the grab settings take snap (c:0x8af7f0).
func _cos_pick_wants(opt: int, snap: GroundItemsNet.Snapshot) -> bool:
	var t := PackedInt32Array()
	var row = _item_rows.get(snap.item_id)
	if row != null:
		t = row.type_ids
	# Trade goods are never listed (c:0x8af420).
	if t.size() >= 3 and t[0] == 3 and t[1] == 3 and t[2] == 8:
		return false
	if (opt & CosNet.PICK_ALL) == 0:
		var own := _own_id()
		var mine := snap.owner_id != 0 and own >= 0 and (snap.owner_id == own or \
			(NetClient.party != null and NetClient.party.in_party and NetClient.party.member(snap.owner_id) != null))
		if not mine:
			return false
	if snap.gold:
		return (opt & CosNet.PICK_GOLD) != 0
	if t.size() >= 2 and t[0] == 3 and t[1] == 1:
		return (opt & CosNet.PICK_EQUIPMENT) != 0
	return (opt & CosNet.PICK_OTHER) != 0

# --- The COS windows (round 795, HudCos) -------------------------------------

var _hud_cos: HudCos = null
## Level -> the EXP it takes (leveldata column 1), for the pet's EXP gauge.
var _cos_level_exp := {}

func _hud_cos_setup() -> void:
	_hud_cos = HudCos.new(_ui_builder)
	ui_control.add_child(_hud_cos)
	if _media_pk2 != null:
		var e := ObjectLoader.find_file(_media_pk2, LevelDataReader.TABLE_PATH)
		if e != null:
			_cos_level_exp = LevelDataReader.parse_exp(_media_pk2.read_file(e))
	_hud_cos.setup({
		"cos_row": func(ref: int): return _cos_table.row(ref) if _cos_table != null else null,
		"item_row": func(ref: int): return _item_rows.get(ref),
		"text": func(key: String) -> String: return _ui_text_table.get_text(key, "") if _ui_text_table != null else "",
		"object_name": func(key: String) -> String:
			var t := _object_names()
			return t.get_text(key, "") if t != null else "",
		"exp_to_next": func(level: int) -> int: return int(_cos_level_exp.get(level, 0)),
		"screen_width": func() -> int: return int(get_viewport().get_visible_rect().size.x),
		"screen_height": func() -> int: return int(get_viewport().get_visible_rect().size.y),
		"item_lookup": func(bag_index: int): return NetClient.last_inventory_instances.get(bag_index),
		"pick_up": func(what: Dictionary, icon, source, at) -> bool:
			return _hud_panels.pick_up_icon(what, icon, source, at) if _hud_panels != null else false,
		"bubble_tip": func(control, source) -> void:
			if _hud_panels != null:
				_hud_panels.set_bubble_tip(control, source),
		# Round 801: the transport's trade rows (SpecialtyFlow): the scale
		# (0x30E8), a good's price -- the last quotation told, else its
		# SellPrice (OURS: the window's own price field, the record's
		# +0xb0, is not mapped) -- and whether the specialty store is open.
		"trade_level": func() -> int: return NetClient.trade_scale,
		"trade_price": func(ref: int) -> int:
			if NetClient.trade_prices_now.has(ref):
				return int(NetClient.trade_prices_now[ref])
			var row: ItemTableReader.Item = _item_rows.get(ref)
			return row.sell_price if row != null else 0,
		"special_store_open": func() -> bool: return _specialty_flow != null and _specialty_flow.store_npc != 0,
	})
	_hud_cos.attach_pet_mini_info(_hud_player_info)
	_hud_cos.command.connect(_on_hud_cos_command)
	_hud_cos.rename_requested.connect(func(uid: int, n: String) -> void: NetClient.send_cos_name(uid, n))
	_hud_cos.setting_requested.connect(func(uid: int, k: int, v: int) -> void: NetClient.send_cos_setting(uid, k, v))
	_hud_cos.bag_move_requested.connect(func(t: int, uid: int, src: int, dst: int, n: int) -> void:
		NetClient.send_cos_bag_move(t, uid, src, dst, n))
	_hud_cos.bag_drag_to_inventory.connect(func(uid: int, src: int) -> void:
		NetClient.send_cos_bag_move(CosNet.BAG_COS_TO_BAG, uid, src, _first_free_bag_slot() + CosNet.BAG_WIRE_OFFSET))
	_hud_cos.target_requested.connect(func(uid: int) -> void: _select_cos(uid))
	_hud_cos.system_line.connect(func(text: String, _c: Color) -> void: _log_system(text))
	NetClient.cos_data.connect(func(d: CosNet.Data) -> void: _hud_cos.add_cos(d))
	NetClient.cos_update.connect(_on_cos_update_hud)
	NetClient.cos_hp.connect(func(uid: int, hp: int) -> void: _hud_cos.set_hp(uid, hp))
	NetClient.cos_setting_result.connect(func(d: Dictionary) -> void:
		if bool(d.get("ok", false)):
			_hud_cos.setting_applied(int(d["uid"]), int(d["kind"]), int(d["value"])))
	NetClient.cos_bag_op.connect(func(d: Dictionary) -> void:
		_hud_cos.bag_applied(d)
		if bool(d.get("ok", false)) and int(d.get("type", 0)) in [CosNet.BAG_COS_TO_BAG, CosNet.BAG_BAG_TO_COS]:
			NetClient.list_inventory(NetClient.current_character_name))
	NetClient.ride_changed.connect(func(d: Dictionary) -> void:
		_sync_own_id()
		if bool(d.get("ok", false)) and _own_id() >= 0 and int(d["rider"]) == (_own_id() & 0xffffffff):
			_hud_cos.set_riding(int(d["cos"]), bool(d["mounted"])))
	NetClient.item_state_changed.connect(_on_cos_item_state)
	# This character's COS told before this world came up.
	for uid in NetClient.cos_own:
		_hud_cos.add_cos(NetClient.cos_own[uid])
	ItemTooltipLines.cos_row_of = func(ref: int): return _cos_table.row(ref) if _cos_table != null else null
	ItemTooltipLines.cos_row_by_code = func(code: String): return _cos_table.by_code.get(code) if _cos_table != null else null

func _on_cos_update_hud(u: CosNet.Update) -> void:
	if u.type == CosNet.UPDATE_EXP:
		_cos_exp_orbs(u)
	if u.type == CosNet.UPDATE_REMOVED:
		_hud_cos.remove_cos(u.uid)
		_cos_attack_target.erase(u.uid)
		_cos_pick_out.erase(u.uid)
		return
	_hud_cos.apply_update(u)
	if u.type == CosNet.UPDATE_NAME and _cos_recs.has(u.uid):
		var rec: CosSpawnNet.Record = _cos_recs[u.uid]
		rec.name = u.name
		var body: Node3D = _cos_bodies.get(u.uid)
		if body != null:
			_cos_label(body, rec)

## 0x3040: a bag item's COS state or rent (the pet scroll's tooltip reads it).
func _on_cos_item_state(d: Dictionary) -> void:
	# Round 843 (lane S): a new RefItemID (mask 1, a switcher's result)
	# flashes its slot, worn or in the bag (c:0x88bf30 -> 0x6ab8c0 /
	# 0x6b44d0 -> 0x6665f0, icon_mall_transgender).
	if int(d.get("mask", 0)) & 0x01 and _hud_panels != null:
		_hud_panels.flash_switched(int(d.get("slot", -1)) + CosNet.BAG_WIRE_OFFSET)
	var it: ItemInstance = NetClient.last_inventory_instances.get(int(d.get("slot", -1)))
	if it == null:
		return
	# Round 843 (lane S): the slot's effects follow the state (c:0x88c637..,
	# 0x6b4390 -> the bag slot's 0x667ac0(state), then the quick bar's,
	# 0x60a940): a pet out gets its edge, a dead one the blue wash. A revival
	# (state 3 over a record still at 4, 0x667ac0 -> 0x6666d0) or a rent
	# made longer (more seconds than a record with some left,
	# c:0x88c6dc..0x88c701 -> 0x6b4500) flashes the bag slot once.
	var life := false
	if int(d.get("state", -1)) >= 0:
		var state := int(d["state"])
		life = state == CosNet.ITEM_STATE_STORED and it.cos_state == CosNet.ITEM_STATE_DEAD
		it.cos_state = state
	if int(d.get("rent_secs", -1)) >= 0:
		var old_left := it.rent_left_secs()
		var new_left := int(d["rent_secs"])
		life = life or (old_left > 0 and new_left > old_left)
		it.cos_rent_secs = new_left
		it.rent_read_msec = Time.get_ticks_msec()
	if _hud_panels != null:
		_hud_panels.bag_item_state_changed(int(d.get("slot", -1)), life)
	_refresh_quickslot_states()

## A HudCos command (0x7a0980's numbering) sent for uid.
func _on_hud_cos_command(uid: int, cmd: int) -> void:
	match cmd:
		HudCosCommand.CMD_RIDE:
			if NetClient.riding_mount == uid:
				NetClient.send_cos_ride(false, uid)
			else:
				NetClient.send_cos_ride(true, uid)
		HudCosCommand.CMD_ATTACK:
			var target := _selected_monster_for_cos()
			if target > 0:
				_cos_attack_target[uid] = target
				NetClient.send_cos_attack(uid, target)
		HudCosCommand.CMD_FOLLOW:
			_cos_attack_target.erase(uid)
			NetClient.send_cos_follow(uid)
		HudCosCommand.CMD_UNSUMMON:
			NetClient.send_cos_unsummon(uid)
		HudCosCommand.CMD_TERMINATE:
			NetClient.send_cos_terminate(uid)

## The monster the target window shows, 0 when none.
func _selected_monster_for_cos() -> int:
	if _hud_target != null and "monster_id" in _hud_target:
		return int(_hud_target.get("monster_id"))
	return _last_attack_target if _last_attack_target > 0 else 0

## The first empty bag index (for a pet-bag item put on the inventory).
func _first_free_bag_slot() -> int:
	var used := {}
	for s in _inventory_slots:
		used[s.slot_index] = true
	for i in 96:
		if not used.has(i):
			return i
	return 0

## A COS selected (a status slot's press): its ring.
func _select_cos(uid: int) -> void:
	var body: Node3D = _cos_bodies.get(uid)
	if body == null or _ground_markers == null:
		return
	# A CICCos's ring (GroundMarkers.Kind.COS, round 698's census).
	_ground_markers.attach("cos:%d" % uid, GroundMarkers.Kind.COS, body.global_position)

# --- The academy (round 865, AcademyFlow) -----------------------------------------

var _academy_flow: AcademyFlow = null

func _academy_setup() -> void:
	_academy_flow = AcademyFlow.new(self, _hud_panels)
	_academy_flow.attach_board(_hud_buff_board)
	_hud_panels.set_academy_hooks({
		"own_portrait": _party_own_portrait,
		"portrait_of": _academy_portrait_of,
	})
	# The store changed: the talk menu's academy line follows the membership
	# (c:0x700b10..0x700b9d reads the store's valid flag).
	NetClient.academy.changed.connect(_refresh_open_talk_menu)

## Invite's object (c:0x821f00): the selected player, or a selected COS's
## owner (c:0x9ce910 -> [owner+0xf8]); 0 for none or the player itself.
func _academy_selected_target() -> int:
	var uid := _party_selected_target()
	if uid != 0:
		return uid
	if _selected_cos >= 0:
		var rec: CosSpawnNet.Record = _cos_recs.get(_selected_cos)
		if rec != null and rec.owner_uid != 0 and (_own_id() < 0 or rec.owner_uid != (_own_id() & 0xffffffff)):
			return rec.owner_uid
	return 0

## A spawned player's name by uid (obj+0x114), "" when unknown.
func _academy_name_of(uid: int) -> String:
	return String((NetClient.user_guilds.get(uid, {}) as Dictionary).get("name", ""))

## A member's 3D head from its model (0x6e8910: a 64x64 render of the
## RefObjID's body, "Bip01 Head"), cached by model; null without one.
var _academy_portraits := {}

func _academy_portrait_of(m: AcademyNet.Member) -> Texture2D:
	if m == null or m.ref_obj_id <= 0:
		return null
	var p: PlayerPortrait = _academy_portraits.get(m.ref_obj_id)
	if p == null:
		var got := _party_portrait_body(m.ref_obj_id)
		if got.is_empty() or got[0] == null:
			return null
		p = PlayerPortrait.new()
		p.name = "AcademyPortrait%d" % m.ref_obj_id
		p.size = Vector2i(HudQuickParty.PORTRAIT_BUFFER, HudQuickParty.PORTRAIT_BUFFER)
		ui_control.add_child(p)
		p.set_character(got[0] as Skeleton3D, got[1] if got.size() > 1 else null)
		_academy_portraits[m.ref_obj_id] = p
	return p.get_texture()

## The academy's map marks (PartyMapMarks' academy rule, c:0x663bc2..): for
## the minimap each drawn member's ground position in the player's region,
## for the world map its region word and position. A member's position is the
## live body named by its record's display name (+0x28, 0x9c35e0) when one is
## spawned, else the record's region and (x, 0, z) (0x9ecfd0). Field only:
## a member in a dungeon is placed by its record's dungeon space (the party's
## rule).
var _academy_marks_mini := PackedVector2Array()
var _academy_marks_regions := PackedInt32Array()
var _academy_marks_pos := PackedVector3Array()
var _academy_uid_by_name := {}
var _academy_uid_by_name_size := -1

func _academy_body_named(display_name: String) -> Node3D:
	if display_name == "":
		return null
	if _academy_uid_by_name_size != NetClient.user_guilds.size():
		_academy_uid_by_name_size = NetClient.user_guilds.size()
		_academy_uid_by_name.clear()
		for uid in NetClient.user_guilds:
			_academy_uid_by_name[String((NetClient.user_guilds[uid] as Dictionary).get("name", ""))] = uid
	var uid = _academy_uid_by_name.get(display_name)
	if uid == null or not _other_bodies.has(uid):
		return null
	return _other_bodies[uid] as Node3D

func _fill_academy_marks(here_region: Vector2i) -> void:
	var st := NetClient.academy
	_academy_marks_mini.resize(0)
	_academy_marks_regions.resize(0)
	_academy_marks_pos.resize(0)
	if not st.in_academy() or here_region.x < 0 or _minimap_group == null or not is_instance_valid(_minimap_group):
		return
	var own := st.own_member()
	var own_world: int = own.world_id if own != null and own.world_id != 0 else -1
	var me := NetClient.current_character_name
	var player_region: int = ((here_region.x & 0xFF) << 8) | (here_region.y & 0xFF)
	for id in st.order:
		var m: AcademyNet.Member = st.members[id]
		if not PartyMapMarks.academy_draws(m, me, own_world):
			continue
		if not PartyMapMarks.region_visible(m.region, player_region, false):
			continue
		var at: Vector2
		var body := _academy_body_named(m.display_name)
		if body != null and is_instance_valid(body) and body.is_inside_tree():
			var l := _minimap_group.to_local(body.global_position)
			at = Vector2(l.x, l.z)
		else:
			at = PartyMapMarks.record_local(here_region, m.region, float(m.x), float(m.z))
		_academy_marks_mini.append(at)
		_academy_marks_regions.append(player_region)
		_academy_marks_pos.append(Vector3(at.x, float(m.y), at.y))

## The academy window's Matching button (c:0x6e8770 -> 0x79c420(1)).
func _academy_open_matching() -> void:
	if _hud_panels != null:
		_hud_panels.open_academy_match()

## OPENSRO_QA_INPUT's academy actions (round 865): a fixture through the
## real decode path, a click on a row's button or a box's answer, a report.
func _qa_academy_step(kind: String, arg: String) -> String:
	match kind:
		"acapkt":
			var f := FileAccess.open("res://scripts/net/fixtures/academy/%s.hex" % arg, FileAccess.READ)
			if f == null:
				return "no fixture %s" % arg
			var data := PackedByteArray()
			for tok in f.get_as_text().split(" ", false):
				if tok.strip_edges() != "":
					data.append(tok.strip_edges().hex_to_int())
			var op := ("0x" + arg.get_slice("_", 0)).hex_to_int()
			NetClient.qa_receive(op, data)
			return "fed 0x%04X (%d bytes)" % [op, data.size()]
		"acahex":
			var op := ("0x" + arg.get_slice(":", 0)).hex_to_int()
			var data := arg.get_slice(":", 1).hex_decode()
			NetClient.qa_receive(op, data)
			return "fed 0x%04X %s" % [op, data.hex_encode()]
		"acarow":
			var pane := _hud_panels.academy_pane if _hud_panels != null else null
			var b := pane.row_node(int(arg), "GDR_APPRENTICESHIPSLOT_BTN_EXITFROMAPPRENTICESHIP") if pane != null else null
			if b == null or not b.is_visible_in_tree():
				return "row %s button not shown" % arg
			_qa_push_click(b.get_global_rect().get_center(), MOUSE_BUTTON_LEFT)
			var rh := get_viewport().gui_get_hovered_control()
			return "clicked row %s button '%s' at %s (hovered %s)" % [arg, AcademyWindow.text_of(b), b.get_global_rect().get_center(),
				rh.get_path() if rh != null else "nothing"]
		"acabox":
			var box: AcademyMsgBox = null
			for n in _hud_panels.get_children():
				if n is AcademyMsgBox and (n as Control).visible and not n.is_queued_for_deletion():
					box = n
			if box == null:
				return "no academy box"
			var btn := box.yes_button() if arg == "yes" else box.no_button()
			if btn == null:
				return "no button"
			_qa_push_click(btn.get_global_rect().get_center(), MOUSE_BUTTON_LEFT)
			return "clicked %s on box %s (%s) size %s at %s" % [arg, box.kind, box.caption.text if box.caption != null else "", box.size, box.position]
		"acajudge":
			var jw: HudWindow = _hud_panels._windows.get("academy_judge") if _hud_panels != null else null
			var j := AcademyJudgeWindow.of(jw)
			if j == null or not jw.visible:
				return "no judge window"
			var dot := jw.node(AcademyJudgeWindow.RADIO).get_node_or_null("Item%s" % arg) as Control
			if dot == null:
				return "no item %s" % arg
			_qa_push_click(dot.get_global_rect().get_center(), MOUSE_BUTTON_LEFT)
			return "clicked judge item %s" % arg
		"acareport":
			return _qa_academy_report()
		"acanotice":
			# Round 867: the notice panel's scroll, through the pointer:
			# acanotice:down / up click that arrow, wheeldown / wheelup turn
			# the wheel over the text, report prints the panel and the line.
			var npane := _hud_panels.academy_pane if _hud_panels != null else null
			var contents := npane.node("GDR_APPRENTICESHIP_NOTIFY_CONTENTS") if npane != null else null
			var bar := AcademyNoticeContents.scroll_of(contents)
			var body := contents.find_child(AcademyNoticeContents.BODY, true, false) as Control if contents != null else null
			if arg == "report":
				return _qa_academy_notice_report()
			if bar == null or body == null or not bar.is_visible_in_tree():
				return "no notice panel shown"
			var gr := bar.get_global_rect()
			match arg:
				"down":
					_qa_push_click(Vector2(gr.get_center().x, gr.position.y + bar.down_y() + 8.0), MOUSE_BUTTON_LEFT)
				"up":
					_qa_push_click(Vector2(gr.get_center().x, gr.position.y + 8.0), MOUSE_BUTTON_LEFT)
				"wheeldown", "wheelup":
					var at := body.get_global_rect().get_center()
					_qa_push_mouse(at, MOUSE_BUTTON_WHEEL_DOWN if arg == "wheeldown" else MOUSE_BUTTON_WHEEL_UP, true, true)
					_qa_push_mouse(at, MOUSE_BUTTON_WHEEL_DOWN if arg == "wheeldown" else MOUSE_BUTTON_WHEEL_UP, false, true)
			return "%s; %s" % [arg, _qa_academy_notice_report()]
		"acaask":
			# Round 866: the guardian's join question (box kind 0xe):
			# acaask:yes / acaask:no click its button; acaask:report prints it.
			var ask := _hud_panels.academy_join_ask if _hud_panels != null else null
			if ask == null or not is_instance_valid(ask) or ask.is_queued_for_deletion():
				return "no join question"
			if arg == "report":
				return "join question '%s' at %s size %s" % [ask.shown_text(), ask.position, ask.size]
			var ab := ask.node("GDR_MBIN_BTN_OK" if arg == "yes" else "GDR_MBIN_BTN_CANCEL")
			if ab == null:
				return "no button"
			_qa_push_click(ab.get_global_rect().get_center(), MOUSE_BUTTON_LEFT)
			return "clicked %s on the join question at %s" % [arg, ab.get_global_rect().get_center()]
	return ""

## Round 867: the notice line and panel as drawn: the line's art and text,
## the panel shown, its text's lines, the first shown, the scroll's range,
## position and thumb, and the rects in window pixels.
func _qa_academy_notice_report() -> String:
	var pane := _hud_panels.academy_pane if _hud_panels != null else null
	if pane == null:
		return "no academy pane"
	var subject := pane.node("GDR_APPRENTICESHIP_NOTIFY_SUBJECT")
	var art := subject.get_node_or_null("Art") as TextureRect if subject != null else null
	var art_name := "none"
	if art != null and art.texture != null:
		art_name = "hover" if art.texture == art.get_meta("hover") else ("normal" if art.texture == art.get_meta("normal") else "other")
	var contents := pane.node("GDR_APPRENTICESHIP_NOTIFY_CONTENTS")
	var bar := AcademyNoticeContents.scroll_of(contents)
	var body := contents.find_child(AcademyNoticeContents.BODY, true, false) as Control if contents != null else null
	return "line art=%s hovered=%s text='%s' line_rect=%s panel=%s panel_rect=%s lines=%d first=%d scroll=%s thumb_y=%s text_rect=%s" % [
		art_name, AcademyNoticeContents.is_hovered(subject), AcademyWindow.text_of(subject.get_node_or_null("Text") as Control) if subject != null else "",
		subject.get_global_rect() if subject != null else Rect2(), contents.visible if contents != null else false,
		contents.get_global_rect() if contents != null else Rect2(),
		AcademyNoticeContents.line_count(contents), AcademyNoticeContents.first_line(contents),
		("%d/%d" % [bar.pos, bar.maximum]) if bar != null else "-", str(bar.thumb_y()) if bar != null else "-",
		body.get_global_rect() if body != null else Rect2()]

func _qa_academy_report() -> String:
	var st := NetClient.academy
	var parts: Array = ["in=%s guardian=%s" % [st.in_academy(), st.am_guardian()]]
	if st.camp != null:
		parts.append("camp=%d rank=%d notice=[%s|%s]" % [st.camp.camp_id, st.camp.rank, st.camp.notice_title, st.camp.notice_content])
	for id in st.order:
		var m: AcademyNet.Member = st.members[id]
		parts.append("%s(c%d g%d %d/%d st%d w%x r%d %d,%d,%d '%s')" % [m.name, m.member_class, m.grade, m.cur_level, m.max_level,
			m.play_state, m.world_id, m.region, m.x, m.y, m.z, m.display_name])
	var pane := _hud_panels.academy_pane if _hud_panels != null else null
	if pane != null:
		for n in ["GDR_APPRENTICESHIP_STATIC_NAME", "GDR_APPRENTICESHIP_STATIC_LEVEL_DATA", "GDR_APPRENTICESHIP_STATIC_RANK_NAME",
				"GDR_APPRENTICESHIP_NOTIFY_SUBJECT"]:
			var c := pane.node(n)
			parts.append("%s='%s'%s" % [n.trim_prefix("GDR_APPRENTICESHIP_"), AcademyWindow.text_of(c), "" if c != null and c.visible else "(hidden)"])
		for n in ["GDR_APPRENTICESHIP_DISSOLVE_APPRENTICESHIP_BTN", "GDR_APPRENTICESHIP_BTN_INVITE", "GDR_APPRENTICESHIP_NOTIFY_EDIT_BTN",
				"GDR_APPRENTICESHIP_BTN_MATCH"]:
			var b := pane.node(n) as BaseButton
			parts.append("%s=%s" % [n.trim_prefix("GDR_APPRENTICESHIP_"), "off" if b == null or b.disabled else "on"])
		for i in AcademyWindow.SLOTS:
			var m := pane.row_member(i)
			if m == null:
				continue
			var b := pane.row_node(i, "GDR_APPRENTICESHIPSLOT_BTN_EXITFROMAPPRENTICESHIP") as BaseButton
			parts.append("row%d=%s '%s' '%s' [%s %s]" % [i, m.name, AcademyWindow.text_of(pane.row_node(i, "GDR_APPRENTICESHIPSLOT_STATIC_LEVEL_DATA")),
				AcademyWindow.text_of(pane.row_node(i, "GDR_APPRENTICESHIPSLOT_STATIC_RANK_NAME")), AcademyWindow.text_of(b),
				"off" if b == null or b.disabled else "on"])
	var sent: Array = []
	for e in NetClient.academy_sent:
		sent.append("%04X:%s" % [int(e[0]), (e[1] as PackedByteArray).hex_encode()])
	parts.append("sent=[%s]" % ",".join(sent))
	if pane != null:
		parts.append("notice{%s}" % _qa_academy_notice_report())
	return " ".join(parts)
