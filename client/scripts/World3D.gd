## The buff bar (HudBuffBoard, round 618): built, told who this player is,
## fed by NetClient's buff_started / buff_ended (round 617), its skill index
## built now, off the main thread, and its tooltip names read through
## HudPanels' skill-name table rather than a second parse of it.
var _hud_buff_board: HudBuffBoard = null

func _build_buff_board() -> void:
	_hud_buff_board = HudBuffBoard.new(_ui_builder)
	_hud_buff_board.name = "HudBuffBoard"
	ui_control.add_child(_hud_buff_board)
	_hud_buff_board.setup()
	_hud_buff_board.is_self = _buff_owner_is_self
	_hud_buff_board.catalog.names_provider = func() -> UiTextTable:
		return _hud_panels.skill_names_table() if _hud_panels != null else null
	# The second file of the client's one text map (round 638 review): a
	# mall skill's name (the premium's "Premium") is in textdata_object.
	_hud_buff_board.catalog.object_names_provider = _object_names
	_hud_buff_board.preload_catalog()
	if not _hud_buff_board.connect_net(NetClient):
		print("World3D: NetClient has no buff_started signal -- the buff bar is fed by SRREVAMP_QA_BUFFS only")
	# This player's buffs that started before the bar was built (round 646):
	# the board keys by token, so one it already shows is not added twice.
	var roster: BuffRoster = NetClient.get("buff_roster") as BuffRoster
	if roster != null:
		for bs in roster.all_starts(Time.get_ticks_msec()):
			_hud_buff_board.on_buff_started(bs)
	var qa := OS.get_environment("SRREVAMP_QA_BUFFS")
	if qa != "":
		_hud_buff_board.qa_inject(qa, OS.get_environment("SRREVAMP_QA_BUFFS_END"))

## Item grants (round 632 review): a used Energy of life scroll grants one
## use of the Hwan regeneration fill for an hour. Retail shows the grant as
## a kind-5 icon on the buff board -- the scroll's icon, its gauge running
## over the scroll's Param1 seconds -- a left-click opens CIFCompositeItemWnd
## with a "<name>(<uses>)" button per granted item, and the button spends one
## (0x715F). See CompositeNet and CompositeItemWindow.
var _composite_grants: Dictionary = {}   # token -> CompositeNet.Grant
var _composite_window: CompositeItemWindow = null

func _wire_composite_items() -> void:
	if not NetClient.has_signal("composite_state"):
		return
	NetClient.composite_state.connect(_on_composite_state)
	NetClient.composite_use_result.connect(_on_composite_use_result)
	if NetClient.has_signal("composite_ended"):
		NetClient.composite_ended.connect(_on_composite_ended)
	if _hud_buff_board != null:
		_hud_buff_board.item_state_clicked.connect(_on_item_state_clicked)
	if NetClient.current_character_name != "" and NetClient.is_connected_to_server():
		NetClient.composite_list(NetClient.current_character_name)

func _on_composite_state(state: CompositeNet.State) -> void:
	if state == null:
		return
	# player+0x20f8 (round 629-632 integration): the Energy of life job's
	# duration bonus, which the next berserk display's drain period adds
	# (HudPlayerInfo.set_hwan_time_bonus; FUN_0089a0d0 / FUN_0089a1a0).
	if _hud_player_info != null:
		_hud_player_info.set_hwan_time_bonus(state.bonus_seconds, state.bonus_seconds_left)
	if _hud_buff_board == null:
		return
	var live := {}
	for g in state.grants:
		var grant: CompositeNet.Grant = g
		var token := -grant.item_id
		live[token] = grant
		var icon := _hud_panels.item_icon_path(grant.scroll_id) if _hud_panels != null else ""
		var total_s := _hud_panels.item_param1(grant.scroll_id) if _hud_panels != null else 0
		var scroll_name := _hud_panels.item_name(grant.scroll_id) if _hud_panels != null else ""
		var b := _hud_buff_board.add_item_state(token, icon, total_s * 1000, grant.seconds_left * 1000, scroll_name)
		if b != null and b.slot != null:
			print("QA COMPOSITE: grant item %d from %d, %d/%d uses, %d s left, icon token %d at screen %s size %s" % [
				grant.item_id, grant.scroll_id, grant.remaining, grant.maximum, grant.seconds_left, token,
				str(b.slot.global_position), str(b.slot.size)])
	for t in _hud_buff_board.item_state_tokens():
		if not live.has(t):
			_hud_buff_board.remove_item_state(int(t))
	_composite_grants = live
	print("World3D: composite state: %d grant(s), berserk bonus %d s (%d s left)" % [
		state.grants.size(), state.bonus_seconds, state.bonus_seconds_left])

func _on_item_state_clicked(token: int) -> void:
	var clicked: CompositeNet.Grant = _composite_grants.get(token)
	if clicked == null:
		return
	# FUN_007af830 lists every board entry whose composite (entry+0) is the
	# clicked icon's key.
	var entries: Array = []
	for t in _composite_grants:
		var g: CompositeNet.Grant = _composite_grants[t]
		if g.scroll_id == clicked.scroll_id:
			var n := _hud_panels.item_name(g.item_id) if _hud_panels != null else ""
			entries.append([g.item_id, n if n != "" else "Item %d" % g.item_id, g.remaining])
	if _composite_window == null or not is_instance_valid(_composite_window):
		_composite_window = CompositeItemWindow.new()
		if not _composite_window.setup(_ui_builder):
			print("World3D: resinfo\\ifcompositeitemwnd.txt did not build")
			_composite_window = null
			return
		ui_control.add_child(_composite_window)
		var reg := _ui_builder.window_def(CompositeItemWindow.REGISTRY)
		if reg != null:
			_composite_window.position = Vector2(reg.rect.position)
		_composite_window.use_requested.connect(func(item_id: int) -> void:
			if NetClient.current_character_name != "":
				NetClient.composite_use(NetClient.current_character_name, item_id))
	_composite_window.show_entries(entries)
	_composite_window.show()
	await get_tree().process_frame
	if _composite_window != null:
		print("QA COMPOSITE: window open, button 0 at screen %s" % str(_composite_window.button_screen_centre(0)))

## A grant's end (composite review; retail 0x315B, FUN_008993b0 removes the
## entry and its kind-5 icon).
func _on_composite_ended(item_id: int, scroll_id: int) -> void:
	var token := -item_id
	_composite_grants.erase(token)
	if _hud_buff_board != null:
		_hud_buff_board.remove_item_state(token)
	print("World3D: composite grant ended: item %d from %d -- icon removed" % [item_id, scroll_id])

func _on_composite_use_result(result: CompositeNet.UseResult) -> void:
	if result == null:
		return
	print("World3D: composite use: item %d, %d left, gauge %d, active %s, error '%s'" % [
		result.item_id, result.remaining, result.berserk_gauge, str(result.berserk_active), result.error])
	UiSounds.use_replied(result.error == "")
	if result.error != "":
		_log_system(result.error)
		return
	if _hud_player_info != null:
		_hud_player_info.set_berserk(result.berserk_gauge, result.berserk_active)

## Whether a buff's owner is this client's player (round 618's review): a
## character (ownerKind 0) whose id is this player's -- the one _sync_own_id
## settles on, OpSelfId's when the server sent it, else the sit answer's.
## No id yet: nobody's buff is shown.
func _buff_owner_is_self(owner_id: int, owner_kind: int) -> bool:
	_sync_own_id()
	return owner_kind == SkillNet.OWNER_CHARACTER and _sit.own_id >= 0 and owner_id == _sit.own_id

## The middle button over the minimap, the player-info block and the target
## window (round 531). It fires the underbar's "m" slot (quick slot 0) wherever
## the cursor is (_unhandled_input, playtest 2026-09-20), but round 529 made
## these three STOP, so a middle press on them is consumed by the GUI and
## never reaches _unhandled_input. Each is handed to the hotbar's one relay
## (HudUnderbar.relay_middle_button), the same handler the hotbar's own body
## uses, so all four surfaces share one path. A press on a STOP child of a
## surface (the minimap's zoom and map buttons, the target's close button) is
## consumed by that child and fires nothing, as before round 529.
func _relay_middle_button_to_hotbar() -> void:
	if _hud_underbar == null:
		return
	for surface in [_hud_minimap, _hud_player_info, _hud_target]:
		if is_instance_valid(surface) and surface is Control:
			_hud_underbar.relay_middle_button(surface as Control)

## Routes the underbar's buttons and its menu's items to the panels. The bar
## opens and closes its own menu (CNIFUnderMenuBar's popup 59); every action
## it emits names a panel (HudUnderbar.MENU_ACTIONS).
func _on_underbar_menu_action(action_name: String) -> void:
	if _hud_panels == null:
		return
	# HudPanels.menu_action: a toggle, except the alchemy item, which only
	# opens (0x798e20(1)).
	_hud_panels.menu_action(action_name)

## Hides the parts of the developer UI the authentic HUD now covers.
## Hidden rather than deleted: the scene still owns those nodes and
## World3D's own handlers still reference them, so removing them is a
## separate change (docs/TODO.md item 5).
func _hide_debug_ui_replaced_by_hud() -> void:
	# ZoneLabel goes too: the minimap now shows the zone name and the
	# client's own X/Y readout, which is what that label was standing in
	# for, and it was drawing straight across the player block.
	# ChatPanel goes now that the authored chat window is built: it was the
	# last of the developer HUD that overlapped the real one, sitting across
	# the bottom-left corner where ifchatviewer's own window belongs.
	for path in ["ActionTabs", "CharacterLabel", "HelpLabel", "ZoneLabel", "ChatPanel"]:
		var node := ui_control.get_node_or_null(path)
		if node is CanvasItem:
			(node as CanvasItem).visible = false

	# The rest of the developer chrome is *hidden*, not retired: the zone
	# box is still the only way to travel and Log Out is still the only way
	# out. They sat over the player block and across the bottom-right corner
	# in every screenshot of this game, which is not what it should look
	# like when someone plays it.
	_set_dev_ui_visible(false)
	_log_system("Developer tools (zone travel, log out): Shift+F1")

	# The debug panel, and the three things a player asked to be able to
	# change from a couch: name range, UI scale (applied at boot) and chat
	# font, all remembered by ClientSettings.
	_debug_panel = DebugPanel.new(self)
	$UI.add_child(_debug_panel)
	_log_system("Debug panel (build, position, entities, loading, performance): Shift+F3")
	_log_system("Stuck in a wall or building? Type /unstuck to return to the zone entry.")
	# Round 700: no game cursor -- say where sro_client.exe goes (GameCursor).
	GameCursor.load_once()
	if not GameCursor.has_cursors():
		_log_system(GameCursor.missing_hint())
	_build_target_window()
	set_name_plate_range(ClientSettings.name_plate_range(NAME_PLATE_RANGE))
	var chat_font_size := ClientSettings.chat_font_size()
	if chat_font_size > 0:
		chat_log.add_theme_font_size_override("normal_font_size", chat_font_size)

	# The camera arm leaves the player's body for a pivot of its own (see
	# CAMERA_VIEW_FREE): the arm keeps its local offset and angles, the
	# pivot takes the body's position each physics tick.
	_camera_pivot = Node3D.new()
	_camera_pivot.name = "CameraPivot"
	add_child(_camera_pivot)
	_camera_pivot.global_position = player.global_position
	camera_arm.reparent(_camera_pivot, false)
	set_camera_view(ClientSettings.camera_view())

## Pushes the camera's far clipping plane out far enough to actually see
## the real terrain this scene streams in.
##
## **Added 2026-09-02** (see docs/WORLD_ISSUES.md's fifty-sixth round). The
## Camera3D never set `far`, so it used Godot's default of **4000** -- but
## the real streamed region grid is `(2 * REGION_LOAD_RADIUS + 1)` regions
## across, i.e. 9600 real units wide, reaching about 5400 units to a corner
## from the player at its centre. Real terrain past 4000 units was therefore
## clipped away with sky showing through it. Confirmed by measurement rather
## than inference: a real downward-raycast profile finds real terrain out to
## z=+3200 and the void beyond z=+4000, i.e. real ground genuinely exists
## well past where the default far plane was cutting it off.
##
## Derived from the same real constants that decide how much world is
## loaded, so it stays correct if the streaming radius or region size ever
## change. (The cloud layer no longer needs it: it is pinned to the far
## plane by its own shader since round 628's review.)
func _apply_camera_far_plane() -> void:
	# Round 694: times the Background Sight Range's factor (1 at the default;
	# _apply_view_distance).
	camera_3d.far = REGION_SPAN * (_region_load_radius() + 1) * 2.0 * _far_scale

## Loads real static scenery through the exact same pk2 -> BsrReader ->
## ObjectLoader pipeline client/tools/render_asset.gd verifies standalone,
## live in this scene -- if SRREVAMP_PK2_PATH and SRREVAMP_BSR_PATH are
## both set. Skips gracefully (a printed hint, not an error) otherwise,
## since this project ships with no game data.
func _try_load_real_scenery() -> void:
	var pk2_path := Pk2Config.data_path()
	var bsr_path := OS.get_environment("SRREVAMP_BSR_PATH")
	if pk2_path == "" or bsr_path == "":
		print("World3D: Data.pk2/SRREVAMP_BSR_PATH not set -- no real scenery loaded")
		return

	var archive := Pk2Reader.open(pk2_path)
	if archive == null:
		printerr("World3D: could not open pk2 archive at ", pk2_path)
		return

	var obj := ObjectLoader.load_object(archive, bsr_path)
	if obj == null:
		printerr("World3D: could not load ", bsr_path, " from ", pk2_path)
		return

	# +Z is behind the third-person camera (it sits at a +Z/+Y offset from
	# the player looking back toward -Z) -- place scenery on the -Z side
	# so it's actually in view near spawn.
	obj.position = Vector3(4, 0, -4)
	add_child(obj)
	print("World3D: loaded real scenery %s from %s" % [bsr_path, pk2_path])

## Loads a real .bsk skeleton + .ban animation through Skeleton3DBuilder
## (see client/tools/render_skeleton3d_animated.gd for the standalone
## verification of this same pipeline), live in this scene as an animated
## decoration (not the player's own body -- see _try_load_real_player_character())
## -- if SRREVAMP_BSK_PATH and SRREVAMP_BAN_PATH are both set. Each accepts
## either a loose file path or a path inside SRREVAMP_PK2_PATH (see
## AssetSource). Skips gracefully otherwise.
func _try_load_real_decoration_skeleton() -> void:
	var bsk_path := OS.get_environment("SRREVAMP_BSK_PATH")
	var ban_path := OS.get_environment("SRREVAMP_BAN_PATH")
	if bsk_path == "" or ban_path == "":
		print("World3D: SRREVAMP_BSK_PATH/SRREVAMP_BAN_PATH not set -- no real decoration skeleton loaded")
		return

	var archive := _open_pk2_if_set()
	var bsk_bytes := AssetSource.read_bytes(bsk_path, archive)
	var ban_bytes := AssetSource.read_bytes(ban_path, archive)
	if bsk_bytes.is_empty() or ban_bytes.is_empty():
		printerr("World3D: could not find .bsk/.ban at ", bsk_path, " / ", ban_path)
		return

	var skel := BskReader.parse(bsk_bytes)
	var anim := BanReader.parse(ban_bytes)
	if skel == null or anim == null or anim.bones.is_empty():
		printerr("World3D: could not parse .bsk/.ban at ", bsk_path, " / ", ban_path)
		return

	_real_skeleton = Skeleton3DBuilder.build_skeleton3d(skel)
	_real_skeleton_track = anim.bones[0]
	_real_skeleton_anim = anim
	_real_skeleton.position = Vector3(-6, 0, -6)
	# Real .bsk bind-pose data uses a much larger native scale than this
	# scene's ~2-unit-tall player capsule (position values in the hundreds
	# -- see docs/protocol/BSK_FORMAT.md) -- scale down so the whole
	# creature is visible near the player instead of dwarfing the scene.
	_real_skeleton.scale = Vector3.ONE * 0.02
	add_child(_real_skeleton)
	# A bare Skeleton3D has no visual representation of its own -- see
	# Skeleton3DBuilder.build_debug_visualization()'s doc comment.
	Skeleton3DBuilder.build_debug_visualization(_real_skeleton)
	print("World3D: loaded real skeleton %s + animation %s (%d bones, %d keyframes on track %s)" % [
		bsk_path, ban_path, skel.bones.size(), _real_skeleton_track.keyframes.size(), _real_skeleton_track.bone_name])

## Opens the real Data.pk2 -- SRREVAMP_PK2_PATH if set, else a real
## "pk2/Data.pk2" next to the running executable (see Pk2Config) -- or
## returns null if neither resolves or the open fails. Used so AssetSource
## can fall back to an in-archive path for any of the loose-file-shaped
## environment variables.
func _open_pk2_if_set() -> Pk2Reader:
	if _data_pk2 != null:
		return _data_pk2
	var pk2_path := Pk2Config.data_path()
	if pk2_path == "":
		return null
	_data_pk2 = Pk2Reader.open(pk2_path)
	return _data_pk2

var _tile_index_cache: TileIndexReader.Table

## The real terrain lighting terms from environment.ifo, remembered when a
## region's environment is applied so the terrain mesh can bake them in.
var _env_light_diffuse := Color.WHITE
var _env_terrain_ambient := Color.BLACK
## The environment's TerrainShadowColor (channel 6), which retail adds to the
## region's `.t` lightmap before multiplying the ground by it
## (MapmTerrainBuilder.lightmap_term, round 610).
var _env_terrain_shadow := Color.BLACK
var _env_light_ready := false
## The zone light the portrait is lit by: [channel 2, channel 3] of the
## current zone's environment record, or empty before one is applied.
var _portrait_zone_light: Array = []

var _tile_index_load_attempted := false

## Loads and caches the real tile2d.ifo table (see TILE_INDEX_PATH) from
## SRREVAMP_PK2_PATH's Data.pk2, for MapmTerrainBuilder's real per-vertex
## ground-tile-type coloring. Only ever parsed once per scene lifetime --
## every real region shares the same real table. Returns null (logged
## once) if SRREVAMP_PK2_PATH isn't set or the file can't be found/parsed;
## callers already treat a null table as "fall back to the generic hue
## sweep," so this isn't a hard failure.
## Real parsed region-zone table, loaded once per run (it covers the whole
## real world, not one region). Null means "already tried, nothing usable".
var _regioninfo_cache: RegioninfoReader.ParsedTable = null
var _regioninfo_load_attempted := false

func _load_regioninfo() -> RegioninfoReader.ParsedTable:
	if _regioninfo_load_attempted:
		return _regioninfo_cache
	_regioninfo_load_attempted = true

	var archive := _open_pk2_if_set()
	if archive == null:
		return null
	var bytes := AssetSource.read_bytes(REGIONINFO_PATH, archive)
	if bytes.is_empty():
		print("World3D: no real region-zone table at ", REGIONINFO_PATH, " -- the zone label keeps whatever it already had")
		return null
	_regioninfo_cache = RegioninfoReader.parse(bytes)
	if _regioninfo_cache == null:
		printerr("World3D: could not parse real region-zone table at ", REGIONINFO_PATH)
	else:
		print("World3D: loaded real region-zone table (%d real zones) from %s" % [_regioninfo_cache.zones.size(), REGIONINFO_PATH])
	return _regioninfo_cache

## Names the real zone a region belongs to, in the label that has read
## "Zone: -" for want of anything real to put there.
##
## Only ever *replaces* the label when the real table names the region
## unambiguously. A region two real zones split between them resolves to
## nothing (see RegioninfoReader.sole_zone_for -- which side of the split a
## point falls on can't be decided until `RECT`'s real coordinates are
## understood), and so does a region the table never mentions. In both
## cases whatever the label already said is left alone rather than
## overwritten with a guess.

## Appends the player's real region and region-local position to the zone
## label, so a screenshot from a playtest says exactly *where* it was taken.
##
## Added 2026-09-06 after a real playtest reported parts of the world being
## "not where they should be" -- a real, credible report that could not be
## acted on, because neither a screenshot nor a description pins down which
## real region and which part of it is being looked at. The region and local
## coordinates are directly checkable against that region's own real authored
## minimap art (`Media.pk2`'s `minimap\\<y>x<x>.ddj`), which is what makes a
## report like that actionable rather than anecdotal.
## The last real zone name resolved for the player's region, kept so the
## label's position part can be refreshed as they walk without re-resolving
## the zone every frame.
var _current_zone_name := "-"
var _zone_label_tick := 0

## The "Audio" autoload's music half, or null (round 612).
func _audio_music() -> MusicDirector:
	var svc := AudioService.instance()
	return svc.music if svc != null else null

## Tells the music which zone the player stands in (round 612): the region
## and region-local position, resolved by the English regioninfo.txt in
## MusicDirector. Not while the loading screen is up -- it is silent, and the
## first world frame starts the music (READ). Retail asks every frame and does
## nothing when the name is unchanged; this asks with the zone label, every
## tenth tick (ours).
func _audio_area_tick() -> void:
	if _loading_screen != null or player == null:
		return
	var music := _audio_music()
	if music == null:
		return
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		return
	var group: Node3D = pair[1]
	var parts := String(group.name).trim_prefix("RealTerrain_").split("_")
	if parts.size() < 2:
		return
	var local := group.to_local(player.global_position)
	music.set_area_at(parts[0].to_int(), parts[1].to_int(), local.x, local.z)

## Refreshes the position shown in the zone label as the player moves.
## Throttled: the text only has to be readable, not per-frame accurate.
func _refresh_zone_label_position() -> void:
	_zone_label_tick += 1
	if _zone_label_tick % 10 != 0:
		return
	_audio_area_tick()
	_water_env_tick()
	if zone_label != null:
		zone_label.text = "Zone: %s%s" % [_current_zone_name, _zone_label_position_suffix()]

	_minimap_npcs_cache = _minimap_npc_positions()

## The minimap and the world map follow the player every physics frame
## (round 630). OURS: the client refreshes its minimap's position through
## 0x661ce0 from 0x777a70, which CICPlayer::vslot_015(3) sends when the
## player's heading changes, and from vslot_012 (0x662510) while a zoom walks
## (it returns early otherwise); a per-frame refresh shows the same thing
## and does not depend on which events this client raises. It used to ride
## the zoom label's tenth-frame throttle, which made the arrow step. The NPC
## walk (every region's Npc_* holders) stays on that throttle, in
## _minimap_npcs_cache; NPCs do not move.
var _minimap_npcs_cache: Array = []
## The region group the player was last found in, and its region (x, y),
## parsed from the group's name once rather than every frame; the lists the
## signs are gathered into, reused (round 630 review).
var _minimap_group: Node3D = null
var _minimap_region := Vector2i(-1, -1)
var _minimap_group_name := StringName()
var _minimap_monsters: Array = []
var _minimap_others: Array = []
## The rendered frame the minimap was last refreshed in (round 664).
var _minimap_frame := -1

func _refresh_minimap() -> void:
	if player == null or _hud_minimap == null or not is_instance_valid(_hud_minimap):
		return
	var pos := player.global_position
	var local := Vector3.ZERO
	var inside := false
	if _minimap_group != null and is_instance_valid(_minimap_group) and _minimap_group.is_inside_tree() \
			and _minimap_group.name == _minimap_group_name:
		local = _minimap_group.to_local(pos)
		inside = local.x >= 0.0 and local.z >= 0.0 and local.x <= REGION_SPAN and local.z <= REGION_SPAN
	if not inside:
		var pair := _nav_graph_for(pos)
		if pair.is_empty():
			return
		var group: Node3D = pair[1]
		var parts := String(group.name).trim_prefix("RealTerrain_").split("_")
		if parts.size() < 2:
			return
		_minimap_group = group
		_minimap_group_name = group.name
		_minimap_region = Vector2i(parts[0].to_int(), parts[1].to_int())
		local = group.to_local(pos)
	var rx := _minimap_region.x
	var ry := _minimap_region.y
	var facing := minimap_facing(player.global_transform.basis, _minimap_group.global_transform.basis)
	_hud_minimap.update_player(rx, ry, local, facing)
	_hud_minimap.set_area_name(_current_zone_name)
	# Only bodies that can land inside the sign circle (round 664): HudMinimap
	# draws a sign only under SIGN_RADIUS pixels from the centre, which at
	# the drawn zoom is this many world units (a hair over, so the circle's
	# own test still decides the edge).
	var reach := HudMinimap.SIGN_RADIUS / maxf(_hud_minimap.tile_px(), 0.001) * HudMinimap.REGION_SPAN * 1.01
	_minimap_fill_positions(_monster_bodies, _minimap_monsters, pos, reach)
	_minimap_fill_positions(_other_bodies, _minimap_others, pos, reach)
	_hud_minimap.update_signs(pos, _minimap_npcs_cache, _minimap_monsters, _minimap_others)
	# The world map every frame only while it is open; hidden, on the old
	# tenth-frame beat, so it is current when it opens.
	if _hud_worldmap != null and is_instance_valid(_hud_worldmap) \
			and (_hud_worldmap.is_visible_in_tree() or _zone_label_tick % 10 == 0):
		_hud_worldmap.update_player(rx, ry, local, facing)
	# SRREVAMP_QA_WALK runs log what the minimap was told, twice a second,
	# so a facing test is read from the log, not a frame (round 630).
	if _qa_walk != "" and _zone_label_tick % 30 == 0:
		print("QA MINIMAP %d/%d local (%.0f, %.0f) facing (%.2f, %.2f) arrow %.0f deg" % [
			rx, ry, local.x, local.z, facing.x, facing.y, rad_to_deg(HudMinimap.arrow_rotation(facing))])

## Fills `out` (kept, cleared and refilled) with the world positions of the live bodies in an id -> Node3D map (monsters,
## other players), skipping ones that are gone or hidden (a dead monster).
## A body held V hides still counts: whether the retail minimap reads V's
## flag was not read, so the minimap is left as it was.
func _minimap_fill_positions(bodies: Dictionary, out: Array, centre: Vector3 = Vector3.ZERO, reach: float = INF) -> void:
	out.clear()
	var reach_sq := reach * reach
	for id in bodies:
		var body: Node3D = bodies[id] as Node3D
		if body != null and is_instance_valid(body) and (body.visible or _objects_hidden):
			var at := body.global_position
			var dx := at.x - centre.x
			var dz := at.z - centre.z
			if dx * dx + dz * dz < reach_sq:
				out.append(at)

## The way the player faces as a region-local ground vector (x east, z
## north), for the minimap's and world map's arrow. The player's front is its
## node's local +Z (_physics_process sets rotation.y = atan2(dir.x, dir.z) to
## face `dir`); the region group's basis carries the world's z -> -z mirror,
## so the vector is taken into the group's frame rather than read off
## rotation.y, which is what the minimap used to do (round 630).
static func minimap_facing(player_basis: Basis, group_basis: Basis) -> Vector2:
	var front := group_basis.inverse() * player_basis.z
	return Vector2(front.x, front.z)

## World positions of every placed NPC, for the minimap's signs: the `Npc_*`
## holders under each loaded region group (the same walk _qa_npc_body_report
## does). UI seam -- the minimap only ever sees positions, never the nodes.
func _minimap_npc_positions() -> Array:
	var out: Array = []
	for group in get_children():
		if not (group is Node3D) or not String(group.name).begins_with("RealTerrain_"):
			continue
		for holder in group.get_children():
			if holder is Node3D and String(holder.name).begins_with("Npc_"):
				out.append((holder as Node3D).global_position)
	return out

## Bone positions of the first few animated characters, so two calls can be
## differenced. Keyed by skeleton instance id.
var _qa_anim_sample: Dictionary = {}

func _qa_animation_report() -> void:
	print("QA ANIM %d animated character(s), %d posed and %d culled last frame" % [_animated.size(), _anim_posed_last, _anim_culled_last])
	var checked := 0
	for entry in _animated:
		var skeleton: Skeleton3D = entry[0]
		if not is_instance_valid(skeleton):
			continue
		var sum := Vector3.ZERO
		for i in range(skeleton.get_bone_count()):
			sum += skeleton.get_bone_global_pose(i).origin
		# The frame this character is posed at, reported alongside the
		# movement: a short loop sampled a whole number of cycles apart is
		# genuinely on the same frame, and "moved 0.000" then says the probe
		# aliased rather than that the animation is dead.
		var frames: int = entry[2]
		var phase: float = entry[3]
		var anim: BanReader.ParsedAnimation = entry[1]
		var frame_idx := anim.key_index_at(_idle_anim_time + phase, true)
		var key := skeleton.get_instance_id()
		var previous = _qa_anim_sample.get(key)
		if previous == null:
			print("   %-22s %2d bones, %2d frames, at frame %d -- first sample" % [
				skeleton.get_parent().name, skeleton.get_bone_count(), frames, frame_idx])
		else:
			var moved: float = (sum - (previous as Vector3)).length()
			print("   %-22s %2d bones, %2d frames, at frame %d -- bones moved %.3f" % [
				skeleton.get_parent().name, skeleton.get_bone_count(), frames, frame_idx, moved])
		_qa_anim_sample[key] = sum
		checked += 1
		if checked >= 5:
			break

## Reports, for every placed object near the player, how its rendered
## footprint compares with the walkable footprint in the navigation graph.
##
## The gap is what lets a player stand inside a structure: the graph only
## knows the walkable part, so where the solid mesh reaches further, the
## graph reports the terrain underneath and puts the player there. Jangan's
## gate is the case that prompted this.
func _qa_navgap_report() -> void:
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		print("QA NAVGAP: off-region")
		return
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	var here := group.to_local(player.global_position)

	# Rendered footprints, from the region's own object nodes.
	# Objects hang off a container under the terrain group, not off the
	# group itself -- the same two-level walk _qa_look_report does.
	var object_nodes: Array[Node] = []
	for container in group.get_children():
		for node in container.get_children():
			if node is Node3D and String(node.name).begins_with("Obj_"):
				object_nodes.append(node)

	var rendered := {}
	for child in object_nodes:
		var box := AABB()
		var seeded := false
		var stack: Array[Node] = [child]
		while not stack.is_empty():
			var cur: Node = stack.pop_back()
			if cur is MeshInstance3D and (cur as MeshInstance3D).mesh != null:
				var mi := cur as MeshInstance3D
				var world_box: AABB = mi.global_transform * mi.get_aabb()
				if seeded:
					box = box.merge(world_box)
				else:
					box = world_box
					seeded = true
			for c in cur.get_children():
				stack.append(c)
		if seeded:
			rendered[String(child.name)] = box

	# Two independent questions, asked separately, because tying them
	# together needs a name-to-index mapping that does not exist: the render
	# nodes are numbered by a running "how many loaded" counter over the
	# .o/.o2 placement files, while the graph keys objects by their index in
	# the .nvm's own object list. An earlier version of this report matched
	# them by the node name's trailing number and confidently reported "NO
	# walkable mesh" for an object that may well have one.
	#
	# So: what does the graph offer to stand on here, and what solid
	# geometry actually covers the spot.
	print("QA NAVGAP at local %d, %d" % [here.x, here.z])

	# heights_at is every surface the graph knows here: the terrain first,
	# then any object cell covering the point.
	var offered := graph.heights_at(here.x, here.z)
	print("   graph offers %d surface(s): %s" % [offered.size(), offered])
	print("   graph objects covering this point: %s" % [graph.objects_at(here.x, here.z)])

	var covering := 0
	for name in rendered:
		var box: AABB = rendered[name]
		var lo := group.to_local(box.position)
		var hi := group.to_local(box.end)
		var x0: float = minf(lo.x, hi.x)
		var x1: float = maxf(lo.x, hi.x)
		var z0: float = minf(lo.z, hi.z)
		var z1: float = maxf(lo.z, hi.z)
		if here.x < x0 or here.x > x1 or here.z < z0 or here.z > z1:
			continue
		covering += 1
		print("   solid %-34s y %.1f..%.1f" % [name, minf(lo.y, hi.y), maxf(lo.y, hi.y)])
	if covering == 0:
		print("   nothing solid covers this spot")

## Opens the named HUD panels and tiles them across the screen, so one
## render can show several at once. Reports what opened and what didn't --
## a panel whose authored layout is missing prints rather than failing.
func _qa_open_panels(spec: String) -> void:
	if _hud_panels == null:
		print("QA PANELS: no HUD (Media.pk2 not loaded)")
		return
	# SRREVAMP_QA_PANELS_IN_PLACE=1 leaves every window where it places
	# itself (the main popup's tab side, clamped into the viewport) instead of
	# centring or tiling it for the shot.
	var in_place := OS.get_environment("SRREVAMP_QA_PANELS_IN_PLACE") != ""
	var ids := spec.split(",", false)
	var placed := 0
	var windows: Array = []   # distinct windows opened, in order
	for raw in ids:
		var panel_id := raw.strip_edges()
		if panel_id == "":
			continue
		# The MENU is not a panel: it is the underbar's own popup (59).
		if panel_id == "menu":
			if _hud_underbar != null:
				_hud_underbar.show_menu()
			placed += 1
			continue
		var window := _hud_panels.open(panel_id)
		if window == null:
			print("QA PANELS: %s did not open" % panel_id)
			continue
		placed += 1
		# Several ids can be tabs of one window (the main popup): the later
		# id switches its tab rather than opening a second window, and the
		# report says so instead of counting it as another window.
		if windows.has(window):
			print("QA PANELS: %s is a tab of the window %s already opened; it is now showing, %dx%d at %s" % [
				panel_id, window.name, int(window.size.x), int(window.size.y), window.position])
			continue
		windows.append(window)
		if not in_place:
			# A single window centres for a clean shot, clear of the left-side
			# chat log; several tile across the top. Through place_window, so
			# the main popup keeps the placement through a resize.
			var view := get_viewport().get_visible_rect().size
			if ids.size() == 1:
				_hud_panels.place_window(window, ((view - window.size) / 2.0).round())
			else:
				var column := (windows.size() - 1) % 3
				var row: int = (windows.size() - 1) / 3
				_hud_panels.place_window(window, Vector2(
					20.0 + column * (view.x - 40.0) / 3.0,
					90.0 + row * 200.0))
		print("QA PANELS: %s opened %dx%d at %s%s" % [
			panel_id, int(window.size.x), int(window.size.y), window.position,
			" (its own placement)" if in_place else ""])
	print("QA PANELS: %d of %d ids opened, in %d window(s)" % [placed, ids.size(), windows.size()])

func _zone_label_position_suffix() -> String:
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		return " @ %d, %d, %d (no region)" % [
			player.global_position.x, player.global_position.y, player.global_position.z]
	var group: Node3D = pair[1]
	var local := group.to_local(player.global_position)
	var suffix := String(group.name).replace("RealTerrain_", "")
	return " [%s] local %d, %d, %d" % [suffix, local.x, local.y, local.z]

## The client's own per-region zone names (Media.pk2's
## `server_dep\\silkroad\\textdata\\textzonename.txt`), loaded once per run.
## Empty means "already tried, nothing usable" -- see _zone_name_for_region.
const TEXT_ZONE_NAME_PATH := "server_dep\\silkroad\\textdata\\textzonename.txt"
var _text_zone_names: Dictionary = {}
var _text_zone_names_load_attempted := false

func _load_text_zone_names() -> Dictionary:
	if _text_zone_names_load_attempted:
		return _text_zone_names
	_text_zone_names_load_attempted = true
	var archive := _open_media_pk2_if_set()
	if archive == null:
		return _text_zone_names
	var bytes := AssetSource.read_bytes(TEXT_ZONE_NAME_PATH, archive)
	if bytes.is_empty():
		print("World3D: no real per-region zone-name table at ", TEXT_ZONE_NAME_PATH, " -- the zone label falls back to Shader\\regioninfo.txt's 15 zones")
		return _text_zone_names
	_text_zone_names = TextZoneNameReader.parse(bytes)
	print("World3D: loaded real per-region zone names (%d regions) from %s" % [_text_zone_names.size(), TEXT_ZONE_NAME_PATH])
	return _text_zone_names

## The display name of the zone a region belongs to. The per-region text
## table is the game's own answer and covers the whole world (Alexandria,
## the dungeons, the arenas); `Shader\\regioninfo.txt` names only the 15
## original zones, so it is the fallback -- and a region neither knows
## keeps the label as it is rather than inventing a name. Before the text
## table was read (docs/rounds/map.md, 2026-09-19) a travel to Alexandria
## left the label and the minimap saying "Jangan".
func _zone_name_for_region(region_x: int, region_y: int) -> String:
	var zone_name := TextZoneNameReader.name_for(_load_text_zone_names(), region_x, region_y)
	if zone_name != "":
		return zone_name
	var table := _load_regioninfo()
	if table == null:
		return ""
	return RegioninfoNames.display_for_region(table, region_x, region_y)

func _update_zone_label_for_region(region_x: int, region_y: int) -> void:
	# The area banner's test runs on every region the player enters (round
	# 703; HudRegionView.enter_region is 0x665aa0's rule).
	_zone_region = Vector2i(region_x, region_y)
	if _hud_region != null:
		_hud_region.enter_region(TextZoneNameReader.region_id(region_x, region_y))
	var zone_name := _zone_name_for_region(region_x, region_y)
	if zone_name == "":
		return
	_current_zone_name = zone_name
	zone_label.text = "Zone: %s%s" % [zone_name, _zone_label_position_suffix()]
	if _hud_minimap != null and is_instance_valid(_hud_minimap):
		_hud_minimap.set_area_name(zone_name)

func _load_tile_index() -> TileIndexReader.Table:
	if _tile_index_load_attempted:
		return _tile_index_cache
	_tile_index_load_attempted = true

	var archive := _open_pk2_if_set()
	if archive == null:
		return null
	var bytes := AssetSource.read_bytes(TILE_INDEX_PATH, archive)
	if bytes.is_empty():
		print("World3D: could not find real tile index at ", TILE_INDEX_PATH, " -- terrain color falls back to a generic hue sweep")
		return null
	_tile_index_cache = TileIndexReader.parse(bytes)
	if _tile_index_cache == null:
		printerr("World3D: could not parse real tile index at ", TILE_INDEX_PATH)
	else:
		print("World3D: loaded real tile index (%d real tile types) from %s" % [_tile_index_cache.entries.size(), TILE_INDEX_PATH])
	return _tile_index_cache

## Real per-.ddj-filename texture cache, shared across every region this
## world loads -- most real tile2d.ifo IDs a region uses (grass/dirt/stone,
## etc) repeat across many regions, so this avoids re-reading and
## re-decoding the same real Tile2D\*.ddj file over and over. A null entry
## means "already tried, no real file/decode" -- also cached, so a
## consistently-missing ID doesn't retry every region load. Per instance,
## not static, since round 560: as a `static var` it outlived the world
## (round 558's scripted reconnect measured entry 2 starting with entry 1's
## 43 textures, `cache_ground=43`, before it had loaded a region), and a
## second login in one process now decodes its own -- the cost is on the
## `ground textures for` line (decoded count and ms). Cleared in _exit_tree.
var _ground_texture_cache: Dictionary = {}

## Which of a region's real per-vertex ground texture IDs resolve, and the
## ground tiles this world has not uploaded yet decoded to Images -- the
## prepare half (round 565) of what `_load_real_ground_textures` did on the
## main thread until then. Keyed by the real TextureInfo.ID
## MapmTerrainBuilder's _vertex_color already decodes -- see
## docs/protocol/DDJ_FORMAT.md and TILE2D_FORMAT.md's 2026-08-23 correction.
## Each real ID resolves through the tile table to a real tile2d.ifo
## filename, loaded from Map.pk2's real `Tile2D\` folder (confirmed
## 2026-08-23 to be where these actually live -- see server/cmd/pk2list's
## real listing against a real Map.pk2). Sets the job's `texture_files` (ID
## -> filename, resolved IDs only) and `new_images` (filename -> Image, null
## for a file missing or undecodable), both empty -- the flat colour, as
## before -- with no tile table or no Map.pk2. A file the job's snapshot of
## _ground_texture_cache names is not read again; one another in-flight job
## is decoding too is decoded twice, and the commit that lands second keeps
## the first upload (_terrain_commit).
static func _prepare_ground_textures(job: Dictionary, region: MapmReader.ParsedRegion) -> void:
	var files := {}
	var new_images := {}
	job["texture_files"] = files
	job["new_images"] = new_images
	var tile_table: TileIndexReader.Table = job["tile_table"]
	var archive: Pk2Reader = job["map_pk2"]
	if tile_table == null or archive == null:
		return
	var known: Dictionary = job["known_textures"]

	var ids := {}
	for block in region.blocks:
		for vertex in block.vertices:
			if vertex.extra.size() < 2:
				continue
			ids[vertex.extra.decode_u16(0) & 0x3ff] = true

	var no_entry := 0
	var unreadable := 0
	var decoded := 0
	var started_ms := Time.get_ticks_msec()
	for id in ids.keys():
		var entry := tile_table.lookup(id)
		if entry == null or entry.filename == "":
			no_entry += 1
			continue
		var filename := entry.filename
		var resolved: bool
		if known.has(filename):
			resolved = known[filename]
		elif new_images.has(filename):
			resolved = new_images[filename] != null
		else:
			decoded += 1
			var image := _decode_ground_image(filename, archive)
			new_images[filename] = image
			resolved = image != null
		if resolved:
			files[id] = filename
		else:
			unreadable += 1
	# One line per region, so a playtest log can say whether a flat or white
	# floor was a texture the archive did not have (unreadable), an id the
	# tile table did not know (no entry), or neither (a rendering problem).
	# The decoded count and time say what this world's own cache cost --
	# on a second login every region's first textures are decoded again
	# (round 560), which is the price of nothing outliving the instance.
	# Since round 565 the time is the decode alone, off the main thread for a
	# streamed cell; the upload is the commit's `images` lap. The same counts
	# ride the job to the commit, which leaves them on the terrain group for
	# /groundprobe (round 579).
	job["ground_counts"] = {"ids": ids.size(), "resolved": files.size(), "decoded": decoded,
		"no_entry": no_entry, "unreadable": unreadable}
	(job["log"] as Array).append(["out", "World3D: ground textures for %s -- %d ids, %d resolved, %d decoded now in %d ms, %d without a tile2d.ifo entry, %d files missing or undecodable%s" % [
		job["mapm_path"], ids.size(), files.size(), decoded, Time.get_ticks_msec() - started_ms, no_entry, unreadable,
		"" if not files.is_empty() else " -- NOTHING resolved, the region draws the flat fallback"]])

## One real Tile2D\<filename>.ddj decoded to an Image (no texture: the
## commit uploads it), or null for a file missing or undecodable -- what
## `_load_ground_texture_file` read and decoded until round 565.
static func _decode_ground_image(filename: String, archive: Pk2Reader) -> Image:
	var bytes := AssetSource.read_bytes("Tile2D\\%s" % filename, archive)
	if bytes.is_empty():
		return null
	var parsed := DdjReader.parse(bytes)
	if parsed == null:
		return null
	return DdjReader.to_image(parsed)

## Real, per-world cache of the 30-frame real water animation loaded from
## Map.pk2's own real `Water\` folder (see docs/WORLD_ISSUES.md's
## 2026-08-26 asset-taxonomy entry) -- every region shares the same real
## water animation, so this is only ever built once per world regardless
## of how many real regions with real water tiles get loaded. Instance
## state since round 560 (statics outlived the world; see
## _ground_texture_cache); cleared in _exit_tree.
var _water_frames_cache: Array = []
var _water_frames_load_attempted := false

## Loads the real 30-frame water flip-book animation
## (Water\water101.ddj..water130.ddj -- a real numbered-frame sequence, not
## a shader effect) into an AnimatedTexture, or null if none of the 30 real
## frames were found (e.g. SRREVAMP_MAP_PK2_PATH unset, or a real archive
## that doesn't ship this folder). Frame timing READ (round 627): the client
## picks frame (GetTickCount() / 100) % 30 in `Map::FUN_00a220b0`, so 100 ms
## a frame -- 10 fps, not the 8 fps this used to guess.
const WATER_FRAME_COUNT := MapmWater.FRAME_COUNT
const WATER_FRAME_FPS := 1000.0 / float(MapmWater.FRAME_MS)

func _load_real_water_animation(archive: Pk2Reader) -> AnimatedTexture:
	if not _water_frames_load_attempted:
		_water_frames_load_attempted = true
		var started_ms := Time.get_ticks_msec()
		for i in range(WATER_FRAME_COUNT):
			var filename := "water1%02d.ddj" % (i + 1)
			var bytes := AssetSource.read_bytes("Water\\%s" % filename, archive)
			if bytes.is_empty():
				continue
			var parsed := DdjReader.parse(bytes)
			if parsed == null:
				continue
			var tex := DdjReader.to_texture(parsed)
			if tex != null:
				_water_frames_cache.append(tex)
		if _water_frames_cache.is_empty():
			print("World3D: no real water frames found under Water\\ -- water tiles render as plain ground")
		else:
			# Once per world: what a second login pays to decode its own
			# frames (round 560), beside the ground textures' own line.
			print("World3D: water animation -- %d of %d frames decoded in %d ms" % [
				_water_frames_cache.size(), WATER_FRAME_COUNT, Time.get_ticks_msec() - started_ms])

	if _water_frames_cache.is_empty():
		return null

	var anim := AnimatedTexture.new()
	anim.frames = _water_frames_cache.size()
	for i in range(_water_frames_cache.size()):
		anim.set_frame_texture(i, _water_frames_cache[i])
		anim.set_frame_duration(i, 1.0 / WATER_FRAME_FPS)
	return anim

## The still surface a PlaneType-1 block draws: `water\water201.ddj`
## (READ, the texture the client loads into world+0x28a7 and binds for those
## blocks). Loaded once per world; null when the archive lacks it.
var _water_still_texture: Texture2D = null
var _water_still_load_attempted := false

func _load_still_water_texture(archive: Pk2Reader) -> Texture2D:
	if not _water_still_load_attempted:
		_water_still_load_attempted = true
		var bytes := AssetSource.read_bytes("Water\\water201.ddj", archive)
		var parsed := DdjReader.parse(bytes) if not bytes.is_empty() else null
		if parsed != null:
			_water_still_texture = DdjReader.to_texture(parsed)
		if _water_still_texture == null:
			print("World3D: no Water\\water201.ddj -- PlaneType-1 still surfaces are not drawn")
	return _water_still_texture

## The two water materials, one per world like the client's own render
## state: every region's water shares them, and the environment's WaterColor
## (channel 14) is written into the animated one whenever the player's
## environment is applied (_apply_real_environment_lighting), as the client
## sets one world-wide texture factor. MapmWater builds them and holds the
## READ render state they follow.
var _water_material: StandardMaterial3D = null
## Round 628: the Water Reflection option, its node, and its two materials.
var _water_reflection_on := true
var _water_reflection: WaterReflection = null
var _water_reflect_material: ShaderMaterial = null
var _water_reflect_still_material: ShaderMaterial = null
var _water_bump_texture: Texture2D = null
var _water_bump_attempted := false

## waterbump3.ddj turned into the bump stage's du/dv (READ, FUN_009f2050).
func _load_water_bump(archive: Pk2Reader) -> Texture2D:
	if not _water_bump_attempted:
		_water_bump_attempted = true
		var started := Time.get_ticks_msec()
		var bytes := AssetSource.read_bytes("SkyBox\\waterbump3.ddj", archive)
		var parsed := DdjReader.parse(bytes) if not bytes.is_empty() else null
		var img := DdjReader.to_image(parsed) if parsed != null else null
		var bump := WaterReflection.bump_image(img)
		if bump != null:
			_water_bump_texture = ImageTexture.create_from_image(bump)
			print("World3D: water bump from SkyBox\\waterbump3.ddj, %dx%d, in %d ms" % [bump.get_width(), bump.get_height(), Time.get_ticks_msec() - started])
		else:
			print("World3D: no SkyBox\\waterbump3.ddj -- the reflection is drawn without its bump")
	return _water_bump_texture

## Writes the water colour into whichever water materials exist.
func _set_water_color(c: Color) -> void:
	if _water_material != null:
		MapmWater.set_water_color(_water_material, c)
	if _water_reflection != null:
		_water_reflection.set_water_color(c)
var _water_still_material: StandardMaterial3D = null
## The EnvironmentID the water's colour was last taken from (-1 none).
var _water_env_id := -1

## Retail's water colour follows the environment of the block under the
## camera (MapmWater.environment_at has the READ chain), one value for the
## whole world. Checked on the zone label's throttle; a change re-samples
## channel 14 into the shared material.
func _water_env_tick() -> void:
	if (_water_material == null and _water_reflect_material == null) or _environment_table == null:
		return
	var cam := get_viewport().get_camera_3d() if get_viewport() != null else null
	if cam == null:
		return
	var pair := _nav_graph_for(cam.global_position)
	if pair.is_empty():
		return
	var group: Node3D = pair[1]
	if not group.has_meta("block_env_ids"):
		return
	var local := group.to_local(cam.global_position)
	var env_id := MapmWater.environment_at(group.get_meta("block_env_ids"), local.x, local.z)
	if env_id < 0 or env_id == _water_env_id:
		return
	for rec in _environment_table.records:
		if rec.key == env_id:
			_water_env_id = env_id
			_env_water_color = EnvironmentReader.sample_color_channel(rec, EnvironmentReader.CHANNEL_WATER_COLOR, _env_time)
			_set_water_color(_env_water_color)
			print("World3D: water colour follows the camera's block, environment %d: %s" % [env_id, str(_env_water_color)])
			return

## The environment's WaterColor (MapmWater.set_water_color clamps it). White
## until an environment is applied -- the neutral fallback
## sample_color_channel already uses, not a colour anyone read.
var _env_water_color := Color(1, 1, 1)

func _water_surface_material(anim: AnimatedTexture) -> StandardMaterial3D:
	if _water_material == null:
		_water_material = MapmWater.water_material(anim, _env_water_color)
	return _water_material

func _water_still_surface_material(tex: Texture2D) -> StandardMaterial3D:
	if _water_still_material == null:
		_water_still_material = MapmWater.still_material(tex)
	return _water_still_material

## A region's real `.nvm` read and parsed, uncached -- the terrain
## prepare's read (round 565; the cache it fills is _grid.navmesh_cache,
## dropped with the region since round 563), which runs on a
## WorkerThreadPool task and so reports through `lines` ([["out"|"err",
## line]], printed by the commit) instead of printing. Null with no
## Data.pk2, no file or no parse.
static func _read_region_navmesh(archive: Pk2Reader, key: int, lines: Array) -> NvmReader.ParsedRegion:
	if archive == null:
		return null
	var nvm_path: String = NAVMESH_PATH_FORMAT % key
	var bytes := AssetSource.read_bytes(nvm_path, archive)
	if bytes.is_empty():
		lines.append(["out", "World3D: no real navmesh at %s -- this region gets no real walkability or water" % nvm_path])
		return null
	var parsed := NvmReader.parse(bytes)
	if parsed == null:
		lines.append(["err", "World3D: could not parse real navmesh at %s" % nvm_path])
		return null
	return parsed

## Prints what a job (or a reader called on its behalf) logged, in order:
## `["out", line]` to stdout, `["err", line]` to stderr.
static func _print_job_log(lines: Array) -> void:
	for line in lines:
		if line[0] == "err":
			printerr(line[1])
		else:
			print(line[1])

## Real walkable graphs, one per loaded region, live in _grid.nav_graphs as
## [NavGraph, Node3D] by region -- the graph plus the node whose own local
## space *is* that region's real coordinate space, so converting between the
## two is done with the node's real transform rather than by re-deriving the
## region placement (and its mirror) by hand. Read through
## _grid.nav_graph_pairs() and _nav_graph_for_region; a region's pair goes
## with its unload (round 563).

## Builds the real walkable graph for a region: its terrain `.nvm` plus every
## real object that `.nvm` lists, each resolved to its own real navigation
## mesh. See NavGraph for how objects attach to a region and why this is data
## rather than collision shapes.
##
## Part of the terrain prepare since round 565 (it was
## `_build_region_nav_graph`, on the main thread): NavGraph.place and
## NavGraph.build are plain GDScript over RefCounted data, and every input is
## in the job -- the navmesh, Data.pk2 behind its lock, the object index and
## a copy of the object navigation meshes already loaded. Sets `nav_graph`
## (null with no navmesh), `used_collisions` (every object id the navmesh
## lists -> its mesh or null, for the commit to put back in
## _grid.object_collision_cache: an unload elsewhere may have pruned one
## while this ran) and `nav_log`, the lines the commit prints once the graph
## is registered.
static func _prepare_nav_graph(job: Dictionary) -> void:
	var region: NvmReader.ParsedRegion = job.get("navmesh")
	var used := {}
	var parsed := {}
	var lines: Array = []
	job["nav_graph"] = null
	job["used_collisions"] = used
	# The ids of `used` this prepare read from the archive rather than found
	# in the job's snapshot -- what _prepared_again counts (round 566's
	# review).
	job["parsed_collisions"] = parsed
	job["nav_log"] = lines
	if region == null:
		return
	var mapm_path: String = job["mapm_path"]
	var archive: Pk2Reader = job["data_pk2"]
	var cache: Dictionary = job["collisions"]
	var placed: Array[NavGraph.PlacedObject] = []
	var missing := 0
	var missing_names := {}
	if archive != null and not region.objects.is_empty():
		var table: ObjidxReader.Table = job["object_index"]
		if table != null:
			for oi in range(region.objects.size()):
				var obj: NvmReader.MapObject = region.objects[oi]
				if not cache.has(obj.resource_id):
					parsed[obj.resource_id] = true
				var collision := _load_object_collision(cache, archive, table, obj.resource_id)
				used[obj.resource_id] = collision
				if collision == null:
					missing += 1
					# Naming them matters: an object with no navigation mesh
					# is one the player can stand *inside*, and "8 objects
					# unresolved" gives no way to tell whether those eight
					# are decorative shrubs or the plaza the town square is
					# built on.
					var missing_entry := table.lookup(obj.resource_id)
					if missing_entry != null and missing_entry.path != "":
						missing_names[missing_entry.path.get_file().get_basename()] = true
					continue
				var placed_object := NavGraph.place(collision, oi, obj.local_position, obj.yaw)
				# Tagged with the real model it came from purely so that a
				# report of what the player is standing on can name it --
				# see _qa_step's position line.
				var entry := table.lookup(obj.resource_id)
				if entry != null and entry.path != "":
					placed_object.set_meta("model", entry.path.get_file().get_basename())
				placed.append(placed_object)
	var graph := NavGraph.build(region, placed)
	job["nav_graph"] = graph
	lines.append(["out", "World3D: real walkable graph for %s -- %d/%d real objects placed, %d real terrain blocking edges" % [
		mapm_path, placed.size(), region.objects.size(), graph.terrain_blocking.size() / 2]])
	if missing > 0:
		lines.append(["out", "World3D:   (%d real objects in that region could not be resolved to a navigation mesh: %s)" % [
			missing, ", ".join(PackedStringArray(missing_names.keys()))]])

## Cache of real object navigation meshes by real resource ID, since a region
## repeats the same handful of real object types across many placements.
## Held in _grid.object_collision_cache; an unload prunes the ids no cached
## navmesh lists any more (round 563). Static over an explicit `cache` since
## round 565: the terrain prepare runs it on a WorkerThreadPool task against
## its job's copy of that cache, and the commit merges what it loaded back.
static func _load_object_collision(
	cache: Dictionary, archive: Pk2Reader, table: ObjidxReader.Table, resource_id: int
) -> BmsReader.CollisionMesh:
	if cache.has(resource_id):
		return cache[resource_id]
	cache[resource_id] = null
	var entry = table.lookup(resource_id)
	if entry == null:
		return null
	# The one mesh the client's own map loader reads (round 644, READ):
	# the `.bsr`'s header word 0x28 names it, and its collision section is
	# the object's navigation mesh -- see NavObjectSource. Rounds 505-643
	# merged the collision sections of every mesh the `.bsr` lists instead;
	# over the 3,268-entry navigation index that agreed on 2,039 objects and
	# differed on 4 (NavObjectSource.load_collision names them).
	var collision := NavObjectSource.load_collision(archive, entry.path)
	cache[resource_id] = collision
	return collision

## The real walkable graph covering the player, as [NavGraph, Node3D], or an
## empty Array when the player is not over any region that has one.
## The real object index that resolves a placement's type ID to its real
## .bsr path, preferring Map.pk2's own table over Data.pk2's -- see
## MAP_OBJECT_INDEX_PATH for why they differ and why the map's wins.
## Cached: every region load needs it, and it is a quarter-megabyte parse.
var _object_index_cache: ObjidxReader.Table = null
var _object_index_load_attempted := false
## The seasonal event pieces this world leaves out (round 583): type id ->
## set name, built once per object index by _seasonal_hidden_for.
var _seasonal_hidden: Dictionary = {}
var _seasonal_hidden_table: ObjidxReader.Table = null

func _load_object_index() -> ObjidxReader.Table:
	if _object_index_load_attempted:
		return _object_index_cache
	_object_index_load_attempted = true

	var bytes := PackedByteArray()
	var source := MAP_OBJECT_INDEX_PATH
	var map_archive := _open_map_pk2_if_set()
	if map_archive != null:
		bytes = AssetSource.read_bytes(MAP_OBJECT_INDEX_PATH, map_archive)
	if bytes.is_empty():
		var data_archive := _open_pk2_if_set()
		if data_archive != null:
			bytes = AssetSource.read_bytes(OBJECT_INDEX_PATH, data_archive)
			source = OBJECT_INDEX_PATH
	if bytes.is_empty():
		printerr("World3D: could not find a real object index (tried Map.pk2's %s and Data.pk2's %s)" % [
			MAP_OBJECT_INDEX_PATH, OBJECT_INDEX_PATH])
		return null

	_object_index_cache = ObjidxReader.parse(bytes)
	if _object_index_cache == null:
		printerr("World3D: could not parse the real object index at ", source)
	else:
		print("World3D: loaded real object index (%d real entries) from %s" % [
			_object_index_cache.entries.size(), source])
	return _object_index_cache

func _nav_graph_for(world_position: Vector3) -> Array:
	# nav_graph_pairs() has already skipped a freed group. At BASE the list
	# kept an unloaded region's pair, and the typed assignment below raised
	# `Trying to assign invalid previously freed instance` on it and aborted
	# this function on every tick, for every region loaded after it (round
	# 563's baseline tour: 687 such errors, the player `off-region` for the
	# rest of the run). The unload now drops the pair as well.
	for pair in _grid.nav_graph_pairs():
		var group: Node3D = pair[1]
		var local := group.to_local(world_position)
		if local.x < 0.0 or local.z < 0.0 or local.x > REGION_SPAN or local.z > REGION_SPAN:
			continue
		return pair
	return []

## The [graph, group] pair for a named region, or [] if it is not loaded.
## _nav_graph_for finds the region under a world position; this finds one by
## the identity the real tables use (npcpos gives a region id and a local
## position, never a world one), which is what lets a QA probe ask about a
## region the player is not standing in.
func _nav_graph_for_region(region_x: int, region_y: int) -> Array:
	return _grid.nav_graph_for_region(region_x, region_y)

##
## Two halves since round 565: `_prepare_navmesh_walls` builds the triangles
## (NvmCollision, plain data) in the terrain prepare, on a WorkerThreadPool
## task for a streamed cell; `_add_navmesh_walls` builds the shape and the
## body from them in the commit, on the main thread.
static func _prepare_navmesh_walls(job: Dictionary) -> void:
	var region: NvmReader.ParsedRegion = job.get("navmesh")
	job["wall_faces"] = PackedVector3Array()
	if region == null:
		return
	var faces := NvmCollision.build_wall_triangles(region, NAVMESH_WALL_HEIGHT)
	job["wall_faces"] = faces
	job["wall_line"] = "World3D: loaded real navmesh walls for %s (%d real blocking of %d internal + %d global edges)" % [
		job["mapm_path"], NvmCollision.blocking_edges(region).size(), region.internal_edges.size(), region.global_edges.size()]

## Adds this region's real navmesh walls: every real blocking edge in its
## `.nvm` cell/edge graph, extruded into a vertical quad by NvmCollision.
##
## This is real *walkability*, which the terrain mesh's own geometric
## collision does not reproduce -- it is the boundary the real game
## actually enforces, and it exists in places no geometry does.
##
## Parented to terrain_group rather than positioned itself, so it inherits
## that node's own rotation and vertical anchoring exactly. The wall
## triangles are built in the same region-local space the terrain mesh uses
## (MapmTerrainBuilder's col -> X, row -> Z): the two formats share a
## byte-identical heightmap, and the local-axis correspondence is measured
## rather than assumed -- see docs/protocol/NVM_FORMAT.md's "Real
## local-axis orientation" section.
##
## Does nothing (and says so) when Data.pk2 isn't set or the region has no
## real navmesh file -- the same honest "nothing to load" behavior as the
## rest of this scene, never a guess.
func _add_navmesh_walls(terrain_group: Node3D, job: Dictionary) -> void:
	var faces: PackedVector3Array = job["wall_faces"]
	if faces.is_empty():
		return
	var shape := ConcavePolygonShape3D.new()
	shape.set_faces(faces)
	var body := StaticBody3D.new()
	body.name = "NavmeshWalls"
	body.collision_layer = NAVMESH_WALL_COLLISION_LAYER
	var body_shape := CollisionShape3D.new()
	body_shape.shape = shape
	body.add_child(body_shape)
	terrain_group.add_child(body)
	if OS.get_environment("SRREVAMP_DEBUG_NAVMESH_WALLS") != "":
		_add_navmesh_wall_debug_mesh(terrain_group, faces)
	print(job["wall_line"])

## Draws the walls _add_navmesh_walls just built, so they can actually
## be looked at. They are deliberately invisible in normal play -- they are
## walkability, not scenery -- which also means a misplaced one is
## impossible to see, and misplacement is exactly the failure this
## project's own headless checks have repeatedly missed. Gated behind
## SRREVAMP_DEBUG_NAVMESH_WALLS so it costs a normal run nothing.
func _add_navmesh_wall_debug_mesh(terrain_group: Node3D, faces: PackedVector3Array) -> void:
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = faces
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(1.0, 0.1, 0.1, 1.0)
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	# Walls are single-sided quads, so without this each one vanishes when
	# viewed from the far side -- which would read as a missing wall.
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	var debug_mesh := MeshInstance3D.new()
	debug_mesh.name = "NavmeshWallsDebug"
	debug_mesh.mesh = mesh
	debug_mesh.material_override = mat
	terrain_group.add_child(debug_mesh)
	var local_aabb := mesh.get_aabb()
	print("World3D: navmesh wall debug mesh local aabb %s .. %s, global origin %s" % [
		local_aabb.position, local_aabb.end, debug_mesh.to_global(local_aabb.position)])

## A region's water, from its own `.m` blocks (round 627; MapmWater has the
## rules and their labels). Until round 627 it came from the `.nvm` plane
## map, with each quad's shape taken from the navmesh tiles' texture type,
## and its triangles faced down under a material that culled back faces, so
## a lake was a sheet seen only from underneath (the v0.1.457 report at
## 98/159, plane 50 over a bed at -30). The `.nvm` plane map also marks water
## in 3,846 blocks the `.m` says have none, and leaves out 6,259 the client
## draws (MEASURED, waterat -census) -- the `.m` is what the client reads.
func _try_add_real_water(terrain_group: Node3D, region: MapmReader.ParsedRegion, mapm_path: String) -> void:
	# SRREVAMP_QA_NOWATER=1 (round 648): build no water at all, so a pixel
	# diff against a normal run measures exactly what the water draws.
	if OS.get_environment("SRREVAMP_QA_NOWATER") != "":
		return
	var coords := _parse_region_coords(mapm_path)
	if not coords.is_empty():
		var region_id := RegionGridState.navmesh_key(int(coords["x"]), int(coords["y"]))
		if not MapmWater.draws_block_water(region_id):
			print("World3D: %s -- region id 0x%04x is a dungeon id: retail draws no block water there" % [mapm_path, region_id])
			return
	# The environment the water's colour follows (_water_env_tick).
	terrain_group.set_meta("block_env_ids", MapmWater.block_environment_ids(region))
	var built := MapmWater.build(region)
	if built.water == null and built.still == null:
		if built.dry_blocks > 0:
			print("World3D: %s -- no water drawn (%d PlaneType-0 block(s), every vertex dry)" % [mapm_path, built.dry_blocks])
		return
	var archive := _open_map_pk2_if_set()
	if archive == null:
		return
	var heights: Array = built.heights.keys()
	heights.sort()
	# The facing is Godot's own front-face rule on the built triangles (the
	# group's z mirror does not change it: Godot flips its cull test for a
	# negative determinant), printed so a run measures it instead of a picture.
	var facing := MapmWater.facing_counts(built.water) + MapmWater.facing_counts(built.still)
	print("World3D: %s -- water: %d animated block(s) (%d fully deep, one quad each), %d still, %d dry skipped, plane height(s) %s, triangles %d up / %d down" % [
		mapm_path, built.water_blocks, built.deep_blocks, built.still_blocks, built.dry_blocks, str(heights), facing.x, facing.y])
	if _water_reflection_on and _water_reflection != null:
		# Round 628: retail's reflection pass (WaterReflection). The frames
		# are not used there (READ); water201 still is, for PlaneType 1.
		var bump := _load_water_bump(archive)
		var still_tex := _load_still_water_texture(archive) if built.still != null else _water_still_texture
		if _water_reflect_material == null:
			_water_reflect_material = _water_reflection.make_material(false, bump, still_tex, _env_water_color)
		if built.still != null and _water_reflect_still_material == null:
			_water_reflect_still_material = _water_reflection.make_material(true, bump, still_tex, _env_water_color)
		_water_reflection.register_region(terrain_group, built.drawn)
		if built.water != null:
			_add_water_instance(terrain_group, "Water", built.water, _water_reflect_material)
		if built.still != null:
			_add_water_instance(terrain_group, "WaterStill", built.still, _water_reflect_still_material)
		return
	if built.water != null:
		var anim := _load_real_water_animation(archive)
		if anim != null:
			_add_water_instance(terrain_group, "Water", built.water, _water_surface_material(anim))
	if built.still != null:
		var tex := _load_still_water_texture(archive)
		if tex != null:
			_add_water_instance(terrain_group, "WaterStill", built.still, _water_still_surface_material(tex))

## The water reflection's copy of a region's terrain (round 628 review): the
## same mesh on the mirror-only layer, each surface's material swapped for
## WaterReflection.clip_material's, which discards below (or above) the
## water plane as retail's user clip plane does. The main view's terrain is
## untouched.
func _add_mirror_terrain(terrain_group: Node3D, patch: MeshInstance3D) -> void:
	if not _water_reflection_on or _water_reflection == null or patch.mesh == null:
		return
	var mirror := MeshInstance3D.new()
	mirror.name = "MirrorTerrain"
	mirror.mesh = patch.mesh
	mirror.layers = WaterReflection.MIRROR_TERRAIN_BIT
	mirror.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	for i in range(patch.mesh.get_surface_count()):
		var src: Material = patch.material_override if patch.material_override != null else patch.mesh.surface_get_material(i)
		if src != null:
			mirror.set_surface_override_material(i, _water_reflection.clip_material(src))
	terrain_group.add_child(mirror)

## One water surface: on WaterReflection's layer, so the mirror camera leaves
## water out of its image as retail's reflection pass does (READ; the layer is
## OURS).
func _add_water_instance(terrain_group: Node3D, node_name: String, mesh: ArrayMesh, mat: Material) -> void:
	var inst := MeshInstance3D.new()
	inst.name = node_name
	inst.mesh = mesh
	inst.material_override = mat
	inst.layers = WaterReflection.WATER_LAYER_BIT
	inst.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	terrain_group.add_child(inst)

## Real sky assets found under Map.pk2's own SkyBox\ folder (2026-08-28,
## see docs/WORLD_ISSUES.md and docs/NEXT_STEPS_RENDERING.md's "Terrain"
## section for the taxonomy-scan history): cloud1.ddj (512x512, DXT3, has a
## real alpha channel), cloud99.ddj (512x512, uncompressed), glow.ddj
## (128x128, uncompressed), shadowsphere.ddj (64x64, DXT3), and
## waterbump3.ddj (512x512, uncompressed) -- confirmed via a real dimension/
## format inspection on the RE box, not guessed. None of these are a single
## large panoramic/equirectangular image, so this is *not* a standard
## six-face or panorama skybox -- the real client evidently builds its sky
## from several small tileable/blended layers instead. No config file or
## mesh describing exactly how the real client combines them was found
## alongside these textures (checked -- no .ifo/.cfg/.bsr next to SkyBox\),
## and the currently-available decompiled binary is the server, not the
## client renderer, so the real exact blending algorithm isn't determinable
## from data alone without further client-side RE (a real, flagged gap, see
## docs/NEXT_STEPS_RENDERING.md).
##
## **Superseded for the clouds in round 628's review follow-up**: the client
## is decompiled now, and its cloud layer is read (cloud_dome.gdshader,
## cloud_layer_mesh): a flat textured grid 20000 above the eye, drawn with
## the eye at the origin, so it has no rim and no parallax. The finite
## 3000-unit hemisphere that stood in for it showed its rim as an arc across
## the sky and in the water's reflection. The sun glow billboard below is
## still this project's stand-in.
## The cloud layer (READ, Map::FUN_00a3de90 / FUN_00a3f570; round 628 review):
## its height above the eye, its grid step and UV step, and the u scroll
## period -- frac(GetTickCount() / 500000).
const CLOUD_LAYER_HEIGHT := 20000.0
const CLOUD_LAYER_STEP := 2000000.0
const CLOUD_LAYER_UV_STEP := 16.0
const CLOUD_SCROLL_MS := 500000.0
## environment.ifo channels the cloud layer reads (READ, round 628 review).
const CHANNEL_CLOUD_COLOR := 4
const CHANNEL_CLOUD_ALPHA := 12
const SUN_GLOW_DISTANCE := 2800.0
const SUN_GLOW_SIZE := 500.0

var _sky_dome: MeshInstance3D
var _sky_dome_material: ShaderMaterial
var _cloud_dome_shader: Shader = preload("res://scripts/assets/cloud_dome.gdshader")
var _cloud_uv_offset := Vector2.ZERO
var _sun_glow: Sprite3D
var _sun_glow_offset := Vector3.ZERO
var _sky_material: GammaSkyMaterial

## Real per-zone day/night lighting data (2026-08-31, see
## docs/protocol/ENVIRONMENT_FORMAT.md and docs/WORLD_ISSUES.md's
## twenty-ninth round): environment.ifo's real SkyTopColor/SkyBottomColor
## channels replace the flat-color-derived gradient _try_add_real_sky()
## builds as a fallback, once a real zone's terrain (and therefore its real
## per-block EnvironmentID) has loaded. Real per-zone checks (Jangan,
## Dunhuang) found every block in a zone shares the same EnvironmentID, so
## reading the first block's is representative, not a guess -- but that
## uniformity hasn't been checked for every zone, so a zone with mixed
## per-block IDs would still only get the first block's color (an honest
## simplification, not wrong for any zone checked so far).
##
## ENVIRONMENT_REFERENCE_TIME is READ from the client (round 226,
## docs/protocol/game_clock.md): SWorld's day/night phase is initialised to
## 0.5 (the float at 0xe1b7e0) in its constructor, the per-frame advance
## (phase += dt * 0.0005, a 2000 s cycle) is gated by a flag nothing in this
## build sets, and the environment graphs are evaluated at that raw phase
## (Map::FUN_00a1baf0 -> FUN_004e55e0). So the retail client samples a fixed
## 0.5 too; a live day/night cycle would be OUR design, not a recovered one.
## The server's game clock (0x34be) feeds nothing in the sky.
const ENVIRONMENT_REFERENCE_TIME := 0.5
## The day phase the environment graphs are read at: ENVIRONMENT_REFERENCE_TIME
## in the world; the front-end backdrop's random title hour (round 678,
## FrontEndBackdrop -- READ: CPSTitle::OnCreate sets SWorld's phase, the same
## +0x26a3 the graphs read, through SWorld::vslot_020).
var _env_time := ENVIRONMENT_REFERENCE_TIME
## The parsed environment.ifo, once per world (instance state since round
## 560, statics until then -- see _ground_texture_cache); cleared in
## _exit_tree.
var _environment_table: EnvironmentReader.ParsedFile = null
var _environment_load_attempted := false

func _try_add_real_sky() -> void:
	var archive := _open_map_pk2_if_set()
	if archive == null:
		print("World3D: SRREVAMP_MAP_PK2_PATH not set -- sky stays a flat placeholder color")
		return

	# Real gradient sky (Godot's own ProceduralSkyMaterial, not a real
	# extracted asset -- no real single sky-gradient image was found, see
	# this function's top comment) replacing the flat background_color the
	# scene shipped with, using that same real color as the horizon tone so
	# this doesn't introduce a new invented color, only extends it into a
	# gradient.
	# GammaSkyMaterial (round 693): ProceduralSkyMaterial's own gradient,
	# drawn the same under Forward+ as under Compatibility.
	var sky_material := GammaSkyMaterial.new()
	var flat_color: Color = world_environment.environment.background_color
	sky_material.sky_top_color = flat_color.lerp(Color(0.15, 0.25, 0.55), 0.35)
	sky_material.sky_horizon_color = flat_color
	sky_material.ground_bottom_color = flat_color.darkened(0.4)
	sky_material.ground_horizon_color = flat_color
	var sky := Sky.new()
	sky.sky_material = sky_material
	world_environment.environment.sky = sky
	world_environment.environment.background_mode = Environment.BG_SKY
	_sky_material = sky_material

	# The cloud layer, as the client draws it (READ, round 628 review:
	# _build_cloud_dome, cloud_layer_mesh, cloud_dome.gdshader) -- a flat
	# grid 20000 above the eye. It replaced the finite hemisphere dome whose
	# polar-UV fade this comment used to describe (rounds 42 and 51).
	var cloud_bytes := AssetSource.read_bytes("SkyBox\\cloud1.ddj", archive)
	if not cloud_bytes.is_empty():
		var parsed := DdjReader.parse(cloud_bytes)
		if parsed != null:
			var cloud_tex := DdjReader.to_texture(parsed)
			if cloud_tex != null:
				_build_cloud_dome(cloud_tex)

	# The real character shadow: a real soft radial blob shipped as
	# SkyBox\shadowsphere.ddj. See _build_blob_shadow.
	var blob_bytes := AssetSource.read_bytes("SkyBox\\shadowsphere.ddj", archive)
	if not blob_bytes.is_empty():
		var blob_parsed := DdjReader.parse(blob_bytes)
		if blob_parsed != null:
			var blob_tex := DdjReader.to_texture(blob_parsed)
			if blob_tex != null:
				_build_blob_shadow(blob_tex)

	var glow_bytes := AssetSource.read_bytes("SkyBox\\glow.ddj", archive)
	if not glow_bytes.is_empty():
		var glow_parsed := DdjReader.parse(glow_bytes)
		if glow_parsed != null:
			var glow_tex := DdjReader.to_texture(glow_parsed)
			if glow_tex != null:
				_build_sun_glow(glow_tex)

func _build_cloud_dome(cloud_tex: Texture2D) -> void:
	_sky_dome_material = ShaderMaterial.new()
	_sky_dome_material.shader = _cloud_dome_shader
	_sky_dome_material.set_shader_parameter("cloud_tex", cloud_tex)
	_sky_dome_material.set_shader_parameter("uv_offset", Vector2.ZERO)
	# Drawn behind everything else transparent (cloud_dome.gdshader).
	_sky_dome_material.render_priority = -128
	_sky_dome = MeshInstance3D.new()
	_sky_dome.name = "CloudDome"
	_sky_dome.mesh = cloud_layer_mesh()
	_sky_dome.material_override = _sky_dome_material
	_sky_dome.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	# The shader places it relative to the eye, so the node's own bounds mean
	# nothing: never cull it.
	_sky_dome.custom_aabb = AABB(Vector3(-1.0e7, -1.0e7, -1.0e7), Vector3(2.0e7, 2.0e7, 2.0e7))
	# Retail's reflection pass draws the sky too (round 628 review).
	_sky_dome.layers = 1 | WaterReflection.REFLECTED_BIT
	add_child(_sky_dome)

## The cloud layer's mesh (READ, Map::FUN_00a3de90): a flat 5x5-vertex grid,
## 20000 above the eye, x and z from -4,000,000 to 4,000,000 in 2,000,000
## steps, u and v from -32 to 32 in 16s; four triangles' worth of quads a
## side. Positions are offsets from the eye (cloud_dome.gdshader).
static func cloud_layer_mesh() -> ArrayMesh:
	var pos := PackedVector3Array()
	var uv := PackedVector2Array()
	for zi in range(5):
		for xi in range(5):
			pos.append(Vector3((xi - 2) * CLOUD_LAYER_STEP, CLOUD_LAYER_HEIGHT, (zi - 2) * CLOUD_LAYER_STEP))
			uv.append(Vector2((xi - 2) * CLOUD_LAYER_UV_STEP, (zi - 2) * CLOUD_LAYER_UV_STEP))
	var idx := PackedInt32Array()
	for r in range(4):
		for c in range(4):
			var i := r * 5 + c
			idx.append_array(PackedInt32Array([i, i + 1, i + 6, i, i + 6, i + 5]))
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = pos
	arrays[Mesh.ARRAY_TEX_UV] = uv
	arrays[Mesh.ARRAY_INDEX] = idx
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return mesh

func _build_sun_glow(glow_tex: Texture2D) -> void:
	# Real DirectionalLight3D direction (see World3D.tscn) -- the sun's
	# apparent position is the opposite of the direction the light travels.
	var light_travel_dir := -directional_light.global_transform.basis.z
	var sun_dir := -light_travel_dir

	_sun_glow = Sprite3D.new()
	_sun_glow.name = "SunGlow"
	_sun_glow.texture = glow_tex
	_sun_glow.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	_sun_glow.shaded = false
	_sun_glow.modulate = Color(1, 1, 0.9, 0.85)
	_sun_glow.pixel_size = SUN_GLOW_SIZE / glow_tex.get_width()
	_sun_glow_offset = sun_dir * SUN_GLOW_DISTANCE
	_sun_glow.position = _sun_glow_offset
	# The Lens Flare row (round 694, apply_video_options).
	_sun_glow.visible = video_options().value(VideoOptions.LENS_FLARE) == 1
	add_child(_sun_glow)

## Loads and caches the real environment.ifo (Map.pk2's root) once per world --
## every real zone shares the same table, only the looked-up Key differs.
func _load_environment_table(archive: Pk2Reader) -> EnvironmentReader.ParsedFile:
	if not _environment_load_attempted:
		_environment_load_attempted = true
		var bytes := AssetSource.read_bytes("environment.ifo", archive)
		if not bytes.is_empty():
			_environment_table = EnvironmentReader.parse(bytes)
		if _environment_table == null:
			print("World3D: no real environment.ifo found -- sky keeps its flat-color-derived gradient")
	return _environment_table

## Real per-zone sky color, from a real region's own EnvironmentID (see this
## file's _sky_material doc comment for the real-data justification and
## ENVIRONMENT_REFERENCE_TIME's honest scope). No-op if _sky_material was
## never built (e.g. no SRREVAMP_MAP_PK2_PATH) or no matching real record is
## found -- leaves the existing flat-color-derived gradient rather than
## guessing.
func _apply_real_environment_lighting(region: MapmReader.ParsedRegion, archive: Pk2Reader) -> void:
	if _sky_material == null or region.blocks.is_empty():
		return
	var table := _load_environment_table(archive)
	if table == null:
		return
	var env_id := region.blocks[0].environment_id
	var record: EnvironmentReader.Record = null
	for rec in table.records:
		if rec.key == env_id:
			record = rec
			break
	if record == null:
		print("World3D: region's EnvironmentID %d has no matching environment.ifo record" % env_id)
		return

	var top := EnvironmentReader.sample_color_channel(record, EnvironmentReader.CHANNEL_SKY_TOP_COLOR, _env_time)
	var bottom := EnvironmentReader.sample_color_channel(record, EnvironmentReader.CHANNEL_SKY_BOTTOM_COLOR, _env_time)
	_sky_material.sky_top_color = top
	_sky_material.sky_horizon_color = bottom
	_sky_material.ground_horizon_color = bottom
	_sky_material.ground_bottom_color = bottom.darkened(0.4)

	# Real per-zone SunColor/DiffuseColor (2026-09-02) -- same real
	# environment.ifo record the sky colors above already use, just two more
	# of its real channels that were decoded from day one but never wired to
	# anything (see docs/protocol/ENVIRONMENT_FORMAT.md). Sampled at the same
	# fixed ENVIRONMENT_REFERENCE_TIME as the sky, for the same honest reason
	# (no real day/night clock exists yet). Real sample data confirms these
	# genuinely differ per zone at midday -- Jangan's SunColor is ~white,
	# Dunhuang's DiffuseColor is a warm tan -- not a no-op recoloring.
	# DirectionalLight3D's real per-zone *angle* has no confirmed real source
	# (only color channels exist in this format) and stays a hand-set
	# constant, unchanged.
	var sun_color := EnvironmentReader.sample_color_channel(record, EnvironmentReader.CHANNEL_SUN_COLOR, _env_time)
	var diffuse_color := EnvironmentReader.sample_color_channel(record, EnvironmentReader.CHANNEL_DIFFUSE_COLOR, _env_time)
	var ambient_color := EnvironmentReader.sample_color_channel(record, EnvironmentReader.CHANNEL_OBJECT_AMBIENT_COLOR, _env_time)

	# **Channel roles corrected 2026-09-07 from the real client's own shader**
	# (see docs/RE_MAP_ENGINE.md). The real terrain vertex shader
	# (`Shader\vertexshader0splatting.c`) lights a vertex as
	#
	#     mad oD0, N.L, c[VSC_DLIGHT_DIFFUSE], c[VSC_DLIGHT_AMBIENT]
	#
	# so the real *diffuse* channel is the directional light's own colour --
	# the term multiplied by N.L -- and the real *ambient* channels are the
	# additive ambient term. This code had those two the other way round: it
	# put SunColor on the directional light and DiffuseColor into ambient.
	#
	# That mattered, and the real data shows why: real SunColor is (1,1,1) in
	# most real records -- it is the sun *disc's* own colour, which is why it
	# now tints the real sun glow sprite below instead -- while real
	# DiffuseColor carries the actual per-zone tint (a real warm
	# 0.70/0.60/0.50, a real cold 0.70/0.53/0.93). Driving the directional
	# light from SunColor therefore threw that per-zone character away and
	# lit every zone with plain white, while pushing the tint into ambient,
	# where it flattened shading instead of directing it.
	directional_light.light_color = diffuse_color
	world_environment.environment.ambient_light_color = ambient_color
	# Round 635's review follow-up: the player block's portrait is lit by this
	# zone light (retail's avatar draws with the world's vslot_025 light), and
	# re-renders when it changes -- a zone load is world entry or a teleport,
	# when retail's FUN_00786f30 -> FUN_006abc50 dirties it.
	_portrait_zone_light = [diffuse_color, ambient_color]
	# The equipment window's preview draws with the same world light (round
	# 633's review: its own D3DLIGHT9 goes to fixed-function state no draw
	# reads -- PaperDoll's header).
	if _paper_doll != null:
		_paper_doll.set_zone_light(diffuse_color, ambient_color)
	if _hud_player_info != null:
		_hud_player_info.set_portrait_zone_light(diffuse_color, ambient_color)
		var pp := _hud_player_info.portrait()
		print("World3D: portrait zone light (EnvironmentID %d): diffuse channel %s ambient channel %s, renders %d" % [
			env_id, diffuse_color, ambient_color, pp.renders_requested if pp != null else -1])

	# Kept so the terrain mesh built moments later can bake the real client's
	# own per-vertex terrain lighting -- see MapmTerrainBuilder's
	# _lit_vertex_color. TerrainAmbientColor is a *separate* real channel from
	# the object ambient above, and genuinely differs (often (1,1,1) against
	# the object ambient's 0.58), which is exactly why baking terrain lighting
	# lets both be honoured where one global ambient cannot.
	_env_light_diffuse = diffuse_color
	_env_terrain_ambient = EnvironmentReader.sample_color_channel(record, EnvironmentReader.CHANNEL_TERRAIN_AMBIENT_COLOR, _env_time)
	_env_terrain_shadow = EnvironmentReader.sample_color_channel(record, EnvironmentReader.CHANNEL_TERRAIN_SHADOW_COLOR, _env_time)
	_env_light_ready = true
	# The water's tint: channel 14 (READ: the record reader stores it at
	# record+0x228, and `Map::FUN_00a1baf0` evaluates that graph into
	# world+0x688f, the texture factor FUN_00a220b0 draws water with).
	# A starting value from the region's block 0; _water_env_tick then
	# follows the camera's block, as retail does.
	_env_water_color = EnvironmentReader.sample_color_channel(record, EnvironmentReader.CHANNEL_WATER_COLOR, _env_time)
	_water_env_id = env_id
	_set_water_color(_env_water_color)
	print("World3D: environment %d water colour (channel 14) %s" % [env_id, str(_env_water_color)])

	# Real per-zone aerial-perspective haze (2026-09-03). The real client's
	# own terrain shaders were found shipped as readable source inside
	# Data.pk2's `Shader\` folder (see docs/protocol/SHADER_FINDINGS.md), and
	# they show the real distance model is not a simple linear near/far fog at
	# all -- it's atmospheric scattering. `scattervsdetail10.vsh` computes a
	# per-channel extinction `E = exp(-(beta_1 + beta_2) * s)` over view-space
	# distance s, and `terrainps14.psh` combines it as
	# `final = surf_color * extinction + inscattering`.
	#
	# That is structurally the same operation as Godot's own exponential fog
	# (surface blended toward a fog color by `1 - exp(-density * depth)`), so
	# the model here is real and recovered, not invented -- and the *color* is
	# real per-zone data: environment.ifo's own FogColor channel, sampled at
	# the same fixed ENVIRONMENT_REFERENCE_TIME as the sky and sun above.
	#
	# The real fog RANGE is read now (round 229, EnvironmentReader's channel
	# notes): the client's fog near and far planes are channels 10 and 11
	# times its view distance (2500 by default) -- a linear D3D fog that is
	# zero until the near plane and complete at the far one. What is still a
	# disclosed rendering choice is FOG_DENSITY: Godot 4.2's fog is
	# exponential from the camera (no depth-range mode until 4.3), so the
	# real planes cannot be applied without a shader pass; until that exists
	# they are computed, logged and shown by QA_LOOK, and the density stays
	# the bounded choice described at FOG_DENSITY.
	var fog_channel := EnvironmentReader.sample_color_channel(record, EnvironmentReader.CHANNEL_FOG_COLOR, _env_time)
	# What the client fogs with is the square root of the clamped channel
	# (READ, rounds 623-628 integration review: EnvironmentReader.
	# render_fog_color). Until then the raw channel was used, darker.
	var fog_color := EnvironmentReader.render_fog_color(fog_channel)
	if OS.get_environment("SRREVAMP_QA_FOG_RAW") != "":
		# QA only: the pre-review colour, for a before/after on one build.
		fog_color = fog_channel
	# The cloud layer's texture factor (READ, round 628 review): RGB is
	# channel 4 (FUN_00a3eb40's param_6 = world+0x685f, evaluated from
	# record+0x158), alpha is world+0x68c7 = (channel 12 + 1) / 2. Its fog is
	# the world's fog colour between 90,000 and 200,000.
	if _sky_dome_material != null:
		var cc := EnvironmentReader.sample_color_channel(record, CHANNEL_CLOUD_COLOR, _env_time)
		var ca := clampf((EnvironmentReader.sample_float_channel(record, CHANNEL_CLOUD_ALPHA, _env_time) + 1.0) * 0.5, 0.0, 1.0)
		_sky_dome_material.set_shader_parameter("cloud_color", Vector3(clampf(cc.r, 0, 1), clampf(cc.g, 0, 1), clampf(cc.b, 0, 1)))
		_sky_dome_material.set_shader_parameter("cloud_alpha", ca)
		_sky_dome_material.set_shader_parameter("fog_color", Vector3(fog_color.r, fog_color.g, fog_color.b))
		print("World3D: cloud layer colour (channel 4) %s, alpha (channel 12) %.3f" % [str(cc), ca])
	_fog_near_real = EnvironmentReader.sample_float_channel(record, EnvironmentReader.CHANNEL_FOG_NEAR_PLANE, _env_time) * EnvironmentReader.VIEW_DISTANCE_DEFAULT
	_fog_far_real = EnvironmentReader.sample_float_channel(record, EnvironmentReader.CHANNEL_FOG_FAR_PLANE, _env_time) * EnvironmentReader.VIEW_DISTANCE_DEFAULT
	print("World3D: environment fog planes (real, channels 10/11 x view distance %.0f): near %.0f, far %.0f -- drawn with Godot density %.5f (disclosed)" % [
		EnvironmentReader.VIEW_DISTANCE_DEFAULT, _fog_near_real, _fog_far_real, FOG_DENSITY])
	var env := world_environment.environment
	env.fog_enabled = true
	env.fog_light_color = fog_color
	# Times the Background Sight Range's factor (round 694; 1 at the default).
	env.fog_density = FOG_DENSITY * _fog_scale
	# The real model's inscattering is strongest looking toward the sun (the
	# Henyey-Greenstein phase term in the real vertex shader), which is exactly
	# what Godot's fog_sun_scatter approximates.
	# Divided by the Forward+ sun scale (round 693): both renderers scale the
	# fog's sun scatter by the light's energy (READ, gles3 scene.glsl 1183 /
	# scene_forward_clustered.glsl 833), and the raised Forward+ sun is there
	# to match the shadow pass, not to brighten the haze (READ; no change
	# MEASURED at the shots taken, where the sky's sun was what had brightened
	# -- GammaSkyMaterial's sun_energy_scale).
	env.fog_sun_scatter = FOG_SUN_SCATTER / WorldPostEffects.sun_scale()
	env.fog_aerial_perspective = FOG_AERIAL_PERSPECTIVE
	# The sky is not fogged (round 693): Compatibility's sky shader never
	# mixes the environment fog in (READ, drivers/gles3/shaders/sky.glsl,
	# 4.2.2), Forward+ does by fog_sky_affect (default 1.0, renderer_rd sky.
	# glsl 263-265), which hazed the Jangan sky shot's top band +22 luma
	# (MEASURED). The cloud layer fogs itself (cloud_dome.gdshader).
	env.fog_sky_affect = 0.0

	# The real sun-disc colour belongs on the real sun sprite. Its alpha stays
	# a disclosed rendering choice (see _build_sun_glow); only the real colour
	# is taken from real data.
	if _sun_glow != null:
		_sun_glow.modulate = Color(sun_color.r, sun_color.g, sun_color.b, _sun_glow.modulate.a)

	# The cloud layer's Compatibility-style blend under Forward+ (round 693's
	# review; GammaSkyMaterial.feed_clouds), fed after the sky, the sun and
	# the light are set.
	if _sky_material != null:
		_sky_material.feed_clouds(_sky_dome_material, directional_light, world_environment.environment)

	print("World3D: applied real environment.ifo lighting (%s, EnvironmentID=%d) -- sky_top=%s sky_bottom=%s sun_disc=%s light_diffuse=%s ambient=%s fog=%s (channel 9 %s)" % [record.name1, env_id, top, bottom, sun_color, diffuse_color, ambient_color, fog_color, fog_channel])

## Opens the real Map.pk2 -- SRREVAMP_MAP_PK2_PATH if set, else a real
## "pk2/Map.pk2" next to the running executable (see Pk2Config) -- or
## returns null if neither resolves or the open fails. Map.pk2 is a separate
## archive from Data.pk2 in a real retail install (confirmed from the
## user's own real client file listing: Data.pk2, Media.pk2, Map.pk2,
## Particles.pk2 are all separate files) -- so terrain resolves its own real
## pk2 path rather than reusing Data.pk2's.
func _open_map_pk2_if_set() -> Pk2Reader:
	if _map_pk2 != null:
		return _map_pk2
	var map_pk2_path := Pk2Config.map_path()
	if map_pk2_path == "":
		return null
	_map_pk2 = Pk2Reader.open(map_pk2_path)
	return _map_pk2

## Opens the real Media.pk2 -- SRREVAMP_MEDIA_PK2_PATH if set, else a real
## "pk2/Media.pk2" next to the running executable (see Pk2Config) -- or
## returns null if neither resolves or the open fails. A real client's
## per-map-region minimap image (see SRREVAMP_MAPM_TEXTURE_PATH below) lives
## in Media.pk2, a third separate archive from both Data.pk2 and Map.pk2 in
## a real retail install.
func _open_media_pk2_if_set() -> Pk2Reader:
	if _media_pk2 != null:
		return _media_pk2
	var media_pk2_path := Pk2Config.media_path()
	if media_pk2_path == "":
		return null
	_media_pk2 = Pk2Reader.open(media_pk2_path)
	return _media_pk2

## The player's Particles.pk2, cached (same lazy-open pattern as the others).
## Returns null when no Particles.pk2 is configured -- the level-up effect
## then plays no visual rather than a fabricated one.
func _open_particles_pk2_if_set() -> Pk2Reader:
	if _particles_pk2 != null:
		return _particles_pk2
	var particles_pk2_path := Pk2Config.particles_path()
	if particles_pk2_path == "":
		return null
	_particles_pk2 = Pk2Reader.open(particles_pk2_path)
	return _particles_pk2

## Loads a real per-region minimap image (SRREVAMP_MAPM_TEXTURE_PATH, e.g.
## "minimap\100x100.ddj") as the terrain's real ground texture, if set.
## Accepts either a loose file path or a path inside SRREVAMP_MEDIA_PK2_PATH
## (see AssetSource) -- a real client's minimap images live in Media.pk2,
## confirmed via this project's own real-file search tooling
## (server/cmd/pk2list) against a real client install.
##
## This is an honest substitution, not a claim that this is the literal
## real-time 3D ground texture: no real-time multi-layer terrain-texture
## system (nor a lookup from a per-tile byte to a specific real texture
## file) has been found anywhere in this project's available real data --
## see docs/protocol/MAPM_FORMAT.md for that search. A region's own real
## minimap art is genuine, region-specific real game data (grass/dirt/rock
## color baked from that exact region), and looks far closer to the real
## game than the flat/procedural fallback color this function returns null
## for -- but it's a real top-down painted image, not sampled per-tile 3D
## terrain texture data.
## path_override lets a zone reload (see _reload_zone_assets) pass a
## specific real path instead of reading SRREVAMP_MAPM_TEXTURE_PATH -- empty
## string (the default) means "use the env var", same as every call site
## before zone reloading existed.
func _load_real_terrain_texture(path_override: String = "") -> Texture2D:
	var tex_path := path_override if path_override != "" else OS.get_environment("SRREVAMP_MAPM_TEXTURE_PATH")
	if tex_path == "":
		return null

	var archive := _open_media_pk2_if_set()
	var bytes := AssetSource.read_bytes(tex_path, archive)
	if bytes.is_empty():
		printerr("World3D: could not find terrain texture at ", tex_path)
		return null

	var parsed := DdjReader.parse(bytes)
	if parsed == null:
		printerr("World3D: could not parse terrain texture at ", tex_path)
		return null

	return DdjReader.to_texture(parsed)

## Loads a region's real .t file (the same base path as mapm_path, with
## its extension swapped) as a real ambient-occlusion-style lightmap --
## see docs/protocol/MAPT_FORMAT.md for the real structure and how this
## project confirmed it (public documentation, verified byte-for-byte
## against a real sample, cross-decoded two independent ways). The real
## embedded texture is a genuine grayscale shadow map (white = fully lit,
## gray = shadowed) -- a natural fit for Godot's built-in AO darkening,
## unlike an earlier same-day attempt to show a *different*, wrongly-
## decoded payload as literal detail-albedo color (reverted after live
## testing looked wrong -- see MAPT_FORMAT.md's own account). Not every
## region has a `.t` file (only newer-generation "Shape B" regions do --
## see MAPM_FORMAT.md's Shape A/B split), so a missing file here is the
## normal, expected case, not an error.
##
## Static and texture-free since round 565: it runs in the terrain prepare,
## on a WorkerThreadPool task for a streamed cell, so it returns the parsed
## file with the lightmap as an Image (`image`; MapTReader.parse's
## with_texture false) and the commit uploads it. The same real `.t` also
## carries the real per-tile ShadowMap, the self-shadow term of the real
## terrain equation, which goes into the job beside it for the mesh builder
## (which does not apply it -- MapmTerrainBuilder._shadow_at says why). Until
## round 565 that map was stashed in a member, so a region with no `.t`
## handed the builder the previous region's -- harmless only because it is
## not applied. Null with no file or no parse.
static func _read_terrain_lightmap(mapm_path: String, archive: Pk2Reader) -> MapTReader.ParsedRegion:
	if mapm_path == "" or not mapm_path.ends_with(".m"):
		return null
	var mapt_path := mapm_path.substr(0, mapm_path.length() - 1) + "t"
	var bytes := AssetSource.read_bytes(mapt_path, archive)
	if bytes.is_empty():
		return null
	return MapTReader.parse(bytes, false)

## The real Jangan region. **Corrected again 2026-09-01** (see
## docs/WORLD_ISSUES.md's thirty-ninth round): "89/182" (found 2026-08-26 by
## raw keyword density alone -- 279 real "jangan"-named placements, the
## single densest region in all 4,050) turned out to be a real, confirmed
## *isolated* pocket -- a direct listing of the real Map.pk2 archive shows
