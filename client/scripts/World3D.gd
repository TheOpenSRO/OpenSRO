			_log_system("The global chat window is unavailable.")
			return
		_hud_whole_chat.send_requested.connect(func(at: int, text: String) -> void:
			print("CHAT GLOBAL: slot %d: %s" % [at, text])
			NetClient.send_global(at, text))
		_hud_whole_chat.refused.connect(_log_system)
	_hud_whole_chat.open_for(slot, count)

## A system line (round 639): to the system message window, as retail's
## 0x7781b0(type, text) writes its own -- `type` is the window's filter type
## (HudSystemMessage.TYPE_*; 0 always shows). Every line this client writes
## here is either retail's own message for the same event (the pickup, EXP and
## party lines, refusals) or OpenSRO's own (the help hints, the dev tools,
## the quickslot and zone lines; docs/protocol/system_message.md lists them).
## Before the window exists (and on a bare World3D) the chat's All list
## takes it, as before.
func _log_system(text: String, type: int = HudSystemMessage.TYPE_ALWAYS) -> void:
	if _hud_syslog != null:
		_hud_syslog.add_message(type, text)
	elif _hud_chat != null:
		_hud_chat.add_message("", "* " + text)
	_tail_log("* " + text)

## Keeps a line in the plain-text tail (LOG_TAIL_LINES; round 848).
func _tail_log(line: String) -> void:
	_log_tail.append(line)
	if _log_tail.size() > LOG_TAIL_LINES:
		_log_tail = _log_tail.slice(_log_tail.size() - LOG_TAIL_LINES)

## The tail's lines, one a line -- what the suites read (a bare World3D, no
## HUD windows) and the debug panel can quote.
func log_text() -> String:
	return "\n".join(_log_tail)

# --- Debug console and Help window ----------------------------------------

## Builds the slash console and the in-client Help window, wires the server's
## GM reply, and puts a tooltip on the chat line telling a tester the
## commands exist. Called once from _ready after the chat is set up.
func _setup_console_and_help() -> void:
	_help_window = HelpWindow.new()
	_help_window.name = "HelpWindow"
	ui_control.add_child(_help_window)
	_help_window.setup(_ui_builder, _help_documents(), _is_gm)
	# Escape closes it in the original's order (0x79d620: after the System
	# window, before the world map; round 858).
	if _hud_panels != null:
		_hud_panels.help_window = _help_window
	# Round 858: the window hole census in a real run (OPENSRO_QA_HOLES).
	HoleCensus.qa_hook(self)

	_console = Console.new(_console_host())
	NetClient.gm_command_result.connect(_on_gm_command_result)
	# This scene usually loads after enter_world_result has already fired, so
	# the probe in that handler never ran for it -- fire it now if the world
	# is already entered.
	if NetClient.last_enter_world_result != null and NetClient.last_enter_world_result.ok:
		_fire_gm_probe()
		_hint_help_once()

	# Discoverability: hovering the chat line says the commands exist. Godot
	# tooltips need a control that takes hover, so mark the input and the
	# underbar's menu button. Our own wording (the client has no authored
	# string for this).
	_refresh_command_tooltip()
	if _hud_underbar != null:
		var menu_btn := _hud_underbar.menu_button()
		if menu_btn != null:
			menu_btn.tooltip_text = _command_tooltip()

	# The QA hooks (OPENSRO_QA_COMMANDS, OPENSRO_QA_HELP) fire from the
	# frame-tick block in the QA process function, like every other hook.
	print("Console: ready (help window %s, log %s)" % [
		"authored frame" if _help_window != null and _help_window.has_authored_frame() else "plain frame",
		ProjectSettings.globalize_path("user://logs/opensro.log")])

## The documents the Help window lists, shipped under res://docs/ by
## client/tools/bundle_docs.sh.
func _help_documents() -> Array:
	return [
		{"title": "Playing", "path": "res://docs/HELP_PLAYING.md"},
		{"title": "Debug tools", "path": "res://docs/DEBUG_TOOLS.md"},
		{"title": "Release notes", "path": "res://docs/RELEASE_NOTES.md"},
	]

## The host of Callables the console reports through. Kept here so the console
## itself has no dependency on World3D and is tested headless with stubs.
func _console_host() -> Dictionary:
	return {
		# Chat AND the log file (print reaches user://logs/opensro.log), so a
		# report can quote the console's own output.
		"log": func(t: String) -> void:
			_log_system(t)
			print("CONSOLE: " + t),
		"open_help": func() -> void:
			if _help_window != null:
				_help_window.open(),
		"where": Callable(self, "_where_report"),
		"log_path": func() -> String: return ProjectSettings.globalize_path("user://logs/opensro.log"),
		"open_log_dir": Callable(self, "_open_log_dir"),
		# Round 848: the report without the panel, which a release build does
		# not build (DevTools).
		"copy_payload": func() -> String: return DebugPanel.diagnostics_for(self),
		"set_clipboard": func(s: String) -> void: DisplayServer.clipboard_set(s),
		"fps": func() -> float: return Engine.get_frames_per_second(),
		"entities": Callable(self, "_entities_report"),
		"recent_errors": Callable(self, "_recent_script_errors"),
		"set_wire": Callable(self, "_set_wire_logging"),
		"set_camera_mode": Callable(self, "_console_set_camera"),
		"whisper": func(n: String, m: String) -> void: NetClient.whisper(n, m),
		"unstuck": func() -> void: _unstuck_player(),
		# Round 814: /grantname -- the own grant name (0x7256).
		"grant_name": func(nick: String) -> void: NetClient.send_guild_grant_name(nick),
		"friend_ask": func(who: String) -> void: friend_ask(who),
		"ground_probe": Callable(self, "_run_ground_probe"),
		# Round 848: the prototype duel's commands (its native tab is gone),
		# and the two settings only the debug panel used to set (OURS).
		"duel": func(verb: String, arg: String) -> void: duel_command(verb, arg),
		"set_ui_scale": func(p: int) -> String: return _console_set_ui_scale(p),
		"set_name_range": func(v: float) -> float: return _console_set_name_range(v),
		"forward_gm": func(line: String) -> void: NetClient.gm_command(NetClient.current_character_name, line, _last_attack_target if _last_attack_target > 0 else 0),
	}

## /uiscale (round 848, OURS): the UI scale, remembered and applied now.
## Round 854: a percentage of the Option window's list (Console snaps it),
## applied as the window's Apply does -- the largest that fits when this
## window is too small for it (UiScaleChoices). Returns the line to show.
func _console_set_ui_scale(percent: int) -> String:
	UiScaleChoices.save_percent(percent)
	if not is_inside_tree():
		return ""
	var used := UiScaleChoices.apply_saved(get_window())
	return UiScaleChoices.describe(UiScaleChoices.saved_percent(), used, get_window().size)

## /names (round 848, OURS): how near a name plate shows, as the debug
## panel's slider set it, remembered. Returns the range applied.
func _console_set_name_range(v: float) -> float:
	var distance := clampf(v, 0.0, 400.0)
	set_name_plate_range(distance)
	ClientSettings.set_value(ClientSettings.SECTION_UI, ClientSettings.KEY_NAME_PLATE_RANGE, distance)
	return distance

## This World3D's entry number in the process: 1 on a fresh launch, 2 after
## the first reconnect or return from character select (GroundProbe.next_entry
## -- the OPENSRO_WORLD_ENTRY environment variable, never a static: what
## outlives an instance is what the white ground after a reconnect is
## suspected of). Round 579.
var _world_entry := 0
## Region grids this instance has built: 1 for the entry, one more per zone
## change (_load_region_neighborhood).
var _grid_builds := 0
## Terrain commits per .m path in this world (_terrain_commit).
var _terrain_commits := {}
## The /groundprobe run still stepping through its A/B checks, if any.
var _ground_probe: GroundProbe = null

## /groundprobe [quick] and the F3 panel's Ground probe button (round 579):
## GroundProbe, run on the region under the player. Returns the chat lines;
## the probe's own lines go to the log and user://logs/groundprobe-*.txt.
## "quick" skips the A/B checks. Any player can run it: nothing reaches the
## server.
func _run_ground_probe(mode: String = "full") -> PackedStringArray:
	if _ground_probe != null and is_instance_valid(_ground_probe) and _ground_probe.is_running():
		return PackedStringArray(["A ground probe is still running -- wait for its 'done' line."])
	var probe := GroundProbe.new()
	probe.name = "GroundProbe"
	add_child(probe)
	_ground_probe = probe
	var focus: Vector3 = player.position if player != null else Vector3.ZERO
	return probe.start(self, _world_entry, mode, focus, {
		"connected": NetClient.is_connected_to_server(),
		"zone": _current_zone_name,
	})

## /where: zone, region y/x, local and world coordinates, walkable height.
func _where_report() -> PackedStringArray:
	var out: PackedStringArray = []
	var p := player.global_position
	# The zone the server last put the player in -- a zone change or a
	# teleport's arrival as well as the entry (NetClient.current_zone, set by
	# both results). Until round 642's review this read the entry's result
	# alone, so after a ferry /where still named the zone the session began in.
	var zone: String = NetClient.current_zone
	if zone == "":
		var result = NetClient.last_enter_world_result
		zone = result.zone if result != null else "?"
	out.append("zone: %s" % zone)
	# The region is whichever loaded cell's own space contains the player --
	# each RealTerrain_<x>_<y> node's local space IS that region's real
	# coordinate space (see _grid.nav_graphs), so this is the inverse of
	# _place_at_region_local rather than arithmetic on the world origin,
	# which named the *relative* cell (0/-1) instead of the real one (97/168).
	var found := false
	for pair in _grid.nav_graph_pairs():
		var group := pair[1] as Node3D
		var graph := pair[0] as NavGraph
		if group == null or graph == null:
			continue
		var local := group.to_local(p)
		if local.x < 0.0 or local.x >= REGION_SPAN or local.z < 0.0 or local.z >= REGION_SPAN:
			continue
		# Node name RealTerrain_<region_x>_<region_y>; written x/y, the
		# project's own notation (Jangan town is "97/168", file 97\168.m).
		var parts := String(group.name).split("_")
		if parts.size() >= 3:
			out.append("region: %s/%s (x/y as in %s\\%s.m)" % [parts[1], parts[2], parts[1], parts[2]])
		out.append("local: %.1f, %.1f" % [local.x, local.z])
		out.append("world: %.1f, %.1f, %.1f" % [p.x, p.y, p.z])
		out.append("walkable height here: %.2f (graph), terrain ray %.2f, feet at %.2f" % [
			group.to_global(Vector3(local.x, graph.height_at(local.x, local.z, local.y), local.z)).y,
			_terrain_height_at(p), p.y])
		found = true
		break
	if not found:
		out.append("region: not inside any loaded region cell")
		out.append("world: %.1f, %.1f, %.1f" % [p.x, p.y, p.z])
		out.append("terrain ray height here: %.2f" % _terrain_height_at(p))
	return out

## /entities: counts of what is in view around the player.
func _entities_report() -> String:
	var monsters := _monster_bodies.size()
	var npcs := get_tree().get_nodes_in_group("name_plates").size()
	var players := _other_bodies.size()
	var ground := _ground_items.count() if _ground_items != null else 0
	return "monsters %d, npcs (name plates) %d, other players %d, ground items %d" % [monsters, npcs, players, ground]

## /log on desktop: open the folder holding the log file. Returns whether it
## did (headless/servers cannot, and say so).
func _open_log_dir() -> bool:
	if OS.has_feature("web") or DisplayServer.get_name() == "headless":
		return false
	var dir := ProjectSettings.globalize_path("user://logs")
	OS.shell_open(dir)
	return true

## /errors: the last `count` script-error lines from this session's log file.
func _recent_script_errors(count: int) -> PackedStringArray:
	var out: PackedStringArray = []
	for line in _tail_log_lines(400):
		if line.contains("SCRIPT ERROR") or line.begins_with("ERROR") or line.contains("Parse Error"):
			out.append(line)
	if out.size() > count:
		out = out.slice(out.size() - count)
	return out

## The last `n` lines of the log file (user://logs/opensro.log), or empty if
## it cannot be read.
func _tail_log_lines(n: int) -> PackedStringArray:
	var path := "user://logs/opensro.log"
	if not FileAccess.file_exists(path):
		return PackedStringArray()
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		return PackedStringArray()
	var all := f.get_as_text().split("\n")
	if all.size() > n:
		return all.slice(all.size() - n)
	return all

func _set_wire_logging(on: bool) -> void:
	_wire_logging = on
	NetClient.wire_logging = on

## /cam free|orbit: map the two console words onto the client's own views
## (set_camera_view). "orbit" is the fixed-pitch, yaw-free Quarter Angle
## view -- the one that reads as orbiting.
func _console_set_camera(mode: String) -> bool:
	match mode:
		"free":
			set_camera_view(CAMERA_VIEW_FREE)
			return true
		"orbit":
			set_camera_view(CAMERA_VIEW_QUARTER)
			return true
	return false

## The chat-line tooltip: the client commands, plus (for a GM) the GM line.
## OURS (the original's chat input has no help); shown in the original's
## bubble by HelpTips (round 848).
func _command_tooltip() -> String:
	var base := "Slash commands: type /help for the list.\n%s" % (_console.help_line() if _console != null else "/help /where /copy /fps /entities")
	return base

## Round 848: on the input line only. The whole chat window carried it too,
## which under the original's at-once bubble would cover the screen beside
## the chat whenever the cursor crossed its log.
func _refresh_command_tooltip() -> void:
	if _hud_chat != null:
		var input := _hud_chat.find_child("*Input*", true, false)
		if input is Control:
			(input as Control).tooltip_text = _command_tooltip()

## Feeds OPENSRO_QA_COMMANDS through the console -- the same parser the chat
## uses -- printing a "QA COMMAND:" marker per line so the log pairs each with
## its reply. Called from the QA tick block once the world has settled.
## Raises a centre-screen banner for a line of `kind` on the instance the
## original uses for it (HudNotice.style_for_kind: GDR_NOTICE for the GM
## notice, GDR_WARNING_WND for the rest; round 703).
func _show_banner(kind: String, text: String) -> void:
	var style_name := String(HudNotice.style_for_kind(kind)["name"])
	var on := _hud_notice if style_name == "GDR_NOTICE" else _hud_warning
	if style_name == "GDR_UPDATE_QUEST_INFO":
		on = _hud_quest_notice
	if on != null:
		on.show_notice(text)

## OPENSRO_QA_NOTICES="<tick>:<what>;..." (round 703) raises the banners at
## those QA ticks through the handlers the network drives:
##   notice:<text>                 GDR_NOTICE, as a chat notice does
##   warning:<text>                GDR_WARNING_WND
##   level:<n>                     _on_level_up(n) -- the level-up line
##   unique:spawn|kill:<ref>[:<killer>]  _on_unique_notice, as 0x300C's
##   region:<x>:<y>                the area banner's test for that region
##   bands                         only print the `QA BANDS` line
##   goto:<x>:<y>:<lx>:<lz>        stand at a spot in a loaded region (the
##                                 region change then runs the real path)
## Each prints `QA NOTICE <tick> <what>` and, a frame later, the banners'
## bands on screen (`QA BANDS ...`).
func _qa_notices_step(plan: String) -> void:
	for raw in plan.split(";", false):
		var spec := String(raw).strip_edges()
		var colon := spec.find(":")
		if colon < 0 or not spec.substr(0, colon).is_valid_int():
			continue
		var tick := int(spec.substr(0, colon))
		var what := spec.substr(colon + 1)
		if _qa_tick == tick + 2:
			_qa_bands_report(what)
		if _qa_tick != tick:
			continue
		print("QA NOTICE %d %s frame %d" % [tick, what, Engine.get_frames_drawn()])
		var parts := what.split(":")
		match parts[0]:
			"notice":
				_show_banner("gm_notice", what.substr(7))
			"warning":
				_show_banner("system", what.substr(8))
			"level":
				_on_level_up(int(parts[1]) if parts.size() > 1 else 2, 0)
			"unique":
				var n := UniqueNoticeNet.Notice.new()
				n.kind = UniqueNoticeNet.KIND_KILL if parts.size() > 1 and parts[1] == "kill" else UniqueNoticeNet.KIND_SPAWN
				n.ref_obj_id = int(parts[2]) if parts.size() > 2 else 1954
				n.killer = parts[3] if parts.size() > 3 else ""
				_on_unique_notice(n)
			"bands":
				_qa_bands_report("probe")
			"goto":
				# A placement in a loaded region, so the next stream check
				# runs the real region-change path.
				if parts.size() > 4:
					_place_at_region_local(int(parts[1]), int(parts[2]), float(parts[3]), float(parts[4]))
			"region":
				if _hud_region != null and parts.size() > 2:
					_hud_region.enter_region(TextZoneNameReader.region_id(int(parts[1]), int(parts[2])))

func _qa_bands_report(what: String) -> void:
	var out := PackedStringArray()
	for item in [_hud_notice, _hud_warning]:
		var b := item as HudNotice
		if b != null and b.visible:
			var r: Rect2 = b.band_screen_rect()
			out.append("%s band %d,%d %dx%d text '%s'" % [b.style_name(), int(r.position.x), int(r.position.y),
				int(r.size.x), int(r.size.y), b.text()])
	if _hud_region != null and _hud_region.visible:
		var xf := _hud_region.get_global_transform_with_canvas()
		var lay := _hud_region.layout()
		var w: Rect2 = lay["window"]
		var t: Rect2 = lay["title"]
		out.append("REGION %s window %d,%d %dx%d title %d,%d %dx%d scale %.2f" % [_hud_region.current_code,
			int(w.position.x), int(w.position.y), int(w.size.x), int(w.size.y),
			int(t.position.x), int(t.position.y), int(t.size.x), int(t.size.y), xf.get_scale().x])
	print("QA BANDS after %s frame %d: %s" % [what, Engine.get_frames_drawn(),
		" | ".join(out) if not out.is_empty() else "none"])

func _run_qa_commands(list: String) -> void:
	for raw in list.split(";", false):
		var line := String(raw).strip_edges()
		if line == "":
			continue
		# "wait <seconds>" (round 642): pause the list, so a /tp can follow a
		# /goto's zone load instead of racing it.
		if line.begins_with("wait "):
			print("QA COMMAND: %s" % line)
			await get_tree().create_timer(maxf(float(line.substr(5)), 0.0)).timeout
			continue
		print("QA COMMAND: %s" % line)
		# Round 814 (QA only): "guild create <name>" founds a guild the way the
		# guild NPC's create prompt does (NetClient.create_guild), so a QA run
		# can stand in a guild without walking to the NPC.
		if line.begins_with("guild create "):
			NetClient.create_guild(NetClient.current_character_name, line.substr(13).strip_edges())
			continue
		# Round 821 (QA only): "guild join <id>" joins a guild by id (the
		# placeholder join, until the invite is built).
		if line.begins_with("guild join "):
			NetClient.join_guild(NetClient.current_character_name, int(line.substr(11).strip_edges()))
			continue
		if line.begins_with("/") and _console != null:
			_console.submit(line)
		else:
			NetClient.say(line)

var _help_hinted := false

## Prints the one-line "type /help" hint once on entering the world. The
## original raised a login notice through its web panel; this is the native,
## non-intrusive equivalent (a chat line, our own wording).
func _hint_help_once() -> void:
	if _help_hinted:
		return
	_help_hinted = true
	_log_system("Type /help for controls and commands, or open Help from the Escape menu.")

## Fires the GM probe: an empty command line the server answers with whether
## this account is a GM. Guarded so it is sent once per world entry.
func _fire_gm_probe() -> void:
	if not NetClient.is_connected_to_server():
		print("Console: GM probe skipped -- not connected")
		return
	if NetClient.current_character_name == "":
		print("Console: GM probe skipped -- no character name yet")
		return
	print("Console: GM probe sent for %s" % NetClient.current_character_name)
	NetClient.gm_command(NetClient.current_character_name, "", 0)

## The server's GM reply: sets GM state, prints the text, applies any move,
## refreshes the views a command changed, and announces a level-up.
func _on_gm_command_result(result: GmNet.Result) -> void:
	if result == null:
		return
	if result.is_gm != _is_gm:
		_is_gm = result.is_gm
		if _console != null:
			_console.is_gm = _is_gm
		if _help_window != null:
			_help_window.set_is_gm(_is_gm)
		_refresh_command_tooltip()
	# On enter-world a GM's client fires an empty probe; greet once.
	if _is_gm and not _gm_greeted:
		_gm_greeted = true
		if _console != null:
			_log_system(_console.gm_help_line())
	if result.text != "":
		_log_system(result.text)
		print("GM REPLY: %s" % result.text)
	if result.new_level > 0:
		_on_level_up(result.new_level, result.stat_points)
	if result.has_pos or result.zone != "":
		_apply_gm_move(result)
	if result.refresh & GmNet.REFRESH_STATS:
		_request_world_stats()
	if result.refresh & GmNet.REFRESH_MONSTERS:
		NetClient.list_monsters()
	if result.refresh & GmNet.REFRESH_INVENTORY:
		if NetClient.current_character_name != "":
			NetClient.list_inventory(NetClient.current_character_name)
	if result.refresh & GmNet.REFRESH_EQUIPMENT:
		if NetClient.current_character_name != "":
			NetClient.list_equipment(NetClient.current_character_name)

## Applies a /tp or /goto move: a zone change first if the reply names a
## different zone (the position is applied when that zone loads), else the
## position now. Movement is client-authoritative, so placing the player and
## letting the move sync inform the server is the same path /unstuck uses.
func _apply_gm_move(result: GmNet.Result) -> void:
	# The zone the player is in NOW (round 629's review): comparing with the
	# enter-world zone took a /goto back to the starting town, after a zone
	# change, for "already there" and never moved the player.
	var here := NetClient.current_zone
	if here == "" and NetClient.last_enter_world_result != null:
		here = NetClient.last_enter_world_result.zone
	if result.zone != "" and result.zone != here:
		if result.has_pos:
			_pending_gm_pos = Vector2(result.x, result.z)
		_request_zone_change(result.zone)
		return
	if result.has_pos:
		_place_player_at_world(result.x, result.z)
		_qa_arm_arrival_probe("gm move to %.0f, %.0f" % [result.x, result.z])

## Stands the player at a world X/Z, resolving the height off the terrain --
## the same safety net _unstuck uses. Clears velocity and lets the move sync
## tell the server.
func _place_player_at_world(x: float, z: float) -> void:
	var spot := Vector3(x, player.global_position.y, z)
	# On the walkable graph's landing height where a graph is loaded, as an
	# arrival is (round 749's verification, c), else the terrain ray.
	var landing := _navmesh_height_at(spot)
	spot.y = _terrain_height_at(spot) if is_nan(landing) else landing
	player.global_position = spot
	player.velocity = Vector3.ZERO
	# Round 749: the GM's point is one the server named (destmove.go
	# noteGMLanding); any walk in effect ends here.
	_has_move_target = false
	_move_heading_run = false
	_send_placement()

## The Shift+F3 panel (dev-only, DevTools.enabled; null otherwise): build,
## server, position, entities, loading failures, frame times, zone travel and
## the sliders for UI scale and name range.
var _debug_panel: DebugPanel = null

func _qa_mall(what: String) -> String:
	if _hud_panels == null:
		return "no hud"
	var parts := what.split(":")
	var m: ItemMallController = _hud_panels._mall()
	match parts[0]:
		"mall_open":
			return "opened" if _hud_panels.open_item_mall() != null else "failed"
		"mall_entry":
			_hud_panels.open_item_mall_entry()
			return "entry box"
		"mall_close":
			return str(m.close())
		"mall_main":
			m.show_main_page()
			return "main page"
		"mall_row":
			var i := int(parts[1])
			if i >= m._rows.size():
				return "no row %d" % i
			m.click_row(m._rows[i])
			return "row %s" % (m._rows[i]["row"] as MallData.MenuRow).text_key
		"mall_sub":
			for r in m._rows:
				if r["open"] and int(parts[1]) < (r["subs"] as Array).size():
					m.click_sub(r["subs"][int(parts[1])], r)
					return "sub %s" % r["subs"][int(parts[1])]["title"]
			return "no open row"
		"mall_hover":
			if int(parts[1]) < m._cells.size():
				m._hover_cell(m._cells[int(parts[1])])
				return "hover"
			return "no cell"
		"mall_wear":
			if int(parts[1]) < m._cells.size():
				var g: MallData.Good = (m._cells[int(parts[1])] as Control).get_meta("good")
				return "wear %s -> %s" % [g.package.code, str(m.wear(g))]
			return "no cell"
		"mall_buy":
			if int(parts[1]) < m._cells.size():
				var g: MallData.Good = (m._cells[int(parts[1])] as Control).get_meta("good")
				m.send_buy(g, int(parts[2]) if parts.size() > 2 else 1, 0)
				return "buy %s" % g.package.code
			return "no cell"
		"mall_search":
			m.search(what.substr(12))
			return "search"
		"mall_type":
			# mall_type:<text>: a real click on the search edit, the text as
			# key presses, then Enter (round 838: what the player does).
			var edit := m.node("GDR_RENEWAL_ITEM_MALL_SEARCH")
			if edit == null:
				return "no edit"
			_qa_push_click(edit.get_global_rect().get_center(), MOUSE_BUTTON_LEFT, true)
			for ch in what.substr(10):
				_qa_push_key(ch)
			var typed := "focus %s text '%s'" % [_qa_focus_name(), (edit as LineEdit).text if edit is LineEdit else "?"]
			_qa_push_key("Enter")
			return "%s -> view %s cells %d" % [typed, String(m._view.get("kind", "")), m._cells.size()]
		"mall_rows":
			# Every menu row with its sub-tabs and their goods counts.
			var rows := []
			for r in m._rows:
				var subs := []
				for s in r["subs"]:
					subs.append("%s(%d)" % [s["title"], (s.get("goods", []) as Array).size()])
				rows.append("%s[%s]" % [(r["row"] as MallData.MenuRow).text_key, ", ".join(subs)])
			return " ".join(rows)
		"mall_pick":
			# mall_pick:<row text key>:<sub title>: real clicks on that row,
			# then on that sub-tab.
			for r in m._rows:
				if (r["row"] as MallData.MenuRow).text_key != parts[1]:
					continue
				if not bool(r["open"]):
					_qa_push_click((r["node"] as Control).get_global_rect().get_center(), MOUSE_BUTTON_LEFT, true)
				for s in r["subs"]:
					if String(s["title"]) == parts[2]:
						_qa_push_click((s["node"] as Control).get_global_rect().get_center(), MOUSE_BUTTON_LEFT, true)
						return "picked -> view %s cells %d" % [String(m._view.get("kind", "")), m._cells.size()]
				return "row open, no sub %s" % parts[2]
			return "no row %s" % parts[1]
		"mall_tip":
			# mall_tip:<i>: the pointer onto cell i's icon (real motion);
			# the tooltip it shows.
			if int(parts[1]) >= m._cells.size():
				return "no cell"
			var slot := (m._cells[int(parts[1])] as Control).find_child("GDR_RENEWAL_SHOP_SLOT_ICON", true, false) as Control
			if slot == null:
				return "no icon"
			var mm := InputEventMouseMotion.new()
			mm.position = slot.get_global_rect().get_center()
			mm.global_position = mm.position
			get_viewport().push_input(mm, true)
			var g: MallData.Good = (m._cells[int(parts[1])] as Control).get_meta("good")
			return "%s: %s" % [g.package.code, ItemTooltipLines.as_text(_hud_panels.item_tip_shown()).replace("\n", " | ")]
		"mall_findbtn":
			# A real click on the Search button.
			var fb := m.node("GDR_RENEWAL_ITEM_MALL_SEARCH_BTN")
			if fb == null:
				return "no button"
			_qa_push_click(fb.get_global_rect().get_center(), MOUSE_BUTTON_LEFT, true)
			return "clicked -> view %s cells %d" % [String(m._view.get("kind", "")), m._cells.size()]
		"mall_original":
			m.press_original()
			return "original"
		"mall_drag":
			# mall_drag:<dx>:<dy>:<left|right>: a press, a move and a release
			# through the preview's own input handler.
			var view := m._preview_view
			if view == null or m.preview == null:
				return "no preview"
			var right := parts.size() > 3 and parts[3] == "right"
			var btn := MOUSE_BUTTON_RIGHT if right else MOUSE_BUTTON_LEFT
			var c := view.size * 0.5
			var d := Vector2(float(parts[1]), float(parts[2]) if parts.size() > 2 else 0.0)
			for step in [[true, c], [null, c + d], [false, c + d]]:
				var ev: InputEvent
				if step[0] == null:
					var mm := InputEventMouseMotion.new()
					mm.position = step[1]
					mm.button_mask = MOUSE_BUTTON_MASK_RIGHT if right else MOUSE_BUTTON_MASK_LEFT
					ev = mm
				else:
					var mb := InputEventMouseButton.new()
					mb.button_index = btn
					mb.pressed = step[0]
					mb.position = step[1]
					ev = mb
				m.preview.handle_input(ev, view.size)
			return "dragged %s %s" % [str(d), "right" if right else "left"]
		"mall_wearitem":
			# mall_wearitem:<item id>: the preview's own wear, for an avatar
			# the archive sells outside the mall.
			if m.preview == null:
				return "no preview"
			return str(m.preview.wear(int(parts[1])))
		"mall_chest":
			# The item chest (OURS), as its icon under the minimap opens it.
			if _hud_panels.item_chest == null:
				return "no chest"
			_hud_panels.item_chest.toggle(_hud_panels)
			return "chest %s" % ("open" if _hud_panels.item_chest.is_open() else "closed")
		"mall_icon":
			var ic: Control = _hud_panels.item_chest_icon
			if ic == null:
				return "no icon"
			return "icon visible %s in tree %s rect %s texture %s parent %s" % [str(ic.visible), str(ic.is_visible_in_tree()),
				str(ic.get_global_rect()), str((ic as TextureButton).texture_normal), str(ic.get_parent().name)]
		"mall_barclick":
			# A real click on the bottom bar's item mall button (control 9).
			var b := _hud_underbar.control([9]) if _hud_underbar != null else null
			if b == null:
				return "no button"
			_qa_push_click(b.get_global_rect().get_center(), MOUSE_BUTTON_LEFT, true)
			return "clicked at %s" % str(b.get_global_rect().get_center())
		"mall_enterok":
			# A real click on the entry box's OK.
			var box := get_tree().root.find_child("MallEnterBox", true, false) as Control
			var ok := box.find_child("GDR_MBIN_BTN_OK", true, false) as Control if box != null else null
			if ok == null:
				return "no entry box"
			_qa_push_click(ok.get_global_rect().get_center(), MOUSE_BUTTON_LEFT, true)
			return "OK clicked"
		"mall_buyworn":
			m.press_buy_worn()
			return "buy worn box"
		"mall_state":
			return "active %s busy %s dealing %d view %s cells %d buy list %d silk %s" % [str(m.active), str(m.busy), m.dealing,
				String(m._view.get("kind", "")), m._cells.size(), m.buy_list.size(), str(NetClient.silk_balances)]
	return "unknown"

## Hides or shows the whole HUD (UI/Control and every window under it) --
## Shift+F10 (KeyMap's "hide_ui", ours; F10 until round 837, now retail's
## item mall). The key brings it back: round 848 retired the native Hide UI
## button that sat beside the minimap.
func _toggle_ui_visibility() -> void:
	ui_control.visible = not ui_control.visible

## Releases the viewport's focus owner for a LEFT button press, and says
## whether it did. Only the left button: a right drag orbits the camera and the
## wheel zooms it, and neither should end a message being typed; the middle
## button fires a quickslot. Static so the suite can drive it without a
## running world (npc_service_reader_test.gd, check (n)).
static func take_focus_back(viewport: Viewport, event: InputEvent) -> bool:
	if viewport == null or not (event is InputEventMouseButton and (event as InputEventMouseButton).pressed):
		return false
	if (event as InputEventMouseButton).button_index != MOUSE_BUTTON_LEFT:
		return false
	var focus_owner := viewport.gui_get_focus_owner()
	if focus_owner == null:
		return false
	focus_owner.release_focus()
	return true

func _unhandled_input(event: InputEvent) -> void:
	if title_mode:
		return
	# A left click that reaches here was consumed by no control -- no STOP
	# control on its chain (Godot 4.2 viewport.cpp) -- so it is treated as a
	# click on the world and takes the keyboard back from whatever text line
	# still holds it. Godot does not release focus on a click on empty space,
	# and since round 521 any focused line counts as typing (_is_typing), which
	# stops movement; without this, a line left focused -- the chat's line,
	# the debug panel's teleport field after Enter -- kept click-to-move (and,
	# before round 608, the WASD keys) dead until the line lost focus some
	# other way.
	# The windows, the chat, the hotbar slots and (round 529) the player-info
	# block, the minimap, the target window and the hotbar's body are STOP, so
	# their clicks do not get here.
	# The click itself carries on to the handlers below.
	if _qa_input_armed and event is InputEventKey and (event as InputEventKey).pressed:
		_qa_input_seen.append(OS.get_keycode_string((event as InputEventKey).keycode))
	take_focus_back(get_viewport(), event)
	# Keys are not read here: every key the game answers is in the key
	# table (KeyMap, round 608) and is run by KeyInput, or by HudPanels for
	# the windows' keys -- F1..F4, the number keys, Tab, N, F10 and the
	# developer toggles all moved there.
	# The middle mouse button fires the bar's "m" slot, the first slot on the
	# hotbar: "the first slot thats on the hotbar you press it with 1, thats
	# not right it should be middle mouse button" (playtest 2026-09-20). The
	# client's own bar has that slot (quick slot 0, labelled ub_number_m), and
	# its mouse handler fires it on WM_MBUTTONDOWN (0x77c4cc -> 0x60bb80(0);
	# HudUnderbar.MOUSE_SLOT has the reading). Until the real bar was built it
	# fired page slot 1, the one the 1 key fires. This is the press over the
	# world; a press over a STOP HUD surface never gets here, and the hotbar
	# fires it for them (_relay_middle_button_to_hotbar).
	#
	# Round 833: the Key Map tab's mouse mode (GI+0x4f9, OptionKeyPage) moves
	# it to the right button and the camera to the middle one (READ,
	# CGInterface::vslot_017 0x77c260: WM_MBUTTONDOWN 0x77c4cc fires the slot
	# in mode 0, WM_RBUTTONDOWN 0x77c67f in mode 1; WM_MOUSEMOVE 0x77c2d5
	# turns the camera on the right button in mode 0, the middle in mode 1).
	if event is InputEventMouseButton and (event as InputEventMouseButton).pressed \
			and (event as InputEventMouseButton).button_index == _mouse_slot_button() \
			and _hud_underbar != null:
		_hud_underbar.activate_mouse_slot()
		get_viewport().set_input_as_handled()
		return
	# Motion that gets this far was not consumed by a window -- see _input.
	if event is InputEventMouseMotion:
		_hover_reached_world = true

	if event is InputEventMouseButton:
		if event.button_index == _orbit_button():
			# The camera's button (the right one, or the middle in mouse mode
			# 1; the target menu follows it, WM_MBUTTONUP in mode 1, READ).
			_right_button_held = event.pressed
			_target_menu_right_button(event.pressed, event.position)
		elif event.button_index == MOUSE_BUTTON_LEFT:
			# Round 832: a left press on the world closes the target menu
			# (FUN_00468c50(0xAE), READ 0x77c486).
			if event.pressed:
				_close_target_menu()
			# The press is the click (round 701; READ): retail's WM_LBUTTONDOWN
			# runs the whole pick -- CGInterface::vslot_017 case 0x201
			# (0x77c4a7) -> 0x793570 -> the object click 0x792f00 or the ground
			# click 0x78f8d0 -> 0x9ec570 (destination, filter, ring) -- and
			# nothing after it repeats it: WM_LBUTTONUP (case 0x202 ->
			# 0x78e5d0) only ends process modes 0xae/0xaf, WM_MOUSEMOVE (case
			# 0x200) turns the camera on the right button (the middle with the
			# swap flag +0x4f9) and never on the left, and the 500 ms timer 7
			# (0x777b90) re-plots a sky click's heading run (0x9eb8e0, which
			# reads no mouse). So a held left button neither moves the ring
			# nor re-aims the walk: a new press does. Until round 701 the
			# click went on the release and a drag past 6 pixels re-picked the
			# destination under the cursor every frame ("the circle will
			# fluidly move around with your cursor", playtest 2026-10-03).
			if event.pressed:
				var took := _dispatch_double_click(event.position) if event.double_click else _dispatch_left_click(event.position)
				# One line a press (round 701): what a tester's log needs to
				# tell "it walked where I first clicked" from "it followed the
				# cursor".
				print("CLICK: left press at %s -> %s%s" % [str(event.position.round()), took,
					(" to (%.1f, %.1f, %.1f)" % [_move_target.x, _move_target.y, _move_target.z]) if took == "walk" and _has_move_target and not _move_heading_run else ""])
			_left_button_held = event.pressed
		elif event.button_index == MOUSE_BUTTON_WHEEL_UP and event.pressed:
			if not _wheel_on_window:
				_camera_wheel(event.factor if event.factor > 0.0 else 1.0)
		elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN and event.pressed:
			if not _wheel_on_window:
				_camera_wheel(-(event.factor if event.factor > 0.0 else 1.0))
		# Only the right button orbits the camera (READ: vslot_017 case 0x200
		# tests the right byte +0x25a, or the middle +0x259 with the swap
		# flag; never the left +0x258). A held left button does nothing.
		_camera_orbiting = _right_button_held
	# The orbit's motion is not read here: _input turns the camera, so a drag
	# keeps orbiting over a STOP control (see orbit_motion_applies).

## Round 818: whether a wheel step at the mouse is over a window, so the
## camera does not zoom. Godot (4.3 on) passes a wheel event up through a
## STOP control while its mouse_force_pass_scroll_events is set -- the
## default -- so every wheel step over a window reached _unhandled_input and
## zoomed the camera while a list scrolled (MEASURED, round 818: a STOP
## square takes the motion and still lets the wheel through). Retail sends
## the world nothing under a window (FUN_00b9dc00 != CGInterface, READ, round
## 697). `hovered` is the viewport's control under the mouse; a STOP control
## on its chain is a window (HudWindow and every HUD surface are STOP).
var _wheel_on_window := false

static func wheel_over_window(hovered: Control) -> bool:
	var c: Node = hovered
	while c is Control:
		if (c as Control).mouse_filter == Control.MOUSE_FILTER_STOP:
			return true
		c = c.get_parent()
	return false

## Whether a mouse motion turns the camera. Asked in _input, not in
## _unhandled_input, because a right drag that began on the world loses its
## motion to any STOP control the cursor crosses. Godot 4.2.2's
## Viewport::_gui_input_event sends motion to gui.mouse_focus, which a press on
## no control leaves empty, or else to the control under the cursor; a STOP
## control there consumes it, so it never reaches _unhandled_input (measured
## by round 522's re-review over the chat, and by npc_service_reader_test's
## check (o)). Viewport::push_input runs _input before the GUI for every
## event, so the orbit reads its motion there wherever the cursor is, and
## _unhandled_input no longer reads it (once, never twice).
##
## The right button must be in the motion's own button mask. _camera_orbiting
## follows the right button's press and release as _unhandled_input sees
## them, and a release can miss it: Godot sends a release to the control that
## holds the mouse focus (a left press on a window made while the right button
## was held), not to _unhandled_input. The flag then stays set with no button
## down, and without this check plain motion would turn the camera everywhere.
## Static so the suite can drive it without a running world. Every view takes
## the drag since round 778 (the third-person view turns its pitch; READ,
## RetailCamera's view note); _input decides which angle each view turns.
static func orbit_motion_applies(event: InputEvent, orbiting: bool, _view: String,
		mask: int = MOUSE_BUTTON_MASK_RIGHT) -> bool:
	if not orbiting or not (event is InputEventMouseMotion):
		return false
	return ((event as InputEventMouseMotion).button_mask & mask) != 0

## Real Silkroad-style click-to-move: raycasts from the camera through the
## real clicked screen position into the 3D world (real terrain/object
## collision -- both now real, solid bodies, see ObjectLoader's own real
## collision fix) and, on a hit, sets that as the player's real destination
## for _physics_process to walk toward every subsequent frame until reached
## or cancelled by another click, typing or death.
## A click on an NPC opens the authored talk window titled with its name,
## the way the original does. Ray-tests the NPC layer only (the colliders
## _npc_collider puts on NAVMESH_WALL_COLLISION_LAYER); returns true when it
## opened a dialogue, so the caller does not also walk there. The holder the
## collider hangs under carries the NPC's name (set where it is placed).
## The game's own cursors (round 697: GameCursor holds the set, read once
## at boot from the player's sro_client.exe, and shows it on every screen at
## the UI scale). The world only chooses which: the hover kind under the
## mouse, re-chosen on retail's timer -- CGInterface's timer 1 fires every
## 250 ms (`push 0xfa; push 1; call 0xb93320`, 0x787294, READ) and its
## handler (vslot_005 case 1, 0x789820) picks the object and its cursor. It
## was a 50 ms throttle on mouse motion until round 697 (ours); the timer
## also turns the cursor when a monster walks under a still mouse.
var _cursor_kind := ""
var _cursor_last_check_ms := 0
const CURSOR_HOVER_INTERVAL_MS := 250
## Classification cost, for the perf note: microseconds summed and counted.
var _cursor_classify_usec := 0
var _cursor_classify_count := 0

func _try_load_cursors() -> void:
	GameCursor.load_once()
	_cursor_kind = ""
	_apply_cursor("normal")

## Every mouse motion is seen here first; whether it then reaches
## _unhandled_input says if a window consumed it. The hover tick
## (_hover_tick, from _physics_process) reads both after the frame's input
## has been routed -- so the cursor is the arrow over a window and the
## world's kind over the world, using the engine's own GUI routing rather
## than a hit-test of our own (4.2 has no gui_get_hovered_control; that
## arrived in 4.3). Retail's tick asks the same question: a window under the
## mouse that is not the interface itself gives 0x95 (FUN_00b9dc00 !=
## CGInterface, READ).
var _hover_pos := Vector2.ZERO
var _hover_reached_world := false

func _input(event: InputEvent) -> void:
	if title_mode:
		return
	# Round 818: whether this wheel step is a window's, asked before the GUI
	# has it -- a list it scrolls can move the row out from under the mouse,
	# and the control under it then is no window's (wheel_over_window).
	if event is InputEventMouseButton and (event as InputEventMouseButton).pressed \
			and (event as InputEventMouseButton).button_index in [MOUSE_BUTTON_WHEEL_UP, MOUSE_BUTTON_WHEEL_DOWN]:
		_wheel_on_window = wheel_over_window(get_viewport().gui_get_hovered_control())
	# The orbit turns the camera here, before the GUI can consume the motion
	# (orbit_motion_applies has why). The event is not marked handled: the
	# control under the cursor still sees it, as before.
	if orbit_motion_applies(event, _camera_orbiting, _camera_view,
			MOUSE_BUTTON_MASK_MIDDLE if _mouse_mode == 1 else MOUSE_BUTTON_MASK_RIGHT):
		# READ (round 778, RetailCamera): the pitch turns unless the view is
		# the quarter view, the yaw unless it is the third-person one (whose
		# yaw the heading sets every frame).
		var motion := event as InputEventMouseMotion
		if _camera_view != CAMERA_VIEW_THIRD_PERSON:
			camera_arm.rotation_degrees.y -= motion.relative.x * CAMERA_ORBIT_SENSITIVITY
		if _camera_view != CAMERA_VIEW_QUARTER:
			camera_arm.rotation_degrees.x = clampf(
				camera_arm.rotation_degrees.x - motion.relative.y * CAMERA_ORBIT_SENSITIVITY,
				CAMERA_PITCH_MIN_DEGREES, CAMERA_PITCH_MAX_DEGREES)
	# The hover follows the mouse with the left button held too (retail's
	# tick runs then, and a held button over an item is the closed glove),
	# and while the camera turns: retail's default rotate method leaves the
	# cursor free and its tick reads where it is (round 697 review, L3). The
	# orbit above is untouched.
	# Round 832: a right drag of more than 5 pixels opens no target menu
	# (GI+0x82c cleared, READ 0x77c260).
	if _target_menu_armed and event is InputEventMouseMotion \
			and (event as InputEventMouseMotion).position.distance_to(_target_menu_press) > TargetMenu.DRAG_PX:
		_target_menu_armed = false
	if event is InputEventMouseMotion:
		_hover_pos = (event as InputEventMouseMotion).position
		_hover_reached_world = false

## The hover tick (_physics_process): retail's 250 ms timer.
func _hover_tick() -> void:
	if Time.get_ticks_msec() - _cursor_last_check_ms >= CURSOR_HOVER_INTERVAL_MS:
		_settle_hover_cursor()

func _settle_hover_cursor() -> void:
	_cursor_last_check_ms = Time.get_ticks_msec()
	GameCursor.refresh(get_window())
	# Also when the game's cursors are not there: the item under the mouse
	# shows its name (_hovered_ground_item).
	var t0 := Time.get_ticks_usec()
	# Over a window no world target is under the mouse: the log line must not
	# name the last one (round 700 review, L1).
	if not _hover_reached_world:
		_hover_target = ""
	var kind := _hover_kind_at(_hover_pos) if _hover_reached_world else "normal"
	_cursor_classify_usec += Time.get_ticks_usec() - t0
	_cursor_classify_count += 1
	if kind != "pickup" and kind != "pickup_held":
		_hovered_ground_item = -1
	_apply_cursor(kind)

## What the cursor should be over this screen point in the world, in the
## order the click dispatch tests the same rays (_dispatch_left_click), so
## the cursor says what a click there would do:
##   a dropped item       -> pickup (0x99), pickup_held (0x9a) with the left
##                           button down; notes the item, whose name shows
##   the nearest character -> a monster (a dying one passed over):
##                           GameCursor.monster_kind (0x97, or 0x95 for a
##                           job monster to a jobless player);
##                           another player: GameCursor.player_kind (0xa0
##                           outside the party with Alt held, else 0x95)
##   the talk ray          -> a gate's pick node (gate_point_id): gate (0xa1),
##                           an NPC: talk (0x98)
##   anything else         -> normal (0x95)
## Retail picks the one nearest object of any class (FUN_0078ee20) and
## switches on its class (vslot_005); this client's click tests the item
## first on purpose (round 207: an item at a monster's feet sits inside the
## monster's tall capsule), and the cursor follows the click. A monster or
## player hidden by held V is passed over, as its click is.
func _hover_kind_at(screen_pos: Vector2) -> String:
	_hover_target = ""
	var item := _ray_hit_tagged(screen_pos, GroundItems.GROUND_ITEM_COLLISION_LAYER, "ground_item_id")
	if item != null and _hover_held(item, "item"):
		_hovered_ground_item = int(item.get_meta("ground_item_id"))
		return GameCursor.item_kind(Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT))
	if not _objects_hidden:
		var who := _ray_hit_character(screen_pos)
		if who != null and _hover_held(who, "monster" if who.has_meta("monster_id") else "player"):
			if who.has_meta("monster_id"):
				return GameCursor.monster_kind(_monster_code_of(int(who.get_meta("monster_id"))))
			# Another player: no party, stall or team state reaches this
			# client yet (GameCursor.player_kind).
			# Round 802: IsHostile(Alt) with the job rules (_player_is_enemy).
			var hid := int(who.get_meta("character_id", -1))
			# Round 839: a stalling player's pouch (0xa3).
			return GameCursor.player_kind(_player_is_enemy(hid, Input.is_key_pressed(KEY_ALT)), _in_own_party(hid),
				_stall_world != null and _stall_world.stalling(hid))
	var talk_node := _talk_ray_at(screen_pos)["node"] as Node
	if talk_node != null and _hover_held(talk_node, "gate" if talk_node.has_meta("gate_point_id") else "npc"):
		return "gate" if talk_node.has_meta("gate_point_id") else "talk"
	return "normal"

## What the hover last found, for its log line: "<what> <name> at <d> units
## (blocks dx, dz)", "" for nothing (round 700).
var _hover_target := ""
var _cursor_target := ""

## Round 700: whether the original client would hold `node` -- the 3 x 3
## message blocks around the player's (GameCursor.in_view_window, READ; see
## there). Notes the target and its distance from the player for the log.
func _hover_held(node: Node, what: String) -> bool:
	var n3 := node as Node3D
	if n3 == null or player == null:
		return true
	var at := n3.global_position
	var me := player.global_position
	var held := GameCursor.in_view_window(me, at)
	_hover_target = "%s %s at %.0f units (blocks %d, %d)%s" % [what, String(node.get_meta("npc_code", node.name)),
		Vector2(at.x - me.x, at.z - me.z).length(),
		GameCursor.view_block(at.x) - GameCursor.view_block(me.x), GameCursor.view_block(at.z) - GameCursor.view_block(me.z),
		"" if held else " -- outside the view window, not held"]
	return held

## The character under a screen point, as the click's pick finds it
## (_pick_character's mask without the Shift self body: retail's hover pick
## passes 0 for include-self): the first ancestor of the nearest monster or
## player collider carrying monster_id or character_id, or null. A dying
## monster is passed over and the ray goes on to whatever is behind it, as
## retail's pick (FUN_0078ee20) skips a character whose +0x65c bit 0 (alive)
## is clear (round 697 review, L2) -- up to HOVER_RAY_PASSES bodies.
const HOVER_RAY_PASSES := 4

func _ray_hit_character(screen_pos: Vector2) -> Node:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
	var exclude: Array[RID] = [player.get_rid()]
	query.collision_mask = MONSTER_COLLISION_LAYER | OTHER_PLAYER_COLLISION_LAYER
	for _pass in HOVER_RAY_PASSES:
		query.exclude = exclude
		var hit := get_world_3d().direct_space_state.intersect_ray(query)
		if hit.is_empty():
			return null
		var node := hit["collider"] as Node
		while node != null and not (node.has_meta("monster_id") or node.has_meta("character_id")):
			node = node.get_parent()
		if node == null or not (node.has_meta("monster_id") and _dying_until.has(int(node.get_meta("monster_id")))):
			return node
		exclude.append(hit["rid"])
	return null

## A live monster's characterdata code (MonsterSnapshot.code_name), "" when
## unknown.
func _monster_code_of(monster_id: int) -> String:
	var snap = _monster_snapshots.get(monster_id)
	if snap != null and snap is CombatNet.MonsterSnapshot:
		return (snap as CombatNet.MonsterSnapshot).code_name
	return ""

## The tagged node under a screen point on a collision layer, or null: the
## ray from the camera through the point, then the first ancestor of the
## collider carrying the meta. The click pickers do the same walk.
func _ray_hit_tagged(screen_pos: Vector2, mask: int, meta: String) -> Node:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
	query.exclude = [player.get_rid()]
	query.collision_mask = mask
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	if hit.is_empty():
		return null
	var node := hit["collider"] as Node
	while node != null and not node.has_meta(meta):
		node = node.get_parent()
	return node

## Shows the cursor for a hover kind (GameCursor.KIND_IDS) when it changes,
## and says so in the log: one line per change, the evidence a tester's log
## carries for "which cursor did it pick there".
func _apply_cursor(kind: String) -> void:
	# The target (round 700) is part of the change, so a gate passing out of
	# the view window logs even while the cursor stays the arrow.
	var target := _hover_target.get_slice(" at ", 0)
	if kind == _cursor_kind and target == _cursor_target:
		return
	_cursor_target = target
	if kind == _cursor_kind:
		if GameCursor.has_cursors() and _hover_target != "":
			print("CURSOR: %s (0x%x) at %s -- %s" % [kind, GameCursor.id_for(kind), str(_hover_pos.round()), _hover_target])
		return
	_cursor_kind = kind
	GameCursor.show_kind(kind, get_window())
	if GameCursor.has_cursors():
		print("CURSOR: %s (0x%x) at %s%s" % [kind, GameCursor.id_for(kind), str(_hover_pos.round()),
			(" -- " + _hover_target) if _hover_target != "" else ""])

## A double click's second press (round 701's review; READ): retail sends it
## as WM_LBUTTONDBLCLK, not a second WM_LBUTTONDOWN, to FUN_00792190 (via
## vslot_017 case 0x203), which picks the object under the cursor and acts
## only on a character it can act on -- a monster is attacked outright; the
## ground, an NPC and a gate get nothing, so a far NPC's approach is not
## rolled again. Another player's case (0x7074 when vslot 0xa8 allows) is not
## built: nothing here (OURS).
func _dispatch_double_click(screen_pos: Vector2) -> String:
	if _player_dead:
		return "ignore"
	if not NetClient.is_connected_to_server() or _objects_hidden:
		return "ignore"
	var monster_id := _monster_at(screen_pos)
	if monster_id < 0:
		return "ignore"
	_cancel_talk_approach("a double click on a monster")
	_last_attack_target = monster_id
	_show_target(monster_id)
	_ring_on_monster(monster_id)
	_attack_monster(monster_id)
	return "attack"

## The original's left-click scheme, in the original's order: a click on a
## monster attacks it, on an NPC talks to it, and anywhere else walks there.
##
## Monster before NPC is deliberate. The NPC ray runs on the navmesh wall
## layer (NPC_COLLISION_LAYER is that layer), which is also what building
## walls sit on, so a monster standing in front of a wall used to lose the
## click to the wall test first -- and the real client's own hover code
## (CGInterface::vslot_005 in sro_client.exe, read for the cursors below)
## classifies the object under the mouse, monsters and NPCs alike, from what
## the pick returns, never wall-first. Returns which path took the click,
## for the QA hook's log.
func _dispatch_left_click(screen_pos: Vector2) -> String:
	if _player_dead:
		# Dead (round 548): a click on the world does nothing -- no pick-up,
		# attack, talk or walk; the Revive button is what there is to click.
		# Logged (round 675): a click lost to a dead state the player cannot
		# see must show in the tester's log.
		print("CLICK: at %s ignored -- the player is dead" % str(screen_pos))
		return "dead"
	# Any new click ends a talk approach still walking (round 701; OURS in
	# part: retail's ground click clears it, FUN_009ec570 writing +0x20 = 0,
	# and a new object click replaces it; a monster's select is not read to).
	_cancel_talk_approach("a new click")
	# An item lying on the ground first: it sits at a monster's feet inside
	# the monster's tall click capsule, so testing the monster first would
	# make a drop unpickable while its killer's next target stands over it.
	# The item ray runs on the ground-item layer alone (see GroundItems).
	if _try_pick_up_item(screen_pos):
		return "pickup"
	var picked := _pick_character(screen_pos)
	if picked != "":
		return picked
	if _try_talk_to_npc(screen_pos):
		return "approach" if not _talk_approach.is_empty() else "talk"
	_try_set_move_target(screen_pos)
	# Round 850 (READ, 0x793a84..0x793ad8): the ground click then turns the
	# world map's auto-move back on when a press on the map or a quest's map
	# button turned it off (HudWorldmap.ground_clicked).
	if _hud_worldmap != null:
		_hud_worldmap.ground_clicked()
	return "walk"

## One line saying what a click ray actually hit: the collider's path, the
## layer bits it is on, and which tag was found walking up from it. This is
## what settles "it opened the talk window" -- the node, not the impression.
func _describe_click_hit(hit: Dictionary, wanted_meta: String) -> String:
	if hit.is_empty():
		return "no hit"
	var collider := hit["collider"] as Node
	var layer := -1
	if collider is CollisionObject3D:
		layer = (collider as CollisionObject3D).collision_layer
	var node := collider
	while node != null and not node.has_meta(wanted_meta):
		node = node.get_parent()
	var tagged := ("%s=%s on %s" % [wanted_meta, str(node.get_meta(wanted_meta)), node.name]) if node != null else ("no %s up the chain" % wanted_meta)
	return "%s (layer 0b%s) -> %s" % [collider.get_path() if collider != null else "?", String.num_int64(layer, 2), tagged]

## The talk ray from `from` to `to` (round 690, split out of
## _try_talk_to_npc so the cursor and GatePickProbe fire the same one):
## {"node": the first ancestor of the nearest tagged collider carrying
## `npc_name`, or null; "collider": the first thing the ray hit, or null;
## "hit": the raw result for that first thing}.
##
## It masks the talk layer (NPC bodies) and the gates' pick boxes
## (GATE_PICK_COLLISION_LAYER), and goes on through what is on the talk layer
## without a tag -- the navmesh walls, which share its bit -- up to
## TALK_RAY_PASSES hits: retail's pick (FUN_0078ee20) tests objects only, and
## an invisible wall standing in front of an NPC or a gate's box is not one.
## Until round 690 the first wall ended the click.
func _talk_ray(from: Vector3, to: Vector3) -> Dictionary:
	var query := PhysicsRayQueryParameters3D.create(from, to)
	var exclude: Array[RID] = [player.get_rid()]
	query.collision_mask = NPC_COLLISION_LAYER | GATE_PICK_COLLISION_LAYER
	var first: Dictionary = {}
	for _pass in TALK_RAY_PASSES:
		query.exclude = exclude
		var hit := get_world_3d().direct_space_state.intersect_ray(query)
		if hit.is_empty():
			break
		if first.is_empty():
			first = hit
		var node := hit["collider"] as Node
		while node != null and not node.has_meta("npc_name"):
			node = node.get_parent()
		if node != null:
			return {"node": node, "collider": first["collider"], "hit": first}
		exclude.append(hit["rid"])
	return {"node": null, "collider": first.get("collider"), "hit": first}

## How many untagged talk-layer bodies the talk ray goes through (OURS): a
## bound, so a click across a walled town casts at most this many rays.
const TALK_RAY_PASSES := 8

## The talk ray through a screen point (_talk_ray).
func _talk_ray_at(screen_pos: Vector2) -> Dictionary:
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	return _talk_ray(from, from + dir * 2000.0)

func _try_talk_to_npc(screen_pos: Vector2) -> bool:
	if _hud_panels == null:
		return false
	var talk := _talk_ray_at(screen_pos)
	var hit: Dictionary = talk["hit"]
	if hit.is_empty():
		return false
	var node := talk["node"] as Node
	if node == null:
		# Round 675: what took a click that talked to nobody -- a gate whose
		# portal is not bound, or a wall on the talk layer in front of it --
		# goes to the tester's log, not only the QA hook's.
		print("%s npc ray: %s" % ["QA CLICK  " if _qa_click_logging else "CLICK:", _describe_click_hit(hit, "npc_name")])
		return false
	if _qa_click_logging:
		print("QA CLICK   npc ray: %s" % _describe_click_hit(hit, "npc_name"))
	# A CICharactor clicked is the selection (round 701's review; READ:
	# 0x793570 calls FUN_00778650 for it in reach and before an approach): a
	# selected monster stops being one, so a later single click on it selects
	# again rather than attacking. A gate (CITeleportGate) is not a
	# CICharactor and leaves the selection alone.
	_select_for_talk(node)
	# Out of reach the click walks there first (round 701; READ, 0x793570):
	# beyond 240 from an NPC or 800 from a gate, to a point on the line back
	# to the player, and the talk follows the arrival (_step_talk_approach).
	if node is Node3D and _start_talk_approach(node as Node3D):
		return true
	_open_talk(node)
	return true

## The selection a talk click makes (round 701's review): an NPC replaces a
## selected monster or player (FUN_00778650); a gate does not.
func _select_for_talk(node: Node) -> void:
	if node.has_meta("gate_point_id"):
		return
	_last_attack_target = -1
	_selected_character = -1
	_clear_target()

## The retail NPC interaction (round 727; NpcTalkNet has the bytes): the
## state, built on the first talk.
var _npc_talk: NpcTalkNet = null
## The holder a select is out for (a WeakRef), null when none.
var _talk_select_node: WeakRef = null
## The interaction-id set the open talk window was built from.
var _talk_ids := PackedByteArray()
## Whether the open talk is the server's (an 0xB045 reply), not a gate's.
var _talk_server := false
## The tab group of the store line whose 0x7046 is out ("" for all tabs).
var _talk_pending_tabgroup := ""
## OpNpcShopDef (round 783, OURS; NpcShopDefNet): the store lines, tabs and
## goods of the NPCs the archives do not describe (the Test Items NPC), by
## uid, as the server sent them before their select reply.
var _npc_shop_defs: Dictionary = {}
## The open talk's definition ({} for a retail NPC, whose lines and tabs are
## its archive's -- ShopReader).
var _talk_shop_def: Dictionary = {}

func _npc_talk_net() -> NpcTalkNet:
	if _npc_talk != null:
		return _npc_talk
	_npc_talk = NpcTalkNet.new()
	_npc_talk.send = func(op: int, payload: PackedByteArray) -> void:
		if NetClient.is_connected_to_server():
			NetClient._send(op, payload)
	_npc_talk.register_with(NetClient)
	# Round 783: an NPC of OpenSRO's own sends its lines and tabs first.
	NetClient.register_handler(NpcShopDefNet.OP_SHOP_DEF, _on_npc_shop_def)
	# Round 786: and then the instances its goods are listed as.
	NetClient.register_handler(NpcShopDefNet.OP_SHOP_GOODS, _on_npc_shop_goods)
	_npc_talk.selected.connect(_on_npc_selected)
	_npc_talk.opened.connect(_on_npc_opened)
	# The refusals: the client shows nothing for a refused select (round
	# 701's reading of 0x88b200); the open's and end's codes are logged.
	_npc_talk.select_refused.connect(func(code: int) -> void:
		print("NPC select refused, code %d" % code))
	_npc_talk.open_refused.connect(func(code: int) -> void:
		print("NPC open refused, code 0x%x" % code))
	_npc_talk.end_refused.connect(func(code: int) -> void:
		print("NPC end refused, code 0x%x" % code)
		_on_npc_ended_by_server())
	# Round 819: 0xB04B closes the NPC windows, whatever its result (READ,
	# c:0x886ac0 calls 0x79e350 before it reads the code) -- the quest talk's
	# OK and the reward end the talk this way (the server's TerminateMenu).
	_npc_talk.ended.connect(_on_npc_ended_by_server)
	return _npc_talk

## The 0xB045 reply (FUN_0088b200 -> IF_NPCWindow::FUN_00703ff0): the talk
## window opens for the NPC with the server's set.
func _on_npc_selected(entity: int, ids: PackedByteArray) -> void:
	var node: Node = _talk_select_node.get_ref() if _talk_select_node != null else null
	_talk_select_node = null
	if node == null or not is_instance_valid(node) or int(node.get_meta("npc_uid", 0)) != entity:
		node = _npc_holders.get(entity)
	if node == null or not is_instance_valid(node):
		print("NPC select: uid %d has no holder here" % entity)
		return
	print("NPC select: uid %d '%s' ids %s" % [entity, str(node.get_meta("npc_code", "")), Array(ids)])
	_talk_server = true
	_show_talk(node, ids)

## OpNpcShopDef (round 783): kept by uid for the select reply that follows.
func _on_npc_shop_def(data: PackedByteArray) -> void:
	var def := NpcShopDefNet.decode(data)
	if def.is_empty():
		print("NPC shop definition: malformed (%d bytes)" % data.size())
		return
	_npc_shop_defs[int(def["uid"])] = def
	var counts: Array = []
	for line in def["lines"]:
		var tabs: Array = []
		for tab in (line as Dictionary)["tabs"]:
			tabs.append((tab["ids"] as PackedInt32Array).size())
		counts.append(tabs)
	print("NPC shop definition: uid %d, %d line(s), goods per tab %s" % [int(def["uid"]), (def["lines"] as Array).size(), str(counts)])

## OpNpcShopGoods (round 786, OURS; NpcShopDefNet.OP_SHOP_GOODS): the
## instances the goods of the definition just sent are listed as (the Test
## Items NPC's +12 full-blue pieces), added to that definition so the store's
## tooltips read them (NpcShopDefNet.tabs -> ShopReader.Tab.instances).
func _on_npc_shop_goods(data: PackedByteArray) -> void:
	var goods := NpcShopDefNet.decode_goods(data)
	if goods.is_empty():
		print("NPC shop goods: malformed (%d bytes)" % data.size())
		return
	var uid := int(goods["uid"])
	if not _npc_shop_defs.has(uid):
		print("NPC shop goods: uid %d has no definition" % uid)
		return
	NpcShopDefNet.merge_goods(_npc_shop_defs[uid], goods)
	var def: Dictionary = _npc_shop_defs[uid]
	print("NPC shop goods: uid %d, %d listed instance(s) (%d in all)" % [uid, (goods["instances"] as Dictionary).size(),
		(def["instances"] as Dictionary).size()])

## The 0xB046 reply: the store (id 1) or the storage (3) opens; the talk
## line (2) keeps the talk window (INTERACTMODE 5; what the original then
## shows, CGObjPC::ShowFirstTalkMenu's message, is OPEN).
func _on_npc_opened(id: int) -> void:
	print("NPC open: id %d" % id)
	match id:
		1, 0x0c:
			# Round 801: 0xc is the specialty store's open; its store is the
			# NPC's own (the quotations follow as 0x30E0).
			if id == 0x0c and _specialty_flow != null:
				_specialty_flow.store_opened(_talk_npc_uid(), _talk_npc_code)
			# Round 783: a line of an NPC of OpenSRO's own -- its tabs and
			# goods are the server's definition, each id named through the
			# client's own item table.
			var custom_line := NpcShopDefNet.line_of(_talk_pending_tabgroup)
			if not _talk_shop_def.is_empty() and custom_line >= 0:
				var tabs := NpcShopDefNet.tabs(_talk_shop_def, custom_line, _hud_panels.item_code_for_id)
				var goods := 0
				for t in tabs:
					goods += (t as ShopReader.Tab).item_codes.size()
				print("NPC store: definition line %d, %d tab(s), %d good(s)" % [custom_line, tabs.size(), goods])
				_hud_panels.open_shop(_talk_npc_name, tabs, _talk_npc_code)
			elif _shop_reader != null and _talk_npc_code != "":
				_hud_panels.open_shop(_talk_npc_name, _shop_reader.tabs_for(_talk_npc_code, _talk_pending_tabgroup),
					_talk_npc_code)
		3:
			_hud_panels.open_storage(_talk_npc_name)
		0x0f:
			# Round 844: 0xB046 {1, 0x0f} -> 0x7250 {npc} (c:0x888fc8).
			_hud_panels.guild_storage().request_open(_talk_npc_uid(), _talk_npc_name)
		0x20:
			# Round 789: 0xB046 {1, 0x20} -> the grant window and the inventory
			# beside it (READ c:0x888e30 -> 0x79d4a0(1), 0x79af20).
			var grant := _hud_panels.open_grant_window()
			print("NPC grant window: %s" % ("open" if grant != null else "unavailable"))
		0x11:
			# Round 838: 0xB046 {1, 0x11} -> Magic POP (c:0x79c060): the
			# select window first.
			_open_gacha_select()

## The talk window, the store or the storage went away (HudPanels'
## npc_window_hidden): the end request 0x704B (READ: the NPC window's close
## slot 0x7040b0 while no open is in flight, and the store's and storage's
## close).
func _on_npc_window_hidden(panel_id: String) -> void:
	if panel_id == "store" and _specialty_flow != null:
		_specialty_flow.store_closed()
	# A hide the server asked for, or ShowWindow(0): no end request.
	if _npc_hide_silent > 0:
		return
	if not _talk_server or _npc_talk == null:
		return
	if _npc_talk.end():
		print("NPC end 0x704B: %s closed" % panel_id)

# --- Magic POP (round 838, GachaWindow / GachaSelectWindow / GachaNet) --------

var _gacha_tables: GachaTables = null
var _gacha_select: GachaSelectWindow = null
var _gacha_window: GachaWindow = null
## The machine the select window was opened for (its uid and ref id).
var _gacha_npc_uid := 0
var _gacha_npc_ref := 0

func _gacha_tables_loaded() -> GachaTables:
	if _gacha_tables == null and _ui_builder != null and _ui_builder.media_archive() != null:
		var archive := _ui_builder.media_archive()
		_gacha_tables = GachaTables.new().load(func(path: String) -> PackedByteArray:
			var entry := ObjectLoader.find_file(archive, path)
			return archive.read_file(entry) if entry != null else PackedByteArray())
		print("GACHA: tables -- %d prizes, %d machines, %d kinds" % [_gacha_tables.prizes.size(),
			_gacha_tables.machines.size(), _gacha_tables.kinds.size()])
	return _gacha_tables

func _gacha_connect() -> void:
	if not NetClient.gacha_play_result.is_connected(_on_gacha_play_result):
		NetClient.gacha_play_result.connect(_on_gacha_play_result)
		NetClient.gacha_exchange_failed.connect(_on_gacha_exchange_failed)
