## The objects' light from the zone's channels and the Bloom row (round 706,
## ObjectLight: READ); 1.0 channels before any zone (OURS fallback).
func _apply_object_light() -> void:
	var bloom := video_options().value(VideoOptions.BLOOM) == 1
	var d: Color = _object_light_channels[0] if not _object_light_channels.is_empty() else ObjectLight.FALLBACK_CHANNEL
	var a: Color = _object_light_channels[1] if not _object_light_channels.is_empty() else ObjectLight.FALLBACK_CHANNEL
	# OURS (round 786, NightLight): the night's scale on the world's objects
	# and characters; the portrait and the paper doll below keep the zone's
	# own light. 1 in a dungeon (its own light) and by day.
	var nk := _night_k if _dungeon == null else 1.0
	ObjectLight.set_light(NightLight.scaled(d, nk), NightLight.scaled(a, nk), bloom)
	print("World3D: object light (READ): ambient %s diffuse %s (channel 2 x %.1f, bloom %s) to-light %s%s%s" % [
		str(ObjectLight.current_ambient), str(ObjectLight.current_diffuse), ObjectLight.diffuse_scale(bloom),
		"on" if bloom else "off", str(ObjectLight.to_light_godot()), "" if not _object_light_channels.is_empty() else " (no zone yet)",
		" (night x %.3f, OURS)" % nk if nk < 1.0 else ""])
	# The portrait's and the paper doll's light follow (their diffuse scale is
	# the same READ rule).
	if not _object_light_channels.is_empty():
		if _paper_doll != null:
			_paper_doll.set_zone_light(d, a)
		if _hud_player_info != null:
			_hud_player_info.set_portrait_zone_light(d, a)

var _tile_index_load_attempted := false

## Loads and caches the real tile2d.ifo table (see TILE_INDEX_PATH) from
## OPENSRO_PK2_PATH's Data.pk2, for MapmTerrainBuilder's real per-vertex
## ground-tile-type coloring. Only ever parsed once per scene lifetime --
## every real region shares the same real table. Returns null (logged
## once) if OPENSRO_PK2_PATH isn't set or the file can't be found/parsed;
## callers already treat a null table as "fall back to the generic hue
## sweep," so this isn't a hard failure.
## Real parsed region-zone table, loaded once per run (it covers the whole
## real world, not one region). Null means "already tried, nothing usable".
var _regioninfo_cache: RegioninfoReader.ParsedTable = null
var _regioninfo_load_attempted := false

func _load_regioninfo() -> RegioninfoReader.ParsedTable:
	if _regioninfo_load_attempted:
		return _regioninfo_cache
	_regioninfo_load_attempted = true

	var archive := _open_pk2_if_set()
	if archive == null:
		return null
	var bytes := AssetSource.read_bytes(REGIONINFO_PATH, archive)
	if bytes.is_empty():
		print("World3D: no real region-zone table at ", REGIONINFO_PATH, " -- the zone label keeps whatever it already had")
		return null
	_regioninfo_cache = RegioninfoReader.parse(bytes)
	if _regioninfo_cache == null:
		printerr("World3D: could not parse real region-zone table at ", REGIONINFO_PATH)
	else:
		print("World3D: loaded real region-zone table (%d real zones) from %s" % [_regioninfo_cache.zones.size(), REGIONINFO_PATH])
	return _regioninfo_cache

## Names the real zone a region belongs to, in the label that has read
## "Zone: -" for want of anything real to put there.
##
## Only ever *replaces* the label when the real table names the region
## unambiguously. A region two real zones split between them resolves to
## nothing (see RegioninfoReader.sole_zone_for -- which side of the split a
## point falls on can't be decided until `RECT`'s real coordinates are
## understood), and so does a region the table never mentions. In both
## cases whatever the label already said is left alone rather than
## overwritten with a guess.

## Appends the player's real region and region-local position to the zone
## label, so a screenshot from a playtest says exactly *where* it was taken.
##
## Added 2026-09-06 after a real playtest reported parts of the world being
## "not where they should be" -- a real, credible report that could not be
## acted on, because neither a screenshot nor a description pins down which
## real region and which part of it is being looked at. The region and local
## coordinates are directly checkable against that region's own real authored
## minimap art (`Media.pk2`'s `minimap\\<y>x<x>.ddj`), which is what makes a
## report like that actionable rather than anecdotal.
## The last real zone name resolved for the player's region (the debug
## panel's and the help hints' zone).
var _current_zone_name := "-"
var _zone_label_tick := 0

## The "Audio" autoload's music half, or null (round 612).
func _audio_music() -> MusicDirector:
	var svc := AudioService.instance()
	return svc.music if svc != null else null

## Tells the music which zone the player stands in (round 612): the region
## and region-local position, resolved by the English regioninfo.txt in
## MusicDirector. Not while the loading screen is up -- it is silent, and the
## first world frame starts the music (READ). Retail asks every frame and does
## nothing when the name is unchanged; this asks with the zone label, every
## tenth tick (ours).
func _audio_area_tick() -> void:
	if _loading_screen != null or player == null:
		return
	var music := _audio_music()
	if music == null:
		return
	# The clock's hour picks the day or night ambient list at the next zone
	# change (round 786; READ, MusicDirector's header: h < 4 or h > 20).
	music.set_game_hour(NetClient.game_clock.hours(Time.get_ticks_msec()))
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		return
	var group: Node3D = pair[1]
	var parts := String(group.name).trim_prefix("RealTerrain_").split("_")
	if parts.size() < 2:
		return
	var local := group.to_local(player.global_position)
	music.set_area_at(parts[0].to_int(), parts[1].to_int(), local.x, local.z)

## The zone tick, every tenth call (the name is the retired zone label's,
## which this refreshed until round 848): the music's area, the water
## environment and the minimap's NPC dots.
func _refresh_zone_label_position() -> void:
	_zone_label_tick += 1
	if _zone_label_tick % 10 != 0:
		return
	_audio_area_tick()
	_water_env_tick()

	_minimap_npcs_cache = _minimap_npc_positions()

## The minimap and the world map follow the player every physics frame
## (round 630). OURS: the client refreshes its minimap's position through
## 0x661ce0 from 0x777a70, which CICPlayer::vslot_015(3) sends when the
## player's heading changes, and from vslot_012 (0x662510) while a zoom walks
## (it returns early otherwise); a per-frame refresh shows the same thing
## and does not depend on which events this client raises. It used to ride
## the zoom label's tenth-frame throttle, which made the arrow step. The NPC
## walk (every region's Npc_* holders) stays on that throttle, in
## _minimap_npcs_cache; NPCs do not move.
var _minimap_npcs_cache: Array = []
## The region group the player was last found in, and its region (x, y),
## parsed from the group's name once rather than every frame; the lists the
## signs are gathered into, reused (round 630 review).
var _minimap_group: Node3D = null
var _minimap_region := Vector2i(-1, -1)
var _minimap_group_name := StringName()
var _minimap_monsters: Array = []
var _minimap_others: Array = []
## Round 786: the monsters whose minimap sign is the unique's (rarity 3 or 8,
## HudMinimap.monster_sign_kind), id -> body, a subset of _monster_bodies
## kept with it (_build_monster_body, _free_monster_body, the zone change);
## and the frame's list of their positions.
var _minimap_unique_bodies := {}
var _minimap_uniques: Array = []
## The rendered frame the minimap was last refreshed in (round 664).
var _minimap_frame := -1

## The party members the maps mark this frame (round 717, PartyMapMarks;
## round 786 in a dungeon): the minimap's, each a ground position (x east, y
## north) in the frame the player's own position is given in -- the
## region-local frame of the player's region in the field, the dungeon's
## own space in a dungeon -- and the world map's (every member but the
## player), each its region word and its position in that region (y the
## record's height), with the names. Reused, so a settled party allocates
## nothing a frame.
var _party_marks_mini := PackedVector2Array()
var _party_marks_regions := PackedInt32Array()
var _party_marks_pos := PackedVector3Array()
var _party_marks_names := PackedStringArray()
## The party the maps read instead of NetClient's (tests); null in play.
var _party_marks_party: PartyState = null

## Fills the lists. `here_region` is the player's field region (unused in a
## dungeon). A member's position is its spawned body's when this client has
## one (0x9c35e0), else its record's (x, 0, z) in its region (0x9ecfd0) --
## the minimap's and the world map's own rule. Whether the minimap takes a
## member is decided on the record (0x9d5520 is given the record's region
## and x, y, z: asm 0x6643de..0x664412), as is a dungeon floor's height test
## on the world map (0x61fd01..0x61fd3b): so the world map's y is the
## record's.
func _fill_party_marks(here_region: Vector2i) -> void:
	var party: PartyState = _party_marks_party if _party_marks_party != null else NetClient.party
	var in_dungeon := _dungeon != null
	var ready: bool = party.in_party and (in_dungeon or (here_region.x >= 0 and _minimap_group != null
		and is_instance_valid(_minimap_group)))
	var own: PartyNet.Member = party.member(party.own_jid) if ready else null
	var own_world: int = own.world_id if own != null else -1
	var player_region: int = (_dungeon.rid & 0xFFFF) if in_dungeon \
		else (((here_region.x & 0xFF) << 8) | (here_region.y & 0xFF))
	# First the counts, so the lists change size only when the party does.
	var nm := 0
	var nw := 0
	if ready:
		for m in party.members:
			if PartyMapMarks.worldmap_draws(m, party.own_jid):
				nw += 1
				if _party_minimap_draws(m, party.own_jid, own_world, player_region):
					nm += 1
	if _party_marks_mini.size() != nm:
		_party_marks_mini.resize(nm)
	if _party_marks_regions.size() != nw:
		_party_marks_regions.resize(nw)
		_party_marks_pos.resize(nw)
		_party_marks_names.resize(nw)
	if nw == 0:
		return
	var im := 0
	var iw := 0
	for m in party.members:
		if not PartyMapMarks.worldmap_draws(m, party.own_jid):
			continue
		# The position in the player's frame (the minimap's) and the
		# region word and position the world map places by.
		var at: Vector2
		var region: int = m.region
		var body := _party_body_for_board(m.jid) as Node3D
		if body != null and is_instance_valid(body) and body.is_inside_tree():
			if in_dungeon:
				var d := DungeonWorld.to_dungeon(body.global_position)
				at = Vector2(d.x, d.z)
			else:
				var l := _minimap_group.to_local(body.global_position)
				at = Vector2(l.x, l.z)
			region = player_region
		elif in_dungeon or (m.region & PartyMapMarks.DUNGEON_BIT) != 0:
			# A dungeon record is already in the dungeon's own space.
			at = Vector2(float(m.x), float(m.z))
		else:
			at = PartyMapMarks.record_local(here_region, m.region, float(m.x), float(m.z))
			region = player_region
		_party_marks_regions[iw] = region
		_party_marks_pos[iw] = Vector3(at.x, float(m.y), at.y)
		if _party_marks_names[iw] != m.member_name:
			_party_marks_names[iw] = m.member_name
		iw += 1
		if _party_minimap_draws(m, party.own_jid, own_world, player_region):
			_party_marks_mini[im] = at
			im += 1

## The minimap's test for `m` (CIFMinimap::vslot_013, 0x6643bb..0x664419):
## the world id, then 0x9d5520 on the record's region and position. The
## world-id test (record +0x68 against the player's own world id, +0x20e4
## through 0x9d4d90) is OURS in one respect: OpenSRO's client keeps the
## player's world id only in the player's own party record, so that record
## stands in for +0x20e4 (right while the server keeps it current); without
## it nothing is compared. The floor is asked only for a record in the
## player's own dungeon.
func _party_minimap_draws(m: PartyNet.Member, own_jid: int, own_world: int, player_region: int) -> bool:
	if m == null or m.jid == own_jid:
		return false
	if own_world >= 0 and m.world_id != own_world:
		return false
	var same_floor := false
	if _dungeon != null and (m.region & 0xFFFF) == (player_region & 0xFFFF):
		# No block under either position: 0x9d5520 found no cell, so 0.
		var floor_here := _party_player_floor()
		same_floor = floor_here >= 0 and _party_record_floor(m) == floor_here
	return PartyMapMarks.region_visible(m.region, player_region, same_floor)

## The floor index (DofReader.Block.floor_index) of the block under a
## member's record position in the player's dungeon, -1 when no block is
## there (0x9d5520 then answers 0: its cell lookup found nothing). The
## block's floor is what 0x9d5520 compares, through the same `[0x1103cc6]`
## slot 1 and the block's slot 2 that ICPlayer::FUN_009d7880 reads the floor
## name with (READ); that slot 2 is DofReader's floor index is INFERRED, as
## for the floor name (round 774). Kept per member until its record moves,
## so a settled party asks the walkable graph nothing a frame (OURS).
var _party_floor_cache := {}

func _party_record_floor(m: PartyNet.Member) -> int:
	if _dungeon == null:
		return -1
	var key := Vector4i(m.region, m.x, m.y, m.z)
	var hit = _party_floor_cache.get(m.jid)
	if hit != null and (hit as Array)[0] == key:
		return int((hit as Array)[1])
	var b := DungeonWorld.block_under(_dungeon, Vector3(float(m.x), float(m.y), float(m.z)))
	var f: int = (_dungeon.dof.blocks[b] as DofReader.Block).floor_index \
		if b >= 0 and b < _dungeon.dof.blocks.size() else -1
	_party_floor_cache[m.jid] = [key, f]
	return f

## The player's block's floor index (its +0x74 / +0x78 cell's block, which
## _dungeon_tick keeps in _dungeon_block), -1 off every block.
func _party_player_floor() -> int:
	if _dungeon == null or _dungeon_block < 0 or _dungeon_block >= _dungeon.dof.blocks.size():
		return -1
	return (_dungeon.dof.blocks[_dungeon_block] as DofReader.Block).floor_index

## QA (round 757, QaCrowdProbe's `minimap` step): the minimap not refreshed.
var _qa_minimap_off := false

func _refresh_minimap() -> void:
	if player == null or _hud_minimap == null or not is_instance_valid(_hud_minimap) or _qa_minimap_off:
		# Round 757: no minimap to write to (no HUD, a QA run): the moves it
		# would have taken are not kept.
		_minimap_moved.clear()
		return
	if _dungeon != null:
		# The tracked quest's signs are the field's (npcpos); a dungeon's
		# minimap draws none (round 785's client review, finding 14, OURS:
		# before, the field's last signs stayed frozen on it).
		_hud_minimap.update_quest(Vector2.ZERO, PackedVector2Array())
		_refresh_dungeon_minimap()
		return
	var pos := player.global_position
	var local := Vector3.ZERO
	var inside := false
	if _minimap_group != null and is_instance_valid(_minimap_group) and _minimap_group.is_inside_tree() \
			and _minimap_group.name == _minimap_group_name:
		local = _minimap_group.to_local(pos)
		inside = local.x >= 0.0 and local.z >= 0.0 and local.x <= REGION_SPAN and local.z <= REGION_SPAN
	if not inside:
		var pair := _nav_graph_for(pos)
		if pair.is_empty():
			return
		var group: Node3D = pair[1]
		var parts := String(group.name).trim_prefix("RealTerrain_").split("_")
		if parts.size() < 2:
			return
		_minimap_group = group
		_minimap_group_name = group.name
		_minimap_region = Vector2i(parts[0].to_int(), parts[1].to_int())
		local = group.to_local(pos)
	var rx := _minimap_region.x
	var ry := _minimap_region.y
	var facing := minimap_facing(player.global_transform.basis, _minimap_group.global_transform.basis)
	_hud_minimap.update_player(rx, ry, local, facing)
	_hud_minimap.set_area_name(_current_zone_name)
	# Only bodies that can land inside the sign circle (round 664): HudMinimap
	# draws a sign only under SIGN_RADIUS pixels from the centre, which at
	# the drawn zoom is this many world units (a hair over, so the circle's
	# own test still decides the edge).
	var reach := HudMinimap.SIGN_RADIUS / maxf(_hud_minimap.tile_px(), 0.001) * HudMinimap.REGION_SPAN * 1.01
	_minimap_fill_monsters(pos, reach)
	# Round 757: the other players' signs are kept by the minimap and written
	# as bodies move (_other_moved), not refilled from every body each frame.
	_minimap_others_sync()
	_hud_minimap.update_signs(pos, _minimap_npcs_cache, _minimap_monsters, _minimap_others, _minimap_uniques)
	_fill_party_marks(_minimap_region)
	# Round 865: the academy's members, drawn before the party's.
	_fill_academy_marks(_minimap_region)
	_hud_minimap.update_academy(Vector2(local.x, local.z), _academy_marks_mini)
	_hud_minimap.update_party(Vector2(local.x, local.z), _party_marks_mini)
	_update_quest_signs(_minimap_region, Vector2(local.x, local.z))
	# The world map every frame only while it is open; hidden, on the old
	# tenth-frame beat, so it is current when it opens.
	if _hud_worldmap != null and is_instance_valid(_hud_worldmap) \
			and (_hud_worldmap.is_visible_in_tree() or _zone_label_tick % 10 == 0):
		_hud_worldmap.update_player(rx, ry, local, facing)
		_hud_worldmap.update_academy(_academy_marks_regions, _academy_marks_pos)
		_hud_worldmap.update_party(_party_marks_regions, _party_marks_pos, _party_marks_names, NetClient.party.job_party)
	# OPENSRO_QA_WALK runs log what the minimap was told, twice a second,
	# so a facing test is read from the log, not a frame (round 630).
	if _qa_walk != "" and _zone_label_tick % 30 == 0:
		print("QA MINIMAP %d/%d local (%.0f, %.0f) facing (%.2f, %.2f) arrow %.0f deg" % [
			rx, ry, local.x, local.z, facing.x, facing.y, rad_to_deg(HudMinimap.arrow_rotation(facing))])

## Round 757: the other players' minimap signs, kept up to date from the moves
## reported this frame (_other_moved) and a spread re-read of
## MINIMAP_RESCAN_FRAMES (a body moved or hidden by a path that does not report,
## an arrival, a departure). MEASURED at 7,000: the per-frame fill over every
## body and the 7,000 TextureRects were 8.45 ms a frame.
const MINIMAP_RESCAN_FRAMES := 60
var _minimap_moved := {}
var _minimap_scan: Array = []
var _minimap_scan_at := 0
var _minimap_sign_ids: Array = []
var _minimap_sign_at := 0

func _minimap_others_sync() -> void:
	for b in _minimap_moved:
		if is_instance_valid(b):
			_minimap_put_other(b as Node3D)
	_minimap_moved.clear()
	# The spread re-read: every body once in MINIMAP_RESCAN_FRAMES refreshes.
	if _minimap_scan_at >= _minimap_scan.size():
		_minimap_scan = _other_bodies.keys()
		_minimap_scan_at = 0
	var per := ceili(float(_minimap_scan.size()) / float(MINIMAP_RESCAN_FRAMES))
	var end := mini(_minimap_scan_at + per, _minimap_scan.size())
	while _minimap_scan_at < end:
		var body = _other_bodies.get(_minimap_scan[_minimap_scan_at])
		_minimap_scan_at += 1
		if body != null and is_instance_valid(body):
			_minimap_put_other(body as Node3D)
	# And the signs whose body is gone (a departure the leave path dropped
	# already, or a body taken out some other way).
	if _minimap_sign_at >= _minimap_sign_ids.size():
		_minimap_sign_ids = _hud_minimap.other_ids()
		_minimap_sign_at = 0
	per = ceili(float(_minimap_sign_ids.size()) / float(MINIMAP_RESCAN_FRAMES))
	end = mini(_minimap_sign_at + per, _minimap_sign_ids.size())
	while _minimap_sign_at < end:
		var id: int = int(_minimap_sign_ids[_minimap_sign_at])
		_minimap_sign_at += 1
		var body = _other_bodies.get(id)
		if body == null or not is_instance_valid(body):
			_hud_minimap.drop_other(id)

func _minimap_put_other(body: Node3D) -> void:
	if not body.has_meta("character_id") or not body.is_inside_tree():
		return
	var id := int(body.get_meta("character_id"))
	if _other_bodies.get(id) != body:
		return
	_hud_minimap.put_other(id, body.global_position, body.visible or _objects_hidden)

## Fills `out` (kept, cleared and refilled) with the world positions of the live bodies in an id -> Node3D map (monsters,
## other players), skipping ones that are gone or hidden (a dead monster).
## A body held V hides still counts: whether the retail minimap reads V's
## flag was not read, so the minimap is left as it was.
## `skip` (round 786): ids left out (the uniques, which take their own sign),
## looked up only for a body inside the reach and only while it holds any.
func _minimap_fill_positions(bodies: Dictionary, out: Array, centre: Vector3 = Vector3.ZERO, reach: float = INF, skip: Dictionary = {}) -> void:
	out.clear()
	var reach_sq := reach * reach
	var skipping := not skip.is_empty()
	for id in bodies:
		var body: Node3D = bodies[id] as Node3D
		if body != null and is_instance_valid(body) and (body.visible or _objects_hidden):
			var at := body.global_position
			var dx := at.x - centre.x
			var dz := at.z - centre.z
			if dx * dx + dz * dz < reach_sq:
				if skipping and skip.has(id):
					continue
				out.append(at)

## Round 786: the monsters' signs, split by the sign each takes
## (HudMinimap.monster_sign_kind, READ vslot_013): the uniques, kept apart at
## spawn in _minimap_unique_bodies, into _minimap_uniques; every other
## monster into _minimap_monsters. OURS: the split is made once a body, at
## spawn, so the per-frame walk over up to 7,000 bodies (round 757) adds a
## lookup only for a body in the sign circle while a unique is loaded.
func _minimap_fill_monsters(centre: Vector3, reach: float) -> void:
	_minimap_fill_positions(_monster_bodies, _minimap_monsters, centre, reach, _minimap_unique_bodies)
	_minimap_fill_positions(_minimap_unique_bodies, _minimap_uniques, centre, reach)

## The way the player faces as a region-local ground vector (x east, z
## north), for the minimap's and world map's arrow. The player's front is its
## node's local +Z (_physics_process sets rotation.y = atan2(dir.x, dir.z) to
## face `dir`); the region group's basis carries the world's z -> -z mirror,
## so the vector is taken into the group's frame rather than read off
## rotation.y, which is what the minimap used to do (round 630).
static func minimap_facing(player_basis: Basis, group_basis: Basis) -> Vector2:
	var front := group_basis.inverse() * player_basis.z
	return Vector2(front.x, front.z)

## World positions of every placed NPC, for the minimap's signs: the `Npc_*`
## holders under each loaded region group (the same walk _qa_npc_body_report
## does). UI seam -- the minimap only ever sees positions, never the nodes.
func _minimap_npc_positions() -> Array:
	var out: Array = []
	for group in get_children():
		if not (group is Node3D) or not String(group.name).begins_with("RealTerrain_"):
			continue
		for holder in group.get_children():
			if holder is Node3D and String(holder.name).begins_with("Npc_"):
				out.append((holder as Node3D).global_position)
	return out

## Bone positions of the first few animated characters, so two calls can be
## differenced. Keyed by skeleton instance id.
var _qa_anim_sample: Dictionary = {}

func _qa_animation_report() -> void:
	print("QA ANIM %d animated character(s), %d posed and %d culled last frame" % [_animated.size(), _anim_posed_last, _anim_culled_last])
	var checked := 0
	for entry in _animated:
		var skeleton: Skeleton3D = entry[0]
		if not is_instance_valid(skeleton):
			continue
		var sum := Vector3.ZERO
		for i in range(skeleton.get_bone_count()):
			sum += skeleton.get_bone_global_pose(i).origin
		# The frame this character is posed at, reported alongside the
		# movement: a short loop sampled a whole number of cycles apart is
		# genuinely on the same frame, and "moved 0.000" then says the probe
		# aliased rather than that the animation is dead.
		var frames: int = entry[2]
		var phase: float = entry[3]
		var anim: BanReader.ParsedAnimation = entry[1]
		var frame_idx := anim.key_index_at(_idle_anim_time + phase, true)
		var key := skeleton.get_instance_id()
		var previous = _qa_anim_sample.get(key)
		if previous == null:
			print("   %-22s %2d bones, %2d frames, at frame %d -- first sample" % [
				skeleton.get_parent().name, skeleton.get_bone_count(), frames, frame_idx])
		else:
			var moved: float = (sum - (previous as Vector3)).length()
			print("   %-22s %2d bones, %2d frames, at frame %d -- bones moved %.3f" % [
				skeleton.get_parent().name, skeleton.get_bone_count(), frames, frame_idx, moved])
		_qa_anim_sample[key] = sum
		checked += 1
		if checked >= 5:
			break

## Reports, for every placed object near the player, how its rendered
## footprint compares with the walkable footprint in the navigation graph.
##
## The gap is what lets a player stand inside a structure: the graph only
## knows the walkable part, so where the solid mesh reaches further, the
## graph reports the terrain underneath and puts the player there. Jangan's
## gate is the case that prompted this.
func _qa_navgap_report() -> void:
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		print("QA NAVGAP: off-region")
		return
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	var here := group.to_local(player.global_position)

	# Rendered footprints, from the region's own object nodes.
	# Objects hang off a container under the terrain group, not off the
	# group itself -- the same two-level walk _qa_look_report does.
	var object_nodes: Array[Node] = []
	for container in group.get_children():
		for node in container.get_children():
			if node is Node3D and String(node.name).begins_with("Obj_"):
				object_nodes.append(node)

	var rendered := {}
	for child in object_nodes:
		var box := AABB()
		var seeded := false
		var stack: Array[Node] = [child]
		while not stack.is_empty():
			var cur: Node = stack.pop_back()
			if cur is MeshInstance3D and (cur as MeshInstance3D).mesh != null:
				var mi := cur as MeshInstance3D
				var world_box: AABB = mi.global_transform * mi.get_aabb()
				if seeded:
					box = box.merge(world_box)
				else:
					box = world_box
					seeded = true
			for c in cur.get_children():
				stack.append(c)
		if seeded:
			rendered[String(child.name)] = box

	# Two independent questions, asked separately, because tying them
	# together needs a name-to-index mapping that does not exist: the render
	# nodes are numbered by a running "how many loaded" counter over the
	# .o/.o2 placement files, while the graph keys objects by their index in
	# the .nvm's own object list. An earlier version of this report matched
	# them by the node name's trailing number and confidently reported "NO
	# walkable mesh" for an object that may well have one.
	#
	# So: what does the graph offer to stand on here, and what solid
	# geometry actually covers the spot.
	print("QA NAVGAP at local %d, %d" % [here.x, here.z])

	# heights_at is every surface the graph knows here: the terrain first,
	# then any object cell covering the point.
	var offered := graph.heights_at(here.x, here.z)
	print("   graph offers %d surface(s): %s" % [offered.size(), offered])
	print("   graph objects covering this point: %s" % [graph.objects_at(here.x, here.z)])

	var covering := 0
	for name in rendered:
		var box: AABB = rendered[name]
		var lo := group.to_local(box.position)
		var hi := group.to_local(box.end)
		var x0: float = minf(lo.x, hi.x)
		var x1: float = maxf(lo.x, hi.x)
		var z0: float = minf(lo.z, hi.z)
		var z1: float = maxf(lo.z, hi.z)
		if here.x < x0 or here.x > x1 or here.z < z0 or here.z > z1:
			continue
		covering += 1
		print("   solid %-34s y %.1f..%.1f" % [name, minf(lo.y, hi.y), maxf(lo.y, hi.y)])
	if covering == 0:
		print("   nothing solid covers this spot")

## Opens the named HUD panels and tiles them across the screen, so one
## render can show several at once. Reports what opened and what didn't --
## a panel whose authored layout is missing prints rather than failing.
func _qa_open_panels(spec: String) -> void:
	if _hud_panels == null:
		print("QA PANELS: no HUD (Media.pk2 not loaded)")
		return
	# OPENSRO_QA_PANELS_IN_PLACE=1 leaves every window where it places
	# itself (the main popup's tab side, clamped into the viewport) instead of
	# centring or tiling it for the shot.
	var in_place := OS.get_environment("OPENSRO_QA_PANELS_IN_PLACE") != ""
	var ids := spec.split(",", false)
	var placed := 0
	var windows: Array = []   # distinct windows opened, in order
	for raw in ids:
		var panel_id := raw.strip_edges()
		if panel_id == "":
			continue
		# The MENU is not a panel: it is the underbar's own popup (59).
		if panel_id == "menu":
			if _hud_underbar != null:
				_hud_underbar.show_menu()
			placed += 1
			continue
		var window := _hud_panels.open(panel_id)
		if window == null:
			print("QA PANELS: %s did not open" % panel_id)
			continue
		placed += 1
		# Several ids can be tabs of one window (the main popup): the later
		# id switches its tab rather than opening a second window, and the
		# report says so instead of counting it as another window.
		if windows.has(window):
			print("QA PANELS: %s is a tab of the window %s already opened; it is now showing, %dx%d at %s" % [
				panel_id, window.name, int(window.size.x), int(window.size.y), window.position])
			continue
		windows.append(window)
		if not in_place:
			# A single window centres for a clean shot, clear of the left-side
			# chat log; several tile across the top. Through place_window, so
			# the main popup keeps the placement through a resize.
			var view := get_viewport().get_visible_rect().size
			if ids.size() == 1:
				_hud_panels.place_window(window, ((view - window.size) / 2.0).round())
			else:
				var column := (windows.size() - 1) % 3
				var row: int = (windows.size() - 1) / 3
				_hud_panels.place_window(window, Vector2(
					20.0 + column * (view.x - 40.0) / 3.0,
					90.0 + row * 200.0))
		print("QA PANELS: %s opened %dx%d at %s%s" % [
			panel_id, int(window.size.x), int(window.size.y), window.position,
			" (its own placement)" if in_place else ""])
	print("QA PANELS: %d of %d ids opened, in %d window(s)" % [placed, ids.size(), windows.size()])

## The client's own per-region zone names (Media.pk2's
## `server_dep\\silkroad\\textdata\\textzonename.txt`), loaded once per run.
## Empty means "already tried, nothing usable" -- see _zone_name_for_region.
const TEXT_ZONE_NAME_PATH := "server_dep\\silkroad\\textdata\\textzonename.txt"
var _text_zone_names: Dictionary = {}
var _text_zone_names_load_attempted := false

func _load_text_zone_names() -> Dictionary:
	if _text_zone_names_load_attempted:
		return _text_zone_names
	_text_zone_names_load_attempted = true
	var archive := _open_media_pk2_if_set()
	if archive == null:
		return _text_zone_names
	var bytes := AssetSource.read_bytes(TEXT_ZONE_NAME_PATH, archive)
	if bytes.is_empty():
		print("World3D: no real per-region zone-name table at ", TEXT_ZONE_NAME_PATH, " -- the zone label falls back to Shader\\regioninfo.txt's 15 zones")
		return _text_zone_names
	_text_zone_names = TextZoneNameReader.parse(bytes)
	print("World3D: loaded real per-region zone names (%d regions) from %s" % [_text_zone_names.size(), TEXT_ZONE_NAME_PATH])
	return _text_zone_names

## The display name of the zone a region belongs to. The per-region text
## table is the game's own answer and covers the whole world (Alexandria,
## the dungeons, the arenas); `Shader\\regioninfo.txt` names only the 15
## original zones, so it is the fallback -- and a region neither knows
## keeps the label as it is rather than inventing a name. Before the text
## table was read (docs/rounds/map.md, 2026-09-19) a travel to Alexandria
## left the label and the minimap saying "Jangan".
func _zone_name_for_region(region_x: int, region_y: int) -> String:
	var zone_name := TextZoneNameReader.name_for(_load_text_zone_names(), region_x, region_y)
	if zone_name != "":
		return zone_name
	var table := _load_regioninfo()
	if table == null:
		return ""
	return RegioninfoNames.display_for_region(table, region_x, region_y)

func _update_zone_label_for_region(region_x: int, region_y: int) -> void:
	# The area banner's test runs on every region the player enters (round
	# 703; HudRegionView.enter_region is 0x665aa0's rule).
	_zone_region = Vector2i(region_x, region_y)
	if _hud_region != null:
		_hud_region.enter_region(TextZoneNameReader.region_id(region_x, region_y))
	var zone_name := _zone_name_for_region(region_x, region_y)
	if zone_name == "":
		return
	_current_zone_name = zone_name
	if _hud_minimap != null and is_instance_valid(_hud_minimap):
		_hud_minimap.set_area_name(zone_name)

func _load_tile_index() -> TileIndexReader.Table:
	if _tile_index_load_attempted:
		return _tile_index_cache
	_tile_index_load_attempted = true

	var archive := _open_pk2_if_set()
	if archive == null:
		return null
	var bytes := AssetSource.read_bytes(TILE_INDEX_PATH, archive)
	if bytes.is_empty():
		print("World3D: could not find real tile index at ", TILE_INDEX_PATH, " -- terrain color falls back to a generic hue sweep")
		return null
	_tile_index_cache = TileIndexReader.parse(bytes)
	if _tile_index_cache == null:
		printerr("World3D: could not parse real tile index at ", TILE_INDEX_PATH)
	else:
		print("World3D: loaded real tile index (%d real tile types) from %s" % [_tile_index_cache.entries.size(), TILE_INDEX_PATH])
	return _tile_index_cache

## Real per-.ddj-filename texture cache, shared across every region this
## world loads -- most real tile2d.ifo IDs a region uses (grass/dirt/stone,
## etc) repeat across many regions, so this avoids re-reading and
## re-decoding the same real Tile2D\*.ddj file over and over. A null entry
## means "already tried, no real file/decode" -- also cached, so a
## consistently-missing ID doesn't retry every region load. Per instance,
## not static, since round 560: as a `static var` it outlived the world
## (round 558's scripted reconnect measured entry 2 starting with entry 1's
## 43 textures, `cache_ground=43`, before it had loaded a region), and a
## second login in one process now decodes its own -- the cost is on the
## `ground textures for` line (decoded count and ms). Cleared in _exit_tree.
var _ground_texture_cache: Dictionary = {}

## Which of a region's real per-vertex ground texture IDs resolve, and the
## ground tiles this world has not uploaded yet decoded to Images -- the
## prepare half (round 565) of what `_load_real_ground_textures` did on the
## main thread until then. Keyed by the real TextureInfo.ID
## MapmTerrainBuilder's _vertex_color already decodes -- see
## docs/protocol/DDJ_FORMAT.md and TILE2D_FORMAT.md's 2026-08-23 correction.
## Each real ID resolves through the tile table to a real tile2d.ifo
## filename, loaded from Map.pk2's real `Tile2D\` folder (confirmed
## 2026-08-23 to be where these actually live -- see server/cmd/pk2list's
## real listing against a real Map.pk2). Sets the job's `texture_files` (ID
## -> filename, resolved IDs only) and `new_images` (filename -> Image, null
## for a file missing or undecodable), both empty -- the flat colour, as
## before -- with no tile table or no Map.pk2. A file the job's snapshot of
## _ground_texture_cache names is not read again; one another in-flight job
## is decoding too is decoded twice, and the commit that lands second keeps
## the first upload (_terrain_commit).
static func _prepare_ground_textures(job: Dictionary, region: MapmReader.ParsedRegion) -> void:
	var files := {}
	var new_images := {}
	job["texture_files"] = files
	job["new_images"] = new_images
	var tile_table: TileIndexReader.Table = job["tile_table"]
	var archive: Pk2Reader = job["map_pk2"]
	if tile_table == null or archive == null:
		return
	var known: Dictionary = job["known_textures"]

	var ids := {}
	for block in region.blocks:
		for vertex in block.vertices:
			if vertex.extra.size() < 2:
				continue
			ids[vertex.extra.decode_u16(0) & 0x3ff] = true

	var no_entry := 0
	var unreadable := 0
	var decoded := 0
	var started_ms := Time.get_ticks_msec()
	for id in ids.keys():
		var entry := tile_table.lookup(id)
		if entry == null or entry.filename == "":
			no_entry += 1
			continue
		var filename := entry.filename
		var resolved: bool
		if known.has(filename):
			resolved = known[filename]
		elif new_images.has(filename):
			resolved = new_images[filename] != null
		else:
			decoded += 1
			var image := _decode_ground_image(filename, archive)
			new_images[filename] = image
			resolved = image != null
		if resolved:
			files[id] = filename
		else:
			unreadable += 1
	# One line per region, so a playtest log can say whether a flat or white
	# floor was a texture the archive did not have (unreadable), an id the
	# tile table did not know (no entry), or neither (a rendering problem).
	# The decoded count and time say what this world's own cache cost --
	# on a second login every region's first textures are decoded again
	# (round 560), which is the price of nothing outliving the instance.
	# Since round 565 the time is the decode alone, off the main thread for a
	# streamed cell; the upload is the commit's `images` lap. The same counts
	# ride the job to the commit, which leaves them on the terrain group for
	# /groundprobe (round 579).
	job["ground_counts"] = {"ids": ids.size(), "resolved": files.size(), "decoded": decoded,
		"no_entry": no_entry, "unreadable": unreadable}
	(job["log"] as Array).append(["out", "World3D: ground textures for %s -- %d ids, %d resolved, %d decoded now in %d ms, %d without a tile2d.ifo entry, %d files missing or undecodable%s" % [
		job["mapm_path"], ids.size(), files.size(), decoded, Time.get_ticks_msec() - started_ms, no_entry, unreadable,
		"" if not files.is_empty() else " -- NOTHING resolved, the region draws the flat fallback"]])

## One real Tile2D\<filename>.ddj decoded to an Image (no texture: the
## commit uploads it), or null for a file missing or undecodable -- what
## `_load_ground_texture_file` read and decoded until round 565.
static func _decode_ground_image(filename: String, archive: Pk2Reader) -> Image:
	var bytes := AssetSource.read_bytes("Tile2D\\%s" % filename, archive)
	if bytes.is_empty():
		return null
	var parsed := DdjReader.parse(bytes)
	if parsed == null:
		return null
	return DdjReader.to_image(parsed)

## Real, per-world cache of the 30-frame real water animation loaded from
## Map.pk2's own real `Water\` folder (see docs/WORLD_ISSUES.md's
## 2026-08-26 asset-taxonomy entry) -- every region shares the same real
## water animation, so this is only ever built once per world regardless
## of how many real regions with real water tiles get loaded. Instance
## state since round 560 (statics outlived the world; see
## _ground_texture_cache); cleared in _exit_tree.
var _water_frames_cache: Array = []
var _water_frames_load_attempted := false

## Loads the real 30-frame water flip-book animation
## (Water\water101.ddj..water130.ddj -- a real numbered-frame sequence, not
## a shader effect) into an AnimatedTexture, or null if none of the 30 real
## frames were found (e.g. OPENSRO_MAP_PK2_PATH unset, or a real archive
## that doesn't ship this folder). Frame timing READ (round 627): the client
## picks frame (GetTickCount() / 100) % 30 in `Map::FUN_00a220b0`, so 100 ms
## a frame -- 10 fps, not the 8 fps this used to guess.
const WATER_FRAME_COUNT := MapmWater.FRAME_COUNT
const WATER_FRAME_FPS := 1000.0 / float(MapmWater.FRAME_MS)

func _load_real_water_animation(archive: Pk2Reader) -> AnimatedTexture:
	if not _water_frames_load_attempted:
		_water_frames_load_attempted = true
		var started_ms := Time.get_ticks_msec()
		for i in range(WATER_FRAME_COUNT):
			var filename := "water1%02d.ddj" % (i + 1)
			var bytes := AssetSource.read_bytes("Water\\%s" % filename, archive)
			if bytes.is_empty():
				continue
			var parsed := DdjReader.parse(bytes)
			if parsed == null:
				continue
			var tex := DdjReader.to_texture(parsed)
			if tex != null:
				_water_frames_cache.append(tex)
		if _water_frames_cache.is_empty():
			print("World3D: no real water frames found under Water\\ -- water tiles render as plain ground")
		else:
			# Once per world: what a second login pays to decode its own
			# frames (round 560), beside the ground textures' own line.
			print("World3D: water animation -- %d of %d frames decoded in %d ms" % [
				_water_frames_cache.size(), WATER_FRAME_COUNT, Time.get_ticks_msec() - started_ms])

	if _water_frames_cache.is_empty():
		return null

	var anim := AnimatedTexture.new()
	anim.frames = _water_frames_cache.size()
	for i in range(_water_frames_cache.size()):
		anim.set_frame_texture(i, _water_frames_cache[i])
		anim.set_frame_duration(i, 1.0 / WATER_FRAME_FPS)
	return anim

## The still surface a PlaneType-1 block draws: `water\water201.ddj`
## (READ, the texture the client loads into world+0x28a7 and binds for those
## blocks). Loaded once per world; null when the archive lacks it.
var _water_still_texture: Texture2D = null
var _water_still_load_attempted := false

func _load_still_water_texture(archive: Pk2Reader) -> Texture2D:
	if not _water_still_load_attempted:
		_water_still_load_attempted = true
		var bytes := AssetSource.read_bytes("Water\\water201.ddj", archive)
		var parsed := DdjReader.parse(bytes) if not bytes.is_empty() else null
		if parsed != null:
			_water_still_texture = DdjReader.to_texture(parsed)
		if _water_still_texture == null:
			print("World3D: no Water\\water201.ddj -- PlaneType-1 still surfaces are not drawn")
	return _water_still_texture

## The two water materials, one per world like the client's own render
## state: every region's water shares them, and the environment's WaterColor
## (channel 14) is written into the animated one whenever the player's
## environment is applied (_apply_real_environment_lighting), as the client
## sets one world-wide texture factor. MapmWater builds them and holds the
## READ render state they follow.
var _water_material: StandardMaterial3D = null
## Round 628: the Water Reflection option, its node, and its two materials.
var _water_reflection_on := true
var _water_reflection: WaterReflection = null
var _water_reflect_material: ShaderMaterial = null
var _water_reflect_still_material: ShaderMaterial = null
var _water_bump_texture: Texture2D = null
var _water_bump_attempted := false

## waterbump3.ddj turned into the bump stage's du/dv (READ, FUN_009f2050).
func _load_water_bump(archive: Pk2Reader) -> Texture2D:
	if not _water_bump_attempted:
		_water_bump_attempted = true
		var started := Time.get_ticks_msec()
		var bytes := AssetSource.read_bytes("SkyBox\\waterbump3.ddj", archive)
		var parsed := DdjReader.parse(bytes) if not bytes.is_empty() else null
		var img := DdjReader.to_image(parsed) if parsed != null else null
		var bump := WaterReflection.bump_image(img)
		if bump != null:
			_water_bump_texture = ImageTexture.create_from_image(bump)
			print("World3D: water bump from SkyBox\\waterbump3.ddj, %dx%d, in %d ms" % [bump.get_width(), bump.get_height(), Time.get_ticks_msec() - started])
		else:
			print("World3D: no SkyBox\\waterbump3.ddj -- the reflection is drawn without its bump")
	return _water_bump_texture

## Writes the water colour into whichever water materials exist.
func _set_water_color(c: Color) -> void:
	if _water_material != null:
		MapmWater.set_water_color(_water_material, c)
	if _water_reflection != null:
		_water_reflection.set_water_color(c)
var _water_still_material: StandardMaterial3D = null
## The EnvironmentID the water's colour was last taken from (-1 none).
var _water_env_id := -1

## Retail's whole environment -- the water's colour included -- follows the
## block under the camera (MapmWater.environment_at has the READ chain), one
## record for the whole world. Checked on the zone label's throttle; a change
## hands the day cycle the block's record, which it eases to over ~2 s (READ:
## Map::FUN_00a1baf0's dt x 0.5) rather than snapping (round 786; before, a
## change re-sampled channel 14 alone into the water).
func _water_env_tick() -> void:
	if _environment_table == null or _dungeon != null:
		return
	var cam := get_viewport().get_camera_3d() if get_viewport() != null else null
	if cam == null:
		return
	var pair := _nav_graph_for(cam.global_position)
	if pair.is_empty():
		return
	var group: Node3D = pair[1]
	if not group.has_meta("block_env_ids"):
		return
	var local := group.to_local(cam.global_position)
	var env_id := MapmWater.environment_at(group.get_meta("block_env_ids"), local.x, local.z)
	if env_id < 0 or env_id == _env_record_id:
		return
	for rec in _environment_table.records:
		if rec.key == env_id:
			_env_record = rec
			_env_record_id = env_id
			_water_env_id = env_id
			_day_cycle.set_record(rec)
			print("World3D: the environment follows the camera's block: environment %d (%s), eased in" % [env_id, rec.name1])
			return

## The environment's WaterColor (MapmWater.set_water_color clamps it). White
## until an environment is applied -- the neutral fallback
## sample_color_channel already uses, not a colour anyone read.
var _env_water_color := Color(1, 1, 1)

func _water_surface_material(anim: AnimatedTexture) -> StandardMaterial3D:
	if _water_material == null:
		_water_material = MapmWater.water_material(anim, _env_water_color)
	return _water_material

func _water_still_surface_material(tex: Texture2D) -> StandardMaterial3D:
	if _water_still_material == null:
		_water_still_material = MapmWater.still_material(tex)
	return _water_still_material

## A region's real `.nvm` read and parsed, uncached -- the terrain
## prepare's read (round 565; the cache it fills is _grid.navmesh_cache,
## dropped with the region since round 563), which runs on a
## WorkerThreadPool task and so reports through `lines` ([["out"|"err",
## line]], printed by the commit) instead of printing. Null with no
## Data.pk2, no file or no parse.
static func _read_region_navmesh(archive: Pk2Reader, key: int, lines: Array) -> NvmReader.ParsedRegion:
	if archive == null:
		return null
	var nvm_path: String = NAVMESH_PATH_FORMAT % key
	var bytes := AssetSource.read_bytes(nvm_path, archive)
	if bytes.is_empty():
		lines.append(["out", "World3D: no real navmesh at %s -- this region gets no real walkability or water" % nvm_path])
		return null
	var parsed := NvmReader.parse(bytes)
	if parsed == null:
		lines.append(["err", "World3D: could not parse real navmesh at %s" % nvm_path])
		return null
	return parsed

## Prints what a job (or a reader called on its behalf) logged, in order:
## `["out", line]` to stdout, `["err", line]` to stderr.
static func _print_job_log(lines: Array) -> void:
	for line in lines:
		if line[0] == "err":
			printerr(line[1])
		else:
			print(line[1])

## Real walkable graphs, one per loaded region, live in _grid.nav_graphs as
## [NavGraph, Node3D] by region -- the graph plus the node whose own local
## space *is* that region's real coordinate space, so converting between the
## two is done with the node's real transform rather than by re-deriving the
## region placement (and its mirror) by hand. Read through
## _grid.nav_graph_pairs() and _nav_graph_for_region; a region's pair goes
## with its unload (round 563).

## Builds the real walkable graph for a region: its terrain `.nvm` plus every
## real object that `.nvm` lists, each resolved to its own real navigation
## mesh. See NavGraph for how objects attach to a region and why this is data
## rather than collision shapes.
##
## Part of the terrain prepare since round 565 (it was
## `_build_region_nav_graph`, on the main thread): NavGraph.place and
## NavGraph.build are plain GDScript over RefCounted data, and every input is
## in the job -- the navmesh, Data.pk2 behind its lock, the object index and
## a copy of the object navigation meshes already loaded. Sets `nav_graph`
## (null with no navmesh), `used_collisions` (every object id the navmesh
## lists -> its mesh or null, for the commit to put back in
## _grid.object_collision_cache: an unload elsewhere may have pruned one
## while this ran) and `nav_log`, the lines the commit prints once the graph
## is registered.
static func _prepare_nav_graph(job: Dictionary) -> void:
	var region: NvmReader.ParsedRegion = job.get("navmesh")
	var used := {}
	var parsed := {}
	var lines: Array = []
	job["nav_graph"] = null
	job["used_collisions"] = used
	# The ids of `used` this prepare read from the archive rather than found
	# in the job's snapshot -- what _prepared_again counts (round 566's
	# review).
	job["parsed_collisions"] = parsed
	job["nav_log"] = lines
	if region == null:
		return
	var mapm_path: String = job["mapm_path"]
	var archive: Pk2Reader = job["data_pk2"]
	var cache: Dictionary = job["collisions"]
	var placed: Array[NavGraph.PlacedObject] = []
	var missing := 0
	var missing_names := {}
	if archive != null and not region.objects.is_empty():
		var table: ObjidxReader.Table = job["object_index"]
		if table != null:
			for oi in range(region.objects.size()):
				var obj: NvmReader.MapObject = region.objects[oi]
				if not cache.has(obj.resource_id):
					parsed[obj.resource_id] = true
				var collision := _load_object_collision(cache, archive, table, obj.resource_id)
				used[obj.resource_id] = collision
				if collision == null:
					missing += 1
					# Naming them matters: an object with no navigation mesh
					# is one the player can stand *inside*, and "8 objects
					# unresolved" gives no way to tell whether those eight
					# are decorative shrubs or the plaza the town square is
					# built on.
					var missing_entry := table.lookup(obj.resource_id)
					if missing_entry != null and missing_entry.path != "":
						missing_names[missing_entry.path.get_file().get_basename()] = true
					continue
				var placed_object := NavGraph.place(collision, oi, obj.local_position, obj.yaw)
				# Tagged with the real model it came from purely so that a
				# report of what the player is standing on can name it --
				# see _qa_step's position line.
				var entry := table.lookup(obj.resource_id)
				if entry != null and entry.path != "":
					placed_object.set_meta("model", entry.path.get_file().get_basename())
				placed.append(placed_object)
	var graph := NavGraph.build(region, placed)
	job["nav_graph"] = graph
	lines.append(["out", "World3D: real walkable graph for %s -- %d/%d real objects placed, %d real terrain blocking edges" % [
		mapm_path, placed.size(), region.objects.size(), graph.terrain_blocking.size() / 2]])
	if missing > 0:
		lines.append(["out", "World3D:   (%d real objects in that region could not be resolved to a navigation mesh: %s)" % [
			missing, ", ".join(PackedStringArray(missing_names.keys()))]])

## Cache of real object navigation meshes by real resource ID, since a region
## repeats the same handful of real object types across many placements.
## Held in _grid.object_collision_cache; an unload prunes the ids no cached
## navmesh lists any more (round 563). Static over an explicit `cache` since
## round 565: the terrain prepare runs it on a WorkerThreadPool task against
## its job's copy of that cache, and the commit merges what it loaded back.
static func _load_object_collision(
	cache: Dictionary, archive: Pk2Reader, table: ObjidxReader.Table, resource_id: int
) -> BmsReader.CollisionMesh:
	if cache.has(resource_id):
		return cache[resource_id]
	cache[resource_id] = null
	var entry = table.lookup(resource_id)
	if entry == null:
		return null
	# The one mesh the client's own map loader reads (round 644, READ):
	# the `.bsr`'s header word 0x28 names it, and its collision section is
	# the object's navigation mesh -- see NavObjectSource. Rounds 505-643
	# merged the collision sections of every mesh the `.bsr` lists instead;
	# over the 3,268-entry navigation index that agreed on 2,039 objects and
	# differed on 4 (NavObjectSource.load_collision names them).
	var collision := NavObjectSource.load_collision(archive, entry.path)
	cache[resource_id] = collision
	return collision

## The real walkable graph covering the player, as [NavGraph, Node3D], or an
## empty Array when the player is not over any region that has one.
## The real object index that resolves a placement's type ID to its real
## .bsr path, preferring Map.pk2's own table over Data.pk2's -- see
## MAP_OBJECT_INDEX_PATH for why they differ and why the map's wins.
## Cached: every region load needs it, and it is a quarter-megabyte parse.
var _object_index_cache: ObjidxReader.Table = null
var _object_index_load_attempted := false
## The seasonal event pieces this world leaves out (round 583): type id ->
## set name, built once per object index by _seasonal_hidden_for.
var _seasonal_hidden: Dictionary = {}
var _seasonal_hidden_table: ObjidxReader.Table = null

func _load_object_index() -> ObjidxReader.Table:
	if _object_index_load_attempted:
		return _object_index_cache
	_object_index_load_attempted = true

	var bytes := PackedByteArray()
	var source := MAP_OBJECT_INDEX_PATH
	var map_archive := _open_map_pk2_if_set()
	if map_archive != null:
		bytes = AssetSource.read_bytes(MAP_OBJECT_INDEX_PATH, map_archive)
	if bytes.is_empty():
		var data_archive := _open_pk2_if_set()
		if data_archive != null:
			bytes = AssetSource.read_bytes(OBJECT_INDEX_PATH, data_archive)
			source = OBJECT_INDEX_PATH
	if bytes.is_empty():
		printerr("World3D: could not find a real object index (tried Map.pk2's %s and Data.pk2's %s)" % [
			MAP_OBJECT_INDEX_PATH, OBJECT_INDEX_PATH])
		return null

	_object_index_cache = ObjidxReader.parse(bytes)
	if _object_index_cache == null:
		printerr("World3D: could not parse the real object index at ", source)
	else:
		print("World3D: loaded real object index (%d real entries) from %s" % [
			_object_index_cache.entries.size(), source])
	return _object_index_cache

func _nav_graph_for(world_position: Vector3) -> Array:
	# nav_graph_pairs() has already skipped a freed group. At BASE the list
	# kept an unloaded region's pair, and the typed assignment below raised
	# `Trying to assign invalid previously freed instance` on it and aborted
	# this function on every tick, for every region loaded after it (round
	# 563's baseline tour: 687 such errors, the player `off-region` for the
	# rest of the run). The unload now drops the pair as well.
	for pair in _grid.nav_graph_pairs():
		var group: Node3D = pair[1]
		# A dungeon's one graph covers the whole dungeon (round 773).
		if (pair[0] as NavGraph).dungeon:
			return pair
		var local := group.to_local(world_position)
		if local.x < 0.0 or local.z < 0.0 or local.x > REGION_SPAN or local.z > REGION_SPAN:
			continue
		return pair
	return []

## The [graph, group] pair for a named region, or [] if it is not loaded.
## _nav_graph_for finds the region under a world position; this finds one by
## the identity the real tables use (npcpos gives a region id and a local
## position, never a world one), which is what lets a QA probe ask about a
## region the player is not standing in.
func _nav_graph_for_region(region_x: int, region_y: int) -> Array:
	return _grid.nav_graph_for_region(region_x, region_y)

##
## Two halves since round 565: `_prepare_navmesh_walls` builds the triangles
## (NvmCollision, plain data) in the terrain prepare, on a WorkerThreadPool
## task for a streamed cell; `_add_navmesh_walls` builds the shape and the
## body from them in the commit, on the main thread.
static func _prepare_navmesh_walls(job: Dictionary) -> void:
	var region: NvmReader.ParsedRegion = job.get("navmesh")
	job["wall_faces"] = PackedVector3Array()
	job["solid_plane_faces"] = PackedVector3Array()
	if region == null:
		return
	job["solid_plane_faces"] = NvmCollision.solid_plane_faces(region)
	var faces := NvmCollision.build_wall_triangles(region, NAVMESH_WALL_HEIGHT)
	job["wall_faces"] = faces
	job["wall_line"] = "World3D: loaded real navmesh walls for %s (%d real blocking of %d internal + %d global edges)" % [
		job["mapm_path"], NvmCollision.blocking_edges(region).size(), region.internal_edges.size(), region.global_edges.size()]

## Round 744: the region's solid planes (NvmCollision.solid_plane_faces --
## Karakoram's frozen lake, whose `.nvm` blocks carry SOLID_PLANE_BIT) as a
## body on the terrain layer, so what is under a click, the camera's arm and
## every terrain ray (TerrainCollision.vertical_ray: the snap, monster and
## ground-item placement) stop at the ice the walk stands on
## (NvmCollision.terrain_height, READ) rather than at the lakebed under it.
## Two-sided: the terrain group's mirrored z flips the faces' winding. That the
## original's pick hits the plane is OURS -- its pick was not read; its height
## query's rule is.
func _add_solid_planes(terrain_group: Node3D, job: Dictionary) -> void:
	var faces: PackedVector3Array = job.get("solid_plane_faces", PackedVector3Array())
	if faces.is_empty():
		return
	var shape := ConcavePolygonShape3D.new()
	shape.backface_collision = true
	shape.set_faces(faces)
	var body := StaticBody3D.new()
	body.name = "SolidPlanes"
	body.collision_layer = TERRAIN_COLLISION_LAYER
	var body_shape := CollisionShape3D.new()
	body_shape.shape = shape
	body.add_child(body_shape)
	terrain_group.add_child(body)
	print("World3D: %d solid plane block(s) (ice) for %s" % [faces.size() / 6, job["mapm_path"]])

## Adds this region's real navmesh walls: every real blocking edge in its
## `.nvm` cell/edge graph, extruded into a vertical quad by NvmCollision.
##
## This is real *walkability*, which the terrain mesh's own geometric
## collision does not reproduce -- it is the boundary the real game
## actually enforces, and it exists in places no geometry does.
##
## Parented to terrain_group rather than positioned itself, so it inherits
## that node's own rotation and vertical anchoring exactly. The wall
## triangles are built in the same region-local space the terrain mesh uses
## (MapmTerrainBuilder's col -> X, row -> Z): the two formats share a
## byte-identical heightmap, and the local-axis correspondence is measured
## rather than assumed -- see docs/protocol/NVM_FORMAT.md's "Real
## local-axis orientation" section.
##
## Does nothing (and says so) when Data.pk2 isn't set or the region has no
## real navmesh file -- the same honest "nothing to load" behavior as the
## rest of this scene, never a guess.
func _add_navmesh_walls(terrain_group: Node3D, job: Dictionary) -> void:
	var faces: PackedVector3Array = job["wall_faces"]
	if faces.is_empty():
		return
	var shape := ConcavePolygonShape3D.new()
	shape.set_faces(faces)
	var body := StaticBody3D.new()
	body.name = "NavmeshWalls"
	body.collision_layer = NAVMESH_WALL_COLLISION_LAYER
	var body_shape := CollisionShape3D.new()
	body_shape.shape = shape
	body.add_child(body_shape)
	terrain_group.add_child(body)
	if OS.get_environment("OPENSRO_DEBUG_NAVMESH_WALLS") != "":
		_add_navmesh_wall_debug_mesh(terrain_group, faces)
	print(job["wall_line"])

## Draws the walls _add_navmesh_walls just built, so they can actually
## be looked at. They are deliberately invisible in normal play -- they are
## walkability, not scenery -- which also means a misplaced one is
## impossible to see, and misplacement is exactly the failure this
## project's own headless checks have repeatedly missed. Gated behind
## OPENSRO_DEBUG_NAVMESH_WALLS so it costs a normal run nothing.
func _add_navmesh_wall_debug_mesh(terrain_group: Node3D, faces: PackedVector3Array) -> void:
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = faces
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(1.0, 0.1, 0.1, 1.0)
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	# Walls are single-sided quads, so without this each one vanishes when
	# viewed from the far side -- which would read as a missing wall.
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	var debug_mesh := MeshInstance3D.new()
	debug_mesh.name = "NavmeshWallsDebug"
	debug_mesh.mesh = mesh
	debug_mesh.material_override = mat
	terrain_group.add_child(debug_mesh)
	var local_aabb := mesh.get_aabb()
	print("World3D: navmesh wall debug mesh local aabb %s .. %s, global origin %s" % [
		local_aabb.position, local_aabb.end, debug_mesh.to_global(local_aabb.position)])

## A region's water, from its own `.m` blocks (round 627; MapmWater has the
## rules and their labels). Until round 627 it came from the `.nvm` plane
## map, with each quad's shape taken from the navmesh tiles' texture type,
## and its triangles faced down under a material that culled back faces, so
## a lake was a sheet seen only from underneath (the v0.1.457 report at
## 98/159, plane 50 over a bed at -30). The `.nvm` plane map also marks water
## in 3,846 blocks the `.m` says have none, and leaves out 6,259 the client
## draws (MEASURED, waterat -census) -- the `.m` is what the client reads.
func _try_add_real_water(terrain_group: Node3D, region: MapmReader.ParsedRegion, mapm_path: String) -> void:
	# OPENSRO_QA_NOWATER=1 (round 648): build no water at all, so a pixel
	# diff against a normal run measures exactly what the water draws.
	if OS.get_environment("OPENSRO_QA_NOWATER") != "":
		return
	var coords := _parse_region_coords(mapm_path)
	if not coords.is_empty():
		var region_id := RegionGridState.navmesh_key(int(coords["x"]), int(coords["y"]))
		if not MapmWater.draws_block_water(region_id):
			print("World3D: %s -- region id 0x%04x is a dungeon id: retail draws no block water there" % [mapm_path, region_id])
			return
	# The environment the water's colour follows (_water_env_tick).
	terrain_group.set_meta("block_env_ids", MapmWater.block_environment_ids(region))
	var built := MapmWater.build(region)
	if built.water == null and built.still == null:
		if built.dry_blocks > 0:
			print("World3D: %s -- no water drawn (%d PlaneType-0 block(s), every vertex dry)" % [mapm_path, built.dry_blocks])
		return
	var archive := _open_map_pk2_if_set()
	if archive == null:
		return
	var heights: Array = built.heights.keys()
	heights.sort()
	# The facing is Godot's own front-face rule on the built triangles (the
	# group's z mirror does not change it: Godot flips its cull test for a
	# negative determinant), printed so a run measures it instead of a picture.
	var facing := MapmWater.facing_counts(built.water) + MapmWater.facing_counts(built.still)
	print("World3D: %s -- water: %d animated block(s) (%d fully deep, one quad each), %d still, %d dry skipped, plane height(s) %s, triangles %d up / %d down" % [
		mapm_path, built.water_blocks, built.deep_blocks, built.still_blocks, built.dry_blocks, str(heights), facing.x, facing.y])
	if _water_reflection_on and _water_reflection != null:
		# Round 628: retail's reflection pass (WaterReflection). The frames
		# are not used there (READ); water201 still is, for PlaneType 1.
		var bump := _load_water_bump(archive)
		var still_tex := _load_still_water_texture(archive) if built.still != null else _water_still_texture
		if _water_reflect_material == null:
			_water_reflect_material = _water_reflection.make_material(false, bump, still_tex, _env_water_color)
		if built.still != null and _water_reflect_still_material == null:
			_water_reflect_still_material = _water_reflection.make_material(true, bump, still_tex, _env_water_color)
		_water_reflection.register_region(terrain_group, built.drawn)
		if built.water != null:
			_add_water_instance(terrain_group, "Water", built.water, _water_reflect_material)
		if built.still != null:
			_add_water_instance(terrain_group, "WaterStill", built.still, _water_reflect_still_material)
		return
	if built.water != null:
		var anim := _load_real_water_animation(archive)
		if anim != null:
			_add_water_instance(terrain_group, "Water", built.water, _water_surface_material(anim))
	if built.still != null:
		var tex := _load_still_water_texture(archive)
		if tex != null:
			_add_water_instance(terrain_group, "WaterStill", built.still, _water_still_surface_material(tex))

## The water reflection's copy of a region's terrain (round 628 review): the
## same mesh on the mirror-only layer, each surface's material swapped for
## WaterReflection.clip_material's, which discards below (or above) the
## water plane as retail's user clip plane does. The main view's terrain is
## untouched.
func _add_mirror_terrain(terrain_group: Node3D, patch: MeshInstance3D) -> void:
	if not _water_reflection_on or _water_reflection == null or patch.mesh == null:
		return
	var mirror := MeshInstance3D.new()
	mirror.name = "MirrorTerrain"
	mirror.mesh = patch.mesh
	mirror.layers = WaterReflection.MIRROR_TERRAIN_BIT
	mirror.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	for i in range(patch.mesh.get_surface_count()):
		var src: Material = patch.material_override if patch.material_override != null else patch.mesh.surface_get_material(i)
		if src != null:
			mirror.set_surface_override_material(i, _water_reflection.clip_material(src))
	terrain_group.add_child(mirror)

