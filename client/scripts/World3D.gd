extends Node3D

## The one real client scene, reached directly from CharacterSelect.gd: a
## player-controlled CharacterBody3D moving over a placeholder flat ground,
## synced to the server over OpMove/OpEntityEntered/OpEntityMoved/
## OpEntityLeft. Other connected characters render as simple labeled
## capsules at their real, server-authoritative positions, or a real
## assembled character if real game data is loaded (see below). Its full
## UI (chat, monsters/combat, inventory, equipment, quests, shop, party,
## guild, duel, trade, friends) was ported here from the original 2D
## World.tscn, which has since been deleted -- see docs/PROGRESS.md.
##
## The ground is a placeholder collision box by default, but both its
## *visual* mesh and its *collision* shape are replaced by real terrain if
## you set OPENSRO_MAPM_PATH to a real Map.pk2 region .m file (see below)
## -- .mapm's grid width (17) is now a real, mechanistically confirmed
## constant (see docs/protocol/MAPM_FORMAT.md and MapmTerrainBuilder), not
## the unresolved blocker it used to be. The real collision shape is a
## HeightMapShape3D over the same real 97x97 height grid the visual mesh is
## built from, split into the mesh's own triangles (TerrainCollision, round
## 567; a ConcavePolygonShape3D of the mesh's triangles until then, still
## built under OPENSRO_TERRAIN_TRIMESH=1 for A/B), so the player physically
## walks on the actual real terrain surface, not a flat box, whenever real
## terrain data loads.
## The terrain's real world position/scale relative to a player's actual
## spawn coordinate is still unconfirmed -- it's placed near the player for
## visibility, not at a confirmed real-world offset. Other entities are
## still labeled capsules -- there's no confirmed mapping from a
## server-side character to
## a specific real asset (this project's server doesn't track a
## race/gender/equipment loadout per character yet), so every *other*
## player shows the same placeholder regardless of who they really are.
##
## The *player's own* body is no longer a placeholder if you point this
## project at your own real game data (this project ships with none --
## BYO, see docs/LEGAL.md): set OPENSRO_PK2_PATH to a real Data.pk2 and
## OPENSRO_MEDIA_PK2_PATH to a real Media.pk2, and the character is
## assembled the way the game assembles it. The body is a row of
## characterdata (`CHAR_CH_MAN_FIGHTER` -> `char\china\chinaman_fighter.bsr`,
## see GENDER_BODY_CODE), a `.bsr` naming the skeleton, nine skinned body
## pieces, the material and 217 animations. What it wears is the server's
## word: each equipped slot's item id is looked up in the item table for the
## model that item is worn as (column 52, `item\china\man_item\
## clothes_01_ba.bsr` for the Cotton Suit), and that `.bsr` says how it
## hangs -- weighted onto the body's bones, or on a skeleton of its own
## under one named body bone (a blade on `Bip01 R HandMid`, a shoulder
## piece on `Bip01 Neck1`). See docs/protocol/ITEM_FORMAT.md.
##
## A newly-created character wears the starting kit the server gave it;
## an item whose id the table does not know is left undrawn rather than
## stood in for. Falls back to the placeholder capsule if the body itself
## cannot be built.
##
## Other connected players are dressed the same way from the same data:
## their gender and every worn item's id come in each EntitySnapshot
## (OpEnterWorldResult/OpEntityEntered, queried live from the equipment
## store -- see equippedItems in server/internal/session/world.go).
##
## OPENSRO_PK2_PATH + OPENSRO_BSR_PATH also loads one real, textured
## static scenery object nearby via ObjectLoader, and
## OPENSRO_BSK_PATH + OPENSRO_BAN_PATH loads a real animated decoration
## skeleton (its own separate .bsk/.ban pair, not the player's body) via
## Skeleton3DBuilder -- both accept either a loose file path or a path
## inside OPENSRO_PK2_PATH (see AssetSource). OPENSRO_MAPM_PATH loads real
## terrain (a real Map.pk2 region's .m file, e.g. "100\\100.m") via
## MapmTerrainBuilder -- Map.pk2 is a separate archive from Data.pk2 in a
## real retail install, so it accepts either a loose file or a path inside
## OPENSRO_MAP_PK2_PATH (its own separate pk2 env var, not
## OPENSRO_PK2_PATH). OPENSRO_MAPM_TEXTURE_PATH additionally textures that
## terrain with a real per-region minimap image (e.g. "minimap\\100x100.ddj",
## matching the same region number as OPENSRO_MAPM_PATH) -- these live in
## Media.pk2, a third separate archive, so it accepts either a loose file or
## a path inside its own OPENSRO_MEDIA_PK2_PATH. Falls back to real
## per-tile vertex-color variation (see MapmTerrainBuilder) if unset -- no
## real-time 3D ground-texture system has been found yet (see
## docs/protocol/MAPM_FORMAT.md), so a region's own real minimap art is the
## closest real, region-accurate substitute currently available.
## OPENSRO_MAPO_PATH loads real placed objects (a real Map.pk2 region's
## .o file, e.g. "0\\0.o", via OPENSRO_MAP_PK2_PATH) and renders each with
## its real resolved .bsr model -- not a placeholder marker -- via a real
## type-ID-to-resource-path lookup (a real, root-level "object.ifo" file
## inside OPENSRO_PK2_PATH's Data.pk2, see docs/protocol/MAPO_FORMAT.md
## for how this was found; it was a confirmed dead end earlier in this
## project). OPENSRO_SYNC_LOAD=1 (round 565, kept for one release as an
## escape hatch) builds every streamed cell's terrain and objects on the main
## thread on the pre-round-565 schedule instead of preparing them on
## WorkerThreadPool tasks (_threaded_load, _terrain_prepare,
## _objects_prepare) -- the schedule only: both still run their split
## prepare and commit halves, back to back. OPENSRO_TERRAIN_TRIMESH=1 (round
## 567, kept for A/B) gives each region's terrain the trimesh collision it had
## until round 567 -- a ConcavePolygonShape3D of every triangle of the drawn
## mesh (MapmTerrainBuilder.surface_faces) -- instead of the heightfield
## (TerrainCollision). OPENSRO_SEASONAL (round 583) is a comma list of the
## seasonal event decoration sets to draw -- christmas, halloween, obt,
## summer -- which are otherwise left out of every region (SeasonalObjects;
## the settings file's `[world]` `seasonal="..."`, quoted, adds to it). Any variable left unset is skipped gracefully (a printed hint, not an error)
## -- this scene works fine with none of them set, same as always.
##
## The server now has a real multi-zone concept: OpChangeZone/
## OpChangeZoneResult (NetClient.change_zone/change_zone_result) let a
## character warp between zone labels. This scene reacts to a successful
## change (_on_change_zone_result): it tears down whatever real
## terrain/map-object nodes are currently loaded ("RealTerrain"/
## "RealMapObjects") and reloads them for the new zone, via _zone_paths --
## a zone label shaped like this project's real Map.pk2 region naming
## ("<x>/<y>", e.g. "100/100") resolves to that region's real internal
## paths ("100\\100.m", "100\\100.o", "minimap\\100x100.ddj"), the same
## convention OPENSRO_MAPM_PATH/OPENSRO_MAPO_PATH's doc comments above
## already describe. The server's own default spawn zone, "jangan", is a
## special case resolved by _resolve_zone_region to the real region this
## project found Jangan actually lives in (JANGAN_ZONE_REGION: "97/168", the
## town, since 2026-09-07; this header said "98/168" -- the palace north of
## it, the pick as of **2026-09-01** -- until round 574. See that constant's
## own doc comment for the real back-and-forth: an earlier, higher-*keyword-
## density* match ("89/182") turned out to be a real, confirmed isolated
## pocket surrounded by void, which dropped the player through an unbounded
## fall when walked into; "98/168" sits inside the same real, single, fully
## contiguous landmass as 98/157, which this header called "the
## already-verified Dunhuang region" until round 574 -- textzonename.txt
## names 98/157 "Donwhang Ferry", and Donwhang itself is 102/153 since round
## 569, DUNHUANG_ZONE_REGION) rather than falling through to
## "nothing to load" the way it used to before Jangan was found at all. Any
## other zone not shaped like a real region still clears back to
## the placeholder ground with nothing loaded -- honest "nothing to load",
## not a guessed path. The *initial* load in _ready() still reads the raw
## env vars directly rather than going through a zone label, since the very
## first EnterWorldResult's zone isn't available yet at that point.

## **Rescaled 2026-08-26** (see docs/WORLD_ISSUES.md's "size of ants" entry):
## every player-relative constant below (movement, camera, click-to-move,
## network-send thresholds, the placeholder capsule) used to be tuned
## around a fixed, invented 1.8-unit character height that was never
## checked against the real environment's own native scale. A real
## measurement (forward-kinematics over a real chinaman_skel.bsk's real
## bind-pose bones) found the real native character height is ~138.7
## units -- the same real order of magnitude as real measured building
## features (walls ~44.5, doors ~72-76, trees ~97-140), which all already
## render unscaled. PLAYER_SCALE_RATIO (real 138.7 / old 1.8) rescales
## every one of these constants by the same factor, preserving their
## previously-tuned *feel* relative to the character's own height rather
## than guessing new values at the new scale.
## Real, confirmed bug (2026-09-01, see docs/WORLD_ISSUES.md): the placeholder
## Ground body and every real terrain patch's collision both defaulted to
## Godot's default collision_layer (bit 1), the same layer every real
## placed-object (.bsr building) collision body also defaults to in
## ObjectLoader -- nothing distinguished "the actual ground" from "the roof
## of a tall building standing on that ground" to a raycast that just takes
## whichever surface it hits first from high above. Since the real fixed
## server spawnPos (0,0,0) can land under/inside a real building (already
## known, see _avoid_spawning_under_roof's own doc comment), a tall real
## structure sitting exactly at the spawn X/Z meant the very first
## ground-snap raycast in _snap_player_onto_terrain hit that building's
## real roof, not the real ground beneath it -- spawning the player on top
## of a tower instead of on the ground, a real bug _avoid_spawning_under_roof
## can't catch (it only checks for a real ceiling *above* an
## already-landed position, not whether "landed" means "on a roof" in the
## first place). Fixed by giving terrain collision its own dedicated layer
## bit (kept alongside the default layer 1, so every other real collision
## check -- movement, click-to-move, camera collision -- is unaffected) and
## having the initial ground-snap ray target only that bit.
const TERRAIN_COLLISION_LAYER := 0b1001 # layer 1 (default) + layer 4 (terrain-only)
const TERRAIN_ONLY_COLLISION_MASK := 0b1000 # layer 4 only

## Real navmesh walls (see _add_navmesh_walls) get their own layer bit,
## deliberately *not* the default layer 1, because they are invisible
## gameplay boundaries rather than visible geometry. The player's own body
## masks this bit in (World3D.tscn), so they are stopped by them; the camera
## spring arm does not, because a camera shoved aside by geometry nobody can
## see reads as a bug, and it is the same class of mistake the terrain layer
## above was added to fix.
const NAVMESH_WALL_COLLISION_LAYER := 0b10000 # layer 5 only

## An NPC's own body.
##
## Standing NPCs were walk-through: they are a Skeleton3D under a Node3D and
## nothing else, so a player crossing Jangan's square passed straight
## through the merchants. The capsule below is sized from the model's own
## geometry -- these models differ enormously, and one radius that suits a
## merchant swallows a horse.
##
## **Layer 5, the same bit the navmesh walls use**, because the player's
## body masks it (`collision_mask = 17` in World3D.tscn) and the camera arm
## does not (`collision_mask = 1`). That is precisely what an NPC wants: it
## stops you walking into it, and it does not shove the camera around every
## time you stand in a crowd of them. Putting them on the default layer 1
## instead would have made Jangan's square unusable to look at.
const NPC_COLLISION_LAYER := NAVMESH_WALL_COLLISION_LAYER
## Monsters sit on their own layer so a click can pick one out to attack it
## without a monster blocking movement or catching the ground-snap ray.
const MONSTER_COLLISION_LAYER := 0b100000 # layer 6 only
## Another player's click body (round 622), on its own layer (8; 7 is the
## ground items'), so a click can select that player -- the target a heal or
## a party buff is cast at -- without blocking movement or any other ray.
const OTHER_PLAYER_COLLISION_LAYER := 0b10000000 # layer 8 only
## The player's OWN click body (round 622's review), on its own layer (9), so
## only a pick that includes the player -- Shift held, retail's include-self
## flag -- ever hits it.
const SELF_CLICK_COLLISION_LAYER := 0b100000000 # layer 9 only

## Smallest capsule an NPC gets, in world units, so a model whose bones all
## sit near the origin still stops someone.
const NPC_MIN_RADIUS := 0.25
const NPC_MIN_HEIGHT := 1.0

## How tall a real blocking navmesh edge is extruded. **A disclosed choice,
## not real data**: the real client tests an edge as an infinite 2D line
## (see docs/protocol/NVM_FORMAT.md's "Edge flag semantics" section), so
## nothing in the game gives a wall a height at all. Comfortably above the
## player capsule's own 3.19 radius so it cannot be stepped over.
const NAVMESH_WALL_HEIGHT := 40.0

## Real per-region navmesh inside Data.pk2, named by the real packed region
## ID -- this is the client's own real format string, recovered from its
## loader (`sprintf_s(buf, 0x400, "navmesh\\nv_%04x.nvm", regionId)`), and
## the real packing is `(x << 8) | y`. See docs/protocol/NVM_FORMAT.md.
const NAVMESH_PATH_FORMAT := "navmesh\\nv_%04x.nvm"

## Real region-to-zone name table. Really does live in Data.pk2's shader
## folder rather than anywhere map-shaped -- see
## docs/protocol/REGIONINFO_FORMAT.md.
const REGIONINFO_PATH := "Shader\\regioninfo.txt"

## **Corrected 2026-09-02** (see docs/WORLD_ISSUES.md's forty-eighth
## round): was `138.7 / 1.8`. The 138.7 came from an earlier claimed
## forward-kinematics measurement of the real character's native height,
## but that figure is simply wrong -- two independent runtime measurements
## of the *actually assembled* real character (its real skeleton's own
## bind-pose bone extent, and the real world-space AABB of every mesh
## attached to it) both come out at **14-16 units**, not 138.7. Everything
## derived from this ratio (camera distance, move speed, gravity,
## click-to-move thresholds, the placeholder collision capsule) was
## therefore scaled roughly 10x too large, which is what made the real
## character render as a distant speck: the camera was parked ~8 character
## heights away.
##
## Now derived from the real measured height instead of a wrong constant.
## 1.8 stays as the notional "human metres" denominator the movement/camera
## feel was originally tuned against, so those tunings keep their intended
## proportion to the character rather than being re-guessed.
##
## **Honest open question, deliberately not guessed at**: real map objects
## measured alongside this (a real chair 12.5 units, table 10.8, standing
## lamp 19.9, guardian lion statue 29.0) are self-consistent with each
## other but make a 14.3-unit character read as roughly chair-height --
## short for an adult. That suggests the real client may apply its own
## character scale factor this project hasn't found yet. No such factor is
## invented here; this constant only corrects a provably wrong measurement.
const REAL_CHARACTER_NATIVE_HEIGHT := 14.34
const PLAYER_SCALE_RATIO := REAL_CHARACTER_NATIVE_HEIGHT / 1.8
## The player's run speed, in world units per second, READ from the
## character table at load (round 231): characterdata column 47 (`Speed2`) of
## the player's body row -- 50 for every playable row -- applied exactly as
## the server applies it (see NpcTableReader.COL_SPEED_RUN for the chain:
## record word -> walk/run slots -> live speed -> position += dir * speed *
## seconds). MOVE_SPEED_FALLBACK is the old feel tuning (6 "human metres" per
## second scaled to the character, about 47.8), used only when no table is
## loaded, and disclosed as such.
const MOVE_SPEED_FALLBACK := 6.0 * PLAYER_SCALE_RATIO
var _move_speed := MOVE_SPEED_FALLBACK
const GRAVITY := 20.0 * PLAYER_SCALE_RATIO

## How high a step the player can walk up, as a fraction of their own real
## capsule height (so it scales with the character rather than being a bare
## number). 0.22 of the real 14.34 capsule is 3.15 units.
##
## **Sized against the real architecture, measured, not picked.** Three real
## staircase assets were loaded and their own tread heights read off:
## `guil_jang_stair01_01` (median riser 3.05), `jang_guild_buil01_stair01`
## and `cj_mili_horstair` (3.00 each, with real tread levels at 2.75, 5.75,
## 8.8, 11.8, 14.75, 17.75, 20.75...). So a **real riser is 3.0 units**, and
## this clears it with a little margin while staying well under anything
## wall-shaped. That the real risers are a fifth of the real character's own
## height also says the character is not mis-scaled against the world, which
## had been a live suspicion.
##
## That there is a step height *at all* is still a disclosed approximation.
## The real client has none, because it never collides with stair geometry:
## it walks the real navmesh cell/edge graph and takes its height from there
## (see docs/protocol/NVM_FORMAT.md). Real raised surfaces are carried by
## the real `.nvm`'s own `MapObject` entries -- per-object walkable meshes
## `NvmReader` already parses but nothing uses yet. Reproducing that is the
## faithful fix; until it exists, a physics character needs some step height
## or real stairs are simply unclimbable.
const STEP_HEIGHT_FRACTION := 0.22

## Real Silkroad-style mouse controls: right-drag orbits the camera around
## the player (independent of the player's own facing), left-click on the
## ground walks the player there, and the scroll wheel zooms. No key moves
## the character (round 608: the retail defaults walk by clicking; KeyMap).
## Radians of turn per pixel of drag: 0.005 (READ, round 778; RetailCamera
## has the address), carried here in degrees because the arm is driven in
## degrees. Was 0.3 (ours) until round 778.
const CAMERA_ORBIT_SENSITIVITY := RetailCamera.DRAG_DEGREES_PER_PIXEL # degrees of camera rotation per pixel of mouse drag
## Sign convention (2026-08-26, MEASURED by a headless SpringArm3D probe):
## the camera sits at the arm's local *+Z*, so a *negative* CameraArm pitch
## lifts the camera above and behind the player and a positive one drops it
## below, looking up. The arm's pitch is the negative of the original's.
## Round 778 (READ, RetailCamera.PITCH_LIMIT): the original turns its pitch
## between -1.0708 and +1.0708 radians, so the camera looks down at most 61.35
## degrees and UP at most 61.35 degrees. Until round 778 this was -80..-10
## (ours): it could look down nearly straight but never up at all.
const CAMERA_PITCH_MIN_DEGREES := -RetailCamera.PITCH_LIMIT_DEGREES
const CAMERA_PITCH_MAX_DEGREES := RetailCamera.PITCH_LIMIT_DEGREES
## One wheel notch: 6 units (READ, round 778: delta 120 / 20.0 in
## CGInterface::vslot_036). Was 15 (ours).
const CAMERA_ZOOM_STEP := RetailCamera.ZOOM_STEP
## The zoom's range, world units: 10..150 (READ, round 778: the floats at
## 0xd81a88 and 0xdb8d74). Was 20..90 until round 778 -- an openly declared
## framing choice made when "no real camera-distance data had been found"
## (the fifty-fifth round); the binary has it. Looking up pulls the camera in
## further (RetailCamera.look_up_max) and the collision ray can shorten it.
const CAMERA_ZOOM_MIN := RetailCamera.ZOOM_MIN
const CAMERA_ZOOM_MAX := RetailCamera.ZOOM_MAX
## The camera's vertical field of view (round 706; READ in round 648 and
## re-read): the camera's constructor `FUN_00bae0a0` stores 60.0 (0xd89ddc)
## at +0x50 and sets +0x44 (perspective); `CGFXVideo3d::FUN_00bae810` passes
## +0x50 x pi/180 (0xe1b8d8) and the viewport's width / height (0xed836c) to
## `FUN_00aa4ef0`, a D3DXMatrixPerspectiveFovLH: m11 = cot(fov / 2), m00 =
## m11 / aspect -- so 60 degrees vertical at any aspect, which is Godot's
## Camera3D.fov under KEEP_HEIGHT. Godot's default was 75 until then, so the
## same spot drew everything about 1.3 times smaller than the original.
const CAMERA_FOV_DEG := 60.0
## The scene's own authored entry pitch (World3D.tscn's CameraArm; OURS --
## the original keeps whatever camera the scene before left, and its
## config\cameradata.txt names a pitch and distance for only two spots,
## round 778). Nothing resets the camera to it any more.
const DEFAULT_CAMERA_PITCH_DEGREES := -42.0
## **Corrected 2026-08-31** (see docs/WORLD_ISSUES.md's thirty-first round):
## was 0.0, matching the scene's old CameraArm yaw -- both were real,
## confirmed wrong. rotation.y = atan2(dir.x, dir.z) (this file's own
## movement code) makes the player's local *+Z* face the movement
## direction, confirmed via a real textured render of the assembled
## character to be the character's real anatomical *front* (chest/abs
## texture, not spine). The old CameraArm pushed to that same local +Z with
## zero added yaw, meaning the default (non-orbited) camera sat on the
## character's *front* side, not behind them -- backwards from the
## intended over-the-shoulder third-person convention, and the real root
## cause of the "front/back texture swap" report (the user was already
## looking at the real front by default; rotating further showed the real
## back). 180.0 puts the camera on the correct side.
const DEFAULT_CAMERA_YAW_DEGREES := 180.0

## The three views the original's Option window offers, by the names it
## gives them. The camera arm hangs from a pivot that follows the player's
## *position* only (not the body's turn -- as a child of the body it swung
## round every time a click turned the character), and the view decides
## what else the pivot and the arm do (READ, round 778; RetailCamera's view
## note has the addresses):
##   free          -- follows position; yaw and pitch are the player's to
##                    drag, and nothing moves them otherwise (the default)
##   third_person  -- the pivot turns with the character, every frame and
##                    with no easing, so the camera sits straight behind
##                    whichever way they face; the drag turns the pitch only
##   quarter       -- the pitch stays where it was; the drag turns the yaw
## Switching writes no pitch in the original. Until round 778 the quarter
## view jumped to a pitch of -55 and the third-person view eased round at
## 360 degrees a second (both ours) and took no pitch drag.
const CAMERA_VIEW_FREE := "free"
const CAMERA_VIEW_THIRD_PERSON := "third_person"
const CAMERA_VIEW_QUARTER := "quarter"
const CAMERA_VIEWS := [CAMERA_VIEW_FREE, CAMERA_VIEW_THIRD_PERSON, CAMERA_VIEW_QUARTER]
var _camera_view := CAMERA_VIEW_FREE
var _camera_pivot: Node3D = null
## The zoom (round 778, RetailCamera): the distance asked for (the wheel's,
## retail +0x3e8), the one in force (+0x3ec; looking up pulls it in), the
## collision ray's while it cuts the camera short (-1 when it does not), and
## the arm's spring_length as this code last set it -- a write by anything
## else (a QA hook) is taken as a new zoom. The arm's own spring and
## collision are off: the camera is placed here (_place_camera).
var _camera_wanted := 45.0
var _camera_current := 45.0
var _camera_hit := -1.0
var _camera_spring_seen := NAN
## The own character's fade when the camera looks up (RetailCamera.Ramp),
## drawn on the model by RetailCamera.ModelFade.
var _self_fade := RetailCamera.Ramp.new()
var _self_fade_model := RetailCamera.ModelFade.new()

func set_camera_view(view: String) -> void:
	if not CAMERA_VIEWS.has(view):
		view = CAMERA_VIEW_FREE
	# The yaw is a world yaw in the original, kept across a switch: fold the
	# pivot's turn into the arm before the pivot changes hands.
	if _camera_pivot != null and _camera_view == CAMERA_VIEW_THIRD_PERSON and view != CAMERA_VIEW_THIRD_PERSON:
		camera_arm.rotation.y += _camera_pivot.rotation.y
		_camera_pivot.rotation.y = 0.0
	_camera_view = view
	match view:
		CAMERA_VIEW_THIRD_PERSON:
			camera_arm.rotation_degrees.y = DEFAULT_CAMERA_YAW_DEGREES
		_:
			if _camera_pivot != null:
				_camera_pivot.rotation.y = 0.0

## ---------------------------------------------------------------------------
## The Option window's Video tab (round 694, VideoOptions; the record of what
## each row does in the original, and what it does here, is
## docs/protocol/OPTION_VIDEO.md). `_video` is the record in force; the
## pieces built later (the blob, the sun glow, a new character's meshes)
## read it as they are made.
var _video: VideoOptions = null
## Whether apply_video_options has run once (round 702: the first applies
## every row).
var _video_applied := false
## The sun's shadow-map reach under Shadow Detail "Detail" (round 702), from
## the camera. Godot's default, 100, faded every shadow out from 80 units,
## so zooming the camera out (10..150 units from the player since round 778)
## made the player's own shadow and its surroundings' come and go. The
## original's projected shadows cover the characters whose key in its list is
## at most 3000 (SWorld::vslot_025's `3000 < key` break), the key being
## `(int)(|object - player| x 10)` (READ, round 702 review:
## CICPlayer::vslot_005 0x9d6f19..0x9d6fad) -- 300 units from the PLAYER.
## So 460: those 300 plus the camera's farthest 150 from the player (READ,
## RetailCamera.ZOOM_MAX; 90 until round 778, which gave 400), plus a margin
## (OURS), and no shadow near the player changes with the zoom.
const SHADOW_MAP_DISTANCE := 460.0
## The terrain patches built, for Detail's catcher (ShadowCatcher).
var _terrain_patches: Array = []
## The original's bloom (RetailBloom, round 702 review), the Bloom row.
var _retail_bloom: RetailBloom = null
## The overlays drawn after it (OverlayView).
var _overlay_view: OverlayView = null
## The far-plane factor of the Background Sight Range (see
## _apply_view_distance).
var _far_scale := 1.0
## The Character Sight Range in force, 0 for none, and the meshes it reaches:
## every GeometryInstance3D added under other_entities (players, monsters,
## the ground items; NPCs are built into their region's RealTerrain_* group
## and are not reached), collected as they are added, so an apply walks a
## list rather than the tree (round 694 review: 24-31 ms with 2,500 monsters).
var _character_range := 0.0
var _character_range_nodes: Array = []
var _character_range_watch := false

func video_options() -> VideoOptions:
	if _video == null:
		_video = VideoOptions.in_force()
	return _video

## Applies `o` to everything this scene draws (Apply / Confirm, and once at
## _ready). Each row's line says what it reaches; rows with nothing here to
## reach say so. The View row is applied by its own caller (set_camera_view).
func apply_video_options(o: VideoOptions) -> void:
	if o == null:
		return
	var t0 := Time.get_ticks_usec()
	# The first application applies every row (round 702): until then
	# `before` was the very record being applied -- video_options() had just
	# made it the one in force -- so nothing "changed" and the saved choices
	# never reached the world at start-up. The sun's shadow map stayed on in
	# Circle (the scene's default), Bloom's glow stayed off, Filtering and
	# Texture Detail were never set, until a row was changed in the window.
	var before: VideoOptions = _video if _video_applied else null
	_video = o
	_video_applied = true
	# Round 747's review, F11: the far crowd on the GPU, the player's config
	# switch (OURS), unless a QA run set it.
	if OS.get_environment("OPENSRO_QA_CROWD_GPU") == "":
		CrowdGpu.enabled = o.gpu_crowd
	VideoOptions.set_in_force(o)
	# Only what changed is applied again (round 694 review: Apply on any tab
	# re-applied the whole record); everything on the first apply.
	var changed := func(entry: int) -> bool:
		return before == null or before.value(entry) != o.value(entry)
	# Shadow Detail. READ, SWorld::vslot_043 case 2: Detail builds a 96x96
	# target and 32x32 shadow textures per character -- a real shadow; Circle
	# and Nothing free them. READ, SWorld::vslot_024 (round 702,
	# CharacterBlobs): Circle draws the round blob under up to ten
	# characters, Detail the projected shadows and NO blob, Nothing neither.
	# Here: Circle draws the blobs (CharacterBlobs, every frame); Detail the
	# sun's shadow map (OURS stand-in for the projected shadows), with no
	# blob; Nothing neither.
	var shadow := o.value(VideoOptions.SHADOW)
	if changed.call(VideoOptions.SHADOW):
		if directional_light != null:
			directional_light.shadow_enabled = shadow >= 2
			directional_light.directional_shadow_max_distance = SHADOW_MAP_DISTANCE
		_apply_shadow_catchers()
		_update_blob_shadow()
	# Fog (temporary), OURS (round 702): the original's fog or none.
	if changed.call(VideoOptions.FOG):
		_apply_fog()
	# Night Darkness and Shadows Follow the Sun (OURS, round 786, NightLight):
	# every group written again at the new scale; the shadow light taken to the
	# hour at once (or back to the fixed light).
	# Job Titles on Names (OURS, round 805): every suited plate again.
	if before != null and changed.call(VideoOptions.JOB_TITLES):
		_refresh_job_plates()
	if before != null and (changed.call(VideoOptions.NIGHT) or changed.call(VideoOptions.SUN_SHADOWS) or changed.call(VideoOptions.SHADOW)):
		if changed.call(VideoOptions.NIGHT) and _day_cycle.state != null and _env_record != null and _dungeon == null:
			_day_pushed.clear()
			_day_push(_day_cycle.state, false)
		_sun_shadow_snap()
	# Background Sight Range (READ distances, OURS drawing; _apply_view_distance).
	if changed.call(VideoOptions.SCENERY):
		_apply_view_distance(o.value(VideoOptions.SCENERY))
	# Character Sight Range (OURS distances; VideoOptions.CHARACTER_RANGE).
	if changed.call(VideoOptions.CHARACTER):
		_set_character_range(VideoOptions.character_range(o.value(VideoOptions.CHARACTER)))
	# Water Reflection: retail builds or frees the pass at once (case 6). Here
	# a region's water is built for one mode, so a change shows from the next
	# world entry (OURS; said in the window's tooltip).
	var want_reflection := o.value(VideoOptions.WATER_REFLECTION) == 1
	if before != null and want_reflection != (before.value(VideoOptions.WATER_REFLECTION) == 1) \
			and want_reflection != _water_reflection_on:
		_log_system("Water Reflection %s from the next login." % ("on" if want_reflection else "off"))
	# Water Detail (OURS rows; VideoOptions.WATER_ROWS): live.
	WaterReflection.target_rows = VideoOptions.water_rows(o.value(VideoOptions.WATER_DETAIL))
	# Texture Filtering (MSAA) and Texture Detail (mip bias): the 3D view.
	if changed.call(VideoOptions.FILTERING) or changed.call(VideoOptions.TEXTURE):
		VideoOptions.apply_viewport(get_viewport(), o)
	# Lens Flare. READ: SWorld::vslot_005 draws the flare (Map::FUN_00a21280)
	# only while world+0x2e84 (case 0xd) is set; round 786 draws that flare
	# (LensFlare), read by _day_bodies.
	if _env_record != null:
		_day_bodies(_env_time, _day_cycle.state)
	# Light Effect (round 720's review, READ: case 0xb -> the thunk 0xbbdad0
	# -> the effect manager's +0x1a4): the teleport gates' glow pass, live.
	_ambient.set_light_effect(o.value(VideoOptions.LIGHT) == 1)
	# SSAO (OURS) through the environment; Bloom Effect is the original's
	# bloom (RetailBloom, round 702 review), in both renderers.
	if world_environment != null and (changed.call(VideoOptions.SSAO) or changed.call(VideoOptions.BLOOM)):
		VideoOptions.apply_post_effects(world_environment.environment,
			o.value(VideoOptions.SSAO) == 1, o.value(VideoOptions.BLOOM) == 1)
	if _retail_bloom != null:
		_retail_bloom.visible = o.value(VideoOptions.BLOOM) == 1
	# The objects' diffuse scale follows the bloom target (round 706, READ:
	# world+0x2e54, ObjectLight).
	if changed.call(VideoOptions.BLOOM):
		_apply_object_light()
	# Effect Quality (READ, IDecoSkill::FUN_00a50dc0; SkillEffects.quality).
	SkillEffects.quality = o.value(VideoOptions.EFFECT)
	# Set Brightness (READ curve; a pass over the whole screen).
	if before == null or before.current().brightness != o.current().brightness:
		VideoOptions.apply_brightness(get_tree().root if is_inside_tree() else null, o.current().brightness)
	if o.notice != "":
		_log_system(o.notice)
		o.notice = ""
	# Dynamic Animation (round 794, READ: case 0xe -> the object renderer's
	# +0x19c through 0xbc11f0, which re-inits every object's cloth on a
	# change): ClothDriver's per-vertex cloth (docs/protocol/CLOTH.md).
	ClothDriver.set_option(o.value(VideoOptions.DYNAMIC_ANIMATION) != 0)
	# Metallic Sheen (case 0xc -> the object renderer's +0x194; forced off on
	# a card below shader model 3, CGame::FUN_00834fb0), Light Effect (case
	# 0xb -> +0x1a4) and Display Friendly/Enemy (the large-battle outfit
	# swap, GlobalDataManager::FUN_009dae90) are kept and saved, and change
	# nothing here: this client draws no environment-map sheen, no torch or
	# sun light effect (Light Effect drives only the teleport gates' glow
	# pass, above), and no battle outfits (docs/protocol/OPTION_VIDEO.md).
	print("World3D: video options applied in %d us -- %s" % [Time.get_ticks_usec() - t0, describe_video(o)])

## OPENSRO_QA_VIDEO_STEPS="spec|spec|..." (round 694, OURS): once the
## world's load is done, every OPENSRO_QA_VIDEO_STEP_FRAMES ticks (default
## 90) the next spec -- OPENSRO_QA_VIDEO's syntax, over this client's
## defaults -- is applied as Apply would, and `QA VIDEO STEP i frame f: spec`
## is printed, so one boot shows (or times) every setting a question needs.
## Each step's end prints its mean wall time a frame over its second half
## (`QA VIDEO TIME i <ms> ms over <n> frames`) and, with
## OPENSRO_QA_VIDEO_SHOT_DIR, saves the frame as step_<i>.png; with
## OPENSRO_QA_VIDEO_QUIT=1 the run quits after the last.
var _qa_video_steps_spec := OS.get_environment("OPENSRO_QA_VIDEO_STEPS")
var _qa_video_steps: PackedStringArray = []
var _qa_video_step_i := -1
var _qa_video_step_at := -1
var _qa_video_step_len := 90
var _qa_video_last_usec := 0
var _qa_video_frames := 0

func _qa_video_step() -> void:
	if _qa_video_steps_spec == "":
		return
	if _qa_video_step_i == -1:
		if not _initial_load_done:
			return
		_qa_video_steps = _qa_video_steps_spec.split("|", false)
		_qa_video_step_i = 0
		_qa_video_step_at = _qa_tick + 120
		return
	if _qa_video_step_i > _qa_video_steps.size():
		return
	# This runs on physics ticks; the time a frame is the wall time over the
	# frames DRAWN in the step's second half.
	if _qa_video_step_i > 0 and _qa_video_last_usec == 0 and _qa_tick >= _qa_video_step_at - _qa_video_step_len / 2:
		_qa_video_last_usec = Time.get_ticks_usec()
		_qa_video_frames = Engine.get_frames_drawn()
	if _qa_tick < _qa_video_step_at:
		return
	if _qa_video_step_i > 0:
		var done := _qa_video_step_i - 1
		var frames := Engine.get_frames_drawn() - _qa_video_frames
		print("QA VIDEO TIME %d %.2f ms over %d frames" % [done,
			float(Time.get_ticks_usec() - _qa_video_last_usec) / 1000.0 / float(maxi(frames, 1)), frames])
		var dir := OS.get_environment("OPENSRO_QA_VIDEO_SHOT_DIR")
		if dir != "":
			var img := get_viewport().get_texture().get_image()
			if img != null:
				img.save_png(dir.path_join("step_%d.png" % done))
	_qa_video_last_usec = 0
	if _qa_video_step_i >= _qa_video_steps.size():
		_qa_video_step_i += 1
		print("QA VIDEO STEPS done")
		if OS.get_environment("OPENSRO_QA_VIDEO_QUIT") == "1":
			get_tree().quit()
		return
	var o := VideoOptions.new()
	VideoOptions.apply_spec(o, _qa_video_steps[_qa_video_step_i])
	print("QA VIDEO STEP %d frame %d: %s" % [_qa_video_step_i, Engine.get_frames_drawn(), _qa_video_steps[_qa_video_step_i]])
	_on_video_options_applied(o)
	_qa_video_step_i += 1
	var every := OS.get_environment("OPENSRO_QA_VIDEO_STEP_FRAMES")
	_qa_video_step_len = int(every) if every.is_valid_int() else 90
	_qa_video_step_at = _qa_tick + _qa_video_step_len

## One line naming every row's value in force, for the log and the QA probe.
func describe_video(o: VideoOptions) -> String:
	var p := o.current()
	var parts := PackedStringArray()
	parts.append("graphic %d quality %d brightness %d" % [o.active + 1, p.quality, p.brightness])
	for e in VideoOptions.VALUE_ENTRIES:
		parts.append("%s=%d" % [VideoOptions.row_of(e)["key"], o.value(e)])
	parts.append("fullscreen=%s resolution=%s" % [str(o.fullscreen), VideoOptions.format_resolution(o.resolution)])
	parts.append("view_distance=%.0f object_range=%.0f far=%.0f fog=%.0f..%.0f%s char_range=%.0f water_rows=%d msaa=%d mip_bias=%.1f renderer=%s" % [
		VideoOptions.view_distance(o.value(VideoOptions.SCENERY)), MapAnimation.object_range,
		camera_3d.far if camera_3d != null else 0.0, _fog_near_real, _fog_far_real,
		"" if _fog_pass != null and _fog_pass.visible else " (off)", _character_range,
		WaterReflection.target_rows, get_viewport().msaa_3d if is_inside_tree() else -1,
		get_viewport().texture_mipmap_bias if is_inside_tree() else 0.0,
		"forward_plus" if VideoOptions.forward_plus_running() else "gl_compatibility"])
	return " ".join(parts)

## Background Sight Range. READ (VideoOptions.SCENERY_FAR): the far plane
## 1500..5500 and the view distance min(0.8 x far, 2500), which scales the
## fog planes and is the map objects' animation range plus 480. Here:
## - the map objects' range follows the view distance (READ rule);
## - the fog planes are the zone's channels times the view distance (READ
##   rule, round 702: _apply_fog);
## - the camera's far plane scales by far / 3500, the READ default, at the
##   settings below it (OURS: this client's far plane is its streamed region
##   window's, not retail's; settings 3 to 5 keep it, since nothing past the
##   loaded window exists to show).
## At 3 (the default) all three are what they were before round 694.
func _apply_view_distance(scenery: int) -> void:
	var view := VideoOptions.view_distance(scenery)
	MapAnimation.set_view_distance(view)
	_far_scale = minf(1.0, VideoOptions.far_plane(scenery) / VideoOptions.SCENERY_FAR[2])
	_apply_fog()
	if camera_3d != null:
		_apply_camera_far_plane()

## The world's fog from the zone's channels (_apply_real_environment_lighting),
## the Background Sight Range's view distance (READ rule) and the Video tab's
## "Fog (temporary)" row (OURS, round 702: the user's comparison toggle; on
## is the original's look). Sets the shader globals every fogged shader reads
## and shows or hides the pass. OPENSRO_QA_NOFOG turns it off for a run.
func _apply_fog() -> void:
	# A dungeon's fog is its block's (round 773).
	if _dungeon != null:
		_apply_dungeon_block(maxi(_dungeon_block, 0))
		return
	var o := video_options()
	var view := VideoOptions.view_distance(o.value(VideoOptions.SCENERY))
	var fog_planes := WorldFog.planes(_fog_channel_near, _fog_channel_far, view)
	_fog_near_real = fog_planes.x
	_fog_far_real = fog_planes.y
	var on := _fog_ready and o.value(VideoOptions.FOG) == 1 and OS.get_environment("OPENSRO_QA_NOFOG") == ""
	var env: Environment = world_environment.environment if world_environment != null else null
	WorldFog.set_globals(fog_planes, on, WorldFog.pass_color(_fog_display_color, env))
	# The object shaders undo the same tone map (round 706, ObjectLight).
	ObjectLight.set_tonemap(env)
	if _fog_pass != null:
		_fog_pass.visible = on
		# Forward+ mixes in display values under this tone map (round 705).
		WorldFog.set_pass_tonemap(_fog_pass, env)
	_apply_fx_reach()

## Round 807 (OURS, the user's request; WorldAmbientFx's class comment): the
## placed objects' effects play to just past the fog's end with the fog on --
## they fade out in it -- and to the far plane, where the landscape ends,
## with it off.
func _apply_fx_reach() -> void:
	if _fog_pass != null and _fog_pass.visible:
		WorldAmbientFx.fx_reach = _fog_far_real + WorldAmbientFx.FOG_MARGIN
	elif camera_3d != null:
		WorldAmbientFx.fx_reach = camera_3d.far
	if _world_fx != null:
		_world_fx.night_changed()

## Whether Detail's terrain catcher draws: Shadow Detail "Detail", under
## Forward+ (ShadowCatcher: the Compatibility renderer's shadowed sun is its
## own additive pass).
func _shadow_catchers_on() -> bool:
	return video_options().value(VideoOptions.SHADOW) >= 2 and RendererChoice.running() == RendererChoice.FORWARD_PLUS

## Puts Detail's catcher on every terrain patch built, or takes it off.
func _apply_shadow_catchers() -> void:
	var on := _shadow_catchers_on()
	var kept: Array = []
	for p in _terrain_patches:
		if is_instance_valid(p):
			ShadowCatcher.set_on(p as MeshInstance3D, on)
			kept.append(p)
	_terrain_patches = kept

## Puts the fog pass under the camera (once; _ready, world and title alike).
func _build_fog_pass() -> void:
	if _fog_pass != null or camera_3d == null:
		return
	_fog_pass = WorldFog.build_pass(RendererChoice.running() != RendererChoice.FORWARD_PLUS)
	_fog_pass.visible = false
	camera_3d.add_child(_fog_pass)

## Character Sight Range: other players' and monsters' meshes are drawn to
## `range_` from the camera (GeometryInstance3D.visibility_range_end; 0
## draws them at any distance). Their name plates keep their own range; NPCs
## are not reached (see _character_range_nodes).
func _set_character_range(range_: float) -> void:
	_character_range = range_
	# The far crowd's parts too (round 747, CrowdGpu: in its vertex shader).
	if _crowd_gpu != null:
		_crowd_gpu.set_range(range_)
	if not _character_range_watch and is_inside_tree():
		# The first time: what is there now, then every mesh as it is added.
		if other_entities != null:
			for n in other_entities.find_children("*", "GeometryInstance3D", true, false):
				if not (n is Label3D):
					_character_range_nodes.append(n)
		get_tree().node_added.connect(_on_node_added_for_range)
		_character_range_watch = true
	var kept: Array = []
	for n in _character_range_nodes:
		if is_instance_valid(n) and (n as Node).is_inside_tree():
			_apply_character_range_to(n as GeometryInstance3D)
			kept.append(n)
	_character_range_nodes = kept

const CHARACTER_RANGE_META := &"video_character_range"

func _apply_character_range_to(g: GeometryInstance3D) -> void:
	if g == null or g is Label3D:
		return
	# A range a mesh was given for another reason is left alone.
	if g.visibility_range_end > 0.0 and not g.has_meta(CHARACTER_RANGE_META):
		return
	g.visibility_range_end = _character_range
	if _character_range > 0.0:
		g.set_meta(CHARACTER_RANGE_META, true)
	elif g.has_meta(CHARACTER_RANGE_META):
		g.remove_meta(CHARACTER_RANGE_META)

func _on_node_added_for_range(n: Node) -> void:
	if n is GeometryInstance3D and not (n is Label3D) and other_entities != null and other_entities.is_ancestor_of(n):
		_character_range_nodes.append(n)
		# Bodies come and go: drop the freed ones now and then.
		if _character_range_nodes.size() % 4096 == 0:
			_character_range_nodes = _character_range_nodes.filter(func(x) -> bool: return is_instance_valid(x))
		if _character_range > 0.0:
			_apply_character_range_to(n as GeometryInstance3D)

## Round 832 (OURS): the Ping / FPS box (PingFpsCounter), shown or removed.
## It sits just above the minimap, under the windows.
var _ping_fps: PingFpsCounter = null

func _apply_ping_fps_counter(on: bool) -> void:
	var have := _ping_fps != null and is_instance_valid(_ping_fps)
	if on and not have:
		_ping_fps = PingFpsCounter.new()
		_ping_fps.net = NetClient
		ui_control.add_child(_ping_fps)
		if _hud_minimap != null and _hud_minimap.get_parent() == ui_control:
			ui_control.move_child(_ping_fps, _hud_minimap.get_index() + 1)
	elif not on and have:
		_ping_fps.queue_free()
		_ping_fps = null

## Round 832: the Option window's Extra tab on Apply / Confirm. The action
## short cut is read where the right click asks for it.
func _on_extra_options_applied(values: Dictionary) -> void:
	_apply_ping_fps_counter(bool(values.get("ping_fps", false)))

## The Option window's Apply / Confirm (HudPanels.video_options_applied):
## the display (window mode, size), the View row, then the world.
func _on_video_options_applied(o: VideoOptions) -> void:
	# The window only when its own rows changed: Apply on another tab must not
	# snap a moved window back (round 694 review).
	var before := _video
	# ... or when the Resolution was picked again and the window is maximised
	# or not at that size (round 696 review, L1: a stored 1280 x 720 re-picked
	# after maximising did nothing).
	if before == null or before.fullscreen != o.fullscreen or before.resolution != o.resolution \
			or VideoOptions.needs_resize(get_window(), o):
		VideoOptions.apply_display(get_window(), o)
	if o.camera_view != "" and o.camera_view != _camera_view:
		set_camera_view(o.camera_view)
		ClientSettings.set_value(ClientSettings.SECTION_UI, ClientSettings.KEY_CAMERA_VIEW, _camera_view)
		if _debug_panel != null:
			_debug_panel.sync_view()
	apply_video_options(o)

## Keeps the pivot on the player and, in the third-person view, turned the
## way they face (at once: the original sets the yaw from the heading every
## frame, RetailCamera's view note), then places the camera.
func _follow_with_camera(delta: float) -> void:
	if _camera_pivot == null:
		return
	# Round 826: the camera shake moves the look-at point (CameraShake).
	_shake_clock_ms += maxf(delta, 0.0) * 1000.0
	_camera_shake.step(int(_shake_clock_ms))
	_camera_pivot.global_position = player.global_position + _camera_shake.offset()
	if _camera_view == CAMERA_VIEW_THIRD_PERSON:
		_camera_pivot.rotation.y = player.rotation.y
	_place_camera(delta)

## Round 826: the original's one camera shake (CameraShake; READ, its header
## and docs/protocol/camera_shake.md), on scene time.
var _camera_shake := CameraShake.new()
var _shake_clock_ms := 0.0

## A skill row's shake (SkillEffects.shake_hook): refused when the caster is
## another player -- READ, the test is the caster's class being exactly
## CICUser (0xef1bc0; FUN_00b94b70 -> 0xb94b30, an equality): this player
## (CICPlayer), monsters, NPCs and pets shake it. Every flag set starts its
## shake in the client's order (0x8, 0x10, 0x80, 0x100; 0x20, 0x40, 0x200,
## 0x400), each replacing the one before.
func _on_skill_shake(flags: int, caster: Node3D, at_arrival: bool) -> void:
	if caster != null and caster != player and _other_bodies.values().has(caster):
		return
	var which: Array = CameraShake.MOV_FLAGS if at_arrival else CameraShake.START_FLAGS
	for sh in CameraShake.shakes_of(flags, which):
		_camera_shake.start(CameraShake.MODE_BOTH, int(sh[0]), CameraShake.LENGTH_MS, int(sh[1]), int(_shake_clock_ms))
		print("CAMERA shake %d for %d ms (tick %d ms) -- %s, flags 0x%x" % [int(sh[0]), CameraShake.LENGTH_MS,
			int(sh[1]), "a mover arrived" if at_arrival else "a skill row played", flags])

## One of this player's own blows lands (READ, FUN_00a49290 at 0xa495b8: the
## damage entry's attacker is this player): a critical, or any blow while
## berserk, shakes the camera (CameraShake.hit_shake).
func _own_blow_shake(critical: bool) -> void:
	var sh := CameraShake.hit_shake(critical, NetClient.own_body_mode == 1)
	if sh.is_empty():
		return
	_camera_shake.start(CameraShake.MODE_BOTH, int(sh[0]), CameraShake.LENGTH_MS, int(sh[1]), int(_shake_clock_ms))
	print("CAMERA shake %d for %d ms -- own blow%s%s" % [int(sh[0]), CameraShake.LENGTH_MS,
		", critical" if critical else "", ", berserk" if NetClient.own_body_mode == 1 else ""])

## The original's camera placer and collision ray, once a physics step
## (round 778; READ, RetailCamera has each rule and address):
## - the distance in force settles against the one asked for and, looking
##   up, the look-up limit (RetailCamera.settle);
## - the arm's pivot -- the look-at point -- rises over the feet by
##   RetailCamera.target_height of the distance (the collided one while the
##   ray cuts it short, as the original's +0x3f8);
## - a ray from 5 units out to the distance, on the arm's collision mask (the
##   terrain and the objects; QA_FREE clears it), puts the camera 5 short of
##   what it hits;
## - the own model's fade follows the pitch (RetailCamera.Ramp).
## The arm's own spring is off (set where the pivot is made); this places the
## Camera3D at the arm's local +Z itself. The one-frame lag the original has
## (its +0x37c keeps the collided distance one frame after the ray clears) is
## not carried.
func _place_camera(delta: float) -> void:
	if camera_3d == null or camera_3d.get_parent() != camera_arm:
		return
	# SpringArm3D turns its own placer back on when it enters the tree again.
	if camera_arm.is_physics_processing_internal():
		camera_arm.set_physics_process_internal(false)
	if not is_equal_approx(camera_arm.spring_length, _camera_spring_seen):
		_camera_wanted = camera_arm.spring_length
		_camera_current = _camera_wanted
		_camera_spring_seen = camera_arm.spring_length
	var pitch := RetailCamera.retail_pitch(camera_arm.rotation_degrees.x)
	_camera_current = RetailCamera.settle(_camera_current, _camera_wanted, pitch)
	camera_arm.position = Vector3(0.0, RetailCamera.target_height(_camera_hit if _camera_hit >= 0.0 else _camera_current), 0.0)
	var dist := _camera_current
	_camera_hit = -1.0
	if camera_arm.collision_mask != 0 and _camera_current > RetailCamera.COLLISION_SKIP and is_inside_tree():
		var target := camera_arm.global_position
		var dir := camera_arm.global_transform.basis.z.normalized()
		var q := PhysicsRayQueryParameters3D.create(target + dir * RetailCamera.COLLISION_SKIP,
			target + dir * _camera_current, camera_arm.collision_mask, [player.get_rid()])
		var hit := get_world_3d().direct_space_state.intersect_ray(q)
		if not hit.is_empty():
			_camera_hit = RetailCamera.collided(target.distance_to(hit["position"]))
			dist = _camera_hit
	camera_3d.transform = Transform3D(Basis.IDENTITY, Vector3(0.0, 0.0, dist))
	_self_fade.set_hidden(RetailCamera.fades(pitch))
	_self_fade_model.apply(_player_skeleton, _self_fade.step(delta))

## One `QA CAMERA` line (round 778, at each QA SHOT): the arm's pitch, the
## zoom asked for and in force, the collision ray's cut, the look-at height,
## the eye's height over the feet and its distance from the look-at point,
## and the own model's alpha with how many of its meshes draw on fade twins.
func _camera_report(shot: String) -> String:
	var eye := camera_3d.global_position.y - player.global_position.y if camera_3d != null else NAN
	return "QA CAMERA %s: pitch %.2f deg (retail %.4f), wanted %.2f, current %.2f, hit %.2f, look-at %.3f over the feet, eye %.2f over the feet at %.2f, alpha %d (%d meshes faded)" % [
		shot, camera_arm.rotation_degrees.x, RetailCamera.retail_pitch(camera_arm.rotation_degrees.x),
		_camera_wanted, _camera_current, _camera_hit, camera_arm.position.y, eye,
		camera_3d.position.z if camera_3d != null else NAN, _self_fade.alpha, _self_fade_model.meshes.size()]

