		if e != null:
			_quest_npcpos = QuestMarks.index_positions(NpcTableReader.parse_positions(_media_pk2.read_file(e)))
	_hud_minimap.update_quest(player_local, QuestMarks.targets_local(ids, here_region, _quest_npcpos))

