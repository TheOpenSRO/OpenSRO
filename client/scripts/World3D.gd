## The item id of a code name in the client's own item table (QA), -1.
func _qa_item_id(code: String) -> int:
	for id in _item_rows:
		var row: ItemTableReader.Item = _item_rows[id]
		if row != null and row.code_name == code:
			return int(id)
	return -1

func _qa_equip_bag_step() -> void:
	if not NetClient.is_connected_to_server():
		return
	for entry in _qa_equip_bag_spec.split(",", false):
		var at := String(entry).split(":")
		var pair := at[1].split("=") if at.size() == 2 else PackedStringArray()
		if pair.size() != 2:
			continue
		var tick := int(at[0])
		if _qa_tick == tick - 20:
			NetClient.list_inventory(NetClient.current_character_name)
		elif _qa_tick == tick:
			var slot := int(pair[0])
			var item_id := int(pair[1])
			if item_id == 0:
				print("QA EQUIP BAG: tick %d taking off slot %d" % [_qa_tick, slot])
				_awaiting_equip_ack = true
				NetClient.unequip(NetClient.current_character_name, slot)
				continue
			var found := false
			for s in _inventory_slots:
				if s.item_id == item_id and CharacterAppearance.is_avatar_key(slot) and _hud_panels != null:
					# Round 789: an avatar key puts it down on the equipment
					# window as a drag would (HudPanels' avatar drop: the client's
					# rules, then 0x7034 type 0x24).
					print("QA EQUIP BAG: tick %d avatar %d from bag slot %d put down on the equipment window" % [_qa_tick, item_id, s.slot_index])
					_hud_panels._drop_avatar_from_bag(s.slot_index)
					found = true
					break
				if s.item_id == item_id:
					print("QA EQUIP BAG: tick %d putting item %d on in slot %d from bag slot %d" % [_qa_tick, item_id, slot, s.slot_index])
					_awaiting_equip_ack = true
					NetClient.equip(NetClient.current_character_name, slot, s.slot_index)
					found = true
					break
			if not found:
				print("QA EQUIP BAG: tick %d item %d not in the bag" % [_qa_tick, item_id])

func _qa_pmi_click(control_name: String) -> void:
	var c := _hud_player_info.find_child(control_name, true, false) as Control
	if c == null:
		print("QA PMI: no %s to click" % control_name)
		return
	var at := c.get_global_rect().get_center()
	for pressed in [true, false]:
		var ev := InputEventMouseButton.new()
		ev.button_index = MOUSE_BUTTON_LEFT
		ev.pressed = pressed
		ev.position = at
		ev.global_position = at
		get_viewport().push_input(ev)
	print("QA PMI: clicked %s at %s" % [control_name, at])

func _qa_pmi_step() -> void:
	if _hud_player_info == null:
		return
	var parts := _qa_pmi_spec.split(",")
	var start := int(parts[0]) if parts.size() > 0 else 400
	var hold := int(parts[1]) if parts.size() > 1 else 40
	if _qa_tick < start or (_qa_tick - start) % hold != 0:
		return
	_qa_pmi_state += 1
	var who := NetClient.current_character_name
	var states := ["ch_gauge0", "ch_gauge2", "ch_full_panel", "unequip_weapon", "equip_weapon", "click_ready", "berserk_on", "eu_full_panel"]
	if _qa_pmi_state >= states.size():
		return
	var state: String = states[_qa_pmi_state]
	match state:
		"ch_gauge0":
			_hud_player_info.set_berserk(0, false)
		"ch_gauge2":
			_hud_player_info.set_berserk(40, false)
		"ch_full_panel":
			_hud_player_info.set_berserk(100, false)
			_qa_pmi_click("GDR_PMI_BTN_CINFO")
		"unequip_weapon":
			if who != "" and NetClient.is_connected_to_server():
				NetClient.unequip(who, EquipmentNet.SLOT_WEAPON)
		"equip_weapon":
			if who != "" and NetClient.is_connected_to_server():
				NetClient.equip(who, EquipmentNet.SLOT_WEAPON, 0)
		"click_ready":
			_qa_pmi_click("GDR_PMI_BTN_JAHWAN")
		"berserk_on":
			_hud_player_info.set_berserk(0, true)
		"eu_full_panel":
			_hud_player_info.set_berserk(100, false)
			_hud_player_info.set_race(1)
	print("QA PMI %s frame %d (panel %s, orbs %d, ready %s, emblem %s)" % [state, Engine.get_frames_drawn(),
		str(_hud_player_info.is_stat_panel_open()), _hud_player_info.hwan_charges(), str(_hud_player_info.hwan_ready()),
		_hud_player_info.race_mark_path()])
## Where KeyInput.dispatched stood when the current action was pushed.
var _qa_input_keymap_mark := 0

## OPENSRO_QA_STALL_BOOTH's step (round 838): the booth StallBooth chooses for
## `decoration` and `race`, at the player's feet, facing as the player does.
var _qa_booth: Node3D = null

func _qa_stall_booth(decoration: int, race: int) -> void:
	if is_instance_valid(_qa_booth):
		_qa_booth.queue_free()
	var path := StallBooth.model_path(_item_rows.get(decoration), race)
	_qa_booth = StallBooth.build(_data_pk2, path)
	print("QA STALL BOOTH: decoration %d race %d -> %s (%s)" % [decoration, race, path,
		"built" if _qa_booth != null else "not found"])
	if _qa_booth == null or player == null:
		return
	add_child(_qa_booth)
	_qa_booth.global_position = player.global_position
	_qa_booth.rotation.y = player.rotation.y

func _qa_input_step() -> void:
	var spec := OS.get_environment("OPENSRO_QA_INPUT")
	if spec == "":
		return
	if not _qa_input_armed:
		_qa_input_armed = true
		for part in spec.split(";", false):
			var at := String(part).find(":")
			if at > 0 and String(part).substr(0, at).is_valid_int():
				_qa_input_steps[int(String(part).substr(0, at))] = String(part).substr(at + 1)
	if _qa_input_report != "":
		var ran: Array = _key_input.dispatched.slice(_qa_input_keymap_mark) if _key_input != null else []
		print("QA INPUT %d %s: open=[%s] focus=%s world_keys=[%s] keymap=[%s]" % [_qa_input_count, _qa_input_report,
			_qa_open_windows(), _qa_focus_name(), ",".join(_qa_input_seen), " | ".join(ran)])
		_qa_input_report = ""
	if not _qa_input_steps.has(_qa_tick):
		return
	var action: String = _qa_input_steps[_qa_tick]
	_qa_input_seen.clear()
	_qa_input_keymap_mark = _key_input.dispatched.size() if _key_input != null else 0
	_qa_input_count += 1
	_qa_input_report = action
	var kind := action.get_slice(":", 0)
	var arg := action.substr(kind.length() + 1)
	match kind:
		"key":
			_qa_push_key(arg)
		"down":
			_qa_push_key(arg, [true])
		"up":
			_qa_push_key(arg, [false])
		"repeat":
			# Round 808: the OS's key repeat of a held key (echo).
			_qa_push_key(arg, [true], true)
		"whisper_from":
			var heard := ChatNet.Update.new()
			heard.type = HudChat.TYPE_WHISPER
			heard.sender_name = arg
			heard.message_text = "tt whisper"
			_on_chat_update(heard)
		"type":
			# Round 865 stage 3: a capital letter goes with Shift held, as a
			# keyboard sends it (it came out in lower case before).
			for i in arg.length():
				var ch := arg[i]
				_qa_push_key("shift+" + ch if ch != ch.to_lower() else ch)
		"click", "rclick":
			var xy := arg.split(",")
			_qa_push_click(Vector2(float(xy[0]), float(xy[1])),
				MOUSE_BUTTON_RIGHT if kind == "rclick" else MOUSE_BUTTON_LEFT, false)
			var hov := get_viewport().gui_get_hovered_control()
			_qa_input_report = "%s (hovered %s)" % [action, hov.get_path() if hov != null else "nothing"]
		"node":
			var node := _qa_find_visible(ui_control, arg)
			# Round 854: the developer panel sits on $UI beside UI/Control.
			if node == null and _debug_panel != null and _debug_panel.visible:
				node = _qa_find_visible(_debug_panel, arg)
			if node == null:
				_qa_input_report = action + " (no such visible node)"
			else:
				var centre := node.get_global_rect().get_center()
				_qa_push_click(centre, MOUSE_BUTTON_LEFT)
				# Round 841: what took the click (the control under the pointer).
				var nhov := get_viewport().gui_get_hovered_control()
				_qa_input_report = "%s at %s (%s; hovered %s)" % [action, centre, node.get_path(), nhov.get_path() if nhov != null else "nothing"]
		"bagitem", "rbagitem":
			# Round 791: left click the bag cell holding that item id (the
			# shown page), as a player picks an item up; round 838: `rbagitem`
			# right-clicks it, as a player uses it.
			var cell := _hud_panels._bag_cell_of_item(int(arg)) if _hud_panels != null else null
			if cell == null:
				_qa_input_report = action + " (not on the shown bag page)"
			else:
				var centre := cell.get_global_rect().get_center()
				_qa_input_report = "%s at %s" % [action, centre]
				_qa_push_click(centre, MOUSE_BUTTON_RIGHT if kind == "rbagitem" else MOUSE_BUTTON_LEFT)
		"playerclick":
			# Round 839: left click the middle of another player's body, as a
			# player clicks it (the pick, the cursor's class and the click's
			# dispatch decide what it does).
			var pbody: Node3D = null
			for cid in _other_bodies:
				var nb = _other_bodies[cid]
				if nb != null and is_instance_valid(nb) and String((nb as Node).get_meta("character_name", "")) == arg:
					pbody = nb
			if pbody == null or camera_3d == null:
				_qa_input_report = action + " (no such player drawn)"
			else:
				var top := float(pbody.get_meta(STALL_TOP_META, 1.8 * PLAYER_SCALE_RATIO))
				var at := camera_3d.unproject_position(pbody.global_position + Vector3(0, top * 0.5, 0))
				_qa_input_report = "%s at %s" % [action, at]
				_qa_push_click(at, MOUSE_BUTTON_LEFT)
		"pmi_order":
			# Round 855 (QA only): the player block as drawn -- where the pet
			# strip sits among its children and which of them draw under and
			# over it, with each one's overlap with the strip in UI pixels.
			_qa_input_report = "%s %s" % [action, _qa_pmi_order_report()]
		"groundclick":
			# Round 846: left click the ground <dx>,<dz> world units from where
			# this player stands, at the pixel the camera draws that point at
			# -- a player's own click near the character (the pick decides
			# where it lands).
			var gxz := arg.split(",", false)
			if gxz.size() != 2 or camera_3d == null:
				_qa_input_report = action + " (needs <dx>,<dz>)"
			else:
				# At the player's own height: the ground it stands on (a deck in
				# a town), which the terrain under a deck is not.
				var gp := player.global_position + Vector3(float(gxz[0]), 0.0, float(gxz[1]))
				var gat := camera_3d.unproject_position(gp)
				_qa_input_report = "%s at %s (world %.2f, %.2f from %.2f, %.2f)" % [action, gat, gp.x, gp.z,
					player.global_position.x, player.global_position.z]
				_qa_push_click(gat, MOUSE_BUTTON_LEFT)
		"stallicon", "stallmodify", "stallslot":
			# Round 839: left click a stall slot's icon, its modify button, or
			# the slot itself (an empty one, to put a held item on).
			var what := "icon" if kind == "stallicon" else ("modify" if kind == "stallmodify" else "slot")
			var sc := _hud_panels.qa_stall_slot_control(int(arg), what) if _hud_panels != null else null
			if sc == null:
				_qa_input_report = action + " (no stall slot shown)"
			else:
				_qa_input_report = "%s at %s" % [action, sc.get_global_rect().get_center()]
				_qa_push_click(sc.get_global_rect().get_center(), MOUSE_BUTTON_LEFT)
		"guildnode", "rguildnode":
			# Round 844: left (right) click a control of the guild window by
			# its GetChild path from the window (47,28 the first member row,
			# 47,401 the level header, 47,222 the notice bar).
			var gc := _qa_net_control("guildnode", arg)
			if gc == null:
				_qa_input_report = action + " (not shown)"
			else:
				_qa_input_report = "%s at %s" % [action, gc.get_global_rect().get_center()]
				_qa_push_click(gc.get_global_rect().get_center(), MOUSE_BUTTON_RIGHT if kind == "rguildnode" else MOUSE_BUTTON_LEFT, true)
		"hudnode":
			# Round 844: left click a control by its node path under HudPanels
			# (GuildMasterLeave/Create/.../CheckBox), as a player's click.
			var hn: Control = _hud_panels.get_node_or_null(NodePath(arg)) as Control if _hud_panels != null else null
			if hn == null or not hn.is_visible_in_tree():
				_qa_input_report = action + " (not shown)"
			else:
				_qa_push_click(hn.get_global_rect().get_center(), MOUSE_BUTTON_LEFT)
				var hh := get_viewport().gui_get_hovered_control()
				_qa_input_report = "%s at %s (hovered %s; pressed %s)" % [action, hn.get_global_rect().get_center(),
					hh.get_path() if hh != null else "nothing", (hn as BaseButton).button_pressed if hn is BaseButton else "-"]
		"cmd":
			# Round 844 part 2: one console line at this tick (as
			# OPENSRO_QA_COMMANDS' at tick 60).
			_run_qa_commands(arg)
		"storebuy":
			# Round 844 part 2: the buy box for a store good, as putting it
			# down on the bag opens it (HudPanels._confirm_buy; not a drag).
			if _hud_panels != null:
				_hud_panels._confirm_buy(int(arg))
		"storetip":
			# Round 844 part 2: a store good's tooltip lines, for the log.
			var tl: Array = _hud_panels.item_tip_lines(int(arg), "store", 0, -1, -1, int(_hud_panels._shop_prices.get(int(arg), 0))) if _hud_panels != null else []
			_qa_input_report = "%s %s" % [action, JSON.stringify(tl.map(func(l) -> String: return String(l["text"])))]
		"hit":
			# Round 850: every shown Control that would take a press at
			# <x>,<y> (mouse filter not IGNORE, its rect holding the point), for
			# a click that never reached the world.
			var hp := arg.split(",")
			var at_pt := Vector2(float(hp[0]), float(hp[1])) if hp.size() == 2 else Vector2.ZERO
			var takers: Array[String] = []
			var stack: Array[Node] = [ui_control]
			while not stack.is_empty():
				var n: Node = stack.pop_back()
				if n is CanvasItem and not (n as CanvasItem).visible:
					continue
				if n is Control and (n as Control).mouse_filter != Control.MOUSE_FILTER_IGNORE \
						and (n as Control).get_global_rect().has_point(at_pt):
					takers.append("%s(%s)" % [n.get_path(), "STOP" if (n as Control).mouse_filter == Control.MOUSE_FILTER_STOP else "PASS"])
				for ch in n.get_children():
					stack.append(ch)
			_qa_input_report = "%s takers=%s" % [action, str(takers)]
		"where":
			# Round 860: where this player stands, whether it walks, and its
			# scroll state -- the hold's measurement.
			_qa_input_report = "%s at (%.2f, %.2f, %.2f) yaw %.4f walking=%s state=%d held=%s" % [action,
				player.global_position.x, player.global_position.y, player.global_position.z, player.rotation.y,
				str(_has_move_target), _own_teleport_state, str(_scroll_hold())]
		"wmquest":
			# Round 850: the world map's quest marks and shown map, for the QA
			# log (HudWorldmap.quest_report: the layers' child counts, auto-move,
			# the map, the scroll).
			_qa_input_report = "%s visible=%s %s" % [action, _hud_worldmap.visible if _hud_worldmap != null else false,
				_hud_worldmap.quest_report() if _hud_worldmap != null else "(no world map)"]
		"acapkt", "acahex", "acarow", "acabox", "acajudge", "acareport", "acaask", "acanotice":
			_qa_input_report = "%s -> %s" % [action, _qa_academy_step(kind, arg)]
		"guildreport":
			# Round 844: the guild window's state, for the QA log.
			_qa_input_report = "%s %s" % [action, _hud_panels.qa_guild_report() if _hud_panels != null else "{}"]
		"netnode", "netbox", "underbar":
			# Round 840: left click a control of the stall network window
			# (netnode:<id>[,<id>..], a GetChild path from its root), of its
			# buy box (netbox:<id>) or of the underbar (underbar:<id>[,..]:
			# 4 the menu button, 59,120 the stall network item).
			var nc := _qa_net_control(kind, arg)
			if nc == null:
				_qa_input_report = action + " (not shown)"
			else:
				_qa_input_report = "%s at %s" % [action, nc.get_global_rect().get_center()]
				# Round 841: in UI units (local), so the click lands at a UI scale other than 1.
				_qa_push_click(nc.get_global_rect().get_center(), MOUSE_BUTTON_LEFT, true)
		"unionnode", "unionbox", "unionstate":
			# Round 844 (QA): unionnode:<id>[,..] left-clicks a control of the
			# guild window by its GetChild path (73 the Relations tab, 164,86,51
			# Apply, 164,86,271 the first union row); unionbox:yes|no the union
			# request box's OK / Cancel; unionstate prints the union pane.
			_qa_input_report = _qa_union_step(kind, arg)
		"boxyes", "boxno":
			# Round 840: the Yes / No of a question box under HudPanels by
			# its node name (StallNetworkQuestion, StallNetworkNotice ...).
			var qb = _hud_panels.get_node_or_null(arg) if _hud_panels != null else null
			var qbtn: BaseButton = qb._find_button(kind == "boxyes") if qb != null and qb.has_method("_find_button") else null
			if qbtn == null or not qbtn.is_visible_in_tree():
				_qa_input_report = action + " (no such box)"
			else:
				_qa_input_report = "%s at %s" % [action, qbtn.get_global_rect().get_center()]
				_qa_push_click(qbtn.get_global_rect().get_center(), MOUSE_BUTTON_LEFT, true)
		"netclose":
			# Round 840: the stall network window's X.
			var ncw := _hud_panels.stall_network_window() if _hud_panels != null else null
			var ncx := ncw.get_node_or_null("CloseButton") as Control if ncw != null else null
			if ncx == null:
				_qa_input_report = action + " (no window)"
			else:
				_qa_input_report = "%s at %s" % [action, ncx.get_global_rect().get_center()]
				_qa_push_click(ncx.get_global_rect().get_center(), MOUSE_BUTTON_LEFT, true)
		"netpage", "netprev", "netnext":
			# Round 840: the page manager's page button i, prev or next.
			var nw := _hud_panels.stall_network_window() if _hud_panels != null else null
			var pb: Control = null
			if nw != null and nw.pager != null:
				pb = nw.pager.page_button(int(arg)) if kind == "netpage" else (nw.pager.prev_button() if kind == "netprev" else nw.pager.next_button())
			if pb == null or not pb.is_visible_in_tree():
				_qa_input_report = action + " (not shown)"
			else:
				_qa_input_report = "%s at %s" % [action, pb.get_global_rect().get_center()]
				_qa_push_click(pb.get_global_rect().get_center(), MOUSE_BUTTON_LEFT, true)
		"netlist":
			# Round 840: row i of the open combo list (ComboList).
			var cl := ComboList.current()
			if cl == null:
				_qa_input_report = action + " (no list open)"
			else:
				var at := cl.to_canvas * (cl.list_rect.position + ComboList.row_rect(cl.list_rect.size, int(arg)).get_center())
				_qa_input_report = "%s at %s (%s)" % [action, at, cl.items[int(arg)] if int(arg) < cl.items.size() else "?"]
				_qa_push_click(at, MOUSE_BUTTON_LEFT)
		"optnode", "optlist", "localnode":
			# Round 854: optnode:<id>[,..][,<child name>] left-clicks an Option
			# window control by its GetChild path (10 the Video tab, 9 Apply,
			# 6 Confirm, 78,465,Down the list's scroll arrow, 78,248,217 the
			# last row's combo); optlist:<i> row i of the open combo list;
			# localnode:<name> as node:. All in UI units, so the click lands at
			# any UI scale.
			_qa_input_report = _qa_option_click(kind, arg)
		"uiscale":
			# Round 854: the UI scale in force and where every shown window is.
			_qa_input_report = "%s %s" % [action, _qa_ui_scale_report()]
		"winsize":
			# Round 854: resize the game window to <w>x<h>, as a player's drag
			# of its frame does (the OS window; UiScaleChoices re-fits).
			var ws := arg.split("x")
			if ws.size() == 2:
				get_window().size = Vector2i(int(ws[0]), int(ws[1]))
			_qa_input_report = "%s -> window %s" % [action, str(get_window().size)]
		"snap":
			# Round 858: this frame into OPENSRO_QA_SNAP_DIR as <arg>.png.
			var sd := OS.get_environment("OPENSRO_QA_SNAP_DIR")
			if sd != "":
				DirAccess.make_dir_recursive_absolute(sd)
				get_viewport().get_texture().get_image().save_png("%s/%s.png" % [sd, arg])
				_qa_input_report = "%s -> %s/%s.png" % [action, sd, arg]
		"holes":
			# Round 858: the hole census (HoleCensus) of a shown Control by
			# name, in this real frame; prints HOLES / PIECE lines.
			var hn := _qa_find_visible(ui_control, arg)
			if hn == null:
				_qa_input_report = action + " (not shown)"
			else:
				HoleCensus.measure(hn, "qa_" + arg, OS.get_environment("OPENSRO_QA_HOLES_OUT"))
		"textalign":
			# Round 859: the text alignment census (TextAlignCensus) of a shown
			# Control by name, in this real frame, with the text typed as it
			# is (no sample); prints TEXT / CARET / TEXTSUM lines.
			var tn := _qa_find_visible(ui_control, arg)
			if tn == null:
				_qa_input_report = action + " (not shown)"
			else:
				TextAlignCensus.measure(tn, "qa_" + arg, TextAlignCensus.index_layouts(_ui_builder), false)
		"editstate":
			# Round 860: where an edit draws its text and caret now (the
			# CifEdit named so, or the one under a shown Control of that name
			# with the keyboard, else its first): the caret column, the
			# text's width, its drawn left and the caret's x in the edit (UI
			# px), the long-text rule's span, the UI scale.
			var en := _qa_find_visible(ui_control, arg)
			var ce := en as CifEdit
			if ce == null and en != null:
				for c in en.find_children("*", "CifEdit", true, false):
					if ce == null or (c as CifEdit).has_focus():
						ce = c as CifEdit
			if ce == null:
				_qa_input_report = action + " (not shown)"
			else:
				var pl := ce.placement()
				var cr: Rect2 = pl.get("caret", Rect2())
				_qa_input_report = "%s -> EDIT %s col %d len %d text_w %.1f left %.1f caret_x %.1f caret_y %.1f span %s size %s at %s scale %.2f" % [
					action, ce.name, ce.caret_column, ce.text.length(), float(pl.get("text_w", 0.0)), float(pl.get("left", 0.0)),
					cr.position.x, cr.position.y, ce.rule_span(), ce.size, ce.get_global_rect().position,
					get_tree().root.content_scale_factor]
		"helpclose", "helptab", "helpstate":
			# Round 858: left click the Help window's X or a menu tab; report
			# its state (root, frame, tab, document).
			var hf := _help_window.get_node_or_null("HelpFrame") as Control if _help_window != null else null
			var target: Control = null
			if hf != null and kind == "helpclose":
				target = hf.get_node_or_null("CloseButton") as Control
			elif hf != null and kind == "helptab":
				target = hf.find_child("Tab%d" % int(arg), true, false) as Control
			if target != null and target.is_visible_in_tree():
				_qa_push_click(target.get_global_rect().get_center(), MOUSE_BUTTON_LEFT)
			_qa_input_report = "%s%s -> help root %s frame %s open %s tab %d doc %d" % [action,
				(" at %s" % target.get_global_rect().get_center()) if target != null else "",
