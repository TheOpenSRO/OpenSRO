## Round 786: the objects' ambient effects blended in display values exactly
## under Forward+ (EfpDisplayPass), on the world camera's compositor; its
## draw list is taken just before the RenderingServer draws a frame.
func _setup_efp_pass() -> void:
	if EfpDisplayPass.qa_off or not VideoOptions.forward_plus_running() or camera_3d == null:
		return
	var p := EfpDisplayPass.new()
	EfpDisplayPass.active = p
	var comp := Compositor.new()
	comp.compositor_effects = [p]
	camera_3d.compositor = comp
	RenderingServer.frame_pre_draw.connect(_submit_efp_pass)

func _submit_efp_pass() -> void:
	if EfpDisplayPass.active != null and is_instance_valid(camera_3d):
		EfpDisplayPass.active.submit(camera_3d)

func _ready() -> void:
	# Round 786: the bodies here move on physics ticks, so the effects on them
	# are placed once a tick (EfpEffect.tick_gate, its _process).
	EfpEffect.gate_ticks(true)
	_setup_efp_pass()
	# Round 808's follow-up: footprints in sand and snow (Footprints).
	_footprints = Footprints.new()
	_footprints.name = "Footprints"
	_footprints.load_texture = func(path: String) -> Texture2D: return _ui_builder.load_texture(path) if _ui_builder != null else null
	_footprints.ground_height = func(p: Vector3) -> float: return _terrain_height_at(p)
	add_child(_footprints)
	_anim_sounds.footstep = Callable(self, "_on_footstep")
	_anim_sounds.clip_fx = Callable(self, "_on_clip_fx")
	# Round 794: the Dynamic Animation driver for this viewport's cloth (the
	# placed objects are duplicates of templates never in the tree).
	ClothDriver.driver_for(get_viewport())
	# Round 789 (lane U): a QA boot straight into the world fetches and layers
	# the QA server's packs before this scene opens any archive (Login does it
	# for a player before character select).
	# Nothing of this scene runs until it is done (no frame of it is set up yet).
	if not title_mode and OS.get_environment("OPENSRO_QA_SERVER") != "" and not NetClient.is_connected_to_server():
		set_process(false)
		set_physics_process(false)
		await QaSignIn.sync_packs(get_tree())
		set_process(true)
		set_physics_process(true)
	# QA (round 786): OPENSRO_QA_PHYSICS_TICKS=<n> runs the physics at n a
	# second, so a movie render (60 frames a second) shows what a player
	# rendering faster than the physics sees (e.g. 24: 2.5 frames a tick, as
	# 144 fps over 60 ticks).
	var qa_ticks := OS.get_environment("OPENSRO_QA_PHYSICS_TICKS")
	if qa_ticks.is_valid_int() and int(qa_ticks) > 0:
		Engine.physics_ticks_per_second = int(qa_ticks)
		print("QA: physics at %d ticks a second" % int(qa_ticks))
	# QA (round 786, GameClock.parse_qa): OPENSRO_QA_CLOCK="HH:MM" pins the
	# game clock for the run, "name=HH:MM,..." per QA shot (_qa_clock_for_shot).
	var qa_clock := OS.get_environment("OPENSRO_QA_CLOCK")
	if qa_clock != "":
		var clock: GameClock = NetClient.game_clock
		clock.qa_pins = GameClock.parse_qa(qa_clock)
		# OPENSRO_QA_CLOCK_RUN=<speed>: the pinned clock runs that many times
		# the game's rate (the perf gate's day passing in seconds).
		var run := OS.get_environment("OPENSRO_QA_CLOCK_RUN")
		if run.is_valid_float() and float(run) > 0.0:
			clock.qa_run = true
			clock.qa_speed = float(run)
		if clock.qa_pins.has(""):
			var at: Vector2i = clock.qa_pins[""]
			clock.pin(at.x, at.y)
		print("QA CLOCK: pins %s" % str(clock.qa_pins))
	# SSAO and glow (round 693): off, the look the project verified under the
	# Compatibility renderer, which has neither; the Options window may pass
	# its own choice (WorldPostEffects). Before the title branch: the title's
	# backdrop is this scene too.
	WorldPostEffects.apply(world_environment.environment)
	# The distance fog's pass (round 702, WorldFog); the zone's environment
	# fills it in.
	_build_fog_pass()
	# QA only (round 786, the ground flicker): OPENSRO_QA_ALPHA_STIR.
	QaAlphaStir.install(self, camera_3d)
	# The original's field of view (round 706, CAMERA_FOV_DEG).
	if camera_3d != null:
		camera_3d.fov = CAMERA_FOV_DEG
		camera_3d.keep_aspect = Camera3D.KEEP_HEIGHT
	# The objects' light before any zone is known, then the zone's (round 706).
	_apply_object_light()
	ObjectLight.set_tonemap(world_environment.environment)
	# Characters' object colour by their tile (round 706 and its review: both
	# renderers, through per-level material copies).
	_character_light = CharacterLight.new(_nav_graph_for)
	# Round 747 (CrowdGpu): a far body follows its meshes' new materials, and
	# comes back to cast Detail's shadow.
	CharacterLight.on_changed = _crowd_light_changed
	CharacterLight.on_value = _crowd_ghost_light
	CharacterBlobs.on_cast = _crowd_wake_node
	EquipFx.far_frame = _crowd_item_frame
	EquipFx.far_origin = _crowd_item_origin
	EquipFx.ghost_frame = _crowd_ghost_item_frame
	EquipFx.ghost_origin = _crowd_ghost_origin
	EquipFx.ghost_gpu = _crowd_gpu_now
	# Round 767: not in title mode. The select and customize screens draw
	# their characters in this viewport over a title backdrop, which has no
	# CrowdGpu; the batches step only with one (EquipFxBatch.step), so the
	# characters' seal and plus particles were handed to batches that never
	# drew (round 764's review F1 made the claim). They keep their holders.
	if not title_mode:
		EquipFx.batch_viewport = get_viewport()
	# Round 762's review, F1: the frame's wait for the background dressing's
	# room (OtherCrowd.FrameMark).
	add_child(OtherCrowd.FrameMark.new(true))
	add_child(OtherCrowd.FrameMark.new(false))
	# The original's bloom (round 702 review); the Bloom row shows it.
	_retail_bloom = RetailBloom.new()
	_retail_bloom.visible = false
	add_child(_retail_bloom)
	# Name plates, damage numbers and their marks, drawn after the bloom
	# (OverlayView, round 702 rework review: retail draws them as 2D text
	# over the finished, bloomed frame).
	_overlay_view = OverlayView.new()
	add_child(_overlay_view)
	_overlay_view.follow(camera_3d)
	# The sun's energy under Forward+, matched to Compatibility's look (round
	# 693, WorldPostEffects.sun_scale; 1.0 under Compatibility).
	directional_light.light_energy *= WorldPostEffects.sun_scale()
	# Decided here on the main thread before any worker decodes a texture
	# (round 695, DdjReader.dxt1_needs_alpha_format; Boot also logs it).
	DdjReader.dxt1_needs_alpha_format()
	# The front-end's 3D backdrop (round 678, FrontEndBackdrop): none of an
	# entry's work -- no player, HUD, server or loading screen.
	if title_mode:
		_overlay_view.set_rendering(false)
		_title_ready()
		return
	# Every entry names itself and the renderer in the log (round 579), so a
	# player's log carries the GPU and how many times this process has
	# entered the world without anyone typing /groundprobe. Counted in the
	# process environment (OPENSRO_WORLD_ENTRY), never a static.
	_world_entry = GroundProbe.next_entry()
	print(GroundProbe.entry_line(_world_entry, get_instance_id()))
	# Round 741: every itemdata part the index names (63, ~1.7 s of GDScript
	# on the render box) parses on a worker while the rest of _ready runs;
	# _load_character_assets waits for it. Free when the select screen
	# already parsed the same archive (ItemTableReader.load_all is shared).
	ItemTableReader.preload_async(_open_media_pk2_if_set())
	# Round 746: characterdata the same way -- every part its index names
	# (63; the world read 7), its boot and entry readers on two workers
	# (CharTables), waited for by _load_character_assets and the NPC and
	# monster loaders.
	CharTables.preload_async(_open_media_pk2_if_set())
	# OPENSRO_QA_UI_SCALE=<f> (round 695, OURS): a QA run boots this scene
	# directly, past Boot's ClientSettings.apply_ui_scale, so it ran at 1.0
	# whatever the settings say; this applies a scale for the run (nothing is
	# saved) -- how the paper doll is measured at the user's 2.0.
	if OS.get_environment("OPENSRO_QA_UI_SCALE") != "":
		ClientSettings.apply_ui_scale(get_window(), OS.get_environment("OPENSRO_QA_UI_SCALE").to_float())
		print("World3D: OPENSRO_QA_UI_SCALE -> UI scale %.2f" % get_window().content_scale_factor)
	_qa_split_init()
	# The Water Reflection option (round 628): the node always exists, so
	# OPENSRO_QA_WATER_TIMING can time a run with the option off too.
	_water_reflection_on = WaterReflection.enabled()
	WaterReflection.ensure_globals()
	# The mirror-only terrain copies are the reflection's, never the screen's.
	camera_3d.cull_mask &= ~WaterReflection.MIRROR_TERRAIN_BIT
	_water_reflection = WaterReflection.new()
	_water_reflection.name = "WaterReflection"
	add_child(_water_reflection)
	print("World3D: water reflection %s (the Video tab's Water Reflection row; Middle, the default, has it off)" % ("on" if _water_reflection_on else "off"))
	# Sound (round 611): distances are measured from the player, left and
	# right from the camera -- AudioService's header says why (ours).
	SoundTable.set_listener(player, camera_3d)
	# The skill tables the combat sounds key by (round 614), read while the
	# world loads rather than on the first blow.
	# Round 746: on workers (every skilldata part the index names); the first
	# use waits for them.
	SkillAudio.warm_async()
	# Skill visual effects (round 620): the same rows, their .efp drawn by
	# EfpEffect from the player's Particles.pk2. The buff auras follow
	# OpBuffStart / OpBuffEnd (rounds 616-618, _fx_on_buff_started).
	SkillEffects.set_archive(_open_particles_pk2_if_set())
	SkillEffects.warm_async()
	SkillEffects.own_body = player
	SkillEffects.shake_hook = _on_skill_shake
	# Round 746's review, finding 4: the player's own weapon is the one whose
	# world-axis effects simulate on their own (EquipFx.prefer_root). Deferred:
	# the driver is a child of the viewport, which is still setting up.
	(func() -> void:
		if is_inside_tree():
			EquipFx.driver_for(get_viewport()).prefer_root = player).call_deferred()
	# Berserk's look (round 651): the SYSTEM_CH_HWANMODE rows of the same
	# table, drawn from the same Particles.pk2.
	BerserkLook.set_archive(_open_particles_pk2_if_set())
	BerserkLook.warm()
	# The effects' plate/mesh/link shaders and their glow twins (round 720's
	# review): compiled behind the loading screen, not as a gate's region
	# binds.
	var sw_efp := Time.get_ticks_usec()
	var warmed := EfpEffect.warm(camera_3d)
	print("World3D: warming %d effect shader(s) in %d us" % [warmed, Time.get_ticks_usec() - sw_efp])
	# The fade-in's shaders (round 676's review): compiled behind the loading
	# screen, not on the first monster's frame.
	print("World3D: warming %d appear-fade shader(s)" % AppearFade.warm(camera_3d))
	# Known skills' effect files decode on a worker thread when the skill
	# state arrives, so a first cast does not (round 620 review).
	NetClient.skill_state_result.connect(func(state) -> void:
		if state != null and state.error == "":
			SkillEffects.preload_skills(state.known_skills.keys())
			# Round 781: learning or raising spends SP; the underbar showed
			# the last stats' total until the next stats update (MEASURED:
			# 9,000,000 there, 8,996,066 in the Skill window).
			_guild_sp_now = state.skill_points
			if _hud_underbar != null:
				_hud_underbar.set_sp(state.skill_points))
	# The auras follow OpBuffStart / OpBuffEnd through _on_buff_started /
	# _on_buff_ended (connected below), after the owner is settled
	# (round 616-620 integration).
	# Entering the world is a loading screen, shown or not (round 612): the
	# title music and any old zone's stop here, and the first region under
	# the player starts its zone's music from the top (FUN_0084ab20, READ).
	var entry_music := _audio_music()
	if entry_music != null:
		entry_music.enter_loading("world entry")
	# OPENSRO_QA_RECONNECT (round 558): number this process's world entries
	# through the environment -- never a static, statics are what a reconnect
	# run measures. The count arms the QA ENTRY / QA TEXPROBE prints and is
	# off unless a reconnect run set it or is about to.
	var qa_reconnect := OS.get_environment("OPENSRO_QA_RECONNECT")
	if qa_reconnect != "" or OS.get_environment("OPENSRO_QA_ENTRY") != "":
		_qa_entry = OS.get_environment("OPENSRO_QA_ENTRY").to_int() + 1
		OS.set_environment("OPENSRO_QA_ENTRY", str(_qa_entry))
	if qa_reconnect == "drain" and not _should_show_loading_screen():
		printerr("QA RECONNECT: 'drain' needs OPENSRO_QA_FORCE_LOADING=1 -- the QA path builds the grid in one frame, so this hook would never fire")
	# A QA run boots this scene directly, so there is no Login or character
	# select behind it. With OPENSRO_QA_SERVER set, sign in first -- that
	# is what makes a render show real equipment, real vitals and the
	# server's own monsters rather than a client talking to nothing. A
	# reconnect run that came back through Login and CharacterSelect
	# (OPENSRO_QA_RECONNECT_VIA_LOGIN) arrives already signed in, the way a
	# player does, so it must not sign in a second time here.
	if OS.get_environment("OPENSRO_QA_SERVER") != "" and not NetClient.is_connected_to_server():
		await QaSignIn.run(get_tree())

	WindowTitle.apply_in_world(NetClient.current_character_name)

	var _t_assets := Time.get_ticks_msec()
	_load_character_assets()
	# Round 795: the COS table (rides, transports, pets) from the boot
	# tables, which the spawn reader asks a record's TypeID4 of.
	_cos_bind_table(CharTables.boot(_media_pk2) if _media_pk2 != null else null)
	# The other players' spawn records are read by the item table (round
	# 737, UserSpawnNet): the spawns that came before it are read now.
	NetClient.set_spawn_item_rows(_item_rows, _cos_kind_of)
	print("World3D: character/item/NPC tables loaded in %d ms" % (Time.get_ticks_msec() - _t_assets))
	# The readers' own time so far, by function (round 667, ParseProfile;
	# OPENSRO_PARSE_PROFILE=1): boot and these tables, then a fresh window
	# for the entry's drain, reported beside its LoadTimings summary.
	if ParseProfile.enabled:
		print(ParseProfile.report("before the entry"))
		ParseProfile.reset()
	if _qa_entry > 0:
		print("QA ENTRY %d: world instance %d at frame %d (connected: %s)" % [
			_qa_entry, get_instance_id(), Engine.get_frames_drawn(), str(NetClient.is_connected_to_server())])

	var result := NetClient.last_enter_world_result
	if result != null and result.ok:
		player.position = Vector3(result.x, result.y, result.z)
		_last_sent_pos = player.position
		_walked_since_send = 0.0
		# Round 749: the server has the character here, with no leg.
		_move_sync.placed(player.position)
		# Facing the way this character left (round 637's review follow-up:
		# the heading restored with the position, OURS), when the server sends
		# one.
		if not is_nan(result.heading):
			player.rotation.y = RemoteFacing.yaw_of(result.heading, 0.0)
		_spawn_result_others(result.others, result.seated)

	NetClient.entity_entered.connect(_on_entity_entered)
	NetClient.user_group_begin.connect(_on_user_group_begin)
	NetClient.user_group_end.connect(_on_user_group_end)
	NetClient.entity_moved.connect(_on_entity_moved)
	# Round 749: retail's 0xB021 and 0xB023 (DestMoveNet).
	NetClient.entity_move_echo.connect(_on_entity_move_echo)
	NetClient.entity_move_stop.connect(_on_entity_move_stop)
	NetClient.entity_turned.connect(_on_entity_turned)
	# Round 795: the COS (pets, rides, transports).
	_cos_connect()
	NetClient.unstuck_result.connect(_on_unstuck_result)
	NetClient.entity_left.connect(_on_entity_left)
	NetClient.other_player_equipment_changed.connect(_on_other_equipment_changed)
	# Round 789: this player's avatar inventory and its moves (AvatarNet).
	NetClient.avatar_list_result.connect(func(_items: Dictionary) -> void: _sync_player_avatars("avatar list"))
	NetClient.avatar_move_result.connect(func(r: Dictionary) -> void:
		if bool(r.get("ok", false)):
			_sync_player_avatars("avatar move"))
	NetClient.change_zone_result.connect(_on_change_zone_result)
	NetClient.teleport_result.connect(_on_teleport_result)
	NetClient.recall_designate_result.connect(_on_recall_designate_result)
	NetClient.chat_update.connect(_on_chat_update)
	NetClient.unique_notice.connect(_on_unique_notice)
	NetClient.chat_result.connect(_on_chat_result)
	NetClient.disconnected.connect(_on_disconnected)
	# The keyboard: the retail key table (KeyMap) run by KeyInput (round 608).
	_setup_keys()

	NetClient.monster_list_result.connect(_on_monster_list_result)
	NetClient.monster_left.connect(_on_monster_left)
	NetClient.monster_moved.connect(_on_monster_moved)
	NetClient.monster_motion_list.connect(_on_monster_motion_list)
	NetClient.monster_attacked.connect(_on_monster_attacked)
	NetClient.monster_spawned.connect(_on_monster_spawned)
	# The NPCs (round 708): the server's spawns, replayed from the roster
	# for those that came before this scene, then followed.
	NetClient.npc_spawned.connect(_on_npc_spawned)
	NetClient.npc_despawned.connect(_on_npc_despawned)
	var npc_roster: NpcSpawnNet.Roster = NetClient.get("npc_roster") as NpcSpawnNet.Roster
	if npc_roster != null:
		for uid in npc_roster.npcs:
			_on_npc_spawned(npc_roster.npcs[uid])
	NetClient.attack_result.connect(_on_attack_result)
	# Round 802: job PvP's blows and the safe trade (JobPvpNet).
	NetClient.player_struck.connect(_on_player_struck)
	NetClient.safe_trade.connect(_on_safe_trade)
