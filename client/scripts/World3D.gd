	if _zone_region.x >= 0:
		_hud_region.enter_region(TextZoneNameReader.region_id(_zone_region.x, _zone_region.y))
	# GDR_NOTICE, the GM notice banner (round 634), over everything else.
	_hud_notice = HudNotice.new()
