## Regions whose NPCs have already been placed live in _grid.npc_regions_done,
## so streaming back into a still-loaded region doesn't stack a second copy
## of everyone in it; a streamed-out region's mark goes with its terrain
## node (RegionGridState.unload), so it is populated again on return.

func _load_npc_tables() -> void:
	if _npc_tables_loaded:
		return
	_npc_tables_loaded = true
	# Opened here rather than reusing _media_pk2: region streaming starts
	# before _try_initialize_pk2_ui() runs, so that handle is still null the
	# first time a region asks for its NPCs.
	if _media_pk2 == null:
		_media_pk2 = _open_media_pk2_if_set()
	if _media_pk2 == null:
		return
	var pos_entry := ObjectLoader.find_file(_media_pk2, NpcTableReader.POSITION_TABLE_PATH)
	if pos_entry == null:
		print("World3D: no npcpos.txt in Media.pk2 -- no NPCs")
		return
	for spawn in NpcTableReader.parse_positions(_media_pk2.read_file(pos_entry)):
		var key := "%d_%d" % [spawn.region_x, spawn.region_y]
		if not _npc_spawns_by_region.has(key):
			_npc_spawns_by_region[key] = []
		_npc_spawns_by_region[key].append(spawn)
	# The same characterdata parts give the model and the name: a row
	# carries an id, an `SN_` key and a `.bsr`, and textdata_object turns
	# the key into what the game calls the NPC. Read once, joined twice.
	var names_entry := ObjectLoader.find_file(_media_pk2, NpcTableReader.OBJECT_NAME_TABLE_PATH)
	var names: UiTextTable = null
	if names_entry != null:
		names = UiTextTable.parse(_media_pk2.read_file(names_entry))
	# NPC greetings resolve through a different table than names: npcchat's SN_
	# ids live in textquest_speechname.txt (with the English in a later column,
	# which UiTextTable picks by content).
	var greet_entry := ObjectLoader.find_file(_media_pk2, "server_dep\\silkroad\\textdata\\textquest_speechname.txt")
	if greet_entry != null:
		_npc_text_table = UiTextTable.parse(_media_pk2.read_file(greet_entry))
	for path in NpcTableReader.MODEL_TABLE_PATHS:
		var entry := ObjectLoader.find_file(_media_pk2, path)
		if entry != null:
			var bytes := _media_pk2.read_file(entry)
			_npc_models = NpcTableReader.parse_models(bytes, _npc_models)
			_npc_codes = NpcTableReader.parse_codes(bytes, _npc_codes)
			if names != null:
				_npc_names = NpcTableReader.parse_names(bytes, names, _npc_names)
	# What each NPC offers: shops (refshopgroup) and greetings (npcchat).
	var shop_entry := ObjectLoader.find_file(_media_pk2, NpcServiceReader.SHOP_TABLE)
	if shop_entry != null:
		_npc_shop_set = NpcServiceReader.parse_shop_npcs(_media_pk2.read_file(shop_entry))
	var chat_entry := ObjectLoader.find_file(_media_pk2, NpcServiceReader.CHAT_TABLE)
	if chat_entry != null:
		_npc_greetings = NpcServiceReader.parse_greetings(_media_pk2.read_file(chat_entry))
	# The shop goods chain (refshopgroup -> ... -> item codename), so Buy shows
	# the NPC's real wares. Reads through _media_pk2 by archive path.
	_shop_reader = ShopReader.new().load(func(archive_path: String) -> PackedByteArray:
		var e := ObjectLoader.find_file(_media_pk2, archive_path)
		return _media_pk2.read_file(e) if e != null else PackedByteArray())
	# The teleport network (round 577): a gate is not in npcpos -- the
	# town's Dimensional Gate is a placed object, bound per region by
	# _bind_region_gates from teleportbuilding's position.
	_teleport_reader = TeleportReader.new().load(func(archive_path: String) -> PackedByteArray:
		var e := ObjectLoader.find_file(_media_pk2, archive_path)
		return _media_pk2.read_file(e) if e != null else PackedByteArray())
	# The gate's name resolves through the same textdata_object table
	# (_object_names); it was just parsed, so it is kept rather than parsed
	# a second time on the first gate.
	if _object_name_table == null and names != null:
		_object_name_table = names
	print("World3D: NPC tables -- %d spawn(s) across %d region(s), %d model(s), %d name(s), %d shop, %d greetings; %s" % [
		_npc_spawn_total(), _npc_spawns_by_region.size(), _npc_models.size(), _npc_names.size(), _npc_shop_set.size(), _npc_greetings.size(),
		_teleport_reader.summary()])

## A floating name over an NPC's head.
##
## Height comes from the assembled skeleton's own bones rather than a fixed
## offset: NPC models vary a great deal in size (the same reason the monster
## labels measure their skeleton), and one number puts a label through a
## tall NPC's face and far above a short one.
## Puts (or replaces) the local player's name plate, the same one every other
## entity carries.
##
## The guild line the original draws ABOVE the name is not here: the client is
## not told its own guild yet, and a plate is not the place to invent one. It
## goes in as soon as the server sends it -- see docs/PLAYTEST_2026_09_20.md
## item 18.
func _refresh_player_name_plate() -> void:
	if player == null or not is_instance_valid(player):
		return
	var existing := player.get_node_or_null("Name")
	if existing != null:
		existing.queue_free()
	var who := NetClient.current_character_name
	if who == "":
		return
	var top := _skeleton_top(_player_skeleton) if _player_skeleton != null else 1.8 * PLAYER_SCALE_RATIO
	player.add_child(_name_plate(who, top))

## `swept` (round 673's review): whether the plate follows the 300-from-the-
## player rule (NamePlates.Sweep), which owns its `visible`. A ground item's
## plate has its own rule -- shown only while hovered or Z is held
## (GroundItems.update_labels, round 608) -- so it is made unswept: the sweep
## setting `visible` every frame showed every item name in range.
func _name_plate(text: String, above: float, swept: bool = true) -> Label3D:
	var label := Label3D.new()
	label.name = "Name"
	label.text = text
	label.position = Vector3(0.0, above * (1.0 + NAME_PLATE_CLEARANCE_FRACTION), 0.0)
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	# **Fixed size, not world size.** The real client draws a name plate in
	# screen space from the entity's position, so it reads the same however
	# far away the entity is. A world-scaled Label3D instead shrinks with
	# distance, and at this world's scale -- a character is
	# REAL_CHARACTER_NATIVE_HEIGHT units tall, not 1.8 -- the default 0.005
	# pixel size made every plate a smear a few pixels high. That is why the
	# monster labels have never shown up in a render either.
	label.fixed_size = true
	label.pixel_size = NAME_PLATE_PIXEL_SIZE
	label.modulate = NAME_PLATE_COLOUR
	label.outline_size = NAME_PLATE_OUTLINE
	label.outline_modulate = NAME_PLATE_OUTLINE_COLOUR
	# Names read over whatever they stand in front of, which is what makes a
	# crowd of NPCs legible -- and retail's name is a screen-space draw over
	# the scene (NamePlates).
	label.no_depth_test = true
	label.render_priority = 1
	label.add_to_group("name_plates")
	# Shown while its owner is within NamePlates.RANGE of the player (READ),
	# from any camera angle; hidden until the sweep first measures it.
	if swept:
		_plate_sweep.add(label)
	return label

## The party monster's mark (round 660): retail's CICMonster vslot 15
## (0x9d3e70) draws, in its name pass, one 16 x 16 quad of
## `icon\item\etc\europe_partymob.ddj` (the name table 0xec7570, index 5)
## 20 px left of the name box's left edge -- so 4 px clear of it -- top-aligned
## with the box, for a monster whose +0x7ad is 1 (0x9d3f2a). READ. The name
## plate itself is ours (see below), so the mark is sized to its text's line
## height, with the gap kept at the retail 4 : 16 of the icon (OURS), and is
## drawn as the plate is: billboarded, fixed size, over the scene.
const PARTY_MARK_TEXTURE := "icon\\item\\etc\\europe_partymob.ddj"
const PARTY_MARK_PX := 16.0
const PARTY_MARK_GAP_PX := 4.0

func _party_mark(label: Label3D) -> Sprite3D:
	if _ui_builder == null:
		return null
	var tex: Texture2D = _ui_builder.load_texture(PARTY_MARK_TEXTURE)
	if tex == null:
		return null
	var mark := Sprite3D.new()
	mark.name = "PartyMark"
	mark.texture = tex
	mark.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	mark.fixed_size = true
	mark.no_depth_test = true
	mark.render_priority = label.render_priority
	_fit_party_mark(label, mark)
	# A child of the plate: shown and hidden with it (round 673).
	return mark

## Sizes and places a party mark against its plate's text and scale. Called
## again whenever the plate is re-sized (_fit_monster_name_box, round 673's
## review): the mark's pixel_size is the plate's times its own ratio, so a
## UI-scale change or a resize that re-sized only the plate left the mark
## at the old scale, over the text or adrift.
func _fit_party_mark(label: Label3D, mark: Sprite3D) -> void:
	if mark == null or mark.texture == null:
		return
	var tex := mark.texture
	var font: Font = label.font if label.font != null else ThemeDB.fallback_font
	var text_size := font.get_string_size(label.text, HORIZONTAL_ALIGNMENT_LEFT, -1, label.font_size)
	var k := text_size.y / PARTY_MARK_PX  # icon pixels -> the plate's font pixels
	mark.pixel_size = label.pixel_size * k * float(PARTY_MARK_PX) / float(tex.get_height())
	# The plate is centred on its node: the mark's centre is half the text, the
	# gap and half itself to the left, in its own texture pixels.
	var tex_px := float(tex.get_height()) / PARTY_MARK_PX
	mark.offset = Vector2(-(text_size.x * 0.5 / k + PARTY_MARK_GAP_PX + PARTY_MARK_PX * 0.5) * tex_px, 0.0)

## A monster's name as retail draws it (round 673), MEASURED from the user's
## retail screenshot of the Mangyang field near Jangan (1730 x 896, every
## name read off its pixels; a picture, not the binary):
##   - pure white glyphs (#ffffff), one level, no outline and no shadow: the
##     pixels beside a glyph are the box's, never black;
##   - a cap height of 9 rows ("M" of "Mangyang", rows 244-252 over the dirt,
##     200-208 over the grass) -- the 9-row cap the HUD's FontIndex 0 has at
##     its 12 px em (UiBuilder.FONT_SIZES; docs/rounds/ui.md), so the name is
##     drawn in the client's face at 12 px (the face itself INFERRED: the
##     text call under FUN_008b4d90 is not traced);
##   - a darker box behind the text, 2 px wider than the ink on each side and
##     16 rows tall (4 above the cap top, 1 below the descender): the ground
##     inside it is 0.71 of the ground just outside it in every channel
##     ((161,123,69) -> (115,88,46)), i.e. black at alpha 0.29;
##   - the same size near and far (screen space; READ, NamePlates).
## Drawn 1:1: the plate's pixel_size makes one glyph texel one screen pixel
## times the UI scale (fixed_size: a font pixel spans pixel_size x depth world
## units, and the screen is 2 depth tan(fov/2) tall), the glyphs rasterised
## at the UI scale as the HUD's are (round 672) and sampled NEAREST. The
## other plates (players, NPCs) keep their look: the picture shows monsters.
const MONSTER_NAME_COLOUR := Color(1.0, 1.0, 1.0)
const MONSTER_NAME_BOX_COLOUR := Color(0.0, 0.0, 0.0, 0.29)
const MONSTER_NAME_BOX_PAD_PX := 2.0
const MONSTER_NAME_BOX_HEIGHT_PX := 16.0
const MONSTER_NAME_BOX_RAISE_PX := 1.0
## The monster plates whose pixel_size follows the screen.
const MONSTER_PLATE_GROUP := "monster_name_plates"
## [window height, UI scale, camera fov] the monster plates were last sized
## for; _step_monster_plate_scale re-sizes them when any changes.
var _monster_plate_basis := Vector3.ZERO

func _monster_name_look(label: Label3D) -> void:
	label.modulate = MONSTER_NAME_COLOUR
	label.outline_size = 0
	var font: Font = _ui_builder.font_at(0) if _ui_builder != null else null
	if font != null:
		label.font = font
	label.font_size = UiBuilder.FONT_SIZES[0]
	label.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	label.pixel_size = _monster_plate_pixel_size()
	label.add_to_group(MONSTER_PLATE_GROUP)
	var box := Sprite3D.new()
	box.name = "NameBox"
	box.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	box.fixed_size = true
	box.no_depth_test = true
	box.shaded = false
	box.modulate = MONSTER_NAME_BOX_COLOUR
	# Under the text: a lower render priority among the transparent overlays.
	box.render_priority = label.render_priority - 1
	box.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	label.add_child(box)
	_fit_monster_name_box(label)

## The box behind a monster's name: the text's own width plus the padding,
## MONSTER_NAME_BOX_HEIGHT_PX tall, in the plate's font pixels (which the
## plate's pixel_size makes screen pixels x the UI scale).
func _fit_monster_name_box(label: Label3D) -> void:
	var box := label.get_node_or_null("NameBox") as Sprite3D
	if box == null:
		return
	var font: Font = label.font if label.font != null else ThemeDB.fallback_font
	var w := int(ceil(font.get_string_size(label.text, HORIZONTAL_ALIGNMENT_LEFT, -1, label.font_size).x + 2.0 * MONSTER_NAME_BOX_PAD_PX))
	var h := int(MONSTER_NAME_BOX_HEIGHT_PX)
	var key := "%dx%d" % [w, h]
	var tex: Texture2D = _monster_name_box_textures.get(key)
	if tex == null:
		var img := Image.create(maxi(w, 1), h, false, Image.FORMAT_RGBA8)
		img.fill(Color.WHITE)
		tex = ImageTexture.create_from_image(img)
		_monster_name_box_textures[key] = tex
	box.texture = tex
	box.pixel_size = label.pixel_size
	_fit_party_mark(label, label.get_node_or_null("PartyMark") as Sprite3D)
	# Centred on the plate the box sat one row low against the picture (3 rows
	# above the cap top and 2 below the descender, MEASURED in round 673's
	# render, against retail's 4 and 1): one font pixel up.
	box.offset = Vector2(0.0, MONSTER_NAME_BOX_RAISE_PX)
var _monster_name_box_textures := {}

## One font pixel = one screen pixel x the UI scale, for a fixed-size plate
## under the current camera (fov is the vertical angle: Camera3D's default
## KEEP_HEIGHT) and window.
func _monster_plate_pixel_size() -> float:
	var cam := get_viewport().get_camera_3d() if is_inside_tree() else null
	var fov := cam.fov if cam != null else 75.0
	var height := float(get_window().size.y) if is_inside_tree() else 720.0
	return 2.0 * tan(deg_to_rad(fov) * 0.5) / maxf(height, 1.0) * _ui_scale_now()

## The UI scale in effect: the window's content scale, which
## ClientSettings.apply_ui_scale sets (read from memory, not the settings
## file, since it is asked every frame).
func _ui_scale_now() -> float:
	return get_window().content_scale_factor if is_inside_tree() else 1.0

## Once a rendered frame: re-sizes every monster plate (and its box) when the
## window height, the UI scale or the camera's fov changed. Three
## comparisons a frame otherwise.
func _step_monster_plate_scale() -> void:
	var cam := get_viewport().get_camera_3d()
	var basis := Vector3(float(get_window().size.y), _ui_scale_now(), cam.fov if cam != null else 75.0)
	if basis == _monster_plate_basis:
		return
	_monster_plate_basis = basis
	var size := _monster_plate_pixel_size()
	for node in get_tree().get_nodes_in_group(MONSTER_PLATE_GROUP):
		var plate := node as Label3D
		if plate == null:
			continue
		plate.pixel_size = size
		_fit_monster_name_box(plate)

## Where a name sits over a model, how large it draws, and in what colour.
##
## Ours, not recovered: nothing in the archive places a name plate, because
## the client draws them in screen space rather than as scene geometry.
## The clearance is a fraction of the model's own height, so it works for a
## creature of any size rather than only for a human-sized one.
const NAME_PLATE_CLEARANCE_FRACTION := 0.12
const NAME_PLATE_PIXEL_SIZE := 0.0004
const NAME_PLATE_COLOUR := Color(1.0, 0.94, 0.72)
const NAME_PLATE_OUTLINE := 8
const NAME_PLATE_OUTLINE_COLOUR := Color(0.0, 0.0, 0.0, 0.85)
## How near an entity has to be TO THE PLAYER before its name shows, in world
## units: retail's 300 (READ, NamePlates.RANGE; round 673). Until round 673
## this was 80 from the CAMERA with a fade over the last tenth -- a project
## choice that hid a monster's name when the camera pitched or zoomed away
## from it. The debug panel's slider changes it live (set_name_plate_range).
const NAME_PLATE_RANGE := NamePlates.RANGE
var _name_plate_range := NAME_PLATE_RANGE
## Every name plate, tested against the player a share a frame (NamePlates.Sweep).
var _plate_sweep := NamePlates.Sweep.new()

## No bar over a monster's head (round 673). The red bar this client drew
## there since 2026-08 was ours (its colours and size "a disclosed choice"),
## and the user asked for it gone. Retail's own over-head gauge is a smaller,
## optional one: CICharactor vslot 38 (0x9d0da0, the name pass's sibling)
## draws an HP (and MP) gauge only under the option flags it tests
## (FUN_00b94b90 on 0xeef6f0 / 0xef1a84 / 0xef1bc0) and within the same 300
## units of the player as the name (FUN_009cef40, READ) -- not built here;
## docs/TODO.md. A monster's health shows in the target window (HudTarget).

## The target window: whatever the player has clicked, at the top of the
## screen. Built by HudTarget from the client's own layouts
## (iftargetwindow + iftw_commonenemy / iftw_specialmob), placing itself
## centred at the top as CIFTargetWindow does; shown on click/attack, updated
## on damage, hidden on death or when nothing is targeted. Everything it
## shows is the server's snapshot -- see hud_target.gd for the recovery.
var _hud_target: HudTarget = null
## Every owner's active buffs, from OpBuffStart / OpBuffEnd for the whole zone
## (round 638): what the target window's buff viewer shows for the selected
## monster or player (HudTargetBuffs.Book; retail keeps them on each object,
## 0xB0BD -> 0x9cd050).
var _target_buff_book := HudTargetBuffs.Book.new()
## Every object's abnormal states, from OpObjectStatus (round 659, StatusNet;
## retail's 0x3057 stores the mask on the object, +0x2c4): owner key ->
## {"mask": int, "levels": bit -> level}. The buff viewer shows them after
## the owner's skill buffs (_owner_buffs_and_states).
var _abnormal_states := {}

## The viewer's list for an owner: its buffs, then its abnormal states.
func _owner_buffs_and_states(owner_key: String) -> Array:
	var out: Array = _target_buff_book.list_of(owner_key)
	var st: Dictionary = _abnormal_states.get(owner_key, {})
	if not st.is_empty():
		out.append_array(HudTargetBuffs.abnormal_entries(int(st["mask"]), st["levels"]))
	return out

func _on_object_status(st: StatusNet.ObjectStatus) -> void:
	var key := _fx_owner_key(st.owner_id, st.owner_kind)
	if st.mask == 0:
		_abnormal_states.erase(key)
	else:
		_abnormal_states[key] = {"mask": st.mask, "levels": st.levels}
	var labels := PackedStringArray()
	for bit in StatusNet.drawn_bits(st.mask):
		labels.append(StatusNet.label(bit))
	print("World3D: %s abnormal mask 0x%x [%s]" % [key, st.mask, ", ".join(labels)])

func _build_target_window() -> void:
	_hud_target = HudTarget.new(_ui_builder)
	_hud_target.name = "TargetWindow"
	# The buff viewer reads the buff bar's skill index (one parse) and the
	# zone's buffs by owner (round 638).
	if _hud_buff_board != null:
		_hud_target.buff_catalog = _hud_buff_board.catalog
	_hud_target.buff_source = _owner_buffs_and_states
	# CIFTargetWindow::vslot_012's per-frame lookup (round 638 review): a
	# target that no longer exists hides the window, and the selection goes.
	_hud_target.target_exists = _target_exists
	_hud_target.target_lost.connect(func(owner_key: String) -> void:
		_last_attack_target = -1
		_selected_character = -1
		print("World3D: target %s gone -- deselected" % owner_key))
	if not _hud_target.setup():
		# No archive: no window, no stand-in. Keep the node so callers are
		# null-safe through the wrappers below.
		ui_control.add_child(_hud_target)
		return
	# Where it goes is the window's own business: CIFTargetWindow places
	# itself, centred at the top, each time it shows a target (HudTarget.place,
	# read at 0x69a161). The registry's 442,10 is not used.
	_hud_target.closed.connect(func() -> void:
		_last_attack_target = -1
		_selected_character = -1)
	ui_control.add_child(_hud_target)

## The target-window rank icon for a rarity -- kept as the one place callers
## already use; the mapping lives with the window now.
func _rank_icon_path(rarity: int) -> String:
	return HudTarget.rank_icon_path(rarity)

## Shows the target window for a monster id, or hides it if the id is not a
## known live monster.
func _show_target(monster_id: int) -> void:
	# A monster selection replaces a selected player (round 622).
	_selected_character = -1
	if _hud_target == null:
		return
	var snap = _monster_snapshots.get(monster_id)
	if snap == null:
		_hud_target.clear()
		return
	_hud_target.show_target(snap.monster_name, snap.level, snap.rarity, snap.hp, snap.max_hp,
		_fx_owner_key(monster_id, SkillNet.OWNER_MONSTER), snap.party)

## The ring on the ground (round 698), made on first use: a child of the
## world, drawn over the RealTerrain_ groups with Media.pk2's select art.
func _markers() -> GroundMarkers:
	if _ground_markers == null or not is_instance_valid(_ground_markers):
		_ground_markers = GroundMarkers.new()
		_ground_markers.name = "GroundMarkers"
		_ground_markers.setup(self, _grid, _marker_texture, _marker_target_position)
		add_child(_ground_markers)
	return _ground_markers

## A monster clicked (or a QA stand-in for the click): the ring under it
## (round 698; FUN_00778650 from the object click: texture 3). Not from
## _show_target, which also re-shows the window for a cast at the selection --
## retail's casts do not reselect, so a ring a ground click moved stays there.
func _ring_on_monster(monster_id: int) -> void:
	if _monster_snapshots.has(monster_id) or _monster_bodies.has(monster_id):
		_markers().attach("monster:%d" % monster_id, GroundMarkers.Kind.MONSTER)

## A select_0N.ddj out of Media.pk2, or null without the archive.
func _marker_texture(path: String) -> Texture2D:
	if _media_pk2 == null:
		return null
	var entry := ObjectLoader.find_file(_media_pk2, path)
	if entry == null:
		print("World3D: %s not in Media.pk2 -- no ground ring" % path)
		return null
	var parsed := DdjReader.parse(_media_pk2.read_file(entry))
	return DdjReader.to_texture(parsed) if parsed != null else null

## Where the ring's followed object stands now, or null when it is gone or
## not drawn (CIODecal::vslot_009's two hide tests, round 698).
func _marker_target_position(key: String) -> Variant:
	var parts := key.split(":")
	if parts.size() != 2 or not parts[1].is_valid_int():
		return null
	var id := int(parts[1])
	var node: Variant = null
	match parts[0]:
		"monster":
			node = _monster_bodies.get(id)
		"player":
			node = _other_bodies.get(id)
		"npc":
			node = instance_from_id(id)
	if node == null or not is_instance_valid(node) or not (node is Node3D):
		return null
	var n := node as Node3D
	if not n.is_inside_tree() or n.is_queued_for_deletion() or not n.is_visible_in_tree():
		return null
	return n.global_position

func _set_target_hp(hp: int, max_hp: int) -> void:
	if _hud_target != null:
		_hud_target.set_hp(hp, max_hp)

func _clear_target() -> void:
	if _hud_target != null:
		_hud_target.clear()

# How far the number climbs while it fades, in world units. Scaled by
# PLAYER_SCALE_RATIO like every other height here (a character is about
# 2 * PLAYER_SCALE_RATIO tall, not 1.8), or the rise would be imperceptible
# in this world's real scale. About three-quarters of a character height.
const FLOAT_TEXT_RISE := 1.5 * PLAYER_SCALE_RATIO
const FLOAT_TEXT_SECONDS := 1.1
const DAMAGE_DEALT_COLOUR := Color(1.0, 1.0, 0.95)
const DAMAGE_TAKEN_COLOUR := Color(1.0, 0.45, 0.35)

## A damage number that rises and fades over the thing it was dealt to, the
## way the original shows combat damage. White for damage the player deals,
## a warm red for damage the player takes. Fixed-size and billboarded like
## the name plates so it reads at any distance; it frees itself when done.
func _floating_damage(anchor: Node3D, height: float, amount: int, colour: Color) -> void:
	# Not in the scene (a body being freed, or a headless test's bare node):
	# nothing would show, and the tween below needs this node in the tree.
	if anchor == null or not is_instance_valid(anchor) or not anchor.is_inside_tree():
		return
	var label := Label3D.new()
	label.text = str(amount)
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	label.fixed_size = true
	label.pixel_size = NAME_PLATE_PIXEL_SIZE * 1.8
	label.modulate = colour
	label.outline_size = NAME_PLATE_OUTLINE
	label.outline_modulate = NAME_PLATE_OUTLINE_COLOUR
	label.no_depth_test = true
	label.render_priority = 3
	label.position = Vector3(0.0, height, 0.0)
	anchor.add_child(label)
	# During a QA attack render, log where the number landed on screen, so a
	# frame crop can be aimed at it rather than hunted for. Off in real play.
	if _qa_attacking:
		var cam := get_viewport().get_camera_3d()
		if cam != null:
			var sp := cam.unproject_position(anchor.global_position + Vector3(0.0, height, 0.0))
			print("World3D: FLOAT %d over %s at screen %.0f,%.0f" % [amount, anchor.name, sp.x, sp.y])
	var tween := create_tween()
	tween.set_parallel(true)
	tween.tween_property(label, "position:y", height + FLOAT_TEXT_RISE, FLOAT_TEXT_SECONDS)
	tween.tween_property(label, "modulate:a", 0.0, FLOAT_TEXT_SECONDS)
	# The outline carries its own alpha, so fade it with the fill or a black
	# ghost of the number lingers after the text has gone.
	tween.tween_property(label, "outline_modulate:a", 0.0, FLOAT_TEXT_SECONDS)
	tween.finished.connect(label.queue_free)

## The height a floating number starts at over a monster: just under its
## name, where its HP bar sat until round 673 (MONSTER_TEXT_UNDER_NAME of the
## name's height, OURS, unchanged), or a default when it has no name plate.
const MONSTER_TEXT_UNDER_NAME := 0.9
func _monster_text_height(monster_id: int) -> float:
	var body = _monster_bodies.get(monster_id)
	if body != null and is_instance_valid(body):
		var label := (body as Node3D).get_node_or_null("Label") as Node3D
		if label != null:
			return label.position.y * MONSTER_TEXT_UNDER_NAME
	# Every spawned monster gets a name plate, so this fallback is rare; human
	# head height (same PLAYER_SCALE_RATIO calibration) beats an unscaled
	# constant that would sit at the monster's feet in this world's scale.
	return 2.0 * PLAYER_SCALE_RATIO

## Changes how near an entity has to be to the player before its name shows,
## for every plate already in the scene (re-tested on the next frame) and
## every one made from now on.
func set_name_plate_range(distance: float) -> void:
	_name_plate_range = maxf(distance, 0.0)
	_plate_sweep.reach = _name_plate_range
	_plate_sweep.retest_all()

## The top of an assembled skeleton, in its own local space.
func _skeleton_top(skeleton: Skeleton3D) -> float:
	return _skeleton_bounds(skeleton).y

## An assembled skeleton's own extent, as (horizontal radius, height).
##
## Height is the highest bone. **Radius is half the model's shallower
## horizontal axis**, not its wider one and not the furthest bone: these
## models stand in a bind pose with their arms out, so the widest bone is a
## hand and the furthest-bone radius came out 5 to 9 units on NPCs 10 to 17
## units tall -- a capsule as wide as the NPC is tall, which stops a player
## well short of touching one. The shallower axis is the model's own
## front-to-back thickness, which is what a body is.
##
## Measured from the mesh AABBs rather than the bones for the same reason:
## the bones say where the arms reach, the geometry says how thick the
## torso is.
func _skeleton_bounds(skeleton: Skeleton3D) -> Vector2:
	var aabb := AABB()
	var have := false
	for child in skeleton.get_children():
		if not (child is VisualInstance3D):
			continue
		var box := (child as VisualInstance3D).get_aabb()
		aabb = box if not have else aabb.merge(box)
		have = true
	if not have:
		# No geometry to measure -- fall back to the bones, which at least
		# say how tall the thing is.
		var top := 0.0
		for i in range(skeleton.get_bone_count()):
			if Skeleton3DBuilder.is_skeleton_bone(skeleton, i):
				top = maxf(top, skeleton.get_bone_global_pose(i).origin.y)
		return Vector2(NPC_MIN_RADIUS, top * skeleton.scale.y)
	var depth: float = minf(aabb.size.x, aabb.size.z) * skeleton.scale.x
	return Vector2(depth * 0.5, aabb.end.y * skeleton.scale.y)

## A body that stops the player walking through an NPC.
func _npc_collider(bounds: Vector2) -> StaticBody3D:
	var shape := CapsuleShape3D.new()
	shape.radius = maxf(bounds.x, NPC_MIN_RADIUS)
	shape.height = maxf(bounds.y, NPC_MIN_HEIGHT)
	var body := StaticBody3D.new()
	body.name = "Body"
	body.collision_layer = NPC_COLLISION_LAYER
	# An NPC is something to walk into, not something to stand on or to
	# aim the ground-snap ray at, so it stays off the terrain layer.
	body.collision_mask = 0
	var collider := CollisionShape3D.new()
	collider.shape = shape
	# A capsule is centred on its own origin; the NPC's is at its feet.
	collider.position = Vector3(0.0, shape.height * 0.5, 0.0)
	body.add_child(collider)
	return body

## Reports, for every placed NPC within QA_NPCBODY_RANGE, the capsule it
## was given and whether a ray aimed at its middle actually hits it.
const QA_NPCBODY_RANGE := 400.0

func _qa_npc_body_report() -> void:
	var space := get_world_3d().direct_space_state
	var checked := 0
	var blocked := 0
	for group in get_children():
		if not (group is Node3D) or not group.name.begins_with("RealTerrain_"):
			continue
		for holder in group.get_children():
			if not holder.name.begins_with("Npc_"):
				continue
			var origin: Vector3 = (holder as Node3D).global_position
			if origin.distance_to(player.global_position) > QA_NPCBODY_RANGE:
				continue
			var body := holder.get_node_or_null("Body") as StaticBody3D
			var shape: CapsuleShape3D = null
			if body != null:
				var cs := body.get_node_or_null("CollisionShape3D") as CollisionShape3D
				if cs == null:
					for child in body.get_children():
						if child is CollisionShape3D:
							cs = child as CollisionShape3D
							break
				if cs != null:
					shape = cs.shape as CapsuleShape3D
			checked += 1
			if shape == null:
				print("QA NPCBODY %s: no collider" % holder.name)
				continue
			# From just outside the capsule, aimed at its middle.
			var mid := origin + Vector3(0.0, shape.height * 0.5, 0.0)
			var from := mid + Vector3(shape.radius * 4.0, 0.0, 0.0)
			var query := PhysicsRayQueryParameters3D.create(from, mid)
			query.exclude = [player.get_rid()]
			# Not the gates' pick boxes (round 690's review).
			query.collision_mask = 0xFFFFFFFF & ~GATE_PICK_COLLISION_LAYER
			var hit := space.intersect_ray(query)
			# Any NPC's body counts: two NPCs stand within half a unit of
			# each other on Jangan's square, so a ray aimed at one is
			# legitimately stopped by the other.
			var stopped := false
			if not hit.is_empty():
				var collider: Object = hit["collider"]
				stopped = collider == body or (collider is Node
					and (collider as Node).get_parent() != null
					and (collider as Node).get_parent().name.begins_with("Npc_"))
			if stopped:
				blocked += 1
			print("QA NPCBODY %s: capsule r=%.2f h=%.2f -> %s" % [
				holder.name, shape.radius, shape.height,
				"blocks" if stopped else "ray passed through (hit %s)" % (
					str(hit.get("collider", "nothing")))])
	print("QA NPCBODY: %d of %d NPC(s) within %.0f units stop a ray" % [
		blocked, checked, QA_NPCBODY_RANGE])

func _npc_spawn_total() -> int:
	var n := 0
	for key in _npc_spawns_by_region:
		n += (_npc_spawns_by_region[key] as Array).size()
	return n

## Places every NPC that stands in one region, assembling each from its own
## .bsr the way the player's body is assembled.
##
## Height comes from the walkable graph rather than from npcpos.txt's own Y:
## that column is authored against the real client's terrain, and this
## project's terrain is rebuilt from the same heightmaps but anchored per
## region, so standing them on the graph is what actually puts their feet on
## this ground. The authored Y is kept as the fallback when a region has no
## graph.
##
## The guard below is per loaded region, not per region ever seen: the mark
## is set once the NPCs stand under the region's terrain node and cleared
## when that node is unloaded (`_maybe_stream_regions` -> `_grid.unload`,
## round 563), because the NPCs are its children and are freed with it.
## Until then the mark outlived the node -- the only clearing was the zone
## change's `_clear_region_grid` -- so a town walked away from and back to
## came back with nobody in it.
func _try_spawn_region_npcs(region_x: int, region_y: int) -> void:
	if _grid.npcs_done(region_x, region_y):
		return
	# Cached after the first cell, which pays it whole -- its own lap (round
	# 561), so the centre cell's `npcs` is not read as spawning alone.
	var sw := Time.get_ticks_usec()
	_load_npc_tables()
	_load_timings.lap("npcs", "tables", sw)
	if _npc_spawns_by_region.is_empty():
		return
	var archive := _open_pk2_if_set()
	if archive == null:
		return
	var group := get_node_or_null("RealTerrain_%d_%d" % [region_x, region_y]) as Node3D
	if group == null:
		return
	_grid.mark_npcs_done(region_x, region_y)
	# The region's teleport gates, under the same mark (round 577): both
	# callers have committed the region's objects just before this, so the
	# placed portal is in the tree, and a region streamed out and back in is
	# bound again with its fresh copies. Before the spawn list, which a
	# region with a gate and no NPC would return on.
	_bind_region_gates(region_x, region_y, group)
	var region_pair := _grid.nav_graph_for_region(region_x, region_y)

	var spawns: Array = _npc_spawns_by_region.get("%d_%d" % [region_x, region_y], [])
	if spawns.is_empty():
		return
	var placed := 0
	var skipped := 0
	var named := 0
	var monsters_skipped := 0
	var faced := 0
	var facing_usec := 0
	for spawn in spawns:
		# npcpos is not a table of NPCs: it holds every placed character,
		# monsters included, and placing those here made Mangyangs stand in
		# the fields outside Jangan as talkable NPCs (playtest 2026-09-20,
		# item 1) -- clicking one opened a talk window instead of attacking.
		#
		# The engine's own naming separates them: characterdata's code is
		# `NPC_CH_SMITH` for a shopkeeper and `MOB_CH_MANGNYANG` for a
		# Mangyang. Monsters belong to the server, which spawns them from
		# its own npcpos import (round 253) as real, attackable monsters, so
		# the client must not also place a decorative copy.
		if String(_npc_codes.get(spawn.npc_id, "")).begins_with("MOB_"):
			monsters_skipped += 1
			continue
		var model: String = _npc_models.get(spawn.npc_id, "")
		if model == "":
			skipped += 1
			continue
		# Assemble a model once into a detached template, then duplicate it for
		# each NPC that uses it -- the repeat spawns skip the expensive .bsr
		# assembly and just copy a node (sharing its mesh/texture resources).
		var template: SkinnedBsrAssembler.AssembledCharacter = _npc_model_cache.get(model)
		if template == null:
			template = SkinnedBsrAssembler.assemble_from_archive(archive, model, true)
			if template == null:
				skipped += 1
				continue
			_npc_model_cache[model] = template
		var skeleton := template.skeleton.duplicate() as Skeleton3D
		if skeleton == null:
			skipped += 1
			continue
		var idle_anim: BanReader.ParsedAnimation = template.idle_animation
		var holder := Node3D.new()
		holder.name = "Npc_%d_%d" % [spawn.npc_id, placed]
		var local: Vector3 = spawn.local_position
		var height: float = local.y
		var npc_graph: NavGraph = null
		if not region_pair.is_empty():
			npc_graph = region_pair[0] as NavGraph
			# The authored Y is passed as the mover's height, not
			# discarded: height_at resolves several stacked walkable
			# surfaces by picking the one nearest the mover, and asking
			# from 0 puts anyone standing on a raised deck underneath it.
			# Jangan's octagonal plaza is a placed object, so every NPC
			# on the town square came out buried in it.
			height = npc_graph.landing_height_at(local.x, local.z)
		holder.position = Vector3(local.x, height, local.z)
		# Which way it faces is a DISCLOSED STAND-IN: the game's value is
		# Tab_RefNest.wInitialDir, server-database data no shipped file
		# carries (see NpcFacing). Facing the most open space on the region's
		# own navigation graph beats every NPC facing the same authored way;
		# an NPC with open space all round keeps the old facing.
		if npc_graph != null:
			var facing_started := Time.get_ticks_usec()
			var standing_on := npc_graph.surface_at(local.x, local.z, height).object_index
			var facing := NpcFacing.open_direction(npc_graph, holder.position, standing_on)
			if facing != Vector2.ZERO:
				holder.rotation.y = NpcFacing.holder_yaw(facing)
				faced += 1
			facing_usec += Time.get_ticks_usec() - facing_started
		holder.add_child(skeleton)
		var bounds := _skeleton_bounds(skeleton)
		# Its idle is posed only while seen (round 655, MonsterDraw).
		skeleton.set_meta(MonsterDraw.META_CULL, true)
		skeleton.set_meta(MonsterDraw.META_RADIUS, MonsterDraw.cull_radius(skeleton, maxf(bounds.x, bounds.y)))
		holder.add_child(_npc_collider(bounds))
		var npc_name: String = _npc_names.get(spawn.npc_id, "")
		# Tagged so a click on the collider can name the NPC it talks to
		# (see _try_talk_to_npc) -- the plate is a Label3D, no use for that.
		holder.set_meta("npc_id", spawn.npc_id)
		holder.set_meta("npc_name", npc_name if npc_name != "" else "")
		holder.set_meta("npc_code", _npc_codes.get(spawn.npc_id, ""))
		if npc_name != "":
			holder.add_child(_name_plate(npc_name, bounds.y))
			named += 1
		group.add_child(holder)
		_animate_skeleton(skeleton, idle_anim)
		placed += 1
	print("World3D: %d/%d NPC(s) placed in %d/%d (%d had no model, %d named, %d monster rows left to the server; %d faced toward open space in %.1f ms)" % [
		placed, spawns.size(), region_x, region_y, skipped, named, monsters_skipped, faced, facing_usec / 1000.0])

## Makes each town's Dimensional Gate standing in a region clickable (round
## 577; retail's pick box since round 690).
##
## **What retail does (READ, round 690, sro_client.exe):**
## - A town gate is a teleportbuilding row of TypeID 4/1/1, and the client
##   creates it as a `CITeleportGate`: `IGIDObject::FUN_009c1fa0` picks the
##   runtime class from the type, and its predicate `FUN_009c1ca0` --
##   non-bionic, TypeID1 4, TypeID2 1 -- selects the class registered as
##   "CITeleportGate" (0xde47b4, parent "CIRuntimeStruct").
## - Its click test is a box from its ref record: `CITeleportGate::vslot_025`
##   (0x9e9eb0) sets min (-r, -h, -r) and max (r, h, r) at +0x280..+0x294 with
##   r = the record's +0x118 and h = its +0x114, which the _RefObjCommon
##   parser (`FUN_00972910`, teleportbuilding's loader `Client_LoadRefDataFile`
##   type 0x14) fills from columns 50 (BCRadius) and 49 (BCHeight)
##   (TeleportReader.TB_BC_RADIUS / TB_BC_HEIGHT). `vslot_033` (0x9e9b60)
##   writes the object's position into an identity matrix's translation and
##   calls the ray-vs-box test `FUN_00a5b000`: the box is centred on the
##   position and never turns with the gate's yaw.
## - The mouse pick `FUN_0078ee20` walks the object list and keeps the
##   nearest box a click ray meets. No model, placed map object or navmesh is
##   part of it; a plain `CIRuntimeStruct` answers the miss value
##   (`FUN_00535520`), so a gate is clickable where its box is and nowhere
##   else. (It casts a 3 x 3 grid of rays a little apart around the cursor;
##   any nearer hit replaces the best, and a centre hit replaces a best from
##   an outer ray whatever its distance -- `d < best || (best_idx != 4 &&
##   idx == 4)`. srrevamp casts the centre ray only -- OPEN.)
## - The position is the structure's spawn position. INFERRED: the server
##   spawns the structure at its teleportbuilding row (columns 41, 43-45), as
##   GObjPC::IsWithinInteractionRange measures from it (round 642).
##
## So for each id-7 gate standing in the region (Point.interaction7 -- round
## 577's rule: exactly the seven town gates, STORE_CH/WC/KT/EU/CA_GATE and
## Alexandria's STORE_SD_GATE1/2), a `GatePick_<code>` node at the building's
## table position carries the talk tags (`npc_name`, `npc_code`,
## `gate_point_id`) and one StaticBody3D with that box, axis-aligned in the
## world (its basis undoes the region group's z mirror), on
## GATE_PICK_COLLISION_LAYER alone. Not the talk layer: that is the
## navmesh-wall bit the player's body masks, and the box is a click target,
## never a wall. The talk ray (_talk_ray) masks both.
##
## **Until round 690** the gate was the placed map object nearest its table
## point within 10 units (round 577's disclosed stand-in), with every piece of
## it on the talk layer: in Jangan the whole pavilion took clicks (147 units
## across), and Alexandria North's portal, placed 15.1 units from its point,
## was never bound -- not clickable since teleporters were added (MEASURED,
## round 690). A row without a box (BCRadius or BCHeight 0) is left
## unclickable, as retail's would be, and the log says so.
func _bind_region_gates(region_x: int, region_y: int, group: Node3D) -> void:
	if _teleport_reader == null:
		return
	for building_v in _teleport_reader.buildings_in_region(region_x, region_y):
		var building: TeleportReader.Building = building_v
		var point := _teleport_reader.point_for_building(building.code)
		if point == null or not point.interaction7:
			continue
		var pick := _gate_pick_node(building, point, group)
		if pick == null:
			print("World3D: teleport gate %s has no bounding box in teleportbuilding (BCRadius %.0f, BCHeight %.0f) -- not clickable" % [
				building.code, building.bc_radius, building.bc_height])
			continue
		_gate_bindings[building.code] = {"rx": region_x, "ry": region_y, "node": pick}
		print("World3D: teleport gate %s clickable at %d/%d local (%.0f, %.0f, %.0f): its BCRadius %.0f / BCHeight %.0f box, world %s (point %d)" % [
			building.code, region_x, region_y, building.x, building.y, building.z, building.bc_radius, building.bc_height,
			str(pick.global_position.round() if pick.is_inside_tree() else (_chain_transform(group) * Vector3(building.x, building.y, building.z)).round()), point.id])

## A town gate's pick box layer (round 690): its own bit (10), which only the
## talk ray masks -- nothing walks into it, no camera or ground ray meets it.
const GATE_PICK_COLLISION_LAYER := 0b1000000000 # layer 10 only

## The town gates of the loaded regions: building code -> {"rx", "ry" (the
## building's region), "node" (its GatePick_<code> node)}. Set by
## _bind_region_gates, cleared with the grid (_clear_region_grid); a region
## streamed out takes its node with it.
var _gate_bindings := {}

## Builds a gate's pick node (see _bind_region_gates) under `group`, the
## building region's terrain group, whose frame the table's region-local
## position is in (a placed object's y is its raw height in that frame too).
## null when the row has no box. A node of the same name already there is
## replaced.
func _gate_pick_node(building: TeleportReader.Building, point: TeleportReader.Point, group: Node3D) -> Node3D:
	if building.bc_radius <= 0.0 or building.bc_height <= 0.0:
		return null
	var node_name := "GatePick_%s" % building.code
	var old := group.get_node_or_null(node_name)
	if old != null:
		group.remove_child(old)
		old.queue_free()
	var node := Node3D.new()
	node.name = node_name
	var frame := _chain_transform(group)
	var at := frame * Vector3(building.x, building.y, building.z)
	node.transform = frame.affine_inverse() * Transform3D(Basis.IDENTITY, at)
	node.set_meta("npc_name", _gate_display_name(building))
	node.set_meta("npc_code", building.code)
	node.set_meta("gate_point_id", point.id)
	var body := StaticBody3D.new()
	body.name = "PickBox"
	body.collision_layer = GATE_PICK_COLLISION_LAYER
	body.collision_mask = 0
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(building.bc_radius * 2.0, building.bc_height * 2.0, building.bc_radius * 2.0)
	shape.shape = box
	body.add_child(shape)
	node.add_child(body)
	group.add_child(node)
	return node

## The placed object whose origin is nearest `spot` (a world point) in x/z,
## within `radius`, over the children of `containers`: {"node", "distance"},
## or {} when none. Positions are composed up the tree by hand
## (_chain_transform), so this holds for nodes outside the tree too.
static func _nearest_placed_object(containers: Array, spot: Vector3, radius: float) -> Dictionary:
	var best: Node3D = null
	var best_d := radius
	for c in containers:
		if not is_instance_valid(c) or (c as Node).is_queued_for_deletion():
			continue
		var container := c as Node3D
		if container == null:
			continue
		var frame := _chain_transform(container)
		for child in container.get_children():
			var node := child as Node3D
			if node == null:
				continue
			var at := frame * node.position
			var d := Vector2(at.x, at.z).distance_to(Vector2(spot.x, spot.z))
			if d <= best_d:
				best_d = d
				best = node
	if best == null:
		return {}
	return {"node": best, "distance": best_d}

## What a gate is called: its building's name string (SN_NPC_CH_GATE) through
## textdata_object, as an NPC's is; "" when the row has none ("xxx") or the
## table does not name it -- the talk window then shows "...".
func _gate_display_name(building: TeleportReader.Building) -> String:
	var names := _object_names()
	if names == null or not names.has(building.name_strid):
		return ""
	var text := names.get_text(building.name_strid).strip_edges()
	return "" if text == building.name_strid else text

## Loads real terrain from a real Map.pk2 region .m file via MapmReader +
## MapmTerrainBuilder, replacing both the placeholder ground's visual mesh
## and its collision shape (see this file's top comment) -- if
## SRREVAMP_MAPM_PATH is set. Accepts either a loose file path or a path
## inside SRREVAMP_MAP_PK2_PATH (see AssetSource). Skips gracefully
## otherwise. path_override/texture_override let _reload_zone_assets pass
## real per-zone paths it resolved itself instead of reading the env vars --
## empty (the default) preserves the original env-var-only behavior for
## _ready()'s own call. world_offset/node_suffix/snap_player let
## _load_region_neighborhood place multiple of these side by side as a real
## multi-region grid instead of always the one env-var-driven region at the
## scene origin -- defaults preserve the original single-region behavior.
##
## shared_vertical_anchor (NAN by default) is the fix for a real bug found
## live (2026-08-22): without it, *every* tile independently forces its own
## near-row-middle vertex to world Y=0 (see the vertical-offset comment
## below), which guarantees a cliff at *every* seam between two tiles in the
## grid, since neighboring tiles' real height data has no known relationship
## to begin with -- confirmed live to trap the camera inside overlapping
## geometry. Passing the center tile's own near_height as every other
## tile's anchor instead means only the center tile still calibrates itself
## to Y=0; every neighbor renders at whatever height its own real data
## implies *relative to that one shared reference* rather than each also
## independently resetting to zero. This doesn't (and can't, without real
## cross-region alignment data this project doesn't have) make neighboring
## tiles seamlessly continuous -- real per-tile terrain remains genuinely
## steep on its own (confirmed live even for a single region, see
## MAPM_FORMAT.md) -- it just stops the grid from *compounding* that with a
## guaranteed reset at every single seam. Returns the near_height this call
## used (NAN on any failure path) so a caller building a grid can capture
## the center tile's value and pass it to every other cell.
func _try_load_real_terrain(path_override: String = "", texture_override: String = "", world_offset: Vector3 = Vector3.ZERO, node_suffix: String = "", snap_player: bool = true, shared_vertical_anchor: float = NAN, apply_environment_lighting: bool = true) -> float:
	var mapm_path := path_override if path_override != "" else OS.get_environment("SRREVAMP_MAPM_PATH")
	if mapm_path == "":
		print("World3D: SRREVAMP_MAPM_PATH not set -- ground stays a placeholder")
		return NAN

	# Both halves on this thread (round 565: see _terrain_prepare), in the
	# order the one function ran them before the split: the region read and
	# parsed; then -- the grid's centre only -- its environment applied, since
	# only the player's own region drives the real sky colour (a neighbouring
	# streamed-in region's own EnvironmentID, not confirmed to always match
	# its neighbours', would otherwise overwrite it with whichever cell loaded
	# last) and the mesh bakes that environment's light; then the rest of the
	# prepare, and the commit. A streamed cell runs the same prepare on a
	# WorkerThreadPool task instead (_dispatch_cell).
	var job := _terrain_job(mapm_path, texture_override, world_offset, node_suffix, snap_player, shared_vertical_anchor, apply_environment_lighting)
	var read_ok := _terrain_prepare_read(job)
	_record_prepare_laps(job)
	if read_ok:
		if apply_environment_lighting:
			var sw := Time.get_ticks_usec()
			_apply_real_environment_lighting(job["region"], job["map_pk2"])
			_terrain_light_into(job)
			_load_timings.lap("terrain", "env", sw)
		_terrain_prepare_build(job)
		_record_prepare_laps(job)
	return _terrain_commit(job)

## Terrain prepared off the main thread (round 565).
##
## A region's terrain is built in two halves. The PREPARE half -- this
## function: the `.m` read and parsed, the `.t` lightmap and the ground tiles
## decoded to Images, the mesh surfaces and the collision's height grid as
## arrays (MapmTerrainBuilder.build_full_region_surfaces_textured,
## TerrainCollision.heights_from_region -- round 567; the trimesh's faces,
## surface_faces, until then and under SRREVAMP_TERRAIN_TRIMESH=1),
## the navmesh read and parsed, the wall triangles and the walkable graph
## (NavGraph.build) -- produces plain data, and a streamed cell runs it on a
## WorkerThreadPool task (_dispatch_cell). The COMMIT half -- _terrain_commit:
## the ImageTextures, the ArrayMesh and its materials, the nodes, the
## collision shape, the walls' shape, the water and the graph's registration
## -- builds everything that owns a RenderingServer or PhysicsServer RID or
## touches the tree, on the main thread. Until round 565 all of it ran on the
## main thread inside one frame (docs/WORLD_ISSUES.md, round 154: "it does
## not thread the build, so a very heavy cell can still hitch"); round 561's
## crossing benchmark measured one ~300 ms frame per streamed cell, ~250 ms of
## it terrain and ~125 ms of that the mesh (client/tools/README.md, "Load
## benchmark").
##
## THE PREPARE-THREAD RULE (client/tools/README.md, "Load benchmark", has it
## too). The prepare constructs NO Node and NO RID-owning Resource -- no
## MeshInstance3D, StaticBody3D, ArrayMesh, Material, ImageTexture or
## Shape3D; Images, packed arrays, Arrays, Dictionaries and the readers'
## RefCounted structs only -- touches neither the scene tree nor the
## RenderingServer nor the PhysicsServer, and reads the archives only through
## Pk2Reader, whose reads are behind a per-handle lock since this round. It is
## static, so it cannot reach this node's state: every cache it consults is
## snapshotted into the job on the main thread before dispatch (_terrain_job),
## it writes nothing but the job, and it prints none of its own lines (they go
## in the job for the commit to print, in order). The readers it calls may
## still push_error from the task on a malformed file -- DdjReader.to_image's
## "failed to build Image", MapmTerrainBuilder's "region has N blocks", the
## MapmReader and NvmReader parse errors (round 565's review; the rule was
## worded "prints nothing" until round 568). The grounding: Godot 4.2's
## "Thread-safe APIs" page -- "Interacting with the active scene tree is NOT
## thread-safe"; building scene chunks outside the tree and loading
## resources on a thread are supported; "Accessing servers from threads is
## supported (for RenderingServer and Physics servers, ensure threaded or
## thread-safe operation is enabled in the project settings!)".
## client/project.godot sets neither, so both are at 4.2.2's defaults (read
## on the render box, round 565: rendering/driver/threads/thread_model 1,
## Single-Safe; physics/3d/run_on_separate_thread false): the physics server
## is not threaded at all, and under Single-Safe a RenderingServer call from
## another thread is -- this item's grounding verifier's reading, not
## measured here -- queued for the main thread and waited on, a deadlock
## while the main thread waits for the task (_drop_cell_jobs, the QA drain).
## The rule keeps the worker away from both.
## terrain_prepare_test.gd walks a prepared job and fails on any Node or
## Resource in it other than an Image.
##
## What the commit still costs the main thread is measured per cell (its laps
## in the `built in` line); the objects and NPC phases stayed synchronous in
## this round and ran in the commit's frame, after the terrain group exists.
## Round 566 moved the objects' prepare onto the same task, after this one
## (_cell_prepare, _objects_prepare); their commit and the NPCs still run in
## the commit's frame.
static func _terrain_prepare(job: Dictionary) -> void:
	if _terrain_prepare_read(job):
		_terrain_prepare_build(job)

## A lap of the prepare half: into the job as [name, usec], not into
## _load_timings, which is the main thread's -- the commit hands them on
## (_record_prepare_laps), as main-thread phases for a job prepared on the
## main thread and as off-thread ones for a task's.
static func _job_lap(job: Dictionary, name: String, since_usec: int) -> int:
	var now := Time.get_ticks_usec()
	(job["laps"] as Array).append([name, now - since_usec])
	# The same lap, by thread, in the PARSEPROF table (round 670): what ranks
	# the prepare's own loops beside the parsers they call.
	if ParseProfile.enabled:
		ParseProfile.add(("prep.objects." if job.has("mapo_path") else "prep.terrain.") + name, since_usec)
	return now

## The prepare's first half: the region's `.m` read and parsed into
## job["region"]. False, with the error the commit prints, when there is no
## terrain to build.
static func _terrain_prepare_read(job: Dictionary) -> bool:
	var mapm_path: String = job["mapm_path"]
	var sw := Time.get_ticks_usec()
	var bytes := AssetSource.read_bytes(mapm_path, job["map_pk2"])
	sw = _job_lap(job, "read", sw)
	if bytes.is_empty():
		job["error"] = "World3D: could not find terrain at %s" % mapm_path
		job["prepared"] = true
		return false
	var region := MapmReader.parse(bytes)
	_job_lap(job, "parse", sw)
	if region == null:
		job["error"] = "World3D: could not parse terrain at %s" % mapm_path
		job["prepared"] = true
		return false
	job["region"] = region
	return true

## The prepare's second half, over job["region"]: the lightmap, the ground
## tiles, the mesh surfaces, the collision's height grid (or, under
## SRREVAMP_TERRAIN_TRIMESH=1, the trimesh's faces), the navmesh, the wall
## triangles and the walkable graph. Sets job["prepared"] last, so a commit
## can tell a task that finished from one a script error ended.
static func _terrain_prepare_build(job: Dictionary) -> void:
	var mapm_path: String = job["mapm_path"]
	var region: MapmReader.ParsedRegion = job["region"]
	var sw := Time.get_ticks_usec()
	# Real .t lightmap, read up front so it is there for whichever mesh the
	# commit builds -- see _read_terrain_lightmap's doc comment and
	# docs/protocol/MAPT_FORMAT.md. Corrects an earlier same-day attempt that
	# decoded the wrong bytes entirely (before .t's real structure -- a
	# ShadowMap plus a properly-headered embedded DDS -- was found via public
	# documentation) and applied the result as direct detail-albedo color,
	# which looked like broken color-noise static and was reverted. The real
	# embedded texture is a genuine grayscale shadow map (white = fully lit).
	var lightmap := _read_terrain_lightmap(mapm_path, job["map_pk2"])
	# Round 610: what retail multiplies the ground by is the lightmap plus the
	# environment's TerrainShadowColor, saturated (MapmTerrainBuilder.
	# lightmap_term has the assembly); the commit uploads that Image.
	job["lightmap"] = null
	if lightmap != null and lightmap.image != null and job.get("light_shadow_ready", false):
		job["lightmap"] = MapmTerrainBuilder.lightmap_term(lightmap.image, job["light_shadow"])
	job["shadow_map"] = lightmap.shadow_map if lightmap != null else PackedByteArray()
	sw = _job_lap(job, "lightmap", sw)

	# Real per-quad ground textures (2026-08-23) -- see
	# docs/protocol/DDJ_FORMAT.md and MapmTerrainBuilder's top comment for
	# the correction: these actually live in Map.pk2's real Tile2D\
	# folder, an archive/folder an earlier search never checked. Only
	# used if at least one of this region's real texture IDs actually
	# resolved to a real file -- otherwise the flat tile-type color
	# (build_full_region_arrays) is a strictly better fallback than a
	# multi-surface mesh where every single surface is the color fallback
	# anyway.
	_prepare_ground_textures(job, region)
	sw = _job_lap(job, "textures", sw)
	var files: Dictionary = job["texture_files"]
	var textured := not files.is_empty()
	job["textured"] = textured

	# Real, fully deterministic full-region assembly (2026-08-23) -- see
	# MapmTerrainBuilder.build_full_region_mesh's doc comment and
	# MAPM_FORMAT.md. MapmReader now parses a region's real, confirmed 6x6
	# block grid directly (no more row/column guessing), so this always
	# produces the complete real 97x97 grid on a successful parse. As arrays
	# here; the commit builds the mesh. The textured surfaces bake the real
	# per-vertex terrain lighting the way the real client does (see
	# MapmTerrainBuilder._lit_vertex_color), from the light terms the job was
	# given on the main thread (_terrain_light_into).
	var surfaces: Array = []
	if textured:
		surfaces = MapmTerrainBuilder.build_full_region_surfaces_textured(
			region, files, job["light_dir"], job["light_diffuse"], job["light_ambient"], job["shadow_map"])
	else:
		var arrays := MapmTerrainBuilder.build_full_region_arrays(region)
		if not arrays.is_empty():
			surfaces = [{"arrays": arrays, "texture_key": -1, "blend": false, "unshaded": false}]
	sw = _job_lap(job, "mesh", sw)
	if surfaces.is_empty():
		job["error"] = "World3D: parsed %d real blocks from %s but couldn't build a mesh from them" % [region.blocks.size(), mapm_path]
		job["prepared"] = true
		return
	job["surfaces"] = surfaces
	job["near_height"] = MapmTerrainBuilder.near_row_middle_height(region)
	# The collision's data (round 567): the region's height grid, which the
	# commit hands a HeightMapShape3D (TerrainCollision -- the mesh's own
	# grid and triangles). Under SRREVAMP_TERRAIN_TRIMESH=1 (A/B), the
	# trimesh's faces instead, as create_trimesh_shape() would have read them
	# back out of the mesh (MapmTerrainBuilder.surface_faces; `faces` was
	# this lap's name until round 567).
	if job.get("trimesh", false):
		job["faces"] = MapmTerrainBuilder.surface_faces(surfaces)
	else:
		job["heights"] = TerrainCollision.heights_from_region(region)
	sw = _job_lap(job, "heights", sw)

	if not job["navmesh_cached"] and int(job["navmesh_key"]) >= 0:
		job["navmesh"] = _read_region_navmesh(job["data_pk2"], job["navmesh_key"], job["log"])
		job["navmesh_loaded"] = true
	sw = _job_lap(job, "navmesh", sw)
	_prepare_navmesh_walls(job)
	sw = _job_lap(job, "walls", sw)
	_prepare_nav_graph(job)
	_job_lap(job, "navgraph", sw)
	job["prepared"] = true

## A terrain job for mapm_path, built on the main thread (round 565): the
## placement the commit needs, the readers, and a snapshot of every World3D
## cache the prepare consults -- the tile table and the object index (loaded
## here if this is the world's first region; the laps say what that cost),
## which ground-tile files this world already holds and whether each decoded
## (filenames and flags, never the textures: those own RIDs), the region's
## cached navmesh, a copy of the object navigation meshes loaded so far, and
## the baked-light terms. The prepare writes its results into the same
## Dictionary -- see _terrain_prepare for the rule both are held to.
func _terrain_job(mapm_path: String, texture_override: String, world_offset: Vector3, node_suffix: String, snap_player: bool, shared_vertical_anchor: float, apply_environment_lighting: bool) -> Dictionary:
	var sw := Time.get_ticks_usec()
	# Cached after the first cell, which pays it whole: 943 ms of the centre
	# cell's 1590 in the entry benchmark's first run (round 561), against 2
	# ms of lightmap for every neighbour -- its own lap, so a one-time table
	# load is not read as anything else's cost.
	var tile_table := _load_tile_index()
	sw = _load_timings.lap("terrain", "tiletable", sw)
	# The walkable graph's object table, cached the same way. Until round 565
	# the graph loaded it on the main thread when a region's navmesh first
	# listed objects, inside the `navgraph` lap.
	var object_index := _load_object_index()
	sw = _load_timings.lap("terrain", "objindex", sw)
	var coords := _parse_region_coords(mapm_path)
	var navmesh_key := -1
	var navmesh_cached := false
	var navmesh: NvmReader.ParsedRegion = null
	# A front-end backdrop is never walked (round 678's review): no navmesh,
	# so no walls and no walkable graph -- the bulk of a cell's objects and
	# memory, freed again when the screen goes.
	if not coords.is_empty() and not title_mode:
		navmesh_key = RegionGridState.navmesh_key(int(coords["x"]), int(coords["y"]))
		if _grid.navmesh_cache.has(navmesh_key):
			navmesh_cached = true
			navmesh = _grid.navmesh_cache[navmesh_key]
	var known_textures := {}
	for filename in _ground_texture_cache:
		known_textures[filename] = _ground_texture_cache[filename] != null
	var job := {
		"mapm_path": mapm_path,
		"texture_override": texture_override,
		"world_offset": world_offset,
		"node_suffix": node_suffix,
		"snap_player": snap_player,
		"anchor": shared_vertical_anchor,
		"apply_env": apply_environment_lighting,
		"coords": coords,
		"map_pk2": _open_map_pk2_if_set(),
		"data_pk2": _open_pk2_if_set(),
		"tile_table": tile_table,
		"object_index": object_index,
		"known_textures": known_textures,
		"navmesh_key": navmesh_key,
		"navmesh_cached": navmesh_cached,
		"navmesh": navmesh,
		"collisions": _grid.object_collision_cache.duplicate(),
		# The terrain's collision shape: the heightfield (round 567), or the
		# pre-567 trimesh for A/B -- read here, on the main thread, because
		# the prepare is static and may run on a task.
		"trimesh": OS.get_environment("SRREVAMP_TERRAIN_TRIMESH") == "1",
		"threaded": false,
		"dispatched_frame": -1,
		"laps": [],
		"log": [],
	}
	_terrain_light_into(job)
	_load_timings.lap("terrain", "snapshot", sw)
	return job

## The baked-light terms a job's mesh is built with, read on the main thread:
## the directional light's direction converted into the region's own local
## space, where the mesh is built (a terrain group carries scale.z = -1 for
## the world mirror and no rotation, so a world direction's Z simply flips),
## and environment.ifo's diffuse and terrain-ambient colours -- once a
## region's environment has been applied (_apply_real_environment_lighting);
## a zero direction, the engine lighting the terrain, before that.
func _terrain_light_into(job: Dictionary) -> void:
	var light_dir := Vector3.ZERO
	if _env_light_ready and directional_light != null:
		var to_light := directional_light.global_transform.basis.z.normalized()
		light_dir = Vector3(to_light.x, to_light.y, -to_light.z)
	job["light_dir"] = light_dir
	job["light_diffuse"] = _env_light_diffuse
	job["light_ambient"] = _env_terrain_ambient
	# The lightmap term needs the environment's TerrainShadowColor; before a
	# region's environment is applied there is none, and no lightmap is drawn.
	job["light_shadow"] = _env_terrain_shadow
	job["light_shadow_ready"] = _env_light_ready

## Hands a job's prepare laps to _load_timings: main-thread phases for a job
## prepared on this thread, off-thread ones for a task's (LoadTimings.offthread
## -- on the cell line, never in its frame's work). `group` is the terrain's,
## or "objects" for an objects job (round 566).
func _record_prepare_laps(job: Dictionary, group: String = "terrain") -> void:
	var threaded: bool = job["threaded"]
	for lap in job["laps"]:
		if threaded:
			_load_timings.offthread(group, lap[0], lap[1])
		else:
			_load_timings.phase(group, lap[0], lap[1])
	(job["laps"] as Array).clear()

## The commit half of a region's terrain (round 565; see _terrain_prepare):
## on the main thread, from a job the prepare filled, everything that owns a
## RenderingServer or PhysicsServer RID or touches the tree -- the textures,
## the mesh and its materials, the terrain group and its placement, the
## collision shape, the walls, the water, the graph's registration -- and
## the caches the prepare read around. Returns the near_height the region was
## placed by (NAN on any failure path), as _try_load_real_terrain always has.
func _terrain_commit(job: Dictionary) -> float:
	_record_prepare_laps(job)
	_print_job_log(job["log"])
	var mapm_path: String = job["mapm_path"]
	if not job.get("prepared", false):
		# The task ended before its last line: a script error on the worker,
		# whose SCRIPT ERROR is in the log above this one.
		printerr("World3D: the terrain for %s was not prepared (see the error above) -- nothing built" % mapm_path)
		return NAN
	if job.has("error"):
		printerr(job["error"])
		return NAN
	var region: MapmReader.ParsedRegion = job["region"]
	var sw := Time.get_ticks_usec()

	# What the prepare read, into this world's caches: the navmesh (a null
	# too -- "tried, nothing"), every object navigation mesh its graph used,
	# and the ground tiles it decoded, uploaded here. A tile another job's
	# commit uploaded first is kept, not replaced. So is a navmesh the main
	# thread cached while this job read its own -- and the graph registered
	# below is built on the job's copy, so that region then keeps two parses
	# of its `.nvm` alive: memory only (round 565's review). The `prepared
	# again` line counts it as a navmesh read twice; 0 in every run round 566
	# counted (docs/RE_COMPLETION.md, round 566).
	var navmesh_key: int = job["navmesh_key"]
	if job.get("navmesh_loaded", false) and not _grid.navmesh_cache.has(navmesh_key):
		_grid.navmesh_cache[navmesh_key] = job["navmesh"]
	var used: Dictionary = job["used_collisions"]
	for id in used:
		if not _grid.object_collision_cache.has(id):
			_grid.object_collision_cache[id] = used[id]
	var new_images: Dictionary = job["new_images"]
	for filename in new_images:
		if not _ground_texture_cache.has(filename):
			var image: Image = new_images[filename]
			_ground_texture_cache[filename] = ImageTexture.create_from_image(image) if image != null else null
	var ground_textures := {}
	var files: Dictionary = job["texture_files"]
	for id in files:
		var tex: Texture2D = _ground_texture_cache.get(files[id])
		if tex != null:
			ground_textures[id] = tex
	var lightmap_image: Image = job["lightmap"]
	var lightmap: Texture2D = ImageTexture.create_from_image(lightmap_image) if lightmap_image != null else null
	sw = _load_timings.lap("terrain", "images", sw)

	var textured: bool = job["textured"]
	var surfaces: Array = job["surfaces"]
	var terrain_mesh: ArrayMesh
	if textured:
		terrain_mesh = MapmTerrainBuilder.surfaces_to_mesh(surfaces, ground_textures, lightmap)
	else:
		terrain_mesh = MapmTerrainBuilder.arrays_to_mesh(surfaces[0]["arrays"])
	sw = _load_timings.lap("terrain", "upload", sw)

	var terrain_group := Node3D.new()
	terrain_group.name = "RealTerrain" + String(job["node_suffix"])
	# What /groundprobe (round 579) reads back about this region: the ground
	# counts the prepare logged, how many of its tiles have a texture, the
	# light the mesh was baked with (a zero direction: shaded, not baked), and
	# which commit of this .m in this world it is -- a second while the first
	# is still loaded would be a duplicate terrain, one of the white ground's
	# hypotheses (docs/RE_COMPLETION.md, round 579).
	var commits := int(_terrain_commits.get(mapm_path, 0)) + 1
	_terrain_commits[mapm_path] = commits
	var ground_counts: Dictionary = job.get("ground_counts", {})
	var light_dir: Vector3 = job.get("light_dir", Vector3.ZERO)
	terrain_group.set_meta("ground_probe", {
		"mapm_path": mapm_path, "commit": commits, "textured": job["textured"],
		"baked": light_dir.length_squared() > 0.0, "light_dir": light_dir,
		"light_diffuse": job.get("light_diffuse", Color.WHITE), "light_ambient": job.get("light_ambient", Color.BLACK),
		"ids": ground_counts.get("ids", -1), "resolved": ground_counts.get("resolved", -1),
		"decoded": ground_counts.get("decoded", -1), "no_entry": ground_counts.get("no_entry", -1),
		"unreadable": ground_counts.get("unreadable", -1), "uploaded": ground_textures.size(),
		"lightmap": lightmap != null, "frame": Engine.get_frames_drawn(), "threaded": job["threaded"],
	})

	# Real per-quad textures (see above) already carry their own
	# per-surface materials (including the real .t lightmap) from
	# MapmTerrainBuilder -- material_override would apply one material to
	# every surface uniformly and stomp that, so it's left null and the
	# mesh's own per-surface materials show through. The single-flat-
	# material path below is unchanged for the untextured fallback.
	var aabb := terrain_mesh.get_aabb()
	var mat: StandardMaterial3D = null
	if not textured:
		mat = StandardMaterial3D.new()
		var real_texture := _load_real_terrain_texture(job["texture_override"])
		var row_count_estimate := aabb.size.z / MapmTerrainBuilder.TILE_SIZE + 1
		if real_texture != null:
			mat.albedo_texture = real_texture
			# The mesh's own UVs (see MapmTerrainBuilder) stretch 0..1 across
			# the whole recovered strip, which can be dozens of real rows long
			# -- squishing one square minimap image over that whole length
			# reads as heavy streaking rather than ground detail. Repeating it
			# roughly once per GRID_WIDTH rows (a real, confirmed value -- see
			# MapmTerrainBuilder) keeps each repeat closer to the image's own
			# roughly-square real aspect ratio instead of one giant stretch.
			mat.uv1_scale = Vector3(1.0, max(row_count_estimate / float(MapmTerrainBuilder.GRID_WIDTH), 1.0), 1.0)
		else:
			mat.vertex_color_use_as_albedo = true
			# Display values, as Compatibility reads them; decoded where the output
			# is linear (Forward+), round 693's ShaderColour.
			mat.vertex_color_is_srgb = ShaderColour.VERTEX_COLOR_IS_SRGB
		if lightmap != null:
			mat.ao_enabled = true
			mat.ao_texture = lightmap
			mat.ao_light_affect = 1.0
	# Real world-space alignment with the player's own spawn position isn't
	# confirmed (see top comment) -- centered near the player purely for
	# visibility, same as the scenery/decoration-skeleton placement choices
	# elsewhere in this file. The vertical offset uses the real height of
	# the mesh's own first-row, middle-column vertex (the part of the mesh
	# that ends up nearest the player/camera once placed) rather than the
	# whole mesh's average -- terrain height varies enormously row to row,
	# so a global average can land nowhere near where the player actually
	# is; this keeps the offset tied to the specific real vertex the player
	# spawns next to.
	#
	# MapmTerrainBuilder lays successive rows out along local +Z, but this
	# scene's third-person camera looks down -Z (+Z is behind it -- see the
	# scenery-placement comment in _try_load_real_scenery()), so an
	# unrotated terrain mesh would extend almost entirely behind the
	# camera. Rotating 180 degrees around Y flips both axes consistently
	# (a pure rotation, so front-face winding/normals stay correct) so
	# successive rows extend further *into* view instead.
	# Read directly from the parsed region rather than the built mesh (the
	# prepare did, MapmTerrainBuilder.near_row_middle_height) -- see
	# near_row_middle_height's doc comment: the textured mesh path can split
	# row 0 across several surfaces, so surface 0 alone no longer reliably
	# holds this vertex the way the old single-surface mesh did.
	var near_height: float = job["near_height"]
	var shared_vertical_anchor: float = job["anchor"]
	var anchor_height := near_height if is_nan(shared_vertical_anchor) else shared_vertical_anchor
	# **Corrected 2026-09-05** (see docs/WORLD_ISSUES.md): this was
	# `rotation.y = PI` plus an `aabb.size.x / 2.0` X offset, which placed
	# every real region *individually rotated 180 degrees* inside a grid
	# whose own offsets ran the other way. Each real region was internally
	# fine -- and objects (parented here) and navmesh walls inherited the
	# same transform, so everything agreed with everything else -- but the
	# regions were assembled against each other backwards, building a world
	# that is not a real place. Reported from a real playtest ("I have never
	# seen this place"), which self-consistency had hidden.
	#
	# The real world space is contiguous: crossing a region's local
	# x = 1920 edge continues at local x = 0 of region_y + 1 (the real
	# global edges' own AssocRegionIdTo says so, see NVM_FORMAT.md), so
	# real world X is `region_y * 1920 + local_x` and real world Z is
	# `region_x * 1920 + local_z`. Local coordinates therefore have to run
	# *forwards*, with no per-region rotation at all.
	#
	# Measured directly on the real heightmaps: a region's own high edge
	# matches its neighbour's low edge exactly (98/168's col 96 against
	# 98/169's col 0: mean difference 0.000000; the reversed pairing the old
	# transform produced: 18.2). Across a real 3x3 neighbourhood the mean
	# height step over every region seam falls from 34.28 to 2.40.
	#
	# The half-span shift keeps each real region *centred* on its own grid
	# offset, exactly as the old transform did on X, so _maybe_stream_regions'
	# own `round(rel / REGION_SPAN)` cell test still names the right cell.
	# **Un-mirrored 2026-09-05** (see docs/WORLD_ISSUES.md's sixty-first
	# round). The real client is Direct3D and left-handed; Godot is
	# right-handed. Feeding real coordinates straight through mirrors the
	# whole world, which is why `BmsReader` had to reverse every real
	# triangle's winding to stop objects rendering inside-out -- that made
	# faces visible again without addressing the cause. Proved with real
	# signage: the real Jangan restaurant carries 長安酒 on two
	# perpendicular *exterior* tower faces, and both rendered with 酒's
	# water radical on the wrong side until this mirror was applied.
	#
	# `scale.z = -1` alone would mirror each real region about its *own*
	# origin, which is the same per-region mistake the sixtieth round fixed.
	# Negating the group's world Z as well composes the two into a single
	# global `z -> -z` about the world origin, so every region stays in the
	# right place relative to its neighbours.
	#
	# Godot flips face culling itself for a negative-determinant transform
	# (verified: the real building renders solid, not inside-out, under this
	# mirror), so `BmsReader`'s existing winding reversal stays exactly as
	# it is and no mesh data needs rewriting.
	#
	# The arithmetic is TerrainCollision.place_group's (round 572): the
	# heightfield's grid lines follow from it, and the vertical terrain rays
	# step off them (TerrainCollision.vertical_ray), so the two are one
	# function and the grid probe in terrain_collision_test.gd runs it.
	# _group_position (round 570) is the same position without a node -- the
	# frame's corner (_frame_corner) and the frame test read it -- and
	# region_grid_state_test.gd holds the two equal for every FRAME_ROWS cell
	# and several anchors, so the grid corner and the heightfield's grid lines
	# cannot drift apart.
	TerrainCollision.place_group(terrain_group, job["world_offset"], anchor_height)
	add_child(terrain_group)
	ground_mesh.visible = false
	ground_collision.disabled = true

	# History, kept for context: an earlier same-day attempt tiled a single
	# parsed sub-patch's data across a synthetic 6x6 grid of *copies* to
	# fill a region's real footprint (see git history / PROGRESS.md), and
	# was reverted after live testing showed it made the camera-in-geometry
	# problem worse (a steep boundary every 320 units instead of every
	# 1920). That approach is now obsolete: terrain_mesh above is already
	# the real stitched multi-sub-patch mesh (build_full_region_mesh), not
	# one repeated patch, so there is exactly one real node to build here.
	var patch_body := StaticBody3D.new()
	patch_body.collision_layer = TERRAIN_COLLISION_LAYER
	var patch_shape := CollisionShape3D.new()
	# Everything since the upload -- the group, the untextured material, the
	# vertical calibration and placement, the body and shape nodes -- is the
	# `setup` lap (round 564's, which named the span between the mesh and the
	# trimesh; a bare stopwatch reset left it in no lap until then).
	sw = _load_timings.lap("terrain", "setup", sw)
	# The collision shape: its own lap, with nothing else in it. Since round
	# 567 a HeightMapShape3D over the region's height grid, which the prepare
	# laid out (TerrainCollision: the mesh's own vertices and triangles, the
	# shape's transform in this group's local space). Until then -- and under
	# SRREVAMP_TERRAIN_TRIMESH=1, kept for A/B -- a ConcavePolygonShape3D of
	# the faces the prepare built, the list create_trimesh_shape() read back
	# out of the mesh until round 565 (MapmTerrainBuilder.surface_faces; the
	# builder's suite compares the two), whose BVH build was this lap: 25-33
	# ms of a streamed cell's 39-51 ms terrain commit after round 565, 27-30 %
	# of the streamed cells' main-thread time after round 566. The
	# heightfield's reads 0 ms on every cell line of round 567's benchmark
	# (whole-ms truncation: under 1 ms a cell; docs/RE_COMPLETION.md, round
	# 567).
	# Round 156 named the trimesh the load's largest single cost -- before
	# round 160's archive fix, which took most of the terrain phase.
	var faces: PackedVector3Array = job.get("faces", PackedVector3Array())
	var heights: PackedFloat32Array = job.get("heights", PackedFloat32Array())
	var collision_kind := "none"
	if job.get("trimesh", false):
		if not faces.is_empty():
			var shape := ConcavePolygonShape3D.new()
			shape.set_faces(faces)
			patch_shape.shape = shape
			collision_kind = "trimesh, %d faces" % (faces.size() / 3)
	else:
		patch_shape.shape = TerrainCollision.make_shape(heights)
		patch_shape.transform = TerrainCollision.shape_transform()
		if patch_shape.shape != null:
			collision_kind = "heightfield %dx%d" % [TerrainCollision.SIDE, TerrainCollision.SIDE]
	sw = _load_timings.lap("terrain", "collision", sw)
	patch_body.add_child(patch_shape)
	var single_patch := MeshInstance3D.new()
	single_patch.name = "SubPatch"
	single_patch.mesh = terrain_mesh
	single_patch.material_override = mat
	single_patch.add_child(patch_body)
	terrain_group.add_child(single_patch)
	_add_mirror_terrain(terrain_group, single_patch)

	_add_navmesh_walls(terrain_group, job)
	sw = _load_timings.lap("terrain", "wallshape", sw)
	_try_add_real_water(terrain_group, job["region"], mapm_path)
	sw = _load_timings.lap("terrain", "water", sw)
	var graph: NavGraph = job.get("nav_graph")
	if graph != null:
		var coords: Dictionary = job["coords"]
		_grid.add_nav_graph(int(coords["x"]), int(coords["y"]), graph, terrain_group)
	_print_job_log(job["nav_log"])
	_load_timings.lap("terrain", "graph", sw)

	# The vertical calibration above only guarantees one specific mesh vertex
	# lines up near world Y=0 -- it says nothing about the height of whatever
	# real terrain happens to sit under the player's actual server-given
	# spawn X/Z, which can be wildly different (see this function's own doc
	# comment on why real spawn/terrain alignment isn't confirmed yet). Left
	# alone, the player can end up embedded in or floating above the mesh.
	# Deferred one frame so the collision shape above is actually registered
	# with the physics server before the raycast below queries it. Only the
	# grid's center region (see _load_region_neighborhood) does this --
	# snapping onto every speculative neighbor as it loads would fight over
	# the player's position for no reason.
	if job["snap_player"]:
		call_deferred("_snap_player_onto_terrain")

	print("World3D: loaded real terrain from %s (%d real blocks, %d rows stitched, real collision shape built: %s) at frame %d%s" % [
		mapm_path, region.blocks.size(), terrain_mesh.get_aabb().size.z / MapmTerrainBuilder.TILE_SIZE + 1, collision_kind,
		Engine.get_frames_drawn(),
		" -- prepared off the main thread, dispatched at frame %d" % job["dispatched_frame"] if job["threaded"] else ""])
	return near_height

## Practical safety net for the real terrain-alignment gap noted where this
## is called: raycasts straight down (and up, to cover an embedded start)
## through the player's current X/Z and snaps them onto whatever real
## surface it hits, so movement always starts from solid, walkable ground
## regardless of how far off the terrain's heuristic placement is from the
## player's real spawn point. Not a fix for the underlying alignment
## question -- just keeps the game playable until that's reverse-engineered.
## Distance above the player's feet the buried-player probe in
## _recover_if_below_terrain starts from. One full region span, so the probe
## reaches any terrain plausibly overhead: real measured region meshes in the
## Jangan neighborhood span at most ~1350 units vertically end to end (see
## docs/WORLD_ISSUES.md), and a player buried by more than a whole region span
## is the WORLD_FLOOR_Y case, which the void-fall recovery already handles.
const BURIED_PROBE_HEIGHT := REGION_SPAN

## Lifts the player back onto the surface when they end up *underneath* the
## terrain rather than on top of it.
##
## Measured 2026-09-03: the initial _snap_player_onto_terrain runs once, while
## the 5x5 region neighborhood is still streaming in, so it can only snap the
## player onto whichever regions happen to have finished loading. Instrumenting
## a real headless run of the real Jangan spawn region (98/168) showed the
## player at y=0.00 on physics frame 0 with the terrain surface beneath them at
## y=1.04 -- i.e. a metre *below* the map -- with 25 region nodes loaded; by
## frame 1, with 30 loaded, the snap had put them at y=64.70. Walking from a
## spawn during that same streaming window measured the player 41 units below
## the terrain surface. Nothing re-checked the player's placement once the
## remaining regions arrived, so a player who was under a region's terrain when
## it streamed in simply stayed under it, seeing the world from below (where
## back-face culling makes the ground invisible and the sky shows straight
## through it).
##
## The existing ground/void check above cannot catch this: its probe starts
## only 10 units above the player, below a 14.34-unit character's own head, so
## terrain overhead is out of its reach entirely.
##
## Safe to apply unconditionally because real .m terrain is a heightmap -- one
## height per grid vertex (see MapmReader) -- so it cannot overhang itself, and
## any terrain strictly above the player's feet therefore means the feet are
## below the surface. Terrain-only (see TERRAIN_ONLY_COLLISION_MASK) keeps real
## objects the player can legitimately stand under -- bridges, building
## interiors, arches -- from being mistaken for ground overhead.
func _recover_if_below_terrain() -> void:
	var feet := player.position
	# Off the heightfield's grid lines (TerrainCollision.vertical_ray, round
	# 572): straight down onto one of them the ray often finds nothing.
	var hit := TerrainCollision.vertical_ray(get_world_3d().direct_space_state, feet.x, feet.z,
		feet.y + BURIED_PROBE_HEIGHT, feet.y, TERRAIN_ONLY_COLLISION_MASK, [player.get_rid()])
	if hit.is_empty():
		return
	# A player standing correctly *on* the ground still registers a hit here,
	# at their own feet -- only a hit meaningfully above them means buried.
	var surface_y: float = hit.position.y
	if surface_y <= feet.y + BURIED_EPSILON * PLAYER_SCALE_RATIO:
		return
	player.position.y = surface_y + 0.05 * PLAYER_SCALE_RATIO
	player.velocity.y = 0.0

## Slack, in unscaled (1.8-unit-tall-character) units, allowed between the
## player's feet and terrain found overhead before they count as buried --
## absorbs the ordinary sub-unit jitter of resting on a collision surface.
const BURIED_EPSILON := 0.25

func _snap_player_onto_terrain() -> void:
	# Terrain-only (see TERRAIN_ONLY_COLLISION_MASK's doc comment) -- without
	# this, a real building standing at the spawn X/Z (its collision defaults
	# to the same layer terrain used to) is whatever this ray hits first from
	# 1000 units up, landing the player on its roof instead of the ground.
	# Off the heightfield's grid lines (TerrainCollision.vertical_ray, round
	# 572): the server's spawn (0, 0, 0) is itself a vertex of the entry
	# region, where a plain vertical ray misses as often as not.
	var p := player.position
	var hit := TerrainCollision.vertical_ray(get_world_3d().direct_space_state, p.x, p.z,
		p.y + 1000.0, p.y - 1000.0, TERRAIN_ONLY_COLLISION_MASK, [player.get_rid()])
	if hit.is_empty():
		return
	var surface: float = hit.position.y + 0.05 * PLAYER_SCALE_RATIO
	# **Lift only.** This is a safety net for a player the region stream
	# buried, which is what it was written for -- but because it looks at
	# terrain alone, dropping the player to whatever it finds also pulls
	# them off anything they are legitimately standing *on*.
	#
	# Measured in Jangan: a zone change places the player correctly on the
	# gate's deck at local y -32.6, and this snap -- running deferred as the
	# centre region finishes loading -- then dragged them down to the bare
	# terrain 13.8 below, inside the gate's own stonework. Every "the player
	# sinks into the town square" render was this line.
	#
	# Lifting still does its job; dropping never was its job.
	if surface <= player.position.y:
		return
	player.position.y = surface
	player.velocity = Vector3.ZERO
	_avoid_spawning_under_roof()

## Real, general safety net (2026-08-26, see docs/WORLD_ISSUES.md): a real
## fixed server spawnPos of (0,0,0) can genuinely land inside a real
## building's interior in a densely-built real zone (confirmed for Jangan's
## own real region, 863 real placements in one region) -- this isn't
## something a fixed spawn coordinate can reliably avoid on its own, since
## "the most open point" in a real palace complex still isn't very open.
## Rather than try to precompute a real building-free spawn point (would
## need real per-object footprint data this project doesn't have, not just
## placement anchors), this checks *after* landing on real terrain whether
## there's a real low ceiling directly overhead (a real room, not open sky)
## and, if so, tries nearby real ground positions in a widening ring until
## one has clear sky above, snapping there instead. Bounded and best-effort:
## if every tried position is still covered, leaves the player at the
## original terrain-snapped position rather than searching forever.
## **Corrected 2026-08-26** (see docs/WORLD_ISSUES.md): a real playtest
## found the original 30.0 never triggered the escape search at all --
## real placed objects render at their own native scale (unlike the
## player's own body, deliberately rescaled to a fixed 1.8-unit height in
## _build_assembled_character), and a direct check of real Jangan-region
## meshes found real building pieces up to ~44.5 real units tall
## (`jangan03\cj_pal_dam_left02.bsr`) and real trees up to ~140 -- 30.0
## couldn't even clear a single real wall piece, let alone a real room.
## Raised with real margin above the tallest real piece measured.
const ROOF_CHECK_HEIGHT := 200.0
## Also raised in proportion -- a real building tall enough to need the
## new ROOF_CHECK_HEIGHT plausibly has a footprint on a similar real
## scale, not the old, much smaller assumption.
const ROOF_ESCAPE_STEP := 60.0
const ROOF_ESCAPE_RINGS := 10
const ROOF_ESCAPE_DIRECTIONS := 8

func _avoid_spawning_under_roof() -> void:
	if not _has_roof_overhead(player.position):
		return
	var space_state := get_world_3d().direct_space_state
	for ring in range(1, ROOF_ESCAPE_RINGS + 1):
		var radius := ring * ROOF_ESCAPE_STEP
		for i in range(ROOF_ESCAPE_DIRECTIONS):
			var angle := TAU * i / ROOF_ESCAPE_DIRECTIONS
			var candidate_xz := player.position + Vector3(cos(angle) * radius, 0.0, sin(angle) * radius)
			# Terrain-only (see TERRAIN_ONLY_COLLISION_MASK's doc comment) --
			# without this, a candidate ring position could land on a
			# *different* real building's roof, which also has clear sky
			# above it, so _has_roof_overhead(candidate) below would wrongly
			# accept it as "escaped" -- moved off one roof, onto another.
			# Off the heightfield's grid lines (TerrainCollision.vertical_ray,
			# round 572): from a player on a grid vertex -- the server's spawn
			# is one -- the rings' points at 0, 90, 180 and 270 degrees lie on
			# grid lines.
			var hit := TerrainCollision.vertical_ray(space_state, candidate_xz.x, candidate_xz.z,
				candidate_xz.y + 1000.0, candidate_xz.y - 1000.0, TERRAIN_ONLY_COLLISION_MASK, [player.get_rid()])
			if hit.is_empty():
				continue
			var candidate: Vector3 = hit.position + Vector3(0.0, 0.05 * PLAYER_SCALE_RATIO, 0.0)
			if not _has_roof_overhead(candidate):
				player.position = candidate
				player.velocity = Vector3.ZERO
				return
	# Every tried ring was still covered -- a real, honest "couldn't find
	# open ground nearby" outcome (e.g. deep inside a real dense palace
	# complex), not silently pretending success.
	printerr("World3D: spawn point has a real roof overhead and no nearby open ground was found within %d real units -- leaving the player here" % (ROOF_ESCAPE_RINGS * ROOF_ESCAPE_STEP))

## True if a real raycast straight up from pos hits something within
## ROOF_CHECK_HEIGHT real units -- a real low ceiling/roof, not open sky.
func _has_roof_overhead(pos: Vector3) -> bool:
	var space_state := get_world_3d().direct_space_state
	var query := PhysicsRayQueryParameters3D.create(
		pos + Vector3(0.0, 0.5 * PLAYER_SCALE_RATIO, 0.0),
		pos + Vector3(0.0, ROOF_CHECK_HEIGHT, 0.0))
	query.exclude = [player.get_rid()]
	# A gate's pick box is a click target, not a roof (round 690).
	query.collision_mask = 0xFFFFFFFF & ~GATE_PICK_COLLISION_LAYER
	var hit := space_state.intersect_ray(query)
	return not hit.is_empty()

## Reads, once, everything dressing needs and nothing it does not:
## Data.pk2 stays open, the characterdata parts give each body row (and the
## speed, BCRadius, DecayTime and Country tables), and the item table is read
## for id -> worn model. Then the builder (CharacterAppearance) is made over
## them: a bodies-only catalogue from the same characterdata bytes (the 52
## Figures, CharCatalog's rule) and this item table, so nothing is parsed
## twice. Each body is assembled the first time a character needs it
## (_body_assets). Leaves _appearance null if SRREVAMP_PK2_PATH isn't set.
func _load_character_assets() -> void:
	_data_pk2 = _open_pk2_if_set()
	if _data_pk2 == null:
		print("World3D: SRREVAMP_PK2_PATH not set -- characters stay placeholders")
		return
	if _media_pk2 == null:
		_media_pk2 = _open_media_pk2_if_set()
	if _media_pk2 == null:
		print("World3D: no Media.pk2 -- no character or item tables, characters stay placeholders")
		return

	var speeds := {}
	var char_parts: Array = []
	for path in NpcTableReader.MODEL_TABLE_PATHS:
		var entry := ObjectLoader.find_file(_media_pk2, path)
		if entry != null:
			var bytes := _media_pk2.read_file(entry)
			char_parts.append(bytes)
			speeds = NpcTableReader.parse_speeds_by_code(bytes, speeds)
			_bc_radius_by_code = NpcTableReader.parse_bc_radius_by_code(bytes, _bc_radius_by_code)
			_monster_decay_ms_by_code = NpcTableReader.parse_decay_by_code(bytes, _monster_decay_ms_by_code)
			_country_by_code = NpcTableReader.parse_country_by_code(bytes, _country_by_code)
	_speeds_by_code = speeds
	# Every row's BCRadius (column 50), for the attack approach: the player's
	# body and the monsters' species both feed the reach band.
	print("World3D: %d BCRadius row(s) from characterdata column 50 (%s: %s)" % [
		_bc_radius_by_code.size(), GENDER_BODY_CODE[DEFAULT_GENDER],
		str(_bc_radius_by_code.get(GENDER_BODY_CODE[DEFAULT_GENDER], "none"))])
	print("World3D: %d monster DecayTime row(s) from characterdata column 13 (MOB_CH_MANGNYANG: %s ms)" % [
		_monster_decay_ms_by_code.size(), str(_monster_decay_ms_by_code.get("MOB_CH_MANGNYANG", "none"))])
	# The player's run speed is its body row's own (column 47), set when the
	# body is known (_apply_player_speed); the default body's until then.
	_apply_player_speed(GENDER_BODY_CODE[DEFAULT_GENDER])
	for path in ItemTableReader.TABLE_PATHS:
		var entry := ObjectLoader.find_file(_media_pk2, path)
		if entry == null:
			continue
		for item in ItemTableReader.parse(_media_pk2.read_file(entry)).values():
			_item_rows[item.id] = item
			if item.drop_model_path != "":
				_item_drop_models[item.id] = item.drop_model_path
			if item.model_path != "":
				_item_models[item.id] = item.model_path
				if item.type_ids.size() >= 4:
					_item_kinds[item.id] = item.type_ids[3]

	# The bodies (round 689): the catalogue's rule over the parts just read.
	var t_cat := Time.get_ticks_usec()
	var bodies := CharCatalog.from_tables(char_parts, [])
	_appearance = CharacterAppearance.from_catalog(_data_pk2, _media_pk2, bodies, _item_rows)
	_body_anims = BodyAnimations.new(_data_pk2)
	for id in bodies.entries:
		var e: CharCatalog.Entry = bodies.entries[id]
		if e.is_body:
			_body_id_by_code[e.code] = e.id
	print("World3D: %d character bodies from characterdata (%d us); %d item model(s) known from the item table" % [
		_body_id_by_code.size(), Time.get_ticks_usec() - t_cat, _item_models.size()])

## The player's run speed from its body's characterdata row (column 47, the
## number the server moves the character by; NpcTableReader.COL_SPEED_RUN) --
## the base. A run speed a server packet set (_server_run_speed: a buff, a GM's
## /speed, replayed at world entry by _replay_held_buffs) is the speed in
## effect and stays: round 689's review found the first dress, which comes
## after that replay, dropping a held /speed 2 back to the body's 50 (a
## reconnecting player then rubber-banded against the server).
func _apply_player_speed(code: String) -> void:
	var player_speeds: Array = _speeds_by_code.get(code, [])
	if player_speeds.size() != 2 or float(player_speeds[1]) <= 0.0:
		print("World3D: no speed row for %s -- keeping %.1f units/s" % [code, _move_speed])
		return
	if _server_run_speed > 0:
		print("World3D: %s runs %.0f units/s by its row, but the server set %d -- kept" % [
			code, float(player_speeds[1]), _server_run_speed])
		return
	_move_speed = float(player_speeds[1])
	print("World3D: player run speed %.0f units/s (characterdata column 47 of %s; walk %.0f)" % [
		_move_speed, code, float(player_speeds[0])])

## The body key (a Figure's characterdata code name) of a character: its
## model's when the server sent one (round 689) and the catalogue holds it,
## else the body its gender was migrated to (GENDER_BODY_CODE), else the
## default gender's. "" when there are no bodies at all.
func _body_key_for(ref_obj_id: int, gender: String) -> String:
	var cat := _appearance.catalog() if _appearance != null else null
	var key := WorldBodies.body_key(cat, ref_obj_id, gender)
	if ref_obj_id > 0 and (cat == null or cat.get_entry(ref_obj_id) == null):
		print("World3D: model %d is not a creatable body in this archive -- drawn as %s (gender %s)" % [ref_obj_id, key, gender])
	return key

## The body's assets (see _character_assets), made on first use from the
## builder's template: the `.bsr` is parsed and the body assembled once, and
## every character of that Figure shares them. {} when the body cannot be
## built.
func _body_assets(body: String) -> Dictionary:
	if _character_assets.has(body):
		return _character_assets[body]
	if _appearance == null or not _body_id_by_code.has(body):
		return {}
	var ref: int = _body_id_by_code[body]
	var tmpl := _appearance.template_for(ref)
	if tmpl == null or tmpl.parsed == null or not tmpl.parsed.is_character:
		printerr("World3D: body %s (%d, %s) is not a character .bsr" % [body, ref, _appearance.body_path(ref)])
		_character_assets[body] = {}
		return {}
	var assets := {
		"ref": ref,
		"bsr_path": _appearance.body_path(ref),
		"parsed": tmpl.parsed,
		"assembled": tmpl,
		"race": _appearance.race_of(ref),
		"woman": _appearance.is_woman(ref),
	}
	_character_assets[body] = assets
	print("World3D: body %s is %s (%d, %d pieces, %d animations, groups %s)" % [
		body, assets["bsr_path"], ref, tmpl.parsed.all_mesh_paths().size(), tmpl.parsed.animation_paths.size(),
		str(tmpl.parsed.animation_groups.keys())])
	return assets

## A body's assets, or the default gender's body's when it has none.
func _body_assets_or_default(body: String) -> Dictionary:
	var assets := _body_assets(body)
	if assets.is_empty():
		assets = _body_assets(String(GENDER_BODY_CODE[DEFAULT_GENDER]))
	return assets

## Whether a body is a woman's (characterdata column 58), for the skill clips'
## man / woman folders.
func _body_is_woman(body: String) -> bool:
	return bool(_body_assets_or_default(body).get("woman", false))

## The race and sex a body's skill clips are filed under, as
## SkillDataReader.cast_clip_path reads them ("europe_woman", ...; round 691
## over round 689's body): the body's race (BodyAnimations) and sex (column 58).
func _body_gender(body: String) -> String:
	var a := _body_assets_or_default(body)
	var race := "europe" if int(a.get("race", BodyAnimations.RACE_CHINA)) == BodyAnimations.RACE_EUROPE else "china"
	return race + ("_woman" if bool(a.get("woman", false)) else "_man")

## The animation a body plays for one action, in the animation group a held
## weapon selects -- the body's own `.bsr` table with the client's fallback to
## `default` (BodyAnimations, READ). Parsed on first use and cached per body.
## Null when the body has no animation for it, which the caller treats as
## "hold the pose".
##
## A body whose `.bsr` carries no groups at all falls back to matching the
## animation file names against BODY_ANIMATION_HINTS.
func _body_animation_for(body: String, action_type: int, group: String = "default") -> BanReader.ParsedAnimation:
	var assets := _body_assets_or_default(body)
	if assets.is_empty():
		return null
	var assembled: SkinnedBsrAssembler.AssembledCharacter = assets["assembled"]
	var parsed: BsrReader.ParsedObject = assets["parsed"]
	if not parsed.animation_groups.is_empty():
		return _body_anims.clip_for(assembled, action_type, group)
	var path := _hinted_animation_path(parsed.animation_paths, action_type)
	if path == "":
		return null
	var cache: Dictionary = assembled.animation_cache
	if cache.has(path):
		return cache[path]
	var bytes := AssetSource.read_bytes(path, _data_pk2)
	if bytes.is_empty():
		bytes = AssetSource.read_bytes("res\\" + path, _data_pk2)
	var anim: BanReader.ParsedAnimation = BanReader.parse(bytes) if not bytes.is_empty() else null
	if anim != null and anim.bones.is_empty():
		anim = null
	cache[path] = anim
	return anim

## The name-hint fallback: the first animation path matching the earliest
## hint for an action, or "".
func _hinted_animation_path(paths: Array, action_type: int) -> String:
	var key := ""
	match action_type:
		BsrReader.AnimationEntry.TYPE_STAND:
			key = "idle_anim"
		BsrReader.AnimationEntry.TYPE_WALK:
			key = "walk_anim"
		BsrReader.AnimationEntry.TYPE_RUN:
			key = "run_anim"
		BsrReader.AnimationEntry.TYPE_HIT:
			key = "hit_anim"
		BsrReader.AnimationEntry.TYPE_DIE:
			key = "death_anim"
	if key == "":
		return ""
	for hint in BODY_ANIMATION_HINTS[key]:
		for path in paths:
			var lower := (path as String).to_lower()
			if lower.ends_with(hint) or lower.contains(hint):
				return path
	return ""

## The animation group the weapon in a set of equipped items selects on a
## body (BodyAnimations.group_for_weapon: the client's switch, the fortress
## weapon by the body's race).
func _weapon_group_for(equipped: Dictionary, body: String = "") -> String:
	var weapon_id: int = int(equipped.get(EquipmentNet.SLOT_WEAPON, 0))
	if weapon_id == 0:
		return "default"
	var race := int(_body_assets_or_default(body).get("race", BodyAnimations.RACE_CHINA)) if body != "" else BodyAnimations.RACE_CHINA
	return BodyAnimations.group_for_weapon(int(_item_kinds.get(weapon_id, 0)), race)

# --- Animation-fired sounds (AnimSounds) ---------------------------------------

## A player character's sound owner: the PLAYER key family, the sound object
## of the body's characterdata row (CHAR_CH_MAN_FIGHTER -> PCM_FIGHTER), the
## body's own .bsr for its tracks, and the held weapon for its swings.
func _audio_pc_owner(label: String, body: String, equipped: Dictionary, node: Node3D) -> AnimSounds.Owner:
	var owner := AnimSounds.Owner.new()
	owner.label = label
	owner.is_pc = true
	owner.token = _sound_object_for(body if body != "" else String(GENDER_BODY_CODE[DEFAULT_GENDER]))
	var assets := _body_assets_or_default(body)
	owner.parsed = assets.get("parsed")
	owner.node = node
	owner.weapon_kind = _audio_weapon_kind(equipped)
	return owner

## The TypeID4 of the weapon in slot 6 (AnimSounds.WEAPON_TOKENS), or
## WEAPON_NONE for an empty slot, or WEAPON_UNKNOWN for an item the table
## does not know -- which swings silently rather than as a guessed weapon.
func _audio_weapon_kind(equipped: Dictionary) -> int:
	var weapon_id: int = int(equipped.get(EquipmentNet.SLOT_WEAPON, 0))
	if weapon_id == 0:
		return AnimSounds.WEAPON_NONE
	return int(_item_kinds.get(weapon_id, AnimSounds.WEAPON_UNKNOWN))

## The sound object for a characterdata code (the core's characterInfo map,
## SoundTable.sound_object), "" when skilleffect.txt has no row for it.
func _sound_object_for(code: String) -> String:
	return SoundTable.sound_object(code)

## The footstep material under the local player: the cell the walk carries
## (_nav_footing) when it is for the region the player is in, else the one
## the height finds.
func _audio_player_material() -> int:
	var pair := _nav_graph_for(player.global_position)
	var footing := -2
	if not pair.is_empty() and pair[0] == _nav_footing_graph:
		footing = _nav_footing
	return _audio_material_at(player.global_position, footing)

## The footstep material id (AnimSounds.MATERIALS) at a world position, or
## -1 where no navmesh is loaded. `footing` is what the body stands on --
## NavGraph.ON_TERRAIN, an object index, or -2 to find it from the height.
## An object's cell is always 0, DIRT (READ, 0x0040ecb0); a terrain cell's
## is the tile2d.ifo type of the region's 20-unit .nvm tile under the point
## (READ, 0x00403940 and the load-time rewrite). No water depth enters it.
func _audio_material_at(world_position: Vector3, footing: int) -> int:
	var pair := _nav_graph_for(world_position)
	if pair.is_empty():
		return -1
	var graph: NavGraph = pair[0]
	var local := (pair[1] as Node3D).to_local(world_position)
	if footing == -2:
		footing = graph.surface_at(local.x, local.z, local.y).object_index
	return AnimSounds.material_at(graph.region, local.x, local.z, footing, _load_tile_index())

## The critical flag voc_moan reads, set on the body a hit is about to play
## on (false for a hit that says nothing about it).
func _audio_mark_hit(skeleton: Variant, critical: bool) -> void:
	if skeleton == null or not is_instance_valid(skeleton):
		return
	var owner := _anim_sounds.owner_of(skeleton)
	if owner != null:
		owner.critical = critical

## The local player's berserk state, for the hwan swing.
func _audio_set_hwan(active: bool) -> void:
	_audio_hwan = active
	if _player_skeleton == null or not is_instance_valid(_player_skeleton):
		return
	var owner := _anim_sounds.owner_of(_player_skeleton)
	if owner != null:
		owner.hwan = active

## Tags a clip with the entry it was found as (BsrReader.CLIP_META), so its
## sound set can be found while it plays.
static func _tag_clip(anim: Object, action_type: int, group: String) -> void:
	if anim != null and group != "":
		anim.set_meta(BsrReader.CLIP_META, [action_type, group])

## Builds one fresh character through the select and create screens' own
## builder (CharacterAppearance, round 689): the body of `body` (a Figure's
## code name, _body_key_for) at the scale byte `scale` -- Height on the node,
## Volume on the bone groups, both READ -- with every worn item hung the way
## its own `.bsr` says, a dual axe's or dagger's `_l`/`_r` and a woman's harp
## `_f`, the client's missing-palette-bone rule, the default wear on an empty
## chest and legs (round 685) and the body's pieces under what it wears
## switched off (round 687). Select, create and the world now draw a character
## identically.
##
## `equipped` is slot -> item id, straight from the server. Each id is
## looked up in the item table for the model it is worn as, so the
## character wears exactly what the server says it does -- the Cotton Suit
## when the server says 4842, not a suit of this client's choosing. An id
## the table does not know is skipped with a line in the log, and the
## character is drawn without it rather than with a stand-in.
##
## Returns the body's Skeleton3D, its uniform scale the Height factor (READ:
## the client scales the skeleton's root about the model origin, CCompChar
## 0xc25460 -> RTSkeleton 0xc4bcb0), with meta "body" and "weapon_group".
## Falls back to the default gender's body if `body` cannot be built; null
## only if even that fails.
func _build_assembled_character(equipped: Dictionary = {}, body: String = "", scale: int = CharacterAppearance.DEFAULT_SCALE) -> Skeleton3D:
	if _appearance == null:
		return null
	var assets := _body_assets(body)
	if assets.is_empty():
		body = String(GENDER_BODY_CODE[DEFAULT_GENDER])
		assets = _body_assets(body)
	if assets.is_empty():
		return null
	var items: Array = []
	for slot in equipped:
		var item_id: int = int(equipped[slot])
		if item_id == 0:
			continue
		if not _item_models.has(item_id):
			print("World3D: item %d in slot %d has no worn model in the item table -- not drawn" % [item_id, slot])
			continue
		items.append({"id": item_id, "plus": 0})
	var built := _appearance.build(int(assets["ref"]), scale, items)
	if built == null:
		return null
	var skeleton := built.skeleton
	built.remove_child(skeleton)
	skeleton.scale = built.scale
	skeleton.set_meta("body", body)
	skeleton.set_meta("weapon_group", built.weapon_group)
	var drawn := 0
	for w in built.worn:
		if not w.get("default", false) and not (w["nodes"] as Array).is_empty():
			drawn += 1
	if not equipped.is_empty():
		print("World3D: %s (scale 0x%02x, height x%.2f) wears %d/%d item(s), %d body mesh(es) hidden under them" % [
			body, scale, built.height_factor, drawn, equipped.size(), built.hidden_body_meshes])
	built.free()
	return skeleton

## Attaches a freshly-built assembled character (see
## _build_assembled_character()) to the player node, hiding the
## placeholder capsule -- if the shared character assets loaded. Leaves
## the placeholder capsule visible otherwise.
##
## What the character wears is the server's word: the equipment list
## (EquipmentNet/OP_LIST via NetClient.list_equipment) says which item is
## in which slot, and each is drawn from its own model. A newly-created
## character wears the starting kit the server gave it.
func _try_apply_real_player_character() -> void:
	_apply_player_equipment_visual(await _real_player_equipped_items())

## Rebuilds the player's 3D body from an equipment map already in hand.
##
## Split out of _try_apply_real_player_character so the equipment-result
## handler can redress the character WITHOUT asking the server again -- the
## coroutine above awaits equipment_result, so calling it from inside that
## signal's own handler would wait for a reply that has already arrived.
##
## Until this existed the model was built once at login and never again, so a
## successful unequip took the sword out of the slot and left it in the
## character's hand: "when i drag and unequip my sword, it doesnt go off of my
## character" (playtest 2026-09-20).
func _apply_player_equipment_visual(equipped: Dictionary) -> void:
	_player_equipped_last = equipped
	var gender := DEFAULT_GENDER
	var ref_obj_id := 0
	var scale := CharacterAppearance.DEFAULT_SCALE
	var ewr = NetClient.last_enter_world_result
	if ewr != null and ewr.gender != "":
		gender = ewr.gender
	# The character's own model (round 689), from a server that sends it.
	if ewr != null and ewr.has_model:
		ref_obj_id = ewr.ref_obj_id
		scale = ewr.scale
	# SRREVAMP_QA_BODY="<ref_obj_id>[:<scale>]" (round 689): this body and scale
	# byte for a run with no server, as a server would name them. With a server
	# the server's word stands (round 689's review).
	var qa_body := _qa_body_spec() if not NetClient.is_connected_to_server() else []
	if not qa_body.is_empty():
		ref_obj_id = int(qa_body[0])
		scale = int(qa_body[1])
	var body := _body_key_for(ref_obj_id, gender)

	# Worth a log line: "the character renders bare" has had two different
	# causes so far -- the server not dressing them, and the client not
	# asking -- and this says which side to look at.
	print("World3D: player equipment %s" % str(equipped))

	var skeleton := _build_assembled_character(equipped, body, scale)
	if skeleton == null:
		return
	body = String(skeleton.get_meta("body", body))
	# Drop the body we were wearing before. This function used to run exactly
	# once, at login, so nothing freed the old skeleton; now that an equipment
	# change redresses the character, leaving it would stack a second dressed
	# body on the player every time anything was equipped or taken off.
	if _player_skeleton != null and is_instance_valid(_player_skeleton):
		_anim_sounds.unregister(_player_skeleton)
		_player_skeleton.queue_free()
		_player_skeleton = null
	# The assembled body's visual front is its own local -Z, but the player
	# node points its local +Z at the movement/target direction (rotation.y =
	# atan2(dir.x, dir.z)). Without correcting for that the body faced away
	# from wherever it was walking -- the "runs backwards on click" playtest
	# bug. Turning the body 180deg aligns its front with the node's forward,
	# so every facing (movement, click, combat) now points the right way.
	skeleton.rotation.y = PI
	player.add_child(skeleton)
	player_mesh.visible = false
	_player_skeleton = skeleton
	# Every other character in view carries a name plate and the local player
	# did not, so the one character you always look at was the one with no
	# name over it (playtest 2026-09-20, item 18).
	_refresh_player_name_plate()
	_player_gender = gender
	if body != _player_body:
		_apply_player_speed(body)
	_player_body = body
	_player_scale = scale
	_apply_player_race()
	_player_weapon_group = _weapon_group_for(equipped, body)
	# The body's sounds: the footstep material is the cell the walk carries
	# (_nav_footing), the swing's token the weapon just equipped.
	var sound_owner := _audio_pc_owner("player", body, equipped, player)
	sound_owner.material = func() -> int: return _audio_player_material()
	sound_owner.hwan = _audio_hwan
	_anim_sounds.register(skeleton, sound_owner)
	print("World3D: player body %s (model %d, scale 0x%02x), animation group %s (stand %s, run %s, sit %s)" % [
		body, ref_obj_id, scale, _player_weapon_group,
		_body_animation_path(body, BsrReader.AnimationEntry.TYPE_STAND, _player_weapon_group),
		_body_animation_path(body, BsrReader.AnimationEntry.TYPE_RUN, _player_weapon_group),
		_body_animation_path(body, BsrReader.AnimationEntry.TYPE_SITTING, _player_weapon_group)])
	_refresh_paper_doll(equipped, body)
	_refresh_player_portrait(skeleton, equipped, body)

## Builds a fresh dressed character (a second copy, not the one on the
## player) into the PaperDoll so the equipment window can show it, the way
## the original renders the character in that window. Rebuilt whenever the
## equipment changes.
var _paper_doll: PaperDoll = null

func _refresh_paper_doll(equipped: Dictionary, body: String) -> void:
	if _hud_panels == null:
		return
	if _paper_doll == null:
		_paper_doll = PaperDoll.new()
		_paper_doll.name = "PaperDoll"
		add_child(_paper_doll)
		# The client's own camera for this view and the zone's light (round
		# 633 and its review), the yaw the pane's rotate arrows and circle set,
		# and rendering only while the pane shows (HudPanels).
		_paper_doll.use_equipment_view()
		if _portrait_zone_light.size() == 2:
			_paper_doll.set_zone_light(_portrait_zone_light[0], _portrait_zone_light[1])
		_paper_doll.set_yaw(_hud_panels.paper_doll_yaw)
		_hud_panels.paper_doll_yaw_changed.connect(_paper_doll.set_yaw)
		_paper_doll.set_active(_hud_panels.paper_doll_shown())
		_hud_panels.paper_doll_shown_changed.connect(_paper_doll.set_active)
		_hud_panels.paper_doll_measure_requested.connect(_log_paper_doll_pose)
	var doll_skeleton := _build_assembled_character(equipped, body, _player_scale)
	if doll_skeleton == null:
		return
	_paper_doll.set_character(doll_skeleton)
	# The doll breathes in the town idle, the same animation and the same
	# clock the body in the world runs on: registered in _animated, it is
	# posed every physics frame by _tick_idle_animations, and the doll's
	# SubViewport (UPDATE_ALWAYS) shows it. A stale entry from a previous
	# equipment change is dropped there when its skeleton is freed.
	var idle := _body_animation_for(body, BsrReader.AnimationEntry.TYPE_STAND, _weapon_group_for(equipped, body))
	if idle != null and _frame_count(idle) > 1:
		Skeleton3DBuilder.apply_ban_pose_at(doll_skeleton, idle, 0.0, true)
		_animated.append([doll_skeleton, idle, _frame_count(idle), 0.0, true, _idle_anim_time, null])
	_hud_panels.set_paper_doll_texture(_paper_doll.get_texture(), _paper_doll)

## The player block's portrait (round 635, PlayerPortrait): a copy of the
## body just dressed -- the world's own, so it wears what the world shows --
## posed with ANI_POSE in the held weapon's group, rendered once. Retail
## re-renders on the same occasions: the item-move reply and the avatar's
## reset mark the block dirty (FUN_007b4c00), and this runs on every dress.
func _refresh_player_portrait(skel: Skeleton3D, equipped: Dictionary, body: String) -> void:
	if _hud_player_info == null or skel == null or not is_instance_valid(skel):
		return
	var copy := skel.duplicate() as Skeleton3D
	if copy == null:
		return
	var pose := _body_animation_for(body, PlayerPortrait.ANI_POSE, _weapon_group_for(equipped, body))
	_hud_player_info.set_portrait(copy, pose)
	var p := _hud_player_info.portrait()
	var view := _hud_player_info.portrait_view()
	print("World3D: portrait dressed (%s, pose %s, %d us, %d material(s) left as they were; buffer %s for a picture of %s screen pixels)" % [
		body, _body_animation_path(body, PlayerPortrait.ANI_POSE, _weapon_group_for(equipped, body)),
		p.last_build_usec if p != null else -1, p.unmapped_materials if p != null else -1,
		p.size if p != null else Vector2i.ZERO,
		ViewportPixels.physical_size(view) if view != null and view.is_inside_tree() else Vector2i.ZERO])

## The doll's hands and head in its 176x318 picture, and where the weapon
## hangs: the log line a render is checked against (round 633's review). The
## character's right hand drawn on the screen's LEFT is the client's view of
## a model facing the camera.
func _log_paper_doll_pose() -> void:
	if _paper_doll == null:
		return
	var r := _paper_doll.bone_on_screen("Bip01 R Hand")
	var l := _paper_doll.bone_on_screen("Bip01 L Hand")
	var h := _paper_doll.bone_on_screen("Bip01 Head")
	print("World3D: doll pose: R hand %s, L hand %s, head %s, face turned %+.1f px (right +), yaw %.3f (picture 176x318; rendered %s)" % [
		r.round(), l.round(), h.round(), _paper_doll.facing_screen_dx(), _hud_panels.paper_doll_yaw, _paper_doll.size])

## Switches another player's looping animation between stand and run as
## their body starts and stops moving. The entry keeps its phase so a
## crowd stays out of step.
func _set_other_gait(character_id: int, moving: bool) -> void:
	var gait: Dictionary = _other_gaits.get(character_id, {})
	if gait.is_empty() or bool(gait["moving"]) == moving:
		return
	gait["moving"] = moving
	# A sitter who moves is on their feet at once, as the server's movement
	# handler makes them (round 607); one who stops is not seated again.
	if moving:
		gait["sitting"] = false
		_other_seated.erase(character_id)
	var action := BsrReader.AnimationEntry.TYPE_RUN if moving else BsrReader.AnimationEntry.TYPE_STAND
	var anim := _body_animation_for(gait["body"], action, gait["group"])
	var frames := _frame_count(anim)
	if frames <= 1:
		return
	# Through swap_loop, which knows a one-shot's resume slot: a monster's blow
	# plays a hit on this body (_play_other_hit, round 540), and a swap that
	# appended a loop beside it would leave two entries driving one skeleton.
	MonsterMotion.swap_loop(_animated, gait["skeleton"], anim, frames, _idle_anim_time)

## Plays anim once on the player's body, over stand or run, and returns
## how long it runs. A one-shot HELD on its last frame -- the die clip,
## _player_one_shot_hold -- is not replaced (round 550): until then a swing
## whose result arrived after the die pose (sent just before the monster's
## killing swing) started over the held clip and was itself held, a dead
## body frozen mid-swing. Nothing plays over a held pose; _leave_dead_state
## releases it. Returns 0 for a refused or a one-frame clip, and sets nothing.
func _play_player_once(anim: BanReader.ParsedAnimation) -> float:
	if _player_one_shot_hold:
		return 0.0
	var frames := _frame_count(anim)
	if frames <= 1:
		return 0.0
	_player_one_shot = anim
	_player_one_shot_start = _player_anim_time
	return anim.duration_seconds()

## Plays a skill's cast animation as a one-shot. The clip is named after the
## skill's Basic_Code (anim_base, e.g. "skill_ch_sword_smash_a") and lives at
## Prim\Ani\Char\China\<man|woman>\<anim_base>.ban in Data.pk2 -- a grounded
## name-based mapping (see the skill-animations note). Returns the clip length
## in seconds, or 0 if it could not be found/parsed (caller falls back).
func _play_skill_cast_anim(anim_base: String) -> float:
	if _player_skeleton == null:
		# No assembled body at all: there is nothing to animate, and the
		# placeholder capsule has no clips.
		return 0.0
	if anim_base == "" or _data_pk2 == null:
		# No archive to read a cast clip from -- still show the weapon swing,
		# which comes from the already-parsed body assets rather than from a
		# fresh archive read. Returning 0 here left a cast with no animation
		# whatsoever, which is the shape the playtest reported.
		print("World3D: no archive for a cast clip -- falling back to the weapon swing")
		return _play_weapon_swing_anim()
	# The body's race and sex folder (round 691's cast_clip_path over round
	# 689's body): a Europe body's clips are under Prim\Ani\Char\Europe.
	var path := SkillDataReader.cast_clip_path(_body_gender(_player_body), anim_base)
	var bytes := AssetSource.read_bytes(path, _data_pk2)
	if bytes.is_empty():
		print("World3D: no cast animation at %s -- falling back to the weapon swing" % path)
		return _play_weapon_swing_anim()
	var anim := BanReader.parse(bytes)
	if anim == null or anim.bones.is_empty():
		print("World3D: could not parse cast animation %s -- falling back to the weapon swing" % path)
		return _play_weapon_swing_anim()
	return _play_player_once(anim)

## The body animation of a self or ground cast (round 616-618 integration):
## what the skill's skilleffect.txt skillaniset2 row says retail's deco start
## plays (SkillEffectReader.cast_body_anim, READ at FUN_00a54f00):
## - READY, WAIT and SHOT all "none" (Grass Walk, the imbues): nothing -- the
##   weapon swing stand-in is NOT played;
## - a WAIT (Ghost Walk: ANI_SKILL_7, action type 32): that entry of the body
##   .bsr in the ROW's AniGroup (DEFAULT for Ghost Walk: the default group's
##   skill_china_lightning_bobeop, not the sword group's downattack), played
##   once (whether retail loops it for the move is OPEN). The AniGroup name is
##   matched to the body's group name lower-cased (INFERRED); a row without one
##   uses the held weapon's group;
## - otherwise (no row, or only READY/SHOT, whose timing is unread): the path
##   targeted casts take, _play_skill_cast_anim. Returns the clip's length.
func _play_self_cast_anim(basic_code: String, anim_base: String) -> float:
	var row := SkillEffectReader.aniset_for(_skill_anisets(), basic_code)
	var plan := SkillEffectReader.cast_body_anim(row)
	match String(plan["kind"]):
		"none":
			print("CAST ANIM: %s -- skillaniset2 names no READY, WAIT or SHOT: no body animation (retail ends the deco, FUN_00a54f00)" % basic_code)
			return 0.0
		"wait":
			var t: int = int(plan["type"])
			var group: String = String(plan.get("group", ""))
			if group == "":
				group = _player_weapon_group
			var anim := _body_animation_for(_player_body, t, group)
			if anim == null:
				print("CAST ANIM: %s -- WAIT action type %d has no entry in the body for group '%s': nothing played" % [
					basic_code, t, group])
				return 0.0
			print("CAST ANIM: %s -- WAIT action type %d, group %s (%s)" % [basic_code, t, group,
				_body_animation_path(_player_body, t, group)])
			return _play_player_once(anim)
	return _play_skill_cast_anim(anim_base)

## skilleffect.txt's skillaniset rows, from the one shared parse.
func _skill_anisets() -> Dictionary:
	if _skill_anisets_loaded:
		return _skill_anisets_cache
	_skill_anisets_loaded = true
	_skill_anisets_cache = _skill_effect_tables()["aniset"]
	return _skill_anisets_cache

var _skill_anisets_cache: Dictionary = {}
var _skill_anisets_loaded := false

## The weapon's ordinary attack clip, played when a skill has no cast clip of
## its own.
##
## MEASURED, and it is why this exists: of the 338 distinct cast-clip names the
## China skill rows derive (Basic_Code lowercased, level suffix dropped), only
## **59 exist** in `Prim\Ani\Char\China\man\`. The other 82 % have no clip
## under that name, under the un-prefixed name (which gains exactly one), or in
## any skilldata column -- column 5 looked promising at 1,482 of 2,944 rows
## until it turned out to hold the base code itself, which is the same string
## the derivation already produces.
##
## So most skills genuinely ship no dedicated cast animation here, and casting
## one played nothing at all: "i used a skill, no animation" (playtest
## 2026-09-20). Showing the weapon's own swing is a DISCLOSED stand-in, not a
## recovered behaviour -- what the original plays for those skills is not known,
## and the effect layer (.efp) is the obvious place still unread.
func _play_weapon_swing_anim() -> float:
	# Try the SAME entries the ordinary swing uses, in the same order, rather
	# than a simplified version of it: the combo types first and TYPE_ATTACK
	# last. A group whose TYPE_ATTACK entry is missing but whose combo entries
	# are present would otherwise play nothing here while swinging normally
	# elsewhere, which is exactly the "no animations" symptom.
	var types: Array = ATTACK_SEQUENCE.duplicate()
	types.append(BsrReader.AnimationEntry.TYPE_ATTACK)
	for t in types:
		var action_type: int = int(t)
		var entry := _body_animation_entry(_player_body, action_type, _player_weapon_group)
		if entry == null:
			continue
		var swing := _body_animation_for(_player_body, entry.action_type, _player_weapon_group)
		if swing == null:
			continue
		var played := _play_player_once(swing)
		if played > 0.0:
			return played
	print("World3D: no swing animation for group '%s' either -- nothing to play" % _player_weapon_group)
	return 0.0

## A learned skill in the window was clicked: assign it to the next free
## underbar quickslot (its icon shown there). Activating that quickslot is what
## casts it -- the authentic Silkroad flow (the window never casts directly).
func _on_skill_assign_requested(skill_id: int, basic_code: String, icon: Texture2D) -> void:
	if not _skill_is_assignable(skill_id):
		return
	SkillEffects.preload_skill(skill_id)
	for k in range(HudUnderbar.SLOTS_PER_PAGE):
		var slot := HudUnderbar.slot_index(1, k)
		if not _quickslot_skills.has(slot) and not _quickslot_items.has(slot):
			_quickslot_skills[slot] = {"id": skill_id, "code": basic_code}
			_hud_underbar.set_slot_item(slot, icon)
			# Retail writes no line when a slot is filled (CNIFUnderMenuBar's
			# 0x60a000..0x60efff has no call to the system window's adds --
			# round 639); the log file keeps it.
			print("World3D: quickslot %d <- skill %d (%s)" % [slot, skill_id, basic_code])
			_save_hotbar()
			return
	_log_system("Quickslots are full.")

## A learned skill was dragged out of the skill window and released: put it
## on the quickslot under the mouse (replacing whatever was there), or do
## nothing when it was dropped elsewhere.
func _on_skill_drop_requested(at: Vector2, skill_id: int, basic_code: String, icon: Texture2D) -> void:
	if not _skill_is_assignable(skill_id):
		return
	var slot := _hud_underbar.slot_index_at(at)
	if slot < 0:
		return
	_quickslot_items.erase(slot)
	_quickslot_skills[slot] = {"id": skill_id, "code": basic_code}
	_hud_underbar.set_slot_item(slot, icon)
	print("World3D: quickslot %d <- skill %d (%s), dropped" % [slot, skill_id, basic_code])
	_save_hotbar()

## Whether a skill may go on the hotbar: the server has to have said the
## character knows it.
##
## The skill window only arms a drag on a learned skill, so this is a second
## gate rather than the only one -- but an unlearned skill was reaching the
## bar somehow (playtest 2026-09-20, item 3), and every route onto it passes
## through here. A refusal says so instead of failing silently, so the next
## report names the route.
func _skill_is_assignable(skill_id: int) -> bool:
	if _hud_panels == null or _hud_panels.is_skill_known(skill_id):
		return true
	_log_system("You have not learned that skill yet.")
	return false

## A quickslot was activated (clicked, or its number key pressed): cast the
## skill assigned to it.
func _on_quickslot_activated(slot_index: int) -> void:
	if _player_dead:
		# Dead (round 548): the server refuses a cast and an item alike
		# (its OpUseSkill and OpUseItem gates, the dead state's server half;
		# retail's `GetLifeState() != 1` guards), so nothing goes out.
		_log_system(DEAD_INPUT_LINE)
		return
	var entry = _quickslot_skills.get(slot_index)
	if OS.get_environment("SRREVAMP_QA_HOTKEY") != "":
		print("QA QUICKSLOT %d (%s): %s, target %d" % [slot_index, HudUnderbar.slot_label(slot_index),
			("skill %d" % int(entry["id"])) if entry != null else ("item" if _quickslot_items.has(slot_index) else "empty"),
			_last_attack_target])
	if entry != null:
		print("World3D: quickslot %d casts skill %d" % [slot_index, int(entry["id"])])
		_cast_skill(int(entry["id"]), String(entry["code"]))
		return
	# A CONSUMABLE on the bar. The quickslots held skills only until now, so a
	# potion could not be put there at all, which is what "skills should be
	# drag and drop" and the unusable HP berry were both about (playtest
	# 2026-09-20).
	var item = _quickslot_items.get(slot_index)
	if item != null and NetClient.current_character_name != "":
		print("World3D: quickslot %d uses item %d at bag slot %d" % [slot_index, int(item["item"]), int(item["slot"])])
		if _hud_panels != null:
			UiSounds.expect_use(_hud_panels.bag_item_types(int(item["slot"])))
		NetClient.use_item(NetClient.current_character_name, int(item["slot"]))

## A bag item was dragged onto the quickslot bar: remember which bag slot it
## came from and show its icon there. Activating that quickslot uses the item.
##
## The bag slot is what gets stored, because that is what OpUseItem addresses.
## It is re-resolved on every inventory refresh (_resync_quickslot_items), since
## moving or spending items shifts what lives in a slot.
func _on_item_drop_requested(at: Vector2, item_id: int, inventory_slot: int, icon: Texture2D) -> void:
	if _hud_underbar == null or item_id < 0:
		return
	var slot := _hud_underbar.slot_index_at(at)
	if slot < 0:
		return
	_quickslot_skills.erase(slot)
	_quickslot_items[slot] = {"item": item_id, "slot": inventory_slot}
	_hud_underbar.set_slot_item(slot, icon)
	print("World3D: quickslot %d <- item %d from bag slot %d" % [slot, item_id, inventory_slot])
	_save_hotbar()

## A left click on a filled quick slot (round 652): its icon goes onto the
## cursor, through the panels' shared HeldIcon.
func _on_quickslot_pick_requested(slot_index: int) -> void:
	if _hud_panels == null or _hud_underbar == null:
		return
	var tex := _hud_underbar.slot_icon(slot_index)
	_hud_panels.pick_up_icon({"kind": "quickslot", "slot": slot_index, "icon": tex}, tex,
		_hud_underbar.slot_icon_rect(slot_index), get_viewport().get_mouse_position())

## The held icon was put down off the panels (round 652): onto the quick slot
## bar, or the world.
func _on_held_dropped_outside(what: Dictionary, at: Vector2) -> void:
	var tex: Texture2D = what.get("icon") as Texture2D
	match String(what.get("kind", "")):
		"skill":
			_on_skill_drop_requested(at, int(what.get("skill_id", 0)), String(what.get("code", "")), tex)
		"bag":
			_on_item_drop_requested(at, int(what.get("item_id", -1)), int(what.get("slot", -1)), tex)
		"quickslot":
			_on_quickslot_drop_requested(at, int(what.get("slot", -1)))
		"worn":
			# On the world, not the bar: retail's CGInterface::vslot_028
			# (0x78abe0) says 0x186d for a worn item (READ).
			if _hud_underbar == null or not _hud_underbar.get_global_rect().has_point(at):
				var line := "UIIT_MSG_STRGERR_CANT_DROP_EQUIPED_ITEM_DIRECTLY"
				if _ui_builder != null:
					line = _ui_builder.resolve_text(line)
				_log_system(line)

## A quick slot's icon was put down (round 652). On another quick slot the
## two change places (CIFUnderBar::vslot_028, kind 0x0c); on itself nothing
## changes; anywhere else it comes off the bar (the bar's release hook
## vslot_026, 0x68d140, clears the slot let go of: READ, the reading of its
## flag +0x3b1 INFERRED).
func _on_quickslot_drop_requested(at: Vector2, from: int) -> void:
	if _hud_underbar == null or from < 0:
		return
	var to := _hud_underbar.slot_index_at(at)
	if to == from:
		return
	if to < 0:
		_quickslot_skills.erase(from)
		_quickslot_items.erase(from)
		_hud_underbar.clear_slot(from)
		print("World3D: quickslot %d removed (put down off the bar)" % from)
		_save_hotbar()
		return
	var from_tex := _hud_underbar.slot_icon(from)
	var to_tex := _hud_underbar.slot_icon(to)
	for table in [_quickslot_skills, _quickslot_items]:
		var a = table.get(from)
		var b = table.get(to)
		table.erase(from)
		table.erase(to)
		if a != null:
			table[to] = a
		if b != null:
			table[from] = b
	_hud_underbar.set_slot_item(to, from_tex)
	_hud_underbar.set_slot_item(from, to_tex)
	print("World3D: quickslots %d and %d changed places" % [from, to])
	_save_hotbar()

## A right click on a learned skill in the skill window (round 652): cast it,
## as a quick slot holding it would (READ: 0x682040 case 0x19 -> 0x81ba10).
func _on_skill_use_requested(skill_id: int, basic_code: String) -> void:
	if _player_dead:
		_log_system(DEAD_INPUT_LINE)
		return
	if not _skill_is_assignable(skill_id):
		return
	print("World3D: skill window casts skill %d" % skill_id)
	_cast_skill(skill_id, basic_code)

## Keeps the bar's item slots pointing at the right bag slots, and clears any
## whose item is gone (spent, sold, moved). Called whenever the bag is redrawn.
func _resync_quickslot_items(slots: Array) -> void:
	if _hud_underbar == null or _quickslot_items.is_empty():
		return
	var by_slot := {}
	var changed := false
	for entry in slots:
		var sl: InventoryNet.Slot = entry
		by_slot[sl.slot_index] = sl.item_id
	for qs in _quickslot_items.keys():
		var want := int(_quickslot_items[qs]["item"])
		var bag := int(_quickslot_items[qs]["slot"])
		var found := HudUnderbar.resolve_item_binding(want, bag, by_slot)
		if found >= 0:
			if found != bag:
				changed = true
				print("World3D: quickslot %d follows item %d from bag slot %d to %d" % [qs, want, bag, found])
			_quickslot_items[qs]["slot"] = found
		else:
			_quickslot_items.erase(qs)
			_hud_underbar.set_slot_item(qs, null)
			changed = true
			print("World3D: quickslot %d cleared: item %d is no longer in the bag" % [qs, want])
	if changed:
		_save_hotbar()

## A skill was learned (NetClient.learn_skill_done): every bar slot holding
## its previous level takes the new one, as retail's 0x60c230 does after
## AddLearnedSkill (HotbarStore.rebind_for_skill), and the bar is saved.
func _on_skill_learned_for_hotbar(skill_id: int, ok: bool) -> void:
	if not ok or _hud_panels == null or _quickslot_skills.is_empty():
		return
	var levels := _hud_panels.skill_level_ids(skill_id)
	var changed := HotbarStore.rebind_for_skill(_quickslot_skills, skill_id, true, levels, _skill_basic_code(skill_id))
	_apply_skill_rebind(changed)

## The withdrawal's half of the same rebind (0x880db0 -> 0x778840(id, 0)).
## This server has no skill withdrawal, so nothing calls it yet (OPEN); it is
## here, tested, for when one lands.
func _on_skill_withdrawn_for_hotbar(skill_id: int) -> void:
	if _hud_panels == null or _quickslot_skills.is_empty():
		return
	var levels := _hud_panels.skill_level_ids(skill_id)
	_apply_skill_rebind(HotbarStore.rebind_for_skill(_quickslot_skills, skill_id, false, levels, _skill_basic_code(skill_id)))

## A per-level skill id's own Basic_Code (skilldata column 3, the level's row;
## SkillBuffCatalog's index), or "" while the index is not ready.
func _skill_basic_code(skill_id: int) -> String:
	if _hud_buff_board == null or _hud_buff_board.catalog == null:
		return ""
	return String(_hud_buff_board.catalog.info(skill_id).get("basic_code", ""))

func _apply_skill_rebind(changed: Array) -> void:
	if changed.is_empty() or _hud_underbar == null:
		return
	for slot in changed:
		if _quickslot_skills.has(slot):
			var id := int(_quickslot_skills[slot]["id"])
			var icon: Texture2D = null
			var path := _hud_panels.skill_icon_path(id)
			if path != "" and _ui_builder != null:
				icon = _ui_builder.load_texture(path)
			_hud_underbar.set_slot_item(int(slot), icon)
			SkillEffects.preload_skill(id)
		else:
			_hud_underbar.clear_slot(int(slot))
	print("World3D: hotbar rebind for a skill change: slots %s -> %s" % [str(changed), str(_quickslot_skills)])
	_save_hotbar()

## A bag move's answer (the whole bag): keep the bar's item slots on their
## items (0x60c430's re-bind, called from the move and item results at
## 0x87b613, 0x88bd53 and 0x88c20b).
func _on_inventory_move_for_hotbar(slots: Array, error: String) -> void:
	if error != "":
		return
	_inventory_slots.assign(slots)
	_resync_quickslot_items(slots)

## The quick-slot file's entry for this character on this server (round
## 639, HotbarStore -- OURS: retail keeps the bar on the server, 0x7158).
func _hotbar_key() -> String:
	var server := "%s:%d" % [NetClient.server_host, NetClient.server_port]
	return HotbarStore.key_for(server, NetClient.current_character_name)

## Set while _restore_hotbar fills the bar, so the fill is not written back.
var _hotbar_restoring := false

## Writes the bar -- every skill and item slot on every page -- on each
## change (a skill or item put on it, an item's bag slot followed or its
## binding dropped).
func _save_hotbar() -> void:
	if _hotbar_restoring or NetClient.current_character_name == "":
		return
	var ok := HotbarStore.save(_hotbar_key(), _quickslot_skills, _quickslot_items)
	print("World3D: hotbar saved (%d skills, %d items) for %s: %s" % [_quickslot_skills.size(),
		_quickslot_items.size(), _hotbar_key(), "ok" if ok else "FAILED"])

## Fills the bar from the file: skills with their icons from the skill
## tables, items with theirs from the item table, bound to the bag slot they
## were saved with and re-resolved against the bag when it is known (now, or
## on its next list, _resync_quickslot_items).
func _restore_hotbar() -> void:
	if _hud_underbar == null or NetClient.current_character_name == "":
		return
	var bar := HotbarStore.load_bar(_hotbar_key())
	var skills: Dictionary = bar["skills"]
	var items: Dictionary = bar["items"]
	_hotbar_restoring = true
	for slot in skills:
		var e: Dictionary = skills[slot]
		_quickslot_items.erase(slot)
		_quickslot_skills[slot] = {"id": int(e["id"]), "code": String(e["code"])}
		var icon: Texture2D = null
		if _hud_panels != null and _ui_builder != null:
			var path := _hud_panels.skill_icon_path(int(e["id"]))
			if path != "":
				icon = _ui_builder.load_texture(path)
		_hud_underbar.set_slot_item(int(slot), icon)
		SkillEffects.preload_skill(int(e["id"]))
	for slot in items:
		var e: Dictionary = items[slot]
		_quickslot_skills.erase(slot)
		_quickslot_items[slot] = {"item": int(e["item"]), "slot": int(e["slot"])}
		var icon: Texture2D = null
		if _hud_panels != null and _ui_builder != null:
			var path := _hud_panels.item_icon_path(int(e["item"]))
			if path != "":
				icon = _ui_builder.load_texture(path)
		_hud_underbar.set_slot_item(int(slot), icon)
	print("World3D: hotbar restored for %s: skills %s, items %s" % [_hotbar_key(), str(skills), str(items)])
	if not _inventory_slots.is_empty():
		_resync_quickslot_items(_inventory_slots)
	_hotbar_restoring = false

## SRREVAMP_QA_LEARN's steps (see the hook in _qa_step): "<mastery>x<n>"
## raises that mastery n times, "<id>" learns that skill; each waits for its
## reply and prints it, and the skill state is re-read at the end so the
## hotbar's known-skill gate sees the result.
func _qa_learn(spec: String) -> void:
	var who := NetClient.current_character_name
	for raw in spec.split(";", false):
		var step := String(raw).strip_edges()
		if step.contains("x"):
			var parts := step.split("x")
			for i in int(parts[1]):
				NetClient.raise_mastery(who, int(parts[0]))
				var r = await NetClient.raise_mastery_result
				print("QA LEARN: mastery %s raise %d -> level %d, sp %d (%s)" % [parts[0], i + 1,
					r.new_level if r != null else -1, r.skill_points if r != null else -1, r.error if r != null else "no reply"])
		elif step.is_valid_int():
			NetClient.learn_skill(who, int(step))
			var answer: Array = await NetClient.learn_skill_result
			print("QA LEARN: skill %s -> ok %s (%s)" % [step, str(answer[0]), str(answer[1])])
	NetClient.skill_state(who)
	await NetClient.skill_state_result
	print("QA LEARN: skill state re-read (skill 3 known: %s)" % str(_hud_panels != null and _hud_panels.is_skill_known(3)))

## Casts a skill. How depends on the skill's own Target_Required and
## TargetType_Land (SelfCast.plan, round 617):
## - Target_Required 0 (Grass Walk, the imbues, the shields): cast at once
##   where the player stands, selected monster or not, as OpUseSkill
##   targetType 0 (_send_self_cast). The selection is left alone.
## - Target_Required 1 with TargetType_Land 1 (Ghost Walk): ground-pick mode
##   -- the next left click on the ground casts it there (targetType 2);
##   right click or Escape cancels.
## - Any other skill at the current target: walks into its reach first when
##   the target is out of it (_attack_monster), then plays its real cast
##   animation (from basic_code) and sends the use-skill request -- the
##   animation goes with the request, in _send_attack, so it does not play at
##   the start of a walk. With nothing selected it is refused, as before.
## The server applies the skill's real cooldown and damage.
func _cast_skill(skill_id: int, basic_code: String) -> void:
	var reach: Dictionary = _hud_panels.skill_reach(skill_id) if _hud_panels != null else {}
	var character_selected := _selected_character != -1 and (_other_bodies.has(_selected_character)
		or _selected_character == _own_id())
	var how := SelfCast.plan(reach, _last_attack_target != -1 and not character_selected, character_selected)
	# Any cast replaces a ground pick still waiting for its click.
	if how != SelfCast.PLAN_GROUND and _self_cast.cancel_pick():
		_end_ground_pick_cursor()
		print("GROUND PICK: off (another skill, %d, was cast)" % skill_id)
	match how:
		SelfCast.PLAN_SELF:
			print("World3D: skill %d: Target_Required 0 -- cast on the player, no target needed (selection %d kept)" % [
				skill_id, _last_attack_target])
			_send_self_cast(skill_id, basic_code, SkillNet.TARGET_NONE, Vector3.ZERO)
		SelfCast.PLAN_GROUND:
			_self_cast.begin_pick(skill_id, basic_code)
			_begin_ground_pick_cursor()
			print("GROUND PICK: on for skill %d (%s) -- left click the ground to cast, right click or Escape cancels" % [
				skill_id, basic_code])
			_log_system("Click on the ground to use the skill (right click or Esc cancels).")
		SelfCast.PLAN_TARGET:
			_show_target(_last_attack_target)
			_attack_monster(_last_attack_target, skill_id, basic_code)
		SelfCast.PLAN_FRIEND:
			print("World3D: skill %d: a friendly Target_Required 1 row -- cast at player %d" % [skill_id, _selected_character])
			_cast_on_character(skill_id, basic_code, _selected_character)
		SelfCast.PLAN_FRIEND_AT_MONSTER:
			# Retail's client sends it (a non-offensive row passes the monster
			# branch of FUN_0081ba10) and the server refuses it 0x3006 in the
			# skill tick's phase 0, before any walk (FUN_0058d7a0). So: sent at
			# once, no walk and no cast drawn -- the retail caster's own cast
			# starts only from the server's 0xB070 -- and the refusal is shown.
			print("World3D: skill %d: a friendly row at monster %d -- sent for the server's target test" % [
				skill_id, _last_attack_target])
			_drop_pending_attack()
			_flush_position()
			NetClient.use_skill(NetClient.current_character_name, skill_id, _last_attack_target, SkillNet.TARGET_ENTITY)
		SelfCast.PLAN_NO_TARGET:
			# READ: the retail client's own refusal, 0x3011 (FUN_0081ba10).
			print("World3D: skill %d: nothing selected -- refused as the retail client refuses it (0x3011)" % skill_id)
			_log_system(SelfCast.NO_TARGET_TEXT)
		SelfCast.PLAN_HOSTILE_AT_CHARACTER:
			# READ (round 622's review): retail's client drops an offensive
			# row at a player SILENTLY when the player is not attackable (its
			# vslot 0xa8 false, 0x81bc93..0x81bcaf: `je 0x81c577`, no message),
			# and shows 0x3022 CANT_ATTACK_PARTY_MEMBER only for an attackable
			# party member. srrevamp has no player-versus-player, so no player
			# is attackable: nothing is sent and nothing is said.
			print("World3D: skill %d at player %d: an offensive row at a player who is not attackable -- dropped silently, as retail drops it" % [
				skill_id, _selected_character])
		_:
			# Nothing selected: the original refuses too ("no target"), and a
			# swing at nothing only looked like a cast that did nothing.
			_log_system("Select a target first (click a monster), then use the skill.")

## Sends a self cast (targetType 0) or a ground cast (targetType 2, at
## `point`) from where the player stands, with the cast animation and sounds
## on the player -- the send-at-once path of _attack_monster, without a
## monster. The current selection is kept and nothing about this cast is
## pinned to it: _pending_skill_hit_code / _pending_skill_id stay with the
## monster's own cast, and the reply is recognised as this cast's
## (SelfCast.is_self_reply) rather than a blow on the target.
##
## The monster field of a self cast carries the selection when there is one.
## A server that reads targetType ignores it for type 0 (§4.0); one that
## predates the byte reach-gates a damaging Target_Required 0 row against it
## (session/skill.go skillInReach), as it did before this round. OURS.
func _send_self_cast(skill_id: int, basic_code: String, target_type: int, point: Vector3) -> void:
	if _player_dead:
		print("World3D: skill %d while dead -- not sent" % skill_id)
		return
	# A cast ends a walk into reach that was for another attack (round 519's
	# rule, as the no_walk path of _attack_monster does).
	_drop_pending_attack()
	_flush_position()
	# Round 640: a recast of a running 'onff' toggle is its switch-off --
	# sent as the same request, with no cast drawn (_own_toggle_running).
	if target_type == SkillNet.TARGET_NONE and _own_toggle_running(skill_id):
		print("TOGGLE: skill %d is running -- the recast switches it off (Tick_UseSkill phase 0); no cast drawn" % skill_id)
		NetClient.use_skill(NetClient.current_character_name, skill_id, 0, target_type, point)
		return
	var anim_base := basic_code.to_lower()
	var us := anim_base.rfind("_")
	if us > 0 and anim_base.substr(us + 1).is_valid_int():
		anim_base = anim_base.substr(0, us)
	_last_combat_time = _player_anim_time
	var clip := _play_self_cast_anim(basic_code, anim_base)
	# The effects' cast (round 616-620 integration): READY now, timed so the
	# phases agree with the body clip just played (SelfCast.effect_timings);
	# SHOT and ACT come with the server's answer -- OpBuffStart for a buff,
	# OpSkillMove for Ghost Walk, the accepted reply otherwise -- and a
	# refusal cancels it (_fx_self_cast_*).
	var fx_timings := SelfCast.effect_timings(SkillEffectReader.aniset_for(_skill_anisets(), basic_code), clip)
	_audio_cast_start(skill_id, -1, fx_timings)
	_fx_self_cast = {"skill": skill_id, "ground": target_type == SkillNet.TARGET_GROUND, "acted": false}
	print("EFFECTS self cast: skill %d %s, phase timing %s" % [skill_id,
		"ground cast (WAIT held for OpSkillMove)" if target_type == SkillNet.TARGET_GROUND else "self cast",
		str(fx_timings) if not fx_timings.is_empty() else "from skilldata"])
	_self_cast.note_cast(skill_id, Time.get_ticks_msec())
	var monster_field := 0
	if target_type == SkillNet.TARGET_NONE and _last_attack_target > 0:
		monster_field = _last_attack_target
	NetClient.use_skill(NetClient.current_character_name, skill_id, monster_field, target_type, point)

# --- Friendly targets and other players' casts (round 622) ---------------------

## A click body for another player (round 622): a capsule as tall as the
## body, on OTHER_PLAYER_COLLISION_LAYER only, so a ray can select the player
## while it blocks no movement and catches no other ray. Sized as a monster's
## click capsule is (OURS, as that one is).
func _other_player_collider(height: float) -> StaticBody3D:
	var shape := CapsuleShape3D.new()
	shape.height = maxf(height, 1.0)
	shape.radius = maxf(height * 0.3, 1.0)
	var sb := StaticBody3D.new()
	sb.name = "PlayerClickBody"
	sb.collision_layer = OTHER_PLAYER_COLLISION_LAYER
	sb.collision_mask = 0
	var cs := CollisionShape3D.new()
	cs.shape = shape
	cs.position = Vector3(0.0, shape.height * 0.5, 0.0)
	sb.add_child(cs)
	return sb

## A left click on a monster or a player (round 622's review): the NEAREST
## character under the cursor wins, whatever its kind, as retail's pick
## FUN_0078ee20 keeps the closest hit across every character object
## (`fVar1 < local_f4`) rather than trying monsters first. A monster is
## attacked (the click's old path), another player selected. The player's own
## body is in the pick only with Shift held: retail's click (0x793570) passes
## `(player+0x65c & 1) == 0 | (GetKeyState(VK_SHIFT) & 0x8000)` as the pick's
## include-self flag, and a pick with it tests the local player too, which
## FUN_00778650 then selects. +0x65c bit 0 is body state 0 (READ: the 0x30bf
## life-state handler FUN_008a80a0 sets state 0 on a revive to life state 1,
## and state 1, set for life state 2, clears it through its mask 0xffcf in
## the state table 0xec5fb8): INFERRED "alive" -- so a plain click includes
## oneself only while dead, when this client takes no world clicks at all
## (the dead state's rule, round 548). Returns the dispatch's word, or "".
func _pick_character(screen_pos: Vector2) -> String:
	if not NetClient.is_connected_to_server() or _objects_hidden:
		return ""
	var include_self := Input.is_key_pressed(KEY_SHIFT)
	var mask := MONSTER_COLLISION_LAYER | OTHER_PLAYER_COLLISION_LAYER
	# The self body exists before any Shift-click needs it: a body added in
	# this frame is not in the physics space for this frame's ray.
	_ensure_self_click_body()
	if include_self:
		mask |= SELF_CLICK_COLLISION_LAYER
	var from := camera_3d.project_ray_origin(screen_pos)
	var dir := camera_3d.project_ray_normal(screen_pos)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 2000.0)
	query.exclude = [player.get_rid()]
	query.collision_mask = mask
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	print("PICK: click at %s, Shift %s (self %s): %s" % [str(screen_pos), str(include_self),
		"in the pick" if include_self else "not in the pick", _describe_click_hit(hit, "monster_id")])
	if hit.is_empty():
		return ""
	var node := hit["collider"] as Node
	while node != null and not (node.has_meta("monster_id") or node.has_meta("character_id") or node.has_meta("self_click")):
		node = node.get_parent()
	if node == null:
		return ""
	if node.has_meta("self_click"):
		_select_self()
		return "select_self"
	if node.has_meta("character_id"):
		_select_character(int(node.get_meta("character_id")), String(node.get_meta("character_name", "")))
		return "select_player"
	# A dead monster is no target (round 677's review): its collider is
	# dropped at the death (_drop_click_body), and a ray that still met it
	# in the same frame finds nothing here.
	if _dying_until.has(int(node.get_meta("monster_id"))):
		return ""
	var monster_id := int(node.get_meta("monster_id"))
	# Select first, attack second (round 701; READ). The object click
	# FUN_00792f00 runs before the selection (0x793570) and sends the attack
	# 0x7074 for a CICMonster only when Ctrl is held (GetKeyState(0x11)) or
	# the monster is already the selection (+0x628) with the target window
	# up (FUN_00778120); otherwise the click selects (FUN_00778650: the ring,
	# texture 3) and sends the select 0x7045 (FUN_0078f5f0), whose reply shows
	# the target window. So the first click on a monster selects it and the
	# next one -- or a double click, WM_LBUTTONDBLCLK -> FUN_00792190, which
	# attacks a monster outright -- attacks. Until round 701 this client
	# attacked on the first click.
	var attack := monster_click_attacks(Input.is_key_pressed(KEY_CTRL), monster_id == _last_attack_target, _target_window_shows(monster_id))
	_last_attack_target = monster_id
	_show_target(monster_id)
	_ring_on_monster(monster_id)
	if not attack:
		return "select_monster"
	_attack_monster(monster_id)
	return "attack"

## Whether a click on a monster attacks it (READ, FUN_00792f00's CICMonster
## branch): Ctrl held, or it is the selection and the target window is up.
static func monster_click_attacks(ctrl: bool, is_selection: bool, window_shows: bool) -> bool:
	return ctrl or (is_selection and window_shows)

## Whether the target window is showing this monster (READ's FUN_00778120
## asks the target window for its object). Without a target window (a test's
## bare world) the selection alone counts.
func _target_window_shows(monster_id: int) -> bool:
	if _hud_target == null:
		return true
	return _hud_target.visible and _hud_target.shown_key == _fx_owner_key(monster_id, SkillNet.OWNER_MONSTER)

## The player's own click body (layer 9), made on first need: a capsule the
## body's height, a child of the player so it follows.
func _ensure_self_click_body() -> void:
	if player == null or player.get_node_or_null("SelfClickBody") != null:
		return
	var height := _skeleton_top(_player_skeleton) if _player_skeleton != null else 1.8 * PLAYER_SCALE_RATIO
	var sb := _other_player_collider(height)
	sb.name = "SelfClickBody"
	sb.collision_layer = SELF_CLICK_COLLISION_LAYER
	sb.set_meta("self_click", true)
	player.add_child(sb)
	print("PICK: this player's click body, height %.2f (%s)" % [height,
		"the skeleton's top" if _player_skeleton != null else "no skeleton yet: the capsule's"])

## This player's own id: OpSelfId's, else the sit answer's; -1 when neither
## has come.
func _own_id() -> int:
	var told := int(NetClient.own_character_id)
	if told >= 0:
		return told
	return int(_sit.own_id) if _sit != null else -1

## Selects this player (round 622's review): retail's two ways, a left press
## on the HUD's player block (CIFPlayerMiniInfo::vslot_030, WM_LBUTTONDOWN's
## slot in the window dispatcher 0x46c8e0 -> FUN_00780ee0(own id), which
## writes the selected id +0x628) and a Shift-click on the body. The target
## window shows the player piece with this player's name.
func _select_self() -> void:
	_sync_own_id()
	var own := _own_id()
	_last_attack_target = -1
	_selected_character = own
	if _hud_target != null:
		_hud_target.show_player(NetClient.current_character_name,
			_fx_owner_key(own, SkillNet.OWNER_CHARACTER), _race_of_body(_player_body))
	print("World3D: selected this player (%d, %s)" % [own, NetClient.current_character_name])

func _select_character(character_id: int, char_name: String) -> void:
	_last_attack_target = -1
	_selected_character = character_id
	# The ring under them (round 698; FUN_00778650: a player's is texture 2).
	_markers().attach("player:%d" % character_id, GroundMarkers.Kind.PLAYER)
	var race := -1
	var body = _other_bodies.get(character_id)
	if body != null and is_instance_valid(body) and (body as Node).has_meta("body"):
		race = _race_of_body(String((body as Node).get_meta("body")))
	if _hud_target != null:
		_hud_target.show_player(char_name, _fx_owner_key(character_id, SkillNet.OWNER_CHARACTER), race)
	print("World3D: selected player %d (%s), race %d" % [character_id, char_name, race])

## Whether a target window owner still exists (round 638 review, the
## vslot_012 mirror): a monster with a body or a snapshot, another player
## with a body, or this player (its own id, or -1 before OpSelfId).
func _target_exists(owner_key: String) -> bool:
	var parts := owner_key.split(":")
	if parts.size() != 2 or not parts[1].is_valid_int():
		return false
	var id := int(parts[1])
	if parts[0] == "monster":
		return _monster_bodies.has(id) or _monster_snapshots.has(id)
	if id == -1 or id == _own_id():
		return true
	return _other_bodies.has(id)

## A character's race for the target window's emblem (round 638): the Country
## (characterdata column 14) of the body it is drawn with -- since round 689
## its own model, the reference object retail reads +0x9c of (0x69b143). -1
## when the table has no row for it: no emblem rather than a guessed one.
func _race_of_body(code: String) -> int:
	if code == "" or not _country_by_code.has(code):
		return -1
	return int(_country_by_code[code])

## Where the server measures a player target from: the position it last sent
## for them (the body interpolates toward it).
func _other_player_ground(character_id: int) -> Vector2:
	var at = _other_body_targets.get(character_id)
	if at == null:
		var body = _other_bodies.get(character_id)
		at = (body as Node3D).position if body != null and is_instance_valid(body) else player.position
	return Vector2((at as Vector3).x, (at as Vector3).z)

## The reach band of a friendly cast at a player, as the server measures it
## (session/friendlycast.go characterInReach): both BCRadius the player
## body's, and the skill level's Range or the weapon's. {} when the skill's
## row is unknown.
func _friend_band(skill_id: int) -> Dictionary:
	var skill: Dictionary = _hud_panels.skill_reach(skill_id) if _hud_panels != null else {}
	if skill.is_empty():
		return {}
	var body_code: String = _player_body if _player_body != "" else String(GENDER_BODY_CODE[DEFAULT_GENDER])
	var caster_bc := int(_bc_radius_by_code.get(body_code, CombatNet.PLAYER_BC_RADIUS))
	return {"band": CombatNet.approach_band(caster_bc, CombatNet.PLAYER_BC_RADIUS,
		CombatNet.effective_range(int(skill["range"]), _equipped_weapon_range()))}

## Casts a friendly skill at a selected player (round 622): walks into the
## skill's reach first when the player is out of it -- the skill tick's
## phase 1 walk (MoveTowardObject), done here because srrevamp's server does
## not walk players, as for a monster (_attack_monster) -- then sends it.
func _cast_on_character(skill_id: int, basic_code: String, character_id: int) -> void:
	if _player_dead:
		print("World3D: skill %d at player %d while dead -- not sent" % [skill_id, character_id])
		return
	_drop_pending_attack()
	if character_id == _own_id() and character_id >= 0:
		# Oneself (round 622's review): no walk, cast where the player stands.
		_flush_position()
		_send_character_cast(skill_id, basic_code, character_id)
		return
	if not _other_bodies.has(character_id):
		_log_system(SelfCast.INVALID_TARGET_TEXT)
		return
	var planned := _friend_band(skill_id)
	if planned.is_empty():
		print("World3D: skill %d's Range is not known here -- sending at once; the server judges the distance" % skill_id)
		_flush_position()
		_send_character_cast(skill_id, basic_code, character_id)
		return
	var cast_root := _wall_root()
	if cast_root != 0:
		# Round 640 (OURS): rooted, so no walk -- the server judges the reach.
		_log_root("the walk into reach of player %d" % character_id, cast_root)
		_flush_position()
		_send_character_cast(skill_id, basic_code, character_id)
		return
	var band: Vector2 = planned["band"]
	_pending_friend_cast = {"character": character_id, "skill": skill_id, "code": basic_code,
		"stop": band.x, "reach": band.y}
	if not _step_pending_friend_cast() and not _pending_friend_cast.is_empty():
		print("World3D: player %d is %.1f away, out of reach %.1f (+%d) -- walking to %.1f short of them before casting skill %d" % [
			character_id, Vector2(player.position.x, player.position.z).distance_to(_other_player_ground(character_id)),
			band.y, CombatNet.REACH_SLACK, band.x, skill_id])

## One tick of the walk into a friendly cast's reach: in reach, it is sent
## (true); out of it, the walk is re-aimed at the player (false).
func _step_pending_friend_cast() -> bool:
	var character_id := int(_pending_friend_cast["character"])
	if not _other_bodies.has(character_id):
		print("World3D: player %d left before the walk reached them -- friendly cast dropped" % character_id)
		_drop_pending_attack()
		return false
	var here := Vector2(player.position.x, player.position.z)
	var there := _other_player_ground(character_id)
	var stop := float(_pending_friend_cast["stop"])
	if CombatNet.approach_releases(here.distance_to(there), stop, float(_pending_friend_cast["reach"]), false):
		_release_friend_cast()
		return true
	var point := CombatNet.approach_point(here, there, CombatNet.approach_aim(stop, false, MOVE_TARGET_STOP_DISTANCE))
	_move_target = Vector3(point.x, player.position.y, point.y)
	_has_move_target = true
	_move_heading_run = false
	return false

## Sends the pending friendly cast from where the player stands.
func _release_friend_cast() -> void:
	var c := _pending_friend_cast
	_pending_friend_cast = {}
	_has_move_target = false
	player.velocity.x = 0.0
	player.velocity.z = 0.0
	var character_id := int(c["character"])
	print("World3D: player %d in reach at %.1f (reach %.1f +%d) -- casting skill %d" % [character_id,
		Vector2(player.position.x, player.position.z).distance_to(_other_player_ground(character_id)),
		float(c["reach"]), CombatNet.REACH_SLACK, int(c["skill"])])
	_flush_position()
	_send_character_cast(int(c["skill"]), String(c["code"]), character_id)

## Sends a friendly cast at a player (OpUseSkill targetType 3, round 622),
## facing them, with the cast clip, sounds and READY effects on the player.
## The reply is recognised as this cast's (SelfCast.is_self_reply: not an
## entity reply); its SHOT and ACT play on the target's body
## (_fx_self_cast_acts) -- when its buff starts (OpBuffStart), or for any
## other row once the server accepts, after the row's own PreparingTime +
## CastingTime from the send (READ: the retail caster's cast is SHOT by the
## server's action message 0xB071, which the server sends when the context
## builder engages the cast after CastingTime; the server here resolves at
## once, so the wait is the client's).
func _send_character_cast(skill_id: int, basic_code: String, character_id: int) -> void:
	if _player_dead:
		return
	var there := _other_player_ground(character_id)
	var dir := there - Vector2(player.position.x, player.position.z)
	if not dir.is_zero_approx():
		player.rotation.y = atan2(dir.x, dir.y)
	var anim_base := basic_code.to_lower()
	var us := anim_base.rfind("_")
	if us > 0 and anim_base.substr(us + 1).is_valid_int():
		anim_base = anim_base.substr(0, us)
	_last_combat_time = _player_anim_time
	var clip := _play_self_cast_anim(basic_code, anim_base)
	var fx_timings := SelfCast.effect_timings(SkillEffectReader.aniset_for(_skill_anisets(), basic_code), clip)
	_audio_cast_start(skill_id, -1, fx_timings)
	var t: Array = SkillEffects._timings.get(skill_id, [0, 0])
	_fx_self_cast = {"skill": skill_id, "ground": false, "acted": false, "character": character_id,
		"sent_ms": Time.get_ticks_msec(), "act_after_ms": int(t[0]) + int(t[1])}
	print("EFFECTS friendly cast: skill %d at player %d, acts %d ms after the send (prep + cast)" % [
		skill_id, character_id, int(t[0]) + int(t[1])])
	_self_cast.note_cast(skill_id, Time.get_ticks_msec())
	NetClient.use_skill(NetClient.current_character_name, skill_id, character_id, SkillNet.TARGET_CHARACTER)

## "<owner key>|<skill>" -> when its OpBuffStart arrived: an act of a cast
## whose buff already started plays no ACT_L cycle (the token holds the aura).
var _recent_buff_starts: Dictionary = {}
const RECENT_BUFF_START_MS := 8000

## Someone else cast a skill (OpSkillCast, round 622; the retail analogues
## 0xB070 result 1 and 0xB071, NetProcessInNavAndSkill FUN_008a5fd0 and
## FUN_008a4960). The start plays the cast on the caster's body -- its body
## clip (as this player's own cast picks it, _play_other_cast_anim), its
## READY/SHOT-0 sounds and SkillEffects.cast with the skilldata phase timing;
## the act forces SHOT (READ: FUN_00a56680 kind 1 -> FUN_00a53090), fires
## SHOT/1 at the target and ACT_S on the body the skill acts on: the named
## character or monster, else the caster. An act whose start never arrived
## (a player who came into view mid-cast) plays the act alone.
func _on_skill_cast(sc: SkillNet.SkillCast) -> void:
	_sync_own_id()
	var body := _fx_owner_body(sc.caster_id, sc.caster_kind)
	var target: Node3D = null
	match sc.target_type:
		SkillNet.TARGET_ENTITY:
			target = _fx_monster_body(sc.target_id)
		SkillNet.TARGET_CHARACTER:
			target = _fx_owner_body(sc.target_id, SkillNet.OWNER_CHARACTER)
	if body == player:
		print("SKILL cast handled: caster %s is this player -- its own client drew it" % _fx_owner_key(sc.caster_id, sc.caster_kind))
		return
	if body == null:
		# A caster out of view (round 622's review): its act still lands on a
		# body this client draws -- a heal on this player plays SHOT/1 and
		# ACT_S here.
		if sc.phase == SkillNet.CAST_ACT and target != null:
			SkillEffects.hit(null, target, sc.skill_id)
			var n0 := SkillEffects.act(sc.skill_id, target, target, false).size()
			print("SKILL cast handled: %s (not in view) of skill %d acts on %s (%d ACT effect(s))" % [
				_fx_owner_key(sc.caster_id, sc.caster_kind), sc.skill_id, _describe_fx_target(sc), n0])
		else:
			print("SKILL cast handled: caster %s is not in view -- nothing drawn" % _fx_owner_key(sc.caster_id, sc.caster_kind))
		return
	var what := "%s's cast" % _fx_owner_key(sc.caster_id, sc.caster_kind)
	if sc.phase == SkillNet.CAST_START:
		if target != null and target != body:
			var d := Vector2(target.global_position.x - body.global_position.x, target.global_position.z - body.global_position.z)
			if not d.is_zero_approx() and sc.caster_kind == SkillNet.OWNER_CHARACTER:
				# A snap that leaves any turn in progress running, as the skill
				# action reader's bare FUN_009c4260 does (FUN_00a54be0, round
				# 637's review follow-up). OURS: the angle is toward the target;
				# retail's comes in the message.
				body.rotation.y = atan2(d.x, d.y)
		var clip := 0.0
		if sc.caster_kind == SkillNet.OWNER_CHARACTER:
			clip = _play_other_cast_anim(sc.caster_id, sc.skill_id)
		SkillAudio.play_phase(sc.skill_id, SkillAudio.READY, -1, body, what)
		SkillAudio.play_phase(sc.skill_id, SkillAudio.SHOT, 0, body, what)
		var n := SkillEffects.cast(sc.skill_id, body, target).size()
		print("SKILL cast handled: %s of skill %d started on its body (clip %.2fs, %d READY effect(s)), target %s" % [
			what, sc.skill_id, clip, n, _describe_fx_target(sc)])
		return
	var on: Node3D = target if target != null else body
	# The owner its buff (if it is one) went to: the named character or
	# monster, else the caster.
	var owner_key := _fx_owner_key(sc.caster_id, sc.caster_kind)
	if sc.target_type == SkillNet.TARGET_CHARACTER:
		owner_key = _fx_owner_key(sc.target_id, SkillNet.OWNER_CHARACTER)
	elif sc.target_type == SkillNet.TARGET_ENTITY:
		owner_key = _fx_owner_key(sc.target_id, SkillNet.OWNER_MONSTER)
	var aura_key := "%s|%d" % [owner_key, sc.skill_id]
	var buff_held := _recent_buff_starts.has(aura_key) and Time.get_ticks_msec() - int(_recent_buff_starts[aura_key]) < RECENT_BUFF_START_MS
	SkillEffects.shot(body)
	SkillEffects.hit(body, on, sc.skill_id)
	SkillAudio.play_phase(sc.skill_id, SkillAudio.SHOT, 1, body, what)
	SkillAudio.play_phase(sc.skill_id, SkillAudio.ACT_S, -1, body, what)
	var n := SkillEffects.act(sc.skill_id, on, on, not buff_held).size()
	print("SKILL cast handled: %s of skill %d acts on %s (%d ACT effect(s)%s)" % [what, sc.skill_id,
		_describe_fx_target(sc), n, ", its aura held by the buff's token" if buff_held else ""])

func _describe_fx_target(sc: SkillNet.SkillCast) -> String:
	match sc.target_type:
		SkillNet.TARGET_ENTITY:
			return "monster %d" % sc.target_id
		SkillNet.TARGET_CHARACTER:
			return "this player" if _buff_owner_is_self(sc.target_id, SkillNet.OWNER_CHARACTER) else "player %d" % sc.target_id
		SkillNet.TARGET_GROUND:
			return "the ground at (%.1f, %.1f, %.1f)" % [sc.x, sc.y, sc.z]
	return "its caster"

## Another player's cast body clip (round 622), picked as this player's own
## is (_play_self_cast_anim, SkillEffectReader.cast_body_anim): nothing for a
## row with no READY/WAIT/SHOT animation; the WAIT entry of their body in the
## row's group; otherwise the clip named after the skill's Basic_Code in
## their gender's folder, falling back to their weapon group's swing, as the
## player's own cast falls back (a DISCLOSED stand-in). Returns its length.
func _play_other_cast_anim(character_id: int, skill_id: int) -> float:
	var gait: Dictionary = _other_gaits.get(character_id, {})
	if gait.is_empty() or not is_instance_valid(gait["skeleton"]):
		return 0.0
	var code := String(SkillAudio.context_for(skill_id)["code"])
	if code == "" or code == SkillAudio.NONE:
		return 0.0
	var skel: Skeleton3D = gait["skeleton"]
	var body := String(gait["body"])
	var group := String(gait["group"])
	var plan := SkillEffectReader.cast_body_anim(SkillEffectReader.aniset_for(_skill_anisets(), code))
	match String(plan["kind"]):
		"none":
			return 0.0
		"wait":
			var g := String(plan.get("group", ""))
			var wait := _body_animation_for(body, int(plan["type"]), g if g != "" else group)
			return _play_once(skel, wait) if wait != null else 0.0
	var anim_base := code.to_lower()
	var us := anim_base.rfind("_")
	if us > 0 and anim_base.substr(us + 1).is_valid_int():
		anim_base = anim_base.substr(0, us)
	var anim: BanReader.ParsedAnimation = null
	if _data_pk2 != null:
		var path := SkillDataReader.cast_clip_path(_body_gender(body), anim_base)
		var bytes := AssetSource.read_bytes(path, _data_pk2)
		if not bytes.is_empty():
			anim = BanReader.parse(bytes)
			if anim != null and anim.bones.is_empty():
				anim = null
	if anim == null:
		anim = _body_animation_for(body, BsrReader.AnimationEntry.TYPE_ATTACK, group)
	return _play_once(skel, anim) if anim != null else 0.0

## The ground-pick mode's cursor. OURS: the mode shows the system cross in
## place of the game's arrow, and the hover cursor is not settled while it
## lasts (_settle_hover_cursor). Round 697 read every caller of the client's
## cursor manager: none sets a cursor for a ground-targeted skill (the
## forced cursors are the store's repair, an item applied to a slot and the
## socket window's two modes), so retail keeps its hover cursor here -- the
## cross is ours, kept until the user decides (docs/TODO.md).
## The default cursor shape this world last set -- kept because a headless
## display server reports none back (Input.get_current_cursor_shape), so the
## suite reads this.
var _default_cursor_shape := Input.CURSOR_ARROW

func _set_default_cursor(shape: Input.CursorShape) -> void:
	Input.set_default_cursor_shape(shape)
	_default_cursor_shape = shape

func _begin_ground_pick_cursor() -> void:
	GameCursor.suspend()
	_set_default_cursor(Input.CURSOR_CROSS)
	print("GROUND PICK: cursor -> cross (ours)")

func _end_ground_pick_cursor() -> void:
	_set_default_cursor(Input.CURSOR_ARROW)
	# Force the game's arrow back on (it is only re-applied on a change).
	_cursor_kind = "normal"
	if GameCursor.is_suspended():
		GameCursor.resume(get_window())

## Ends ground-pick mode, if it is on, saying why in the log.
func _cancel_ground_pick(why: String) -> bool:
	if not _self_cast.cancel_pick():
		return false
	_end_ground_pick_cursor()
	print("GROUND PICK: cancelled (%s)" % why)
	return true

## The world is going (_exit_tree) or the session ended (_on_disconnected,
## which the System menu's Restart and Exit reach): a pick left on would keep
## its cross cursor over the login screen (round 617's review). The pick ends
## and the default shape goes back whether or not one was on.
func _leave_ground_pick(why: String) -> void:
	_cancel_ground_pick(why)
	_set_default_cursor(Input.CURSOR_ARROW)

## A left click on the world while ground-pick mode is on: the point on the
## ground under it (the walk's own ray, _ground_point_at) is where the skill
## is cast. A click that finds no ground leaves the mode on.
func _ground_pick_click(screen_pos: Vector2) -> String:
	if _player_dead:
		_cancel_ground_pick("dead")
		return "dead"
	var point = _ground_point_at(screen_pos)
	if point == null:
		print("GROUND PICK: no ground under the click at %s -- still waiting" % str(screen_pos))
		return "ground_pick_miss"
	var pick := _self_cast.take_pick()
	_end_ground_pick_cursor()
	var at: Vector3 = point
	print("GROUND PICK: skill %d at (%.1f, %.1f, %.1f), %.1f from the player" % [
		int(pick["id"]), at.x, at.y, at.z, Vector2(at.x, at.z).distance_to(Vector2(player.position.x, player.position.z))])
	var landing := _resolve_ground_landing(int(pick["id"]), at)
	if landing.refused:
		_log_system("The skill's data is still loading -- try again in a moment.")
		return "ground_pick_refused"
	_send_self_cast(int(pick["id"]), String(pick["code"]), SkillNet.TARGET_GROUND, landing.sent)
	return "ground_pick"

## The landing a ground cast from here to `point` sends (GhostWalk, round
## 616-618 integration and its review): clamped to the row's tele value[1] in
## 3-D, as the retail server clamps, walked on the navmesh and stopped where
## retail's walk stops, truncated as retail's move record is, and kept in
## reach so the server's clamp leaves it. A reach not yet known (the skill
## index still loading) refuses the cast (OURS). Kept in _ground_landing so
## the OpSkillMove that answers it can take the landing's footing.
func _resolve_ground_landing(skill_id: int, point: Vector3) -> GhostWalk.Landing:
	var reach := 0.0
	if _hud_buff_board != null and _hud_buff_board.catalog != null:
		reach = _hud_buff_board.catalog.tele_reach(skill_id)
	if reach <= 0.0:
		print("GROUND PICK: skill %d's tele reach is not known here (index not ready, or no 'tele') -- refused, nothing sent" % skill_id)
	var footing := _nav_footing
	var footing_graph := _nav_footing_graph
	if player.global_position.distance_to(_nav_footing_pos) > NAV_FOOTING_RESETTLE_DISTANCE:
		footing = -2
	var landing := GhostWalk.resolve(player.global_position, point, reach, footing, footing_graph,
		Callable(self, "_nav_graph_for"))
	var p := landing.sent
	var c := landing.clamped
	if landing.refused:
		_ground_landing = null
		return landing
	if landing.unchecked:
		print("GROUND LANDING: skill %d -- no navmesh under the player, sending the clamped point (%.1f, %.1f, %.1f) unchecked" % [
			skill_id, c.x, c.y, c.z])
	else:
		print("GROUND LANDING: skill %d reach %.0f: clamped (%.1f, %.1f, %.1f) -> walked to (%.2f, %.2f, %.2f) on %s%s, %.2f from the player" % [
			skill_id, reach, c.x, c.y, c.z, p.x, p.y, p.z, _nav_footing_name(landing.graph, landing.footing),
			(" -- stopped at a wall" + (", sent back by the cell's objects" if landing.cancelled else "")) if landing.blocked else "",
			player.global_position.distance_to(p)])
	_ground_landing = landing
	return landing

## The last ground-cast landing sent (_resolve_ground_landing), for the
## OpSkillMove that answers it; null when none is outstanding.
var _ground_landing: GhostWalk.Landing = null

## Attacks a monster -- a plain swing, or a cast when skill_id is not 0 --
## after walking into reach if it is out of it.
##
## The engine's attack tick (CGCharAutoCommandActor::Tick_Attack 0x004ad8e0,
## and the skill tick 0x004ae590 with the skill's Range for a skill that needs
## a target) computes a band in phase 0 -- how far away the blow lands (reach)
## and where a walk toward the target aims (stop) -- and in phase 1, on EVERY
## tick, tests
## Action_IsTargetWithinReach (0x004ad4a0, `int(dist) <= reach + 2`): out of
## reach, GObjPC::MoveTowardObject(target, round(stop)) (0x004b0350) walks the
## attacker; in reach, FUN_004ad780 -> FUN_004b03f0 faces the target and drops
## that walk's target (FUN_004b0450 zeroes the +8 MoveTowardObject stored), and
## the blow is sent (phase 2). docs/protocol/auto_command.md, "The attack tick".
##
## In retail that walk is the SERVER's. srrevamp's server does not move
## players -- it refuses a blow out of reach with "too far away"
## (session/keepup.go firstSwingInReach / skillInReach) -- so the walk is done
## here and the request goes out only once the player stands in reach: an
## OpMove after the request would cancel the keep-up it starts
## (session/world.go, the move handler's keepUp.Cancel), so nothing moves
## between the two. The band and the test are the server's own
## (CombatNet.approach_band / in_reach mirror combat/reach.go), so the client
## sends exactly when the server will accept.
##
## A skill the skill tick casts without a band -- Target_Required 0, or a
## land target (Tick_UseSkill phase 0 jumps to phase 2 at 0x4ae743/0x4ae753;
## CombatNet.skill_tick_approaches) -- is sent at once from where the player
## stands, with no walk: the engine does not walk for it, and the server
## accepts the non-damaging ones at any distance.
##
## When the band cannot be computed -- a species with no BCRadius row, a skill
## the catalog does not know, no archive at all -- the request goes out at once
## and the server judges the distance, as before; the log says which.
func _attack_monster(monster_id: int, skill_id: int = 0, basic_code: String = "") -> void:
	if _player_dead:
		# Dead (round 548): no swing, no cast, no walk into reach. A world
		# click and a quickslot are stopped before this; the QA attack loop
		# is stopped at the death. The server would refuse it anyway.
		print("World3D: attack on monster %d while dead -- not sent" % monster_id)
		return
	# A new attack replaces one still walking into reach, and the walk that was
	# for it ends too: a self-cast pressed on the way (the no_walk path below)
	# would otherwise go out while the character kept walking to the old stop
	# point and then stood by the monster doing nothing (round 519's review).
	# A walk this attack needs is re-aimed by _step_pending_attack below; a
	# ground walk with no attack pending is left alone.
	_drop_pending_attack()
	var planned := _attack_band(monster_id, skill_id)
	# Both send-at-once paths tell the server where the player stands first,
	# as _release_pending_attack does. A walk just dropped above has usually
	# moved the player past MIN_SEND_DISTANCE since the last send, and without
	# this the physics send gate emitted one more OpMove within MIN_SEND_INTERVAL
	# (0.05 s) of the attack, which cancels the keep-up it had just started (world.go
	# handleMove; round 522's review). A no-op when nothing moved.
	if planned.has("no_walk"):
		print("World3D: skill %d: %s -- the skill tick casts it with no walk; sending at once" % [
			skill_id, str(planned["no_walk"])])
		_flush_position()
		_send_attack(monster_id, skill_id, basic_code)
		return
	if not planned.has("band"):
		print("World3D: no approach for monster %d (%s) -- sending at once; the server judges the distance" % [
			monster_id, str(planned.get("why", "?"))])
		_flush_position()
		_send_attack(monster_id, skill_id, basic_code)
		return
	# Round 640 (OURS): rooted by the wall, no walk into reach -- sent from
	# where the player stands; the server's reach rule answers it.
	var attack_root := _wall_root()
	if attack_root != 0:
		_log_root("the walk into reach of monster %d" % monster_id, attack_root)
		_flush_position()
		_send_attack(monster_id, skill_id, basic_code)
		return
	var band: Vector2 = planned["band"]
	_pending_attack = {"monster": monster_id, "skill": skill_id, "code": basic_code,
		"stop": band.x, "reach": band.y, "tight": false, "retries": 0}
	if not _step_pending_attack() and not _pending_attack.is_empty():
		var snap = _monster_snapshots.get(monster_id)
		var gap := Vector2(player.position.x, player.position.z).distance_to(Vector2(snap.x, snap.z))
		print("World3D: monster %d is %.1f away, out of reach %.1f (+%d) -- walking to %.1f short of it before %s" % [
			monster_id, gap, band.y, CombatNet.REACH_SLACK, band.x,
			"casting skill %d" % skill_id if skill_id != 0 else "swinging"])

## The reach band for an attack on monster_id as the server will measure it
## (session/keepup.go keepUpInReach / skillInReach): the player's BCRadius and
## the species' (characterdata col 50), and the skill level's own Range
## (skilldata col 21) or, when it has none, the weapon's (itemdata col 94).
## {"band": Vector2(stop, reach)}; {"no_walk": reason} for a skill the skill
## tick casts without a band (CombatNet.skill_tick_approaches); or
## {"why": reason} when a piece is unknown.
func _attack_band(monster_id: int, skill_id: int) -> Dictionary:
	var skill_range := 0
	if skill_id != 0:
		var skill: Dictionary = _hud_panels.skill_reach(skill_id) if _hud_panels != null else {}
		if skill.is_empty():
			return {"why": "skill %d is not in the skill catalog, so its Range is unknown" % skill_id}
		if not bool(skill["approach"]):
			return {"no_walk": "Target_Required 0 or a land target (skilldata cols 22/24)"}
		skill_range = int(skill["range"])
	var snap = _monster_snapshots.get(monster_id)
	if snap == null:
		return {"why": "not in the monster list"}
	var species: String = snap.code_name
	if species == "" or not _bc_radius_by_code.has(species):
		return {"why": "no characterdata BCRadius row for species '%s'" % species}
	# The player's own body row (_player_body). The client reads the row;
	# the server reads none -- keepUpInReach/skillInReach (session/keepup.go)
	# pass the constant combat.PlayerBCRadius for every attacker. The two agree
	# because all 52 CHAR_* rows read 4 (re-counted round 523 over the box's
	# six characterdata data files); a table whose body rows differed would
	# split them. The constant is also the fallback when the row is absent.
	var body_code: String = _player_body if _player_body != "" else String(GENDER_BODY_CODE[DEFAULT_GENDER])
	var caster_bc := int(_bc_radius_by_code.get(body_code, CombatNet.PLAYER_BC_RADIUS))
	var weapon_range := _equipped_weapon_range()
	return {"band": CombatNet.approach_band(caster_bc, int(_bc_radius_by_code[species]),
		CombatNet.effective_range(skill_range, weapon_range))}

## The weapon in hand's Range (itemdata col 94, ItemTableReader.Item.attack_range),
## as session/keepup.go's equippedWeaponRange reads it: 0 with no weapon, and 0
## while the weapon is broken -- durability.IsBroken, current == 0, the value
## at which its stats stop applying (an untracked item, -1 or absent from the
## block, counts as whole). A weapon the item table does not know gives 0 too,
## which only makes the walk stop closer than it had to.
func _equipped_weapon_range() -> int:
	var weapon_id := int(_player_equipped_last.get(EquipmentNet.SLOT_WEAPON, 0))
	if weapon_id == 0:
		return 0
	for d in NetClient.last_equipment_durabilities:
		if int(d.slot) == EquipmentNet.SLOT_WEAPON and int(d.current) == 0:
			return 0
	var row = _item_rows.get(weapon_id)
	return int(row.attack_range) if row != null else 0

## One tick of Tick_Attack phase 1 for the pending attack. In reach: release
## it (stop, tell the server where the player stands, send) and return true.
## Out of reach: aim the walk at the stop distance on the line to the target
## -- MoveTowardObject's destination, re-aimed every tick so it follows the
## target -- and return false. A target that died or left the list drops the
## attack and the walk that was for it.
func _step_pending_attack() -> bool:
	var monster_id := int(_pending_attack["monster"])
	var snap = _monster_snapshots.get(monster_id)
	if snap == null or not _monster_bodies.has(monster_id) or _dying_until.has(monster_id):
		print("World3D: monster %d died or left before the walk reached it -- attack dropped" % monster_id)
		_pending_attack = {}
		_has_move_target = false
		return false
	var here := Vector2(player.position.x, player.position.z)
	var there := Vector2(snap.x, snap.z)
	# A target walking a server-driven leg, or one the server already refused
	# as too far away, is released only inside the stop distance: from the
	# band's outer edge a receding target is out of reach by the time the
	# server measures it (CombatNet.approach_releases).
	var tight := bool(_pending_attack.get("tight", false)) or _monster_is_moving(monster_id)
	var stop := float(_pending_attack["stop"])
	if CombatNet.approach_releases(here.distance_to(there), stop, float(_pending_attack["reach"]), tight):
		_release_pending_attack()
		return true
	var point := CombatNet.approach_point(here, there,
		CombatNet.approach_aim(stop, tight, MOVE_TARGET_STOP_DISTANCE))
	_move_target = Vector3(point.x, player.position.y, point.y)
	_has_move_target = true
	_move_heading_run = false
	return false

## Drops an attack still walking into reach, and ends the walk that was for
## it -- for a click that does something else from where the player stands
## (talking to an NPC, picking up a drop within reach), a zone change, or the
## target's death. A click that starts a walk of its own replaces the move
## target instead and only clears _pending_attack.
func _drop_pending_attack() -> void:
	_released_attack = {}
	if not _pending_friend_cast.is_empty():
		_pending_friend_cast = {}
		_has_move_target = false
	if _pending_attack.is_empty():
		return
	_pending_attack = {}
	_has_move_target = false
	player.velocity.x = 0.0
	player.velocity.z = 0.0

## Sends the pending attack from where the player stands: the walk ends, the
## position goes out first (_flush_position), then the request.
func _release_pending_attack() -> void:
	var attack := _pending_attack
	_pending_attack = {}
	_has_move_target = false
	player.velocity.x = 0.0
	player.velocity.z = 0.0
	var monster_id := int(attack["monster"])
	var snap = _monster_snapshots.get(monster_id)
	if snap != null:
		print("World3D: monster %d in reach at %.1f (reach %.1f +%d%s) -- sending" % [
			monster_id, Vector2(player.position.x, player.position.z).distance_to(Vector2(snap.x, snap.z)),
			float(attack["reach"]), CombatNet.REACH_SLACK,
			", inside the stop %.1f" % float(attack["stop"]) if bool(attack.get("tight", false)) or _monster_is_moving(monster_id) else ""])
	_flush_position()
	_send_attack(monster_id, int(attack["skill"]), String(attack["code"]))
	# Kept until its result, which may send it walking again
	# (_rewalk_after_refusal). Set after the send: _send_attack clears it.
	_released_attack = attack

## The approach walk's answer to a refused release. The server measures the
## distance a round trip after the client did, and a target walking away has
## gained v x that in between; the engine's phase 1 simply keeps walking while
## the target is out of reach (docs/protocol/auto_command.md, "The attack
## tick"). So a refusal as too far away for the plain swing the walk released
## -- its target alive and not dying -- walks again, now releasing only inside
## the stop distance, up to CombatNet.APPROACH_RETRY_CAP times. A skill is not
## sent again (CombatNet.should_rewalk, round 534): its cast already played.
## True when it walks again.
func _rewalk_after_refusal(result: CombatNet.AttackResult) -> bool:
	var released := _released_attack
	_released_attack = {}
	if released.is_empty() or not _pending_attack.is_empty():
		return false
	var monster_id := int(released["monster"])
	if result.monster_id != 0 and result.monster_id != monster_id:
		return false
	var alive := _monster_snapshots.has(monster_id) and _monster_bodies.has(monster_id) \
		and not _dying_until.has(monster_id)
	var retries := int(released.get("retries", 0))
	var skill_id := int(released.get("skill", 0))
	if not CombatNet.should_rewalk(result.error, alive, retries, skill_id):
		if result.error == CombatNet.REFUSED_TOO_FAR and alive:
			if skill_id != 0:
				print("World3D: skill %d on monster %d refused as too far away -- not cast again" % [skill_id, monster_id])
			else:
				print("World3D: monster %d still too far away after %d walk(s) -- giving up" % [monster_id, retries])
		return false
	var again := released.duplicate()
	again["tight"] = true
	again["retries"] = retries + 1
	_pending_attack = again
	print("World3D: monster %d was too far away when the server measured it -- walking again (%d/%d), releasing inside the stop %.1f" % [
		monster_id, retries + 1, CombatNet.APPROACH_RETRY_CAP, float(again["stop"])])
	_step_pending_attack()
	return true

## Tells the server where the player stands now, if that is not what it was
## last told, so the request that follows is measured from here. The physics
## tick sends the same update only every MIN_SEND_INTERVAL and
## MIN_SEND_DISTANCE, and an attack sent in between would be measured from a
## stale spot. It goes BEFORE the attack: the server cancels a running keep-up
## on every OpMove (session/world.go), so a move sent after the attack would
## end the swings it had just started.
func _flush_position() -> void:
	if not NetClient.is_connected_to_server() or player.position == _last_sent_pos:
		return
	# Not while seated (round 607): the server would take it as walking off
	# and stand the character. A seated body has not moved, so a swing from
	# the seat -- which the server does not refuse -- is measured from where
	# it sits without one.
	if _sit.sitting or _motion_locked():
		return
	NetClient.move_to(player.position.x, player.position.y, player.position.z, _position_relocated())
	_last_sent_pos = player.position
	_walked_since_send = 0.0
	_time_since_send = 0.0

## Sends an attack request: a plain swing when skill_id is 0, else the cast --
## whose animation, battle stance and hit effect are armed here, when the
## request actually goes out, not when it was asked for.
##
## Any request forgets the attack the approach walk released before it
## (round 534): the next refusal answers this request, not that one. A swing
## the server drops inside its re-use delay gets no reply at all (round 255,
## session/combat.go swingReady), so without this its entry outlived it and a
## later refusal walked it again. _release_pending_attack records its own
## attack after this returns.
func _send_attack(monster_id: int, skill_id: int, basic_code: String) -> void:
	_released_attack = {}
	if skill_id == 0:
		NetClient.attack(NetClient.current_character_name, monster_id)
		return
	# basic_code carries the level suffix; derive the clip name the same way the
	# reader's BaseSkill.cast_anim_name does (lowercase, drop trailing _NN).
	var anim_base := basic_code.to_lower()
	var us := anim_base.rfind("_")
	if us > 0 and anim_base.substr(us + 1).is_valid_int():
		anim_base = anim_base.substr(0, us)
	_last_combat_time = _player_anim_time
	_play_skill_cast_anim(anim_base)
	_pending_skill_hit_code = basic_code
	_pending_skill_id = skill_id
	_audio_cast_start(skill_id, monster_id)
	if OS.get_environment("SRREVAMP_QA_HOTKEY") != "":
		print("QA CAST: use_skill %d (%s) on monster %d" % [skill_id, basic_code, monster_id])
	NetClient.use_skill(NetClient.current_character_name, skill_id, monster_id)

## The group entry behind _body_animation_for, for its events.
func _body_animation_entry(body: String, action_type: int, group: String) -> BsrReader.AnimationEntry:
	var assets := _body_assets_or_default(body)
	if assets.is_empty():
		return null
	return BodyAnimations.entry_for(assets["parsed"], action_type, group)

## The path _body_animation_for would parse, for a log line.
func _body_animation_path(body: String, action_type: int, group: String) -> String:
	var assets := _body_assets_or_default(body)
	if assets.is_empty():
		return ""
	return (assets["parsed"] as BsrReader.ParsedObject).animation_for(action_type, group).get_file()

## Queries the real server for the local player's equipped items (the same
## EquipmentNet protocol the equipment HUD uses) and reports them as
## slot -> item id. Returns nothing without querying if there's no live
## server connection -- the standalone dev-tool/screenshot contexts used
## throughout this project's asset work, which load World3D.tscn directly
## with SRREVAMP_* env vars set but no real login/enter-world flow, so a
## query would otherwise await a signal that can never fire.
func _real_player_equipped_items() -> Dictionary:
	if not NetClient.is_connected_to_server() or NetClient.current_character_name == "":
		# QA stand-in: with no server, an env-supplied loadout lets a dressed
		# character be rendered for a screenshot. The ids resolve through the
		# real item table exactly as the server's list would, so this exercises
		# the real id -> worn-model path, not a shortcut around it.
		var qa_equip := OS.get_environment("SRREVAMP_QA_EQUIP")
		if qa_equip != "":
			return _parse_qa_equip(qa_equip)
		return {}
	NetClient.list_equipment(NetClient.current_character_name)
	var answer: Array = await NetClient.equipment_result
	var items: Array = answer[0]
	print("World3D: server reports %d equipped item(s) for %s (error: %s)" % [
		items.size(), NetClient.current_character_name, str(answer[1])])
	var equipped := {}
	for item in items:
		equipped[item.slot] = item.item_id
	return equipped

## Parses a QA equipment loadout, "slot=item_id" pairs separated by commas
## (e.g. "1=3637,4=3638,5=3639,6=3632" -- chest, legs, boots, sword), into the
## slot -> item id dictionary _build_assembled_character expects. Slots are the
## EquipmentNet.SLOT_* numbers; item ids are real ones from the item table. A
## malformed pair is skipped with a log line rather than guessed at. Only the
## QA screenshot harness sets SRREVAMP_QA_EQUIP -- see _real_player_equipped_items.
func _parse_qa_equip(spec: String) -> Dictionary:
	var equipped := {}
	for pair in spec.split(",", false):
		var kv: PackedStringArray = String(pair).split("=")
		if kv.size() != 2 or not kv[0].strip_edges().is_valid_int() or not kv[1].strip_edges().is_valid_int():
			printerr("World3D: SRREVAMP_QA_EQUIP: bad pair '%s' (want slot=item_id)" % pair)
			continue
		equipped[int(kv[0].strip_edges())] = int(kv[1].strip_edges())
	print("World3D: QA equipment loadout %s" % str(equipped))
	return equipped

## Loads a real Map.pk2 region's real object placements (SRREVAMP_MAPO_PATH,
## e.g. "0\\0.o", via SRREVAMP_MAP_PK2_PATH -- same archive as
## SRREVAMP_MAPM_PATH) and renders up to MAX_MAP_OBJECTS of them with their
## real resolved .bsr models, via a real type-ID lookup
## (OBJECT_INDEX_PATH, from SRREVAMP_PK2_PATH's Data.pk2) -- see
## docs/protocol/MAPO_FORMAT.md for how this real mapping was found (it was
## a confirmed dead end earlier in this project). Skips gracefully if
## either env var is unset, or if a specific placement's type ID isn't in
## the index (real, expected -- not every real object type is necessarily
## resolvable, and this project doesn't try to hide that by falling back
## to a placeholder marker here). path_override lets _reload_zone_assets
## pass a real per-zone path it resolved itself instead of reading
## SRREVAMP_MAPO_PATH -- empty (the default) preserves the original
## env-var-only behavior for _ready()'s own call. world_offset/node_suffix
## let _load_region_neighborhood place multiple of these side by side --
## defaults preserve the original single-region behavior. Also tries the
## same region's real .o2 file (mapo_path + "2") and merges its real
## placements in, if present -- .o2 only exists for newer-generation
## ("Shape B") regions alongside .o (see docs/protocol/MAPO2_FORMAT.md and
## MAPM_FORMAT.md's Shape A/B split), so a missing .o2 is the normal,
## expected case for Shape A regions, not an error.
func _try_load_real_map_objects(path_override: String = "", world_offset: Vector3 = Vector3.ZERO, node_suffix: String = "") -> void:
	var mapo_path := path_override if path_override != "" else OS.get_environment("SRREVAMP_MAPO_PATH")
	if mapo_path == "":
		print("World3D: SRREVAMP_MAPO_PATH not set -- no real map objects loaded")
		return
	# Both halves on this thread (round 566: see _objects_prepare) -- the
	# grid's centre, every cell under SRREVAMP_SYNC_LOAD=1 and the standalone
	# paths. A streamed cell prepares the same job on its WorkerThreadPool
	# task, after its terrain (_cell_prepare), and commits it here in
	# _load_region_cell.
	var job := _objects_job(mapo_path, world_offset, node_suffix)
	_objects_prepare(job)
	_objects_commit(job)

## A region's objects prepared off the main thread (round 566).
##
## The objects of a cell are built in the same two halves as its terrain
## (_terrain_prepare). The PREPARE half -- this function, static, plain data
## -- reads the region's `.o2` and takes from it the objects the retail
## loader builds (region_placements, round 643), resolves each placement's
## model in the object index and prepares every model this world does not
## hold a template for (ObjectLoader.prepare_object: the `.bsr`/`.bms`/`.bmt`
## parsed, the mesh arrays and trimesh faces built, the textures decoded to
## Images and the alpha classified on them). The COMMIT half,
## _objects_commit, uploads the textures, commits each prepared model into
## ObjectTemplateCache -- the templates' owner since round 559, so a placed
## copy is still a duplicate() of the world's one template -- and places
## the copies, on the main thread, each object once in the world
## (_placed_objects). Until round 566 all of it ran on the main
## thread in the frame the cell was committed in: the load benchmark on
## round 565's code measured 26-83 ms of objects a streamed cell at the
## crossing and 5,346 ms over the entry's 25 cells, `templates` 3,526 of it
## (docs/RE_COMPLETION.md, round 566).
##
## It keeps THE PREPARE-THREAD RULE of _terrain_prepare: no Node and no
## RID-owning Resource (ObjectLoader.prepare_object's result holds Images,
## arrays and the readers' structs), no tree, no server, no line of its own
## printed (they go in job["log"]; a reader's push_error on a malformed file
## still prints from the task, as the terrain readers' do), no write outside
## the job, archive reads only through
## Pk2Reader, and every World3D cache it consults snapshotted into the job
## on the main thread (_objects_job): the templates held, the textures held
## (key, fourCC and measured alpha statistics -- never the texture), the
## heightmaps parsed so far. objects_prepare_test.gd walks a prepared job for
## Nodes and Resources other than Image.
##
## The region's own heightmap is read here for the grid's cache (the QA
## ground probes and _qa_ground_report read it there): the terrain prepare's
## parse when the same task made one (job["here"], _cell_prepare), else a
## parse of its own under Pk2Reader's lock, handed back in
## job["new_heightmaps"]. Until round 643 the prepare also parsed the eight
## neighbours' for an ownership test by height (_placements_belonging_here),
## which the record's own owner field replaces.
static func _objects_prepare(job: Dictionary) -> void:
	var mapo_path: String = job["mapo_path"]
	var map_archive: Pk2Reader = job["map_pk2"]
	var sw := Time.get_ticks_usec()
	# The retail client reads no `.o` (round 643): its only map-object path
	# is "%d\%d.o2" (sro_client.exe's strings hold "%d\%d.m", "%d\%d.o2" and
	# "%d\%d.t" and no "%d\%d.o"), read by FUN_00a361b0. A region without an
	# `.o2` has no objects there either.
	var mapo2_path := mapo_path + "2"
	var mapo2_bytes := AssetSource.read_bytes(mapo2_path, map_archive)
	if mapo2_bytes.is_empty():
		job["error"] = "World3D: could not find map objects at %s" % mapo2_path
		job["prepared"] = true
		return
	var region2 := MapO2Reader.parse(mapo2_bytes)
	if region2 == null:
		job["error"] = "World3D: could not parse map objects at %s" % mapo2_path
		job["prepared"] = true
		return
	var coords: Dictionary = job["coords"]
	var taken := region_placements(region2, coords)
	var deduped: Array = taken["placements"]
	(job["log"] as Array).append(["out", "World3D: %s -- %d object(s) from %d record(s) of lists 1 and 2 (%d listed again by another sector, %d with the skip bit, %d owned by a neighbour and placed in its frame)" % [
		mapo2_path, deduped.size(), taken["records"], taken["repeats"], taken["skipped"], taken["foreign"]]])
	# The region's force_addobject rows (ForceAddObjectReader, round 643's
	# review; READ: the tail of FUN_00a361b0 builds them when the region's
	# `.o2` loads, so a region without one gets none).
	var forced: Array = job.get("force_rows", [])
	if not forced.is_empty():
		deduped = deduped + forced
		(job["log"] as Array).append(["out", "World3D: %s -- %d force_addobject object(s) (%s)" % [
			mapo2_path, forced.size(), ", ".join(PackedStringArray(forced.map(func(p): return String(p["path"]).get_file())))]])
	# Seasonal event decorations left out (round 583, SeasonalObjects): before
	# the model loop, so their models and textures are never even read. Each
	# piece carries its own collision (_objects_commit), so not placing it
	# removes that too; no region's `.nvm` references a seasonal id, so
	# navigation is unchanged.
	var seasonal := SeasonalObjects.filter(deduped, job.get("seasonal_hidden", {}))
	deduped = seasonal["kept"]
	job["seasonal_hid"] = seasonal["hid"]
	if int(seasonal["total"]) > 0:
		(job["log"] as Array).append(["out", SeasonalObjects.log_line(mapo2_path, seasonal)])
	job["objects_o2"] = taken["records"]
	job["objects_foreign"] = taken["foreign"]
	sw = _job_lap(job, "parse", sw)
	# The region's own heightmap, for the grid's cache (see above).
	if not coords.is_empty():
		_job_heightmap(job, coords["x"], coords["y"])
	var placements: Array = deduped
	sw = _job_lap(job, "own", sw)

	if placements.is_empty():
		job["error"] = "World3D: no real objects parsed from %s" % mapo_path
		job["prepared"] = true
		return
	var data_archive: Pk2Reader = job["data_pk2"]
	if data_archive == null:
		job["error"] = "World3D: SRREVAMP_PK2_PATH not set -- can't resolve real object type IDs"
		job["prepared"] = true
		return
	var table: ObjidxReader.Table = job["object_index"]
	if table == null:
		# _load_object_index printed why, on the main thread, when the job
		# was built.
		job["stopped"] = true
		job["prepared"] = true
		return

	# Every model the commit will place and this world holds no template
	# for, prepared once per job however often it is placed. Bounded the
	# way the commit's loop is, by MAX_MAP_OBJECTS resolved placements: a
	# placement past a failed one may still ask for a model this did not
	# prepare, and the commit then loads it on the main thread as before
	# (_load_object_template).
	var models := {}
	var textures := {}
	var held: Dictionary = job["templates_held"]
	var known: Dictionary = job["known_textures"]
	var resolved := 0
	for placement in placements:
		if resolved >= MAX_MAP_OBJECTS:
			break
		var model_path := placement_model_path(placement, table)
		if model_path == "":
			continue
		resolved += 1
		var model_key: String = model_path.to_lower()
		if models.has(model_key) or held.has(model_key):
			continue
		models[model_key] = ObjectLoader.prepare_object(data_archive, model_path, known, textures)
	job["placements"] = placements
	job["models"] = models
	job["textures"] = textures
	_job_lap(job, "models", sw)
	job["prepared"] = true

## The objects a region's `.o2` gives the world, the way the retail loader
## takes them (round 643) -- READ in sro_client.exe's FUN_00a361b0
## (MapCallBack.cpp; docs/protocol/MAPO2_FORMAT.md):
##
## - Each of the 36 sectors has three stored lists. The loader builds every
##   record of the second and third (MapO2Reader's `lists[1]` and
##   `lists[2]`) whose byte 27 has bit 0 clear (MapO2Reader.Entry.skipped);
##   the first list is empty in every file (round 583).
## - Each record names its object by a 32-bit key, CONCAT22(bytes 28-29,
##   bytes 22-23) -- the owner region and the uid (Entry.object_key) -- and
##   is looked up in a refcounted cache (Map::FUN_00a1a1d0): the first
##   record of a key builds the object, every later one shares it. A big
##   object is listed by every sector (and every region) it reaches, and
##   exists once.
## - The position is in the OWNER region's frame. MEASURED over the 4,559
##   region `.o2` files: 10,703 keys are listed by more than one region,
##   10,682 of them at the identical local position and type in every file,
##   and 75,543 of the 75,564 keys are listed by their owner's own file.
##   So a neighbour's object is placed here at its local position plus the
##   owner's offset from this region (MapO2Reader.owner_offset).
##
## Until round 643 the world drew the region's `.o` (which retail never
## reads) and `.o2`'s `lists[2]` only, each in this region's frame, then
## dropped `.o2` entries a neighbour's ground explained better. Measured
## with server/cmd/mapobjcensus: 12,847 of the 75,564 objects retail builds
## were never drawn -- 52,366 keys sit in `lists[1]` alone, among them
## Hotan's stable and its north and south bridges and the Taklamakan temple
## with its two bridges -- and 1,064 placements matched no object retail
## builds.
##
## Returns {"placements": [{type_id, position, rotation, key}], "records",
## "repeats", "skipped", "foreign"}; `coords` is the region's
## _parse_region_coords (empty: every position is taken as given).
static func region_placements(region2: MapO2Reader.ParsedRegion, coords: Dictionary) -> Dictionary:
	var placements: Array = []
	var keys := {}
	var records := 0
	var repeats := 0
	var skipped := 0
	var foreign := 0
	for sector in region2.sectors:
		for li in [1, 2]:
			for entry in (sector as MapO2Reader.Sector).lists[li]:
				var e := entry as MapO2Reader.Entry
				records += 1
				if e.skipped():
					skipped += 1
					continue
				var key := e.object_key()
				if keys.has(key):
					repeats += 1
					continue
				keys[key] = true
				var pos := e.position
				if not coords.is_empty():
					var offset := MapO2Reader.owner_offset(e.owner_region, int(coords["x"]), int(coords["y"]))
					if offset != Vector3.ZERO:
						foreign += 1
						pos += offset
				placements.append({"type_id": e.type_id, "position": pos, "rotation": e.rotation, "key": key})
	return {"placements": placements, "records": records, "repeats": repeats, "skipped": skipped, "foreign": foreign}

## The model a placement names: its object-index entry's path, or -- for a
## force_addobject row whose path the index does not list (vslot_045 then
## appends it as a new type, READ) -- the row's own path. "" when neither.
static func placement_model_path(placement: Dictionary, table: ObjidxReader.Table) -> String:
	var entry := table.lookup(int(placement["type_id"])) if table != null and int(placement["type_id"]) >= 0 else null
	if entry != null and entry.path != "":
		return entry.path
	return String(placement.get("path", ""))

## An objects job for mapo_path, built on the main thread (round 566): the
## placement the commit needs, the readers, the object index (loaded here if
## this is the world's first region; _terrain_job loads the same table), and
## a snapshot of every cache the prepare consults -- the region's parsed
## heightmap if the grid holds it (its eight neighbours' too until round
## 643, for the ownership test region_placements replaced), the model
## paths ObjectTemplateCache holds a template for, and the textures this
## world has uploaded (ObjectLoader.snapshot_textures: key, fourCC and
## measured statistics, never a texture). See _objects_prepare.
func _objects_job(mapo_path: String, world_offset: Vector3, node_suffix: String) -> Dictionary:
	var sw := Time.get_ticks_usec()
	var table := _load_object_index()
	var coords := _parse_region_coords(mapo_path)
	var heightmaps := {}
	if not coords.is_empty():
		var key := RegionGridState.region_key(int(coords["x"]), int(coords["y"]))
		if _grid.parsed_heightmaps.has(key):
			heightmaps[key] = _grid.parsed_heightmaps[key]
	if _object_templates == null:
		_object_templates = ObjectTemplateCache.new(_load_object_template)
	var job := {
		"mapo_path": mapo_path,
		"world_offset": world_offset,
		"node_suffix": node_suffix,
		"coords": coords,
		"map_pk2": _open_map_pk2_if_set(),
		"data_pk2": _open_pk2_if_set(),
		"object_index": table,
		"seasonal_hidden": _seasonal_hidden_for(table),
		"force_rows": _force_rows_for(coords, table),
		"heightmaps": heightmaps,
		"new_heightmaps": {},
		"here": null,
		"templates_held": _object_templates.held_keys(),
		"known_textures": ObjectLoader.snapshot_textures(_object_textures),
		"threaded": false,
		"dispatched_frame": -1,
		"laps": [],
		"log": [],
	}
	_load_timings.lap("objects", "snapshot", sw)
	return job

## force_addobject.txt's rows (ForceAddObjectReader, round 643's review),
## read once per world from Media.pk2 on the main thread. Empty when the
## archive or the file is missing. Every loaded row is drawn: whether a
## fortress state hides one is OPEN, and the flags wear no emblem (OURS) --
## see ForceAddObjectReader's doc comment.
var _force_add_objects: Array[ForceAddObjectReader.Row] = []
var _force_add_objects_load_attempted := false

## One region's force_addobject rows as placements (plain data, for the
## objects job).
func _force_rows_for(coords: Dictionary, table: ObjidxReader.Table) -> Array:
	if coords.is_empty():
		return []
	if not _force_add_objects_load_attempted:
		_force_add_objects_load_attempted = true
		var archive := _open_media_pk2_if_set()
		if archive != null:
			var bytes := AssetSource.read_bytes(ForceAddObjectReader.PATH, archive)
			_force_add_objects = ForceAddObjectReader.parse(bytes)
			print("World3D: %d force_addobject row(s) loaded from %s" % [_force_add_objects.size(), ForceAddObjectReader.PATH])
	var rows := ForceAddObjectReader.rows_for(_force_add_objects, int(coords["x"]), int(coords["y"]))
	return ForceAddObjectReader.placements(rows, table)

## The seasonal event pieces to leave out of this world's regions (round
## 583): type id -> set name over the object index's own paths
## (SeasonalObjects.hidden_ids), minus the sets SRREVAMP_SEASONAL and the
## settings file show again. Built once per index, on the main thread; the
## jobs share the one Dictionary read-only.
func _seasonal_hidden_for(table: ObjidxReader.Table) -> Dictionary:
	if table == null:
		return {}
	if _seasonal_hidden_table != table:
		_seasonal_hidden = SeasonalObjects.hidden_ids(table, SeasonalObjects.enabled_from_environment())
		_seasonal_hidden_table = table
	return _seasonal_hidden

## A streamed cell's whole prepare, on its WorkerThreadPool task (round 566):
## the terrain (_terrain_prepare), then the objects (_objects_prepare) over
## the objects job _dispatch_cell put in job["objects"], handed the
## region's own heightmap the terrain has just parsed. Static, like both.
static func _cell_prepare(job: Dictionary) -> void:
	_terrain_prepare(job)
	var objects: Dictionary = job["objects"]
	objects["here"] = job.get("region")
	_objects_prepare(objects)

## The commit half of a region's objects (round 566; see _objects_prepare),
## on the main thread: the heightmaps the prepare parsed into the grid's
## cache, the textures it decoded into this world's (uploaded here), the
## container parented to the region's terrain group, and each placement a
## duplicate of the world's template for its model -- built here from the
## prepared model (_load_object_template) the first time the world places
## it.
func _objects_commit(job: Dictionary) -> void:
	_record_prepare_laps(job, "objects")
	_print_job_log(job["log"])
	var mapo_path: String = job["mapo_path"]
	if not job.get("prepared", false):
		# The task ended before its last line: a script error on the worker,
		# whose SCRIPT ERROR is in the log above this one.
		printerr("World3D: the map objects for %s were not prepared (see the error above) -- nothing placed" % mapo_path)
		return
	var new_heightmaps: Dictionary = job["new_heightmaps"]
	for key in new_heightmaps:
		if not _grid.parsed_heightmaps.has(key):
			_grid.parsed_heightmaps[key] = new_heightmaps[key]
	if job.has("error"):
		printerr(job["error"])
		return
	if job.get("stopped", false):
		return
	var placements: Array = job["placements"]
	var table: ObjidxReader.Table = job["object_index"]
	var node_suffix: String = job["node_suffix"]
	var sw := Time.get_ticks_usec()
	ObjectLoader.commit_textures(job["textures"], _object_textures)
	sw = _load_timings.lap("objects", "textures", sw)

	var container := Node3D.new()
	container.name = "RealMapObjects" + node_suffix

	# Real world-space alignment: SOLVED (2026-08-24) via a real, public,
	# non-reverse-engineered source -- JellyBitz's xSROMap
	# (https://github.com/JellyBitz/xSROMap), whose own real coordinate-
	# conversion JS confirms a region's local coordinates span exactly
	# [0, 1920) and a region ID packs as `(ySector << 8) | xSector` --
	# exactly the real REGION_SPAN (1920.0) and region-folder-name
	# convention ("98\168.m" = xSector 98, ySector 168) this project's own
	# region-streaming grid already uses for real terrain, confirming that
	# grid's math is really correct, not just internally consistent. So a
	# `.o` object's raw position is already real, absolute-within-its-
	# region data needing no artificial recentering -- it only needs the
	# exact same offset transform `_try_load_real_terrain` already
	# applies to that region's terrain (the half-REGION_SPAN centring
	# offset, and no rotation -- see its own **Corrected 2026-09-05**
	# comment for why there used to be one), so parenting this container
	# under that exact terrain node (found by its real, shared node-name
	# convention) inherits that transform automatically instead of
	# duplicating it. Falls back to the old world_offset-only placement if
	# that terrain node isn't loaded (e.g. a real `.o` with no matching
	# `.m`, or this function's own standalone/env-var call path where no
	# node_suffix was given) -- better than dropping the objects entirely.
	var terrain_node := get_node_or_null("RealTerrain" + node_suffix) if node_suffix != "" else null
	if terrain_node != null:
		terrain_node.add_child(container)
	else:
		container.position = job["world_offset"]
		add_child(container)
	_object_containers[node_suffix] = container
	# A floor the ring may lie on arrived (round 701's review).
	if _ground_markers != null:
		_ground_markers.objects_changed()

	var loaded := 0
	var skipped_unresolved := 0
	# A real region repeats the same handful of real object types across
	# dozens/hundreds of placements (see docs/PROGRESS.md -- a real 58-
	# object region had only 4 distinct types), and neighbouring regions
	# repeat each other's (the `cj_s.bsr` wall above is placed by five) --
	# so each distinct real .bsr is built once PER WORLD and duplicated per
	# placement, rather than re-parsing the same real .bms/.bmt/.ddj chain
	# per placement or per region. Until round 559 the templates were a
	# per-call dictionary that was never freed; ObjectTemplateCache has what
	# that leaked and the rules it now keeps. The region's own `.o` path is
	# its key into the cache, so the streaming unload can release what only
	# this region placed. Since round 566 a template this job prepared is
	# committed from that (_prepared_models, read by _load_object_template).
	# A prepared model whose template another job's commit built first is
	# never committed, so ITS `missing` and QA lines (`QA MAT`, `QA ALPHA`)
	# never print -- the job that committed the model printed its own, and
	# the `prepared again` line counts the copy (round 566's review: a gap in
	# the log only).
	var shared_here := 0 # keys another loaded region had already placed
	var models_here := {} # distinct model paths this region placed
	var reused_here := 0 # of those, how many another region had already built
	_prepared_models = job["models"]
	_templates_unprepared = 0
	# `templates` is lapped inside _load_object_template, one lap per build;
	# `place` is the rest of this loop -- the container, the duplicate, the
	# transform, the add -- so the two do not overlap.
	var templates_before := _load_timings.phase_usec("objects", "templates")
	for placement in placements:
		if loaded >= MAX_MAP_OBJECTS:
			break
		var model_path := placement_model_path(placement, table)
		if model_path == "":
			skipped_unresolved += 1
			continue
		# One object per key in the world, as the retail loader's refcounted
		# cache keeps it (region_placements, round 643): a key another loaded
		# region has placed is shared, not placed again.
		var key := int(placement.get("key", -1))
		if key >= 0:
			var held: Dictionary = _placed_objects.get(key, {})
			if not held.is_empty() and is_instance_valid(held["node"]):
				(held["listers"] as Dictionary)[node_suffix] = true
				shared_here += 1
				continue

		var model_key: String = model_path.to_lower()
		if not models_here.has(model_key):
			models_here[model_key] = true
			if _object_templates.has(model_key):
				reused_here += 1
		var node := _object_templates.instance(model_path, mapo_path)
		if node == null:
			continue
		# Real, absolute-within-its-region position -- see this function's
		# own doc comment above (container placement) for how this is now
		# known correct rather than an artificial recentering.
		node.position = placement["position"]
		# The game's yaw, turned the game's way: NEGATED in Godot. See
		# NavGraph.godot_yaw for the binary's own matrix (MapLoader ->
		# FUN_0043cda0, a row-vector Y rotation). Until round 506 this was the
		# raw positive yaw, which faced every object not at 0 or 180 degrees
		# the wrong way. The navigation mesh uses the same helper, so what a
		# player collides with still matches what they see.
		node.rotation.y = NavGraph.godot_yaw(placement["rotation"])
		# Named after the real model it came from, so that a node in the
		# scene tree says *which* real object it is. Without this every
		# placed object was an anonymous Node3D and the only way to work
		# out what a piece of geometry in front of the camera was, was to
		# match it against placement coordinates by hand -- see
		# _qa_look_report, which reads these names straight back.
		node.name = "Obj_%s_%d" % [model_path.get_file().get_basename(), loaded]
		container.add_child(node)
		# Round 645: its clip starts at t = 0 now, as a sector's objects do
		# in retail; object.ifo flag bit 0 keeps it running at any range.
		# A force_addobject row (round 643's review) carries the type its
		# path names in object.ifo, found as retail finds it; a path the
		# table lacks has no entry here, and the flags retail's appended
		# type gets (SWorld::vslot_045) are not read -- taken as 0 (OPEN).
		var type_id := int(placement.get("type_id", -1))
		var ifo_entry: ObjidxReader.Entry = table.lookup(type_id) if table != null else null
		if node.has_meta(MapAnimation.META_ANIMATED) or model_key.ends_with(".cpd"):
			_map_animation_poses()
			_map_animations.add(node, ifo_entry != null and (ifo_entry.flags & 1) != 0)
		loaded += 1
		if key >= 0:
			_placed_objects[key] = {"node": node, "holder": node_suffix, "listers": {node_suffix: true}}
	_prepared_models = {}
	# Retail's reflection draws the scenery too (round 628 review).
	if _water_reflection_on:
		WaterReflection.mark_reflected(container)

	_load_timings.phase("objects", "place",
		Time.get_ticks_usec() - sw - (_load_timings.phase_usec("objects", "templates") - templates_before))
	var unprepared := ""
	if job["threaded"]:
		unprepared = " -- prepared off the main thread, dispatched at frame %d; %d template(s) built unprepared" % [
			job["dispatched_frame"], _templates_unprepared]
	print("World3D: loaded %d/%d real map objects from %s2 (%d .o2 records, %d owned by a neighbour, %d already placed by a loaded region, %d unresolved type IDs skipped, %d distinct real models, %d templates reused, %d held for the world)%s" % [
		loaded, placements.size(), mapo_path, job["objects_o2"], job["objects_foreign"], shared_here, skipped_unresolved,
		models_here.size(), reused_here, _object_templates.size(), unprepared])

## Parsed `.m` heightmaps by region, for the grid's cache: the QA ground
## probes read a region's there. Until round 643 the objects prepare also
## sampled the eight neighbours' for an ownership test by height, which the
## `.o2` record's owner field replaced (region_placements). Held in
## _grid.parsed_heightmaps and dropped with the region (round 563).
##
## Since round 566 the job's view of that cache (_objects_job snapshots it):
## a heightmap not in it is read and parsed here, under Pk2Reader's lock --
## or, for the region itself, taken from the terrain prepare's parse
## (job["here"]) -- and recorded in job["new_heightmaps"], which
## _objects_commit puts in the grid's cache. A null is cached too: "tried,
## nothing".
static func _job_heightmap(job: Dictionary, region_x: int, region_y: int) -> MapmReader.ParsedRegion:
	var key := RegionGridState.region_key(region_x, region_y)
	var heightmaps: Dictionary = job["heightmaps"]
	if heightmaps.has(key):
		return heightmaps[key]
	var coords: Dictionary = job["coords"]
	var parsed: MapmReader.ParsedRegion = null
	if job["here"] != null and region_x == int(coords["x"]) and region_y == int(coords["y"]):
		parsed = job["here"]
	else:
		var bytes := AssetSource.read_bytes("%d\\%d.m" % [region_x, region_y], job["map_pk2"])
		if not bytes.is_empty():
			parsed = MapmReader.parse(bytes)
	heightmaps[key] = parsed
	(job["new_heightmaps"] as Dictionary)[key] = parsed
	return parsed

## The real player capsule's own height, read from the real shape rather
## than duplicated as a number here, so rescaling the character in the
## scene keeps the step height (see STEP_HEIGHT_FRACTION) in proportion.
func _player_capsule_height() -> float:
	var collision := player.get_node_or_null("Collision") as CollisionShape3D
	if collision != null and collision.shape is CapsuleShape3D:
		return (collision.shape as CapsuleShape3D).height
	return 0.0

## Set to "1" to move the player with Godot physics (gravity, capsule,
## move_and_slide and the _try_step_up assist) instead of on the real walkable
## graph. Kept so the two models can be compared directly within one build.
##
## The graph is the default because it is verified end to end, in a real
## running world, against the exact failure it was built to fix:
##
##   * the graph itself is verified against real data (see NavGraph);
##   * it builds correctly for every streamed region -- a real Jangan load
##     places 122/122 real objects with 411 real terrain blocking edges;
##   * and a real character climbs a real staircase with it. Dropped at the
##     foot of the real Jangan palace stairs (a real 22.1-unit ramp) with the
##     _try_step_up assist disabled, the player walked region-local y=2.12 ->
##     10.74 -> 19.64 -> 21.94, arriving at the ramp's own real top height and
##     then holding that height for 450 further frames while continuing to
##     move -- so it neither stalls on the ramp nor falls through at the top.
##     Partway along, X stops changing while Z keeps rising: a real blocking
##     edge being slid along rather than stuck to.
##   * The same harness, on the same stairs, with the reverted
##     collision-shape approach produced *zero* displacement
##     (docs/WORLD_ISSUES.md's sixty-third round).
const NAV_MOVEMENT_DISABLE_ENV := "SRREVAMP_NO_NAVMESH_MOVEMENT"

## Moves the player on the real walkable graph, the way the real client does:
## the ground's height comes from the real cell underfoot, and a move is
## refused when it crosses a real blocking edge -- an edge being a 2D line,
## never geometry.
##
## Returns false when no real graph covers the player, in which case the
## caller falls back to physics. That happens legitimately: a region with no
## `.nvm`, or the moment before one streams in.
##
## There is no gravity here and no capsule, which is not a simplification --
## the real client has neither. The previous attempt expressed this same data
## as collision shapes and failed precisely because a capsule against a
## two-sided surface pins itself against the very ramp it stands on (see
## docs/WORLD_ISSUES.md's sixty-third round).
func _move_on_nav_graph(delta: float) -> bool:
	if OS.get_environment(NAV_MOVEMENT_DISABLE_ENV) == "1":
		return false
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		return false
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]

	# The move is expressed in the region's own space, via the terrain group's
	# own transform, so the world mirror cannot skew it -- and the decision
	# itself lives in NavGraph.step_tracked, where it can be unit tested.
	var world_step := Vector3(player.velocity.x, 0.0, player.velocity.z) * delta
	var local := group.to_local(player.global_position)
	var target := group.to_local(player.global_position + world_step)

	# What the player stands on is carried from frame to frame, the way the
	# real client carries its current cell: being on an object is a state
	# entered by crossing one of its outline edges (a doorway, a stair's foot),
	# not something read off the height. It is re-settled from the height only
	# when something other than this walk moved the player -- a teleport, a
	# zone change, the physics fallback -- or when the player crossed into a
	# region whose graph numbers its objects differently.
	var trace := _qa_walk != "" or OS.get_environment("SRREVAMP_QA_NAVTRACE") != ""
	if graph != _nav_footing_graph or player.global_position.distance_to(_nav_footing_pos) > NAV_FOOTING_RESETTLE_DISTANCE:
		_nav_footing = graph.surface_at(local.x, local.z, local.y).object_index
		_nav_footing_graph = graph
		if trace:
			print("NAV %4d: footing settled on %s at local %.1f, %.1f (y %.1f)" % [
				_qa_tick, _nav_footing_name(graph, _nav_footing), local.x, local.z, local.y])
	var asked := Vector2(target.x - local.x, target.z - local.z)
	# Round 653 and its follow-up: an order in effect does not slide along a
	# wall -- it stops at it and ends (the no-slide walk and
	# ClickWalk.blocked_ends; READ: retail's collision query answers a
	# blocking edge with the crossing point, nudged at most 0.2 toward the
	# cell centre, and bit 0, which ends the mover's movement, for every
	# movement kind). An attack's or friendly cast's approach is re-issued on
	# the next tick by _step_move_order. Only the QA walk (SRREVAMP_QA_WALK, a
	# measurement path with no order) still slides.
	var slide := _qa_walk != "" and not _has_move_target
	var step := graph.step_tracked(local, asked, _nav_footing, slide)
	if _has_move_target and ClickWalk.blocked_ends(step.blocked):
		_end_blocked_click_walk(graph, step)
	if trace and OS.get_environment("SRREVAMP_QA_NAVTRACE") == "2":
		print("NAV %4d: %.2f, %.2f -> %.2f, %.2f (y %.2f) on %s" % [
			_qa_tick, local.x, local.z, step.position.x, step.position.z, step.position.y,
			_nav_footing_name(graph, step.standing_on)])
	if trace:
		if step.entered != -1:
			print("NAV %4d: onto %s at local %.1f, %.1f (y %.1f)" % [
				_qa_tick, _nav_footing_name(graph, step.entered), step.position.x, step.position.z, step.position.y])
		if step.exited != -1:
			print("NAV %4d: off %s at local %.1f, %.1f (y %.1f)" % [
				_qa_tick, _nav_footing_name(graph, step.exited), step.position.x, step.position.z, step.position.y])
		if step.blocked and not _nav_blocked_last_frame:
			print("NAV %4d: wall at local %.1f, %.1f (on %s)" % [
				_qa_tick, step.position.x, step.position.z, _nav_footing_name(graph, step.standing_on)])
		_nav_blocked_last_frame = step.blocked
	_nav_footing = step.standing_on
	player.global_position = group.to_global(step.position)
	_nav_footing_pos = player.global_position
	player.velocity.y = 0.0
	return true

## One tick of the movement order in effect (the click walk, the heading run,
## an attack's or friendly cast's approach, a pick-up walk). Round 653's
## follow-up moved it out of _physics_process so the approach's retry can be
## tested: a walk now ends at the first blocked step (ClickWalk.blocked_ends,
## READ), and an attack or friendly cast walking into reach is re-issued here
## on the next tick even though the wall ended its move -- retail's attack
## tick re-issues MoveTowardObject on every pass while out of reach
## (docs/protocol/auto_command.md, phase 1, READ). Against a wall that keeps
## it out of reach the body therefore stands at the wall facing its target,
## re-aiming every tick, until the target comes into reach or the player
## gives another order; what a retail body shows then was not read.
func _step_move_order(delta: float) -> void:
	# An attack walking into reach: Tick_Attack's phase 1 tests the reach
	# on every tick of the walk, so this does too, and the blow goes out
	# on the first frame in reach -- stopped, the position flushed, the
	# request sent -- before the send gate below could follow it with an
	# OpMove, which would cancel the keep-up it starts (_attack_monster).
	if not _pending_attack.is_empty():
		_step_pending_attack()
	if not _pending_friend_cast.is_empty():
		_step_pending_friend_cast()
	if _pending_attack.is_empty() and _pending_friend_cast.is_empty():
		_approach_blocked_at = Vector3.INF
	elif _has_move_target and _approach_blocked_at != Vector3.INF \
			and Vector2(_move_target.x - _approach_blocked_at.x, _move_target.z - _approach_blocked_at.z).length() < APPROACH_BLOCKED_HOLD:
		# OURS: the re-issued approach aims where the one a wall just ended
		# aimed -- the target has not moved -- so the body stands at the
		# wall, facing it, and the reach is still tested every tick. Stepping
		# again would only meet the same wall, and each no-slide stop nudges
		# the body up to 0.2 toward its cell's centre (READ, FUN_004472d0),
		# which at 60 re-issues a second creeps it along the wall (MEASURED
		# in click_walk_test.gd: 22.7 units in 2 s). How often retail's
		# client re-shows a server-side re-issue was not read.
		_has_move_target = false
		_aim_local_player(Vector3(_move_target.x - player.position.x, 0.0, _move_target.z - player.position.z))
	if not _has_move_target:
		# The pending attack went out this frame, or its target went away.
		player.velocity.x = 0.0
		player.velocity.z = 0.0
	elif _step_click_walk(delta):
		_ask_pickup_after_walk()
		# Arrived at the stop distance with the attack still pending. The
		# stop is never beyond the reach, so the test above fires first;
		# this only keeps an attack from being stranded, and the server
		# still judges it.
		if not _pending_attack.is_empty():
			_release_pending_attack()
		if not _pending_friend_cast.is_empty():
			_release_friend_cast()

## A zone change or teleport was accepted (round 653's review): no walk or run
## goes on into the new zone. A heading run carried on there before.
func _end_move_order_for_arrival() -> void:
	_has_move_target = false
	_move_heading_run = false
	if player != null:
		player.velocity.x = 0.0
		player.velocity.z = 0.0

## Round 653's review (OURS): a heading run whose next step has no navigation
## graph under it and no terrain either -- it ran off the loaded world --
## ends here, rather than falling under gravity until the void recovery puts
## the player back. Retail's world is always loaded around the player; what
## its mover does at an unloaded edge was not read. Returns whether it ended.
func _end_run_off_world(delta: float) -> bool:
	if not (_has_move_target and _move_heading_run):
		return false
	var next := player.position + Vector3(player.velocity.x, 0.0, player.velocity.z) * delta
	# Down to WORLD_FLOOR_Y, the void recovery's own line: VoidCatchFloor
	# (top at y -1995) is below it and is no ground.
	var hit := TerrainCollision.vertical_ray(get_world_3d().direct_space_state, next.x, next.z,
		player.position.y + 10.0, WORLD_FLOOR_Y, TERRAIN_ONLY_COLLISION_MASK, [player.get_rid()])
	if not hit.is_empty():
		return false
	_has_move_target = false
	_move_heading_run = false
	player.velocity.x = 0.0
	player.velocity.z = 0.0
	if _qa_move_log:
		print("MOVE run ended: no graph and no ground ahead at (%.3f, %.3f)" % [next.x, next.z])
	return true

## One tick of the click walk (round 649, ClickWalk.step): the player's
## horizontal velocity toward _move_target for this tick, cut on the tick that
## would reach or pass the point so the body lands on it (READ, retail's mover
## tick FUN_009e0e60), and true -- the walk over, the order cleared, the body
## stopped -- once it stands within MOVE_TARGET_STOP_DISTANCE. Before round
## 649 every tick asked for the full speed, and a step longer than the distance
## left plus the stop (a /speed of about 5.7 or more, or less with a speed buff)
## could carry the body past the point and back again on every tick, for ever.
func _step_click_walk(delta: float) -> bool:
	if _move_heading_run:
		# Round 653: a heading run has no point to arrive at -- the full run
		# speed along its heading every tick (SkyRun.velocity; READ, the
		# tick's destination test is for +0x80 == 1 only). A wall ends it
		# (_move_on_nav_graph); the turn toward the heading was started with
		# the run and goes on in _step_local_turn.
		var rv := SkyRun.velocity(_move_heading, _move_speed)
		player.velocity.x = rv.x
		player.velocity.z = rv.y
		return false
	var to_target := Vector2(_move_target.x - player.position.x, _move_target.z - player.position.z)
	var r := ClickWalk.step(to_target, _move_speed, delta, MOVE_TARGET_STOP_DISTANCE)
	if bool(r["arrived"]):
		_has_move_target = false
		player.velocity.x = 0.0
		player.velocity.z = 0.0
		return true
	var v: Vector2 = r["velocity"]
	player.velocity.x = v.x
	player.velocity.z = v.y
	# Turned toward the walk at the client's rate (round 637's review
	# follow-up), not snapped: _aim_local_player, _step_local_turn.
	_aim_local_player(Vector3(to_target.x, 0.0, to_target.y).normalized())
	return false

## Ends an order at the wall that blocked its step (round 649; round 653's
## follow-up for every order; ClickWalk.blocked_ends, READ): the order cleared
## and the body stopped where the no-slide walk left it, as an arrival does,
## and a walk to a ground item asks for it from here (the server judges the 10
## units). An attack's or friendly cast's approach keeps its pending action:
## _step_move_order re-issues the approach on the next tick, as retail's
## attack tick re-issues MoveTowardObject on every pass while out of reach
## (docs/protocol/auto_command.md, phase 1, READ).
func _end_blocked_click_walk(graph: NavGraph, step: NavGraph.StepResult) -> void:
	var was_run := _move_heading_run
	var approach := not _pending_attack.is_empty() or not _pending_friend_cast.is_empty()
	if approach:
		_approach_blocked_at = _move_target
	_has_move_target = false
	_move_heading_run = false
	player.velocity.x = 0.0
	player.velocity.z = 0.0
	if _qa_move_log or _qa_walk != "" or OS.get_environment("SRREVAMP_QA_NAVTRACE") != "":
		# An approach meets its wall on every tick it is re-issued: logged
		# once a second at most.
		var now_ms := Time.get_ticks_msec()
		if not approach or now_ms - _approach_block_logged_ms >= 1000:
			if approach:
				_approach_block_logged_ms = now_ms
			print("NAV: the %s is blocked at local %.2f, %.2f (on %s) -- ended, as retail's mover ends at a wall%s" % [
				"heading run" if was_run else ("approach" if approach else "walk"), step.position.x, step.position.z,
				_nav_footing_name(graph, step.standing_on), "; re-issued next tick" if approach else ""])
	_ask_pickup_after_walk()

## A walk up to a ground item we were too far from is over: ask again from
## where it ended; the server is the judge of the 10 units.
func _ask_pickup_after_walk() -> void:
	if _pending_pickup_id != -1 and not _pickup_inflight and NetClient.is_connected_to_server():
		_pickup_inflight = true
		NetClient.pick_up(NetClient.current_character_name, _pending_pickup_id)

## When a blocked approach was last logged (it is re-issued every tick).
var _approach_block_logged_ms := -100000
## Where the approach a wall last ended was aiming (round 653's follow-up), or
## INF: a re-issue aiming within APPROACH_BLOCKED_HOLD of it stands at the
## wall instead of stepping into it again (_step_move_order). OURS.
var _approach_blocked_at := Vector3.INF
## How far the approach's point must move (the target moving) before a
## blocked approach steps again. OURS: well under any monster's step, well
## over float noise.
const APPROACH_BLOCKED_HOLD := 0.5

## What the walk believes the player stands on: NavGraph.ON_TERRAIN or a real
## object index into the current graph's region. See _move_on_nav_graph.
var _nav_footing: int = NavGraph.ON_TERRAIN
var _nav_footing_graph: NavGraph = null
## Where the walk left the player last frame; a player found elsewhere was
## moved by something else, and the footing is re-settled from the height.
var _nav_footing_pos := Vector3.INF
var _nav_blocked_last_frame := false
## How far the player may be from where the walk left them before the
## footing is re-settled. A project choice: well above any float drift, well
## below any teleport.
const NAV_FOOTING_RESETTLE_DISTANCE := 1.0

## "terrain", or the object's model name if the graph tagged one, else its
## index -- for the walk's trace lines and the QA position line.
func _nav_footing_name(graph: NavGraph, footing: int) -> String:
	if footing == NavGraph.ON_TERRAIN:
		return "terrain"
	var placed: NavGraph.PlacedObject = graph.objects.get(footing)
	if placed != null and placed.has_meta("model"):
		return "object %s" % placed.get_meta("model")
	return "object %d" % footing

## How wide the real character shadow blob is drawn, in world units.
##
## A disclosed rendering choice, not real data: the real texture is a plain
## radial gradient with no scale baked into it, and nothing found so far says
## how large the real client draws it. Sized here a little wider than the real
## player capsule (radius 2) so it reads as a shadow under the feet.
const BLOB_SHADOW_SIZE := 9.0

## How far above the real ground the blob sits, to keep it from z-fighting the
## terrain it lies on. Also a disclosed choice.
const BLOB_SHADOW_LIFT := 0.15

var _blob_shadow: MeshInstance3D

## Builds the real character shadow.
##
## The real client does not shadow-map its terrain -- it lights terrain per
## vertex (see MapmTerrainBuilder._lit_vertex_color) and draws a character's
## shadow as a real soft radial blob, shipped as `SkyBox\shadowsphere.ddj` in
## a real Map.pk2: a real 64x64 DXT3 gradient, black at the centre fading to
## a real 64x64 DXT3 texture whose RGB is solid black and whose **alpha** is the
## radial gradient, so it draws as a soft alpha-blended black disc.
##
## Added 2026-09-07 because baking real terrain lighting made terrain unshaded,
## which removed the engine's own dynamic shadow from the ground. This restores
## a shadow the way the real client actually draws one, rather than putting the
## engine's back.
func _build_blob_shadow(blob_tex: Texture2D) -> void:
	var quad := QuadMesh.new()
	quad.size = Vector2(BLOB_SHADOW_SIZE, BLOB_SHADOW_SIZE)

	var mat := StandardMaterial3D.new()
	mat.albedo_texture = blob_tex
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	# The real texture's shape lives entirely in its **alpha**: measured, its
	# RGB is solid black (mean 0, standard deviation 0) while its alpha is the
	# radial gradient (mean 0.33, standard deviation 0.34). So it is drawn as
	# an ordinary alpha-blended black quad, and the gradient does the shaping.
	#
	# Two earlier attempts got this wrong by trusting a converted preview of
	# the texture, which composited that alpha over white and so *looked* like
	# a black-centre-to-white-edge multiply map. Both drew a hard black square.
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.blend_mode = BaseMaterial3D.BLEND_MODE_MIX
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mat.depth_draw_mode = BaseMaterial3D.DEPTH_DRAW_DISABLED

	_blob_shadow = MeshInstance3D.new()
	_blob_shadow.name = "CharacterShadow"
	_blob_shadow.mesh = quad
	_blob_shadow.material_override = mat
	# A QuadMesh faces +Z; lay it flat on the ground.
	_blob_shadow.rotation_degrees = Vector3(-90.0, 0.0, 0.0)
	_blob_shadow.visible = false
	add_child(_blob_shadow)

## Keeps the real character shadow under the player, on the real ground.
##
## The height comes from the real walkable graph rather than a raycast, so the
## shadow lands on whatever the player is actually standing on -- real terrain,
## or a real object's own navigation mesh such as a staircase or bridge.
func _update_blob_shadow() -> void:
	if _blob_shadow == null:
		return
	var pair := _nav_graph_for(player.global_position)
	if pair.is_empty():
		_blob_shadow.visible = false
		return
	var graph: NavGraph = pair[0]
	var group: Node3D = pair[1]
	var local := group.to_local(player.global_position)
	local.y = graph.height_at(local.x, local.z, local.y) + BLOB_SHADOW_LIFT
	_blob_shadow.global_position = group.to_global(local)
	# Shadow Detail "Nothing" draws no blob (round 694, apply_video_options).
	_blob_shadow.visible = video_options().value(VideoOptions.SHADOW) >= 1

