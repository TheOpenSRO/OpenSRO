func _try_add_real_sky() -> void:
	var archive := _open_map_pk2_if_set()
	if archive == null:
		print("World3D: OPENSRO_MAP_PK2_PATH not set -- sky stays a flat placeholder color")
		return

	# Real gradient sky (Godot's own ProceduralSkyMaterial, not a real
	# extracted asset -- no real single sky-gradient image was found, see
	# this function's top comment) replacing the flat background_color the
	# scene shipped with, using that same real color as the horizon tone so
	# this doesn't introduce a new invented color, only extends it into a
	# gradient.
	# GammaSkyMaterial (round 693): ProceduralSkyMaterial's own gradient,
	# drawn the same under Forward+ as under Compatibility.
	var sky_material := GammaSkyMaterial.new()
	var flat_color: Color = world_environment.environment.background_color
	sky_material.sky_top_color = flat_color.lerp(Color(0.15, 0.25, 0.55), 0.35)
	sky_material.sky_horizon_color = flat_color
	sky_material.ground_bottom_color = flat_color.darkened(0.4)
	sky_material.ground_horizon_color = flat_color
	var sky := Sky.new()
	sky.sky_material = sky_material
	world_environment.environment.sky = sky
	world_environment.environment.background_mode = Environment.BG_SKY
	_sky_material = sky_material

	# The cloud layer, as the client draws it (READ, round 628 review:
	# _build_cloud_dome, cloud_layer_mesh, cloud_dome.gdshader) -- a flat
	# grid 20000 above the eye. It replaced the finite hemisphere dome whose
	# polar-UV fade this comment used to describe (rounds 42 and 51).
	var cloud_bytes := AssetSource.read_bytes("SkyBox\\cloud1.ddj", archive)
	if not cloud_bytes.is_empty():
		var parsed := DdjReader.parse(cloud_bytes)
		if parsed != null:
			var cloud_tex := DdjReader.to_texture(parsed)
			if cloud_tex != null:
				_build_cloud_dome(cloud_tex)

	# The real character shadow: a real soft radial blob shipped as
	# SkyBox\shadowsphere.ddj. See _build_blob_shadow.
	var blob_bytes := AssetSource.read_bytes("SkyBox\\shadowsphere.ddj", archive)
	if not blob_bytes.is_empty():
		var blob_parsed := DdjReader.parse(blob_bytes)
		if blob_parsed != null:
			var blob_tex := DdjReader.to_texture(blob_parsed)
			if blob_tex != null:
				_build_blob_shadow(blob_tex)

	# The sun disc, the moon and the flare (round 786) -- not SkyBox\glow.ddj,
	# which retail loads and never draws (LensFlare's header).
	_build_sky_bodies(archive)

func _build_cloud_dome(cloud_tex: Texture2D) -> void:
	_sky_dome_material = ShaderMaterial.new()
	_sky_dome_material.shader = _cloud_dome_shader
	_sky_dome_material.set_shader_parameter("cloud_tex", cloud_tex)
	_sky_dome_material.set_shader_parameter("uv_offset", Vector2.ZERO)
	# The far plane's clip z (round 754's reversed depth; round 760: per renderer).
	_sky_dome_material.set_shader_parameter("far_clip_z",
		WorldFog.far_clip_z(RendererChoice.running() != RendererChoice.FORWARD_PLUS))
	# Drawn behind everything else transparent (cloud_dome.gdshader), after
	# the sun disc (-128) and the moon (-127), as retail's sky step draws the
	# sun, the moon, then the clouds (round 786, READ 0xa2727d, 0xa27284,
	# 0xa2737c).
	_sky_dome_material.render_priority = -126
	_sky_dome = MeshInstance3D.new()
	_sky_dome.name = "CloudDome"
	_sky_dome.mesh = cloud_layer_mesh()
	_sky_dome.material_override = _sky_dome_material
	_sky_dome.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	# The shader places it relative to the eye, so the node's own bounds mean
	# nothing: never cull it.
	_sky_dome.custom_aabb = AABB(Vector3(-1.0e7, -1.0e7, -1.0e7), Vector3(2.0e7, 2.0e7, 2.0e7))
	# Retail's reflection pass draws the sky too (round 628 review).
	_sky_dome.layers = 1 | WaterReflection.REFLECTED_BIT
	add_child(_sky_dome)

## The cloud layer's mesh (READ, Map::FUN_00a3de90): a flat 5x5-vertex grid,
## 20000 above the eye, x and z from -4,000,000 to 4,000,000 in 2,000,000
## steps, u and v from -32 to 32 in 16s; four triangles' worth of quads a
## side. Positions are offsets from the eye (cloud_dome.gdshader).
static func cloud_layer_mesh() -> ArrayMesh:
	var pos := PackedVector3Array()
	var uv := PackedVector2Array()
	for zi in range(5):
		for xi in range(5):
			pos.append(Vector3((xi - 2) * CLOUD_LAYER_STEP, CLOUD_LAYER_HEIGHT, (zi - 2) * CLOUD_LAYER_STEP))
			uv.append(Vector2((xi - 2) * CLOUD_LAYER_UV_STEP, (zi - 2) * CLOUD_LAYER_UV_STEP))
	var idx := PackedInt32Array()
	for r in range(4):
		for c in range(4):
			var i := r * 5 + c
			idx.append_array(PackedInt32Array([i, i + 1, i + 6, i, i + 6, i + 5]))
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = pos
	arrays[Mesh.ARRAY_TEX_UV] = uv
	arrays[Mesh.ARRAY_INDEX] = idx
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return mesh

## A Sun\ texture of Map.pk2 (lens2..7, moon01..30), or null.
static func _sun_texture(path: String, archive: Pk2Reader) -> Texture2D:
	var bytes := AssetSource.read_bytes(path, archive)
	if bytes.is_empty():
		return null
	var parsed := DdjReader.parse(bytes)
	return DdjReader.to_texture(parsed) if parsed != null else null

## A quad of the sky step (sky_body.gdshader): a 2 x 2 QuadMesh whose
## vertex shader builds the body's quad; drawn without the camera's
## translation, so never culled.
func _sky_body_instance(node_name: String, tex: Texture2D, flat_color: bool, half_ratio: float, priority: int) -> Array:
	var mat := ShaderMaterial.new()
	mat.shader = _sky_body_shader
	mat.render_priority = priority
	mat.set_shader_parameter("body_tex", tex)
	mat.set_shader_parameter("flat_color", flat_color)
	mat.set_shader_parameter("half_ratio", half_ratio)
	mat.set_shader_parameter("far_clip_z", WorldFog.far_clip_z(RendererChoice.running() != RendererChoice.FORWARD_PLUS))
	var mi := MeshInstance3D.new()
	mi.name = node_name
	var quad := QuadMesh.new()
	quad.size = Vector2(2.0, 2.0)
	mi.mesh = quad
	mi.material_override = mat
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	mi.custom_aabb = AABB(Vector3(-1.0e7, -1.0e7, -1.0e7), Vector3(2.0e7, 2.0e7, 2.0e7))
	# Retail's reflection pass draws the landscape pass's sky too (round 628).
	mi.layers = 1 | WaterReflection.REFLECTED_BIT
	mi.visible = false
	add_child(mi)
	return [mi, mat]

## The sun disc, the moon and the flare (round 786; READ in DayCycle and
## LensFlare). Placed and shown by _day_bodies.
func _build_sky_bodies(archive: Pk2Reader) -> void:
	_sky_bodies_archive = archive
	var lens2 := _sun_texture("Sun\\lens2.ddj", archive)
	if lens2 != null:
		var sun := _sky_body_instance("SunDisc", lens2, true, DayCycle.SUN_HALF_SIZE / DayCycle.BODY_DISTANCE, -128)
		_sun_disc = sun[0]
		_sun_disc_material = sun[1]
	else:
		print("World3D: no Sun\\lens2.ddj -- the sun disc is not drawn")
	var moon := _sky_body_instance("Moon", null, false, DayCycle.MOON_HALF_SIZE / DayCycle.BODY_DISTANCE, -127)
	_moon_disc = moon[0]
	_moon_disc_material = moon[1]
	var lenses := {}
	for n in range(3, 8):
		lenses[n] = _sun_texture("Sun\\lens%d.ddj" % n, archive)
	_lens_flare = LensFlare.new()
	_lens_flare.name = "LensFlare"
	add_child(_lens_flare)
	_lens_flare.setup(lenses)
	if _sky_dome_material != null:
		_sky_dome_material.set_shader_parameter("body_sun_tex", lens2)
		_sky_dome_material.set_shader_parameter("body_sun_half", DayCycle.SUN_HALF_SIZE / DayCycle.BODY_DISTANCE)
		_sky_dome_material.set_shader_parameter("body_moon_half", DayCycle.MOON_HALF_SIZE / DayCycle.BODY_DISTANCE)
	print("World3D: sky bodies -- sun disc %s, flare textures %s" % [
		"Sun\\lens2.ddj x SunColor" if lens2 != null else "none",
		str(lenses.keys().filter(func(k): return lenses[k] != null))])

## The moon's picture for `day`, loaded on first use.
func _moon_texture(day: int) -> Texture2D:
	var path := DayCycle.moon_texture(day)
	if not _moon_textures.has(path):
		_moon_textures[path] = _sun_texture(path, _sky_bodies_archive) if _sky_bodies_archive != null else null
	return _moon_textures[path]

## Loads and caches the real environment.ifo (Map.pk2's root) once per world --
## every real zone shares the same table, only the looked-up Key differs.
func _load_environment_table(archive: Pk2Reader) -> EnvironmentReader.ParsedFile:
	if not _environment_load_attempted:
		_environment_load_attempted = true
		var bytes := AssetSource.read_bytes("environment.ifo", archive)
		if not bytes.is_empty():
			_environment_table = EnvironmentReader.parse(bytes)
		if _environment_table == null:
			print("World3D: no real environment.ifo found -- sky keeps its flat-color-derived gradient")
	return _environment_table

## Real per-zone sky color, from a real region's own EnvironmentID (see this
## file's _sky_material doc comment for the real-data justification and the
## day phase). No-op if _sky_material was
## never built (e.g. no OPENSRO_MAP_PK2_PATH) or no matching real record is
## found -- leaves the existing flat-color-derived gradient rather than
## guessing.
func _apply_real_environment_lighting(region: MapmReader.ParsedRegion, archive: Pk2Reader) -> void:
	if _sky_material == null or region.blocks.is_empty():
		return
	var table := _load_environment_table(archive)
	if table == null:
		return
	var env_id := region.blocks[0].environment_id
	var record: EnvironmentReader.Record = null
	for rec in table.records:
		if rec.key == env_id:
			record = rec
			break
	if record == null:
		print("World3D: region's EnvironmentID %d has no matching environment.ifo record" % env_id)
		return

	# Round 786 (DayCycle): the record is read at the day phase -- the
	# server's clock in the world, the title's hour on the front end -- every
	# frame (_day_tick), as retail's environment step reads it; a world built
	# or a zone changed takes its values at once (READ: the snap flag +0x238c).
	_env_record = record
	_env_record_id = env_id
	_day_cycle.set_record(record)
	_day_cycle.snap()
	_env_time = _current_day_phase()
	var st := _day_cycle.step(_env_time, 0.0)
	_day_push(st, true)
	_day_bodies(_env_time, st)
	print("World3D: applied real environment.ifo lighting (%s, EnvironmentID=%d) at day phase %.4f -- sky_top=%s sky_bottom=%s sun_disc=%s light_diffuse=%s ambient=%s fog=%s (channel 9 %s)" % [
		record.name1, env_id, _env_time, st.sky_top, st.sky_bottom, st.sun, st.diffuse, st.object_ambient,
		EnvironmentReader.render_fog_color(st.fog), st.fog])

## The time of day (round 786): DayCycle reads the camera block's
## environment record at the day phase and eases toward it; these write the
## result where the world draws it.
var _day_cycle := DayCycle.new()
## The record the cycle reads and its EnvironmentID (-1 none).
var _env_record: EnvironmentReader.Record = null
var _env_record_id := -1
## The front end's fixed hour (title_begin), -1 in the world (the clock's).
var _env_fixed_phase := -1.0
## QA: the sky bodies stay hidden (an overview's hidden sky).
var _qa_bodies_hidden := false
## What each group was last pushed with (_day_push).
var _day_pushed := {}
var _day_sample_at := -100000
var _day_portrait_at := -100000
## OURS: the graphs are sampled ten times a second (the phase moves 0.0006 in
## that time); the easing runs every frame.
const DAY_SAMPLE_MS := 100
## OURS: a group is written again only once a value moved this much --
## 1/1024 of the display range, a quarter of an 8-bit step; the sky (whose
## material change re-renders Godot's sky radiance) at a whole 8-bit step.
const DAY_EPSILON := 1.0 / 1024.0
const DAY_SKY_EPSILON := 1.0 / 255.0
## OURS: the portrait and the paper doll re-render with the light at most
## every 2 s, and only for a change of two 8-bit steps.
const DAY_PORTRAIT_MS := 2000
const DAY_PORTRAIT_EPSILON := 2.0 / 255.0

## The day phase to draw now: the front end's fixed hour, else the server's
## clock (GameClock: NO_CLOCK_PHASE before a 0x3020).
func _current_day_phase() -> float:
	if _env_fixed_phase >= 0.0:
		return _env_fixed_phase
	return NetClient.game_clock.phase(Time.get_ticks_msec())

## The clock's day (the moon's picture), 0 before a clock (READ: SWorld's
## +0x6778 starts at 0).
func _clock_day() -> int:
	if _env_fixed_phase >= 0.0 or not NetClient.game_clock.synced:
		return 0
	return NetClient.game_clock.reading(Time.get_ticks_msec()).day

## The night flag (round 806, READ: docs/protocol/night_lights.md): the
## effect manager's +0x1a8, which SWorld::vslot_004 sets every world frame --
## dungeons included, no test before it -- from the day phase
## (GameClock.is_night_phase: clock 20:00:01 to 03:59:59; the front end's
## fixed hour likewise). It holds the night-only particles
## (EfpEffect.set_night) and lights the night-lit layers (srr_night,
## object.gdshaderinc). -1 before the first frame.
var _night := -1
## QA (OURS): OPENSRO_QA_NIGHT=on|off forces the flag whatever the clock --
## the A/B whose frame difference is what the night adds.
var _qa_night := OS.get_environment("OPENSRO_QA_NIGHT")

func _night_tick() -> void:
	var on := GameClock.is_night_phase(_current_day_phase())
	if _qa_night == "on" or _qa_night == "off":
		on = _qa_night == "on"
	if int(on) == _night:
		return
	_night = int(on)
	EfpEffect.set_night(on, get_tree())
	_world_fx.night_changed()
	RenderingServer.global_shader_parameter_set(&"srr_night", 1.0 if on else 0.0)
	var r := NetClient.game_clock.reading(Time.get_ticks_msec()) if NetClient.game_clock.synced and _env_fixed_phase < 0.0 else null
	print("World3D: night flag %s at day phase %.4f%s" % ["ON" if on else "off", _current_day_phase(),
		(" (clock %02d:%02d:%02d)" % [r.hour, r.minute, r.second]) if r != null else ""])

## Every frame in the world: the graphs re-read ten times a second, eased
## every frame (READ: dt x 0.5), written where they moved (_day_push), and the
## sun and the moon placed.
func _day_tick(delta: float) -> void:
	if _env_record == null or _dungeon != null:
		return
	var fs := FrameSplit.on
	var t0 := Time.get_ticks_usec() if fs else 0
	var now := Time.get_ticks_msec()
	var resample := now - _day_sample_at >= DAY_SAMPLE_MS
	# The shadow light (OURS, round 786): its target with each sample, its
	# glide every frame until it arrives.
	if resample:
		_sun_shadow_target(_current_day_phase())
	if not _sun_shadow_settled:
		_sun_shadow_glide(delta)
	if not resample and _day_cycle.settled:
		# Nothing left to ease and no new sample: nothing moved.
		return
	if resample:
		_day_sample_at = now
		_env_time = _current_day_phase()
	var st := _day_cycle.step(_env_time, delta, resample)
	_day_push(st, false)
	if resample:
		_day_bodies(_env_time, st)
	if fs:
		FrameSplit.add("w_day", Time.get_ticks_usec() - t0)

## OURS (round 786, NightLight): the night's scale now -- 1 on the front end
## (its fixed hour keeps retail's look), in a dungeon, with no record and with
## Night Darkness at Original.
var _night_k := 1.0
## The record's noon light (NightLight.noon_metric), per record.
var _night_noon_record: EnvironmentReader.Record = null
var _night_noon := 0.0

func _night_scale(st: DayCycle.State) -> float:
	if st == null or _env_record == null or _env_fixed_phase >= 0.0 or _dungeon != null:
		return 1.0
	var lvl := NightLight.level(video_options().value(VideoOptions.NIGHT))
	if lvl <= 0.0:
		return 1.0
	if _night_noon_record != _env_record:
		_night_noon_record = _env_record
		_night_noon = NightLight.noon_metric(_env_record)
	return NightLight.scale(_night_noon, NightLight.light_metric(st.diffuse, st.object_ambient),
		NightLight.amount(_env_time), lvl)

## The shadow light (OURS, round 786, NightLight): the direction to it and its
## strength as applied, the target, and whether the glide has arrived.
var _sun_shadow_dir := Vector3.ZERO
var _sun_shadow_goal := Vector3.ZERO
var _sun_shadow_strength := -1.0
var _sun_shadow_settled := true
## Whether the light is turned from the scene's (the row on).
var _sun_shadow_active := false
## The scene's own light basis (the fixed direction the shadows kept before
## round 786, and keep with the row Off), taken before the first turn.
var _scene_light_basis := Basis.IDENTITY
var _scene_light_taken := false

func _take_scene_light() -> void:
	if not _scene_light_taken and directional_light != null:
		_scene_light_basis = directional_light.basis
		_scene_light_taken = true

## The fixed direction to the light the terrain's N.L is baked against
## (round 786's: the scene light's), whichever way the shadow light turns.
func _fixed_to_light() -> Vector3:
	_take_scene_light()
	var parent := directional_light.get_parent() as Node3D
	if parent != null and parent.is_inside_tree():
		return parent.global_transform.basis * _scene_light_basis.z
	return _scene_light_basis.z

func _sun_shadows_on() -> bool:
	return _env_fixed_phase < 0.0 and video_options().value(VideoOptions.SUN_SHADOWS) == 1 \
		and video_options().value(VideoOptions.SHADOW) >= 2

## A new target from the phase, when it moved a step (NightLight's rule).
func _sun_shadow_target(phase: float) -> void:
	if directional_light == null:
		return
	_take_scene_light()
	if not _sun_shadows_on():
		if _sun_shadow_active:
			# Back to the fixed light at full strength (the row turned off).
			directional_light.basis = _scene_light_basis
			ShadowCatcher.set_strength(1.0)
			_sun_shadow_active = false
		_sun_shadow_strength = -1.0
		_sun_shadow_dir = Vector3.ZERO
		_sun_shadow_goal = Vector3.ZERO
		_sun_shadow_settled = true
		return
	_sun_shadow_active = true
	var want: Array = NightLight.shadow_light(phase, _clock_day())
	var dir: Vector3 = want[0]
	var strength: float = want[1]
	if _sun_shadow_strength < 0.0 or absf(strength - _sun_shadow_strength) >= NightLight.STRENGTH_EPSILON \
			or (strength == 0.0 and _sun_shadow_strength != 0.0):
		_sun_shadow_strength = strength
		ShadowCatcher.set_strength(strength)
	if _sun_shadow_goal == Vector3.ZERO or NightLight.should_retarget(_sun_shadow_goal, dir):
		_sun_shadow_goal = dir
		_sun_shadow_settled = false
		if _sun_shadow_dir == Vector3.ZERO:
			_sun_shadow_dir = dir
			directional_light.basis = NightLight.light_basis(dir)
			_sun_shadow_settled = true

## The light glides toward the target (and stops once there).
func _sun_shadow_glide(delta: float) -> void:
	if _sun_shadow_goal == Vector3.ZERO or directional_light == null:
		_sun_shadow_settled = true
		return
	var g: Array = NightLight.glide(_sun_shadow_dir, _sun_shadow_goal, delta, maxf(_sun_shadow_strength, 0.0))
	_sun_shadow_dir = g[0]
	_sun_shadow_settled = g[1]
	directional_light.basis = NightLight.light_basis(_sun_shadow_dir)

## Takes the shadow light to the phase at once (a QA clock pin, a setting).
func _sun_shadow_snap() -> void:
	_sun_shadow_goal = Vector3.ZERO
	_sun_shadow_dir = Vector3.ZERO
	_sun_shadow_strength = -1.0
	if _env_record != null and _dungeon == null:
		_sun_shadow_target(_current_day_phase())

static func _day_moved(before: Array, now: Array, eps: float) -> bool:
	if before.size() != now.size():
		return true
	for i in range(now.size()):
		var a = before[i]
		var b = now[i]
		if a is Color:
			var ca: Color = a
			var cb: Color = b
			if absf(ca.r - cb.r) >= eps or absf(ca.g - cb.g) >= eps or absf(ca.b - cb.b) >= eps:
				return true
		elif absf(float(a) - float(b)) >= eps:
			return true
	return false

## Whether a group's values moved enough to write them (and remembers them).
func _day_take(group: String, values: Array, eps: float, force: bool) -> bool:
	if force or _day_moved(_day_pushed.get(group, []), values, eps):
		_day_pushed[group] = values
		return true
	return false

## Writes the cycle's values where the world draws them (round 786; READ
## channel roles in DayCycle's header and each consumer's own). `force`
## writes every group, with the log lines a zone's environment has always
## printed; otherwise a group is written only when it moved enough to show.
func _day_push(st: DayCycle.State, force: bool) -> void:
	if st == null:
		return
	# OURS (round 786, NightLight): the night's scale -- k on the lights,
	# k^0.75 on the sky, the fog and the clouds; 1 by day, at Original, on the
	# front end and with no record. Every group below writes the scaled value.
	_night_k = _night_scale(st)
	var nk := _night_k
	var ns := NightLight.sky_scale(nk)
	var sky_top := NightLight.scaled(st.sky_top, ns)
	var sky_bottom := NightLight.scaled(st.sky_bottom, ns)
	var sky_moved := false
	# The sky's gradient: channels 1 (top) and 13 (bottom).
	if _sky_material != null and _day_take("sky", [sky_top, sky_bottom], DAY_SKY_EPSILON, force):
		_sky_material.sky_top_color = sky_top
		_sky_material.sky_horizon_color = sky_bottom
		_sky_material.ground_horizon_color = sky_bottom
		_sky_material.ground_bottom_color = sky_bottom.darkened(0.4)
		sky_moved = true
	# The light: channel 2 (diffuse) on the directional light and in the
	# objects' formula, channel 3 the objects' ambient (ObjectLight, round 706).
	# Roles corrected 2026-09-07 from the client's own terrain vertex shader
	# (`mad oD0, N.L, c[VSC_DLIGHT_DIFFUSE], c[VSC_DLIGHT_AMBIENT]`,
	# docs/RE_MAP_ENGINE.md): the diffuse channel is the term multiplied by
	# N.L. Channel 0 (SunColor) is the sun disc's colour (round 786:
	# Map::FUN_00a207a0's texture factor), not a light.
	if _day_take("light", [NightLight.scaled(st.diffuse, nk), NightLight.scaled(st.object_ambient, nk)], DAY_EPSILON, force):
		directional_light.light_color = NightLight.scaled(st.diffuse, nk)
		world_environment.environment.ambient_light_color = NightLight.scaled(st.object_ambient, nk)
		# Round 808's follow-up: the footprints take the object ambient
		# (Footprints: world +0x6853..).
		if _footprints != null:
			_footprints.set_tint(NightLight.scaled(st.object_ambient, nk))
		# The zone's own channels (the portrait's light); _apply_object_light
		# and the line below apply the night's scale to the world.
		_object_light_channels = [st.diffuse, st.object_ambient]
		_portrait_zone_light = [st.diffuse, st.object_ambient]
		if force:
			# Logs, and tells the portrait and the paper doll.
			_apply_object_light()
			_day_pushed["portrait"] = [st.diffuse, st.object_ambient]
			_day_portrait_at = Time.get_ticks_msec()
			if _hud_player_info != null:
				var pp := _hud_player_info.portrait()
				print("World3D: portrait zone light (EnvironmentID %d): diffuse channel %s ambient channel %s, renders %d" % [
					_env_record_id, st.diffuse, st.object_ambient, pp.renders_requested if pp != null else -1])
		else:
			ObjectLight.set_light(NightLight.scaled(st.diffuse, nk), NightLight.scaled(st.object_ambient, nk),
				video_options().value(VideoOptions.BLOOM) == 1)
	# The portrait and the paper doll re-render with the light: not often.
	if not force and Time.get_ticks_msec() - _day_portrait_at >= DAY_PORTRAIT_MS \
			and _day_take("portrait", [st.diffuse, st.object_ambient], DAY_PORTRAIT_EPSILON, false):
		_day_portrait_at = Time.get_ticks_msec()
		if _paper_doll != null:
			_paper_doll.set_zone_light(st.diffuse, st.object_ambient)
		if _hud_player_info != null:
			_hud_player_info.set_portrait_zone_light(st.diffuse, st.object_ambient)
	# The terrain: channels 2, 5 and 6 (TerrainLight). Kept for a terrain
	# built with the bake (OPENSRO_QA_TERRAIN_BAKE) and the QA log.
	_env_light_diffuse = st.diffuse
	_env_terrain_ambient = st.terrain_ambient
	_env_terrain_shadow = st.terrain_shadow
	_env_light_ready = true
	if _day_take("terrain", [st.diffuse, st.terrain_ambient, st.terrain_shadow, nk], DAY_EPSILON, force):
		TerrainLight.set_light(st.diffuse, st.terrain_ambient, st.terrain_shadow, nk)
	# The water's tint: channel 14 (READ, round 627), x the night's k (OURS).
	var water := NightLight.scaled(st.water, nk)
	if _day_take("water", [water], DAY_EPSILON, force):
		_env_water_color = water
		_set_water_color(water)
		if force:
			print("World3D: environment %d water colour (channel 14) %s" % [_env_record_id, str(st.water)])
	# The fog: sqrt of channel 9, the planes channels 10 and 11 (WorldFog,
	# round 702).
	var fog_color := EnvironmentReader.render_fog_color(st.fog)
	if OS.get_environment("OPENSRO_QA_FOG_RAW") != "":
		# QA only: the pre-review colour, for a before/after on one build.
		fog_color = st.fog
	# OURS (round 786): the night's k^0.75, so the distance does not glow
	# over a darkened ground.
	fog_color = NightLight.scaled(fog_color, ns)
	if _day_take("fog", [fog_color, st.fog_near, st.fog_far], DAY_EPSILON, force):
		_fog_channel_near = st.fog_near
		_fog_channel_far = st.fog_far
		_fog_display_color = fog_color
		_fog_ready = true
		var env := world_environment.environment
		if force:
			# Godot's own fog draws nothing (density 0, no sun scatter, no
			# aerial perspective -- all three were OURS). It stays enabled
			# because the Compatibility renderer applies a shader's own FOG
			# only while the environment's fog is on (gles3 scene.glsl
			# 1580-1588); WorldFog.SHADER_FN is that FOG for the transparent
			# shaders drawn after the pass. The sky is not fogged (round 693).
			env.fog_enabled = true
			env.fog_density = 0.0
			env.fog_sun_scatter = 0.0
			env.fog_aerial_perspective = 0.0
			env.fog_height_density = 0.0
			env.fog_sky_affect = 0.0
		env.fog_light_color = fog_color
		_apply_fog()
		if force:
			print("World3D: environment fog (READ): channels 10/11 = %.3f / %.3f -> linear in view depth from %.0f to %.0f (view distance %.0f), colour %s; drawn %s" % [
				_fog_channel_near, _fog_channel_far, _fog_near_real, _fog_far_real,
				VideoOptions.view_distance(video_options().value(VideoOptions.SCENERY)), str(fog_color),
				"yes" if _fog_pass != null and _fog_pass.visible else "no"])
	# The cloud layer's texture factor: channel 4, alpha (channel 12 + 1) / 2
	# (READ, round 628 review); its fog the world's fog colour.
	var cloud_moved := false
	var cloud := NightLight.scaled(st.cloud, ns)
	if _sky_dome_material != null and _day_take("cloud", [cloud, st.cloud_alpha, fog_color], DAY_EPSILON, force):
		_sky_dome_material.set_shader_parameter("cloud_color", Vector3(cloud.r, cloud.g, cloud.b))
		_sky_dome_material.set_shader_parameter("cloud_alpha", st.cloud_alpha)
		_sky_dome_material.set_shader_parameter("fog_color", Vector3(fog_color.r, fog_color.g, fog_color.b))
		cloud_moved = true
		if force:
			print("World3D: cloud layer colour (channel 4) %s, alpha (channel 12) %.3f" % [str(st.cloud), st.cloud_alpha])
	# The cloud layer's Compatibility-style blend under Forward+ (round 693's
	# review; GammaSkyMaterial.feed_clouds), fed after the sky and the light.
	if _sky_material != null and (sky_moved or cloud_moved or force):
		_sky_material.feed_clouds(_sky_dome_material, directional_light, world_environment.environment)

## The sun disc, the moon and the flare at `phase` (READ: DayCycle's header,
## LensFlare's): positions, the disc's SunColor, the moon's picture for the
## clock's day, and what is shown -- nothing in a dungeon or a hidden-sky QA
## overview, the flare only with the Lens Flare row on and the sun at least
## 700 of its 20000 above the horizon (0xdd81c4, Map::FUN_00a21280).
func _day_bodies(phase: float, st: DayCycle.State) -> void:
	var field := _dungeon == null and not _qa_bodies_hidden and _env_record != null
	var sun_dir := DayCycle.sun_direction(phase)
	var sun_axis := DayCycle.body_axis(sun_dir)
	var sun_on := field and DayCycle.sun_disc_drawn(phase) and _sun_disc != null
	var sun_color: Color = st.sun if st != null else Color(1, 1, 1)
	if _sun_disc != null:
		_sun_disc.visible = sun_on
		_sun_disc_material.set_shader_parameter("body_dir", sun_dir)
		_sun_disc_material.set_shader_parameter("body_axis", sun_axis)
		_sun_disc_material.set_shader_parameter("body_color", Vector3(sun_color.r, sun_color.g, sun_color.b))
	var day := _clock_day()
	var moon_tex: Texture2D = null
	var moon_on := field and DayCycle.moon_drawn(phase, day)
	if moon_on:
		moon_tex = _moon_texture(day)
		moon_on = moon_tex != null
	var moon_dir := DayCycle.moon_direction(phase)
	var moon_axis := DayCycle.body_axis(moon_dir)
	if _moon_disc != null:
		_moon_disc.visible = moon_on
		_moon_disc_material.set_shader_parameter("body_dir", moon_dir)
		_moon_disc_material.set_shader_parameter("body_axis", moon_axis)
		if moon_tex != null and day != _moon_day_shown:
			_moon_day_shown = day
			_moon_disc_material.set_shader_parameter("body_tex", moon_tex)
	if _sky_dome_material != null:
		_sky_dome_material.set_shader_parameter("body_sun_on", sun_on)
		_sky_dome_material.set_shader_parameter("body_sun_dir", sun_dir)
		_sky_dome_material.set_shader_parameter("body_sun_axis", sun_axis)
		_sky_dome_material.set_shader_parameter("body_sun_color", Vector3(sun_color.r, sun_color.g, sun_color.b))
		_sky_dome_material.set_shader_parameter("body_moon_on", moon_on)
		_sky_dome_material.set_shader_parameter("body_moon_dir", moon_dir)
		_sky_dome_material.set_shader_parameter("body_moon_axis", moon_axis)
		if moon_tex != null:
			_sky_dome_material.set_shader_parameter("body_moon_tex", moon_tex)
	if _lens_flare != null:
		var flare_on := field and video_options().value(VideoOptions.LENS_FLARE) == 1 \
			and sun_dir.y * DayCycle.BODY_DISTANCE >= 700.0
		_lens_flare.set_sun(sun_dir, flare_on)

## Hides the sun, the moon and the flare (a dungeon, a QA overview).
func _hide_sky_bodies() -> void:
	if _sun_disc != null:
		_sun_disc.visible = false
	if _moon_disc != null:
		_moon_disc.visible = false
	if _lens_flare != null:
		_lens_flare.set_sun(Vector3.UP, false)
	if _sky_dome_material != null:
		_sky_dome_material.set_shader_parameter("body_sun_on", false)
		_sky_dome_material.set_shader_parameter("body_moon_on", false)

## OPENSRO_QA_CLOCK (OURS, QA only; GameClock.parse_qa): at each QA shot the
## clock is pinned at the time named like the shot, and the environment
## snaps to it, so one boot can show noon, sunset and night.
func _qa_clock_for_shot(shot_name: String) -> void:
	var clock: GameClock = NetClient.game_clock
	if not clock.qa_pins.has(shot_name):
		return
	var at: Vector2i = clock.qa_pins[shot_name]
	clock.pin(at.x, at.y)
	_day_cycle.snap()
	_day_sample_at = -100000
	_sun_shadow_snap()
	print("QA CLOCK %s: pinned at %02d:%02d -> sky phase %.4f" % [shot_name, at.x, at.y, clock.phase(Time.get_ticks_msec())])

## Opens the real Map.pk2 -- OPENSRO_MAP_PK2_PATH if set, else a real
## "pk2/Map.pk2" next to the running executable (see Pk2Config) -- or
## returns null if neither resolves or the open fails. Map.pk2 is a separate
## archive from Data.pk2 in a real retail install (confirmed from the
## user's own real client file listing: Data.pk2, Media.pk2, Map.pk2,
## Particles.pk2 are all separate files) -- so terrain resolves its own real
## pk2 path rather than reusing Data.pk2's.
func _open_map_pk2_if_set() -> Pk2Reader:
	if _map_pk2 != null:
		return _map_pk2
	_map_pk2 = AssetArchives.map()
	return _map_pk2

## Opens the real Media.pk2 -- OPENSRO_MEDIA_PK2_PATH if set, else a real
## "pk2/Media.pk2" next to the running executable (see Pk2Config) -- or
## returns null if neither resolves or the open fails. A real client's
## per-map-region minimap image (see OPENSRO_MAPM_TEXTURE_PATH below) lives
## in Media.pk2, a third separate archive from both Data.pk2 and Map.pk2 in
## a real retail install.
func _open_media_pk2_if_set() -> Pk2Reader:
	if _media_pk2 != null:
		return _media_pk2
	_media_pk2 = AssetArchives.media()
	return _media_pk2

## The player's Particles.pk2, cached (same lazy-open pattern as the others).
## Returns null when no Particles.pk2 is configured -- the level-up effect
## then plays no visual rather than a fabricated one.
func _open_particles_pk2_if_set() -> Pk2Reader:
	if _particles_pk2 != null:
		return _particles_pk2
	_particles_pk2 = AssetArchives.particles()
	return _particles_pk2

## Loads a real per-region minimap image (OPENSRO_MAPM_TEXTURE_PATH, e.g.
## "minimap\100x100.ddj") as the terrain's real ground texture, if set.
## Accepts either a loose file path or a path inside OPENSRO_MEDIA_PK2_PATH
## (see AssetSource) -- a real client's minimap images live in Media.pk2,
## confirmed via this project's own real-file search tooling
## (server/cmd/pk2list) against a real client install.
##
## This is an honest substitution, not a claim that this is the literal
## real-time 3D ground texture: no real-time multi-layer terrain-texture
## system (nor a lookup from a per-tile byte to a specific real texture
## file) has been found anywhere in this project's available real data --
## see docs/protocol/MAPM_FORMAT.md for that search. A region's own real
## minimap art is genuine, region-specific real game data (grass/dirt/rock
## color baked from that exact region), and looks far closer to the real
## game than the flat/procedural fallback color this function returns null
## for -- but it's a real top-down painted image, not sampled per-tile 3D
## terrain texture data.
## path_override lets a zone reload (see _reload_zone_assets) pass a
## specific real path instead of reading OPENSRO_MAPM_TEXTURE_PATH -- empty
## string (the default) means "use the env var", same as every call site
## before zone reloading existed.
func _load_real_terrain_texture(path_override: String = "") -> Texture2D:
	var tex_path := path_override if path_override != "" else OS.get_environment("OPENSRO_MAPM_TEXTURE_PATH")
	if tex_path == "":
		return null

	var archive := _open_media_pk2_if_set()
	var bytes := AssetSource.read_bytes(tex_path, archive)
	if bytes.is_empty():
		printerr("World3D: could not find terrain texture at ", tex_path)
		return null

	var parsed := DdjReader.parse(bytes)
	if parsed == null:
		printerr("World3D: could not parse terrain texture at ", tex_path)
		return null

	return DdjReader.to_texture(parsed)

## Loads a region's real .t file (the same base path as mapm_path, with
## its extension swapped) as a real ambient-occlusion-style lightmap --
## see docs/protocol/MAPT_FORMAT.md for the real structure and how this
## project confirmed it (public documentation, verified byte-for-byte
## against a real sample, cross-decoded two independent ways). The real
## embedded texture is a genuine grayscale shadow map (white = fully lit,
## gray = shadowed) -- a natural fit for Godot's built-in AO darkening,
## unlike an earlier same-day attempt to show a *different*, wrongly-
## decoded payload as literal detail-albedo color (reverted after live
## testing looked wrong -- see MAPT_FORMAT.md's own account). Not every
## region has a `.t` file (only newer-generation "Shape B" regions do --
## see MAPM_FORMAT.md's Shape A/B split), so a missing file here is the
## normal, expected case, not an error.
##
## Static and texture-free since round 565: it runs in the terrain prepare,
## on a WorkerThreadPool task for a streamed cell, so it returns the parsed
## file with the lightmap as an Image (`image`; MapTReader.parse's
## with_texture false) and the commit uploads it. The same real `.t` also
## carries the real per-tile ShadowMap, the self-shadow term of the real
## terrain equation, which goes into the job beside it for the mesh builder
## (which does not apply it -- MapmTerrainBuilder._shadow_at says why). Until
## round 565 that map was stashed in a member, so a region with no `.t`
## handed the builder the previous region's -- harmless only because it is
## not applied. Null with no file or no parse.
static func _read_terrain_lightmap(mapm_path: String, archive: Pk2Reader) -> MapTReader.ParsedRegion:
	if mapm_path == "" or not mapm_path.ends_with(".m"):
		return null
	var mapt_path := mapm_path.substr(0, mapm_path.length() - 1) + "t"
	var bytes := AssetSource.read_bytes(mapt_path, archive)
	if bytes.is_empty():
		return null
	return MapTReader.parse(bytes, false)

## The real Jangan region. **Corrected again 2026-09-01** (see
## docs/WORLD_ISSUES.md's thirty-ninth round): "89/182" (found 2026-08-26 by
## raw keyword density alone -- 279 real "jangan"-named placements, the
## single densest region in all 4,050) turned out to be a real, confirmed
## *isolated* pocket -- a direct listing of the real Map.pk2 archive shows
## every region touching it in any direction is void (no `.m` file at all),
## with the nearest other real terrain 2+ REGION_SPAN away. Walking into
## that gap dropped the player through an unbounded void (see this file's
## WORLD_FLOOR_Y fix, same round). "98/168" -- the *original*
## 2026-08-24 discovery, set aside at the time for having "only" 32 matches
## against 89/182's 279 -- sits inside a real, single, fully contiguous
## landmass of 500+ populated regions (y=145-175 x=85-108 all real terrain,
## confirmed via the same archive listing) that already includes the
## already-verified real Dunhuang region ("98/157", 11 rows away, no gaps
## between them -- dated: textzonename.txt names 98/157 "Donwhang Ferry",
## and Donwhang itself is 102/153 since round 569, DUNHUANG_ZONE_REGION;
## noted here in round 574) plus real "greenfield" (open fields/lake gardens),
## "jangan04" (military camp), "jangan05" (temple), and "jangan02/03"
## (pub/market/palace-substructure) districts -- exactly the open,
## walkable, populated-but-not-just-palace world this project was missing.
## A fuller keyword rescan (2026-09-01, server/cmd's ad hoc topregions_scratch,
## deleted after use) found 98/168 actually has 277 real "jangan" matches
## (almost tied with 89/182's 279) and *more* real palace-lion-statue
## matches (`cj3`, 50 vs 47) -- the original 32-match figure undercounted it,
## most likely from scanning too small a subset of the real archive at the
## time. Real-rendered and verified (779/779 real map objects resolved,
## real stone walls/willow trees/festival banners, no load errors).
## **Corrected 2026-09-07**, in a real playtest. 98/168 is real Jangan
## architecture, but it is specifically the *palace*: every building placed
## in it is a `cj_pal_*` model from `Res\Bldg\China\Jangan03\` -- the big
## door, the main and guard buildings, the lion statues, the stairs -- and
## it contains no shop at all. Spawning there meant a player walked around
## a walled palace compound looking for the town they remembered.
##
## The town is one region west, 97/168: scanning every real region's
## placements for the town's own shop and gate models (server/cmd's
## findregionassets) puts `cj_acce.bsr` (accessory shop) and
## `cj_jang_gate_dragon.bsr` in exactly one region, and that region is
## 97/168. Its centre is the real town square with the dragon statue, at
## local (1002, 1020) -- see ZONE_SPAWN_LOCAL. (This comment said 917 until
## 2026-09-15; the constant has always been 1020, and the stale figure would
## put anything derived from it 103 units out.)
const JANGAN_ZONE_REGION := "97/168"

## Where a named zone's own real landing spot is, in that region's local
## coordinates, keyed by the resolved region string.
##
## The server has no map data whatsoever -- every character enters the
## world at a single fixed spawnPos of (0, 0, 0) (see
## server/internal/session/world.go), which is the geometric centre of
## whatever region the zone resolves to, and is a recognisable place only
## by accident. Jangan's real entrance is its town square, so that is
## where a real login lands.
## The square's own centre is the dragon statue's plinth, so the landing
## spot sits a little north of it -- the scene's camera looks along -Z, so
