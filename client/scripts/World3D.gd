## OPENSRO_QA_WALK_TO="<tick>:<x>,<z>[;<tick>:rel:<dx>,<dz>;<tick>:deck:<dx>,<dz>;<tick>:run:<deg>;<tick>:sit;<tick>:attack...]"
## (round 749): at each tick, a ground click on world (x, z) -- the walk a
## click issues (_issue_walk: the click filter, the order, its 0x7021), at
## the ground's height there -- a sky click's heading run toward <deg> (0 is
## +z, 90 is +x: the QA walk's convention), the N key's sit toggle, or one
## attack on the nearest monster. The two-client checks drive A this way, so
## B draws A from 0xB021. QA only; never set in real play.
var _qa_walk_to_spec := OS.get_environment("OPENSRO_QA_WALK_TO")

func _qa_walk_to_step() -> void:
	for part in _qa_walk_to_spec.split(";", false):
		var bits := part.split(":", false)
		if bits.size() < 2 or not bits[0].is_valid_int() or int(bits[0]) != _qa_tick:
			continue
		if bits[1] == "run" and bits.size() >= 3:
			var ang := deg_to_rad(float(bits[2]))
			print("QA WALK_TO %d: %s" % [_qa_tick, _start_heading_run(Vector3(sin(ang), 0.0, cos(ang)))])
			continue
		# "sit": the N key's toggle (_request_sit_toggle); "attack": one
		# attack on the nearest monster, walking into reach as a click does
		# (_qa_attack_nearest).
		if bits[1] == "sit":
			print("QA WALK_TO %d: sit -- %s" % [_qa_tick, _request_sit_toggle()])
			continue
		if bits[1] == "attack":
			print("QA WALK_TO %d: attack the nearest monster from (%.1f, %.1f)" % [_qa_tick, player.position.x, player.position.z])
			_qa_attack_nearest()
			continue
		# "rel:<dx>,<dz>" (round 749's verification): a click that far from
		# where the player stands, for a walk after an arrival whose point the
		# run does not know beforehand.
		var rel := (bits[1] == "rel" or bits[1] == "deck") and bits.size() >= 3
		var xz := (bits[2] if rel else bits[1]).split(",", false)
		if xz.size() != 2:
			continue
		print("QA WALK_TO %d: %s" % [_qa_tick, _qa_click(float(xz[0]), float(xz[1]), rel, bits[1] == "deck")])

## The QA walk's ground click (OPENSRO_QA_WALK_TO; round 762: QaCrowdProbe's
## `walk=` / `deck=` steps): a click on world (x, z), or that far from where
## the player stands when `rel`, at the ground's height there -- or, with
## `deck` (round 759), on the highest walkable surface there (an object's
## floor, as a click on Jangan's plaza deck lands). Returns what it did.
func _qa_click(x: float, z: float, rel: bool, deck: bool) -> String:
	var at := Vector3(x, player.position.y, z)
	if rel:
		at += Vector3(player.position.x, 0.0, player.position.z)
	at.y = _terrain_height_at(at)
	if deck:
		var pair := _nav_graph_for(at)
		if not pair.is_empty():
			var grp: Node3D = pair[1]
			var lp := grp.to_local(at)
			at.y = grp.to_global(Vector3(lp.x, (pair[0] as NavGraph).landing_height_at(lp.x, lp.z), lp.z)).y
	return "click at (%.1f, %.1f, %.1f) from (%.1f, %.1f): %s" % [at.x, at.y, at.z, player.position.x, player.position.z, _issue_walk(at)]

