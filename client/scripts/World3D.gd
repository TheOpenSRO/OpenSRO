	apply_video_options(video_options())
	var _t_region := Time.get_ticks_msec()
	_load_timings.begin_drain()
	# The "NOW LOADING" screen goes up here, before the centre cell (round
	# 562). Until then _drain_initial_load created it after the synchronous
	# centre-cell build below, so for the whole of it the window kept
	# whatever it had drawn last, with no screen in existence -- round 561's
	# baseline entry log: `cell 97/168 built in 5373 ms at frame 13` with no
	# LoadingScreen line before it; round 562's runs put the screen at frame
	# 13 and the centre cell at 14. The teleport path (_on_change_zone_result)
	# already had this order.
	# The clock above stays ahead of the screen, so the `region grid loaded`
	# total still covers the screen's build and the frame that draws it, as
	# it did when the drain built the screen; that frame is handed on so the
	# line's awaited-frame count still includes it.
	var screen_frames: int = await _show_loading_screen()
	# A drop during that frame changed scene under this instance (round
	# 560's guard in the drain): nothing left to build for.
	if not is_inside_tree():
		return
	_load_initial_region_neighborhood()
	_try_initialize_pk2_ui()
	_try_load_cursors()
	# The HUD was just added to ui_control AFTER the screen, and CanvasItem
	# draw order is child order: back over it before the drain shows it.
	if _loading_screen != null:
		_loading_screen.cover_siblings()
	await _drain_initial_load(_t_region, screen_frames)

## Where the minimap sits: flush with the screen's top-right corner, as the
## client puts it. 0x79f030 (the interface's HUD placement, called from
## 0x78cf13) fetches GDR_MINIMAP (id 10) and calls its SetPos (vslot 0x98)
## with (screen width - 0x81, 0) (0x79f059..0x79f095). The window is 140x184
## (ginterface.txt, and mm_window.ddj's own size) but its art is opaque only
## over columns 0..128 and rows 0..171 (measured, round 630), so at
## x = width - 129 the art's right edge is the screen's and its top the
## screen's; the 11 transparent columns hang off the right edge. It used to
## sit 14 in and 10 down at 136x175, our own placement, with the world
## showing above and right of it. The scene's Hide UI button stays clear of
## it (hud_click_routing_test.gd). Static so the suite can place a minimap
## exactly where the world does (round 531).
const MINIMAP_RIGHT_INSET := 0x81
static func place_minimap(minimap: Control) -> void:
	minimap.anchors_preset = Control.PRESET_TOP_RIGHT
	minimap.anchor_left = 1.0
	minimap.anchor_right = 1.0
	minimap.anchor_top = 0.0
	minimap.anchor_bottom = 0.0
	minimap.grow_horizontal = Control.GROW_DIRECTION_BEGIN
	minimap.grow_vertical = Control.GROW_DIRECTION_END
	minimap.offset_left = -float(MINIMAP_RIGHT_INSET)
	minimap.offset_right = -float(MINIMAP_RIGHT_INSET) + HudMinimap.FRAME_SIZE.x
	minimap.offset_top = 0.0
	minimap.offset_bottom = HudMinimap.FRAME_SIZE.y

## Initializes authentic Silkroad UI components (minimap, underbar) from Media.pk2 if available.
func _try_initialize_pk2_ui() -> void:
	_media_pk2 = _open_media_pk2_if_set()
	if _media_pk2 == null:
		print("World3D: Media.pk2 not found (path='%s') -- authentic UI skipped" % Pk2Config.media_path())
		return
	_preload_skill_effect_table()
	_preload_name_key_index()

	# Load UI localization strings from Media.pk2
	var text_entry := ObjectLoader.find_file(_media_pk2, "server_dep\\silkroad\\textdata\\textuisystem.txt")
	if text_entry != null:
		var text_bytes := _media_pk2.read_file(text_entry)
		_ui_text_table = UiTextTable.parse(text_bytes)

	_ui_builder = UiBuilder.new(_media_pk2, _ui_text_table)
	# Every text node of the in-game UI in the client's own face, at its
	# 12 px, drawn unfiltered -- including the ones made in code with no
	# font of their own (UiBuilder.apply_ui_theme, round 672).
	_ui_builder.apply_ui_theme(ui_control)

	# Setup authentic Minimap
	_hud_minimap = HudMinimap.new(_ui_builder, _media_pk2, _ui_text_table)
	_hud_minimap.name = "HudMinimap"
	# add_child builds it: HudMinimap._ready runs setup(), which builds once.
	# A second setup() here used to build a second map stacked on the first.
	ui_control.add_child(_hud_minimap)
	place_minimap(_hud_minimap)

	# The world map (CNIFWorldMap, res_ui\worldmapguide.2dt), opened by M and
	# by the minimap's own map button -- both reach the client's 0x79abe0. It
	# is built once and kept hidden, as the client loads it at game start and
	# hides it at once (0x777a70, called from CGInterface::Create at 0x78cf64
	# once there is a player object): the window and the map table
	# are read at build time, the 363 tiles only as they come into view.
	_hud_worldmap = HudWorldmap.new(_ui_builder)
	_hud_worldmap.name = "HudWorldmap"
	ui_control.add_child(_hud_worldmap)
	if _hud_worldmap.build_worldmap():
		_hud_worldmap.centre()
		_hud_worldmap.hide()
		_hud_minimap.world_map_requested.connect(_hud_worldmap.toggle)
	else:
		# No res_ui\worldmapguide.2dt or no map table -- this archive cannot
		# show one.
		_hud_worldmap.queue_free()
		_hud_worldmap = null

	# Setup authentic Underbar (bottom bar): CNIFUnderMenuBar, built from
	# res_ui\nifundermenubar.2dt (HudUnderbar has the reading).
	_hud_underbar = HudUnderbar.new(_ui_builder, _media_pk2, _ui_text_table)
	_hud_underbar.name = "HudUnderbar"
	ui_control.add_child(_hud_underbar)
	# Centred and flush to the bottom, as the client puts it: 0x786f30 calls
	# the bar's SetPos((screen_w - 800) / 2, screen_h - 0x44) right after
	# loading it (0x7871dc..0x787210). The size is the file's root rect,
	# 800x68.
	var bar_size := _hud_underbar.size
	_hud_underbar.anchor_left = 0.5
	_hud_underbar.anchor_right = 0.5
	_hud_underbar.anchor_top = 1.0
	_hud_underbar.anchor_bottom = 1.0
	_hud_underbar.grow_horizontal = Control.GROW_DIRECTION_BOTH
	_hud_underbar.grow_vertical = Control.GROW_DIRECTION_BEGIN
	_hud_underbar.offset_left = -bar_size.x / 2.0
	_hud_underbar.offset_right = bar_size.x / 2.0
	_hud_underbar.offset_top = -bar_size.y
	_hud_underbar.offset_bottom = 0.0
	# Built by add_child above (HudUnderbar._ready runs setup(), which builds
	# once); a second setup() here used to stack a second bar on the first.
	_hud_underbar.quickslot_activated.connect(_on_quickslot_activated)

	# The always-on block at the top left: portrait, name, level, HP and MP.
	# Its own registry entry places it at 4,7 in the client's default
	# layout, which is a plain top-left inset and translates directly.
	_hud_player_info = HudPlayerInfo.new(_ui_builder)
	_hud_player_info.name = "HudPlayerInfo"
	ui_control.add_child(_hud_player_info)
	_hud_player_info.position = Vector2(4, 7)
	_hud_player_info.setup()
	_hud_player_info.self_pressed.connect(_select_self)
	# Round 629: the ready circle runs the berserk key's own path, the "+"
	# opens the character window, and opening the stat panel asks for fresh
	# numbers (CIFPlayerMiniInfo's message map; see hud_player_info.gd).
	_hud_player_info.berserk_pressed.connect(func() -> void:
		print("World3D: berserk circle pressed -- %s" % _run_key_action("berserk", 0)))
	_hud_player_info.stat_up_pressed.connect(func() -> void:
		if _hud_panels != null and not _hud_panels.is_open("character"):
			_hud_panels.open("character")
		print("World3D: stat-up pressed -- character window open"))
	_hud_player_info.stat_panel_toggled.connect(func(open: bool) -> void:
		print("World3D: player stat panel %s" % ("open" if open else "closed"))
		if open:
			_request_world_stats())
	_apply_player_race()
	if _portrait_zone_light.size() == 2:
		_hud_player_info.set_portrait_zone_light(_portrait_zone_light[0], _portrait_zone_light[1])
		print("World3D: portrait zone light at block creation: diffuse channel %s ambient channel %s" % _portrait_zone_light)
	# Round 635: a body dressed before the block existed gets its portrait now
	# (retail's block is created dirty: +0x38c = 1 in its constructor).
	if _player_skeleton != null and is_instance_valid(_player_skeleton):
		_refresh_player_portrait(_player_skeleton, _player_equipped_last, _player_body)
	_hud_player_info.set_character(NetClient.current_character_name, 1)

	# The active-buff icons right of the player block (round 618): retail's
	# CIFMagicStateBoard, placed by its own GDR_MAGICSTATEBOARD rect.
	_build_buff_board()

	# Real vitals. The server reports them twice: once on entering the world
	# (EnterWorldResult carries HP and MaxHP) and again on every attack
	# (AttackResult's player_hp), so the bar is right on login and stays
	# right through combat.
	_seed_vitals_from_last_enter_world()
	if _last_enter_world_max_hp > 0:
		_hud_player_info.set_hp(_last_enter_world_hp, _last_enter_world_max_hp)
	NetClient.enter_world_result.connect(func(result) -> void:
		if result != null and result.ok:
			# A character enters standing, and may be another character
			# than the last one this client played (round 607).
			_sit.own_id = -1
			_sit.reset()
			# And whose buffs are whose (round 617): OpSelfId for this entry,
			# when it has come, is taken again by _sync_own_id.
			_self_cast.forget_owner()
			_sync_own_id()
			# The buff bar starts empty for this entry (round 618's review):
			# its icons were the last entry's, or another character's.
			if _hud_buff_board != null:
				_hud_buff_board.clear()
			# And every other owner's (round 638): the zone re-sends them.
			_target_buff_book.clear()
			_abnormal_states.clear()
			# And no target carries over (round 638 review): whatever was
			# selected belonged to the entry that ended.
			_last_attack_target = -1
			_selected_character = -1
			_clear_target()
		if result != null and result.ok and result.max_hp > 0:
			_last_enter_world_hp = result.hp
			_last_enter_world_max_hp = result.max_hp
			if _hud_player_info != null:
				_hud_player_info.set_hp(result.hp, result.max_hp)
			if _hud_panels != null:
				_hud_panels.set_character_vitals(result.hp, result.max_hp, 1)
			# Pull the full stats so the level, EXP gauge and SP are live from
			# the moment the world loads, not just HP.
			_request_world_stats()
			# Ask the server whether this account is a GM (an empty command
			# line is the probe); the reply enables the GM tooltip/section and
			# greets a GM once.
			_fire_gm_probe()
			_hint_help_once())
	NetClient.attack_result.connect(func(result) -> void:
		# A REFUSAL CARRIES NO HEALTH. "too far away", "skill on cooldown",
		# "target not found" and a dozen others are AttackResults with only an
		# error string set, so player_hp is the int32 zero value -- and painting
		# the bar from it said the player was dead. That is the real shape of
		# "when i click a mangyang ... my health shoots all the way down to 0"
		# (playtest 2026-09-20): the refusal, not the blow, emptied the bar.
		#
		# Only a result that actually reports health may move the bar. Death is
		# unaffected: a real death is a successful result whose player_hp is 0
		# and whose monster/attack fields are filled in.
		if result != null and result.error != "" and result.error != SelfCast.SILENT_END_TEXT:
			# Say why. A refused swing or cast used to do nothing visible at
			# all, so "no distance checking" and "nothing happened" looked the
			# same from the outside. (A cast retail ends without a text --
			# SelfCast.SILENT_END_TEXT, round 636's review -- stays silent.)
			_log_system(result.error)
			if OS.get_environment("SRREVAMP_QA_HOTKEY") != "":
				print("QA ATTACK RESULT: refused (%s)" % result.error)
		if result != null and result.error == "":
			_audio_set_hwan(result.berserk_active)
			# Round 639: what the kill earned, in the system window, as
			# retail's EXP handler writes it (exp_gain_lines).
			if result.exp_gained > 0 or result.skill_exp_gained > 0:
				var exp_t := _ui_text_table.get_text("UIIT_MSG_STATE_GAIN_EXP", "") if _ui_text_table != null else ""
				var sexp_t := _ui_text_table.get_text("UIIT_MSG_STATE_GET_SKILL_EXP", "") if _ui_text_table != null else ""
				for line in exp_gain_lines(result.exp_gained, result.skill_exp_gained, exp_t, sexp_t):
					_log_system(line, HudSystemMessage.TYPE_GAIN)
		if result != null and result.error == "" and _last_enter_world_max_hp > 0:
			if _hud_player_info != null:
				_hud_player_info.set_hp(result.player_hp, _last_enter_world_max_hp)
				# The count only (round 629's review): an AttackResult is not a
				# start, and a running display ends on its own timers.
				_hud_player_info.set_berserk(result.berserk_gauge, false)
				if OS.get_environment("SRREVAMP_QA_HOTKEY") != "":
					# The orbs as drawn: an unlit orb is hidden (round 629).
					var lit := 0
					var orbs: Array = _hud_player_info.get("_berserk_orbs")
					for orb in orbs:
						if orb is CanvasItem and (orb as CanvasItem).visible:
							lit += 1
					print("QA BERSERK: gauge %d active %s, %d of %d orbs lit (monster %d, damage %d)" % [
						result.berserk_gauge, str(result.berserk_active), lit, orbs.size(), result.monster_id, result.monster_damage])
			if _hud_panels != null:
				_hud_panels.set_character_vitals(result.player_hp, _last_enter_world_max_hp, 1)
			# A kill changes exp (and maybe level/HP-max), so refresh the gauges.
			if result.monster_died:
				_request_world_stats()
			# QA: auto-activate berserk once the gauge fills, so a render shows
			# the orbs light and the berserk glow. Never fires in real play.
			# SRREVAMP_QA_BERSERK=tab presses Tab instead, through the viewport
			# (push_input), so the run measures the key (round 608).
			if OS.get_environment("SRREVAMP_QA_BERSERK") != "" and result.berserk_gauge >= 100 and not result.berserk_active \
					and NetClient.current_character_name != "":
				if OS.get_environment("SRREVAMP_QA_BERSERK") == "tab":
					if not _qa_berserk_tab_sent:
						_qa_berserk_tab_sent = true
						print("QA BERSERK: gauge %d -- pressing Tab" % result.berserk_gauge)
						_qa_push_key("Tab")
				else:
					NetClient.berserk(NetClient.current_character_name))
	# Berserk: the orbs fill on attack (above); an activation result updates
	# them and, when it started a berserk, announces it.
	NetClient.berserk_result.connect(func(activated: bool, gauge: int, active: bool) -> void:
		print("World3D: berserk result: activated %s, gauge %d, active %s" % [str(activated), gauge, str(active)])
		if _hud_player_info != null:
			# The activation reply starts the display; a refusal passes the
			# count, which FUN_00778ae0 leaves alone when it is 0.
			_hud_player_info.set_berserk(gauge, activated)
		_audio_set_hwan(active)
		if activated:
			_log_system("Berserk!")
		elif not active:
			_log_system("The berserk gauge is not full yet."))
	# The level, EXP gauge, HP-bar maximum and SP all come from the stats
	# packet -- kept live here (enter-world, each kill, and level-up).
	NetClient.character_stats_result.connect(_on_world_stats)
	# Using a potion returns the new HP/MP directly, so the bars redraw
	# without a follow-up stats round trip, and the bag count is refreshed.
	NetClient.use_item_result.connect(_on_use_item_result)
	# QA: once a kill has dropped a potion into the bag, drink it, so a render
	# can show a consumable actually working. Never fires in real play.
	if OS.get_environment("SRREVAMP_QA_USEITEM") != "":
		NetClient.inventory_list_result.connect(_qa_use_first_potion)
	# Until the first stats packet lands the bar is drawn full with no
	# readout rather than a made-up number -- see set_mp_unknown. The stats
	# packet now carries real mana (the game's own base curve), so
	# _on_world_stats replaces this with a live value.
	_hud_player_info.set_mp_unknown()
	# This scene usually loads *after* enter_world_result has already fired,
	# so the handler above never runs for it -- the scene reads the cached
	# result instead (see last_enter_world_result). Nothing then asked for
	# stats until the first kill, which left the level label, EXP gauge, SP
	# and mana empty on arrival. Ask now, with the handler connected.
	if NetClient.last_enter_world_result != null and NetClient.last_enter_world_result.ok:
		_request_world_stats()

	# Every floating game window, created on demand.
	_hud_panels = HudPanels.new(_ui_builder)
	_hud_panels.name = "HudPanels"
	ui_control.add_child(_hud_panels)
	_hud_panels.connect_net()
	# A body dressed before the panels existed gets its paper doll now, as
	# the portrait does above (round 695: a QA run's loadout dresses before
	# the HUD is built, and _refresh_paper_doll returns without panels).
	if _player_skeleton != null and is_instance_valid(_player_skeleton) and _paper_doll == null:
		_refresh_paper_doll(_player_equipped_last, _player_body)
	# QA: rearrange the bag once (SRREVAMP_QA_MOVE="from,to") so a render's
##   SRREVAMP_QA_STORAGE_ITEM=1 (needs --server) unequip the boots into the bag, open the
##                          warehouse, the quantity dialog, and deposit 1 of the
##                          first bag item -- the flow that crashed a playtest
	# log shows a drag landing server-side -- see HudPanels.qa_move_sequence.
	if OS.get_environment("SRREVAMP_QA_MOVE") != "" and NetClient.is_connected_to_server():
		_hud_panels.qa_move_sequence(OS.get_environment("SRREVAMP_QA_MOVE"))
	# The Escape / System menu (see HudPanels): Restart returns to the login
	# screen, Exit quits, and Help opens the help window. The Option button
	# is the retail one -- id 10 -> 0x6f5190,
	# which toggles CNIFOption from res_ui\optionwnd.2dt and hides the System
	# window, silently (HudPanels.toggle_option). The debug panel stays on
	# Shift+F3.
	_hud_panels.system_option_requested.connect(func():
		_hud_panels.toggle_option())
	# The Option window's Video tab (round 694): Apply / Confirm.
	_hud_panels.video_options_applied.connect(_on_video_options_applied)
	# Restart is one scene change: NetClient.disconnect_from_server() emits
	# `disconnected` unconditionally, and _on_disconnected is what takes this
	# instance to Login -- for a dropped peer, for the Log Out button
	# (_on_disconnect_pressed) and for this. Until round 560 this lambda
	# queued Login a second time itself, from a node _on_disconnected had
	# already detached, where get_tree() is null. That state -- detached and
	# not yet freed, `data.tree` null -- is what round 558's runs C and D
	# logged on the mid-load drain path; this lambda's own call was not
	# logged, the same detach is read as applying. Round 564 reworded this: the
	# earlier parenthetical, that the engine "replaces a pending scene" and
	# the first instance was already freed, was an unmeasured claim.
	_hud_panels.system_restart_requested.connect(func(): NetClient.disconnect_from_server())
	_hud_panels.system_exit_requested.connect(func(): get_tree().quit())
