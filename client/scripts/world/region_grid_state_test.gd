extends SceneTree

## Exercises RegionGridState -- the per-region bookkeeping World3D keeps
## while a grid is loaded, and what a streaming unload must forget -- run
## headless:
## `godot4 --headless --path client --script res://scripts/world/region_grid_state_test.gd`
##
## The fixtures are bare objects (a NavGraph, an NvmReader.ParsedRegion with
## two MapObjects, a MapmReader.ParsedRegion, a Node3D group per region);
## never game data. What is held to account is the forgetting: unload(97,
## 167) drops that region's cell, NPC mark, nav graph, navmesh, heightmap
## and the object collision meshes only it referenced, and leaves 97/168's
## entries alone; a region marked again after an unload counts as populated
## again; clear_all() empties everything.
##
## NEGATIVE: the class is reached through load() by path and has_method
## guards (level_data_reader_test.gd's pattern), so on the tree before round
## 563 -- no region_grid_state.gd, World3D erasing only `_loaded_cells` in
## its unload loop while `_npc_regions_done` was cleared by `_clear_region_grid`
## alone and `_navmesh_cache` / `_parsed_region_heightmaps` /
## `_object_collision_cache` never -- this suite FAILS its first check
## rather than failing to parse. Proven on that tree for round 563's record.
##
## THE COORDINATE FRAME (round 570; RegionGridState's comment of that name).
## RegionGridState.frame_world, the client's port of
## server/internal/worldmap.ToWorld, and the terrain placement itself
## (World3D._group_position of World3D._cell_offset from the frame, with the
## group's scale.z = -1) reproduce FRAME_ROWS: worldmap.go's MEASURED table in
## the frame of 97/168, and the same points in the frame of 98/157. The rows
## were generated by ToWorld, not typed from prose, and worldmap_test.go's
## TestFrameTableTheClientReproduces holds the Go side to the same rows. The
## axes checked: region y -> world X, region x -> world Z, Z mirrored
## (AGENTS.md). Moving a point from the 97/168 frame into 98/157's shifts it
## by (+21120, +1920) -- derived below from frame_world, never a literal.
## The streaming cell test (RegionGridState.cell_at) finds each row's region
## from its world point, and World3D._frame_coords takes the server's
## FrameRegion -- equal to the zone's own centre for all six labels, so the
## grid every zone builds is the one it built before.
## NEGATIVE: before round 570 RegionGridState has no frame_world and World3D
## no _group_position / _frame_coords; the has_method guards FAIL (reached
## through load() and call(), so they do not fail to parse). A helper with the
## region axes the intuitive way round (region x -> world X) misses the
## measured 98/168 row, which is why that row is here.
## ONE PLACEMENT (round 572). _terrain_commit places a region's group with
## TerrainCollision.place_group -- the heightfield's grid lines, which
## TerrainCollision.vertical_ray steps off, follow from it -- while the frame
## rows above and the frame's corner (_frame_corner, _grid_origin_world) read
## World3D._group_position. The suite holds the node place_group positions to
## Transform3D(Basis(1, 1, -1), _group_position) for every FRAME_ROWS cell, for
## Constantinople's centre and the far corner of its radius-2 grid in 97/168's
## frame (the server's -single-frame, round 571: world x to -175,680), and for
## several anchors, so the corner the streaming test measures from and the
## heightfield's grid lines cannot drift apart. NEGATIVE: before round 572
## TerrainCollision has no place_group, and the method-list guard FAILS.
## World3D.gd needs the NetClient autoload registered before it compiles,
## which is the case in _initialize and not in _init (zone_centres_test.gd),
## so this suite runs from _initialize since round 570.

## [region_x, region_y, local_x, local_z, frame_x, frame_y, world_x, world_z],
## from server/internal/worldmap.ToWorld (round 570).
const FRAME_ROWS := [
	[97, 168, 1002.0, 1020.0, 97, 168, 42.0, -60.0],
	[97, 169, 960.0, 960.0, 97, 168, 1920.0, 0.0],
	[97, 167, 960.0, 960.0, 97, 168, -1920.0, 0.0],
	[98, 168, 960.0, 960.0, 97, 168, 0.0, -1920.0],
	[96, 168, 960.0, 960.0, 97, 168, 0.0, 1920.0],
	[98, 157, 960.0, 960.0, 97, 168, -21120.0, -1920.0],
	[102, 153, 960.0, 960.0, 97, 168, -28800.0, -9600.0],
	[97, 168, 1002.0, 1020.0, 98, 157, 21162.0, 1860.0],
	[97, 169, 960.0, 960.0, 98, 157, 23040.0, 1920.0],
	[97, 167, 960.0, 960.0, 98, 157, 19200.0, 1920.0],
	[98, 168, 960.0, 960.0, 98, 157, 21120.0, 0.0],
	[96, 168, 960.0, 960.0, 98, 157, 21120.0, 3840.0],
	[98, 157, 960.0, 960.0, 98, 157, 0.0, 0.0],
	[102, 153, 960.0, 960.0, 98, 157, -7680.0, -7680.0],
]

var _failures := 0

func _check(cond: bool, msg: String) -> void:
	if cond:
		print("ok  " + msg)
	else:
		print("FAIL " + msg)
		_failures += 1

func _navmesh(resource_ids: Array) -> NvmReader.ParsedRegion:
	var region := NvmReader.ParsedRegion.new()
	for id in resource_ids:
		var obj := NvmReader.MapObject.new()
		obj.resource_id = id
		region.objects.append(obj)
	return region

func _initialize() -> void:
	var script := load("res://scripts/world/region_grid_state.gd") as GDScript
	var compiled := script != null and script.can_instantiate()
	_check(compiled, "region_grid_state.gd loads and can instantiate (absent before round 563)")
	if not compiled:
		_finish()
		return
	var state: RefCounted = script.new()
	var has_unload := state.has_method("unload")
	_check(has_unload, "RegionGridState has unload")
	if not has_unload:
		_finish()
		return

	_test_unload_forgets_one_region(state)
	_test_reentry_and_clear_all(script.new())
	_test_frame(script.new())
	_finish()

## Region x/y out of a _parse_region_coords-style Dictionary, compared field
## by field.
func _is_region(d: Dictionary, x: int, y: int) -> bool:
	return d.get("x", -1) == x and d.get("y", -1) == y

## The region axes the intuitive way round -- region x to world X, region y to
## world Z, no mirror: what this project assumed before round 46 and what the
## measured rows rule out.
func _intuitive_world(rx: int, ry: int, lx: float, lz: float, fx: int, fy: int) -> Vector2:
	return Vector2(float(rx - fx) * 1920.0 + lx - 960.0, float(ry - fy) * 1920.0 + lz - 960.0)

func _test_frame(state: RefCounted) -> void:
	var helpers := true
	for method in ["frame_world", "cell_world_offset", "cell_at"]:
		var has: bool = state.has_method(method)
		_check(has, "RegionGridState has %s (absent before round 570)" % method)
		helpers = helpers and has
	var S := load("res://scripts/World3D.gd") as GDScript
	var loads := S != null and S.can_instantiate()
	_check(loads, "World3D.gd loads and can instantiate headless")
	if not helpers or not loads:
		return
	var w: Node = S.new()
	for method in ["_group_position", "_cell_offset", "_frame_coords"]:
		var has: bool = w.has_method(method)
		_check(has, "World3D has %s (_group_position and _frame_coords absent before round 570)" % method)
		helpers = helpers and has
	if not helpers:
		w.free()
		return

	# Any vertical anchor: x and z do not depend on it.
	var anchor := 12.5
	var corner: Vector3 = w.call("_group_position", Vector3.ZERO, anchor)
	for row in FRAME_ROWS:
		var rx: int = row[0]
		var ry: int = row[1]
		var fx: int = row[4]
		var fy: int = row[5]
		var want := Vector2(row[6], row[7])
		var label := "%d/%d (%s, %s) in the frame of %d/%d" % [rx, ry, row[2], row[3], fx, fy]
		var got: Vector2 = state.call("frame_world", rx, ry, row[2], row[3], fx, fy)
		_check(got == want, "frame_world: %s -> %s, ToWorld's (got %s)" % [label, want, got])
		# The terrain placement itself: the region's group stands where
		# _terrain_commit puts it -- _group_position of the PRE-mirror
		# _cell_offset from the frame -- and carries scale.z = -1, so a local
		# point maps through Basis(1, 1, -1) at that position.
		var pos: Vector3 = w.call("_group_position", w.call("_cell_offset", rx - fx, ry - fy), anchor)
		var placed := Transform3D(Basis.from_scale(Vector3(1, 1, -1)), pos) * Vector3(row[2], 0.0, row[3])
		_check(Vector2(placed.x, placed.z) == want, "the terrain placement puts %s at %s (got %s)" % [label, want, Vector2(placed.x, placed.z)])
		# The frame region's corner is the group's position less the cell's
		# POST-mirror offset: World3D._frame_corner, what
		# _load_region_neighborhood takes as _grid_origin_world (round 571;
		# grid_origin_test.gd).
		var off: Vector3 = state.call("cell_world_offset", rx - fx, ry - fy)
		_check(pos - off == corner, "%d/%d's group less cell_world_offset(%d, %d) is the frame's corner" % [rx, ry, rx - fx, ry - fy])
		# And the streaming test finds the row's region from its world point.
		var cell: Vector2i = state.call("cell_at", Vector3(want.x, 0.0, want.y) - corner)
		_check(cell == Vector2i(rx - fx, ry - fy), "cell_at puts %s in cell %s (got %s)" % [label, Vector2i(rx - fx, ry - fy), cell])

	# The frame shift, derived: every point moves from the 97/168 frame into
	# 98/157's by minus 98/157's own middle in the 97/168 frame -- (+21120,
	# +1920), both terms positive. The batch plan's "(21120, -1920)" had z's
	# sign wrong.
	var middle: Vector2 = state.call("frame_world", 98, 157, 960.0, 960.0, 97, 168)
	for p in [[97, 168, 1002.0, 1020.0], [97, 169, 960.0, 960.0], [98, 168, 960.0, 960.0], [102, 153, 10.0, 1900.0]]:
		var a: Vector2 = state.call("frame_world", p[0], p[1], p[2], p[3], 97, 168)
		var b: Vector2 = state.call("frame_world", p[0], p[1], p[2], p[3], 98, 157)
		_check(b - a == -middle, "%d/%d moves by %s into 98/157's frame (got %s)" % [p[0], p[1], -middle, b - a])
	_check(-middle.x > 0.0 and -middle.y > 0.0, "the shift into 98/157's frame is positive on both axes (got %s)" % -middle)

	# The row that rules out the intuitive axes.
	_check(_intuitive_world(98, 168, 960.0, 960.0, 97, 168) != Vector2(0.0, -1920.0),
		"region x -> world X misses the measured 98/168 -> (0, -1920) row, so the row discriminates")

	# The server's FrameRegion. Today it is each zone's own centre
	# (worldmap.FrameFor; session_test's TestFrameForNamesEachZonesCentre
	# pins these six rows on the server), so every zone builds in its own
	# frame, the centre at cell (0, 0) -- the grid it built before round 570.
	var server_frames := {
		"jangan": "97/168", "dunhuang": "102/153", "donwhang": "102/153",
		"constantinople": "105/79", "hotan": "92/135", "samarkand": "106/107",
	}
	for zone in server_frames:
		var centre: Dictionary = w.call("_parse_region_coords", w.call("_resolve_zone_region", zone))
		var framed: Dictionary = w.call("_frame_coords", centre, server_frames[zone])
		_check(not centre.is_empty() and _is_region(framed, int(centre["x"]), int(centre["y"])),
			"%s's FrameRegion %s is its own centre %s (got %s)" % [zone, server_frames[zone], centre, framed])
	var donwhang := {"x": 102, "y": 153}
	_check(_is_region(w.call("_frame_coords", donwhang, ""), 102, 153), "no FrameRegion (an older server): the zone's own centre")
	_check(_is_region(w.call("_frame_coords", donwhang, "97/168"), 97, 168), "a FrameRegion other than the centre is the frame the grid is built in")
	_check(_is_region(w.call("_frame_coords", donwhang, "jangan"), 102, 153), "a FrameRegion that is not x/y falls back to the centre")
	_test_one_placement(w)
	w.free()

## ONE PLACEMENT (the header's section of that name, round 572).
func _test_one_placement(w: Node) -> void:
	var tc := load("res://scripts/assets/terrain_collision.gd") as GDScript
	var has := false
	if tc != null:
		for m in tc.get_script_method_list():
			if String(m.get("name", "")) == "place_group":
				has = true
	_check(has, "TerrainCollision has place_group (absent before round 572)")
	if not has:
		return
	# [label, the cell's offset from the frame region, pre-mirror].
	var cells := []
	for row in FRAME_ROWS:
		cells.append(["%d/%d in the frame of %d/%d" % [row[0], row[1], row[4], row[5]],
			w.call("_cell_offset", int(row[0]) - int(row[4]), int(row[1]) - int(row[5]))])
	# Constantinople (105/79) in 97/168's frame, and its radius-2 grid's far
	# corner cell (107/77), whose low-x edge is the grid's farthest x.
	cells.append(["105/79 in the frame of 97/168", w.call("_cell_offset", 105 - 97, 79 - 168)])
	cells.append(["107/77 in the frame of 97/168", w.call("_cell_offset", 107 - 97, 77 - 168)])
	# Anchors: arbitrary inputs, both signs. A NAN anchor reaches neither
	# function: _terrain_commit falls back to the near-row height, and
	# _frame_corner to 0.
	var anchors := [0.0, 12.5, -37.25, 1234.5]
	var farthest := 0.0
	for cell in cells:
		var mismatched := PackedStringArray()
		for anchor in anchors:
			var g := Node3D.new()
			tc.call("place_group", g, cell[1], anchor)
			var pos: Vector3 = w.call("_group_position", cell[1], anchor)
			var want := Transform3D(Basis.from_scale(Vector3(1, 1, -1)), pos)
			if g.position != pos or g.scale != Vector3(1, 1, -1) or g.transform != want:
				mismatched.append("anchor %s: place_group %s scale %s, _group_position %s" % [anchor, g.position, g.scale, pos])
			farthest = maxf(farthest, absf(pos.x))
			g.free()
		_check(mismatched.is_empty(), "%s: place_group's node stands at _group_position with scale.z = -1, at all %d anchors%s" % [
			cell[0], anchors.size(), "" if mismatched.is_empty() else " (" + "; ".join(mismatched) + ")"])
	_check(farthest == 175680.0, "the far corner's group stands at world x -175,680, the -single-frame grid's farthest (got %.1f)" % -farthest)

func _test_unload_forgets_one_region(state: RefCounted) -> void:
	var group_167 := Node3D.new()
	var group_168 := Node3D.new()
	var graph_167 := NavGraph.new()
	var graph_168 := NavGraph.new()
	# 97/167 lists objects 10 and 11; 97/168 lists 11 and 12: 10 is 167's
	# alone, 11 shared, 12 168's alone.
	state.mark_loaded(0, -1, 97, 167)
	state.mark_loaded(0, 0, 97, 168)
	state.mark_npcs_done(97, 167)
	state.mark_npcs_done(97, 168)
	state.add_nav_graph(97, 167, graph_167, group_167)
	state.add_nav_graph(97, 168, graph_168, group_168)
	state.navmesh_cache[state.navmesh_key(97, 167)] = _navmesh([10, 11])
	state.navmesh_cache[state.navmesh_key(97, 168)] = _navmesh([11, 12])
	state.parsed_heightmaps["97_167"] = MapmReader.ParsedRegion.new()
	state.parsed_heightmaps["97_168"] = MapmReader.ParsedRegion.new()
	# Neighbours the ownership test parsed without loading them: 96/166 is
	# 97/167's alone (diagonal), 98/169 is 97/168's alone, 96/167 is next
	# to both.
	state.parsed_heightmaps["96_166"] = MapmReader.ParsedRegion.new()
	state.parsed_heightmaps["98_169"] = null
	state.parsed_heightmaps["96_167"] = MapmReader.ParsedRegion.new()
	state.object_collision_cache[10] = null # tried, none -- cached too
	state.object_collision_cache[11] = BmsReader.CollisionMesh.new()
	state.object_collision_cache[12] = BmsReader.CollisionMesh.new()

	_check(state.navmesh_key(97, 168) == 0x61a8, "navmesh_key is (x << 8) | y (nv_61a8.nvm for 97/168)")
	_check(state.npcs_done(97, 167) and state.npcs_done(97, 168), "both regions count as populated before the unload")
	var before: Array = state.nav_graph_for_region(97, 167)
	_check(before.size() == 2 and before[0] == graph_167 and before[1] == group_167,
		"nav_graph_for_region answers [graph, group] for a loaded region")
	_check(state.nav_graph_pairs().size() == 2, "two pairs before the unload")

	var dropped: PackedStringArray = state.unload(97, 167)
	print("     unload(97,167) dropped: " + ", ".join(dropped))
	_check(not state.npcs_done(97, 167), "npcs_done(97,167) is false after the unload -- the region is repopulated when it streams back in")
	_check(state.npcs_done(97, 168), "... while 97/168 still counts as populated")
	_check(state.nav_graph_for_region(97, 167).is_empty(), "nav_graph_for_region(97,167) is empty after the unload")
	var after: Array = state.nav_graph_for_region(97, 168)
	_check(after.size() == 2 and after[0] == graph_168, "... while 97/168's pair stays")
	_check(state.nav_graph_pairs().size() == 1 and state.nav_graph_pairs()[0][1] == group_168,
		"nav_graph_pairs lists 97/168's pair alone")
	_check(not state.navmesh_cache.has(state.navmesh_key(97, 167)) and state.navmesh_cache.has(state.navmesh_key(97, 168)),
		"navmesh_cache has no 97/167 key and keeps 97/168's")
	_check(not state.parsed_heightmaps.has("97_167") and state.parsed_heightmaps.has("97_168"),
		"parsed_heightmaps has no 97/167 key and keeps 97/168's")
	_check(not state.parsed_heightmaps.has("96_166"),
		"a neighbour heightmap only the unloaded region's ownership test needed (96/166) is pruned")
	_check(state.parsed_heightmaps.has("98_169") and state.parsed_heightmaps.has("96_167"),
		"neighbour heightmaps next to the still-loaded 97/168 (98/169, 96/167) are kept")
	_check(not state.loaded_cells.has("0_-1") and state.loaded_cells.has("0_0"),
		"the region's own cell (0_-1) is dropped and 97/168's (0_0) kept")
	_check(not state.object_collision_cache.has(10), "object 10, listed by 97/167's navmesh alone, is pruned")
	_check(state.object_collision_cache.has(11) and state.object_collision_cache.has(12),
		"object 11 (shared with 97/168) and 12 (97/168's) are kept")
	_check(dropped.has("cell 0_-1") and dropped.has("npcs") and dropped.has("nav graph")
			and dropped.has("navmesh") and dropped.has("heightmap") and dropped.has("1 neighbour heightmap(s)")
			and dropped.has("1 object collision mesh(es)"),
		"unload names what it dropped (got: %s)" % ", ".join(dropped))
	_check(state.unload(97, 167).is_empty(), "a second unload of the same region drops nothing")
	_check(state.unload(50, 50).is_empty(), "unloading a region never loaded drops nothing")
	_check(state.counts_line() == "cells=1 queued=0 npc_regions=1 nav_graphs=1 navmesh=1 heightmaps=3 collisions=2",
		"counts_line reads the remaining region and its two neighbours (got: %s)" % state.counts_line())

	# A freed group is never handed out: the pair is skipped, not assigned.
	group_168.free()
	_check(state.nav_graph_for_region(97, 168).is_empty() and state.nav_graph_pairs().is_empty(),
		"a pair whose group was freed is not handed out (no typed assignment of a freed instance)")
	group_167.free()

func _test_reentry_and_clear_all(state: RefCounted) -> void:
	state.mark_loaded(1, 0, 98, 168)
	state.mark_npcs_done(98, 168)
	state.unload(98, 168)
	_check(not state.npcs_done(98, 168) and state.loaded_cells.is_empty(), "unloaded: 98/168 is neither loaded nor populated")
	# The cell streams back in: World3D marks it loaded and spawns its NPCs
	# again, which marks it done again.
	state.mark_loaded(1, 0, 98, 168)
	_check(not state.npcs_done(98, 168), "a cell that streamed back in is not yet populated -- _try_spawn_region_npcs runs for it")
	state.mark_npcs_done(98, 168)
	_check(state.npcs_done(98, 168) and state.loaded_cells["1_0"] == Vector2i(98, 168),
		"... and is populated once its NPCs are placed again")

	state.queued_cells["2_0"] = true
	state.navmesh_cache[state.navmesh_key(98, 168)] = _navmesh([7])
	state.object_collision_cache[7] = null
	state.parsed_heightmaps["98_168"] = null
	state.add_nav_graph(98, 168, NavGraph.new(), Node3D.new())
	var group: Node3D = state.nav_graph_for_region(98, 168)[1]
	state.clear_all()
	_check(state.loaded_cells.is_empty() and state.queued_cells.is_empty() and state.npc_regions_done.is_empty()
			and state.nav_graphs.is_empty() and state.navmesh_cache.is_empty()
			and state.parsed_heightmaps.is_empty() and state.object_collision_cache.is_empty(),
		"clear_all empties every dictionary (the zone change)")
	group.free()

func _finish() -> void:
	if _failures == 0:
		print("ALL PASS")
		quit(0)
	else:
		print("%d FAILURES" % _failures)
		quit(1)
