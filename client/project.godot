; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Comments here start with ';'. A '#' line is NOT a comment in this file:
; Godot folds it into the next key, and that setting silently never applies
; (round 581; scripts/project_settings_test.gd checks what the engine read).

config_version=5

[application]

config/name="OpenSRO"
config/description="OpenSRO: a clean-room Silkroad Online-style MMO client. Requires user-supplied *.pk2 data files at runtime."
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.2")

[autoload]

; Round 704 (UserDataMigration): FIRST, so a player's settings are copied from
; the old SRRevamp user folder before the Audio autoload reads them.
UserDataMigrator="*res://scripts/setting/user_data_migration.gd"
NetClient="*res://scripts/net/net_client.gd"
; The client's sound (round 611): buses, options, the effect table, the
; music and ambient. docs/protocol/SOUND_FORMAT.md holds the contract.
Audio="*res://scripts/audio/audio_service.gd"

[debug]

; Always write a real log file next to nothing needing a console -- a real
; downloaded-exe player (OpenSRO, OpenSRO) has no terminal by default, so a bug
; report with "no logging to check" (2026-08-26, see docs/WORLD_ISSUES.md)
; had nothing to attach. Boot.gd prints the resolved absolute path once at
; startup so it's easy to find.
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/opensro.log"
file_logging/max_log_files=10

[rendering]

; Forward+ (Vulkan) is the default from round 693 (the user, 2026-10-02:
; "Let's make forward+ the default build"). From round 581 to 692 it was
; the Compatibility (OpenGL) renderer, chosen on 2026-08-26 after a tester's
; broken visuals were blamed on Vulkan; the white ground among them was
; later traced to a draw-order bug fixed in round 580 (measured holding
; under both renderers in round 693).
; Compatibility stays a choice per install: override.cfg beside the game
; (RendererChoice), written from setting/config.yaml's display.renderer or
; by the Compatibility launcher. Godot 4.2.2 does not fall back to OpenGL by
; itself when Vulkan fails (RendererChoice has the source it was read from).
; Before round 581 these lines began with '#', which swallowed the key
; below, and every player ran Forward+ anyway.
renderer/rendering_method="forward_plus"
; Phones and tablets (the "mobile" feature tag) stay on Compatibility, as
; before; no mobile build is exported. The web's ".web" key is the engine's
; own default, gl_compatibility (main/main.cpp), and is not set here.
renderer/rendering_method.mobile="gl_compatibility"

[gui]

; On: the window rasterises glyphs at its content scale factor (the UI
; scale), so text is drawn at the size it is shown at, at every scale --
; ClientSettings.apply_ui_scale has why it is on from start-up and never
; toggled (docs/WORLD_ISSUES.md round 672).
fonts/dynamic_fonts/use_oversampling=true

[shader_globals]

; The world's distance fog (round 702, WorldFog): x the fog start, y the fog
; end (view depth, world units), z 1 while the fog is drawn; READ from the
; client's environment step (docs/protocol/ENVIRONMENT_FORMAT.md). The colour
; is the zone's fog colour as the frame's linear value before tone mapping.
; A shader drawn after the fog pass (a transparent MTRL mod) fogs itself with
; them; the pass reads them too.
srr_fog_params={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
srr_fog_color={
"type": "vec4",
"value": Vector4(0, 0, 0, 1)
}
