; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Comments here start with ';'. A '#' line is NOT a comment in this file:
; Godot folds it into the next key, and that setting silently never applies
; (round 581; scripts/project_settings_test.gd checks what the engine read).

config_version=5

[application]

config/name="OpenSRO"
config/description="OpenSRO: a clean-room Silkroad Online-style MMO client. Requires user-supplied *.pk2 data files at runtime."
run/main_scene="res://scenes/Boot.tscn"
; Round 754 (the 4.7.2 spike): "4.7", as the 4.7 editor writes it on a save
; (ProjectSettings::save_custom adds the renderer's name). Below "4.6" Godot
; turns on animation/compatibility/default_parent_skeleton_in_mesh_instance_3d
; by itself (core/config/project_settings.cpp, 4.7.2), but only when it reads
; this text file, not an export's project.binary; every skinned MeshInstance3D
; the client builds names its skeleton itself, so the 4.6+ default ("") holds.
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

; Round 704 (UserDataMigration): FIRST, so a player's settings are copied from
; the old SRRevamp user folder before the Audio autoload reads them.
UserDataMigrator="*res://scripts/setting/user_data_migration.gd"
NetClient="*res://scripts/net/net_client.gd"
; The client's sound (round 611): buses, options, the effect table, the
; music and ambient. docs/protocol/SOUND_FORMAT.md holds the contract.
Audio="*res://scripts/audio/audio_service.gd"
; Round 754 (the 4.7.2 spike): frees the static caches' textures, meshes and
; shaders at quit while the RenderingServer still exists; under 4.7.2 a world
; run on Forward+ aborted at exit without it (scripts/shutdown_release.gd).
ShutdownRelease="*res://scripts/shutdown_release.gd"

[debug]

; Always write a real log file next to nothing needing a console -- a real
; downloaded-exe player (OpenSRO, OpenSRO) has no terminal by default, so a bug
; report with "no logging to check" (2026-08-26, see docs/WORLD_ISSUES.md)
; had nothing to attach. Boot.gd prints the resolved absolute path once at
; startup so it's easy to find.
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/opensro.log"
file_logging/max_log_files=10

[rendering]

; Forward+ (Vulkan) is the default from round 693 (the user, 2026-10-02:
; "Let's make forward+ the default build"). From round 581 to 692 it was
; the Compatibility (OpenGL) renderer, chosen on 2026-08-26 after a tester's
; broken visuals were blamed on Vulkan; the white ground among them was
; later traced to a draw-order bug fixed in round 580 (measured holding
; under both renderers in round 693).
; Compatibility stays a choice per install: override.cfg beside the game
; (RendererChoice), written from setting/config.yaml's display.renderer or
; by the Compatibility launcher. Godot 4.2.2 did not fall back to OpenGL by
; itself when Vulkan fails (RendererChoice has the source it was read from);
; 4.4+ does (rendering/rendering_device/fallback_to_opengl3, READ), and the
; native library's probe (vk_fallback.rs) still runs first.
; Before round 581 these lines began with '#', which swallowed the key
; below, and every player ran Forward+ anyway.
renderer/rendering_method="forward_plus"
; Phones and tablets (the "mobile" feature tag) stay on Compatibility, as
; before; no mobile build is exported. The web's ".web" key is the engine's
; own default, gl_compatibility (main/main.cpp), and is not set here.
renderer/rendering_method.mobile="gl_compatibility"
; Round 760 (Godot 4.7.2): the RenderingServer on its own thread (2). With the
; skeletons' per-frame process off it is the fastest model measured: 1000 /
; 3000 / 7000 players standing 5.9 / 7.1 / 9.4 ms a frame against 8.1 / 10.1 /
; 13.2 on the default thread and 9.0 / 11.2 / 15.5 on 4.2.2 (docs/rounds/
; r760.md), and 0 crashes in 5 x 300 s crowd runs with arrivals, walking and
; zone changes. Godot calls it experimental; `--render-thread safe` on the
; command line (or 1 here in override.cfg) gives the default model back. Under
; 4.2.2 it crashed (round 757: an AnimatedTexture re-entered the draw); 4.7.2
; emits frame_pre_draw on the main thread before it queues the draw (READ).
driver/threads/thread_model=2

[gui]

; On: the window rasterises glyphs at its content scale factor (the UI
; scale), so text is drawn at the size it is shown at, at every scale --
; ClientSettings.apply_ui_scale has why it is on from start-up and never
; toggled (docs/WORLD_ISSUES.md round 672).
fonts/dynamic_fonts/use_oversampling=true

[shader_globals]

; The world's distance fog (round 702, WorldFog): x the fog start, y the fog
; end (view depth, world units), z 1 while the fog is drawn; READ from the
; client's environment step (docs/protocol/ENVIRONMENT_FORMAT.md). The colour
; is the zone's fog colour as the frame's linear value before tone mapping.
; A shader drawn after the fog pass (a transparent MTRL mod) fogs itself with
; them; the pass reads them too.
srr_fog_params={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
srr_fog_color={
"type": "vec4",
"value": Vector4(0, 0, 0, 1)
}
srr_fog_height={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

; The objects' and characters' light (round 706, ObjectLight): the direction
; to the light in Godot's world (READ: -normalize(-1, -1, 0)), the light's
; ambient (channel 3 clamped) and diffuse (channel 2 clamped x 0.8 / 0.6 by
; the Bloom row), and the tone map the object shaders undo (x exposure,
; y white, z 1 Filmic, w 1 undo on). World3D sets them; these are the
; values before it does (OURS: 1.0 channels, bloom on, Filmic).
srr_obj_light={
"type": "vec4",
"value": Vector4(0.707107, 0.707107, 0, 0)
}
srr_obj_ambient={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}
srr_obj_diffuse={
"type": "vec4",
"value": Vector4(0.8, 0.8, 0.8, 1)
}
srr_obj_tonemap={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}

; The terrain's light at the day phase (round 786, TerrainLight): the
; environment's diffuse (channel 2), terrain ambient (channel 5) and terrain
; shadow (channel 6), display values, which retail evaluates every frame
; (Map::FUN_00a1baf0). World3D sets them from DayCycle; these are the values
; before it does (OURS: N.L alone, no shadow added).
srr_terrain_diffuse={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}
srr_terrain_ambient={
"type": "vec4",
"value": Vector4(0, 0, 0, 1)
}
srr_terrain_shadow={
"type": "vec4",
"value": Vector4(0, 0, 0, 1)
}
; OURS (round 786, NightLight): the night's scale on the terrain's lit colour,
; after retail's clamp; 1 by day and with Night Darkness at Original.
srr_terrain_night={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}

; The weapon and shield glow's clock in seconds (round 734's review, F8,
; EquipGlow.CLOCK_WRAP): a script accumulator advanced by every process
; frame's delta, wrapped at 25200 s, so the pulse and the scroll never jump
; at Godot's 3600 s TIME rollover.
srr_glow_clock={
"type": "float",
"value": 0.0
}

; The TEXANI mods' clock in seconds (round 786, TexAni.clock): a script
; accumulator advanced by every physics tick's delta, never wrapped (the
; original's rate matrix grows without a wrap too, READ). Each material's
; texture-coordinate rows are start + rates x (clock - its texani_t0).
srr_texani_clock={
"type": "float",
"value": 0.0
}

; The far crowd's clip clock in ms (round 747, CrowdGpu.flush): the world's
; clip time less CrowdGpu's epoch, rebased every CrowdGpu.EPOCH_SECONDS so a
; float keeps the quantum's precision.
srr_crowd_clock={
"type": "float",
"value": 0.0
}

; Round 762: the far crowd's held pages' reveal clocks (ms, as srr_crowd_clock;
; CrowdGpu.hold_open / reveal), one a slot; 1e9 while a slot's page is held.
srr_crowd_reveal={
"type": "vec4",
"value": Vector4(1e+09, 1e+09, 1e+09, 1e+09)
}
