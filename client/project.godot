; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="SRRevamp"
config/description="Clean-room MMO client scaffold. Requires user-supplied *.pk2 data files at runtime."
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.2")

[autoload]

NetClient="*res://scripts/net/net_client.gd"

[debug]

# Always write a real log file next to nothing needing a console -- a real
# downloaded-exe player (OpenSRO, OpenSRO) has no terminal by default, so a bug
# report with "no logging to check" (2026-08-26, see docs/WORLD_ISSUES.md)
# had nothing to attach. Boot.gd prints the resolved absolute path once at
# startup so it's easy to find.
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/srrevamp.log"
file_logging/max_log_files=10

[rendering]

# Real, deliberate choice (2026-08-26, see docs/WORLD_ISSUES.md): default
# to the Compatibility (OpenGL) renderer rather than Godot 4's Forward+
# (Vulkan) default. A real playtest reported a cluster of symptoms --
# missing HUD, flat/textureless ground, generally "not right" visuals --
# all at once, which is consistent with a Vulkan driver/GPU incompatibility
# on that specific machine (no hard crash, just broad rendering breakage)
# rather than several unrelated content bugs. Compatibility mode runs on
# far more real hardware (including older/integrated GPUs a real user is
# likelier to have), which matters more for a downloadable hobby client
# than Forward+'s extra rendering features.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

