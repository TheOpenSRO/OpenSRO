          ]
        }
      },
      "id": 10,
      "gridPos": {
        "x": 16,
        "y": 35,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Logins, world entries and exits",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "${selector:raw} | logfmt | __error__=\"\" | msg=~\"login|entered world|left world|lobby: .*\" | account=~\"${account:raw}\" | character=~\"${character:raw}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "logs",
      "title": "Warps and teleports",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "${selector:raw} | logfmt | __error__=\"\" | msg=~\"warp|teleport|teleport refused|walk-in teleport.*|scroll warp|zone change refused.*\" | account=~\"${account:raw}\" | character=~\"${character:raw}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
