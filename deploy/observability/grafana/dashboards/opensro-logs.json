      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "logs",
      "title": "Economy (mall, stalls, exchanges, gacha)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "${selector:raw} | logfmt | __error__=\"\" | msg=~\"mall: .*|stall: .*|exchange: .*|gacha.*\"",
          "refId": "A",
